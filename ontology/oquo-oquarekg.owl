        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Provenance refers to the provision of information regarding the origin of the dataset and of the resources within the dataset itself.</obo:IAO_0000115>
        <rdfs:label>KG provenance characteristic</rdfs:label>
    </owl:Class>
    


