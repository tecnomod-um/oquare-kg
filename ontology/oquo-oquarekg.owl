                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGVersatilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo#KGVersatilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGUsageOfMultipleLanguagesMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the number of languages supported by a graph.</obo:IAO_0000115>
        <rdfs:label>KG usage of multiple languages metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGUsageOfUndefinedClassesAndPropertiesMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGUsageOfUndefinedClassesAndPropertiesMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
