                <owl:hasValue rdf:resource="https://purl.org/oquo#KGRelationsPerNodeMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the average number of relations per graph node.</obo:IAO_0000115>
        <rdfs:label>KG relations per node metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGReliabilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGReliabilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasSubCharacteristic"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGAccessibilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Reliability refers to the capability of the knowledge graph to maintain its level of performance under stated conditions for a given period of time.</obo:IAO_0000115>
        <rdfs:label>KG reliability characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGReusabilityCharacteristic -->

