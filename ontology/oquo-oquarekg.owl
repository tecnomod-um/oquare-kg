        <obo:IAO_0000115 xml:lang="en">Structural accuracy refers to the correctness of the use of ontological terms in the graph.</obo:IAO_0000115>
        <rdfs:label>KG structural accuracy characteristic</rdfs:label>
    </owl:Class>
    


