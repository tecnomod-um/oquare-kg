                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGClusteringCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGUnderstandabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGClusteringCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGUnderstandabilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGSynonymsPerInstanceMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the number of synonyms associated with instances divided by the total number of instances.</obo:IAO_0000115>
        <rdfs:label>KG synonyms per instance metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGSyntacticValidityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGSyntacticValidityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Syntactic validity is the degree to which an RDF document conforms to the specification of its serialization format.</obo:IAO_0000115>
        <rdfs:label>KG syntactic validity characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGTraceabilityOfTheDataMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGTraceabilityOfTheDataMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
