                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGClusteringCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGConsistencyCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInferenceCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInterpretabilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGUsageOfUndefinedClassesAndPropertiesMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the use of classes and properties that are not described with ontology terms.</obo:IAO_0000115>
        <rdfs:label>KG usage of undefined classes and properties metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGValidFormatMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGValidFormatMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGInteroperabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGSyntacticValidityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInteroperabilityCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGSyntacticValidityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGValidFormatMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Identifies whether declared serialization formats conform to recognized RDF syntax specifications.</obo:IAO_0000115>
        <rdfs:label>KG valid format metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGVersatilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGVersatilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Versatility refers to the availability of the data in different representations and in an internationalized way.</obo:IAO_0000115>
        <rdfs:label>KG versatility characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#NominalToOrdinalScaleConversion -->

    <owl:Class rdf:about="https://purl.org/oquo#NominalToOrdinalScaleConversion">
        <rdfs:subClassOf rdf:resource="https://purl.org/oquo#ScaleConversion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#hasInputScale"/>
                <owl:someValuesFrom rdf:resource="http://www.wurvoc.org/vocabularies/om-1.8/Nominal_scale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#hasOutputScale"/>
                <owl:someValuesFrom rdf:resource="http://www.wurvoc.org/vocabularies/om-1.8/Ordinal_scale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#hasScalePointMapping"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#NominalToOrdinalScalePointMapping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Defines how to convert a nominal scale into an ordinal scale.</rdfs:comment>
        <rdfs:label>nominal to ordinal scale conversion</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#NominalToOrdinalScalePointMapping -->

    <owl:Class rdf:about="https://purl.org/oquo#NominalToOrdinalScalePointMapping">
        <rdfs:subClassOf rdf:resource="https://purl.org/oquo#ScalePointMapping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#hasOutputScaleCategory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/net/QualityModel#OrdinalScaleItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#hasInputNominalValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents the mapping between a nominal value in one scale and an ordinal value in another scale.</rdfs:comment>
        <rdfs:label>nominal to ordinal scale point mapping</rdfs:label>
    </owl:Class>
    


