                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGLicensingCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGReusabilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGMachineReadableLicenseMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Checks whether a dataset has a valid machine-readable license.</obo:IAO_0000115>
        <rdfs:label>KG machine-readable license metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGMaintainabilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGMaintainabilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasSubCharacteristic"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGReusabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">The capability of a knowledge graph to be modified or extended in response to changes in environments, data sources, requirements, or functional specifications.</obo:IAO_0000115>
        <rdfs:label>KG maintainability characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGMisplacedClassesOrPropertiesMetric -->

