<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.org/oquo#"
     xml:base="https://purl.org/oquo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:om-1="http://www.wurvoc.org/vocabularies/om-1.8/"
     xmlns:rdf1="http://www.cropontology.org/rdf/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:QualityModel="http://purl.org/net/QualityModel#">
    <owl:Ontology rdf:about="https://purl.org/oquo-oquarekg">
        <owl:imports rdf:resource="https://purl.org/oquo-core"/>
        <dc:description>The oquo-oquarekg ontology extends the Ontology QUality Ontology (OQUO) by including the OQuaRE-KG framework</dc:description>
        <dc:title>The oquo-oquarekg ontology</dc:title>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://purl.org/oquo#hasInputNominalValue -->

    <owl:DatatypeProperty rdf:about="https://purl.org/oquo#hasInputNominalValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/oquo#ScalePointMapping"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment>The input nominal value (for example, a boolean) of an scale point mapping.</rdfs:comment>
        <rdfs:label>has input nominal value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://purl.org/oquo#KGAccessibilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGAccessibilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Accessibility is the degree to which a knowledge graph and its metadata can be reliably retrieved by humans and machines through open, standardized protocols, with clear access conditions and persistent availability of metadata.</obo:IAO_0000115>
        <rdfs:label>KG accessibility characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGAnnotationRichnessMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGAnnotationRichnessMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGUnderstandabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGUnderstandabilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGAnnotationRichnessMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the mean number of annotation properties per instance.</obo:IAO_0000115>
        <rdfs:label>KG annotation richness metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGClassesPerInstanceMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGClassesPerInstanceMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGClusteringCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGConsistencyCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGInferenceCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGInterpretabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGClusteringCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGConsistencyCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInferenceCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInterpretabilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGClassesPerInstanceMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the mean number of classes associated with each instance.</obo:IAO_0000115>
        <rdfs:label>KG classes per instance metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGClusteringCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGClusteringCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Clustering is the degree to which entities representing the same or closely related concepts are accurately identified, grouped and linked within or across data sources.</obo:IAO_0000115>
        <rdfs:label>KG clustering characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGCompatibilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGCompatibilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasSubCharacteristic"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGInteroperabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">The ability of a knowledge graph to function correctly and be integrated with other knowledge graphs, data sources, or systems by adhering to common technical standards for data representation and exchange.</obo:IAO_0000115>
        <rdfs:label>KG compatibility characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGCompatibleDatatypeMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGCompatibleDatatypeMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGConsistencyCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGSyntacticValidityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGConsistencyCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGSyntacticValidityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGCompatibleDatatypeMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Assesses the lexical form of data values against the datatype attached to each literal.</obo:IAO_0000115>
        <rdfs:label>KG compatible datatype metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGConsistencyCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGConsistencyCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Consistency means that two or more entities do not conflict with respect to knowledge representation and inference mechanisms.</obo:IAO_0000115>
        <rdfs:label>KG consistency characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGDereferenceabilityOfTheURIMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGDereferenceabilityOfTheURIMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGAccessibilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGAccessibilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGDereferenceabilityOfTheURIMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures whether the URI of a resource can be reliably dereferenced.</obo:IAO_0000115>
        <rdfs:label>KG dereferenceability of the URI metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGDescriptionsPerInstanceMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGDescriptionsPerInstanceMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGUnderstandabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo#KGUnderstandabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGDescriptionsPerInstanceMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the total number of descriptions associated with instances divided by the total number of instances.</obo:IAO_0000115>
        <rdfs:label>KG descriptions per instance metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGDifferentSerialisationFormatsMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGDifferentSerialisationFormatsMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGAccessibilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGInteroperabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGSyntacticValidityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGVersatilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGAccessibilityCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInteroperabilityCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGSyntacticValidityCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGVersatilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGDifferentSerialisationFormatsMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Checks whether multiple serialisation formats are declared in graph metadata.</obo:IAO_0000115>
        <rdfs:comment>The direct evaluation output of this metric is the set of distinct serialisation formats found for the resource (possibly empty). The value positioned on this metric&apos;s scale is the cardinality of that set, which is computed downstream from the raw result.</rdfs:comment>
        <rdfs:label>KG different serialisation formats metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGEntitiesWithNoTypeMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGEntitiesWithNoTypeMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#LowerBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGClusteringCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGConsistencyCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGInferenceCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGInterpretabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGClusteringCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGConsistencyCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInferenceCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGInterpretabilityCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGEntitiesWithNoTypeMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the ratio of graph entities lacking an RDF type.</obo:IAO_0000115>
        <rdfs:label>KG entities with no type metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGEvidenceMetric -->

