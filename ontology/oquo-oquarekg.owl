        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Reusability is the degree to which components of a knowledge graph can be effectively used in multiple contexts to build new systems or enrich other knowledge graphs.</obo:IAO_0000115>
        <rdfs:label>KG reusability characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGReuseOfExistingTermsMetric -->

