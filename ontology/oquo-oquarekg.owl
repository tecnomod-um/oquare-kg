                <owl:hasValue rdf:resource="https://purl.org/oquo#KGReuseOfExistingTermsMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Assesses whether relevant existing terms from other vocabularies are reused.</obo:IAO_0000115>
        <rdfs:label>KG re-use of existing terms metric</rdfs:label>
