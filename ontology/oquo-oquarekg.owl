        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGLicensingCharacteristic"/>
