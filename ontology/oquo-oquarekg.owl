                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGAccessibilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGProvenanceCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGReusabilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGTrustworthinessCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#KGAccessibilityCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGProvenanceCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGReusabilityCharacteristic"/>
                            <rdf:Description rdf:about="https://purl.org/oquo#KGTrustworthinessCharacteristic"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGTraceabilityOfTheDataMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Checks whether resources have provenance information related to the origin of data.</obo:IAO_0000115>
        <rdfs:label>KG traceability of the data metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGTransferabilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGTransferabilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasSubCharacteristic"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGVersatilityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">The degree to which a knowledge graph can be deployed, reused, or adapted across different platforms, domains, or technical environments with minimal modification, preserving its data, schema, and semantic definitions.</obo:IAO_0000115>
        <rdfs:label>KG transferability characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGTrustworthinessCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGTrustworthinessCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Trustworthiness is the degree to which the information is accepted to be correct, true, real and credible.</obo:IAO_0000115>
        <rdfs:label>KG trustworthiness characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGUnderstandabilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGUnderstandabilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Understandability refers to the ease with which data can be comprehended without ambiguity and be used by a human information consumer.</obo:IAO_0000115>
        <rdfs:label>KG understandability characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGUsageOfDeprecatedClassesOrPropertiesMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGUsageOfDeprecatedClassesOrPropertiesMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#LowerBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGStructuralAccuracyCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo#KGStructuralAccuracyCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGUsageOfDeprecatedClassesOrPropertiesMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Checks whether used classes and properties are deprecated classes or deprecated properties.</obo:IAO_0000115>
        <rdfs:label>KG usage of deprecated classes or properties metric</rdfs:label>
    </owl:Class>
    


