                <owl:hasValue rdf:resource="https://purl.org/oquo#KGMisplacedClassesOrPropertiesMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Checks whether defined classes and properties are used in their correct RDF positions.</obo:IAO_0000115>
        <rdfs:label>KG misplaced classes or properties metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGMisusedOWLDatatypeOrObjectPropertiesMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGMisusedOWLDatatypeOrObjectPropertiesMetric">
