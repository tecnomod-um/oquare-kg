    <owl:Class rdf:about="https://purl.org/oquo#KGLicensingCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Licensing is the granting of permission for a consumer to re-use a dataset under defined conditions.</obo:IAO_0000115>
        <rdfs:label>KG licensing characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGMachineReadableLicenseMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGMachineReadableLicenseMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
