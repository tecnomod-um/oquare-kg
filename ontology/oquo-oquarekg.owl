                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGRedundancyCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasSubCharacteristic"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGStructuralAccuracyCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasSubCharacteristic"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo#KGSyntacticValidityCharacteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">The structural dimension accounts for the intrinsic design and structure of the knowledge graph, independent of the user&apos;s specific context.</obo:IAO_0000115>
        <rdfs:label>KG structural characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGSynonymsPerInstanceMetric -->

    <owl:Class rdf:about="https://purl.org/oquo#KGSynonymsPerInstanceMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
