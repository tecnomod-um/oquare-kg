            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">The level of effort required by users to effectively access, query, navigate, and update the information stored within the knowledge graph to perform their tasks.</obo:IAO_0000115>
        <rdfs:label>KG operability characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGProvenanceCharacteristic -->

