        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Measures the number of names associated with instances divided by the total number of instances.</obo:IAO_0000115>
        <rdfs:label>KG names per instance metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGOperabilityCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGOperabilityCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
