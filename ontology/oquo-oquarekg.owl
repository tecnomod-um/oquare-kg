                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo#KGProvisionOfBasicProvenanceInformationMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Checks for basic provenance information such as creator or publisher metadata on a dataset.</obo:IAO_0000115>
        <rdfs:label>KG provision of basic provenance information metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGRedundancyCharacteristic -->

    <owl:Class rdf:about="https://purl.org/oquo#KGRedundancyCharacteristic">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#QualityCharacteristic"/>
        <obo:IAO_0000115 xml:lang="en">Redundancy refers to the degree of avoidance of duplicate entities or relationships that could confuse the reasoning and querying of the graph.</obo:IAO_0000115>
        <rdfs:label>KG redundancy characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo#KGRelationsPerNodeMetric -->

