# ============================================================
# Monarch KG -> slice extraction for OQuaRE-KG (GraphDB)
# Run each block separately. Replace the MONDO root in VALUES ?ROOT.
# If Monarch lives in a named graph <G>, wrap non-GRAPH patterns in GRAPH <G>.
# ============================================================

PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX biolink:  <https://w3id.org/biolink/vocab/>

# ---- (1) disease->phenotype associations in the branch (full assoc node = provenance) ----
INSERT { GRAPH <urn:slice:mondo> { ?a ?ap ?ao } }
WHERE {
  VALUES ?ROOT { <http://purl.obolibrary.org/obo/MONDO_0004995> }
  ?a rdf:predicate biolink:has_phenotype ; rdf:subject ?d .
  ?d biolink:subclass_of* ?ROOT .
  ?a ?ap ?ao .
} ;

# ---- (2) gene->disease associations whose object is in the branch ----
INSERT { GRAPH <urn:slice:mondo> { ?a ?ap ?ao } }
WHERE {
  VALUES ?ROOT { <http://purl.obolibrary.org/obo/MONDO_0004995> }
  ?a rdf:predicate biolink:gene_associated_with_condition ; rdf:object ?d .
  ?d biolink:subclass_of* ?ROOT .
  ?a ?ap ?ao .
} ;

# ---- (3) corresponding direct edges ----
INSERT { GRAPH <urn:slice:mondo> { ?s ?p ?o } }
WHERE {
  VALUES ?ROOT { <http://purl.obolibrary.org/obo/MONDO_0004995> }
  VALUES ?p { biolink:has_phenotype biolink:gene_associated_with_condition }
  ?s ?p ?o .
  { ?s biolink:subclass_of* ?ROOT } UNION { ?o biolink:subclass_of* ?ROOT }
} ;

# ---- (4) annotation closure over subject/object of the slice associations ----
INSERT { GRAPH <urn:slice:mondo> { ?n ?np ?no } }
WHERE {
  GRAPH <urn:slice:mondo> { ?a ?sp ?n . VALUES ?sp { rdf:subject rdf:object } }
  ?n ?np ?no .
  FILTER(?np IN (rdf:type, biolink:category, rdfs:label, dcterms:description,
    biolink:synonym, biolink:exact_synonym, biolink:related_synonym,
    biolink:narrow_synonym, biolink:broad_synonym, biolink:xref,
    biolink:symbol, biolink:full_name, biolink:in_taxon, biolink:in_taxon_label,
    biolink:deprecated))
} ;
