<http://purl.obolibrary.org/obo/MONDO_0015281> rdfs:label "atrial standstill"@en ;
    dcterms:description "Atrial standstill is a rare cardiac rhythm disease with a few familial and sporadic cases described to date that is characterized by a transient or permanent absence of electrical and mechanical atrial activity. Electrocardiographic findings include bradycardia, ectopic supraventricular rhythms, lack of atrial excitability and absent P waves." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "atrial cardiomyopathy with heart block" ;
    ns1:synonym "atrial cardiomyopathy with heart block" ;
