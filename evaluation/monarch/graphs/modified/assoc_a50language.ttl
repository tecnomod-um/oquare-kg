<http://purl.obolibrary.org/obo/MONDO_0015263> rdfs:label "Brugada syndrome"@en ;
    dcterms:description "A genetically heterogeneous condition characterized by complete or incomplete right bundle branch block accompanied by ST elevation in leads V1-V3. There is a high incidence of ventricular arrhythmia that may result in sudden death." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Brugada syndrome",
