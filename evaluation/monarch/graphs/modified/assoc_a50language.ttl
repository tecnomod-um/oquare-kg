<http://purl.obolibrary.org/obo/MONDO_0980715> rdfs:label "cardiac conduction disease with or without cardiomyoopathy" ;
    dcterms:description "A rare genetic cardiac disease characterized by variably expressed atrial tachyarrhythmia (such as atrial flutter, paroxysmal or chronic atrial fibrillation, ectopic atrial tachycardia, or multifocal atrial tachycardia), infra-Hisian conduction system disease, and vulnerability to dilated cardiomyopathy. Age of onset ranges between childhood and adulthood." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "hereditary atrial tachyarrhythmia-infra-Hisian cardiac conduction disease" ;
    ns1:synonym "hereditary atrial tachyarrhythmia-infra-Hisian cardiac conduction disease"@en ;
    ns1:xref "OMIMPS:616117"@en,
        "Orphanet:436242"@en .

