<http://purl.obolibrary.org/obo/HP_0000092> rdfs:label "Renal tubular atrophy" ;
    dcterms:description "The presence of renal tubules with thick redundant basement membranes, or a reduction of greater than 50% in tubular diameter compared to surrounding non-atrophic tubules." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Renal tubular cell atrophy",
        "Tubular atrophy"@en ;
    ns1:synonym "Renal tubular cell atrophy",
        "Tubular atrophy" ;
