<http://purl.obolibrary.org/obo/HP_0000873> rdfs:label "Diabetes insipidus" ;
    dcterms:description "A state of excessive water intake and hypotonic (dilute) polyuria. Diabetes insipidus may be due to failure of vasopressin (AVP) release (central or neurogenic diabetes insipidus) or to a failure of the kidney to respond to AVP (nephrogenic diabetes insipidus)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:15771004",
        "UMLS:C0011848" .

<http://purl.obolibrary.org/obo/HP_0000926> rdfs:label "Platyspondyly" ;
    dcterms:description "A flattened vertebral body shape with reduced distance between the vertebral endplates." ;
