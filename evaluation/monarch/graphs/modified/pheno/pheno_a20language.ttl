    ns1:xref "UMLS:C0545017",
        "SNOMEDCT_US:125510009"@en .

<http://purl.obolibrary.org/obo/HP_0012593> rdfs:label "Nephrotic range proteinuria" ;
    dcterms:description "Severely increased amount of excretion of protein in the urine, defined as 3.5 grams per day or more in adults and 40 mg per meter-squared body surface area per hour in children." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:264867001",
        "UMLS:C0445118"@en .

<http://purl.obolibrary.org/obo/HP_0012649> rdfs:label "Increased inflammatory response" ;
    dcterms:description "A abnormal increase in the inflammatory response to injury or infection." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022803" .

<http://purl.obolibrary.org/obo/HP_0012722> rdfs:label "Heart block" ;
    dcterms:description "Impaired conduction of cardiac impulse occurring anywhere along the conduction pathway." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:233916004",
        "UMLS:C0018794"@en .

<http://purl.obolibrary.org/obo/HP_0012758> rdfs:label "Neurodevelopmental delay" ;
    dcterms:description "Neurodevelopmental delay (NDD) refers to delays in the maturation of the brain and central nervous system; infants and young children with NDD may experience delays in the development of one or more skills including gross motor abilities, fine-motor coordination, language abilities and ability to solve increasingly complex problems." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "NDD" ;
    ns1:synonym "NDD" ;
    ns1:xref "UMLS:C4022738"@en .

<http://purl.obolibrary.org/obo/HP_0012785> rdfs:label "Flexion contracture of finger" ;
    dcterms:description "Chronic loss of joint motion in a finger due to structural changes in non-bony tissue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flexion deformity of finger" ;
    ns1:synonym "Flexion deformity of finger" ;
    ns1:xref "UMLS:C1857304" .

<http://purl.obolibrary.org/obo/HP_0012802> rdfs:label "Broad jaw" ;
    dcterms:description "Bigonial distance (lower facial width) more than 2 SD above the mean (objective); or an apparently increased width of the lower jaw (mandible) when viewed from the front (subjective)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad jaw",
        "Broad lower face",
        "Broad mandible",
        "Wide mandible",
        "Wide jaw"@en ;
    ns1:synonym "Broad lower face",
        "Wide jaw",
        "Wide mandible",
        "Broad jaw"@en,
        "Broad mandible"@en ;
    ns1:xref "UMLS:C3281059" .

<http://purl.obolibrary.org/obo/HP_0012819> rdfs:label "Myocarditis" ;
    dcterms:description "Inflammation of the myocardium."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of heart muscle" ;
    ns1:synonym "Inflammation of heart muscle" ;
    ns1:xref "SNOMEDCT_US:50920009",
        "UMLS:C0027059" .

<http://purl.obolibrary.org/obo/HP_0020062> rdfs:label "Decreased hemoglobin concentration" ;
    dcterms:description "An abnormal reduction below normal hemoglobin concentration in the circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased haemoglobin concentration",
        "Decreased Hb concentration"@en ;
    ns1:synonym "Decreased Hb concentration",
        "Decreased haemoglobin concentration" .

<http://purl.obolibrary.org/obo/HP_0020086> rdfs:label "BCGitis" ;
    dcterms:description "Local or regional infection with Bacillus Calmette-Guerin (BCG) following vaccination." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025066> rdfs:label "Decreased mean corpuscular volume" ;
    dcterms:description "A reduction from normal of the mean corpuscular volume, or mean cell volume (MCV) of red blood cells (usually defined as an MCV below 80 femtoliters)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Microcytosis",
        "Reduced erythrocyte volume",
        "Decreased MCV"@en ;
    ns1:synonym "Microcytosis",
        "Reduced erythrocyte volume",
        "Decreased MCV"@en .

<http://purl.obolibrary.org/obo/HP_0025156> rdfs:label "Dependency on intravenous nutrition" ;
    dcterms:description "Inability to be weaned from intravenous (parenteral) nutrition, as judged by the hydration status (urine output, blood urea nitrogen, creatinine, urine sodium concentration), ability to maintain weight, stool output, and serum electrolyte status." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dependency on IV nutrition" ;
    ns1:synonym "Dependency on IV nutrition" .

<http://purl.obolibrary.org/obo/HP_0025230> rdfs:label "Tendonitis" ;
    dcterms:description "Inflammation of a tendon." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Teninitis" ;
    ns1:synonym "Teninitis" .

<http://purl.obolibrary.org/obo/HP_0025252> rdfs:label "Geographic tongue" ;
    dcterms:description "An anomaly of the tongue characterized by loss (atrophy) of filiform papillae of the tongue, leaving areas of erythema (redness), surrounded by a serpiginous, white, hyperkeratotic border. The name geographic tongue refers to an appearance that is said to be similar to a map."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Annulus migrans",
        "Benign migratory glossitis",
        "Lingual erythema migrans",
        "Wandering rash of the tongue",
        "Glossitis areata exfoliativa"@en ;
    ns1:synonym "Annulus migrans",
        "Benign migratory glossitis",
        "Glossitis areata exfoliativa",
        "Lingual erythema migrans",
        "Wandering rash of the tongue" .

<http://purl.obolibrary.org/obo/HP_0025300> rdfs:label "Malar rash"@en ;
    dcterms:description "An erythematous (red), flat facial rash that affects the skin in the malar area (over the cheekbones) and extends over the bridge of the nose." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Butterfly rash",
        "Cheekbone rash" ;
    ns1:synonym "Butterfly rash",
        "Cheekbone rash" .

<http://purl.obolibrary.org/obo/HP_0025420> rdfs:label "Diffuse alveolar hemorrhage"@en ;
    dcterms:description "A type of of pulmonary hemorrhage that originates from the pulmonary microcirculation, including the alveolar capillaries, arterioles, and venules. It presents with hemoptysis, anemia, diffuse lung infiltration, and acute respiratory failure. The diagnosis is confirmed by the observation of the accumulation of red blood cells, fibrin, or hemosiderin-laden macrophage in the alveolar space on pathologic biopsy. Hemosiderin, a product of hemoglobin degradation, appears at least 48-72 hours after bleeding and is helpful in distinguishing diffuse alveolar hemorrhage from surgical trauma. Mild interstitial thickening, organizing pneumonia, or diffuse alveolar damage can also be seen." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Diffuse alveolar haemorrhage"@en ;
    ns1:synonym "Diffuse alveolar haemorrhage"@en .

<http://purl.obolibrary.org/obo/HP_0025526> rdfs:label "Psoriasiform lesion" ;
    dcterms:description "A skin lesions that resembles the lesions observed in psoriasis, viz., an erythematous plaque covered by fine silvery scales. Psoriasiform lesions can be observed in psoriasis as well as in other conditions including allergic contact dermatitis, seborrhoeic dermatitis, Atopic dermatitis, pityriasis rubra, and lichen simplex chronicus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Psoriatic-like lesion"@en ;
    ns1:related_synonym "Erythematosquamous plaque",
        "Erythemato-squamous plaque"@en ;
    ns1:synonym "Erythematosquamous plaque",
        "Psoriatic-like lesion",
        "Erythemato-squamous plaque"@en .

<http://purl.obolibrary.org/obo/HP_0025528> rdfs:label "Annular cutaneous lesion" ;
    dcterms:description "A lesion of the skin with a ring-like distribution." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025615> rdfs:label "Abscess" ;
    dcterms:description "An abscess is a localized collection of purulent material surrounded by inflammation and granulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025616> rdfs:label "Sterile abscess" ;
    dcterms:description "An abscess not caused by infection with pyogenic bacteria. Operationally, a sterile abscess is inferred if investigations of an abscess fail to reveal evidence of pathogenic organisms." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030043> rdfs:label "Hip subluxation" ;
    dcterms:description "A partial dislocation of the hip joint, whereby the head of the femur is partially displaced from the socket."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial hip dislocation",
        "Subluxation involving the hip joint" ;
    ns1:synonym "Partial hip dislocation"@en,
        "Subluxation involving the hip joint"@en ;
    ns1:xref "SNOMEDCT_US:263057000",
        "UMLS:C0434785" .

<http://purl.obolibrary.org/obo/HP_0030047> rdfs:label "Abnormal lateral ventricle morphology" ;
    dcterms:description "A morphological anomaly of the lateral ventricle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of lateral ventricle" ;
    ns1:synonym "Abnormality of lateral ventricle" ;
    ns1:xref "UMLS:C4022662" .

<http://purl.obolibrary.org/obo/HP_0030057> rdfs:label "Autoimmune antibody positivity" ;
    dcterms:description "The presence of an antibody in the blood circulation that is directed against the organism's own cells or tissues."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022660" .

<http://purl.obolibrary.org/obo/HP_0030084> rdfs:label "Clinodactyly" ;
    dcterms:description "An angulation of a digit at an interphalangeal joint in the plane of the palm (finger) or sole (toe)." ;
    ns1:broad_synonym "Curvature of digit" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Permanent curving of the finger" ;
    ns1:synonym "Curvature of digit"@en,
        "Permanent curving of the finger"@en ;
    ns1:xref "SNOMEDCT_US:17268007",
        "UMLS:C0265610",
        "UMLS:C4280304"@en .

<http://purl.obolibrary.org/obo/HP_0030146> rdfs:label "Abnormal liver parenchyma morphology" ;
    dcterms:description "A structural anomaly of the liver located predominantly in the hepatocytes as opposed to stromal cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022605"@en .

<http://purl.obolibrary.org/obo/HP_0030149> rdfs:label "Cardiogenic shock" ;
    dcterms:description "Severely decreased cardiac output with evidence of inadequate end-organ perfusion (i.e., tissue hypoxia) in the presence of adequate intravascular volume." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cardiovascular shock" ;
    ns1:synonym "Cardiovascular shock" ;
    ns1:xref "SNOMEDCT_US:89138009",
        "UMLS:C0036980" .

<http://purl.obolibrary.org/obo/HP_0030166> rdfs:label "Night sweats" ;
    dcterms:description "Occurrence of excessive sweating during sleep."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Night sweats",
        "Nocturnal hyperhidrosis" ;
    ns1:synonym "Night sweats",
        "Nocturnal hyperhidrosis"@en ;
    ns1:xref "SNOMEDCT_US:42984000",
        "UMLS:C0028081" .

<http://purl.obolibrary.org/obo/HP_0030167> rdfs:label "Antimitochondrial antibody positivity"@en ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against mitochondria." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Serum antimitochrondrial antibodies" ;
    ns1:synonym "Serum antimitochrondrial antibodies" ;
    ns1:xref "UMLS:C4021051" .

<http://purl.obolibrary.org/obo/HP_0030319> rdfs:label "Weakness of facial musculature"@en ;
    dcterms:description "Reduced strength of one or more muscles innervated by the facial nerve (the seventh cranial nerve)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased facial muscle strength",
        "Decreased strength of facial muscles",
        "Face weakness",
        "Facial weakness",
        "Myasthenia of facial muscles",
        "Weakness of face",
        "Weakness of facial musculature",
        "Facial muscle weakness"@en,
        "Reduced facial muscle strength"@en ;
    ns1:synonym "Decreased facial muscle strength",
        "Decreased strength of facial muscles",
        "Facial muscle weakness",
        "Facial weakness",
        "Myasthenia of facial muscles",
        "Reduced facial muscle strength",
        "Weakness of face",
        "Weakness of facial musculature",
        "Face weakness"@en ;
    ns1:xref "UMLS:C4022514" .

<http://purl.obolibrary.org/obo/HP_0030320> rdfs:label "Increased intervertebral space" ;
    dcterms:description "An increase in the vertical distance between adjacent vertebral bodies, observed as an increase in the intervertebral disk space."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022513" .

<http://purl.obolibrary.org/obo/HP_0030351> rdfs:label "Urticarial plaque" ;
    dcterms:description "A well-circumscribed, intensely pruritic, raised wheal (edema of the superficial skin) typically 1 to 2 cm in diameter." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072895" .

<http://purl.obolibrary.org/obo/HP_0030384> rdfs:label "Decreased proportion of marginal zone B cells" ;
    dcterms:description "A reduction in the normal proportion of marginal zone B cells (CD19+/CD27+/IgM+/IgD+) in circulation relative to the total number of B cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072922" .

<http://purl.obolibrary.org/obo/HP_0030666> rdfs:label "Retinal neovascularization" ;
    dcterms:description "In ischemic retinal disease, neovascularization (NV) involves the sprouting of new vessels from pre-existent vessels. Ischemia invariably leads to the upregulation of Vascular Endothelial Growth Factor (VEGF) production. Most frequently the new vessels grow internal to the plane of the retina. However, intraretinal proliferation of new vessels can also occur."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal vascular proliferation" ;
    ns1:synonym "Retinal vascular proliferation" ;
    ns1:xref "SNOMEDCT_US:61267008",
        "UMLS:C0035320" .

<http://purl.obolibrary.org/obo/HP_0030793> rdfs:label "Jaw swelling" ;
    dcterms:description "Abnormal enlargement in the upper jaw (maxilla) or in the lower jaw (mandible)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280766" .

<http://purl.obolibrary.org/obo/HP_0030802> rdfs:label "Lower eyelid retraction" ;
    dcterms:description "Inferior malposition of the lower eyelid margin without eyelid eversion." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:700264006",
        "UMLS:C1861656" .

<http://purl.obolibrary.org/obo/HP_0030872> rdfs:label "Abnormal cardiac ventricular function" ;
    dcterms:description "An abnormality of the cardiac ventricular function." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280733" .

<http://purl.obolibrary.org/obo/HP_0031185> rdfs:label "Elevated circulating NT-proBNP concentration"@en ;
    dcterms:description "The concentration of NT-proBNP (= N-terminal pro-B-type natriuretic peptide, = N-terminal prohormone of brain natriuretic peptide) in the blood circulation is above the upper limit of normal."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased NT-proBNP level" ;
    ns1:synonym "Increased NT-proBNP level" .

<http://purl.obolibrary.org/obo/HP_0031191> rdfs:label "Deep dermal perivascular inflammatory infiltrate" ;
    dcterms:description "Numerous lymphocytes surrounding blood vessels in the deep part of the dermis."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Deep perivascular inflammatory infiltrate"@en ;
    ns1:synonym "Deep perivascular inflammatory infiltrate" .

<http://purl.obolibrary.org/obo/HP_0031545> rdfs:label "Abnormally low T cell receptor excision circle level" ;
    dcterms:description "Reduced level of T cell receptor excision circle (TRECs) as measured by the TREC assay. Late in maturation, 70% of thymocytes that will ultimately express alpha/beta-T cell receptors form a circular DNA TREC from the excised TCRdelta gene that lies within the TCRalpha genetic locus. The circles are stable but do not increase following cell division and, therefore, become diluted as T cells proliferate. A quantitative polymerase chain reaction (PCR) reaction across the joint of the circular DNA provides the TREC copy number, a marker of newly-formed, antigenically-naïve thymic emigrant T cells." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031606> rdfs:label "Retinal cotton wool spot" ;
    dcterms:description "Fluffy white patch in the inner retina, representing localized areas of dense white swelling of the retinal nerve fiber layer." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031688> rdfs:label "Erythroid dysplasia" ;
    dcterms:description "Dysplasia in the erythroid lineage, which presents with a variety of morphological changes in the bone marrow, including nuclear budding or irregular nuclear contour in erythroblasts." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Dyserythropoiesis" ;
    ns1:synonym "Dyserythropoiesis" .

<http://purl.obolibrary.org/obo/HP_0031689> rdfs:label "Megakaryocyte dysplasia" ;
    dcterms:description "The presence of micro-megakaryocytes, hypo-lobed, or non-lobed nuclei in megakaryocytes of all sizes and multiple, widely-separated nuclei." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysmegakaryopoiesis"@en ;
    ns1:synonym "Dysmegakaryopoiesis" .

<http://purl.obolibrary.org/obo/HP_0031693> rdfs:label "Severe Epstein Barr virus infection" ;
    dcterms:description "An unusually severe Epstein Barr virus (EBV) infection." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fulminant infectious mononucleosis",
        "Severe EBV infection"@en ;
    ns1:synonym "Fulminant infectious mononucleosis",
        "Severe EBV infection" .

<http://purl.obolibrary.org/obo/HP_0031972> rdfs:label "Presyncope" ;
    dcterms:description "Presyncope is a state of lightheadedness, muscular weakness, blurred vision, and feeling faint. Presyncope is most often cardiovascular in cause."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031987> rdfs:label "Diminished ability to concentrate"@en ;
    dcterms:description "The inability to focus or concentrate on a specific task, activity, or object. The subject may find themselves unable to grasp or understand written text and re-reads frequently without understanding. Familiar tasks or activities are severely compromised due to the lack of ability to concentrate. Thinking through multi-step problems is typically very difficult or impossible, leading to avoidance of such activities." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Concentration problems",
        "Labored thinking",
        "Lack of concentration",
        "Poor concentration" ;
    ns1:synonym "Lack of concentration",
        "Poor concentration",
        "Concentration problems"@en,
        "Labored thinking"@en .

<http://purl.obolibrary.org/obo/HP_0032024> rdfs:label "Ileal ulcer" ;
    dcterms:description "An erosion of the mucous membrane in a portion of the ileum."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032163> rdfs:label "Molluscum contagiosum" ;
    dcterms:description "Molluscum contagiosum is a cutaneous viral infection that is commonly observed in both healthy and immunocompromised children. The infection is caused by a member of the Poxviridae family, the molluscum contagiosum virus. Molluscum contagiosum presents as single or multiple small white or flesh-colored papules that typically have a central umbilication. The central umbilication may be difficult to observe in young children and, instead, may bear an appearance similar to an acneiform eruption. The lesions vary in size (from 1 mm to 1 cm in diameter) and are painless, although a subset of patients report pruritus in the area of infection. On average, 11-20 papules appear on the body during the course of infection and generally remains a self-limiting disease. However, in immunosuppressed patients, molluscum contagiosum can be a severe infection with hundreds of lesions developing on the body. Extensive eruption is indicative of an advanced immunodeficiency state."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032219> rdfs:label "Increased CD4+ T cell proportion" ;
    dcterms:description "Abnormal increase of helper CD3+CD4+ T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group. These are usually measured within the TCR alpha/beta positive population." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated helper T cell proportion",
        "Increased helper T cell proportion",
        "Increased proportion of CD4+ T cells",
        "Increased proportion of CD4-positive T cells",
        "Increased proportion of CD4-positive, alpha-beta T cells",
        "Elevated proportion of CD4-positive T cells"@en ;
    ns1:synonym "Elevated helper T cell proportion",
        "Elevated proportion of CD4-positive T cells",
        "Increased helper T cell proportion",
        "Increased proportion of CD4+ T cells",
        "Increased proportion of CD4-positive, alpha-beta T cells",
        "Increased proportion of CD4-positive T cells"@en .

<http://purl.obolibrary.org/obo/HP_0032252> rdfs:label "Granuloma" ;
    dcterms:description "A compact, organized collection of mature mononuclear phagocytes, which may be but is not necessarily accompanied by accessory features such as necrosis." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032263> rdfs:label "Increased blood pressure" ;
    dcterms:description "Abnormal increase in blood pressure. An individual measurement of increased blood pressure does not necessarily imply hypertension. In practical terms, multiple measurements are recommended to diagnose the presence of hypertension." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased BP"@en ;
    ns1:synonym "Increased BP"@en .

<http://purl.obolibrary.org/obo/HP_0032323> rdfs:label "Periodic fever"@en ;
    dcterms:description "Episodic fever that recurs at regular intervals."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032436> rdfs:label "Abnormal circulating C-reactive protein concentration" ;
    dcterms:description "Any deviation from the normal concentration of C-reactive protein in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal C-reactive protein level" ;
    ns1:synonym "Abnormal C-reactive protein level" .

<http://purl.obolibrary.org/obo/HP_0032564> rdfs:label "Ileitis"@en ;
    dcterms:description "Inflammation of the ileum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of the ileum" ;
    ns1:synonym "Inflammation of the ileum" .

<http://purl.obolibrary.org/obo/HP_0032948> rdfs:label "Renal interstitial fibrosis" ;
    dcterms:description "The accumulation of collagen and related extracellular matrix (ECM) molecules in the interstitium of the kidney. The interstitium is expanded by the presence of collagen that stain blue on trichrome. Tubules are not back to back, but rather separated by fibrosis and can be atrophic." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032979> rdfs:label "Hemosiderin-laden macrophages in bronchoalveolar fluid" ;
    dcterms:description "Hemosiderin-laden macrophages (HLM) in bronchoalveolar lavage (BAL) fluid were originally known as adiagnostic biomarker of alveolar hemorrhage, but have also been observed in idiopathic pulmonary fibrosis (IPF) with histopathological pattern of usual interstitial pneumonia (UIP)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Accumulation of hemosiderin laden alveolar macrophages",
        "Siderophages in bronchoalveolar fluid" ;
    ns1:synonym "Accumulation of hemosiderin laden alveolar macrophages",
        "Siderophages in bronchoalveolar fluid"@en .

<http://purl.obolibrary.org/obo/HP_0033040> rdfs:label "Anti-Sm antibody positivity" ;
    dcterms:description "The presence of autoantibodies in the serum that react to seven proteins that consist of a core of small nuclear ribonucleoprotein (snRNP) particles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-Smith autoantibody" ;
    ns1:synonym "Anti-Smith autoantibody" .

<http://purl.obolibrary.org/obo/HP_0033041> rdfs:label "Cytokine storm"@en ;
    dcterms:description "Excessive or uncontrolled release of proinflammatory cytokines." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypercytokinemia" ;
    ns1:synonym "Hypercytokinemia" .

<http://purl.obolibrary.org/obo/HP_0033106> rdfs:label "Elevated circulating D-dimer concentration" ;
    dcterms:description "An increased concentration of D-dimers, a marker of fibrin degradation, in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated D-dimers",
        "Elevated fibrin degradation fragment concentration" ;
    ns1:synonym "Elevated D-dimers",
        "Elevated fibrin degradation fragment concentration" .

<http://purl.obolibrary.org/obo/HP_0033117> rdfs:label "Duodenitis"@en ;
    dcterms:description "Inflammation of the lining of the upper small intestine (duodenum)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Duodenal inflammation" ;
    ns1:synonym "Duodenal inflammation" .

<http://purl.obolibrary.org/obo/HP_0033176> rdfs:label "Submandibular lymph node enlargement"@en ;
    dcterms:description "Increased size of the lymph nodes that are located beneath the mandible (lower jaw)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Submandibular lymphadenopathy" ;
    ns1:synonym "Submandibular lymphadenopathy" .

<http://purl.obolibrary.org/obo/HP_0033188> rdfs:label "Cystic acne" ;
    dcterms:description "A severe type of acne characterized by the formation of cysts enclosing a mixture of keratin and sebum."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033194> rdfs:label "Perioral erythema" ;
    dcterms:description "Erythema (Redness of the skin caused by hyperemia of the capillaries in the lower layers of the skin) localized to the region surrounding the mouth." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033195> rdfs:label "Perianal erythema" ;
    dcterms:description "Erythema (Redness of the skin caused by hyperemia of the capillaries in the lower layers of the skin) localized to the region surrounding the anus." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033199> rdfs:label "Increased circulating interleukin 10 concentration" ;
    dcterms:description "An elevation of the concentration of interleukin 10 in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum interleukin 10" ;
    ns1:synonym "Increased serum interleukin 10" .

<http://purl.obolibrary.org/obo/HP_0033221> rdfs:label "Increased CD4:CD8 ratio" ;
    dcterms:description "An abnormal elevation of the relative proportion of CD4+ to CD8+ T cells." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033250> rdfs:label "Nailfold capillary tortuosity" ;
    dcterms:description "An increased number of turns of the blood vessels of the nailfold with a charactereistic winded or twisted appearance of the blood vessels." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033253> rdfs:label "Reduced circulating interferon gamma concentration"@en ;
    dcterms:description "A reduction in the concentration of interferon gamma measured in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced circulating interferon gamma" ;
    ns1:synonym "Reduced circulating interferon gamma" .

<http://purl.obolibrary.org/obo/HP_0033260> rdfs:label "Livedo racemosa"@en ;
    dcterms:description "Livedo racemosa describes a reddish-blue mottling of the skin in an irregular, reticular pattern. It differs from the more common livedo reticularis by its shape. Livedo racemosa consists of broken circular segments resulting in a seemingly larger pattern, as opposed to the fine, regular, complete network of livedo reticularis. Livedo racemosa results from permanent impairment of peripheral blood flow and, unlike livedo reticularis, it persists on warming." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033261> rdfs:label "Renal artery aneurysm" ;
    dcterms:description "Increase in diameter of a segment of the renal artery that can be defined as a focal, isolated dilatation of all three layers of the arterial wall over 1.5 times the diameter of the disease-free proximal adjacent arterial segment." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033280> rdfs:label "Paratracheal lymphadenopathy" ;
    dcterms:description "Enlargement of lymph nodes surrounding the trachea." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033308> rdfs:label "Patellar overgrowth" ;
    dcterms:description "Excessive growth of the kneecap (patella)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033332> rdfs:label "Elevated circulating amyloid A concentration" ;
    dcterms:description "The concentration of serum amyloid A in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating amyloid A" ;
    ns1:synonym "Elevated circulating amyloid A"@en .

<http://purl.obolibrary.org/obo/HP_0033380> rdfs:label "Nasal chondritis" ;
    dcterms:description "Inflammation of the cartilage of the nose." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nose chondritis" ;
    ns1:synonym "Nose chondritis" .

<http://purl.obolibrary.org/obo/HP_0033425> rdfs:label "Periungual erythema" ;
