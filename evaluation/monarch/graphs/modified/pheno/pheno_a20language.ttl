<http://purl.obolibrary.org/obo/HP_0032638> rdfs:label "Elevated urine mevalonic acid level" ;
    dcterms:description "An abnormally increased amount of mevanolate in the urine. Mevanolate is that hydroxy monocarboxylic acid anion that is the conjugate base of mevalonic acid."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urine mevalonate",
        "Elevated urine mevalonate levels",
        "Mevalonate aciduria",
        "Elevated urine mevalonic acid"@en ;
    ns1:synonym "Elevated urine mevalonate",
        "Elevated urine mevalonate levels",
        "Mevalonate aciduria",
        "Elevated urine mevalonic acid"@en .

<http://purl.obolibrary.org/obo/HP_0033028> rdfs:label "Anti-U1 ribonucleoprotein antibody positivity"@en ;
    dcterms:description "The presence autoantibodies in the serum that react to proteins (70 Kd, A, C) that are associated with U1 RNA and form U1snRNP." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-RNP-antibodies",
        "Anti-U1-RNP antibody positivity" ;
    ns1:narrow_synonym "Anti-Scl-34 antibody positivity",
        "Anti-U3 ribonucleoprotein antibody positivity" ;
