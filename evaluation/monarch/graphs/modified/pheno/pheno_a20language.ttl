        "Anti-myeloperoxidase specific antineutrophil cytoplasmic antibody",
        "MPO-ANCA"@en ;
    ns1:synonym "Anti-myeloperoxidase specific antineutrophil cytoplasmic antibody",
        "MPO-ANCA",
        "Anti-MPO antibody positivity"@en .

<http://purl.obolibrary.org/obo/HP_0033605> rdfs:label "Pustular rash" ;
    dcterms:description "A rash composed of pustular lesions. A pustule is defined as a vesicle or bulla containing purulent material. It varies in size and may occur at different levels within the epidermis: subcorneal, intraepidermal, or basement membrane zones. The pustules may or may not be sterile and are normally filled with neutrophils." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Pustulosis" ;
    ns1:synonym "Pustulosis" .

<http://purl.obolibrary.org/obo/HP_0033631> rdfs:label "Spondylitis" ;
    dcterms:description "Inflammation of the vertebrae (vertebral bodies) or spine." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033748> rdfs:label "Hypoesthesia" ;
    dcterms:description "Decreased ability to perceive touch." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoaesthesia",
        "Numbness" ;
    ns1:synonym "Hypoaesthesia",
        "Numbness" .

<http://purl.obolibrary.org/obo/HP_0033833> rdfs:label "Elevated circulating sCD25 concentration" ;
    dcterms:description "The concentration of sCD25 (= soluble CD25, = soluble interleukin-2 receptor alpha-chain, = soluble IL-2 receptor alpha) in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating interleukin-2 receptor alpha-chain"@en ;
    ns1:synonym "Elevated circulating interleukin-2 receptor alpha-chain" .

<http://purl.obolibrary.org/obo/HP_0034156> rdfs:label "Anti-beta-2-Glycoprotein I IgG antibody positivity" ;
    dcterms:description "Presence of IgG antibodies against beta 2 glycoprotein I in the circulation. Beta-2 glycoprotein I (beta2GPI) is the principal target of autoantibodies in the antiphospholipid syndrome." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-beta2GPI IgG antibody positivity"@en ;
    ns1:synonym "Anti-beta2GPI IgG antibody positivity" .

