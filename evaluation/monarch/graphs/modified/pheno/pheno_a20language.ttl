<http://purl.obolibrary.org/obo/HP_0000510> rdfs:label "Rod-cone dystrophy" ;
    dcterms:description "An inherited retinal disease subtype in which the rod photoreceptors appear to be more severely affected than the cone photoreceptors. Typical presentation is with nyctalopia (due to rod dysfunction) followed by loss of mid-peripheral field of vision, which gradually extends and leaves many patients with a small central island of vision due to the preservation of macular cones." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinitis pigmentosa",
        "Rod cone dystrophy" ;
    ns1:synonym "Rod cone dystrophy",
        "Retinitis pigmentosa"@en ;
    ns1:xref "SNOMEDCT_US:28835009",
        "UMLS:C0035334" .

