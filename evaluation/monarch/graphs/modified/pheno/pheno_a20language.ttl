    ns1:exact_synonym "Eczema"@en ;
    ns1:related_synonym "Dermatitis" ;
    ns1:synonym "Eczema",
        "Dermatitis"@en ;
    ns1:xref "SNOMEDCT_US:281104002",
        "SNOMEDCT_US:43116000",
        "UMLS:C0013595" .

<http://purl.obolibrary.org/obo/HP_0000967> rdfs:label "Petechiae"@en ;
    dcterms:description "Petechiae are pinpoint-sized reddish/purple spots, resembling a rash, that appear just under the skin or a mucous membrane when capillaries have ruptured and some superficial bleeding into the skin has happened. This term refers to an abnormally increased susceptibility to developing petechiae." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "MEDDRA:10034754",
        "SNOMEDCT_US:271813007",
        "SNOMEDCT_US:50091001",
        "UMLS:C0031256" .

<http://purl.obolibrary.org/obo/HP_0001034> rdfs:label "Hypermelanotic macule"@en ;
