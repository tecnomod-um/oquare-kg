        "UMLS:C0237849"@en .

<http://purl.obolibrary.org/obo/HP_0040313> rdfs:label "Oligoarthritis"@en ;
    dcterms:description "A type of arthritis that affects up to four joints in the first six months of disease." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0100255> rdfs:label "Metaphyseal dysplasia" ;
