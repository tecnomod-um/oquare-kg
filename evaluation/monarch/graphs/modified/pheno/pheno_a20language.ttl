    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neutrophil migratory defect"@en ;
    ns1:synonym "Neutrophil migratory defect"@en ;
    ns1:xref "UMLS:C4280709" .

<http://purl.obolibrary.org/obo/HP_0040270> rdfs:label "Impaired glucose tolerance" ;
