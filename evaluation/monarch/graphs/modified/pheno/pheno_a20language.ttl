    ns1:synonym "Glucose tolerance decreased",
        "Decreased glucose tolerance"@en ;
    ns1:xref "UMLS:C0151671",
        "MP:0005291"@en .

<http://purl.obolibrary.org/obo/HP_0040303> rdfs:label "Decreased circulating iron concentration"@en ;
