<http://purl.obolibrary.org/obo/HP_0000006> rdfs:label "Autosomal dominant inheritance" ;
    dcterms:description "A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in heterozygotes. In the context of medical genetics, an autosomal dominant disorder is caused when a single copy of the mutant allele is present. Males and females are affected equally, and can both transmit the disorder with a risk of 50% for each child of inheriting the mutant allele." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "monoallelic_autosomal",
        "Autosomal dominant"@en ;
    ns1:related_synonym "Autosomal dominant form",
        "Autosomal dominant type" ;
    ns1:synonym "Autosomal dominant",
        "Autosomal dominant form",
        "Autosomal dominant type",
        "monoallelic_autosomal" ;
    ns1:xref "SNOMEDCT_US:263681008",
        "UMLS:C0443147" .

<http://purl.obolibrary.org/obo/HP_0000007> rdfs:label "Autosomal recessive inheritance"@en ;
    dcterms:description "A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in individuals with two pathogenic alleles, either homozygotes (two copies of the same mutant allele) or compound heterozygotes (whereby each copy of a gene has a distinct mutant allele)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Autosomal recessive",
        "biallelic_autosomal" ;
    ns1:related_synonym "Autosomal recessive form",
        "Autosomal recessive predisposition" ;
    ns1:synonym "Autosomal recessive",
        "Autosomal recessive form",
        "Autosomal recessive predisposition",
        "biallelic_autosomal" ;
    ns1:xref "SNOMEDCT_US:258211005",
        "UMLS:C0441748",
        "UMLS:C4020899"@en .

<http://purl.obolibrary.org/obo/HP_0000010> rdfs:label "Recurrent urinary tract infections" ;
    dcterms:description "Repeated infections of the urinary tract." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Frequent urinary tract infections",
        "Urinary tract infections",
        "Urinary tract infections, recurrent",
        "Recurrent UTIs"@en,
        "Repeated bladder infections"@en,
        "Repeated urinary tract infections"@en ;
    ns1:synonym "Frequent urinary tract infections",
        "Recurrent UTIs",
        "Repeated bladder infections",
        "Urinary tract infections",
        "Urinary tract infections, recurrent",
        "Repeated urinary tract infections"@en ;
    ns1:xref "UMLS:C0262655",
        "SNOMEDCT_US:197927001"@en .

<http://purl.obolibrary.org/obo/HP_0000023> rdfs:label "Inguinal hernia"@en ;
    dcterms:description "Protrusion of the contents of the abdominal cavity through the inguinal canal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:396232000",
        "UMLS:C0019294",
        "MEDDRA:10022016"@en .

<http://purl.obolibrary.org/obo/HP_0000047> rdfs:label "Hypospadias" ;
    dcterms:description "Abnormal position of urethral meatus on the ventral penile shaft (underside) characterized by displacement of the urethral meatus from the tip of the glans penis to the ventral surface of the penis, scrotum, or perineum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypospadia" ;
    ns1:synonym "Hypospadia" ;
    ns1:xref "SNOMEDCT_US:204888000",
        "UMLS:C1691215",
        "Fyler:4504"@en .

<http://purl.obolibrary.org/obo/HP_0000050> rdfs:label "Hypoplastic male external genitalia" ;
    dcterms:description "Underdevelopment of part or all of the male external reproductive organs (which include the penis, the scrotum and the urethra)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplastic male genitalia",
        "Underdeveloped male genitalia",
        "Small male external genitalia"@en ;
    ns1:synonym "Hypoplastic male genitalia",
        "Small male external genitalia"@en,
        "Underdeveloped male genitalia"@en ;
    ns1:xref "UMLS:C1852534" .

