<http://purl.obolibrary.org/obo/HP_0000618> rdfs:label "Blindness" ;
    dcterms:description "Blindness is the condition of lacking visual perception defined as a profound reduction in visual perception. On the 6m visual acuity scale, blindness is defined as less than 3/60. On the 20ft visual acuity scale, blindness is defined as less than 20/400. On the decimal visual acuity scale, blindness is defined as less than 0.05. Blindness is typically characterized by a visual field of no greater than 10 degrees in radius around central fixation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blindness",
        "Total vision loss"@en ;
    ns1:related_synonym "Legal blindness" ;
    ns1:synonym "Blindness",
        "Legal blindness",
        "Total vision loss" ;
    ns1:xref "Fyler:4866",
        "SNOMEDCT_US:65956007",
        "UMLS:C0271215",
        "UMLS:C0456909" .

<http://purl.obolibrary.org/obo/HP_0000677> rdfs:label "Oligodontia" ;
