<http://purl.obolibrary.org/obo/HP_0002062> rdfs:label "Abnormal pyramidal tract morphology"@en ;
    dcterms:description "Any structural abnormality of the pyramidal tract, whose chief element, the corticospinal tract, is the only direct connection between the brain and the spinal cord. In addition to the corticospinal tract, the pyramidal system includes the corticobulbar, corticomesencephalic, and corticopontine tracts." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Morphological abnormality of the pyramidal tract",
        "Abnormality of the pyramidal tracts"@en ;
