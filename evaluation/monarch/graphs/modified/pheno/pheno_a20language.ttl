    ns1:synonym "Growth of abnormal tissue on or under the skin" ;
    ns1:xref "UMLS:C0037287",
        "SNOMEDCT_US:95319004"@en .

<http://purl.obolibrary.org/obo/HP_0200037> rdfs:label "Skin vesicle" ;
    dcterms:description "A circumscribed, fluid-containing, epidermal elevation less than 10mm in diameter at the widest point that (i) Contain serous exudates or serum mixed with blood or pus; (ii) Are discrete, grouped, irregularly distributed, or linear as in Rhus dermatitis; (iii) Are short-lived. Vesicles may break spontaneously or evolve into bullae by enlarging or coalescing with other vesicles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3814530" .

<http://purl.obolibrary.org/obo/HP_0200047> rdfs:label "Chondritis of pinna" ;
    dcterms:description "Inflammation of the cartilage of the external ear." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of cartilage of pinna" ;
    ns1:synonym "Inflammation of cartilage of pinna" ;
    ns1:xref "UMLS:C0741305" .

<http://purl.obolibrary.org/obo/HP_0200056> rdfs:label "Macular scar"@en ;
    dcterms:description "Fibrous connective tissue consequent upon healing of a wound (i.e., a scar) located in the macula." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular scarring" ;
    ns1:synonym "Macular scarring" ;
    ns1:xref "SNOMEDCT_US:18410006",
        "UMLS:C0423428" .

<http://purl.obolibrary.org/obo/HP_0200057> rdfs:label "Marcus Gunn pupil"@en ;
    dcterms:description "An aberrant pupillary response characterized by (i) Constriction of pupils of both eyes when the light stimulus is applied to the normal eye, and (ii) Dilatation of pupils of both eyes when the light stimulus is rapidly transferred from the normal eye (after brief light exposure to the normal eye) to the affected eye." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Relative afferent pupil defect",
        "Relative afferent pupillary defect" ;
    ns1:synonym "Relative afferent pupil defect",
        "Relative afferent pupillary defect" ;
    ns1:xref "SNOMEDCT_US:232122003",
        "SNOMEDCT_US:247015002",
        "UMLS:C0549122" .

<http://purl.obolibrary.org/obo/HP_0200123> rdfs:label "Chronic hepatitis"@en ;
    dcterms:description "Hepatitis that lasts for more than six months." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic liver inflammation"@en ;
    ns1:synonym "Chronic liver inflammation" ;
    ns1:xref "SNOMEDCT_US:76783007",
        "UMLS:C0019189" .

<http://purl.obolibrary.org/obo/HP_0410174> rdfs:label "Increased circulating troponin T concentration" ;
    dcterms:description "An increased concentration of tropnin T in the blood, which is a cardiac regulatory protein that controls the calcium mediated interaction between actin and myosin. Raised cardiac troponin concentrations are now accepted as the standard biochemical marker for the diagnosis of myocardial infarction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased troponin T level in blood" ;
    ns1:synonym "Increased troponin T level in blood"@en .

<http://purl.obolibrary.org/obo/HP_0410242> rdfs:label "Abnormal circulating IgG concentration" ;
    dcterms:description "An abnormal deviation from normal levels of IgG immunoglobulin in blood." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal circulating IgG level",
        "Abnormal IgG level in blood"@en ;
    ns1:synonym "Abnormal IgG level in blood"@en,
        "Abnormal circulating IgG level"@en .

<http://purl.obolibrary.org/obo/HP_0410243> rdfs:label "Abnormal circulating IgM concentration" ;
    dcterms:description "An abnormal deviation from normal levels of IgM immunoglobulin in blood." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal circulating IgM level",
        "Abnormal IgM level in blood"@en ;
    ns1:synonym "Abnormal IgM level in blood",
        "Abnormal circulating IgM level" .

<http://purl.obolibrary.org/obo/HP_0410300> rdfs:label "Complete or near-complete absence of specific antibody response to unconjugated pneumococcus vaccine" ;
    dcterms:description "The inability to synthesize postvaccination antibodies against a pneumococcus antigen, as measured by antibody titer determination following vaccination." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0500271> rdfs:label "Decreased gamma-delta T cell proportion" ;
    dcterms:description "Abnormal decrease of TCR gamma/delta positive T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased proportion of gamma-delta T lymphocytes",
        "Decreased proportion of gamma-delta T-cells",
        "Decreased proportion of gamma-delta T-lymphocytes",
        "Decreased proportion of gammadelta T cells",
        "Reduced proportion of gamma-delta T cells" ;
    ns1:synonym "Decreased proportion of gamma-delta T-cells",
        "Decreased proportion of gamma-delta T-lymphocytes",
        "Decreased proportion of gammadelta T cells",
        "Reduced proportion of gamma-delta T cells",
        "Decreased proportion of gamma-delta T lymphocytes"@en .

<http://purl.obolibrary.org/obo/HP_4000025> rdfs:label "Anti-integrin antibody positivity"@en ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against an integrin. Integrins are a family of cell adhesion molecules with 24 known integrin heterodimers. Integrins transduce mechanical and biochemical signals from fibrotic extracellular matrix into the cell, activate latent TGFbeta, and subsequently modulate fibroblast adhesion, migration, and growth." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_4000031> rdfs:label "Anti-type VII collagen antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against collagen type VII."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_4000037> rdfs:label "Congenital hydrocele" ;
    dcterms:description "Congenital hydrocele occurs when processus vaginalis is patent and communicates with the peritoneal cavity. This communication allows the movement of peritoneal fluid but is too small to allow the intra-abdominal contents to herniate through." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_4000041> rdfs:label "AA amyloidosis" ;
    dcterms:description "Extracellular tissue deposition of fibrils that are composed of fragments of and/or intact serum amyloid A protein, a hepatic acute phase reactant." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000239> rdfs:label "Elevated circulating tumor necrosis factor alpha concentration" ;
    dcterms:description "The concentration of tumor necrosis factor alpha in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000263> rdfs:label "Papillary dermal edema" ;
    dcterms:description "Swelling due to fluid acculuation of the papillary dermis." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000374> rdfs:label "Increased circulating interleukin 1beta concentration"@en ;
    dcterms:description "An increased concentration of interleukin-1beta in the blood circulation."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000441> rdfs:label "Abnormal circulating interleukin 6 concentration"@en ;
    dcterms:description "Any deviation from the normal range of the concentration of interleukin 6 (IL-6) in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000562> rdfs:label "Reduced circulating adenosine deaminase-2 activity" ;
    dcterms:description "Concentration of adenosine deaminase 2 in the blood circulation below the lower limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced circulating ADA2 activity"@en ;
    ns1:synonym "Reduced circulating ADA2 activity" .

<http://purl.obolibrary.org/obo/HP_6000606> rdfs:label "Elevated urinary D-glyceric acid level"@en ;
    dcterms:description "The amount of D-glyceric acid in the urine, normalized for urine concentration, is above the upper limit of normal."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000715> rdfs:label "Central giant cell lesion of the jaw" ;
    dcterms:description "A benign proliferative and asymptomatic intraosseous lesion of the jaw formed by fibrous tissue that contains multiple focus of hemorrhage and an aggregation of multinucleated giant cells." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000933> rdfs:label "Koebner Phenomenon" ;
    dcterms:description "The appearance of new skin lesions on previously unaffected skin secondary to trauma. This phenomenon is also termed the isomorphic (from Greek, equal shape) response, given the fact that the new lesions that appear are clinically and histologically identical to the patient's underlying cutaneous disease."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/MONDO_0001709> rdfs:label "hypercalcemic sarcoidosis" ;
    dcterms:description "Sarcoidosis with a complication of hypercalcemia."@en ;
    ns1:category ns1:Disease ;
    ns1:xref "DOID:13407",
        "MEDGEN:272729",
        "NCIT:C35807",
        "UMLS:C1334067",
        "GARD:0022994"@en .

<http://purl.obolibrary.org/obo/MONDO_0008429> rdfs:label "Singleton-Merten dysplasia" ;
    dcterms:description "Singleton-Merten dysplasia is characterized by dental dysplasia, progressive calcification of the thoracic aorta with stenosis, osteoporosis and expansion of the marrow cavities in hand bones. Additional features included generalized muscle weakness and atrophy, and chronic psoriasiform skin eruptions. It has been reported in four unrelated patients (male and female) and in a family with multiple affected members (male)." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Merten-Singleton syndrome",
        "Singleton Merten syndrome",
        "Singleton-Merten syndrome",
        "singleton Merten syndrome" ;
