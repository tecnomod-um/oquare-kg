        "Quincke oedema"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:400075008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0002994"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:41291007" .

