        "Wide bregma sutures"^^<http://example.org/invalidDatatype>,
        "Wide fontanelles"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:276709006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0456132"^^<http://example.org/invalidDatatype>,
        "UMLS:C4072820"^^<http://example.org/invalidDatatype>,
        "UMLS:C4072821"^^<http://example.org/invalidDatatype>,
        "UMLS:C4072822"^^<http://example.org/invalidDatatype> .

