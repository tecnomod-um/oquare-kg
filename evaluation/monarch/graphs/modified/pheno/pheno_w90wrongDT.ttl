        "SNOMEDCT_US:24079001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0011615"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280605"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001085> rdfs:label "Papilledema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Papilledema refers to edema (swelling) of the optic disc secondary to any factor which increases cerebral spinal fluid pressure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Papillitis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Papillitis"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:423341008"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:73221001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0030353"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:248487006" .

<http://purl.obolibrary.org/obo/HP_0001156> rdfs:label "Brachydactyly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Digits that appear disproportionately short compared to the hand/foot. The word brachydactyly is used here to describe a series distinct patterns of shortened digits (brachydactyly types A-E). This is the sense used here."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brachydactyly syndrome"^^<http://example.org/invalidDatatype>,
        "Short fingers or toes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Brachydactyly syndrome"^^<http://example.org/invalidDatatype>,
        "Short fingers or toes" ;
    ns1:xref "SNOMEDCT_US:43476002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0221357" .

<http://purl.obolibrary.org/obo/HP_0001260> rdfs:label "Dysarthria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dysarthric speech is a general description referring to a neurological speech disorder characterized by poor articulation. Depending on the involved neurological structures, dysarthria may be further classified as spastic, flaccid, ataxic, hyperkinetic and hypokinetic, or mixed."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Difficulty articulating speech"^^<http://example.org/invalidDatatype>,
        "Dysarthric speech"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dysarthric speech"^^<http://example.org/invalidDatatype>,
        "Difficulty articulating speech" ;
    ns1:xref "SNOMEDCT_US:8011004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0013362"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001264> rdfs:label "Spastic diplegia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Spasticity (neuromuscular hypertonia) primarily in the muscles of the legs, hips, and pelvis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spastic diparesis"^^<http://example.org/invalidDatatype>,
        "Spastic diplegic"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Spastic diparesis"^^<http://example.org/invalidDatatype>,
        "Spastic diplegic"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:281411007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0023882"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001285> rdfs:label "Spastic tetraparesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Spastic weakness affecting all four limbs."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spastic quadriparesis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Spastic quadriparesis"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:298282001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0575059"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001291> rdfs:label "Abnormal cranial nerve morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Structural abnormality affecting one or more of the cranial nerves, which emerge directly from the brain stem."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of cranial nerve"^^<http://example.org/invalidDatatype>,
        "Abnormality of the cranial nerves"^^<http://example.org/invalidDatatype>,
