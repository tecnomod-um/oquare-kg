<http://purl.obolibrary.org/obo/HP_0001942> rdfs:label "Metabolic acidosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Metabolic acidosis (MA) is characterized by a fall in blood pH due to a reduction of serum bicarbonate concentration. This can occur as a result of either the accumulation of acids (high anion gap MA) or the loss of bicarbonate from the gastrointestinal tract or the kidney (hyperchloremic MA). By definition, MA is not due to a respirary cause."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:59455009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0220981"^^<http://example.org/invalidDatatype> .

