        "Increased erythrocyte sedimentation rate"^^<http://example.org/invalidDatatype>,
        "Raised erythrocyte sedimentation rate"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated ESR"^^<http://example.org/invalidDatatype>,
