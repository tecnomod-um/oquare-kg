<http://purl.obolibrary.org/obo/HP_0001036> rdfs:label "Parakeratosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal formation of the keratinocytes of the epidermis characterized by persistence of nuclei, incomplete formation of keratin, and moistness and swelling of the keratinocytes."^^<http://example.org/invalidDatatype> ;
