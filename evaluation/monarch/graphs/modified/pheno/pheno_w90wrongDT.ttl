<http://purl.obolibrary.org/obo/HP_0001878> rdfs:label "Hemolytic anemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of anemia caused by premature destruction of red blood cells (hemolysis)."^^<http://example.org/invalidDatatype> ;
