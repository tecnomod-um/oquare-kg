<http://purl.obolibrary.org/obo/MONDO_0800137> rdfs:label "early-onset pulmonary and cutaneous vasculitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A monogenic autoinflammatory disorder caused by a de novo activating mutation, p.Tyr515∗, in hematopoietic cell kinase (HCK). The disease is characterized by cutaneous vasculitis and chronic pulmonary inflammation that progresses to fibrosis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:xref "GARD:0026453"^^<http://example.org/invalidDatatype> .

