<http://purl.obolibrary.org/obo/HP_0001904> rdfs:label "Autoimmune neutropenia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal decrease of the absolute number of neutrophils in the blood, per microlitre, compared to a reference range for a given sex and age-group, accompanied by the detection of anti-neutrophil antibodies."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
