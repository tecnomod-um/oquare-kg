<http://purl.obolibrary.org/obo/HP_0025092> rdfs:label "Epidermal acanthosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diffuse hypertrophy or thickening of the stratum spinosum of the epidermis (prickle cell layer of the skin)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Acanthotic epidermis"^^<http://example.org/invalidDatatype>,
        "Acanthosis",
