        "SNOMEDCT_US:86299006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0039685"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001638> rdfs:label "Cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A myocardial disorder in which the heart muscle is structurally and functionally abnormal, in the absence of coronary artery disease, hypertension, valvular disease and congenital heart disease sufficient to cause the observed myocardial abnormality."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Disease of the heart muscle"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Disease of the heart muscle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "Fyler:1840"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:57809008"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:85898001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0878544"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001639> rdfs:label "Hypertrophic cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hypertrophic cardiomyopathy (HCM) is defined by the presence of increased ventricular wall thickness or mass in the absence of loading conditions (hypertension, valve disease) sufficient to cause the observed abnormality."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cardiomyopathy, hypertrophic"^^<http://example.org/invalidDatatype>,
        "Enlarged and thickened heart muscle"^^<http://example.org/invalidDatatype>,
        "HCM"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Cardiomyopathy, hypertrophic"^^<http://example.org/invalidDatatype>,
        "Enlarged and thickened heart muscle"^^<http://example.org/invalidDatatype>,
        "HCM"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:233873004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:45227007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0007194"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001643> rdfs:label "Patent ductus arteriosus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "In utero, the ductus arteriosus (DA) serves to divert ventricular output away from the lungs and toward the placenta by connecting the main pulmonary artery to the descending aorta. A patent ductus arteriosus (PDA) in the first 3 days of life is a physiologic shunt in healthy term and preterm newborn infants, and normally is substantially closed within about 24 hours after bith and completely closed after about three weeks. Failure of physiologcal closure is referred to a persistent or patent ductus arteriosus (PDA). Depending on the degree of left-to-right shunting, PDA can have clinical consequences." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ductus arteriosus"^^<http://example.org/invalidDatatype>,
        "PDA"^^<http://example.org/invalidDatatype>,
        "Patent ductus Botalli"^^<http://example.org/invalidDatatype>,
        "Persistent arterial duct"^^<http://example.org/invalidDatatype>,
        "Persistent ductus arteriosus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "PDA"^^<http://example.org/invalidDatatype>,
        "Patent ductus Botalli"^^<http://example.org/invalidDatatype>,
        "Persistent arterial duct"^^<http://example.org/invalidDatatype>,
        "Persistent ductus arteriosus"^^<http://example.org/invalidDatatype>,
        "Ductus arteriosus" ;
    ns1:xref "Fyler:2100"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:83330001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0013274"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001650> rdfs:label "Aortic valve stenosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a stenosis (narrowing) of the aortic valve."^^<http://example.org/invalidDatatype> ;
