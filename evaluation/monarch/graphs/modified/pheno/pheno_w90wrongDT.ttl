        "Muscle hypotonia"^^<http://example.org/invalidDatatype>,
        "Muscular hypotonia"^^<http://example.org/invalidDatatype>,
        "Peripheral hypotonia"^^<http://example.org/invalidDatatype>,
        "Low muscle tone" ;
    ns1:xref "SNOMEDCT_US:398151007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:398152000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0026827"^^<http://example.org/invalidDatatype> .

