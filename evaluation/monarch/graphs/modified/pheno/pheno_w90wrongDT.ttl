<http://purl.obolibrary.org/obo/HP_0000618> rdfs:label "Blindness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Blindness is the condition of lacking visual perception defined as a profound reduction in visual perception. On the 6m visual acuity scale, blindness is defined as less than 3/60. On the 20ft visual acuity scale, blindness is defined as less than 20/400. On the decimal visual acuity scale, blindness is defined as less than 0.05. Blindness is typically characterized by a visual field of no greater than 10 degrees in radius around central fixation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blindness"^^<http://example.org/invalidDatatype>,
        "Total vision loss"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Legal blindness"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Blindness"^^<http://example.org/invalidDatatype>,
        "Legal blindness"^^<http://example.org/invalidDatatype>,
        "Total vision loss"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:65956007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0271215"^^<http://example.org/invalidDatatype>,
        "Fyler:4866",
        "UMLS:C0456909" .

