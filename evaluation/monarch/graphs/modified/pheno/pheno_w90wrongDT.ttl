<http://purl.obolibrary.org/obo/HP_0012377> rdfs:label "Hemianopia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Partial or complete loss of vision in one half of the visual field of one or both eyes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hemianopsia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hemianopsia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:77674003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0018979"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012390> rdfs:label "Anal fissure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A small tear in the thin, moist tissue (mucosa) that lines the anus. It appears as a crack or slit in the mucous membrane of the anus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Anal erosion"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anal erosion"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:20928004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:30037006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0016167"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012424> rdfs:label "Chorioretinitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An inflammation of the choroid and retina."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:46627006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0008513"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012432> rdfs:label "Chronic fatigue"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Subjective feeling of tiredness characterized by a lack of energy and motivation that persists for six months or longer."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic extreme exhaustion"^^<http://example.org/invalidDatatype>,
        "Chronic fatigue"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Chronic extreme exhaustion"^^<http://example.org/invalidDatatype>,
        "Chronic fatigue"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0518656"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012444> rdfs:label "Brain atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Partial or complete wasting (loss) of brain tissue that was once present."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brain degeneration"^^<http://example.org/invalidDatatype>,
        "Brain wasting"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Brain degeneration"^^<http://example.org/invalidDatatype>,
        "Brain wasting"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:278849000"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:418143002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:52522001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0154671"^^<http://example.org/invalidDatatype>,
        "UMLS:C0235946"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012534> rdfs:label "Dysesthesia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Painful sensations elicited by a nonpainful cutaneous stimulus such as a light touch or gentle stroking over affected areas of the body. Sometimes referred to as hyperpathia or hyperalgesia. Often perceived as an intense burning, dyesthesias may outlast the stimulus by several seconds."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysaesthesia"^^<http://example.org/invalidDatatype>,
        "Hyperalgesia"^^<http://example.org/invalidDatatype>,
        "Hyperpathia"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Dysesthesias"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dysaesthesia"^^<http://example.org/invalidDatatype>,
        "Dysesthesias"^^<http://example.org/invalidDatatype>,
        "Hyperalgesia"^^<http://example.org/invalidDatatype>,
        "Hyperpathia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0392699"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:279079003" .

<http://purl.obolibrary.org/obo/HP_0012544> rdfs:label "Elevated circulating aldolase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of fructose 1,6-bisphosphate aldolase in the blood circulation above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated aldolase level" ;
    ns1:synonym "Elevated aldolase level"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022858"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012574> rdfs:label "Mesangial hypercellularity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased numbers of mesangial cells per glomerulus, defined as more than 3 nuclei fully surrounded by matrix in one or more mesangial areas, not including perihilar region, on a standard 3-micron-thick tissue section, best evaluated on periodic acid-Schiff (PAS) stain."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mesangial proliferation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Mesangial proliferation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:125510009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0545017"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012593> rdfs:label "Nephrotic range proteinuria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Severely increased amount of excretion of protein in the urine, defined as 3.5 grams per day or more in adults and 40 mg per meter-squared body surface area per hour in children."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:264867001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0445118"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012649> rdfs:label "Increased inflammatory response"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A abnormal increase in the inflammatory response to injury or infection."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022803"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012722> rdfs:label "Heart block"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Impaired conduction of cardiac impulse occurring anywhere along the conduction pathway."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:233916004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0018794"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012758> rdfs:label "Neurodevelopmental delay" ;
    dcterms:description "Neurodevelopmental delay (NDD) refers to delays in the maturation of the brain and central nervous system; infants and young children with NDD may experience delays in the development of one or more skills including gross motor abilities, fine-motor coordination, language abilities and ability to solve increasingly complex problems." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "NDD"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "NDD"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022738"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012785> rdfs:label "Flexion contracture of finger"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Chronic loss of joint motion in a finger due to structural changes in non-bony tissue."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flexion deformity of finger"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Flexion deformity of finger"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1857304"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012802> rdfs:label "Broad jaw" ;
    dcterms:description "Bigonial distance (lower facial width) more than 2 SD above the mean (objective); or an apparently increased width of the lower jaw (mandible) when viewed from the front (subjective)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad jaw"^^<http://example.org/invalidDatatype>,
        "Broad lower face"^^<http://example.org/invalidDatatype>,
        "Wide jaw"^^<http://example.org/invalidDatatype>,
        "Wide mandible"^^<http://example.org/invalidDatatype>,
        "Broad mandible" ;
    ns1:synonym "Broad jaw"^^<http://example.org/invalidDatatype>,
        "Broad lower face"^^<http://example.org/invalidDatatype>,
        "Broad mandible"^^<http://example.org/invalidDatatype>,
        "Wide jaw"^^<http://example.org/invalidDatatype>,
        "Wide mandible"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C3281059"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012819> rdfs:label "Myocarditis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the myocardium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of heart muscle"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Inflammation of heart muscle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:50920009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0027059" .

<http://purl.obolibrary.org/obo/HP_0020062> rdfs:label "Decreased hemoglobin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal reduction below normal hemoglobin concentration in the circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased Hb concentration"^^<http://example.org/invalidDatatype>,
        "Decreased haemoglobin concentration" ;
    ns1:synonym "Decreased Hb concentration"^^<http://example.org/invalidDatatype>,
        "Decreased haemoglobin concentration" .

<http://purl.obolibrary.org/obo/HP_0020086> rdfs:label "BCGitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Local or regional infection with Bacillus Calmette-Guerin (BCG) following vaccination."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025066> rdfs:label "Decreased mean corpuscular volume"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction from normal of the mean corpuscular volume, or mean cell volume (MCV) of red blood cells (usually defined as an MCV below 80 femtoliters)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased MCV"^^<http://example.org/invalidDatatype>,
        "Microcytosis"^^<http://example.org/invalidDatatype>,
        "Reduced erythrocyte volume"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Microcytosis"^^<http://example.org/invalidDatatype>,
        "Reduced erythrocyte volume"^^<http://example.org/invalidDatatype>,
        "Decreased MCV" .

<http://purl.obolibrary.org/obo/HP_0025156> rdfs:label "Dependency on intravenous nutrition"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inability to be weaned from intravenous (parenteral) nutrition, as judged by the hydration status (urine output, blood urea nitrogen, creatinine, urine sodium concentration), ability to maintain weight, stool output, and serum electrolyte status."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dependency on IV nutrition"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dependency on IV nutrition"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025230> rdfs:label "Tendonitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of a tendon."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Teninitis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Teninitis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025252> rdfs:label "Geographic tongue"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of the tongue characterized by loss (atrophy) of filiform papillae of the tongue, leaving areas of erythema (redness), surrounded by a serpiginous, white, hyperkeratotic border. The name geographic tongue refers to an appearance that is said to be similar to a map."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Annulus migrans"^^<http://example.org/invalidDatatype>,
        "Benign migratory glossitis"^^<http://example.org/invalidDatatype>,
        "Glossitis areata exfoliativa"^^<http://example.org/invalidDatatype>,
        "Lingual erythema migrans"^^<http://example.org/invalidDatatype>,
        "Wandering rash of the tongue"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Annulus migrans"^^<http://example.org/invalidDatatype>,
        "Benign migratory glossitis"^^<http://example.org/invalidDatatype>,
        "Lingual erythema migrans"^^<http://example.org/invalidDatatype>,
        "Wandering rash of the tongue"^^<http://example.org/invalidDatatype>,
        "Glossitis areata exfoliativa" .

<http://purl.obolibrary.org/obo/HP_0025300> rdfs:label "Malar rash"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An erythematous (red), flat facial rash that affects the skin in the malar area (over the cheekbones) and extends over the bridge of the nose."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Butterfly rash"^^<http://example.org/invalidDatatype>,
        "Cheekbone rash"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Butterfly rash"^^<http://example.org/invalidDatatype>,
        "Cheekbone rash"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025420> rdfs:label "Diffuse alveolar hemorrhage"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of of pulmonary hemorrhage that originates from the pulmonary microcirculation, including the alveolar capillaries, arterioles, and venules. It presents with hemoptysis, anemia, diffuse lung infiltration, and acute respiratory failure. The diagnosis is confirmed by the observation of the accumulation of red blood cells, fibrin, or hemosiderin-laden macrophage in the alveolar space on pathologic biopsy. Hemosiderin, a product of hemoglobin degradation, appears at least 48-72 hours after bleeding and is helpful in distinguishing diffuse alveolar hemorrhage from surgical trauma. Mild interstitial thickening, organizing pneumonia, or diffuse alveolar damage can also be seen."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Diffuse alveolar haemorrhage"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Diffuse alveolar haemorrhage"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025526> rdfs:label "Psoriasiform lesion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A skin lesions that resembles the lesions observed in psoriasis, viz., an erythematous plaque covered by fine silvery scales. Psoriasiform lesions can be observed in psoriasis as well as in other conditions including allergic contact dermatitis, seborrhoeic dermatitis, Atopic dermatitis, pityriasis rubra, and lichen simplex chronicus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Psoriatic-like lesion" ;
    ns1:related_synonym "Erythemato-squamous plaque"^^<http://example.org/invalidDatatype>,
        "Erythematosquamous plaque" ;
    ns1:synonym "Erythematosquamous plaque"^^<http://example.org/invalidDatatype>,
        "Psoriatic-like lesion"^^<http://example.org/invalidDatatype>,
        "Erythemato-squamous plaque" .

<http://purl.obolibrary.org/obo/HP_0025528> rdfs:label "Annular cutaneous lesion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A lesion of the skin with a ring-like distribution."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025615> rdfs:label "Abscess"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abscess is a localized collection of purulent material surrounded by inflammation and granulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025616> rdfs:label "Sterile abscess"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abscess not caused by infection with pyogenic bacteria. Operationally, a sterile abscess is inferred if investigations of an abscess fail to reveal evidence of pathogenic organisms."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030043> rdfs:label "Hip subluxation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A partial dislocation of the hip joint, whereby the head of the femur is partially displaced from the socket."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial hip dislocation"^^<http://example.org/invalidDatatype>,
        "Subluxation involving the hip joint"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Partial hip dislocation"^^<http://example.org/invalidDatatype>,
        "Subluxation involving the hip joint"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:263057000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0434785"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030047> rdfs:label "Abnormal lateral ventricle morphology" ;
    dcterms:description "A morphological anomaly of the lateral ventricle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of lateral ventricle"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of lateral ventricle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022662"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030057> rdfs:label "Autoimmune antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of an antibody in the blood circulation that is directed against the organism's own cells or tissues."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022660"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030084> rdfs:label "Clinodactyly" ;
    dcterms:description "An angulation of a digit at an interphalangeal joint in the plane of the palm (finger) or sole (toe)."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Curvature of digit" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Permanent curving of the finger"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Curvature of digit"^^<http://example.org/invalidDatatype>,
        "Permanent curving of the finger"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:17268007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265610"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280304"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030146> rdfs:label "Abnormal liver parenchyma morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A structural anomaly of the liver located predominantly in the hepatocytes as opposed to stromal cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022605"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030149> rdfs:label "Cardiogenic shock"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Severely decreased cardiac output with evidence of inadequate end-organ perfusion (i.e., tissue hypoxia) in the presence of adequate intravascular volume."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cardiovascular shock"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Cardiovascular shock"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:89138009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0036980"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030166> rdfs:label "Night sweats"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Occurrence of excessive sweating during sleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Night sweats"^^<http://example.org/invalidDatatype>,
        "Nocturnal hyperhidrosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Night sweats"^^<http://example.org/invalidDatatype>,
        "Nocturnal hyperhidrosis"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:42984000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0028081"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030167> rdfs:label "Antimitochondrial antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against mitochondria."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Serum antimitochrondrial antibodies"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Serum antimitochrondrial antibodies"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021051"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030319> rdfs:label "Weakness of facial musculature"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced strength of one or more muscles innervated by the facial nerve (the seventh cranial nerve)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased facial muscle strength"^^<http://example.org/invalidDatatype>,
        "Face weakness"^^<http://example.org/invalidDatatype>,
        "Facial muscle weakness"^^<http://example.org/invalidDatatype>,
        "Facial weakness"^^<http://example.org/invalidDatatype>,
        "Myasthenia of facial muscles"^^<http://example.org/invalidDatatype>,
        "Reduced facial muscle strength"^^<http://example.org/invalidDatatype>,
        "Weakness of face"^^<http://example.org/invalidDatatype>,
        "Weakness of facial musculature"^^<http://example.org/invalidDatatype>,
        "Decreased strength of facial muscles" ;
    ns1:synonym "Decreased facial muscle strength"^^<http://example.org/invalidDatatype>,
        "Decreased strength of facial muscles"^^<http://example.org/invalidDatatype>,
        "Facial muscle weakness"^^<http://example.org/invalidDatatype>,
        "Facial weakness"^^<http://example.org/invalidDatatype>,
        "Myasthenia of facial muscles"^^<http://example.org/invalidDatatype>,
        "Reduced facial muscle strength"^^<http://example.org/invalidDatatype>,
        "Weakness of face"^^<http://example.org/invalidDatatype>,
        "Weakness of facial musculature"^^<http://example.org/invalidDatatype>,
        "Face weakness" ;
    ns1:xref "UMLS:C4022514"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030320> rdfs:label "Increased intervertebral space"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the vertical distance between adjacent vertebral bodies, observed as an increase in the intervertebral disk space." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022513"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030351> rdfs:label "Urticarial plaque"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A well-circumscribed, intensely pruritic, raised wheal (edema of the superficial skin) typically 1 to 2 cm in diameter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072895"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030384> rdfs:label "Decreased proportion of marginal zone B cells"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction in the normal proportion of marginal zone B cells (CD19+/CD27+/IgM+/IgD+) in circulation relative to the total number of B cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072922"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030666> rdfs:label "Retinal neovascularization"^^<http://example.org/invalidDatatype> ;
    dcterms:description "In ischemic retinal disease, neovascularization (NV) involves the sprouting of new vessels from pre-existent vessels. Ischemia invariably leads to the upregulation of Vascular Endothelial Growth Factor (VEGF) production. Most frequently the new vessels grow internal to the plane of the retina. However, intraretinal proliferation of new vessels can also occur."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal vascular proliferation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Retinal vascular proliferation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:61267008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0035320"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030793> rdfs:label "Jaw swelling"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal enlargement in the upper jaw (maxilla) or in the lower jaw (mandible)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280766"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030802> rdfs:label "Lower eyelid retraction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inferior malposition of the lower eyelid margin without eyelid eversion." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:700264006"^^<http://example.org/invalidDatatype>,
        "UMLS:C1861656"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030872> rdfs:label "Abnormal cardiac ventricular function"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the cardiac ventricular function."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280733" .

<http://purl.obolibrary.org/obo/HP_0031185> rdfs:label "Elevated circulating NT-proBNP concentration" ;
    dcterms:description "The concentration of NT-proBNP (= N-terminal pro-B-type natriuretic peptide, = N-terminal prohormone of brain natriuretic peptide) in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased NT-proBNP level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased NT-proBNP level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031191> rdfs:label "Deep dermal perivascular inflammatory infiltrate"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Numerous lymphocytes surrounding blood vessels in the deep part of the dermis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Deep perivascular inflammatory infiltrate"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Deep perivascular inflammatory infiltrate"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031545> rdfs:label "Abnormally low T cell receptor excision circle level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced level of T cell receptor excision circle (TRECs) as measured by the TREC assay. Late in maturation, 70% of thymocytes that will ultimately express alpha/beta-T cell receptors form a circular DNA TREC from the excised TCRdelta gene that lies within the TCRalpha genetic locus. The circles are stable but do not increase following cell division and, therefore, become diluted as T cells proliferate. A quantitative polymerase chain reaction (PCR) reaction across the joint of the circular DNA provides the TREC copy number, a marker of newly-formed, antigenically-naïve thymic emigrant T cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031606> rdfs:label "Retinal cotton wool spot"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fluffy white patch in the inner retina, representing localized areas of dense white swelling of the retinal nerve fiber layer."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031688> rdfs:label "Erythroid dysplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dysplasia in the erythroid lineage, which presents with a variety of morphological changes in the bone marrow, including nuclear budding or irregular nuclear contour in erythroblasts."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Dyserythropoiesis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dyserythropoiesis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031689> rdfs:label "Megakaryocyte dysplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of micro-megakaryocytes, hypo-lobed, or non-lobed nuclei in megakaryocytes of all sizes and multiple, widely-separated nuclei."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysmegakaryopoiesis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dysmegakaryopoiesis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031693> rdfs:label "Severe Epstein Barr virus infection" ;
    dcterms:description "An unusually severe Epstein Barr virus (EBV) infection."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fulminant infectious mononucleosis"^^<http://example.org/invalidDatatype>,
        "Severe EBV infection"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Fulminant infectious mononucleosis"^^<http://example.org/invalidDatatype>,
        "Severe EBV infection"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031972> rdfs:label "Presyncope"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Presyncope is a state of lightheadedness, muscular weakness, blurred vision, and feeling faint. Presyncope is most often cardiovascular in cause."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031987> rdfs:label "Diminished ability to concentrate"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The inability to focus or concentrate on a specific task, activity, or object. The subject may find themselves unable to grasp or understand written text and re-reads frequently without understanding. Familiar tasks or activities are severely compromised due to the lack of ability to concentrate. Thinking through multi-step problems is typically very difficult or impossible, leading to avoidance of such activities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Concentration problems"^^<http://example.org/invalidDatatype>,
        "Labored thinking"^^<http://example.org/invalidDatatype>,
        "Lack of concentration"^^<http://example.org/invalidDatatype>,
        "Poor concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Concentration problems"^^<http://example.org/invalidDatatype>,
        "Labored thinking"^^<http://example.org/invalidDatatype>,
        "Poor concentration"^^<http://example.org/invalidDatatype>,
        "Lack of concentration" .

<http://purl.obolibrary.org/obo/HP_0032024> rdfs:label "Ileal ulcer"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An erosion of the mucous membrane in a portion of the ileum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032163> rdfs:label "Molluscum contagiosum"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Molluscum contagiosum is a cutaneous viral infection that is commonly observed in both healthy and immunocompromised children. The infection is caused by a member of the Poxviridae family, the molluscum contagiosum virus. Molluscum contagiosum presents as single or multiple small white or flesh-colored papules that typically have a central umbilication. The central umbilication may be difficult to observe in young children and, instead, may bear an appearance similar to an acneiform eruption. The lesions vary in size (from 1 mm to 1 cm in diameter) and are painless, although a subset of patients report pruritus in the area of infection. On average, 11-20 papules appear on the body during the course of infection and generally remains a self-limiting disease. However, in immunosuppressed patients, molluscum contagiosum can be a severe infection with hundreds of lesions developing on the body. Extensive eruption is indicative of an advanced immunodeficiency state."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032219> rdfs:label "Increased CD4+ T cell proportion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal increase of helper CD3+CD4+ T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group. These are usually measured within the TCR alpha/beta positive population."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated helper T cell proportion"^^<http://example.org/invalidDatatype>,
        "Elevated proportion of CD4-positive T cells"^^<http://example.org/invalidDatatype>,
        "Increased helper T cell proportion"^^<http://example.org/invalidDatatype>,
        "Increased proportion of CD4+ T cells"^^<http://example.org/invalidDatatype>,
        "Increased proportion of CD4-positive T cells"^^<http://example.org/invalidDatatype>,
        "Increased proportion of CD4-positive, alpha-beta T cells"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated proportion of CD4-positive T cells"^^<http://example.org/invalidDatatype>,
        "Increased helper T cell proportion"^^<http://example.org/invalidDatatype>,
        "Increased proportion of CD4+ T cells"^^<http://example.org/invalidDatatype>,
        "Increased proportion of CD4-positive T cells"^^<http://example.org/invalidDatatype>,
        "Increased proportion of CD4-positive, alpha-beta T cells"^^<http://example.org/invalidDatatype>,
        "Elevated helper T cell proportion" .

<http://purl.obolibrary.org/obo/HP_0032252> rdfs:label "Granuloma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A compact, organized collection of mature mononuclear phagocytes, which may be but is not necessarily accompanied by accessory features such as necrosis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032263> rdfs:label "Increased blood pressure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal increase in blood pressure. An individual measurement of increased blood pressure does not necessarily imply hypertension. In practical terms, multiple measurements are recommended to diagnose the presence of hypertension."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased BP" ;
    ns1:synonym "Increased BP"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032323> rdfs:label "Periodic fever"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Episodic fever that recurs at regular intervals."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032436> rdfs:label "Abnormal circulating C-reactive protein concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation from the normal concentration of C-reactive protein in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal C-reactive protein level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal C-reactive protein level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032564> rdfs:label "Ileitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the ileum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of the ileum"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Inflammation of the ileum"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032948> rdfs:label "Renal interstitial fibrosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The accumulation of collagen and related extracellular matrix (ECM) molecules in the interstitium of the kidney. The interstitium is expanded by the presence of collagen that stain blue on trichrome. Tubules are not back to back, but rather separated by fibrosis and can be atrophic."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032979> rdfs:label "Hemosiderin-laden macrophages in bronchoalveolar fluid"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hemosiderin-laden macrophages (HLM) in bronchoalveolar lavage (BAL) fluid were originally known as adiagnostic biomarker of alveolar hemorrhage, but have also been observed in idiopathic pulmonary fibrosis (IPF) with histopathological pattern of usual interstitial pneumonia (UIP)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Accumulation of hemosiderin laden alveolar macrophages"^^<http://example.org/invalidDatatype>,
        "Siderophages in bronchoalveolar fluid"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Accumulation of hemosiderin laden alveolar macrophages"^^<http://example.org/invalidDatatype>,
        "Siderophages in bronchoalveolar fluid"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033040> rdfs:label "Anti-Sm antibody positivity" ;
    dcterms:description "The presence of autoantibodies in the serum that react to seven proteins that consist of a core of small nuclear ribonucleoprotein (snRNP) particles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-Smith autoantibody"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-Smith autoantibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033041> rdfs:label "Cytokine storm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excessive or uncontrolled release of proinflammatory cytokines." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypercytokinemia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hypercytokinemia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033106> rdfs:label "Elevated circulating D-dimer concentration" ;
    dcterms:description "An increased concentration of D-dimers, a marker of fibrin degradation, in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated D-dimers"^^<http://example.org/invalidDatatype>,
        "Elevated fibrin degradation fragment concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated D-dimers"^^<http://example.org/invalidDatatype>,
        "Elevated fibrin degradation fragment concentration"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033117> rdfs:label "Duodenitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the lining of the upper small intestine (duodenum)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Duodenal inflammation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Duodenal inflammation"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033176> rdfs:label "Submandibular lymph node enlargement" ;
    dcterms:description "Increased size of the lymph nodes that are located beneath the mandible (lower jaw)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Submandibular lymphadenopathy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Submandibular lymphadenopathy"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033188> rdfs:label "Cystic acne"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A severe type of acne characterized by the formation of cysts enclosing a mixture of keratin and sebum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033194> rdfs:label "Perioral erythema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Erythema (Redness of the skin caused by hyperemia of the capillaries in the lower layers of the skin) localized to the region surrounding the mouth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033195> rdfs:label "Perianal erythema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Erythema (Redness of the skin caused by hyperemia of the capillaries in the lower layers of the skin) localized to the region surrounding the anus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033199> rdfs:label "Increased circulating interleukin 10 concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevation of the concentration of interleukin 10 in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum interleukin 10"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased serum interleukin 10"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033221> rdfs:label "Increased CD4:CD8 ratio"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal elevation of the relative proportion of CD4+ to CD8+ T cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033250> rdfs:label "Nailfold capillary tortuosity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased number of turns of the blood vessels of the nailfold with a charactereistic winded or twisted appearance of the blood vessels."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033253> rdfs:label "Reduced circulating interferon gamma concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction in the concentration of interferon gamma measured in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced circulating interferon gamma"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced circulating interferon gamma"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033260> rdfs:label "Livedo racemosa"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Livedo racemosa describes a reddish-blue mottling of the skin in an irregular, reticular pattern. It differs from the more common livedo reticularis by its shape. Livedo racemosa consists of broken circular segments resulting in a seemingly larger pattern, as opposed to the fine, regular, complete network of livedo reticularis. Livedo racemosa results from permanent impairment of peripheral blood flow and, unlike livedo reticularis, it persists on warming."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033261> rdfs:label "Renal artery aneurysm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increase in diameter of a segment of the renal artery that can be defined as a focal, isolated dilatation of all three layers of the arterial wall over 1.5 times the diameter of the disease-free proximal adjacent arterial segment."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033280> rdfs:label "Paratracheal lymphadenopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Enlargement of lymph nodes surrounding the trachea."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033308> rdfs:label "Patellar overgrowth"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excessive growth of the kneecap (patella)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033332> rdfs:label "Elevated circulating amyloid A concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of serum amyloid A in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating amyloid A"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated circulating amyloid A" .

<http://purl.obolibrary.org/obo/HP_0033380> rdfs:label "Nasal chondritis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the cartilage of the nose."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nose chondritis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nose chondritis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033425> rdfs:label "Periungual erythema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Erythema (redness of the skin caused by hyperemia in superficial capillaries) in the region surrounding a fingernail or toe nail."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033434> rdfs:label "Nasal septum perforation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A full-thickness defect of the nasal septum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nasal-septum perforation"^^<http://example.org/invalidDatatype>,
        "Perforation of the nasal septum"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nasal-septum perforation"^^<http://example.org/invalidDatatype>,
        "Perforation of the nasal septum"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033438> rdfs:label "Elevated circulating myoglobin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased blood concentration of myoglobin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033559> rdfs:label "Anti-myeloperoxidase antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies in the blood circulation that react against myeloperoxidase."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-MPO antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-myeloperoxidase specific antineutrophil cytoplasmic antibody"^^<http://example.org/invalidDatatype>,
        "MPO-ANCA"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-MPO antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-myeloperoxidase specific antineutrophil cytoplasmic antibody"^^<http://example.org/invalidDatatype>,
        "MPO-ANCA"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033605> rdfs:label "Pustular rash"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rash composed of pustular lesions. A pustule is defined as a vesicle or bulla containing purulent material. It varies in size and may occur at different levels within the epidermis: subcorneal, intraepidermal, or basement membrane zones. The pustules may or may not be sterile and are normally filled with neutrophils."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Pustulosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pustulosis" .

<http://purl.obolibrary.org/obo/HP_0033631> rdfs:label "Spondylitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the vertebrae (vertebral bodies) or spine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033748> rdfs:label "Hypoesthesia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased ability to perceive touch."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoaesthesia"^^<http://example.org/invalidDatatype>,
        "Numbness" ;
    ns1:synonym "Numbness"^^<http://example.org/invalidDatatype>,
