<http://purl.obolibrary.org/obo/HP_0002415> rdfs:label "Leukodystrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Leukodystrophy refers to deterioration of white matter of the brain resulting from degeneration of myelin sheaths in the CNS. Their basic defect is directly related to the synthesis and maintenance of myelin membranes. Symmetric white matter involvement at MRI is a typical finding in patients with leukodystrophies."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Degeneration of white matter of brain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Degeneration of white matter of brain"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:192781003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0023520" .

<http://purl.obolibrary.org/obo/HP_0002725> rdfs:label "Systemic lupus erythematosus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A chronic, relapsing, inflammatory, and often febrile multisystemic disorder of connective tissue, characterized principally by involvement of the skin, joints, kidneys, and serosal membranes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "SLE"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "SLE"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:55464009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0024141"^^<http://example.org/invalidDatatype> .

