        "Cranial nerve disease"^^<http://example.org/invalidDatatype>,
        "Cranial nerve involvement"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1854510"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020872"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001297> rdfs:label "Stroke"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Sudden impairment of blood flow to a part of the brain due to occlusion or rupture of an artery to the brain."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
