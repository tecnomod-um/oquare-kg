<http://purl.obolibrary.org/obo/HP_0000716> rdfs:label "Depression"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Frequently experiencing feelings of being down, miserable, and/or hopeless; struggling to recover from these moods; having a pessimistic outlook on the future; feeling a pervasive sense of shame; having a low self-worth; experiencing thoughts of suicide and engaging in suicidal behavior."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Depression"^^<http://example.org/invalidDatatype>,
        "Depressive episode"^^<http://example.org/invalidDatatype>,
        "Depressivity"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Depressive disorder"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Depression"^^<http://example.org/invalidDatatype>,
        "Depressive disorder"^^<http://example.org/invalidDatatype>,
        "Depressive episode"^^<http://example.org/invalidDatatype>,
        "Depressivity"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:35489007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:78667006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0011581"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:21061000119107" .

<http://purl.obolibrary.org/obo/HP_0000739> rdfs:label "Anxiety"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Intense feelings of nervousness, tension, or panic often arise in response to interpersonal stresses. There is worry about the negative effects of past unpleasant experiences and future negative possibilities. Individuals may feel fearful, apprehensive, or threatened by uncertainty, and they may also have fears of falling apart or losing control." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anxiety"^^<http://example.org/invalidDatatype>,
        "Excessive, persistent worry and fear"^^<http://example.org/invalidDatatype>,
        "Anxiousness" ;
    ns1:related_synonym "Anxiety disease"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anxiety"^^<http://example.org/invalidDatatype>,
        "Anxiousness"^^<http://example.org/invalidDatatype>,
        "Excessive, persistent worry and fear"^^<http://example.org/invalidDatatype>,
        "Anxiety disease" ;
    ns1:xref "SNOMEDCT_US:48694002"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020884"^^<http://example.org/invalidDatatype>,
        "UMLS:C0003467" .

<http://purl.obolibrary.org/obo/HP_0000742> rdfs:label "Self-mutilation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Deliberate harm to one's body resulting in tissue damage, without a conscious intent to die."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Deliberate self-harm"^^<http://example.org/invalidDatatype>,
