<http://purl.obolibrary.org/obo/HP_0001387> rdfs:label "Joint stiffness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Joint stiffness is a perceived sensation of tightness in a joint or joints when attempting to move them after a period of inactivity. Joint stiffness typically subsides over time."^^<http://example.org/invalidDatatype> ;
