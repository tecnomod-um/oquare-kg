<http://purl.obolibrary.org/obo/HP_0001761> rdfs:label "Pes cavus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in height of the medial longitudinal arch of the foot that does not flatten on weight bearing (i.e., a distinctly hollow form of the sole of the foot when it is bearing weight)."^^<http://example.org/invalidDatatype> ;
