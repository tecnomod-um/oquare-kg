<http://purl.obolibrary.org/obo/HP_0012622> rdfs:label "Chronic kidney disease"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Functional anomaly of the kidney persisting for at least three months."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "CKD"^^<http://example.org/invalidDatatype>,
        "Chronic kidney disease"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Loss of renal function"^^<http://example.org/invalidDatatype>,
        "Progressive renal failure"^^<http://example.org/invalidDatatype>,
        "Progressive renal insufficiency"^^<http://example.org/invalidDatatype>,
        "Renal failure, progressive"^^<http://example.org/invalidDatatype>,
        "Renal insufficiency, progressive"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "CKD"^^<http://example.org/invalidDatatype>,
        "Chronic kidney disease"^^<http://example.org/invalidDatatype>,
        "Loss of renal function"^^<http://example.org/invalidDatatype>,
        "Progressive renal failure"^^<http://example.org/invalidDatatype>,
        "Progressive renal insufficiency"^^<http://example.org/invalidDatatype>,
        "Renal failure, progressive"^^<http://example.org/invalidDatatype>,
        "Renal insufficiency, progressive"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:709044004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0748318"^^<http://example.org/invalidDatatype>,
        "UMLS:C1561643"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012647> rdfs:label "Abnormal inflammatory response"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any anomaly of the inflammatory response, a response to injury or infection characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells and macrophages." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal inflammatory response"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal inflammatory response"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022805"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020151> rdfs:label "Anti-dsDNA antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against double-stranded DNA."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-double-stranded DNA antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-double-stranded DNA antibody positivity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025116> rdfs:label "Fetal distress"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An intrauterine state characterized by suboptimal values in the fetal heart rate, oxygenation of fetal blood, or other parameters indicative of compromise of the fetus. Signs of fetal distress include repetitive variable decelerations, fetal tachycardia or bradycardia, late decelerations, or low biophysical profile."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Foetal distress" ;
    ns1:synonym "Foetal distress"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025131> rdfs:label "Finger swelling"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Enlargement of the soft tissues of one or more fingers."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Swelling of fingers"^^<http://example.org/invalidDatatype>,
        "Swollen fingers"^^<http://example.org/invalidDatatype>,
        "Swollen finger" ;
    ns1:synonym "Swelling of fingers"^^<http://example.org/invalidDatatype>,
        "Swollen finger"^^<http://example.org/invalidDatatype>,
        "Swollen fingers"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025143> rdfs:label "Chills"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A sudden sensation of feeling cold."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chills"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Chills" .

<http://purl.obolibrary.org/obo/HP_0025289> rdfs:label "Cervical lymphadenopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Enlarged lymph nodes in the neck."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Swollen lymph nodes in the neck"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Swollen lymph nodes in the neck"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025406> rdfs:label "Asthenia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A state characterized by a feeling of weakness and loss of strength leading to a generalized weakness of the body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lack of energy and strength"^^<http://example.org/invalidDatatype>,
        "Weakness"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Prostration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Lack of energy and strength"^^<http://example.org/invalidDatatype>,
        "Prostration"^^<http://example.org/invalidDatatype>,
        "Weakness" .

<http://purl.obolibrary.org/obo/HP_0025435> rdfs:label "Increased circulating lactate dehydrogenase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevated level of the enzyme lactate dehydrogenase in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased circulating LDH concentration"^^<http://example.org/invalidDatatype>,
        "Increased lactate dehydrogenase level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased lactate dehydrogenase level"^^<http://example.org/invalidDatatype>,
        "Increased circulating LDH concentration" .

<http://purl.obolibrary.org/obo/HP_0025439> rdfs:label "Pharyngitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation (due to infection or irritation) of the pharynx."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025452> rdfs:label "Pyoderma gangrenosum"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deep skin ulcer with a well defined border, which is usually violet or blue. The ulcer edge is often undermined (worn and damaged) and the surrounding skin is erythematous and indurated. The ulcer often starts as a small papule or collection of papules, which break down to form small ulcers with a so called cat's paw appearance. These coalesce and the central area then undergoes necrosis to form a single ulcer."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030038> rdfs:label "Enchondroma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A solitary, benign, intramedullary cartilage tumor that is often found in the short tubular bones of the hands and feet, distal femur, and proximal humerus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:31186001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:423699002"^^<http://example.org/invalidDatatype>,
        "UMLS:C1704356"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030053> rdfs:label "Stiff skin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An induration (hardening) of the skin"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Indurated skin"^^<http://example.org/invalidDatatype>,
        "Stiff skin"^^<http://example.org/invalidDatatype>,
        "Skin induration" ;
    ns1:synonym "Indurated skin"^^<http://example.org/invalidDatatype>,
        "Skin induration"^^<http://example.org/invalidDatatype>,
        "Stiff skin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C3276815"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030056> rdfs:label "Uncombable hair"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hair that is disorderly, stands out from the scalp, and cannot be combed flat."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Uncombable hair"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Uncombable hair"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1860607"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030151> rdfs:label "Cholangitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the biliary ductal system, affecting the intrahepatic or extrahepatic portions, or both."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bile duct inflammation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Bile duct inflammation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:82403002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0008311"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030374> rdfs:label "Decreased proportion of memory B cells"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction in the normal proportion of memory B cells (CD19+/CD27+) in circulation relative to the total number of B cells. Memory B cells develop from naive B cells. Upon antigen rechallenge, memory B cells rapidly expand and differentiate into plasma cells under the cognate control of memory Th cells (Phase IV)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072913"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030388> rdfs:label "Decreased class-switched memory B cell proportion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction in the normal proportion of class-switched memory B cells (CD19+/CD27+/IgM+/IgD+) relative to the total number of B cells. Marginal zone B cells undergo limited somatic hypermutation and produce high-affinity IgM and some IgG, whereas class-switched memory B cells synthetize IgG, IgM, and IgA."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased proportion of CD19+CD27+IgD- cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of class-switched memory B cells"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased proportion of CD19+CD27+IgD- cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of class-switched memory B cells"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072925"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030953> rdfs:label "Conjunctival hyperemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dilatation of the blood vessels of the conjunctiva leading to a red appearance of the sclera."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Conjunctival injection"^^<http://example.org/invalidDatatype>,
        "Conjunctival vascular congestion"^^<http://example.org/invalidDatatype>,
        "Conjunctival hyperaemia" ;
    ns1:synonym "Conjunctival hyperaemia"^^<http://example.org/invalidDatatype>,
        "Conjunctival injection"^^<http://example.org/invalidDatatype>,
        "Conjunctival vascular congestion"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031123> rdfs:label "Recurrent gastroenteritis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased susceptibility to gastroenteritis, an infectious inflammationof the stomach and small intestines manifested by signs and symptoms such as diarheas and abdominal pain, as manifested by recurrent episodes of gastroenteritis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031956> rdfs:label "Elevated circulating aspartate aminotransferase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of aspartate aminotransferase (AST) in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated serum AST"^^<http://example.org/invalidDatatype>,
        "Elevated serum aspartate aminotransferase"^^<http://example.org/invalidDatatype>,
        "Elevated serum glutamic oxaloacetic transaminase"^^<http://example.org/invalidDatatype>,
        "Aspartate aminotransferase increased" ;
    ns1:synonym "Aspartate aminotransferase increased"^^<http://example.org/invalidDatatype>,
        "Elevated serum AST"^^<http://example.org/invalidDatatype>,
        "Elevated serum aspartate aminotransferase"^^<http://example.org/invalidDatatype>,
        "Elevated serum glutamic oxaloacetic transaminase"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031964> rdfs:label "Elevated circulating alanine aminotransferase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally high concentration in the circulation of alanine aminotransferase (ALT)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Alanine aminotransferase increased"^^<http://example.org/invalidDatatype>,
        "Elevated serum ALT"^^<http://example.org/invalidDatatype>,
        "Elevated serum alanine aminotransferase"^^<http://example.org/invalidDatatype>,
        "Elevated serum glutamic-pyruvic transaminase"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Alanine aminotransferase increased"^^<http://example.org/invalidDatatype>,
        "Elevated serum ALT"^^<http://example.org/invalidDatatype>,
        "Elevated serum glutamic-pyruvic transaminase"^^<http://example.org/invalidDatatype>,
        "Elevated serum alanine aminotransferase" .

<http://purl.obolibrary.org/obo/HP_0032069> rdfs:label "Anti-thyroglobulin antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react to thyroglobulin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-thyroid globulin antibody positivity"^^<http://example.org/invalidDatatype>,
        "TgAbs"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-thyroid globulin antibody positivity"^^<http://example.org/invalidDatatype>,
        "TgAbs"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032153> rdfs:label "Joint subluxation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A partial dislocation of a joint."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032230> rdfs:label "Cytoplasmic antineutrophil antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies in the serum that react against proteins predominantly expressed in cytoplasmic granules of neutrophils."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-neutrophil cytoplasmic antibody positivity"^^<http://example.org/invalidDatatype>,
        "C-ANCA antibodies"^^<http://example.org/invalidDatatype>,
        "Cytoplasmic antineutrophil cytoplasmic antibodies"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-neutrophil cytoplasmic antibody positivity"^^<http://example.org/invalidDatatype>,
        "C-ANCA antibodies"^^<http://example.org/invalidDatatype>,
        "Cytoplasmic antineutrophil cytoplasmic antibodies"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032638> rdfs:label "Elevated urine mevalonic acid level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally increased amount of mevanolate in the urine. Mevanolate is that hydroxy monocarboxylic acid anion that is the conjugate base of mevalonic acid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urine mevalonate"^^<http://example.org/invalidDatatype>,
        "Elevated urine mevalonate levels"^^<http://example.org/invalidDatatype>,
        "Elevated urine mevalonic acid"^^<http://example.org/invalidDatatype>,
        "Mevalonate aciduria"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated urine mevalonate"^^<http://example.org/invalidDatatype>,
        "Elevated urine mevalonate levels"^^<http://example.org/invalidDatatype>,
        "Elevated urine mevalonic acid"^^<http://example.org/invalidDatatype>,
        "Mevalonate aciduria"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033028> rdfs:label "Anti-U1 ribonucleoprotein antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence autoantibodies in the serum that react to proteins (70 Kd, A, C) that are associated with U1 RNA and form U1snRNP."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-RNP-antibodies"^^<http://example.org/invalidDatatype>,
        "Anti-U1-RNP antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:narrow_synonym "Anti-Scl-34 antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-U3 ribonucleoprotein antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-RNP-antibodies"^^<http://example.org/invalidDatatype>,
        "Anti-Scl-34 antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-U1-RNP antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-U3 ribonucleoprotein antibody positivity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033050> rdfs:label "Pharyngalgia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) and perceived to originate in the throat." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pharyngodynia"^^<http://example.org/invalidDatatype>,
        "Sore throat"^^<http://example.org/invalidDatatype>,
        "Throat discomfort"^^<http://example.org/invalidDatatype>,
        "Throat pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pharyngodynia"^^<http://example.org/invalidDatatype>,
        "Sore throat"^^<http://example.org/invalidDatatype>,
        "Throat discomfort"^^<http://example.org/invalidDatatype>,
        "Throat pain"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033178> rdfs:label "Increased circulating interleukin 8 concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased concentration of interleukin-8 in the circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum interleukin 8"^^<http://example.org/invalidDatatype>,
        "Increased serum interleukin-8"^^<http://example.org/invalidDatatype>,
        "Increased serum IL-8" ;
    ns1:synonym "Increased serum IL-8"^^<http://example.org/invalidDatatype>,
        "Increased serum interleukin 8"^^<http://example.org/invalidDatatype>,
        "Increased serum interleukin-8" .

<http://purl.obolibrary.org/obo/HP_0033331> rdfs:label "Acute phase response"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Presence of one or more manifestations of the acute phase response. Acute phase proteins (APP) are blood proteins primarily synthesized by hepatocytes as part of the acute phase response (APR). The APR is part of the early-defense or innate immune system, which is triggered by different stimuli including trauma, infection, stress, neoplasia, and inflammation. The APR results in a complex systemic reaction with the goal of reestablishing homeostasis and promoting healing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033430> rdfs:label "Non-infectious meningitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the layers of tissue that cover the brain and spinal cord (meninges) and of the fluid-filled space between the meninges (subarachnoid space) when it is caused by disorders that are not infections or by drugs or vaccines."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aseptic meningitis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Aseptic meningitis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033505> rdfs:label "Livedo reticularis" ;
    dcterms:description "Livedo reticularis is characterized by the presence of a bluish purple, mottled or netlike pattern in unbroken circles on the skin. Exposure to cold environments usually intensifies the vascular pattern. Presumably, the condition results from slow or stagnant blood flow, vessel-wall pathology, and decreased oxygen tension." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033677> rdfs:label "Acute respiratory distress syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Acute respiratory distress syndrome (ARDS) is defined as an acute disorder that starts within seven days of the inciting event and is characterized by bilateral lung infiltrates and severe progressive hypoxemia in the absence of any evidence of cardiogenic pulmonary edema. ARDS is defined by the patient's oxygen in arterial blood (PaO2) to the fraction of the oxygen in the inspired air (FiO2). These patients have a PaO2/FiO2 ratio of less than 300." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "ARDS"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "ARDS"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040049> rdfs:label "Macular edema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Thickening of the retina that takes place due to accumulation of extracellular fluid in the macula as a nonspecific response to blood-retinal barrier breakdown. It can either have a cystoid aspect in the fovea, or a more diffuse aspect."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular oedema"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Macular oedema"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:37231002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0271051"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040189> rdfs:label "Scaling skin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Refers to the loss of the outer layer of the epidermis in large, scale-like flakes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Desquamation"^^<http://example.org/invalidDatatype>,
        "Scaling skin"^^<http://example.org/invalidDatatype>,
        "flaking skin"^^<http://example.org/invalidDatatype>,
        "peeling skin"^^<http://example.org/invalidDatatype>,
        "Scaly skin" ;
    ns1:related_synonym "Exfoliation" ;
    ns1:synonym "Desquamation"^^<http://example.org/invalidDatatype>,
        "Exfoliation"^^<http://example.org/invalidDatatype>,
        "Scaling skin"^^<http://example.org/invalidDatatype>,
        "flaking skin"^^<http://example.org/invalidDatatype>,
        "peeling skin"^^<http://example.org/invalidDatatype>,
        "Scaly skin" ;
    ns1:xref "SNOMEDCT_US:14411002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:271767006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0237849"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040313> rdfs:label "Oligoarthritis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of arthritis that affects up to four joints in the first six months of disease."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0100255> rdfs:label "Metaphyseal dysplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of dysplastic regions in metaphyseal regions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:27837003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265294"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100279> rdfs:label "Ulcerative colitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A chronic inflammatory bowel disease that includes characteristic ulcers, or open sores, in the colon. The main symptom of active disease is usually constant diarrhea mixed with blood, of gradual onset and intermittent periods of exacerbated symptoms contrasting with periods that are relatively symptom-free. In contrast to Crohn's disease this special form of colitis begins in the distal parts of the rectum, spreads continually upwards and affects only mucose and submucose tissue of the colon."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Colitis ulcerosa"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Colitis ulcerosa"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:64766004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0009324"^^<http://example.org/invalidDatatype> .

