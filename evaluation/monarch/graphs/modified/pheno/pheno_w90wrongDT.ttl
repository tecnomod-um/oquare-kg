    ns1:xref "SNOMEDCT_US:34742003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0020541"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001973> rdfs:label "Autoimmune thrombocytopenia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of thrombocytopenia in combination with detection of antiplatelet antibodies."^^<http://example.org/invalidDatatype> ;
