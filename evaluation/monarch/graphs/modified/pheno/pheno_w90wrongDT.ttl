<http://purl.obolibrary.org/obo/HP_0000047> rdfs:label "Hypospadias"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal position of urethral meatus on the ventral penile shaft (underside) characterized by displacement of the urethral meatus from the tip of the glans penis to the ventral surface of the penis, scrotum, or perineum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypospadia"^^<http://example.org/invalidDatatype> ;
