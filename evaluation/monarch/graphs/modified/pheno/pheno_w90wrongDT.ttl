<http://purl.obolibrary.org/obo/HP_0009886> rdfs:label "Trichorrhexis nodosa"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Trichorrhexis nodosa is the formation of nodes along the hair shaft through which breakage readily occurs. It is thus a focal defect in the hair fiber that is characterized by thickening or weak points (nodes) that cause the hair to break off easily. The result is defective, abnormally fragile hair."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:22486004"^^<http://example.org/invalidDatatype>,
