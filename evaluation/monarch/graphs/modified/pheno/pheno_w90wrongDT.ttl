<http://purl.obolibrary.org/obo/HP_0001061> rdfs:label "Acne"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A skin condition in which there is an increase in sebum secretion by the pilosebaceous apparatus associated with open comedones (blackheads), closed comedones (whiteheads), and pustular nodules (papules, pustules, and cysts)."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Breaking out"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
