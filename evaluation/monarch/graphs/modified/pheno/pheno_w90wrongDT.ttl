<http://purl.obolibrary.org/obo/HP_0000790> rdfs:label "Hematuria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of blood in the urine. Hematuria may be gross hematuria (visible to the naked eye) or microscopic hematuria (detected by dipstick or microscopic examination of the urine)." ;
    ns1:broad_synonym "High urine occult blood"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blood in urine"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Blood in urine"^^<http://example.org/invalidDatatype>,
        "High urine occult blood"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:34436003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:53298000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0018965"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000823> rdfs:label "Delayed puberty"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Passing the age when puberty normally occurs with no physical or hormonal signs of the onset of puberty."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Delayed pubertal development"^^<http://example.org/invalidDatatype>,
        "Delayed pubertal growth"^^<http://example.org/invalidDatatype>,
        "Delayed puberty"^^<http://example.org/invalidDatatype>,
        "Pubertal delay" ;
    ns1:synonym "Delayed pubertal development"^^<http://example.org/invalidDatatype>,
        "Delayed puberty"^^<http://example.org/invalidDatatype>,
        "Pubertal delay"^^<http://example.org/invalidDatatype>,
        "Delayed pubertal growth" ;
    ns1:xref "SNOMEDCT_US:123526007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:400003000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0034012"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000872> rdfs:label "Hashimoto thyroiditis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A chronic, autoimmune type of thyroiditis associated with hypothyroidism."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hashimoto's thyroiditis"^^<http://example.org/invalidDatatype>,
        "Chronic lymphocytic thyroiditis" ;
    ns1:synonym "Chronic lymphocytic thyroiditis"^^<http://example.org/invalidDatatype>,
        "Hashimoto's thyroiditis"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:21983002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0677607"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000873> rdfs:label "Diabetes insipidus" ;
    dcterms:description "A state of excessive water intake and hypotonic (dilute) polyuria. Diabetes insipidus may be due to failure of vasopressin (AVP) release (central or neurogenic diabetes insipidus) or to a failure of the kidney to respond to AVP (nephrogenic diabetes insipidus)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:15771004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0011848"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000926> rdfs:label "Platyspondyly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A flattened vertebral body shape with reduced distance between the vertebral endplates."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flat vertebral bodies"^^<http://example.org/invalidDatatype>,
        "Flattened vertebrae"^^<http://example.org/invalidDatatype>,
        "Flattened vertebral bodies"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Flat vertebral bodies"^^<http://example.org/invalidDatatype>,
        "Flattened vertebrae"^^<http://example.org/invalidDatatype>,
        "Flattened vertebral bodies"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1844704"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000939> rdfs:label "Osteoporosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Osteoporosis is a systemic skeletal disease characterized by low bone density and microarchitectural deterioration of bone tissue with a consequent increase in bone fragility. According to the WHO criteria, osteoporosis is defined as a BMD that lies 2.5 standard deviations or more below the average value for young healthy adults (a T-score below -2.5 SD)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:64859006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0029456"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000952> rdfs:label "Jaundice" ;
    dcterms:description "Yellow pigmentation of the skin due to bilirubin, which in turn is the result of increased bilirubin concentration in the bloodstream."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Jaundice"^^<http://example.org/invalidDatatype>,
        "Yellow skin"^^<http://example.org/invalidDatatype>,
        "Yellowing of the skin"^^<http://example.org/invalidDatatype>,
        "Icterus" ;
    ns1:synonym "Icterus"^^<http://example.org/invalidDatatype>,
        "Jaundice"^^<http://example.org/invalidDatatype>,
        "Yellow skin"^^<http://example.org/invalidDatatype>,
        "Yellowing of the skin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:18165001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0022346"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000956> rdfs:label "Acanthosis nigricans"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A dermatosis characterized by thickened, hyperpigmented plaques, typically on the intertriginous surfaces and neck."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Darkened and thickened skin"^^<http://example.org/invalidDatatype>,
        "Keratosis nigricans"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Darkened and thickened skin"^^<http://example.org/invalidDatatype>,
        "Keratosis nigricans"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:402599005"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:72129000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0000889"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000957> rdfs:label "Cafe-au-lait spot"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Cafe-au-lait spots are hyperpigmented lesions that can vary in color from light brown to dark brown with smooth borders and having a size of 1.5 cm or more in adults and 0.5 cm or more in children."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Birthmark"^^<http://example.org/invalidDatatype>,
        "Flat light-brown mark on skin"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cafe au lait spots"^^<http://example.org/invalidDatatype>,
        "Cafe-au-lait macules"^^<http://example.org/invalidDatatype>,
        "Cafe-au-lait macule" ;
    ns1:related_synonym "Cafe-au-lait spots"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Birthmark"^^<http://example.org/invalidDatatype>,
        "Cafe au lait spots"^^<http://example.org/invalidDatatype>,
        "Cafe-au-lait macule"^^<http://example.org/invalidDatatype>,
        "Cafe-au-lait macules"^^<http://example.org/invalidDatatype>,
        "Cafe-au-lait spots"^^<http://example.org/invalidDatatype>,
        "Flat light-brown mark on skin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:51089004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0221263"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265974"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:201281002" .

<http://purl.obolibrary.org/obo/HP_0000964> rdfs:label "Eczematoid dermatitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Eczema is a form of dermatitis that is characterized by scaly, pruritic, erythematous lesions located on flexural surfaces."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Eczema"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Dermatitis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dermatitis"^^<http://example.org/invalidDatatype>,
        "Eczema"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:281104002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:43116000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0013595"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000967> rdfs:label "Petechiae"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Petechiae are pinpoint-sized reddish/purple spots, resembling a rash, that appear just under the skin or a mucous membrane when capillaries have ruptured and some superficial bleeding into the skin has happened. This term refers to an abnormally increased susceptibility to developing petechiae."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "MEDDRA:10034754"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:271813007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:50091001",
        "UMLS:C0031256" .

<http://purl.obolibrary.org/obo/HP_0001034> rdfs:label "Hypermelanotic macule"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A hyperpigmented circumscribed area of change in normal skin color without elevation or depression of any size."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperpigmented macules"^^<http://example.org/invalidDatatype>,
        "Hyperpigmented spots"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Hyperpigmented skin patches"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hyperpigmented macules"^^<http://example.org/invalidDatatype>,
        "Hyperpigmented spots"^^<http://example.org/invalidDatatype>,
        "Hyperpigmented skin patches" ;
    ns1:xref "UMLS:C1842774"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001047> rdfs:label "Atopic dermatitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atopic dermatitis (AD) or atopic eczema is an itchy, inflammatory skin condition with a predilection for the skin flexures. It is characterized by poorly defined erythema with edema, vesicles, and weeping in the acute stage and skin thickening (lichenification) in the chronic stage."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Allergic eczema"^^<http://example.org/invalidDatatype>,
        "Atopic eczema"^^<http://example.org/invalidDatatype>,
        "Dermatitis, Atopic"^^<http://example.org/invalidDatatype>,
        "Infantile eczema"^^<http://example.org/invalidDatatype>,
        "Neurodermatitis"^^<http://example.org/invalidDatatype>,
        "Prurigo Besnier"^^<http://example.org/invalidDatatype>,
        "Atopic dermatitis, chronic" ;
    ns1:related_synonym "Baby eczema"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Allergic eczema"^^<http://example.org/invalidDatatype>,
