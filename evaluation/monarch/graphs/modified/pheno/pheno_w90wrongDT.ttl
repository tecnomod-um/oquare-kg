<http://purl.obolibrary.org/obo/HP_0003565> rdfs:label "Elevated erythrocyte sedimentation rate"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased erythrocyte sedimentation rate (ESR). The ESR is a test that measures the distance that erythrocytes have fallen after one hour in a vertical column of anticoagulated blood under the influence of gravity. The ESR is a nonspecific finding. An elevation may indicate inflammation or may be caused by any condition that elevates fibrinogen."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated ESR"^^<http://example.org/invalidDatatype>,
        "Elevated sedimentation rate"^^<http://example.org/invalidDatatype>,
