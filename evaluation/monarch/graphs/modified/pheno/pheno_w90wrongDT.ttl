        "UMLS:C0037287"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0200037> rdfs:label "Skin vesicle"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A circumscribed, fluid-containing, epidermal elevation less than 10mm in diameter at the widest point that (i) Contain serous exudates or serum mixed with blood or pus; (ii) Are discrete, grouped, irregularly distributed, or linear as in Rhus dermatitis; (iii) Are short-lived. Vesicles may break spontaneously or evolve into bullae by enlarging or coalescing with other vesicles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3814530"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0200047> rdfs:label "Chondritis of pinna"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the cartilage of the external ear."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of cartilage of pinna"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Inflammation of cartilage of pinna"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0741305"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0200056> rdfs:label "Macular scar"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fibrous connective tissue consequent upon healing of a wound (i.e., a scar) located in the macula."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular scarring" ;
    ns1:synonym "Macular scarring"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:18410006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0423428"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0200057> rdfs:label "Marcus Gunn pupil" ;
    dcterms:description "An aberrant pupillary response characterized by (i) Constriction of pupils of both eyes when the light stimulus is applied to the normal eye, and (ii) Dilatation of pupils of both eyes when the light stimulus is rapidly transferred from the normal eye (after brief light exposure to the normal eye) to the affected eye."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Relative afferent pupil defect"^^<http://example.org/invalidDatatype>,
        "Relative afferent pupillary defect"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Relative afferent pupil defect"^^<http://example.org/invalidDatatype>,
        "Relative afferent pupillary defect"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:232122003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:247015002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0549122"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0200123> rdfs:label "Chronic hepatitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hepatitis that lasts for more than six months."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic liver inflammation" ;
    ns1:synonym "Chronic liver inflammation" ;
    ns1:xref "SNOMEDCT_US:76783007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0019189"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410174> rdfs:label "Increased circulating troponin T concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased concentration of tropnin T in the blood, which is a cardiac regulatory protein that controls the calcium mediated interaction between actin and myosin. Raised cardiac troponin concentrations are now accepted as the standard biochemical marker for the diagnosis of myocardial infarction."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased troponin T level in blood"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased troponin T level in blood"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410242> rdfs:label "Abnormal circulating IgG concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal deviation from normal levels of IgG immunoglobulin in blood." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal IgG level in blood"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating IgG level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal IgG level in blood"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating IgG level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410243> rdfs:label "Abnormal circulating IgM concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal deviation from normal levels of IgM immunoglobulin in blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal IgM level in blood"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating IgM level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal IgM level in blood"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating IgM level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410300> rdfs:label "Complete or near-complete absence of specific antibody response to unconjugated pneumococcus vaccine"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The inability to synthesize postvaccination antibodies against a pneumococcus antigen, as measured by antibody titer determination following vaccination."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0500271> rdfs:label "Decreased gamma-delta T cell proportion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal decrease of TCR gamma/delta positive T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased proportion of gamma-delta T lymphocytes"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of gamma-delta T-cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of gamma-delta T-lymphocytes"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of gammadelta T cells"^^<http://example.org/invalidDatatype>,
        "Reduced proportion of gamma-delta T cells"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased proportion of gamma-delta T lymphocytes"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of gamma-delta T-lymphocytes"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of gammadelta T cells"^^<http://example.org/invalidDatatype>,
        "Reduced proportion of gamma-delta T cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of gamma-delta T-cells" .

<http://purl.obolibrary.org/obo/HP_4000025> rdfs:label "Anti-integrin antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against an integrin. Integrins are a family of cell adhesion molecules with 24 known integrin heterodimers. Integrins transduce mechanical and biochemical signals from fibrotic extracellular matrix into the cell, activate latent TGFbeta, and subsequently modulate fibroblast adhesion, migration, and growth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_4000031> rdfs:label "Anti-type VII collagen antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against collagen type VII."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_4000037> rdfs:label "Congenital hydrocele" ;
    dcterms:description "Congenital hydrocele occurs when processus vaginalis is patent and communicates with the peritoneal cavity. This communication allows the movement of peritoneal fluid but is too small to allow the intra-abdominal contents to herniate through."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_4000041> rdfs:label "AA amyloidosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Extracellular tissue deposition of fibrils that are composed of fragments of and/or intact serum amyloid A protein, a hepatic acute phase reactant."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000239> rdfs:label "Elevated circulating tumor necrosis factor alpha concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of tumor necrosis factor alpha in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000263> rdfs:label "Papillary dermal edema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Swelling due to fluid acculuation of the papillary dermis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000374> rdfs:label "Increased circulating interleukin 1beta concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased concentration of interleukin-1beta in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000441> rdfs:label "Abnormal circulating interleukin 6 concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation from the normal range of the concentration of interleukin 6 (IL-6) in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000562> rdfs:label "Reduced circulating adenosine deaminase-2 activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of adenosine deaminase 2 in the blood circulation below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced circulating ADA2 activity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced circulating ADA2 activity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6000606> rdfs:label "Elevated urinary D-glyceric acid level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The amount of D-glyceric acid in the urine, normalized for urine concentration, is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000715> rdfs:label "Central giant cell lesion of the jaw"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A benign proliferative and asymptomatic intraosseous lesion of the jaw formed by fibrous tissue that contains multiple focus of hemorrhage and an aggregation of multinucleated giant cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000933> rdfs:label "Koebner Phenomenon"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The appearance of new skin lesions on previously unaffected skin secondary to trauma. This phenomenon is also termed the isomorphic (from Greek, equal shape) response, given the fact that the new lesions that appear are clinically and histologically identical to the patient's underlying cutaneous disease." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/MONDO_0001709> rdfs:label "hypercalcemic sarcoidosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Sarcoidosis with a complication of hypercalcemia."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
