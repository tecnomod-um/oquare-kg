    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cerebellar ataxia, progressive"^^<http://example.org/invalidDatatype>,
        "Progressive ataxia" ;
    ns1:synonym "Cerebellar ataxia, progressive"^^<http://example.org/invalidDatatype>,
