<http://purl.obolibrary.org/obo/HP_0001805> rdfs:label "Onychogryphosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Onychogryphosis is a disorder of nail plate growth that is clinically characterized by an opaque, yellow-brown thickening of the nail plate with associated gross hyperkeratosis, elongation, and increased curvature."^^<http://example.org/invalidDatatype> ;
