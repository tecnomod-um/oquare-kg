    dcterms:description "A kind of anemia in which the volume of the red blood cells is normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Normocytic anaemia"^^<http://example.org/invalidDatatype> ;
