<http://purl.obolibrary.org/obo/HP_0001642> rdfs:label "Pulmonic stenosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A narrowing of the right ventricular outflow tract that can occur at the pulmonary valve (valvular stenosis), below the pulmonary valve (infundibular stenosis), or above the pulmonary valve (supravalvar stenosis)."^^<http://example.org/invalidDatatype> ;
