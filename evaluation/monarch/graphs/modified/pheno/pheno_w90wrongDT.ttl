<http://purl.obolibrary.org/obo/HP_0001097> rdfs:label "Keratoconjunctivitis sicca"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dryness of the eye related to deficiency of the tear film components (aqueous, mucin, or lipid), lid surface abnormalities, or epithelial abnormalities. Keratoconjunctivitis sicca often results in a scratchy or sandy sensation (foreign body sensation) in the eyes, and may also be associated with itching, inability to produce tears, photosensitivity, redness, pain, and difficulty in moving the eyelids."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dry eyes"^^<http://example.org/invalidDatatype>,
        "Keratitis sicca"^^<http://example.org/invalidDatatype>,
        "Xerophthalmia"^^<http://example.org/invalidDatatype> ;
