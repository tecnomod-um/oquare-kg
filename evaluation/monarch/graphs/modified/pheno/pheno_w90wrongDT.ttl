    ns1:xref "SNOMEDCT_US:90128006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0349506"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001009> rdfs:label "Telangiectasia" ;
    dcterms:description "Telangiectasias refer to small dilated blood vessels located near the surface of the skin or mucous membranes, measuring between 0.5 and 1 millimeter in diameter. Telangiectasia are located especially on the tongue, lips, palate, fingers, face, conjunctiva, trunk, nail beds, and fingertips."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Telangiectases"^^<http://example.org/invalidDatatype> ;
