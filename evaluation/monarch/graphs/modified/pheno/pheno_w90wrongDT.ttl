        "UMLS:C0003507"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001658> rdfs:label "Myocardial infarction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Necrosis of the myocardium caused by an obstruction of the blood supply to the heart and often associated with chest pain, shortness of breath, palpitations, and anxiety as well as characteristic EKG findings and elevation of serum markers including creatine kinase-MB fraction and troponin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Heart attack"^^<http://example.org/invalidDatatype>,
        "MI"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "MI"^^<http://example.org/invalidDatatype>,
        "Heart attack" ;
    ns1:xref "UMLS:C0027051"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:22298006" .

<http://purl.obolibrary.org/obo/HP_0001659> rdfs:label "Aortic regurgitation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An insufficiency of the aortic valve, leading to regurgitation (backward flow) of blood from the aorta into the left ventricle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aortic insufficiency"^^<http://example.org/invalidDatatype>,
