        "SNOMEDCT_US:57138009" .

<http://purl.obolibrary.org/obo/HP_0000545> rdfs:label "Myopia" ;
    dcterms:description "An abnormality of refraction characterized by the ability to see objects nearby clearly, while objects in the distance appear blurry."^^<http://example.org/invalidDatatype> ;
