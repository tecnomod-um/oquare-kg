<http://purl.obolibrary.org/obo/HP_0100651> rdfs:label "Type I diabetes mellitus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A chronic condition in which the pancreas produces little or no insulin. Type I diabetes mellitus is manifested by the sudden onset of severe hyperglycemia with rapid progression to diabetic ketoacidosis unless treated with insulin."^^<http://example.org/invalidDatatype> ;
