<http://purl.obolibrary.org/obo/HP_0000050> rdfs:label "Hypoplastic male external genitalia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Underdevelopment of part or all of the male external reproductive organs (which include the penis, the scrotum and the urethra)."^^<http://example.org/invalidDatatype> ;
