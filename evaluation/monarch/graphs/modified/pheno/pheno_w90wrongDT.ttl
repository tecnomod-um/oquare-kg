<http://purl.obolibrary.org/obo/HP_0000713> rdfs:label "Agitation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A state of excessive motor activity that is associated with mental distress or a feeling of substantial unease or inner tension. Distinguished from restlessness by the increased level of emotional distress and negative intensity of the experience. Agitation has a significant level of physical activity that is typically threatening to the self or others."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Psychomotor agitation" ;
    ns1:synonym "Psychomotor agitation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:24199005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085631"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000726> rdfs:label "Dementia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A loss of global cognitive ability of sufficient amount to interfere with normal social or occupational function. Dementia represents a loss of previously present cognitive abilities, generally in adults, and can affect memory, thinking, language, judgment, and behavior." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dementia"^^<http://example.org/invalidDatatype>,
        "Dementia, progressive"^^<http://example.org/invalidDatatype>,
        "Progressive dementia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dementia, progressive"^^<http://example.org/invalidDatatype>,
        "Progressive dementia"^^<http://example.org/invalidDatatype>,
        "Dementia" ;
    ns1:xref "SNOMEDCT_US:52448006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0497327"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000741> rdfs:label "Apathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Apathy is a quantitative reduction of interest, motivation and the initiation and persistence of goal-directed behavior, where often the accompanying emotions, thoughts, and social interactions are also diminished. The individual is typically non-reactive to provocations, positive or negative, and appears to not care. Distinguished from lethargy which involves lack of physical or mental energy."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lack of feeling, emotion, interest"^^<http://example.org/invalidDatatype>,
        "State of indifference"^^<http://example.org/invalidDatatype>,
        "Lack of feeling, emotion, interest, motivation, initiation" ;
    ns1:synonym "Lack of feeling, emotion, interest"^^<http://example.org/invalidDatatype>,
        "Lack of feeling, emotion, interest, motivation, initiation"^^<http://example.org/invalidDatatype>,
        "State of indifference"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:20602000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085632"^^<http://example.org/invalidDatatype> .

