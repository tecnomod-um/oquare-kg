<http://purl.obolibrary.org/obo/HP_0001818> rdfs:label "Paronychia" ;
    dcterms:description "The nail disease paronychia is an often-tender bacterial or fungal hand infection or foot infection where the nail and skin meet at the side or the base of a finger or toenail. The infection can start suddenly (acute paronychia) or gradually (chronic paronychia)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "MEDDRA:10034016"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:71906005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0030578"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001875> rdfs:label "Decreased total neutrophil count"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal decrease of absolute number of neutrophils in the blood, per microlitre, compared to a reference range for a given sex and age-group."^^<http://example.org/invalidDatatype> ;
