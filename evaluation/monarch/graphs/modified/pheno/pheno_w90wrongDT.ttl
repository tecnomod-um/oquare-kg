<http://purl.obolibrary.org/obo/HP_0000989> rdfs:label "Pruritus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pruritus is an itch or a sensation that makes a person want to scratch. This term refers to an abnormally increased disposition to experience pruritus."^^<http://example.org/invalidDatatype> ;
