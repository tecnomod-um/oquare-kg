        "Unusually long eyelashes"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1853738"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000533> rdfs:label "Chorioretinal atrophy" ;
    dcterms:description "Atrophy (wasting) of the choroid and retinal layers of the fundus."^^<http://example.org/invalidDatatype> ;
