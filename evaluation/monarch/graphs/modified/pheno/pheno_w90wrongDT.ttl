<http://purl.obolibrary.org/obo/HP_0000006> rdfs:label "Autosomal dominant inheritance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in heterozygotes. In the context of medical genetics, an autosomal dominant disorder is caused when a single copy of the mutant allele is present. Males and females are affected equally, and can both transmit the disorder with a risk of 50% for each child of inheriting the mutant allele."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Autosomal dominant"^^<http://example.org/invalidDatatype>,
        "monoallelic_autosomal"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Autosomal dominant form"^^<http://example.org/invalidDatatype>,
        "Autosomal dominant type"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Autosomal dominant"^^<http://example.org/invalidDatatype>,
        "Autosomal dominant form"^^<http://example.org/invalidDatatype>,
        "Autosomal dominant type"^^<http://example.org/invalidDatatype>,
        "monoallelic_autosomal"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:263681008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0443147"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000007> rdfs:label "Autosomal recessive inheritance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in individuals with two pathogenic alleles, either homozygotes (two copies of the same mutant allele) or compound heterozygotes (whereby each copy of a gene has a distinct mutant allele)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Autosomal recessive"^^<http://example.org/invalidDatatype>,
        "biallelic_autosomal"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Autosomal recessive form"^^<http://example.org/invalidDatatype>,
        "Autosomal recessive predisposition"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Autosomal recessive"^^<http://example.org/invalidDatatype>,
        "Autosomal recessive form"^^<http://example.org/invalidDatatype>,
        "Autosomal recessive predisposition"^^<http://example.org/invalidDatatype>,
        "biallelic_autosomal"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:258211005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0441748"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020899"^^<http://example.org/invalidDatatype> .

