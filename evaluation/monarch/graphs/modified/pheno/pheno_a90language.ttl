<http://purl.obolibrary.org/obo/HP_0100018> rdfs:label "Nuclear cataract"@en ;
    dcterms:description "A nuclear cataract is an opacity or clouding that develops in the lens nucleus. That is, a nuclear cataract is one that is located in the center of the lens. The nucleus tends to darken changing from clear to yellow and sometimes brown."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Yellowish cloudy center of lens",
        "Yellowish cloudy centre of lens" ;
    ns1:synonym "Yellowish cloudy center of lens",
        "Yellowish cloudy centre of lens"@en ;
    ns1:xref "SNOMEDCT_US:53889007"@en,
        "UMLS:C0392557"@en .

