<http://purl.obolibrary.org/obo/HP_0000510> rdfs:label "Rod-cone dystrophy"@en ;
    dcterms:description "An inherited retinal disease subtype in which the rod photoreceptors appear to be more severely affected than the cone photoreceptors. Typical presentation is with nyctalopia (due to rod dysfunction) followed by loss of mid-peripheral field of vision, which gradually extends and leaves many patients with a small central island of vision due to the preservation of macular cones."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinitis pigmentosa"@en,
        "Rod cone dystrophy"@en ;
    ns1:synonym "Retinitis pigmentosa",
        "Rod cone dystrophy"@en ;
    ns1:xref "SNOMEDCT_US:28835009"@en,
        "UMLS:C0035334"@en .

