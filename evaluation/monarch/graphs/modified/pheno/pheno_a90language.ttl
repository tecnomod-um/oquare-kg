        "Persistent wide fontanel"@en,
        "Wide fontanelles"@en ;
    ns1:narrow_synonym "Large bregma sutures"@en,
        "Large, late-closing fontanelle"@en,
        "Wide bregma sutures"@en ;
    ns1:synonym "Enlarged fontanelles"@en,
        "Large bregma sutures"@en,
        "Large fontanel"@en,
        "Large fontanelle"@en,
        "Large fontanels"@en,
        "Large, late-closing fontanelle"@en,
        "Persistent wide fontanel"@en,
        "Wide bregma sutures"@en,
        "Wide fontanelles"@en ;
