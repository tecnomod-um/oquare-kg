<http://purl.obolibrary.org/obo/HP_0000618> rdfs:label "Blindness"@en ;
    dcterms:description "Blindness is the condition of lacking visual perception defined as a profound reduction in visual perception. On the 6m visual acuity scale, blindness is defined as less than 3/60. On the 20ft visual acuity scale, blindness is defined as less than 20/400. On the decimal visual acuity scale, blindness is defined as less than 0.05. Blindness is typically characterized by a visual field of no greater than 10 degrees in radius around central fixation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blindness"@en,
        "Total vision loss"@en ;
    ns1:related_synonym "Legal blindness"@en ;
    ns1:synonym "Blindness"@en,
        "Legal blindness"@en,
        "Total vision loss"@en ;
    ns1:xref "Fyler:4866"@en,
        "SNOMEDCT_US:65956007"@en,
        "UMLS:C0271215"@en,
        "UMLS:C0456909"@en .

