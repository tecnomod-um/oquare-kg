<http://purl.obolibrary.org/obo/HP_0000006> rdfs:label "Autosomal dominant inheritance"@en ;
    dcterms:description "A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in heterozygotes. In the context of medical genetics, an autosomal dominant disorder is caused when a single copy of the mutant allele is present. Males and females are affected equally, and can both transmit the disorder with a risk of 50% for each child of inheriting the mutant allele."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "monoallelic_autosomal",
        "Autosomal dominant"@en ;
    ns1:related_synonym "Autosomal dominant form"@en,
        "Autosomal dominant type"@en ;
    ns1:synonym "Autosomal dominant",
        "Autosomal dominant form"@en,
        "Autosomal dominant type"@en,
        "monoallelic_autosomal"@en ;
    ns1:xref "SNOMEDCT_US:263681008"@en,
        "UMLS:C0443147"@en .

<http://purl.obolibrary.org/obo/HP_0000007> rdfs:label "Autosomal recessive inheritance"@en ;
    dcterms:description "A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in individuals with two pathogenic alleles, either homozygotes (two copies of the same mutant allele) or compound heterozygotes (whereby each copy of a gene has a distinct mutant allele)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Autosomal recessive"@en,
        "biallelic_autosomal"@en ;
    ns1:related_synonym "Autosomal recessive form"@en,
        "Autosomal recessive predisposition"@en ;
    ns1:synonym "Autosomal recessive"@en,
        "Autosomal recessive form"@en,
        "Autosomal recessive predisposition"@en,
        "biallelic_autosomal"@en ;
    ns1:xref "SNOMEDCT_US:258211005"@en,
        "UMLS:C0441748"@en,
        "UMLS:C4020899"@en .

<http://purl.obolibrary.org/obo/HP_0000010> rdfs:label "Recurrent urinary tract infections"@en ;
    dcterms:description "Repeated infections of the urinary tract."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Repeated bladder infections",
        "Frequent urinary tract infections"@en,
        "Recurrent UTIs"@en,
        "Repeated urinary tract infections"@en,
        "Urinary tract infections"@en,
        "Urinary tract infections, recurrent"@en ;
    ns1:synonym "Repeated urinary tract infections",
        "Frequent urinary tract infections"@en,
        "Recurrent UTIs"@en,
        "Repeated bladder infections"@en,
        "Urinary tract infections"@en,
        "Urinary tract infections, recurrent"@en ;
    ns1:xref "SNOMEDCT_US:197927001"@en,
        "UMLS:C0262655"@en .

<http://purl.obolibrary.org/obo/HP_0000023> rdfs:label "Inguinal hernia"@en ;
    dcterms:description "Protrusion of the contents of the abdominal cavity through the inguinal canal." ;
