    dcterms:description "Reduced ability of the lungs to transfer gas from inspired air to the bloodstream as measured by the diffusing capacity of the lungs for carbon monoxide (DLCO) test."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased diffusing capacity"@en ;
    ns1:synonym "Decreased diffusing capacity"@en ;
    ns1:xref "UMLS:C4073175"@en .

<http://purl.obolibrary.org/obo/HP_0045073> rdfs:label "Serositis" ;
