<http://purl.obolibrary.org/obo/HP_0000100> rdfs:label "Nephrotic syndrome"@en ;
    dcterms:description "Nephrotic syndrome is a collection of findings resulting from glomerular dysfunction with an increase in glomerular capillary wall permeability associated with pronounced proteinuria. Nephrotic syndrome refers to the constellation of clinical findings that result from severe renal loss of protein, with Proteinuria and hypoalbuminemia, edema, and hyperlipidemia."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nephrosis"@en ;
    ns1:synonym "Nephrosis"@en ;
    ns1:xref "SNOMEDCT_US:52254009"@en,
        "UMLS:C0027726"@en .

