    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react to thyroglobulin." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-thyroid globulin antibody positivity"@en,
        "TgAbs"@en ;
    ns1:synonym "Anti-thyroid globulin antibody positivity"@en,
        "TgAbs"@en .

<http://purl.obolibrary.org/obo/HP_0032153> rdfs:label "Joint subluxation"@en ;
    dcterms:description "A partial dislocation of a joint."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032230> rdfs:label "Cytoplasmic antineutrophil antibody positivity"@en ;
    dcterms:description "The presence of autoantibodies in the serum that react against proteins predominantly expressed in cytoplasmic granules of neutrophils."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-neutrophil cytoplasmic antibody positivity"@en,
        "C-ANCA antibodies"@en,
        "Cytoplasmic antineutrophil cytoplasmic antibodies"@en ;
    ns1:synonym "Cytoplasmic antineutrophil cytoplasmic antibodies",
        "Anti-neutrophil cytoplasmic antibody positivity"@en,
        "C-ANCA antibodies"@en .

<http://purl.obolibrary.org/obo/HP_0032638> rdfs:label "Elevated urine mevalonic acid level"@en ;
    dcterms:description "An abnormally increased amount of mevanolate in the urine. Mevanolate is that hydroxy monocarboxylic acid anion that is the conjugate base of mevalonic acid."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urine mevalonate",
        "Mevalonate aciduria",
        "Elevated urine mevalonate levels"@en,
        "Elevated urine mevalonic acid"@en ;
    ns1:synonym "Elevated urine mevalonate"@en,
        "Elevated urine mevalonate levels"@en,
        "Elevated urine mevalonic acid"@en,
        "Mevalonate aciduria"@en .

<http://purl.obolibrary.org/obo/HP_0033028> rdfs:label "Anti-U1 ribonucleoprotein antibody positivity"@en ;
    dcterms:description "The presence autoantibodies in the serum that react to proteins (70 Kd, A, C) that are associated with U1 RNA and form U1snRNP."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-RNP-antibodies",
        "Anti-U1-RNP antibody positivity"@en ;
    ns1:narrow_synonym "Anti-Scl-34 antibody positivity"@en,
