<http://purl.obolibrary.org/obo/HP_0000873> rdfs:label "Diabetes insipidus"@en ;
    dcterms:description "A state of excessive water intake and hypotonic (dilute) polyuria. Diabetes insipidus may be due to failure of vasopressin (AVP) release (central or neurogenic diabetes insipidus) or to a failure of the kidney to respond to AVP (nephrogenic diabetes insipidus)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:15771004"@en,
        "UMLS:C0011848"@en .

<http://purl.obolibrary.org/obo/HP_0000926> rdfs:label "Platyspondyly"@en ;
    dcterms:description "A flattened vertebral body shape with reduced distance between the vertebral endplates."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flat vertebral bodies"@en,
        "Flattened vertebrae"@en,
        "Flattened vertebral bodies"@en ;
    ns1:synonym "Flat vertebral bodies"@en,
