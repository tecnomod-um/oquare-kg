        "Anti-RNP-antibodies"@en,
        "Anti-Scl-34 antibody positivity"@en,
        "Anti-U3 ribonucleoprotein antibody positivity"@en .

<http://purl.obolibrary.org/obo/HP_0033050> rdfs:label "Pharyngalgia"@en ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) and perceived to originate in the throat."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pharyngodynia"@en,
        "Sore throat"@en,
        "Throat discomfort"@en,
        "Throat pain"@en ;
    ns1:synonym "Sore throat",
        "Pharyngodynia"@en,
        "Throat discomfort"@en,
        "Throat pain"@en .

<http://purl.obolibrary.org/obo/HP_0033178> rdfs:label "Increased circulating interleukin 8 concentration"@en ;
    dcterms:description "An increased concentration of interleukin-8 in the circulation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum IL-8"@en,
        "Increased serum interleukin 8"@en,
        "Increased serum interleukin-8"@en ;
    ns1:synonym "Increased serum IL-8"@en,
        "Increased serum interleukin 8"@en,
        "Increased serum interleukin-8"@en .

<http://purl.obolibrary.org/obo/HP_0033331> rdfs:label "Acute phase response"@en ;
    dcterms:description "Presence of one or more manifestations of the acute phase response. Acute phase proteins (APP) are blood proteins primarily synthesized by hepatocytes as part of the acute phase response (APR). The APR is part of the early-defense or innate immune system, which is triggered by different stimuli including trauma, infection, stress, neoplasia, and inflammation. The APR results in a complex systemic reaction with the goal of reestablishing homeostasis and promoting healing."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033430> rdfs:label "Non-infectious meningitis"@en ;
    dcterms:description "Inflammation of the layers of tissue that cover the brain and spinal cord (meninges) and of the fluid-filled space between the meninges (subarachnoid space) when it is caused by disorders that are not infections or by drugs or vaccines."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aseptic meningitis"@en ;
    ns1:synonym "Aseptic meningitis"@en .

<http://purl.obolibrary.org/obo/HP_0033505> rdfs:label "Livedo reticularis"@en ;
    dcterms:description "Livedo reticularis is characterized by the presence of a bluish purple, mottled or netlike pattern in unbroken circles on the skin. Exposure to cold environments usually intensifies the vascular pattern. Presumably, the condition results from slow or stagnant blood flow, vessel-wall pathology, and decreased oxygen tension."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033677> rdfs:label "Acute respiratory distress syndrome"@en ;
    dcterms:description "Acute respiratory distress syndrome (ARDS) is defined as an acute disorder that starts within seven days of the inciting event and is characterized by bilateral lung infiltrates and severe progressive hypoxemia in the absence of any evidence of cardiogenic pulmonary edema. ARDS is defined by the patient's oxygen in arterial blood (PaO2) to the fraction of the oxygen in the inspired air (FiO2). These patients have a PaO2/FiO2 ratio of less than 300."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "ARDS" ;
    ns1:synonym "ARDS"@en .

<http://purl.obolibrary.org/obo/HP_0040049> rdfs:label "Macular edema"@en ;
    dcterms:description "Thickening of the retina that takes place due to accumulation of extracellular fluid in the macula as a nonspecific response to blood-retinal barrier breakdown. It can either have a cystoid aspect in the fovea, or a more diffuse aspect."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular oedema"@en ;
    ns1:synonym "Macular oedema"@en ;
    ns1:xref "SNOMEDCT_US:37231002",
        "UMLS:C0271051"@en .

<http://purl.obolibrary.org/obo/HP_0040189> rdfs:label "Scaling skin" ;
    dcterms:description "Refers to the loss of the outer layer of the epidermis in large, scale-like flakes."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Desquamation"@en,
        "Scaling skin"@en,
        "Scaly skin"@en,
        "flaking skin"@en,
        "peeling skin"@en ;
    ns1:related_synonym "Exfoliation"@en ;
    ns1:synonym "Exfoliation",
        "Desquamation"@en,
        "Scaling skin"@en,
        "Scaly skin"@en,
        "flaking skin"@en,
        "peeling skin"@en ;
    ns1:xref "SNOMEDCT_US:14411002"@en,
        "SNOMEDCT_US:271767006"@en,
        "UMLS:C0237849"@en .

<http://purl.obolibrary.org/obo/HP_0040313> rdfs:label "Oligoarthritis"@en ;
    dcterms:description "A type of arthritis that affects up to four joints in the first six months of disease."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0100255> rdfs:label "Metaphyseal dysplasia"@en ;
    dcterms:description "The presence of dysplastic regions in metaphyseal regions."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:27837003"@en,
        "UMLS:C0265294"@en .

<http://purl.obolibrary.org/obo/HP_0100279> rdfs:label "Ulcerative colitis"@en ;
    dcterms:description "A chronic inflammatory bowel disease that includes characteristic ulcers, or open sores, in the colon. The main symptom of active disease is usually constant diarrhea mixed with blood, of gradual onset and intermittent periods of exacerbated symptoms contrasting with periods that are relatively symptom-free. In contrast to Crohn's disease this special form of colitis begins in the distal parts of the rectum, spreads continually upwards and affects only mucose and submucose tissue of the colon."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Colitis ulcerosa"@en ;
    ns1:synonym "Colitis ulcerosa"@en ;
    ns1:xref "SNOMEDCT_US:64766004"@en,
        "UMLS:C0009324"@en .

<http://purl.obolibrary.org/obo/HP_0100543> rdfs:label "Cognitive impairment"@en ;
    dcterms:description "Abnormal cognition is characterized by deficits in thinking, reasoning, or remembering."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of cognition"@en,
        "Cognitive abnormality"@en,
        "Cognitive defects"@en,
        "Cognitive deficits"@en,
        "Cognitive impairment"@en,
        "Intellectual impairment"@en ;
    ns1:synonym "Abnormality of cognition"@en,
        "Cognitive abnormality"@en,
        "Cognitive defects"@en,
        "Cognitive deficits"@en,
        "Cognitive impairment"@en,
        "Intellectual impairment"@en ;
    ns1:xref "SNOMEDCT_US:386806002"@en,
        "UMLS:C0338656"@en,
        "UMLS:C0683322"@en .

<http://purl.obolibrary.org/obo/HP_0100651> rdfs:label "Type I diabetes mellitus"@en ;
    dcterms:description "A chronic condition in which the pancreas produces little or no insulin. Type I diabetes mellitus is manifested by the sudden onset of severe hyperglycemia with rapid progression to diabetic ketoacidosis unless treated with insulin."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Type 1 diabetes",
        "Diabetes mellitus Type I"@en,
        "Juvenile diabetes mellitus"@en,
        "Type I diabetes"@en ;
    ns1:related_synonym "Insulin-dependent diabetes mellitus"@en ;
    ns1:synonym "Type 1 diabetes",
        "Diabetes mellitus Type I"@en,
        "Insulin-dependent diabetes mellitus"@en,
