<http://purl.obolibrary.org/obo/HP_0002415> rdfs:label "Leukodystrophy"@en ;
    dcterms:description "Leukodystrophy refers to deterioration of white matter of the brain resulting from degeneration of myelin sheaths in the CNS. Their basic defect is directly related to the synthesis and maintenance of myelin membranes. Symmetric white matter involvement at MRI is a typical finding in patients with leukodystrophies."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Degeneration of white matter of brain"@en ;
    ns1:synonym "Degeneration of white matter of brain"@en ;
    ns1:xref "UMLS:C0023520",
        "SNOMEDCT_US:192781003"@en .

<http://purl.obolibrary.org/obo/HP_0002725> rdfs:label "Systemic lupus erythematosus"@en ;
    dcterms:description "A chronic, relapsing, inflammatory, and often febrile multisystemic disorder of connective tissue, characterized principally by involvement of the skin, joints, kidneys, and serosal membranes."@en ;
