<http://purl.obolibrary.org/obo/HP_0000938> rdfs:label "Osteopenia"@en ;
    dcterms:description "Osteopenia is a term to define bone density that is not normal but also not as low as osteoporosis. By definition from the World Health Organization osteopenia is defined by bone densitometry as a T score -1 to -2.5."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Generalised osteopenia"@en,
        "Generalized osteopenia"@en,
        "Osteopaenia"@en ;
    ns1:synonym "Osteopaenia",
        "Generalised osteopenia"@en,
        "Generalized osteopenia"@en ;
    ns1:xref "SNOMEDCT_US:312894000"@en,
        "SNOMEDCT_US:78441005"@en,
        "UMLS:C0029453"@en,
        "UMLS:C0747078"@en .

<http://purl.obolibrary.org/obo/HP_0000965> rdfs:label "Cutis marmorata"@en ;
    dcterms:description "A reticular discoloration of the skin with cyanotic (reddish-blue appearing) areas surrounding pale central areas due to dilation of capillary blood vessels and stagnation of blood within the vessels. Cutis marmorata generally occurs on the legs, arms and trunk and is often more severe in cold weather."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0263401"@en .

<http://purl.obolibrary.org/obo/HP_0001251> rdfs:label "Ataxia" ;
    dcterms:description "Ataxia refers to impaired coordination of voluntary muscle movement. Cerebellar ataxia refers to ataxia due to dysfunction of the cerebellum. This causes a variety of elementary neurological deficits including asynergy (lack of coordination between muscles, limbs and joints), dysmetria (lack of ability to judge distances that can lead to under- or overshoot in grasping movements), and dysdiadochokinesia (inability to perform rapid movements requiring antagonizing muscle groups to be switched on and off repeatedly)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cerebellar ataxia"@en ;
    ns1:synonym "Cerebellar ataxia"@en ;
    ns1:xref "SNOMEDCT_US:85102008"@en,
        "UMLS:C0007758"@en .

<http://purl.obolibrary.org/obo/HP_0001394> rdfs:label "Cirrhosis"@en ;
    dcterms:description "A chronic disorder of the liver in which liver tissue becomes scarred and is partially replaced by regenerative nodules and fibrotic tissue resulting in loss of liver function."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hepatic cirrhosis"@en,
        "Scar tissue replaces healthy tissue in the liver"@en ;
    ns1:related_synonym "Liver cirrhosis"@en ;
    ns1:synonym "Hepatic cirrhosis"@en,
        "Liver cirrhosis"@en,
        "Scar tissue replaces healthy tissue in the liver"@en ;
    ns1:xref "SNOMEDCT_US:19943007"@en,
        "UMLS:C0023890"@en .

<http://purl.obolibrary.org/obo/HP_0001395> rdfs:label "Hepatic fibrosis" ;
    dcterms:description "The presence of excessive fibrous connective tissue in the liver. Fibrosis is a reparative or reactive process." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Liver fibrosis"@en ;
    ns1:synonym "Liver fibrosis"@en ;
    ns1:xref "SNOMEDCT_US:62484002"@en,
        "UMLS:C0239946"@en .

<http://purl.obolibrary.org/obo/HP_0001409> rdfs:label "Portal hypertension"@en ;
    dcterms:description "Increased pressure in the portal vein."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:34742003"@en,
        "UMLS:C0020541"@en .

<http://purl.obolibrary.org/obo/HP_0001973> rdfs:label "Autoimmune thrombocytopenia"@en ;
    dcterms:description "The presence of thrombocytopenia in combination with detection of antiplatelet antibodies." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Immune thrombocytopenia",
        "Idiopathic thrombocytopenia"@en ;
    ns1:related_synonym "Idiopathic thrombocytopenic purpura"@en ;
