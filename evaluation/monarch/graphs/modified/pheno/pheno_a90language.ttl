<http://purl.obolibrary.org/obo/HP_0000956> rdfs:label "Acanthosis nigricans"@en ;
    dcterms:description "A dermatosis characterized by thickened, hyperpigmented plaques, typically on the intertriginous surfaces and neck."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Darkened and thickened skin"@en,
        "Keratosis nigricans"@en ;
    ns1:synonym "Keratosis nigricans",
        "Darkened and thickened skin"@en ;
    ns1:xref "SNOMEDCT_US:402599005"@en,
        "SNOMEDCT_US:72129000"@en,
        "UMLS:C0000889"@en .

<http://purl.obolibrary.org/obo/HP_0000957> rdfs:label "Cafe-au-lait spot"@en ;
    dcterms:description "Cafe-au-lait spots are hyperpigmented lesions that can vary in color from light brown to dark brown with smooth borders and having a size of 1.5 cm or more in adults and 0.5 cm or more in children."@en ;
