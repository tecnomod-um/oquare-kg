<http://purl.obolibrary.org/obo/HP_0012647> rdfs:label "Abnormal inflammatory response"@en ;
    dcterms:description "Any anomaly of the inflammatory response, a response to injury or infection characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells and macrophages."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal inflammatory response" ;
    ns1:synonym "Abnormal inflammatory response"@en ;
    ns1:xref "UMLS:C4022805"@en .

<http://purl.obolibrary.org/obo/HP_0020151> rdfs:label "Anti-dsDNA antibody positivity"@en ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against double-stranded DNA."@en ;
    ns1:category ns1:PhenotypicFeature ;
