        "UMLS:C0497327"@en .

<http://purl.obolibrary.org/obo/HP_0000741> rdfs:label "Apathy"@en ;
    dcterms:description "Apathy is a quantitative reduction of interest, motivation and the initiation and persistence of goal-directed behavior, where often the accompanying emotions, thoughts, and social interactions are also diminished. The individual is typically non-reactive to provocations, positive or negative, and appears to not care. Distinguished from lethargy which involves lack of physical or mental energy."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lack of feeling, emotion, interest"@en,
        "Lack of feeling, emotion, interest, motivation, initiation"@en,
        "State of indifference"@en ;
