    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000441> rdfs:label "Abnormal circulating interleukin 6 concentration"@en ;
    dcterms:description "Any deviation from the normal range of the concentration of interleukin 6 (IL-6) in the blood circulation."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000562> rdfs:label "Reduced circulating adenosine deaminase-2 activity"@en ;
