        "SNOMEDCT_US:32273002"@en,
        "UMLS:C0398650"@en .

<http://purl.obolibrary.org/obo/HP_0002017> rdfs:label "Nausea and vomiting"@en ;
    dcterms:description "Nausea is a commonly encountered symptom that has been defined as an unpleasant painless subjective feeling that one will imminently vomit. Vomiting has been defined as the forceful expulsion of the contents of the stomach, duodenum, or jejunum through the oral cavity. While nausea and vomiting are often thought to exist on a temporal continuum, this is not always the case. There are situations when severe nausea may be present without emesis and less frequently, when emesis may be present without preceding nausea." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nausea and vomiting"@en ;
    ns1:synonym "Nausea and vomiting"@en ;
    ns1:xref "SNOMEDCT_US:16932000"@en,
        "UMLS:C0027498"@en .

<http://purl.obolibrary.org/obo/HP_0002024> rdfs:label "Malabsorption" ;
    dcterms:description "Impaired ability to absorb one or more nutrients from the intestine."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intestinal malabsorption"@en,
        "Malabsorption"@en ;
    ns1:synonym "Intestinal malabsorption"@en,
