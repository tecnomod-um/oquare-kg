        "Morphological abnormality of the pyramidal tract"@en,
        "Pyramidal tract disease"@en ;
    ns1:xref "UMLS:C4020859"@en,
        "UMLS:C4021761"@en .

<http://purl.obolibrary.org/obo/HP_0002063> rdfs:label "Rigidity" ;
    dcterms:description "Continuous involuntary sustained muscle contraction. When an affected muscle is passively stretched, the degree of resistance remains constant regardless of the rate at which the muscle is stretched. This feature helps to distinguish rigidity from muscle spasticity."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Muscle rigidity"@en,
