<http://purl.obolibrary.org/obo/HP_0200057> rdfs:label "Marcus Gunn pupil"@en ;
    dcterms:description "An aberrant pupillary response characterized by (i) Constriction of pupils of both eyes when the light stimulus is applied to the normal eye, and (ii) Dilatation of pupils of both eyes when the light stimulus is rapidly transferred from the normal eye (after brief light exposure to the normal eye) to the affected eye."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Relative afferent pupil defect",
        "Relative afferent pupillary defect"@en ;
    ns1:synonym "Relative afferent pupillary defect",
        "Relative afferent pupil defect"@en ;
    ns1:xref "UMLS:C0549122",
        "SNOMEDCT_US:232122003"@en,
        "SNOMEDCT_US:247015002"@en .

<http://purl.obolibrary.org/obo/HP_0200123> rdfs:label "Chronic hepatitis"@en ;
    dcterms:description "Hepatitis that lasts for more than six months."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic liver inflammation"@en ;
    ns1:synonym "Chronic liver inflammation"@en ;
    ns1:xref "SNOMEDCT_US:76783007"@en,
        "UMLS:C0019189"@en .

<http://purl.obolibrary.org/obo/HP_0410174> rdfs:label "Increased circulating troponin T concentration"@en ;
    dcterms:description "An increased concentration of tropnin T in the blood, which is a cardiac regulatory protein that controls the calcium mediated interaction between actin and myosin. Raised cardiac troponin concentrations are now accepted as the standard biochemical marker for the diagnosis of myocardial infarction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased troponin T level in blood" ;
    ns1:synonym "Increased troponin T level in blood"@en .

<http://purl.obolibrary.org/obo/HP_0410242> rdfs:label "Abnormal circulating IgG concentration"@en ;
    dcterms:description "An abnormal deviation from normal levels of IgG immunoglobulin in blood."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal IgG level in blood"@en,
        "Abnormal circulating IgG level"@en ;
    ns1:synonym "Abnormal IgG level in blood",
        "Abnormal circulating IgG level"@en .

