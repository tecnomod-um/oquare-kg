<http://purl.obolibrary.org/obo/HP_0002570> rdfs:label "Steatorrhea" ;
    dcterms:description "Greater than normal amounts of fat in the feces. This is a result of malabsorption of lipids in the small intestine and results in frothy foul-smelling fecal matter that floats." ;
    ns1:category ns1:PhenotypicFeature ;
