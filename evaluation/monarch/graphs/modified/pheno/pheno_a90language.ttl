        "SNOMEDCT_US:52522001"@en,
        "UMLS:C0154671"@en,
        "UMLS:C0235946"@en .

<http://purl.obolibrary.org/obo/HP_0012534> rdfs:label "Dysesthesia"@en ;
    dcterms:description "Painful sensations elicited by a nonpainful cutaneous stimulus such as a light touch or gentle stroking over affected areas of the body. Sometimes referred to as hyperpathia or hyperalgesia. Often perceived as an intense burning, dyesthesias may outlast the stimulus by several seconds."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysaesthesia"@en,
        "Hyperalgesia"@en,
        "Hyperpathia"@en ;
    ns1:related_synonym "Dysesthesias"@en ;
    ns1:synonym "Dysaesthesia"@en,
        "Dysesthesias"@en,
        "Hyperalgesia"@en,
        "Hyperpathia"@en ;
    ns1:xref "SNOMEDCT_US:279079003",
        "UMLS:C0392699"@en .

<http://purl.obolibrary.org/obo/HP_0012544> rdfs:label "Elevated circulating aldolase concentration"@en ;
    dcterms:description "Concentration of fructose 1,6-bisphosphate aldolase in the blood circulation above the upper limit of normal."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated aldolase level"@en ;
    ns1:synonym "Elevated aldolase level"@en ;
    ns1:xref "UMLS:C4022858"@en .

<http://purl.obolibrary.org/obo/HP_0012574> rdfs:label "Mesangial hypercellularity"@en ;
    dcterms:description "Increased numbers of mesangial cells per glomerulus, defined as more than 3 nuclei fully surrounded by matrix in one or more mesangial areas, not including perihilar region, on a standard 3-micron-thick tissue section, best evaluated on periodic acid-Schiff (PAS) stain."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mesangial proliferation"@en ;
    ns1:synonym "Mesangial proliferation"@en ;
    ns1:xref "SNOMEDCT_US:125510009"@en,
        "UMLS:C0545017"@en .

<http://purl.obolibrary.org/obo/HP_0012593> rdfs:label "Nephrotic range proteinuria"@en ;
    dcterms:description "Severely increased amount of excretion of protein in the urine, defined as 3.5 grams per day or more in adults and 40 mg per meter-squared body surface area per hour in children."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:264867001"@en,
        "UMLS:C0445118"@en .

<http://purl.obolibrary.org/obo/HP_0012649> rdfs:label "Increased inflammatory response"@en ;
    dcterms:description "A abnormal increase in the inflammatory response to injury or infection."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022803"@en .

<http://purl.obolibrary.org/obo/HP_0012722> rdfs:label "Heart block" ;
    dcterms:description "Impaired conduction of cardiac impulse occurring anywhere along the conduction pathway."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:233916004"@en,
        "UMLS:C0018794"@en .

<http://purl.obolibrary.org/obo/HP_0012758> rdfs:label "Neurodevelopmental delay"@en ;
    dcterms:description "Neurodevelopmental delay (NDD) refers to delays in the maturation of the brain and central nervous system; infants and young children with NDD may experience delays in the development of one or more skills including gross motor abilities, fine-motor coordination, language abilities and ability to solve increasingly complex problems." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "NDD"@en ;
    ns1:synonym "NDD"@en ;
    ns1:xref "UMLS:C4022738"@en .

<http://purl.obolibrary.org/obo/HP_0012785> rdfs:label "Flexion contracture of finger"@en ;
    dcterms:description "Chronic loss of joint motion in a finger due to structural changes in non-bony tissue."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flexion deformity of finger"@en ;
    ns1:synonym "Flexion deformity of finger"@en ;
    ns1:xref "UMLS:C1857304"@en .

<http://purl.obolibrary.org/obo/HP_0012802> rdfs:label "Broad jaw"@en ;
    dcterms:description "Bigonial distance (lower facial width) more than 2 SD above the mean (objective); or an apparently increased width of the lower jaw (mandible) when viewed from the front (subjective)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad jaw"@en,
        "Broad lower face"@en,
        "Broad mandible"@en,
        "Wide jaw"@en,
        "Wide mandible"@en ;
    ns1:synonym "Broad lower face",
        "Wide jaw",
        "Broad jaw"@en,
        "Broad mandible"@en,
        "Wide mandible"@en ;
    ns1:xref "UMLS:C3281059" .

<http://purl.obolibrary.org/obo/HP_0012819> rdfs:label "Myocarditis"@en ;
    dcterms:description "Inflammation of the myocardium." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of heart muscle"@en ;
    ns1:synonym "Inflammation of heart muscle"@en ;
    ns1:xref "SNOMEDCT_US:50920009"@en,
        "UMLS:C0027059"@en .

<http://purl.obolibrary.org/obo/HP_0020062> rdfs:label "Decreased hemoglobin concentration" ;
    dcterms:description "An abnormal reduction below normal hemoglobin concentration in the circulation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased Hb concentration"@en,
        "Decreased haemoglobin concentration"@en ;
    ns1:synonym "Decreased Hb concentration"@en,
        "Decreased haemoglobin concentration"@en .

<http://purl.obolibrary.org/obo/HP_0020086> rdfs:label "BCGitis"@en ;
    dcterms:description "Local or regional infection with Bacillus Calmette-Guerin (BCG) following vaccination."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025066> rdfs:label "Decreased mean corpuscular volume" ;
    dcterms:description "A reduction from normal of the mean corpuscular volume, or mean cell volume (MCV) of red blood cells (usually defined as an MCV below 80 femtoliters)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased MCV"@en,
        "Microcytosis"@en,
        "Reduced erythrocyte volume"@en ;
    ns1:synonym "Decreased MCV"@en,
        "Microcytosis"@en,
        "Reduced erythrocyte volume"@en .

<http://purl.obolibrary.org/obo/HP_0025156> rdfs:label "Dependency on intravenous nutrition"@en ;
    dcterms:description "Inability to be weaned from intravenous (parenteral) nutrition, as judged by the hydration status (urine output, blood urea nitrogen, creatinine, urine sodium concentration), ability to maintain weight, stool output, and serum electrolyte status."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dependency on IV nutrition"@en ;
    ns1:synonym "Dependency on IV nutrition"@en .

<http://purl.obolibrary.org/obo/HP_0025230> rdfs:label "Tendonitis"@en ;
    dcterms:description "Inflammation of a tendon."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Teninitis"@en ;
    ns1:synonym "Teninitis"@en .

<http://purl.obolibrary.org/obo/HP_0025252> rdfs:label "Geographic tongue"@en ;
    dcterms:description "An anomaly of the tongue characterized by loss (atrophy) of filiform papillae of the tongue, leaving areas of erythema (redness), surrounded by a serpiginous, white, hyperkeratotic border. The name geographic tongue refers to an appearance that is said to be similar to a map."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Annulus migrans"@en,
        "Benign migratory glossitis"@en,
        "Glossitis areata exfoliativa"@en,
        "Lingual erythema migrans"@en,
        "Wandering rash of the tongue"@en ;
    ns1:synonym "Benign migratory glossitis",
        "Annulus migrans"@en,
        "Glossitis areata exfoliativa"@en,
        "Lingual erythema migrans"@en,
        "Wandering rash of the tongue"@en .

<http://purl.obolibrary.org/obo/HP_0025300> rdfs:label "Malar rash"@en ;
    dcterms:description "An erythematous (red), flat facial rash that affects the skin in the malar area (over the cheekbones) and extends over the bridge of the nose."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Butterfly rash"@en,
        "Cheekbone rash"@en ;
    ns1:synonym "Cheekbone rash",
        "Butterfly rash"@en .

<http://purl.obolibrary.org/obo/HP_0025420> rdfs:label "Diffuse alveolar hemorrhage"@en ;
    dcterms:description "A type of of pulmonary hemorrhage that originates from the pulmonary microcirculation, including the alveolar capillaries, arterioles, and venules. It presents with hemoptysis, anemia, diffuse lung infiltration, and acute respiratory failure. The diagnosis is confirmed by the observation of the accumulation of red blood cells, fibrin, or hemosiderin-laden macrophage in the alveolar space on pathologic biopsy. Hemosiderin, a product of hemoglobin degradation, appears at least 48-72 hours after bleeding and is helpful in distinguishing diffuse alveolar hemorrhage from surgical trauma. Mild interstitial thickening, organizing pneumonia, or diffuse alveolar damage can also be seen."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Diffuse alveolar haemorrhage" ;
    ns1:synonym "Diffuse alveolar haemorrhage"@en .

<http://purl.obolibrary.org/obo/HP_0025526> rdfs:label "Psoriasiform lesion"@en ;
    dcterms:description "A skin lesions that resembles the lesions observed in psoriasis, viz., an erythematous plaque covered by fine silvery scales. Psoriasiform lesions can be observed in psoriasis as well as in other conditions including allergic contact dermatitis, seborrhoeic dermatitis, Atopic dermatitis, pityriasis rubra, and lichen simplex chronicus."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Psoriatic-like lesion"@en ;
    ns1:related_synonym "Erythemato-squamous plaque"@en,
        "Erythematosquamous plaque"@en ;
    ns1:synonym "Erythemato-squamous plaque",
        "Erythematosquamous plaque"@en,
        "Psoriatic-like lesion"@en .

<http://purl.obolibrary.org/obo/HP_0025528> rdfs:label "Annular cutaneous lesion"@en ;
    dcterms:description "A lesion of the skin with a ring-like distribution."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025615> rdfs:label "Abscess"@en ;
    dcterms:description "An abscess is a localized collection of purulent material surrounded by inflammation and granulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025616> rdfs:label "Sterile abscess"@en ;
    dcterms:description "An abscess not caused by infection with pyogenic bacteria. Operationally, a sterile abscess is inferred if investigations of an abscess fail to reveal evidence of pathogenic organisms."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030043> rdfs:label "Hip subluxation"@en ;
    dcterms:description "A partial dislocation of the hip joint, whereby the head of the femur is partially displaced from the socket."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial hip dislocation"@en,
        "Subluxation involving the hip joint"@en ;
    ns1:synonym "Partial hip dislocation"@en,
        "Subluxation involving the hip joint"@en ;
    ns1:xref "SNOMEDCT_US:263057000"@en,
        "UMLS:C0434785"@en .

<http://purl.obolibrary.org/obo/HP_0030047> rdfs:label "Abnormal lateral ventricle morphology"@en ;
    dcterms:description "A morphological anomaly of the lateral ventricle."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of lateral ventricle"@en ;
    ns1:synonym "Abnormality of lateral ventricle" ;
    ns1:xref "UMLS:C4022662"@en .

<http://purl.obolibrary.org/obo/HP_0030057> rdfs:label "Autoimmune antibody positivity"@en ;
    dcterms:description "The presence of an antibody in the blood circulation that is directed against the organism's own cells or tissues."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022660" .

<http://purl.obolibrary.org/obo/HP_0030084> rdfs:label "Clinodactyly"@en ;
    dcterms:description "An angulation of a digit at an interphalangeal joint in the plane of the palm (finger) or sole (toe)."@en ;
    ns1:broad_synonym "Curvature of digit"@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Permanent curving of the finger" ;
    ns1:synonym "Curvature of digit"@en,
        "Permanent curving of the finger"@en ;
    ns1:xref "SNOMEDCT_US:17268007"@en,
        "UMLS:C0265610"@en,
        "UMLS:C4280304"@en .

<http://purl.obolibrary.org/obo/HP_0030146> rdfs:label "Abnormal liver parenchyma morphology"@en ;
    dcterms:description "A structural anomaly of the liver located predominantly in the hepatocytes as opposed to stromal cells."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022605"@en .

<http://purl.obolibrary.org/obo/HP_0030149> rdfs:label "Cardiogenic shock"@en ;
    dcterms:description "Severely decreased cardiac output with evidence of inadequate end-organ perfusion (i.e., tissue hypoxia) in the presence of adequate intravascular volume."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cardiovascular shock"@en ;
    ns1:synonym "Cardiovascular shock"@en ;
    ns1:xref "SNOMEDCT_US:89138009"@en,
        "UMLS:C0036980"@en .

<http://purl.obolibrary.org/obo/HP_0030166> rdfs:label "Night sweats"@en ;
    dcterms:description "Occurrence of excessive sweating during sleep."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Night sweats"@en,
        "Nocturnal hyperhidrosis"@en ;
    ns1:synonym "Night sweats"@en,
        "Nocturnal hyperhidrosis"@en ;
    ns1:xref "SNOMEDCT_US:42984000"@en,
        "UMLS:C0028081"@en .

<http://purl.obolibrary.org/obo/HP_0030167> rdfs:label "Antimitochondrial antibody positivity"@en ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against mitochondria."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Serum antimitochrondrial antibodies" ;
    ns1:synonym "Serum antimitochrondrial antibodies"@en ;
    ns1:xref "UMLS:C4021051"@en .

<http://purl.obolibrary.org/obo/HP_0030319> rdfs:label "Weakness of facial musculature"@en ;
    dcterms:description "Reduced strength of one or more muscles innervated by the facial nerve (the seventh cranial nerve)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced facial muscle strength",
        "Weakness of face",
        "Decreased facial muscle strength"@en,
        "Decreased strength of facial muscles"@en,
        "Face weakness"@en,
        "Facial muscle weakness"@en,
        "Facial weakness"@en,
        "Myasthenia of facial muscles"@en,
        "Weakness of facial musculature"@en ;
    ns1:synonym "Decreased facial muscle strength"@en,
        "Decreased strength of facial muscles"@en,
        "Face weakness"@en,
        "Facial muscle weakness"@en,
        "Facial weakness"@en,
        "Myasthenia of facial muscles"@en,
        "Reduced facial muscle strength"@en,
        "Weakness of face"@en,
        "Weakness of facial musculature"@en ;
    ns1:xref "UMLS:C4022514"@en .

<http://purl.obolibrary.org/obo/HP_0030320> rdfs:label "Increased intervertebral space" ;
    dcterms:description "An increase in the vertical distance between adjacent vertebral bodies, observed as an increase in the intervertebral disk space."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022513"@en .

<http://purl.obolibrary.org/obo/HP_0030351> rdfs:label "Urticarial plaque"@en ;
    dcterms:description "A well-circumscribed, intensely pruritic, raised wheal (edema of the superficial skin) typically 1 to 2 cm in diameter."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072895"@en .

<http://purl.obolibrary.org/obo/HP_0030384> rdfs:label "Decreased proportion of marginal zone B cells"@en ;
    dcterms:description "A reduction in the normal proportion of marginal zone B cells (CD19+/CD27+/IgM+/IgD+) in circulation relative to the total number of B cells."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072922"@en .

<http://purl.obolibrary.org/obo/HP_0030666> rdfs:label "Retinal neovascularization"@en ;
    dcterms:description "In ischemic retinal disease, neovascularization (NV) involves the sprouting of new vessels from pre-existent vessels. Ischemia invariably leads to the upregulation of Vascular Endothelial Growth Factor (VEGF) production. Most frequently the new vessels grow internal to the plane of the retina. However, intraretinal proliferation of new vessels can also occur."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal vascular proliferation"@en ;
    ns1:synonym "Retinal vascular proliferation" ;
    ns1:xref "SNOMEDCT_US:61267008"@en,
        "UMLS:C0035320"@en .

<http://purl.obolibrary.org/obo/HP_0030793> rdfs:label "Jaw swelling"@en ;
    dcterms:description "Abnormal enlargement in the upper jaw (maxilla) or in the lower jaw (mandible)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280766"@en .

<http://purl.obolibrary.org/obo/HP_0030802> rdfs:label "Lower eyelid retraction" ;
    dcterms:description "Inferior malposition of the lower eyelid margin without eyelid eversion."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:700264006"@en,
        "UMLS:C1861656"@en .

<http://purl.obolibrary.org/obo/HP_0030872> rdfs:label "Abnormal cardiac ventricular function"@en ;
    dcterms:description "An abnormality of the cardiac ventricular function." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280733"@en .

<http://purl.obolibrary.org/obo/HP_0031185> rdfs:label "Elevated circulating NT-proBNP concentration"@en ;
    dcterms:description "The concentration of NT-proBNP (= N-terminal pro-B-type natriuretic peptide, = N-terminal prohormone of brain natriuretic peptide) in the blood circulation is above the upper limit of normal."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased NT-proBNP level"@en ;
    ns1:synonym "Increased NT-proBNP level"@en .

<http://purl.obolibrary.org/obo/HP_0031191> rdfs:label "Deep dermal perivascular inflammatory infiltrate"@en ;
    dcterms:description "Numerous lymphocytes surrounding blood vessels in the deep part of the dermis."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Deep perivascular inflammatory infiltrate"@en ;
    ns1:synonym "Deep perivascular inflammatory infiltrate"@en .

<http://purl.obolibrary.org/obo/HP_0031545> rdfs:label "Abnormally low T cell receptor excision circle level"@en ;
    dcterms:description "Reduced level of T cell receptor excision circle (TRECs) as measured by the TREC assay. Late in maturation, 70% of thymocytes that will ultimately express alpha/beta-T cell receptors form a circular DNA TREC from the excised TCRdelta gene that lies within the TCRalpha genetic locus. The circles are stable but do not increase following cell division and, therefore, become diluted as T cells proliferate. A quantitative polymerase chain reaction (PCR) reaction across the joint of the circular DNA provides the TREC copy number, a marker of newly-formed, antigenically-naïve thymic emigrant T cells."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031606> rdfs:label "Retinal cotton wool spot"@en ;
    dcterms:description "Fluffy white patch in the inner retina, representing localized areas of dense white swelling of the retinal nerve fiber layer."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031688> rdfs:label "Erythroid dysplasia"@en ;
    dcterms:description "Dysplasia in the erythroid lineage, which presents with a variety of morphological changes in the bone marrow, including nuclear budding or irregular nuclear contour in erythroblasts."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Dyserythropoiesis"@en ;
    ns1:synonym "Dyserythropoiesis" .

<http://purl.obolibrary.org/obo/HP_0031689> rdfs:label "Megakaryocyte dysplasia"@en ;
    dcterms:description "The presence of micro-megakaryocytes, hypo-lobed, or non-lobed nuclei in megakaryocytes of all sizes and multiple, widely-separated nuclei."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysmegakaryopoiesis"@en ;
    ns1:synonym "Dysmegakaryopoiesis"@en .

<http://purl.obolibrary.org/obo/HP_0031693> rdfs:label "Severe Epstein Barr virus infection"@en ;
    dcterms:description "An unusually severe Epstein Barr virus (EBV) infection."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fulminant infectious mononucleosis"@en,
        "Severe EBV infection"@en ;
    ns1:synonym "Fulminant infectious mononucleosis"@en,
        "Severe EBV infection"@en .

<http://purl.obolibrary.org/obo/HP_0031972> rdfs:label "Presyncope"@en ;
    dcterms:description "Presyncope is a state of lightheadedness, muscular weakness, blurred vision, and feeling faint. Presyncope is most often cardiovascular in cause."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031987> rdfs:label "Diminished ability to concentrate"@en ;
    dcterms:description "The inability to focus or concentrate on a specific task, activity, or object. The subject may find themselves unable to grasp or understand written text and re-reads frequently without understanding. Familiar tasks or activities are severely compromised due to the lack of ability to concentrate. Thinking through multi-step problems is typically very difficult or impossible, leading to avoidance of such activities."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Concentration problems"@en,
        "Labored thinking"@en,
        "Lack of concentration"@en,
        "Poor concentration"@en ;
    ns1:synonym "Concentration problems"@en,
        "Labored thinking"@en,
        "Lack of concentration"@en,
        "Poor concentration"@en .

<http://purl.obolibrary.org/obo/HP_0032024> rdfs:label "Ileal ulcer"@en ;
    dcterms:description "An erosion of the mucous membrane in a portion of the ileum."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032163> rdfs:label "Molluscum contagiosum"@en ;
    dcterms:description "Molluscum contagiosum is a cutaneous viral infection that is commonly observed in both healthy and immunocompromised children. The infection is caused by a member of the Poxviridae family, the molluscum contagiosum virus. Molluscum contagiosum presents as single or multiple small white or flesh-colored papules that typically have a central umbilication. The central umbilication may be difficult to observe in young children and, instead, may bear an appearance similar to an acneiform eruption. The lesions vary in size (from 1 mm to 1 cm in diameter) and are painless, although a subset of patients report pruritus in the area of infection. On average, 11-20 papules appear on the body during the course of infection and generally remains a self-limiting disease. However, in immunosuppressed patients, molluscum contagiosum can be a severe infection with hundreds of lesions developing on the body. Extensive eruption is indicative of an advanced immunodeficiency state."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032219> rdfs:label "Increased CD4+ T cell proportion"@en ;
    dcterms:description "Abnormal increase of helper CD3+CD4+ T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group. These are usually measured within the TCR alpha/beta positive population." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated helper T cell proportion"@en,
        "Elevated proportion of CD4-positive T cells"@en,
        "Increased helper T cell proportion"@en,
        "Increased proportion of CD4+ T cells"@en,
        "Increased proportion of CD4-positive T cells"@en,
        "Increased proportion of CD4-positive, alpha-beta T cells"@en ;
    ns1:synonym "Increased proportion of CD4-positive T cells",
        "Elevated helper T cell proportion"@en,
        "Elevated proportion of CD4-positive T cells"@en,
        "Increased helper T cell proportion"@en,
        "Increased proportion of CD4+ T cells"@en,
        "Increased proportion of CD4-positive, alpha-beta T cells"@en .

<http://purl.obolibrary.org/obo/HP_0032252> rdfs:label "Granuloma"@en ;
    dcterms:description "A compact, organized collection of mature mononuclear phagocytes, which may be but is not necessarily accompanied by accessory features such as necrosis."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032263> rdfs:label "Increased blood pressure"@en ;
    dcterms:description "Abnormal increase in blood pressure. An individual measurement of increased blood pressure does not necessarily imply hypertension. In practical terms, multiple measurements are recommended to diagnose the presence of hypertension." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased BP"@en ;
    ns1:synonym "Increased BP"@en .

<http://purl.obolibrary.org/obo/HP_0032323> rdfs:label "Periodic fever"@en ;
    dcterms:description "Episodic fever that recurs at regular intervals." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032436> rdfs:label "Abnormal circulating C-reactive protein concentration"@en ;
    dcterms:description "Any deviation from the normal concentration of C-reactive protein in the blood circulation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal C-reactive protein level"@en ;
    ns1:synonym "Abnormal C-reactive protein level"@en .

<http://purl.obolibrary.org/obo/HP_0032564> rdfs:label "Ileitis"@en ;
    dcterms:description "Inflammation of the ileum."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of the ileum"@en ;
    ns1:synonym "Inflammation of the ileum"@en .

<http://purl.obolibrary.org/obo/HP_0032948> rdfs:label "Renal interstitial fibrosis"@en ;
    dcterms:description "The accumulation of collagen and related extracellular matrix (ECM) molecules in the interstitium of the kidney. The interstitium is expanded by the presence of collagen that stain blue on trichrome. Tubules are not back to back, but rather separated by fibrosis and can be atrophic."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032979> rdfs:label "Hemosiderin-laden macrophages in bronchoalveolar fluid"@en ;
    dcterms:description "Hemosiderin-laden macrophages (HLM) in bronchoalveolar lavage (BAL) fluid were originally known as adiagnostic biomarker of alveolar hemorrhage, but have also been observed in idiopathic pulmonary fibrosis (IPF) with histopathological pattern of usual interstitial pneumonia (UIP)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Accumulation of hemosiderin laden alveolar macrophages"@en,
        "Siderophages in bronchoalveolar fluid"@en ;
    ns1:synonym "Accumulation of hemosiderin laden alveolar macrophages"@en,
        "Siderophages in bronchoalveolar fluid"@en .

<http://purl.obolibrary.org/obo/HP_0033040> rdfs:label "Anti-Sm antibody positivity"@en ;
    dcterms:description "The presence of autoantibodies in the serum that react to seven proteins that consist of a core of small nuclear ribonucleoprotein (snRNP) particles."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-Smith autoantibody" ;
    ns1:synonym "Anti-Smith autoantibody"@en .

<http://purl.obolibrary.org/obo/HP_0033041> rdfs:label "Cytokine storm"@en ;
    dcterms:description "Excessive or uncontrolled release of proinflammatory cytokines."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypercytokinemia"@en ;
    ns1:synonym "Hypercytokinemia"@en .

<http://purl.obolibrary.org/obo/HP_0033106> rdfs:label "Elevated circulating D-dimer concentration"@en ;
    dcterms:description "An increased concentration of D-dimers, a marker of fibrin degradation, in the blood circulation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated D-dimers"@en,
        "Elevated fibrin degradation fragment concentration"@en ;
    ns1:synonym "Elevated D-dimers"@en,
        "Elevated fibrin degradation fragment concentration"@en .

<http://purl.obolibrary.org/obo/HP_0033117> rdfs:label "Duodenitis"@en ;
    dcterms:description "Inflammation of the lining of the upper small intestine (duodenum)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Duodenal inflammation"@en ;
    ns1:synonym "Duodenal inflammation"@en .

<http://purl.obolibrary.org/obo/HP_0033176> rdfs:label "Submandibular lymph node enlargement"@en ;
    dcterms:description "Increased size of the lymph nodes that are located beneath the mandible (lower jaw)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Submandibular lymphadenopathy" ;
    ns1:synonym "Submandibular lymphadenopathy"@en .

<http://purl.obolibrary.org/obo/HP_0033188> rdfs:label "Cystic acne"@en ;
    dcterms:description "A severe type of acne characterized by the formation of cysts enclosing a mixture of keratin and sebum." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033194> rdfs:label "Perioral erythema"@en ;
    dcterms:description "Erythema (Redness of the skin caused by hyperemia of the capillaries in the lower layers of the skin) localized to the region surrounding the mouth."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033195> rdfs:label "Perianal erythema"@en ;
    dcterms:description "Erythema (Redness of the skin caused by hyperemia of the capillaries in the lower layers of the skin) localized to the region surrounding the anus." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033199> rdfs:label "Increased circulating interleukin 10 concentration"@en ;
    dcterms:description "An elevation of the concentration of interleukin 10 in the blood circulation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum interleukin 10"@en ;
    ns1:synonym "Increased serum interleukin 10"@en .

<http://purl.obolibrary.org/obo/HP_0033221> rdfs:label "Increased CD4:CD8 ratio"@en ;
    dcterms:description "An abnormal elevation of the relative proportion of CD4+ to CD8+ T cells." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033250> rdfs:label "Nailfold capillary tortuosity"@en ;
    dcterms:description "An increased number of turns of the blood vessels of the nailfold with a charactereistic winded or twisted appearance of the blood vessels."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033253> rdfs:label "Reduced circulating interferon gamma concentration"@en ;
    dcterms:description "A reduction in the concentration of interferon gamma measured in the blood circulation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced circulating interferon gamma"@en ;
    ns1:synonym "Reduced circulating interferon gamma" .

<http://purl.obolibrary.org/obo/HP_0033260> rdfs:label "Livedo racemosa"@en ;
    dcterms:description "Livedo racemosa describes a reddish-blue mottling of the skin in an irregular, reticular pattern. It differs from the more common livedo reticularis by its shape. Livedo racemosa consists of broken circular segments resulting in a seemingly larger pattern, as opposed to the fine, regular, complete network of livedo reticularis. Livedo racemosa results from permanent impairment of peripheral blood flow and, unlike livedo reticularis, it persists on warming."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033261> rdfs:label "Renal artery aneurysm"@en ;
    dcterms:description "Increase in diameter of a segment of the renal artery that can be defined as a focal, isolated dilatation of all three layers of the arterial wall over 1.5 times the diameter of the disease-free proximal adjacent arterial segment."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033280> rdfs:label "Paratracheal lymphadenopathy"@en ;
    dcterms:description "Enlargement of lymph nodes surrounding the trachea."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033308> rdfs:label "Patellar overgrowth"@en ;
    dcterms:description "Excessive growth of the kneecap (patella)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033332> rdfs:label "Elevated circulating amyloid A concentration"@en ;
    dcterms:description "The concentration of serum amyloid A in the blood circulation is above the upper limit of normal."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating amyloid A"@en ;
    ns1:synonym "Elevated circulating amyloid A" .

<http://purl.obolibrary.org/obo/HP_0033380> rdfs:label "Nasal chondritis"@en ;
    dcterms:description "Inflammation of the cartilage of the nose." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nose chondritis"@en ;
    ns1:synonym "Nose chondritis"@en .

<http://purl.obolibrary.org/obo/HP_0033425> rdfs:label "Periungual erythema"@en ;
    dcterms:description "Erythema (redness of the skin caused by hyperemia in superficial capillaries) in the region surrounding a fingernail or toe nail."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033434> rdfs:label "Nasal septum perforation"@en ;
    dcterms:description "A full-thickness defect of the nasal septum."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nasal-septum perforation"@en,
        "Perforation of the nasal septum"@en ;
    ns1:synonym "Nasal-septum perforation"@en,
        "Perforation of the nasal septum"@en .

<http://purl.obolibrary.org/obo/HP_0033438> rdfs:label "Elevated circulating myoglobin concentration"@en ;
    dcterms:description "An increased blood concentration of myoglobin."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033559> rdfs:label "Anti-myeloperoxidase antibody positivity"@en ;
    dcterms:description "The presence of autoantibodies in the blood circulation that react against myeloperoxidase." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-MPO antibody positivity"@en,
        "Anti-myeloperoxidase specific antineutrophil cytoplasmic antibody"@en,
        "MPO-ANCA"@en ;
    ns1:synonym "MPO-ANCA",
        "Anti-MPO antibody positivity"@en,
        "Anti-myeloperoxidase specific antineutrophil cytoplasmic antibody"@en .

<http://purl.obolibrary.org/obo/HP_0033605> rdfs:label "Pustular rash"@en ;
    dcterms:description "A rash composed of pustular lesions. A pustule is defined as a vesicle or bulla containing purulent material. It varies in size and may occur at different levels within the epidermis: subcorneal, intraepidermal, or basement membrane zones. The pustules may or may not be sterile and are normally filled with neutrophils."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Pustulosis"@en ;
    ns1:synonym "Pustulosis"@en .

<http://purl.obolibrary.org/obo/HP_0033631> rdfs:label "Spondylitis" ;
    dcterms:description "Inflammation of the vertebrae (vertebral bodies) or spine."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033748> rdfs:label "Hypoesthesia" ;
    dcterms:description "Decreased ability to perceive touch."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoaesthesia",
        "Numbness"@en ;
    ns1:synonym "Hypoaesthesia"@en,
        "Numbness"@en .

<http://purl.obolibrary.org/obo/HP_0033833> rdfs:label "Elevated circulating sCD25 concentration"@en ;
    dcterms:description "The concentration of sCD25 (= soluble CD25, = soluble interleukin-2 receptor alpha-chain, = soluble IL-2 receptor alpha) in the blood circulation is above the upper limit of normal."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating interleukin-2 receptor alpha-chain"@en ;
