    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Indurated skin"@en,
        "Skin induration"@en,
        "Stiff skin"@en ;
    ns1:synonym "Indurated skin"@en,
        "Skin induration"@en,
        "Stiff skin"@en ;
    ns1:xref "UMLS:C3276815"@en .

<http://purl.obolibrary.org/obo/HP_0030056> rdfs:label "Uncombable hair"@en ;
    dcterms:description "Hair that is disorderly, stands out from the scalp, and cannot be combed flat."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Uncombable hair"@en ;
    ns1:synonym "Uncombable hair"@en ;
    ns1:xref "UMLS:C1860607"@en .

<http://purl.obolibrary.org/obo/HP_0030151> rdfs:label "Cholangitis"@en ;
    dcterms:description "Inflammation of the biliary ductal system, affecting the intrahepatic or extrahepatic portions, or both."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bile duct inflammation"@en ;
    ns1:synonym "Bile duct inflammation"@en ;
    ns1:xref "SNOMEDCT_US:82403002"@en,
        "UMLS:C0008311"@en .

<http://purl.obolibrary.org/obo/HP_0030374> rdfs:label "Decreased proportion of memory B cells"@en ;
    dcterms:description "A reduction in the normal proportion of memory B cells (CD19+/CD27+) in circulation relative to the total number of B cells. Memory B cells develop from naive B cells. Upon antigen rechallenge, memory B cells rapidly expand and differentiate into plasma cells under the cognate control of memory Th cells (Phase IV)."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072913"@en .

<http://purl.obolibrary.org/obo/HP_0030388> rdfs:label "Decreased class-switched memory B cell proportion"@en ;
    dcterms:description "A reduction in the normal proportion of class-switched memory B cells (CD19+/CD27+/IgM+/IgD+) relative to the total number of B cells. Marginal zone B cells undergo limited somatic hypermutation and produce high-affinity IgM and some IgG, whereas class-switched memory B cells synthetize IgG, IgM, and IgA."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased proportion of class-switched memory B cells",
        "Decreased proportion of CD19+CD27+IgD- cells"@en ;
    ns1:synonym "Decreased proportion of CD19+CD27+IgD- cells"@en,
        "Decreased proportion of class-switched memory B cells"@en ;
    ns1:xref "UMLS:C4072925"@en .

<http://purl.obolibrary.org/obo/HP_0030953> rdfs:label "Conjunctival hyperemia"@en ;
    dcterms:description "Dilatation of the blood vessels of the conjunctiva leading to a red appearance of the sclera."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Conjunctival hyperaemia"@en,
        "Conjunctival injection"@en,
        "Conjunctival vascular congestion"@en ;
    ns1:synonym "Conjunctival hyperaemia"@en,
        "Conjunctival injection"@en,
        "Conjunctival vascular congestion"@en .

<http://purl.obolibrary.org/obo/HP_0031123> rdfs:label "Recurrent gastroenteritis"@en ;
    dcterms:description "Increased susceptibility to gastroenteritis, an infectious inflammationof the stomach and small intestines manifested by signs and symptoms such as diarheas and abdominal pain, as manifested by recurrent episodes of gastroenteritis."@en ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031956> rdfs:label "Elevated circulating aspartate aminotransferase concentration"@en ;
    dcterms:description "The concentration of aspartate aminotransferase (AST) in the blood circulation is above the upper limit of normal."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aspartate aminotransferase increased"@en,
        "Elevated serum AST"@en,
        "Elevated serum aspartate aminotransferase"@en,
        "Elevated serum glutamic oxaloacetic transaminase"@en ;
