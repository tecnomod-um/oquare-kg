    ns1:synonym "Anti-double-stranded DNA antibody positivity"@en .

<http://purl.obolibrary.org/obo/HP_0025116> rdfs:label "Fetal distress"@en ;
    dcterms:description "An intrauterine state characterized by suboptimal values in the fetal heart rate, oxygenation of fetal blood, or other parameters indicative of compromise of the fetus. Signs of fetal distress include repetitive variable decelerations, fetal tachycardia or bradycardia, late decelerations, or low biophysical profile."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Foetal distress"@en ;
    ns1:synonym "Foetal distress"@en .

<http://purl.obolibrary.org/obo/HP_0025131> rdfs:label "Finger swelling"@en ;
    dcterms:description "Enlargement of the soft tissues of one or more fingers."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Swelling of fingers"@en,
        "Swollen finger"@en,
        "Swollen fingers"@en ;
    ns1:synonym "Swelling of fingers"@en,
        "Swollen finger"@en,
        "Swollen fingers"@en .

<http://purl.obolibrary.org/obo/HP_0025143> rdfs:label "Chills"@en ;
    dcterms:description "A sudden sensation of feeling cold." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chills"@en ;
    ns1:synonym "Chills"@en .

<http://purl.obolibrary.org/obo/HP_0025289> rdfs:label "Cervical lymphadenopathy"@en ;
    dcterms:description "Enlarged lymph nodes in the neck."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Swollen lymph nodes in the neck"@en ;
    ns1:synonym "Swollen lymph nodes in the neck"@en .

<http://purl.obolibrary.org/obo/HP_0025406> rdfs:label "Asthenia"@en ;
    dcterms:description "A state characterized by a feeling of weakness and loss of strength leading to a generalized weakness of the body."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lack of energy and strength"@en,
        "Weakness"@en ;
    ns1:related_synonym "Prostration"@en ;
    ns1:synonym "Weakness",
        "Lack of energy and strength"@en,
        "Prostration"@en .

<http://purl.obolibrary.org/obo/HP_0025435> rdfs:label "Increased circulating lactate dehydrogenase concentration" ;
