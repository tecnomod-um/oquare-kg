<http://purl.obolibrary.org/obo/HP_0034156> rdfs:label "Anti-beta-2-Glycoprotein I IgG antibody positivity"@en ;
    dcterms:description "Presence of IgG antibodies against beta 2 glycoprotein I in the circulation. Beta-2 glycoprotein I (beta2GPI) is the principal target of autoantibodies in the antiphospholipid syndrome."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-beta2GPI IgG antibody positivity"@en ;
    ns1:synonym "Anti-beta2GPI IgG antibody positivity"@en .

<http://purl.obolibrary.org/obo/HP_0034447> rdfs:label "Increased circulating interleukin 18 concentration"@en ;
    dcterms:description "An increased concentration of interleukin-18 in the blood circulation."@en ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "IL-18 high in blood"@en ;
