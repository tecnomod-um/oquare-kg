        <http://purl.obolibrary.org/obo/HP_0031417>,
        <http://purl.obolibrary.org/obo/HP_0033850> ;
    ns1:related_synonym "sudden onset of unilateral flushing and sweating",
        "unilateral loss of facial flushing and sweating with contralateral anhidrosis" ;
    ns1:synonym "progressive isolated segmental anhidrosis",
