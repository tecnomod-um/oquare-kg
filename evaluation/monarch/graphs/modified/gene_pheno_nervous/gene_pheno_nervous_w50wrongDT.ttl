<http://purl.obolibrary.org/obo/HP_0011748> rdfs:label "Adrenocorticotropic hormone deficiency" ;
    dcterms:description "A reduced ability to secrete adrenocorticotropic hormone (ACTH), a hormone that stimulates the adrenal cortex to secrete of glucocorticoids such as cortisol."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "ACTH deficiency"^^<http://example.org/invalidDatatype>,
        "Corticotropin deficiency"^^<http://example.org/invalidDatatype> ;
