<http://purl.obolibrary.org/obo/HP_0002613> rdfs:label "Biliary cirrhosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Progressive destruction of the small-to-medium bile ducts of the intrahepatic biliary tree, which leads to progressive cholestasis and often end-stage liver disease." ;
    ns1:category ns1:PhenotypicFeature ;
