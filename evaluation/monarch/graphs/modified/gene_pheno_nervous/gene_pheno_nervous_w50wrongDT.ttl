    ns1:exact_synonym "Demyelination in central white matter" ;
    ns1:synonym "Demyelination in central white matter" ;
    ns1:xref "UMLS:C0338474" .

<http://purl.obolibrary.org/obo/HP_0007787> rdfs:label "Posterior subcapsular cataract" ;
    dcterms:description "A type of cataract affecting the posterior pole of lens immediately adjacent to ('beneath') the Lens capsule." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Posterior subcapsular opacities of the lens"^^<http://example.org/invalidDatatype> ;
