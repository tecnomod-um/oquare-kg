    ns1:xref "UMLS:C1867873" .

<http://purl.obolibrary.org/obo/HP_0001680> rdfs:label "Coarctation of aorta"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Coarctation of the aorta is a narrowing or constriction of a segment of the aorta." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Coarctation of the aorta"^^<http://example.org/invalidDatatype>,
