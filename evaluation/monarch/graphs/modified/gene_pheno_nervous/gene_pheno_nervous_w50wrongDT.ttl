        "Small thumbs",
        "Thumb hypoplasia" ;
    ns1:xref "SNOMEDCT_US:253936008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0431890" .

<http://purl.obolibrary.org/obo/HP_0009926> rdfs:label "Epiphora" ;
    dcterms:description "Abnormally increased lacrimation, that is, excessive tearing (watering eye)." ;
    ns1:category ns1:PhenotypicFeature ;
