<http://purl.obolibrary.org/obo/MONDO_0009699> rdfs:label "action myoclonus-renal failure syndrome" ;
    dcterms:description "Action myoclonus-renal failure syndrome (AMRF) is a rare epilepsy syndrome characterized by progressive myoclonus epilepsy in association with primary glomerular disease. Patients present with neurologic symptoms (including tremor, action myoclonus, tonic-clonic seizures, later ataxia and dysarthria) that may precede, occur simultaneously or be followed by renal manifestations including proteinuria that progresses to nephrotic syndrome and end-stage renal disease. In some patients, sensorimotor peripheral neuropathy, sensorineural hearing loss and dilated cardiomyopathy are associated symptoms."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "AMRF"^^<http://example.org/invalidDatatype>,
        "action myoclonus-renal failure syndrome"^^<http://example.org/invalidDatatype>,
        "epilepsy, progressive myoclonic 4, with or without renal failure"^^<http://example.org/invalidDatatype>,
        "myoclonus-nephropathy syndrome"^^<http://example.org/invalidDatatype>,
        "EPM4",
        "epilepsy, progressive myoclonic, 4, with or without renal failure",
        "progressive myoclonic epilepsy type 4" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0000083>,
        <http://purl.obolibrary.org/obo/HP_0000093>,
