        "Prominent nose"^^<http://example.org/invalidDatatype>,
        "Big nose",
        "Large nose",
        "Pronounced nose" ;
    ns1:related_synonym "Hyperplasia of nose"^^<http://example.org/invalidDatatype>,
        "Hypertrophy of nose",
        "Nasal hyperplasia",
        "Nasal hypertrophy" ;
    ns1:synonym "Big nose"^^<http://example.org/invalidDatatype>,
        "Hyperplasia of nose"^^<http://example.org/invalidDatatype>,
        "Hypertrophy of nose"^^<http://example.org/invalidDatatype>,
        "Increased nasal size"^^<http://example.org/invalidDatatype>,
        "Increased size of nose"^^<http://example.org/invalidDatatype>,
        "Nasal hypertrophy"^^<http://example.org/invalidDatatype>,
        "Pronounced nose"^^<http://example.org/invalidDatatype>,
        "Disproportionately large nose",
        "Large nose",
        "Nasal hyperplasia",
