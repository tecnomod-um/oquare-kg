<http://purl.obolibrary.org/obo/HP_0007803> rdfs:label "Monochromacy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Complete color blindness, a complete inability to distinguish colors. Affected persons cannot perceive colors, but only shades of gray." ;
