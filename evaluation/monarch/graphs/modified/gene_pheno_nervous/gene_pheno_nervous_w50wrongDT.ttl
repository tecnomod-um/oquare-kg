<http://purl.obolibrary.org/obo/HP_0100258> rdfs:label "Preaxial polydactyly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of polydactyly in which the extra digit or digits are localized on the side of the thumb or great toe." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Polydactyly, preaxial"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Polydactyly, preaxial" ;
