    dcterms:description "An increased number of twists and turns of the retinal blood vessels. This can affect either arteries, veins or both."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tortuous retinal vessels"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tortuous retinal vessels" ;
    ns1:xref "UMLS:C1860475"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025097> rdfs:label "Eyelid myoclonus" ;
    dcterms:description "Marked, involuntary jerking of the eyelids." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blepharoclonus" ;
    ns1:related_synonym "Eyelid myoclonia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Blepharoclonus",
        "Eyelid myoclonia" .

<http://purl.obolibrary.org/obo/HP_0025101> rdfs:label "Dysgenesis of the hippocampus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Structural abnormality of the hippocampus related to defective development."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hippocampal dysgenesis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hippocampal dysgenesis" .

<http://purl.obolibrary.org/obo/HP_0030043> rdfs:label "Hip subluxation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A partial dislocation of the hip joint, whereby the head of the femur is partially displaced from the socket."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Subluxation involving the hip joint"^^<http://example.org/invalidDatatype>,
        "Partial hip dislocation" ;
    ns1:synonym "Partial hip dislocation",
        "Subluxation involving the hip joint" ;
    ns1:xref "SNOMEDCT_US:263057000",
        "UMLS:C0434785" .

<http://purl.obolibrary.org/obo/HP_0030052> rdfs:label "Inguinal freckling"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence in the inguinal region (groin) of an increased number of freckles, small circular spots on the skin that are darker than the surrounding skin because of deposits of melanin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Freckles in groin region"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Freckles in groin region"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1834297"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030057> rdfs:label "Autoimmune antibody positivity" ;
    dcterms:description "The presence of an antibody in the blood circulation that is directed against the organism's own cells or tissues."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022660" .

<http://purl.obolibrary.org/obo/HP_0030099> rdfs:label "Reduced muscle fiber alpha dystroglycan"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Immunohistochemistry reveals reduced alpha dystroglycan protein in the muscle biopsy. Alpha-dystroglycan is a heavily glycosylated peripheral-membrane component of the dystrophin-associated glycoprotein complex (DAPC), which, in addition to laminin alpha2, binds perlecan and agrin in the extracellular matrix, whereas beta-dystroglycan, derived from the same gene, is a transmembrane protein that links to dystrophin intracellularly." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced muscle fibre alpha dystroglycan" ;
    ns1:synonym "Reduced muscle fibre alpha dystroglycan"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022646" .

<http://purl.obolibrary.org/obo/HP_0030192> rdfs:label "Fatigable weakness of bulbar muscles"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of weakness of the bulbar muscles (muscles of the mouth and throat responsible for speech and swallowing) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022591" .

<http://purl.obolibrary.org/obo/HP_0030197> rdfs:label "Fatigable weakness of skeletal muscles" ;
    dcterms:description "A type of weakness of skeletal muscle that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022586"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030216> rdfs:label "Inertia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduction of goal-directed behaviors linked to the impairment in frontal executive functions (planning of an action for example)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022575" .

<http://purl.obolibrary.org/obo/HP_0030339> rdfs:label "Decreased circulating gonadotropin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction of the circulating level of a gonadotropin, that is, of a protein hormone secreted by gonadotrope cells of the anterior pituitary of vertebrates. The primary gonadotropins are luteinizing hormone (LH) and follicle-stimulating hormone (FSH)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased circulating gonadotropin level" ;
    ns1:synonym "Decreased circulating gonadotropin level" ;
    ns1:xref "UMLS:C4072887" .

<http://purl.obolibrary.org/obo/HP_0030341> rdfs:label "Decreased circulating follicle stimulating hormone concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction of the circulating level of follicle-stimulating hormone (FSH)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased circulating follicle stimulating hormone level" ;
    ns1:synonym "Decreased circulating follicle stimulating hormone level"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072889"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030344> rdfs:label "Decreased circulating luteinizing hormone level" ;
    dcterms:description "A reduction in the circulating level of luteinizing hormone (LH)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased circulating luteinising hormone level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased circulating luteinising hormone level" ;
    ns1:xref "UMLS:C4072890"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030784> rdfs:label "Anomic aphasia" ;
    dcterms:description "An inability to name people and objects that are correctly perceived. The individual is able to describe the object in question, but cannot provide the name." ;
    ns1:category ns1:PhenotypicFeature ;
