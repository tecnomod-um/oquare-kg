<http://purl.obolibrary.org/obo/HP_0004398> rdfs:label "Peptic ulcer" ;
    dcterms:description "The term peptic ulcer refers to acid peptic injury of the digestive tract, resulting in mucosal break reaching the submucosa. Peptic ulcers are usually located in the stomach or proximal duodenum, but they can also be found in the esophagus or Meckel's diverticulum. Infection with Helicobacter pylori and the use of non steroidal antiinflammatory drugs (NSAIDs) or aspirin are the main risk factors of both gastric and duodenal peptic ulcers."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Sore in the lining of gastrointestinal tract" ;
    ns1:synonym "Sore in the lining of gastrointestinal tract"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0030920"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:13200003" .

