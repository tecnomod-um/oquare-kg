        "Hypoplasia of depressor angula oris muscle",
        "Partial unilateral facial paresis" ;
    ns1:xref "SNOMEDCT_US:51409009",
        "UMLS:C0431406",
        "UMLS:C4280327" .

<http://purl.obolibrary.org/obo/HP_0011355> rdfs:label "Localized skin lesion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A lesion of the skin that is located in a specific region rather than being generalized."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Localised skin lesion",
        "Localized skin lesion" ;
