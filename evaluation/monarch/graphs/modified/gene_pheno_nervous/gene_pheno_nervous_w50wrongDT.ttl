<http://purl.obolibrary.org/obo/HP_0003201> rdfs:label "Rhabdomyolysis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Breakdown of muscle fibers that leads to the release of muscle fiber contents (myoglobin) into the bloodstream."^^<http://example.org/invalidDatatype> ;
