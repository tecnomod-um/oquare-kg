    ns1:synonym "PAPVC"^^<http://example.org/invalidDatatype>,
        "PAPVD",
        "PAPVR",
        "Partial anomalous pulmonary venous connection",
        "Partial anomalous pulmonary venous drainage" ;
    ns1:xref "Fyler:2030"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:68237008",
        "UMLS:C0158634" .

<http://purl.obolibrary.org/obo/HP_0010784> rdfs:label "Uterine neoplasm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A tumor (abnormal growth of tissue) of the uterus." ;
    ns1:broad_synonym "Uterine cancer"^^<http://example.org/invalidDatatype> ;
