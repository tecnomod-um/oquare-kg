<http://purl.obolibrary.org/obo/HP_0008202> rdfs:label "Reduced circulating prolactin concentration" ;
    dcterms:description "A reduced level of prolactin in the blood circulation. Prolactin is a protein hormone that is secreted by lactotrophs in the anterior pituitary and that stimulates mammary gland development and milk production."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Prolactin deficiency"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Prolactin deficiency" ;
    ns1:xref "SNOMEDCT_US:67873006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0271586"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0008443> rdfs:label "Neuropathic spinal arthropathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A progressive disorder of vertebral joint degeneration that occurs in the setting of any condition characterized by decreased afferent innervation, involving loss of deep pain and proprioceptive sensation in the vertebral column. Patients most commonly present with symptoms of lower back pain, sitting imbalance, progressive spinal deformity (usually kyphosis), and an audible clicking sound on changing postures." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spinal neuroarthropathy"^^<http://example.org/invalidDatatype>,
        "Charcot spinal arthropathy",
        "Spinal deformities" ;
    ns1:synonym "Charcot spinal arthropathy"^^<http://example.org/invalidDatatype>,
        "Spinal deformities",
        "Spinal neuroarthropathy" ;
    ns1:xref "SNOMEDCT_US:298380006",
        "UMLS:C0575157" .

<http://purl.obolibrary.org/obo/HP_0008629> rdfs:label "Pulsatile tinnitus" ;
    dcterms:description "Pulsatile tinnitus is generally classified a kind of objective tinnitus, meaning that it is not only audible to the patient but also to the examiner on auscultation of the auditory canal and/or of surrounding structures with use of an auscultation tube or stethoscope. Usually, pulsatile tinnitus is heard as a lower pitched thumping or booming, a rougher blowing sound which is coincidental with respiration, or as a clicking, higher pitched rhythmic sensation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:232322006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0751559" .

<http://purl.obolibrary.org/obo/HP_0008678> rdfs:label "Renal hypoplasia/aplasia" ;
