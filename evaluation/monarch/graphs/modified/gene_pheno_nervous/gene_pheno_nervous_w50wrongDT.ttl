        "UMLS:C0009676" .

<http://purl.obolibrary.org/obo/HP_0001655> rdfs:label "Patent foramen ovale" ;
    dcterms:description "Failure of the foramen ovale to seal postnatally, leaving a potential conduit between the left and right cardiac atria." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "PFO"^^<http://example.org/invalidDatatype>,
        "Persistent foramen ovale"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Persistent foramen ovale"^^<http://example.org/invalidDatatype>,
        "PFO" ;
    ns1:xref "ICD-10:Q21.1"^^<http://example.org/invalidDatatype>,
        "UMLS:C0016522"^^<http://example.org/invalidDatatype>,
        "Fyler:2020",
        "SNOMEDCT_US:204317008" .

<http://purl.obolibrary.org/obo/HP_0001771> rdfs:label "Achilles tendon contracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A contracture of the Achilles tendon." ;
    ns1:category ns1:PhenotypicFeature ;
