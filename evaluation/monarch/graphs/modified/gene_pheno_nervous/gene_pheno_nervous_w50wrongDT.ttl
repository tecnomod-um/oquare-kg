    dcterms:description "A herniation of meninges through a congenital bone defect in the skull in the occipital region."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:445468002",
