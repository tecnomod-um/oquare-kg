<http://purl.obolibrary.org/obo/HP_0031959> rdfs:label "Leg dystonia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of dystonia (abnormally increased muscular tone causing fixed abnormal postures) that affects muscles of the legs." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031987> rdfs:label "Diminished ability to concentrate" ;
    dcterms:description "The inability to focus or concentrate on a specific task, activity, or object. The subject may find themselves unable to grasp or understand written text and re-reads frequently without understanding. Familiar tasks or activities are severely compromised due to the lack of ability to concentrate. Thinking through multi-step problems is typically very difficult or impossible, leading to avoidance of such activities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Concentration problems"^^<http://example.org/invalidDatatype>,
        "Lack of concentration"^^<http://example.org/invalidDatatype>,
        "Labored thinking",
        "Poor concentration" ;
    ns1:synonym "Poor concentration"^^<http://example.org/invalidDatatype>,
        "Concentration problems",
        "Labored thinking",
        "Lack of concentration" .

<http://purl.obolibrary.org/obo/HP_0033128> rdfs:label "Delayed ability to crawl" ;
    dcterms:description "A failure to achieve the ability to crawl at an appropriate developmental stage. Normal infant motor development is marked by a series of postural milestones including learning to crawl on hands and knees between the ages of 6 and 10 months." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033258> rdfs:label "Sudden unexpected death in epilepsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Sudden unexpected death in epilepsy (SUDEP) is a sudden, unexpected, witnessed or unwitnessed, non-traumatic and non-drowning death, occurring in benign circumstances, in an individual with epilepsy, with or without evidence for a seizure and excluding documented status epilepticus, in which postmortem examination has not revealed a cause of death."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "SUDEP"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "SUDEP"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034671> rdfs:label "Knee contracture" ;
    dcterms:description "Lack of full passive range of motion (restrictions in flexion, extension, or other movements) of the knee joint resulting from structural changes of non-bony tissues, such as muscles, tendons, ligaments, joint capsules and/or skin." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Contracture of knee"^^<http://example.org/invalidDatatype>,
        "Knee contractures"^^<http://example.org/invalidDatatype>,
        "Contracture of the knees" ;
    ns1:synonym "Contracture of knee"^^<http://example.org/invalidDatatype>,
        "Knee contractures"^^<http://example.org/invalidDatatype>,
        "Contracture of the knees" .

<http://purl.obolibrary.org/obo/HP_0034677> rdfs:label "Ankle contracture"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040075> rdfs:label "Hypopituitarism" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:74728003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0020635"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040196> rdfs:label "Mild microcephaly" ;
    dcterms:description "Decreased occipito-frontal (head) circumference (OFC). For the microcephaly OFC must be between -3 SD and -2 SD compared to appropriate, age matched, normal standards (i.e. -3 SD <= OFC < -2 SD)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1836806"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100321> rdfs:label "Abnormal dentate nucleus morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the dentate nucleus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the dentate nucleus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of the dentate nucleus"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022148"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100595> rdfs:label "Camptocormia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal forward-flexed posture e.g. forward flexion of the spine, which is noticeable when standing or walking but disappears when lying down. It is becoming an increasingly recognized feature of Parkinson's disease and dystonic disorders." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:13534001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0264162"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100659> rdfs:label "Abnormal cerebral vascular morphology" ;
    dcterms:description "An anomaly of the cerebral blood vessels." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the cerebral blood vessels"^^<http://example.org/invalidDatatype>,
        "Abnormality of the cerebral vasculature" ;
