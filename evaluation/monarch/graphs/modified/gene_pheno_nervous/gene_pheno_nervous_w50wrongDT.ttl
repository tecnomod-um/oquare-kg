<http://purl.obolibrary.org/obo/HP_0000510> rdfs:label "Rod-cone dystrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An inherited retinal disease subtype in which the rod photoreceptors appear to be more severely affected than the cone photoreceptors. Typical presentation is with nyctalopia (due to rod dysfunction) followed by loss of mid-peripheral field of vision, which gradually extends and leaves many patients with a small central island of vision due to the preservation of macular cones."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinitis pigmentosa"^^<http://example.org/invalidDatatype>,
        "Rod cone dystrophy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Rod cone dystrophy"^^<http://example.org/invalidDatatype>,
        "Retinitis pigmentosa" ;
    ns1:xref "SNOMEDCT_US:28835009",
        "UMLS:C0035334" .

