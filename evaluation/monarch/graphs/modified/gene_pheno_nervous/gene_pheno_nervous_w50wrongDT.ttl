        "UMLS:C3279571"^^<http://example.org/invalidDatatype>,
        "UMLS:C4053775"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011760> rdfs:label "Pituitary growth hormone cell adenoma"^^<http://example.org/invalidDatatype> ;
