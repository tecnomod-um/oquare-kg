<http://purl.obolibrary.org/obo/HP_0010729> rdfs:label "Cherry red spot of the macula" ;
    dcterms:description "Pallor of the perifoveal macula of the retina with appearance of a small circular reddish choroid shape as seen through the fovea centralis due to relative transparency of the macula."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular cherry red spot"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Macular cherry red spot" ;
    ns1:xref "UMLS:C2216370" .

<http://purl.obolibrary.org/obo/HP_0010807> rdfs:label "Open bite" ;
    dcterms:description "Visible space between the dental arches in occlusion."^^<http://example.org/invalidDatatype> ;
