<http://purl.obolibrary.org/obo/HP_0008544> rdfs:label "Abnormally folded helix" ;
    dcterms:description "Any structural anomaly of the border of the helix, which usually forms a rolled rim but is highly variable in shape."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1970777" .

<http://purl.obolibrary.org/obo/HP_0008573> rdfs:label "Low-frequency sensorineural hearing impairment"^^<http://example.org/invalidDatatype> ;
