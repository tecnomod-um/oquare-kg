<http://purl.obolibrary.org/obo/HP_0002179> rdfs:label "Opisthotonus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Opisthotonus is defined as a dramatic abnormal posture due to spastic contraction of the extensor muscles of the neck, trunk, and lower extremities that produces a severe backward arching from neck to heel. In most cases, the trunk is elevated off the ground by a few inches. It is usually sudden in onset and can be sustained or repetitive. It can be considered a variant of decerebrate posturing involving a hyperextension of the neck, back, and limbs." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Arc de cercle",
        "Opisthotonos" ;
    ns1:synonym "Arc de cercle"^^<http://example.org/invalidDatatype>,
        "Opisthotonos"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:8652009",
        "UMLS:C0151818" .

<http://purl.obolibrary.org/obo/HP_0002705> rdfs:label "High, narrow palate" ;
    dcterms:description "The presence of a high and narrow palate."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High, narrow palate"^^<http://example.org/invalidDatatype>,
        "Narrow and high arched palate"^^<http://example.org/invalidDatatype>,
