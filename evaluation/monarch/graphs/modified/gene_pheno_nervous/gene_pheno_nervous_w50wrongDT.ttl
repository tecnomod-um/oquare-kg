<http://purl.obolibrary.org/obo/MONDO_0005663> rdfs:label "Barre-Lieou syndrome" ;
    dcterms:description "A neurologic syndrome following injury of the spinal sympathetic nerves of the neck. The injury usually results from arthritis or pinching by the adjacent vertebrae. Symptoms include facial pain, chronic allergies, dizziness, neck pain, ear pain and vertigo."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Cervicocranial syndrome"^^<http://example.org/invalidDatatype>,
