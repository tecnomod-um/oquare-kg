<http://purl.obolibrary.org/obo/HP_0010812> rdfs:label "Short uvula"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased length of the uvula." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplastic uvula"^^<http://example.org/invalidDatatype>,
