<http://purl.obolibrary.org/obo/HP_0012469> rdfs:label "Infantile spasms" ;
    dcterms:description "Infantile spasms represent a subset of \"epileptic spasms\". Infantile Spasms are epileptic spasms starting in the first year of life (infancy)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3887898" .

