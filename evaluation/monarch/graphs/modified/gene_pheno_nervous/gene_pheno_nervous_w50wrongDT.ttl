<http://purl.obolibrary.org/obo/HP_0009886> rdfs:label "Trichorrhexis nodosa" ;
    dcterms:description "Trichorrhexis nodosa is the formation of nodes along the hair shaft through which breakage readily occurs. It is thus a focal defect in the hair fiber that is characterized by thickening or weak points (nodes) that cause the hair to break off easily. The result is defective, abnormally fragile hair."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:22486004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0263485"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:238736006" .

<http://purl.obolibrary.org/obo/HP_0009899> rdfs:label "Prominent crus of helix" ;
    dcterms:description "The presence of an abnormally prominent of the crus of the helix. That is, development of the crus helix to the same degree as an average antihelix stem or helix." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal prominence of the crus of the ear"^^<http://example.org/invalidDatatype>,
        "Helix, crus, prominent"^^<http://example.org/invalidDatatype>,
        "Hyperplastic helix crus"^^<http://example.org/invalidDatatype>,
        "Hypertrophic helix crus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hypertrophic helix crus"^^<http://example.org/invalidDatatype>,
        "Abnormal prominence of the crus of the ear",
        "Helix, crus, prominent",
        "Hyperplastic helix crus" ;
    ns1:xref "UMLS:C4021377"^^<http://example.org/invalidDatatype> .

