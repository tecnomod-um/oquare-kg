<http://purl.obolibrary.org/obo/MONDO_0035344> rdfs:label "acute bilirubin encephalopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare neurologic disease characterized by lethargy, hypotonia, poor feeding, opisthotonus, and a typical high-pitched cry due to bilirubin accumulation in the globus pallidus, sub-thalamic nuclei, and other brain regions, resulting from severe neonatal unconjugated hyperbilirubinemia. Onset of symptoms is typically within the first three to five days of life. Additional features include fever, apnea, seizures, and coma. Especially respiratory failure or refractory seizures may lead to a fatal outcome."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "ABE"^^<http://example.org/invalidDatatype>,
        "Acute kernicterus" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0000407>,
        <http://purl.obolibrary.org/obo/HP_0000502>,
        <http://purl.obolibrary.org/obo/HP_0001250>,
