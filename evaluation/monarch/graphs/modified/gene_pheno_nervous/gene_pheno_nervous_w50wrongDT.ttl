<http://purl.obolibrary.org/obo/MONDO_0033667> rdfs:label "Delpire-McNeill syndrome" ;
    dcterms:description "Any neurodevelopmental disorder in which the cause of the disease is a mutation in the SLC12A2 gene. It is characterized by global developmental delay, mild to moderate intellectual disability, delayed, poor or absent speech, hypotonia with delayed or absent walking, bilateral sensorineural deafness, and autistic features. Variable features may include ventricular septal defect, tracheoesophageal fistula, hip dislocation, swallowing difficulties (that may require tube feeding), brain anomalies (including cortical dysplasia and agenesis of the corpus callosum) and spasticity." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "DELMNES",
        "SLC12A2-related autosomal dominant infantile-developmental delay-intellectual disability-sensorineural deafness syndrome" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0000729>,
        <http://purl.obolibrary.org/obo/HP_0000750>,
        <http://purl.obolibrary.org/obo/HP_0001257>,
        <http://purl.obolibrary.org/obo/HP_0001263>,
        <http://purl.obolibrary.org/obo/HP_0001274>,
        <http://purl.obolibrary.org/obo/HP_0001276>,
        <http://purl.obolibrary.org/obo/HP_0001290>,
        <http://purl.obolibrary.org/obo/HP_0001344>,
        <http://purl.obolibrary.org/obo/HP_0001629>,
        <http://purl.obolibrary.org/obo/HP_0002015>,
        <http://purl.obolibrary.org/obo/HP_0002539>,
        <http://purl.obolibrary.org/obo/HP_0002575>,
        <http://purl.obolibrary.org/obo/HP_0002827>,
        <http://purl.obolibrary.org/obo/HP_0008619>,
        <http://purl.obolibrary.org/obo/HP_0031936> ;
    ns1:synonym "DELMNES"^^<http://example.org/invalidDatatype>,
        "SLC12A2-related autosomal dominant infantile-developmental delay-intellectual disability-sensorineural deafness syndrome"^^<http://example.org/invalidDatatype> ;
