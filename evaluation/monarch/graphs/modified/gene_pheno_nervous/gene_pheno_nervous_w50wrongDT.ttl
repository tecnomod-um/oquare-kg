<http://purl.obolibrary.org/obo/HP_0001260> rdfs:label "Dysarthria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dysarthric speech is a general description referring to a neurological speech disorder characterized by poor articulation. Depending on the involved neurological structures, dysarthria may be further classified as spastic, flaccid, ataxic, hyperkinetic and hypokinetic, or mixed." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Difficulty articulating speech",
