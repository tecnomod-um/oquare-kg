<http://purl.obolibrary.org/obo/HP_0000154> rdfs:label "Wide mouth"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Distance between the oral commissures more than 2 SD above the mean. Alternatively, an apparently increased width of the oral aperture (subjective)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad mouth"^^<http://example.org/invalidDatatype>,
