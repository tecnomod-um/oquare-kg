    ns1:xref "SNOMEDCT_US:72129000"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:402599005",
        "UMLS:C0000889" .

<http://purl.obolibrary.org/obo/HP_0000963> rdfs:label "Thin skin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduction in thickness of the skin, generally associated with a loss of suppleness and elasticity of the skin." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Thin skin"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Thin skin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:277797007",
        "UMLS:C0423757" .

<http://purl.obolibrary.org/obo/HP_0000974> rdfs:label "Hyperextensible skin" ;
    dcterms:description "A condition in which the skin can be stretched beyond normal, and then returns to its initial position."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperelastic skin"^^<http://example.org/invalidDatatype>,
        "Skin hyperelasticity"^^<http://example.org/invalidDatatype>,
        "Skin hyperextensibility"^^<http://example.org/invalidDatatype>,
        "Stretchable skin"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Skin hyperelasticity"^^<http://example.org/invalidDatatype>,
        "Skin hyperextensibility"^^<http://example.org/invalidDatatype>,
        "Hyperelastic skin",
        "Stretchable skin" ;
    ns1:xref "UMLS:C0241074" .

<http://purl.obolibrary.org/obo/HP_0001009> rdfs:label "Telangiectasia" ;
    dcterms:description "Telangiectasias refer to small dilated blood vessels located near the surface of the skin or mucous membranes, measuring between 0.5 and 1 millimeter in diameter. Telangiectasia are located especially on the tongue, lips, palate, fingers, face, conjunctiva, trunk, nail beds, and fingertips." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Telangiectases" ;
    ns1:related_synonym "Spider veins"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Spider veins"^^<http://example.org/invalidDatatype>,
        "Telangiectases" ;
    ns1:xref "SNOMEDCT_US:112641009"^^<http://example.org/invalidDatatype>,
        "UMLS:C1138421"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:247479008",
        "UMLS:C0039446" .

<http://purl.obolibrary.org/obo/HP_0001058> rdfs:label "Poor wound healing" ;
    dcterms:description "A reduced ability to heal cutaneous wounds." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Poor wound healing" ;
    ns1:synonym "Poor wound healing" ;
    ns1:xref "UMLS:C1851789"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001072> rdfs:label "Thickened skin"^^<http://example.org/invalidDatatype> ;
