<http://purl.obolibrary.org/obo/MONDO_0013229> rdfs:label "hot water reflex epilepsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hot water reflex epilepsy is a rare neurologic disease characterized by the onset of generalized or focal seizures following immersion of the head in hot water, or with hot water being poured over the head. Primary generalized tonic-clonic seizures have been reported in rare cases."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "epilepsy, hot water"^^<http://example.org/invalidDatatype>,
