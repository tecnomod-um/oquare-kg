<http://purl.obolibrary.org/obo/HP_0000039> rdfs:label "Epispadias" ;
    dcterms:description "Epispadias is a urogenital malformation characterized by the failure of the urethral tube to tubularize on the dorsal aspect. Unlike in hypospadias, where the meatus is on the ventral aspect, children with epispadias have a wide-open urethral plate on the dorsum. It is commonly seen as a component in the spectrum of bladder exstrophy-epispadias-complex. Isolated epispadias constitutes less than 10 percent of the total cases of epispadias." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:406477003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0563449"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000040> rdfs:label "Long penis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Penile length more than 2 SD above the mean for age."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Enlarged penis"^^<http://example.org/invalidDatatype>,
        "Long penis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Enlarged penis"^^<http://example.org/invalidDatatype>,
        "Long penis" ;
    ns1:xref "SNOMEDCT_US:88673001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0269011"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000070> rdfs:label "Ureterocele"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A ureterocele is a congenital saccular dilatation of the distal segment of the ureter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:12818004",
        "UMLS:C0041960" .

