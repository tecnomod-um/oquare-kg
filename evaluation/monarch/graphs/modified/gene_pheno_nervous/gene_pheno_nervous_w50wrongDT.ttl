<http://purl.obolibrary.org/obo/HP_0012330> rdfs:label "Pyelonephritis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An inflammation of the kidney involving the parenchyma of kidney, the renal pelvis and the kidney calices."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:45816000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0034186"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012372> rdfs:label "Abnormal eye morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A structural anomaly of the globe of the eye, or bulbus oculi." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the globe"^^<http://example.org/invalidDatatype>,
        "Abnormally shaped eye"^^<http://example.org/invalidDatatype>,
        "Abnormal eye structure" ;
    ns1:synonym "Abnormal eye structure"^^<http://example.org/invalidDatatype>,
        "Abnormally shaped eye"^^<http://example.org/invalidDatatype>,
        "Abnormality of the globe" ;
    ns1:xref "Fyler:4863"^^<http://example.org/invalidDatatype>,
        "UMLS:C4022925"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012384> rdfs:label "Rhinitis" ;
    dcterms:description "Inflammation of the nasal mucosa with nasal congestion."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nasal inflammation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nasal inflammation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C2718128"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:70076002",
        "UMLS:C0035455" .

<http://purl.obolibrary.org/obo/HP_0012387> rdfs:label "Bronchitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the large airways in the lung including any part of the bronchi from the primary bronchi to the tertiary bronchi." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:32398004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0006277" .

<http://purl.obolibrary.org/obo/HP_0012440> rdfs:label "Abnormal biliary tract morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A structural abnormality of the biliary tree." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anomaly of the biliary tract" ;
    ns1:synonym "Anomaly of the biliary tract"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021086"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012446> rdfs:label "Decreased CSF 5-methyltetrahydrofolate concentration" ;
    dcterms:description "A reduced concentration of 5-methyltetrahydrofolate(2-) in the cerebrospinal fluid (CSF). 5-methyltetrahydrofolate is the active folate metabolite."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced CSF 5-methyltetrahydrofolate concentration"^^<http://example.org/invalidDatatype>,
        "Low CSF 5-methyltetrahydrofolate" ;
    ns1:related_synonym "Cerebral folate deficiency" ;
    ns1:synonym "Low CSF 5-methyltetrahydrofolate"^^<http://example.org/invalidDatatype>,
        "Cerebral folate deficiency",
        "Reduced CSF 5-methyltetrahydrofolate concentration" ;
    ns1:xref "SNOMEDCT_US:711403001"^^<http://example.org/invalidDatatype>,
        "UMLS:C2751584"^^<http://example.org/invalidDatatype>,
        "UMLS:C4022901"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012453> rdfs:label "Bilateral wrist flexion contracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A chronic loss of wrist joint motion on the right and left sides." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Bilateral wrist contracture" ;
    ns1:synonym "Bilateral wrist contracture" ;
    ns1:xref "UMLS:C4020723"^^<http://example.org/invalidDatatype>,
        "UMLS:C4022899"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012477> rdfs:label "Vocal tremor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A wavering, unsteady voice that reflects involuntary and approximately sinusoidal oscillation of motor unit firings of laryngeal muscles. Vocal tremor results in low frequency modulations of voice frequency or amplitude and intermittent voice instability." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Shakey voice"^^<http://example.org/invalidDatatype>,
        "Vocal tremor"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Shakey voice",
        "Vocal tremor" ;
    ns1:xref "UMLS:C4022889"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012490> rdfs:label "Panniculitis" ;
    dcterms:description "Inflammation of subcutaneous adipose tissue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of adipose tissue"^^<http://example.org/invalidDatatype>,
        "Inflammation of fat tissue"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Inflammation of adipose tissue"^^<http://example.org/invalidDatatype>,
        "Inflammation of fat tissue"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:22125009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0030326" .

<http://purl.obolibrary.org/obo/HP_0012495> rdfs:label "Posterior cerebral artery stenosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Narrowing or constriction of the inner surface (lumen) of the posterior cerebral artery."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1504569"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012502> rdfs:label "Abnormality of the internal capsule" ;
    dcterms:description "An anomaly of the internal capsule, which is an area of white matter in the brain that separates the caudate nucleus and the thalamus from the putamen and the globus pallidus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022875"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012504> rdfs:label "Abnormal size of pituitary gland"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deviation from the normal size of the pituitary gland."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022874"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012507> rdfs:label "Weakness of orbicularis oculi muscle"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced strength of the orbicularis oculi, the circumorbital muscle in the face that closes the eyelid." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Weakness of orbicularis oculi muscles"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Weakness of orbicularis oculi muscles" ;
    ns1:xref "UMLS:C1839030" .

<http://purl.obolibrary.org/obo/HP_0012523> rdfs:label "Oral aversion" ;
    dcterms:description "Reluctance or refusal of a child to be breastfed or eat, manifested as gagging, vomiting, turning head away from food, or avoidance of sensation in or around the mouth (i.e. toothbrushing or face-washing)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3665983"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012537> rdfs:label "Food intolerance" ;
    dcterms:description "A detrimental reaction to a food, beverage, food additive, or compound found in foods that produces symptoms in one or more body organs and systems that is not mediated by an immune reaction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Food intolerance",
        "Non-allergic food hypersensitivity" ;
    ns1:synonym "Non-allergic food hypersensitivity"^^<http://example.org/invalidDatatype>,
        "Food intolerance" ;
    ns1:xref "UMLS:C0149696"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:235719002" .

<http://purl.obolibrary.org/obo/HP_0012544> rdfs:label "Elevated circulating aldolase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of fructose 1,6-bisphosphate aldolase in the blood circulation above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated aldolase level" ;
    ns1:synonym "Elevated aldolase level"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022858" .

<http://purl.obolibrary.org/obo/HP_0012554> rdfs:label "Absent thumbnail" ;
    dcterms:description "Absence of thumb nail."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022849"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012583> rdfs:label "Unilateral renal hypoplasia" ;
    dcterms:description "One sided hypoplasia of the kidney."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Small kidney on one side"^^<http://example.org/invalidDatatype>,
        "Underdeveloped kidney on one side"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Small kidney on one side",
        "Underdeveloped kidney on one side" ;
    ns1:xref "UMLS:C0431691"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:204948009" .

<http://purl.obolibrary.org/obo/HP_0012592> rdfs:label "Albuminuria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased concentration of albumin in the urine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:274769005",
        "UMLS:C0001925" .

<http://purl.obolibrary.org/obo/HP_0012606> rdfs:label "Renal sodium wasting"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally increased sodium concentration in the urine in the presence of hyponatremia."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Kidney sodium wasting",
        "Renal Na wasting",
        "Renal Na+ wasting" ;
    ns1:synonym "Kidney sodium wasting"^^<http://example.org/invalidDatatype>,
        "Renal Na wasting"^^<http://example.org/invalidDatatype>,
        "Renal Na+ wasting" ;
    ns1:xref "UMLS:C2748576"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012642> rdfs:label "Cerebellar agenesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Cerebellar agenesis is defined by the near complete absence of cerebellar tissue with only remnants of the anterior vermis, flocculus, and/or middle cerebellar peduncles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022808"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012646> rdfs:label "Retractile testis" ;
    dcterms:description "A testis that is located at the upper scrotum or lower inguinal canal and that can be made to descend completely into the scrotum without resistance by manual reduction but returns to its original position by the cremasteric reflex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retractile testicle" ;
    ns1:synonym "Retractile testicle" ;
    ns1:xref "SNOMEDCT_US:21779006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0520578" .

<http://purl.obolibrary.org/obo/HP_0012666> rdfs:label "Severely reduced left ventricular ejection fraction" ;
    dcterms:description "A large reduction in the fraction of blood pumped from the left ventricle with each cardiac cycle. The normal range in adults is at over 50 percent, and a severe reduction is defined as less than 30 percent." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Severely reduced ejection fraction" ;
    ns1:synonym "Severely reduced ejection fraction" ;
    ns1:xref "UMLS:C4022790"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012671> rdfs:label "Abulia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abulia is characterized by difficulty in initiating and sustaining spontaneous movements; the person often appears frozen but will move hesitantly on request. There are frequently substantial reductions in emotional responsiveness, spontaneous speech, and social interaction. The individual appears to be content to remain still and inactive with minimal movement, but moves or reacts hesitantly in response to interactions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aboulia" ;
    ns1:synonym "Aboulia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0919974"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012689> rdfs:label "Abnormal pineal melatonin secretion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly in the amount or timing of melatonin secretion by the pineal gland. Note that melatonin is also synthesized by multiple tissues outside of the pineal gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022777" .

<http://purl.obolibrary.org/obo/HP_0012705> rdfs:label "Abnormal metabolic brain imaging by MRS"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of metabolism in the brain identified by magnetic resonance spectroscopy (MRS)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022764"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012715> rdfs:label "Profound hearing impairment" ;
    dcterms:description "A profound (essentially complete) form of hearing impairment." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Profound hearing impairment" ;
    ns1:synonym "Profound hearing impairment" ;
    ns1:xref "UMLS:C4022756" .

<http://purl.obolibrary.org/obo/HP_0012721> rdfs:label "Venous malformation" ;
    dcterms:description "A vascular malformation resulting from a developmental error of venous tissue composed of dysmorphic channels lined by flattened endothelium and exhibiting slow turnover. A venous malformation may present as a blue patch on the skin ranging to a soft blue mass. Venous malformations are easily compressible and usually swell in thewhen venous pressure increases (e.g., when held in a dependent position or when a child cries). They may be relatively localized or quite extensive within an anatomic region." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Venous malformations" ;
    ns1:synonym "Venous malformations" ;
    ns1:xref "SNOMEDCT_US:297222002"^^<http://example.org/invalidDatatype>,
        "UMLS:C2937220" .

<http://purl.obolibrary.org/obo/HP_0012722> rdfs:label "Heart block"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Impaired conduction of cardiac impulse occurring anywhere along the conduction pathway."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:233916004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0018794" .

<http://purl.obolibrary.org/obo/HP_0012726> rdfs:label "Episodic hypokalemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally decreased potassium concentration in the blood occurring periodically with a return to normal between the episodes." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Recurrent low potassium"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Recurrent low potassium" ;
    ns1:xref "UMLS:C4022754"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012731> rdfs:label "Ectopic anterior pituitary gland"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal anatomic location of the anterior pituitary gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022751"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012732> rdfs:label "Anorectal anomaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the anus or rectum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:33225004"^^<http://example.org/invalidDatatype>,
        "UMLS:C3495676" .

<http://purl.obolibrary.org/obo/HP_0012748> rdfs:label "Focal T2 hyperintense brainstem lesion" ;
    dcterms:description "A lighter than expected T2 signal on magnetic resonance imaging (MRI) of the brainstem. This term refers to a localized hyperintensity affecting a particular region of the brainstem."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022748"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012765> rdfs:label "Widened cerebellar subarachnoid space" ;
    dcterms:description "An increase in size of the anatomic space between the arachnoid membrane and pia mater in the region surrounding the cerebellum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022734"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012771> rdfs:label "Increased arm span"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased length of the arm span (length from one end of an individual's arms measured at the fingertips to the other when raised parallel to the ground at shoulder height at a one-hundred eighty degree angle)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased arm span" ;
    ns1:synonym "Increased arm span" ;
    ns1:xref "UMLS:C4022729"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012799> rdfs:label "Unilateral facial palsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "One-sided weakness of the muscles of facial expression and eye closure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Facial droop"^^<http://example.org/invalidDatatype>,
        "Paralysis of one side of the face"^^<http://example.org/invalidDatatype>,
        "Unilateral facial paralysis"^^<http://example.org/invalidDatatype>,
        "Unilateral facial weakness"^^<http://example.org/invalidDatatype>,
        "Unilateral facial muscle paralysis",
        "Unilateral facial muscle weakness",
        "Weakness of one side of the face" ;
    ns1:synonym "Facial droop"^^<http://example.org/invalidDatatype>,
        "Unilateral facial muscle paralysis"^^<http://example.org/invalidDatatype>,
        "Unilateral facial muscle weakness"^^<http://example.org/invalidDatatype>,
        "Paralysis of one side of the face",
        "Unilateral facial paralysis",
        "Unilateral facial weakness",
        "Weakness of one side of the face" ;
    ns1:xref "UMLS:C0239516"^^<http://example.org/invalidDatatype>,
        "UMLS:C4022719"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012802> rdfs:label "Broad jaw"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bigonial distance (lower facial width) more than 2 SD above the mean (objective); or an apparently increased width of the lower jaw (mandible) when viewed from the front (subjective)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad mandible"^^<http://example.org/invalidDatatype>,
        "Broad jaw",
        "Broad lower face",
        "Wide jaw",
        "Wide mandible" ;
    ns1:synonym "Broad jaw"^^<http://example.org/invalidDatatype>,
        "Broad lower face"^^<http://example.org/invalidDatatype>,
        "Wide jaw"^^<http://example.org/invalidDatatype>,
        "Broad mandible",
        "Wide mandible" ;
    ns1:xref "UMLS:C3281059" .

<http://purl.obolibrary.org/obo/HP_0012805> rdfs:label "Iris transillumination defect" ;
    dcterms:description "Transmission of light through the iris as visualized upon slit lamp examination or infrared iris transillumination videography. The light passes through defects in the pigmentation of the iris."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1096099"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012819> rdfs:label "Myocarditis" ;
    dcterms:description "Inflammation of the myocardium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of heart muscle" ;
    ns1:synonym "Inflammation of heart muscle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:50920009",
        "UMLS:C0027059" .

<http://purl.obolibrary.org/obo/HP_0012864> rdfs:label "Abnormal sperm morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A structural anomaly of sperm." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Teratospermia"^^<http://example.org/invalidDatatype>,
        "Teratozoospermia"^^<http://example.org/invalidDatatype>,
        "Abnormal shape of sperm" ;
    ns1:synonym "Abnormal shape of sperm"^^<http://example.org/invalidDatatype>,
        "Teratozoospermia"^^<http://example.org/invalidDatatype>,
        "Teratospermia" ;
    ns1:xref "UMLS:C0403824"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:236817003" .

<http://purl.obolibrary.org/obo/HP_0012877> rdfs:label "Retrograde ejaculation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The emission of semen and seminal fluid into the bladder instead of through the penis during orgasm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:50112006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0403673" .

<http://purl.obolibrary.org/obo/HP_0012900> rdfs:label "Myotonia of the face"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Slowed relaxation of muscles in the face."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022686" .

<http://purl.obolibrary.org/obo/HP_0012901> rdfs:label "Myotonia of the jaw" ;
    dcterms:description "Slowed relaxation of muscles in the jaw." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022685" .

<http://purl.obolibrary.org/obo/HP_0012904> rdfs:label "Cold-sensitive myotonia" ;
    dcterms:description "An involuntary and painless delay in the relaxation of skeletal muscle following contraction or electrical stimulation that is induced by exposure to cold." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022682"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020046> rdfs:label "Accommodative esotropia" ;
    dcterms:description "A form of esotropia (convergent deviation of the eyes) associated with activation of the accommodative reflex."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020071> rdfs:label "Viremia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of virus in the blood." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020073> rdfs:label "Hypopigmented macule" ;
    dcterms:description "A white or lighter patch of skin that may appear anywhere on the body and are caused by decreased skin pigmentation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020119> rdfs:label "Abnormal retinal nerve fiber layer morphology" ;
    dcterms:description "A structural abnormality of the retinal nerve fiber layer" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal retinal nerve fibre layer morphology"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal retinal nerve fibre layer morphology"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020181> rdfs:label "Reduced haptoglobin level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally low concentration of haptoglobin in the blood circulation. Decreased haptoglobin in conjunction with increased reticulocyte count and anemia may indicate hemolysis. Decreased haptoglobin levels can also occur in the absence of hemolysis, due to cirrhosis of the liver, disseminated ovarian carcinomatosis, pulmonary sarcoidosis, and elevated estrogen state."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020219> rdfs:label "Motor seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A motor seizure is a type of seizure that is characterized at onset by involvement of the skeletal musculature. The motor event could consist of an increase (positive) or decrease (negative) in muscle contraction to produce a movement."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025007> rdfs:label "Ectopic fovea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal anatomic position of the fovea." ;
    ns1:broad_synonym "Ectopic macula" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Ectopic macula"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025010> rdfs:label "Foveal atrophy" ;
    dcterms:description "A nonspecific term denoting wasting, especially as a result of degeneration, of the retinal pigment epithelium (RPE) and neurosensory retinal cells in the fovea."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025017> rdfs:label "Capillary fragility"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced resistance to rupture of capillary blood vessels. Capillary fragility may manifest as a bleeding diathesis with spontaneous ecchymoses (bruises)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025053> rdfs:label "Elevated brain N-acetyl aspartate level by MRS"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of N-acetyl aspartate in the brain identified by magnetic resonance spectroscopy (MRS)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated brain N-acetyl aspartate level by magnetic resonance spectroscopy" ;
    ns1:synonym "Elevated brain N-acetyl aspartate level by magnetic resonance spectroscopy" .

<http://purl.obolibrary.org/obo/HP_0025077> rdfs:label "Decreased QRS voltage" ;
    dcterms:description "Reduced amplitude (height) of the QRS complex of the electrocardiogram (EKG), defined as amplitudes of all the QRS complexes in the limb leads are less than 5 mm or amplitudes of all the QRS complexes in the precordial leads less than 10 mm." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025104> rdfs:label "Capillary malformation" ;
    dcterms:description "A capillary malformation is a flat, sharply defined vascular stain of the skin. It may cover a large surface area or it may be scattered and appear as little islands of color. In a capillary maformation, the predominant vessels are small, slow-flow vessels (i.e., arterioles and postcapillary venules)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025112> rdfs:label "Auditory sensitivity" ;
    dcterms:description "Decreased tolerance to sound."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Noise sensitivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Noise sensitivity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025142> rdfs:label "Constitutional symptom" ;
    dcterms:description "A symptom or manifestation indicating a systemic or general effect of a disease and that may affect the general well-being or status of an individual."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025143> rdfs:label "Chills"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A sudden sensation of feeling cold." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chills" ;
    ns1:synonym "Chills"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025168> rdfs:label "Left ventricular diastolic dysfunction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal function of the left ventricule during left ventricular relaxation and filling." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025235> rdfs:label "NREM parasomnia" ;
    dcterms:description "A parasomnia that occurs during non-rapid eye movement (NREM) sleep."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Disturbance in NREM",
        "NREM parasomnia",
        "Non-rapid eye movement parasomnia" ;
    ns1:synonym "Disturbance in NREM"^^<http://example.org/invalidDatatype>,
        "NREM parasomnia",
        "Non-rapid eye movement parasomnia" .

<http://purl.obolibrary.org/obo/HP_0025238> rdfs:label "Foot pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the foot." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Foot pain" ;
    ns1:synonym "Foot pain" .

<http://purl.obolibrary.org/obo/HP_0025309> rdfs:label "Abnormal pupil shape"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deviation from the normal circular shape of the pupil" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Irregular pupil"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Irregular pupil"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025313> rdfs:label "Exophoria" ;
    dcterms:description "A form of strabismus with one or both eyes deviated outward to a milder degree than with exotropia." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025318> rdfs:label "Ovarian carcinoma" ;
    dcterms:description "A malignant neoplasm originating from the surface ovarian epithelium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ovarian epithelial cancer"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Ovarian epithelial cancer" ;
    ns1:xref "NCIT:C4908" .

<http://purl.obolibrary.org/obo/HP_0025383> rdfs:label "Dorsocervical fat pad"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An area of fat accumulation at the back of the neck in the form of a hump." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Buffalo hump" ;
    ns1:synonym "Buffalo hump" .

<http://purl.obolibrary.org/obo/HP_0025456> rdfs:label "Abnormal CSF protein concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation from the normal range of a protein concentration in the cerebrospinal fluid." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal CSF protein level" ;
    ns1:synonym "Abnormal CSF protein level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025480> rdfs:label "Lipomyelomeningocele"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of spinal dysraphism presenting as a subcutaneous fatty mass, that is, a spinal defect associated with lipomatous tissue, and covered by skin. The most usual location for lipomyelomeningocele is at the gluteal cleft." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025518> rdfs:label "Visual gaze preference"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of gaze that can be observed following an acute supranuclear cerebral lesion (e.g., stroke) that is characterized by an acute inability to direct gaze contralateral to the side of the lesion and is accompanied by a tendency for tonic deviation of the eyes toward the side of the lesion."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025574> rdfs:label "Macular hemorrhage" ;
    dcterms:description "Bleeding occurring within the macula lutea of the retina." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular haemorrhage"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Macular haemorrhage" .

<http://purl.obolibrary.org/obo/HP_0025586> rdfs:label "Hypertropia" ;
    dcterms:description "A type of strabismus characterized by permanent upward deviation of the visual axis of one eye." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025592> rdfs:label "Superior oblique muscle weakness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased strength of the superior oblique muscle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Superior oblique palsy" ;
    ns1:synonym "Superior oblique palsy" .

<http://purl.obolibrary.org/obo/HP_0025605> rdfs:label "Lid lag on downgaze" ;
    dcterms:description "Delayed descent of the upper eyelid on downgaze. Also described by some authors as von Graefe sign." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Eyelid lag",
        "Lid lag" ;
    ns1:related_synonym "von Graefe sign"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Eyelid lag"^^<http://example.org/invalidDatatype>,
        "Lid lag"^^<http://example.org/invalidDatatype>,
        "von Graefe sign" .

<http://purl.obolibrary.org/obo/HP_0025615> rdfs:label "Abscess" ;
    dcterms:description "An abscess is a localized collection of purulent material surrounded by inflammation and granulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025637> rdfs:label "Vasospasm" ;
    dcterms:description "Narrowing of an artery due to constriction of the blood vessels." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blood vessel spasm"^^<http://example.org/invalidDatatype>,
        "Angiospasm",
        "Vascular spasm" ;
    ns1:synonym "Angiospasm",
        "Blood vessel spasm",
        "Vascular spasm" .

<http://purl.obolibrary.org/obo/HP_0025671> rdfs:label "Fetal pericardial effusion" ;
    dcterms:description "An abnormal accumulation of fluid in which the heart is partially or completely surrounded by fluid that is seen in all views and the thickness of the fluid as observed by prenatal ultrasound is above age-dependent norms."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025717> rdfs:label "Skeletal muscle autophagosome accumulation" ;
    dcterms:description "Abnormal accumulation of autophagosomes in skeletal muscle tissue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Autophagic material in muscle biopsy" ;
    ns1:synonym "Autophagic material in muscle biopsy" .

<http://purl.obolibrary.org/obo/HP_0030001> rdfs:label "Lagophthalmos" ;
    dcterms:description "A condition in which the eyelids do not close to cover the eye completely." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inability to close the eyelids"^^<http://example.org/invalidDatatype>,
        "Eyelids stay open" ;
    ns1:synonym "Eyelids stay open"^^<http://example.org/invalidDatatype>,
        "Inability to close the eyelids"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022680"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030059> rdfs:label "Mitochondrial depletion" ;
    dcterms:description "An abnormal reduction in mitochondrial DNA content of cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022659" .

<http://purl.obolibrary.org/obo/HP_0030088> rdfs:label "Increased serum testosterone level" ;
    dcterms:description "An elevated circulating testosterone level in the blood." ;
    ns1:broad_synonym "Increased testosterone" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High serum testosterone levels"^^<http://example.org/invalidDatatype>,
        "Increased serum testosterone levels"^^<http://example.org/invalidDatatype>,
        "High serum testosterone level" ;
    ns1:synonym "High serum testosterone levels"^^<http://example.org/invalidDatatype>,
        "Increased serum testosterone levels"^^<http://example.org/invalidDatatype>,
        "Increased testosterone"^^<http://example.org/invalidDatatype>,
        "High serum testosterone level" ;
    ns1:xref "UMLS:C0241358"^^<http://example.org/invalidDatatype>,
        "UMLS:C4072885" .

<http://purl.obolibrary.org/obo/HP_0030091> rdfs:label "Absent muscle fiber merosin" ;
    dcterms:description "Lack of merosin protein in the muscle biopsy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent merosin staining in muscle biopsy"^^<http://example.org/invalidDatatype>,
        "Absent muscle fiber laminin alpha 2"^^<http://example.org/invalidDatatype>,
        "Absent muscle fibre laminin alpha 2"^^<http://example.org/invalidDatatype>,
        "Absent muscle fibre merosin" ;
    ns1:synonym "Absent merosin staining in muscle biopsy"^^<http://example.org/invalidDatatype>,
        "Absent muscle fiber laminin alpha 2"^^<http://example.org/invalidDatatype>,
        "Absent muscle fibre laminin alpha 2"^^<http://example.org/invalidDatatype>,
        "Absent muscle fibre merosin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021055"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030179> rdfs:label "Abnormal peripheral action potential amplitude"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly in the magnitude of the action potential along a peripheral nerve, that is, of the rapid rise and fall of the electrical membrane potential of the nerve." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022596"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030185> rdfs:label "Isometric tremor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An isometric tremor occurs with muscle contraction against a rigid stationary object (e.g., when making a fist)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Dystonia tremor"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dystonia tremor"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022594"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280303"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030198> rdfs:label "Fatigable weakness of distal limb muscles"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of weakness of a skeletal muscle of distal part of a limb that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022585" .

<http://purl.obolibrary.org/obo/HP_0030207> rdfs:label "Paradoxical respiration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Breathing movements in which the chest wall moves in on inspiration and out on expiration, in reverse of the normal movements. It may be seen in children with respiratory distress of any cause, which leads to indrawing of the intercostal spaces during inspiration. Patients with chronic airways obstruction also show indrawing of the lower ribs during inspiration, due to the distorted action of a depressed and flattened diaphragm. Crush injuries of the chest, with fractured ribs and sternum, can lead to a severe degree of paradoxical breathing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Paradoxical breathing" ;
    ns1:synonym "Paradoxical breathing" .

<http://purl.obolibrary.org/obo/HP_0030210> rdfs:label "Anti-muscle-specific tyrosine kinase antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against muscle specific kinase (anti-MuSK Ab)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-MUSK antibodies"^^<http://example.org/invalidDatatype>,
        "Anti-muscle-specific tyrosine kinase antibody"^^<http://example.org/invalidDatatype>,
        "Muscle specific kinase antibody positivity" ;
    ns1:synonym "Anti-muscle-specific tyrosine kinase antibody"^^<http://example.org/invalidDatatype>,
        "Muscle specific kinase antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-MUSK antibodies" ;
    ns1:xref "UMLS:C4021044"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030212> rdfs:label "Collectionism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excessive or pathological tendency to save and collect possessions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Compulsive hoarding"^^<http://example.org/invalidDatatype>,
        "Hoarding"^^<http://example.org/invalidDatatype>,
        "Collecting" ;
    ns1:synonym "Collecting"^^<http://example.org/invalidDatatype>,
        "Compulsive hoarding"^^<http://example.org/invalidDatatype>,
        "Hoarding" ;
    ns1:xref "UMLS:C0424290"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:247968005" .

<http://purl.obolibrary.org/obo/HP_0030213> rdfs:label "Emotional dearth" ;
    dcterms:description "A diminished ability to experience, express, or connect with emotions whether positive or negative. This state is often characterized by a pervasive sense of emotional disconnection or detachment, where the individual may report feeling \"numb\" or lacking emotional responses that were previously present. The reduction in emotional response can range from mild dampening of emotional responses to a near-total absence of emotional engagement. It is essential to consider the individual's baseline emotional capacity, as changes may be more significant in those who previously had a wide emotional range." ;
    ns1:broad_synonym "Flat Affect"^^<http://example.org/invalidDatatype>,
        "Unable to feel emotion"^^<http://example.org/invalidDatatype>,
        "Affective insufficiency",
        "Blunted Affect",
        "Diminished Emotional Response",
        "Emotional poverty",
        "Restricted Affect" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Emotional blunting"^^<http://example.org/invalidDatatype>,
        "Emotional Numbness",
        "Emotionally barren",
        "Inability to feel emotions" ;
    ns1:related_synonym "Emotional Detachment",
        "Flattened Emotional Expression",
        "Lack of Emotional Reactivity",
        "Restricted Emotional Range",
        "Restricted emotional capacity" ;
    ns1:synonym "Affective insufficiency"^^<http://example.org/invalidDatatype>,
        "Blunted Affect"^^<http://example.org/invalidDatatype>,
        "Emotional Numbness"^^<http://example.org/invalidDatatype>,
        "Emotional blunting"^^<http://example.org/invalidDatatype>,
        "Emotional poverty"^^<http://example.org/invalidDatatype>,
        "Flat Affect"^^<http://example.org/invalidDatatype>,
        "Flattened Emotional Expression"^^<http://example.org/invalidDatatype>,
        "Inability to feel emotions"^^<http://example.org/invalidDatatype>,
        "Lack of Emotional Reactivity"^^<http://example.org/invalidDatatype>,
        "Restricted Affect"^^<http://example.org/invalidDatatype>,
        "Restricted Emotional Range"^^<http://example.org/invalidDatatype>,
        "Restricted emotional capacity"^^<http://example.org/invalidDatatype>,
        "Unable to feel emotion"^^<http://example.org/invalidDatatype>,
        "Diminished Emotional Response",
        "Emotional Detachment",
        "Emotionally barren" ;
    ns1:xref "SNOMEDCT_US:6140007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0233469"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030302> rdfs:label "Agenesis of the anterior commissure" ;
    dcterms:description "Absence of the anterior commissure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1851087" .

<http://purl.obolibrary.org/obo/HP_0030356> rdfs:label "Increased circulating interferon-gamma concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevation in the concentration of interferon gamma measured in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum interferon-gamma level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased serum interferon-gamma level" ;
    ns1:xref "UMLS:C4072900"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030430> rdfs:label "Neuroma" ;
    dcterms:description "A tumor made up of nerve cells and nerve fibers."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nerve tumor"^^<http://example.org/invalidDatatype>,
        "Pinched nerve"^^<http://example.org/invalidDatatype>,
        "Nerve tumour" ;
    ns1:synonym "Pinched nerve"^^<http://example.org/invalidDatatype>,
        "Nerve tumor",
        "Nerve tumour" ;
    ns1:xref "SNOMEDCT_US:274089002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:84116009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0027858"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:25169009",
        "SNOMEDCT_US:443892003",
        "UMLS:C0273482" .

<http://purl.obolibrary.org/obo/HP_0030469> rdfs:label "Abnormal dark-adapted electroretinogram"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An electroretinographic anomaly detected by dark-adapted full-field ERG. The dark adapted ERG targets rod-pathway function." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072959"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030473> rdfs:label "Abnormal light-adapted flicker electroretinogram" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal light adapted flicker electroretinogram"^^<http://example.org/invalidDatatype>,
        "Abnormal light-adapted 30Hz flicker ERG"^^<http://example.org/invalidDatatype>,
        "Abnormal light-adapted flicker ERG"^^<http://example.org/invalidDatatype>,
        "Abnormal light-adapted 30Hz flicker electroretinogram" ;
    ns1:synonym "Abnormal light adapted flicker electroretinogram"^^<http://example.org/invalidDatatype>,
        "Abnormal light-adapted 30Hz flicker ERG"^^<http://example.org/invalidDatatype>,
        "Abnormal light-adapted 30Hz flicker electroretinogram"^^<http://example.org/invalidDatatype>,
        "Abnormal light-adapted flicker ERG"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072963" .

<http://purl.obolibrary.org/obo/HP_0030501> rdfs:label "Macular crystals" ;
    dcterms:description "Crystalline deposits in the macula, located intra-retinally." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Refractile lesions in the macula" ;
    ns1:synonym "Refractile lesions in the macula"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072988"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030512> rdfs:label "Difficulty adjusting to changes in luminance"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072994"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030531> rdfs:label "Altitudinal visual field defect" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073005" .

<http://purl.obolibrary.org/obo/HP_0030532> rdfs:label "Visual acuity test abnormality" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073006"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030553> rdfs:label "Visual acuity no light perception" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:63063006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0442774"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030586> rdfs:label "Abnormal Ishihara plate test"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073059" .

<http://purl.obolibrary.org/obo/HP_0030602> rdfs:label "Abnormal fundus autofluorescence imaging"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fundus autofluorescence (FAF) is a non-invasive retinal imaging modality used in clinical practice to provide a density map of lipofuscin, the predominant ocular fluorophore, in the retinal pigment epithelium. Autofluorescent patterns result from the complex interaction of fluorophores such a lipofuscin, which release an autofluorescent signal, and elements such as melanin and rhodopsin, which absorb the excitation beam and attenuate autofluorescence. Other structures such as retinal vessels and the crystalline lens may also influence autofluorescence through blocking and interference." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073073"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030619> rdfs:label "Reduced OCT-measured foveal thickness"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073089" .

<http://purl.obolibrary.org/obo/HP_0030625> rdfs:label "Hyporeflective spaces on macular OCT"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073095"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030632> rdfs:label "Hypoautofluorescent macular lesion" ;
    dcterms:description "Decreased amount of autofluorescence in the macula as ascertained by fundus autofluorescence imaging." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypo-autofluorescent macular lesion"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hypo-autofluorescent macular lesion"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4073102" .

<http://purl.obolibrary.org/obo/HP_0030693> rdfs:label "Supratentorial neoplasm" ;
    dcterms:description "A benign or malignant neoplasm that occurs within the intracranial cavity above the tentorium cerebelli." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pineal parenchymal tumor",
        "Pineal parenchymal tumour" ;
    ns1:synonym "Pineal parenchymal tumor",
        "Pineal parenchymal tumour" ;
    ns1:xref "SNOMEDCT_US:359619007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:47598005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0038874"^^<http://example.org/invalidDatatype>,
        "NCIT:C3328",
        "SNOMEDCT_US:127026004",
        "UMLS:C0031941" .

<http://purl.obolibrary.org/obo/HP_0030746> rdfs:label "Intraventricular hemorrhage" ;
    dcterms:description "Bleeding into the ventricles of the brain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intraventricular haemorrhage"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Intraventricular haemorrhage"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:23276006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0240059"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030800> rdfs:label "Abnormal visual accommodation" ;
    dcterms:description "An anomaly in the process of visual accommodation, which is the process of adjustment of the eye to enable sharp vision of objects at different distances. Accommodation is mediated by contraction of the ciliary muscles, which alter the convexity of the lens and, consequently, its refractive power."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280760" .

<http://purl.obolibrary.org/obo/HP_0030811> rdfs:label "Tongue pain" ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the tongue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Painful tongue" ;
    ns1:synonym "Painful tongue" ;
    ns1:xref "SNOMEDCT_US:30731004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0017672" .

<http://purl.obolibrary.org/obo/HP_0030820> rdfs:label "Hooded eyelid"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Eyelid partly covered by skin when eyes are open."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3277348"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030830> rdfs:label "Crackles"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Crackles are discontinuous, explosive, and nonmusical adventitious lung sounds normally heard in inspiration and sometimes during expiration. Crackles are usually classified as fine and coarse crackles based on their duration, loudness, pitch, timing in the respiratory cycle, and relationship to coughing and changing body position."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Crepitations",
        "Rales" ;
    ns1:synonym "Crepitations"^^<http://example.org/invalidDatatype>,
        "Rales"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0034642"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:48409008" .

<http://purl.obolibrary.org/obo/HP_0030839> rdfs:label "Knee pain" ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the knee." ;
    ns1:broad_synonym "Pain under knee cap" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Knee pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Knee pain"^^<http://example.org/invalidDatatype>,
        "Pain under knee cap"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:30989003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0231749" .

<http://purl.obolibrary.org/obo/HP_0030844> rdfs:label "Undetectable pattern electroretinogram"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absent response to a pattern electroretinogram (PERG)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280746" .

<http://purl.obolibrary.org/obo/HP_0030872> rdfs:label "Abnormal cardiac ventricular function"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the cardiac ventricular function." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280733" .

<http://purl.obolibrary.org/obo/HP_0030907> rdfs:label "Thunderclap headache"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Severe head pain with sudden onset, reaching its maximum intensity in less than one minute and lasting from one hour to ten days."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031153> rdfs:label "Membranous vitreous appearance" ;
    dcterms:description "Vitreous humor of the eye displaying consisting of a vestigial gel in the retrolental space bounded by a convoluted membrane." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Membranous anomaly"^^<http://example.org/invalidDatatype>,
        "Membranous vitreous"^^<http://example.org/invalidDatatype>,
        "Membranous vitreous phenotype"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Membranous anomaly"^^<http://example.org/invalidDatatype>,
        "Membranous vitreous"^^<http://example.org/invalidDatatype>,
        "Membranous vitreous phenotype" .

<http://purl.obolibrary.org/obo/HP_0031177> rdfs:label "Finger flexor weakness" ;
    dcterms:description "Reduced ability to flex (bend) the fingers. This can manifest as incomplete closure of the hand due to weakness in finger flexion." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031185> rdfs:label "Elevated circulating NT-proBNP concentration" ;
    dcterms:description "The concentration of NT-proBNP (= N-terminal pro-B-type natriuretic peptide, = N-terminal prohormone of brain natriuretic peptide) in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased NT-proBNP level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased NT-proBNP level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031207> rdfs:label "Hepatic hemangioma" ;
    dcterms:description "A congenital vascular malformation in the liver composed of masses of blood vessels that are atypical or irregular in arrangement and size."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hemangioma of the liver",
        "Liver hemangioma" ;
    ns1:synonym "Hemangioma of the liver"^^<http://example.org/invalidDatatype>,
        "Liver hemangioma"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031246> rdfs:label "Nonproductive cough"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A cough that does not produce phlegm or mucus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dry cough",
        "Dry coughing" ;
    ns1:synonym "Dry cough"^^<http://example.org/invalidDatatype>,
        "Dry coughing" .

<http://purl.obolibrary.org/obo/HP_0031251> rdfs:label "Abnormal subclavian artery morphology" ;
    dcterms:description "Any anomaly of a subclavian artery."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031295> rdfs:label "Left atrial enlargement" ;
    dcterms:description "Increase in size of the left atrium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Enlarged heart left atrium"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Enlarged heart left atrium" ;
    ns1:xref "Fyler:3020"^^<http://example.org/invalidDatatype>,
        "Fyler:3011" .

<http://purl.obolibrary.org/obo/HP_0031318> rdfs:label "Myofiber disarray"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A nonparallel arrangement of cardiac myocytes." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Myocardial fibre disarray"^^<http://example.org/invalidDatatype>,
        "Myocardial fiber disarray" ;
    ns1:synonym "Myocardial fibre disarray"^^<http://example.org/invalidDatatype>,
        "Myocardial fiber disarray" .

<http://purl.obolibrary.org/obo/HP_0031364> rdfs:label "Ecchymosis" ;
    dcterms:description "A purpuric lesion that is larger than 1 cm in diameter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ecchymoses"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Ecchymoses" .

<http://purl.obolibrary.org/obo/HP_0031422> rdfs:label "Abnormal cerebellar cortex morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the cortex of the cerebellum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal morphology of the cerebellar cortex" ;
    ns1:synonym "Abnormal morphology of the cerebellar cortex"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031432> rdfs:label "Restricted or repetitive behaviors or interests"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A broad range of compulsive behaviors are repeated, including simple motor stereotypies and tics, as well as more complex repetitive movements or compulsions." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031466> rdfs:label "Impairment in personality functioning"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A maladaptive personality trait characterized by moderate or greater impairment in personality (self /interpersonal) functioning."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031468> rdfs:label "Separation insecurity" ;
    dcterms:description "Fears of rejection by and/or separation from significant others are associated with fears of excessive dependency and complete loss of autonomy." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031469> rdfs:label "Low self-esteem"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Persistent, excessively negative, and critical thoughts of one's personal abilities, attributes, or any feature related to the self and self-attitude. The affected individual believes they are a lesser being compared to others in their social peer group."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Worthlessness" ;
    ns1:synonym "Worthlessness" .

<http://purl.obolibrary.org/obo/HP_0031545> rdfs:label "Abnormally low T cell receptor excision circle level" ;
    dcterms:description "Reduced level of T cell receptor excision circle (TRECs) as measured by the TREC assay. Late in maturation, 70% of thymocytes that will ultimately express alpha/beta-T cell receptors form a circular DNA TREC from the excised TCRdelta gene that lies within the TCRalpha genetic locus. The circles are stable but do not increase following cell division and, therefore, become diluted as T cells proliferate. A quantitative polymerase chain reaction (PCR) reaction across the joint of the circular DNA provides the TREC copy number, a marker of newly-formed, antigenically-naïve thymic emigrant T cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031826> rdfs:label "Abnormal reflex" ;
    dcterms:description "Any anomaly of a reflex, i.e., of an automatic response mediated by the nervous system (a reflex does not need the intervention of conscious thought to occur)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031846> rdfs:label "Femur fracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A break or crush injury of the thigh bone (femur)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Femoral fracture"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Femoral fracture"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031878> rdfs:label "Acromicria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Small hands and feet in proportion to the rest of the body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031885> rdfs:label "Hyperglycorrhachia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally high glucose concentration in the cerebrospinal fluid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased CSF glucose" ;
    ns1:synonym "Increased CSF glucose"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031891> rdfs:label "Decreased total eosinophil count" ;
    dcterms:description "Abnormal decrease of absolute number of eosinophils in the blood, per microlitre, compared to a reference range for a given sex and age-group."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased eosinophil count"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased eosinophil count"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031913> rdfs:label "Rhombencephalosynapsis" ;
    dcterms:description "Rhombencephalosynapsis is a rare brain malformation defined by midline fusion of the cerebellar hemispheres with partial or complete loss of the intervening vermis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031931> rdfs:label "Ocular flutter"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Ocular flutter is an abnormal eye movement consisting of repetitive, irregular, involuntary bursts of horizontal saccades without an intersaccadic interval. It is generally superimposed on normal oculomotor behavior and its occurrence may be favored by various events, such as blinks, the triggering of normal saccades or optokinetic stimulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031937> rdfs:label "Tachylalia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Speech that is abnormally fast as compared to the perceived cultural norm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tachylogia"^^<http://example.org/invalidDatatype>,
        "Fast speech" ;
    ns1:synonym "Tachylogia"^^<http://example.org/invalidDatatype>,
        "Fast speech" .

<http://purl.obolibrary.org/obo/HP_0031938> rdfs:label "Abnormal conus terminalis morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the conus terminalis, which is the distal bulbous part of the spinal cord at the location where the spinal cord tapers and ends (usually between the L1 and L2 lumbar vertebrae)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal conus medullaris morphology"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal conus medullaris morphology" .

<http://purl.obolibrary.org/obo/HP_0031947> rdfs:label "Tongue tremor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unintentional, oscillating to-and-fro muscle movement affecting the tongue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Jerky movements of the tongue"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Jerky movements of the tongue" .

<http://purl.obolibrary.org/obo/HP_0032051> rdfs:label "Focal cortical dysplasia type II"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of focal cortical dysplasia that is characterized by disrupted cortical lamination and specific cytological abnormalities." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032052> rdfs:label "Focal cortical dysplasia type IIa"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A subtype of focal cortical dysplasia type II that is characterized by dysmorphic neurons, which present with a significantly enlarged cell body and nucleus, malorientation, abnormally distributed intracellular Nissl substance and cytoplasmic accumulation of neurofilament proteins."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032059> rdfs:label "Mild malformation of cortical development"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A malformation of cortical development characterized by mild abnormalities of the cortex: excessive heterotopic neurons in Layer 1 or microscopic neuronal clusters or excess of single neurons of normal morphology in deep white matter." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032070> rdfs:label "Leptomeningeal enhancement" ;
    dcterms:description "Contrast material enhancement of the pia mater or enhancement that extends into the subarachnoid spaces of the sulci and cisterns is leptomeningeal enhancement. Leptomeningeal enhancement is usually associated with meningitis, which may be bacterial, viral, or fungal. The primary mechanism of this enhancement is breakdown of the blood-brain barrier without angiogenesis." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032097> rdfs:label "Hypermanganesemia" ;
    dcterms:description "An elevation above the normal concentration of manganese in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased blood manganese concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased blood manganese concentration"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032118> rdfs:label "Retinitis" ;
    dcterms:description "Inflammation of the retina of the eye."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032122> rdfs:label "Very low visual acuity" ;
    dcterms:description "A reduction in visual acuity with best corrected visual acuity between 1.40 (20/500) and 1.89 logMAR (up to roughly 20/1590)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032147> rdfs:label "Erythromelalgia" ;
    dcterms:description "Recurrent episodes of redness, burning pain, and warmth of the extremities following exposure to heat or exercise with symptoms predominantly involving the feet." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032232> rdfs:label "Elevated circulating CK-MB concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of CK-MB (= creatine kinase MB) in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased circulating CK MB isoform" ;
    ns1:synonym "Increased circulating CK MB isoform"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032271> rdfs:label "Extrapulmonary tuberculosis" ;
    dcterms:description "A type of tubercular infection located outside of the lung, which is the most common location of tuberculosis. There are two types of clinical manifestation of tuberculosis (TB) are pulmonary TB (PTB) and extrapulmonary TB (EPTB). The former is most common. EPTB refers to TB involving organs other than the lungs (e.g., pleura, lymph nodes, abdomen, genitourinary tract, skin, joints and bones, or meninges). A patient with both pulmonary and EPTB is classified as a case of PTB." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Extrapulmonary TB"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Extrapulmonary TB" .

<http://purl.obolibrary.org/obo/HP_0032308> rdfs:label "Increased circulating procalcitonin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevated concentration of procalcitonin in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased circulating procalcitonin level" ;
    ns1:synonym "Increased circulating procalcitonin level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032323> rdfs:label "Periodic fever" ;
    dcterms:description "Episodic fever that recurs at regular intervals." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032506> rdfs:label "Alien limb phenomenon" ;
    dcterms:description "Alien limb phenomenon refers to involuntary motor activity of a limb in conjunction with the feeling of estrangement from that limb."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032521> rdfs:label "Self hugging" ;
    dcterms:description "Involuntary, tic-like movements consisted of crossing both arms across the chest and tensing the body or clasping the hands and squeezing the arms to the sides. The movements last a few seconds and may occur in series or flurries, generally accompanied by facial grimacing and occasional grunting." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spasmodic upper-body squeeze" ;
    ns1:synonym "Spasmodic upper-body squeeze" .

<http://purl.obolibrary.org/obo/HP_0032550> rdfs:label "Howell-Jolly bodies" ;
    dcterms:description "Howell-Jolly bodies are small, intra-erythrocytic remnants of erythrocyte nuclei. These inclusions are solitary in each erythrocyte and strongly basophilic. These are often confused with overlying platelets, but can be distinguished by the presence of a halo around overlying platelets." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032588> rdfs:label "Hand apraxia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inability to perform purposeful (learned) movements with the hand upon command, even though the command is understood and there is a willingness to perform the movement. Hand apraxia includes the inability to grasp, pick up, and hold large and small objects." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lack of purposeful hand use"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Lack of purposeful hand use" .

<http://purl.obolibrary.org/obo/HP_0032649> rdfs:label "Skewfoot"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of flat-foot characterized by hindfoot abductovalgus, metatarsus adductus, and Achilles tendon shortening. The predominant radiographic findings include forefoot adduction with lateral subluxation of the navicular on the talus and heel valgus. Very abnormal shoe wear is noted on the medial side. Calluses occur under the metatarsal heads and the head of the plantar-flexed talus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Skew foot"^^<http://example.org/invalidDatatype>,
        "Skew-foot" ;
    ns1:synonym "Skew foot"^^<http://example.org/invalidDatatype>,
        "Skew-foot" .

<http://purl.obolibrary.org/obo/HP_0032677> rdfs:label "Generalized-onset motor seizure" ;
    dcterms:description "A generalized motor seizure is a type of generalized-onset seizure with predominantly motor (involving musculature) signs. The motor event could consist of an increase (positive) or decrease (negative) in muscle contraction to produce a movement."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Generalised onset motor seizure"^^<http://example.org/invalidDatatype>,
        "Generalised-onset motor seizure"^^<http://example.org/invalidDatatype>,
        "Generalized onset motor seizure" ;
    ns1:synonym "Generalised onset motor seizure"^^<http://example.org/invalidDatatype>,
        "Generalised-onset motor seizure"^^<http://example.org/invalidDatatype>,
        "Generalized onset motor seizure" .

<http://purl.obolibrary.org/obo/HP_0032678> rdfs:label "Eyelid myoclonia seizure" ;
    dcterms:description "An eyelid myoclonia seizure is a type of generalized myoclonic seizure which may or may not be associated with loss of awareness."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032773> rdfs:label "Focal autonomic seizure with palpitations/tachycardia/bradycardia/asystole" ;
    dcterms:description "A type of focal autonomic seizure characterized by changes in heart rate as the initial semiological feature."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032810> rdfs:label "Focal sensory seizure with cephalic sensation" ;
    dcterms:description "A seizure characterized by a sensation in the head such as light-headedness or headache as its first clinical manifestation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cephalic aura"^^<http://example.org/invalidDatatype>,
        "Focal seizure with cephalic sensation"^^<http://example.org/invalidDatatype>,
        "Partial seizure with cephalic sensation" ;
    ns1:synonym "Focal seizure with cephalic sensation"^^<http://example.org/invalidDatatype>,
        "Cephalic aura",
        "Partial seizure with cephalic sensation" .

<http://purl.obolibrary.org/obo/HP_0032864> rdfs:label "Focal aware sensory seizure with auditory features"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of focal sensory seizure with auditory features during which awareness is retained throughout the seizure." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032867> rdfs:label "Refractory status epilepticus" ;
    dcterms:description "Refractory status epilepticus is defined as status epilepticus continuing despite two appropriately selected and dosed antiepileptic drugs, including a benzodiazepine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032894> rdfs:label "Seizure precipitated by febrile infection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any form of seizure occurring at the time of a fever (temperature at or above 38.0 degrees Celcius) without infection of the central nervous system, and without an alternative cause such as severe metabolic derangement, occurring at any age."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fever induced seizure"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Fever induced seizure"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033054> rdfs:label "Myoclonic tremor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A tremor-like cortical myoclonus. The tremulous movements are in fact small, high-frequency myoclonic jerks, induced by posture or action. They can be mild, but can also be more incapacitating. When present in the lower limbs, these may lead to gait disorders and even drop attacks. These tremor-like movements during action can be mistaken for essential tremor or epileptic seizures."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033082> rdfs:label "Reduced TSH response to thyrotrophin-releasing hormone stimulation test"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A lower than normal TSH response to thyrotrophin-releasing hormone stimulation test."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033092> rdfs:label "Increased urine succinate level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of succinate in the urine, normalized for urine concentration, is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033205> rdfs:label "Biceps hyperreflexia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased intensity of the biceps reflex."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033206> rdfs:label "Hyperactive Achilles reflex" ;
    dcterms:description "Increased intensity of the Achilles reflex."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperactive ankle jerk reflex"^^<http://example.org/invalidDatatype>,
        "Hyperactive ankle reflex" ;
    ns1:synonym "Hyperactive ankle jerk reflex"^^<http://example.org/invalidDatatype>,
        "Hyperactive ankle reflex"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033257> rdfs:label "Delayed ability to walk with support" ;
    dcterms:description "A failure to achieve the ability to walk with support (cruise) at an appropriate developmental stage."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Delayed ability to cruise" ;
    ns1:synonym "Delayed ability to cruise"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033329> rdfs:label "Abnormal postural reflex" ;
    dcterms:description "Anomaly of the physiological response to maintain the body's posture when movement and position is altered."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal postural reaction" ;
    ns1:synonym "Abnormal postural reaction" .

<http://purl.obolibrary.org/obo/HP_0033686> rdfs:label "Mitochondrial hypertrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Enlargement of mitochondria. Mitochondrial hypertrophy is not discernible by light microscopy. By electron microscopy (EM), hypertrophic mitochondria have normal cristae and normal matrix density. In contrast, swollen mitochondria display swollen cristae and irregular matrix densities in EM."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Megamitochondria"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Megamitochondria" .

<http://purl.obolibrary.org/obo/HP_0033720> rdfs:label "EEG with occipital epileptiform discharges" ;
    dcterms:description "Focal epileptiform EEG discharges recorded in the occipital region."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033733> rdfs:label "Low-grade vesicoureteral reflux" ;
    dcterms:description "Vesicoureteral reflux without dilation of the renal calyces (Grade I-II)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033755> rdfs:label "Increased left ventricular end-diastolic volume" ;
    dcterms:description "Abnormally high volume of blood in the left ventricle at the end of diastole (just before systole)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033834> rdfs:label "Malaise"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A feeling of general discomfort, weakness, or lack of health." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034008> rdfs:label "Opto-chiasmatic atrophy" ;
    dcterms:description "Wasting (atrophy) of the optic chiasm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034042> rdfs:label "Dorsal hirsutism" ;
    dcterms:description "Abnormally increased hair growth in the lskin of the back."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034051> rdfs:label "Hypoplastic anterior limbs of the internal capsule" ;
    dcterms:description "Underdevelopment of the frontal part (anterior crus or anterior limb) of the internal capsule."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034052> rdfs:label "Impaired toe-walking ability" ;
    dcterms:description "Difficulty or reduced ability to walk on toes. Toe-walking can be tested as a part of the neurological examination. Foot plantar flexion weakness leads to difficulties in walking on toes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034159> rdfs:label "Paget disease of bone" ;
    dcterms:description "A localized disorder of bone remodeling. Increased numbers of larger than normal osteoclasts initiate the process at affected skeletal sites, and the increase in bone resorption is followed by an increase in new bone formation, altering bone architecture."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034252> rdfs:label "Absent corneal reflex"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of the corneal blinking reflex, which normally induces involuntary blinking of the eyelids following contact of the cornea. The corneal blink reflex is caused by a loop between the trigeminal sensory nerves and the facial motor (VII) nerve innervation of the orbicularis oculi muscles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034272> rdfs:label "Perifoveal hypoautofluorescence" ;
    dcterms:description "Decreased amount of autofluorescence (emission of fluorescent light from ocular structures in the absence of sodium fluorescein) in the retina in the region surrounding the fovea." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034298> rdfs:label "Elevated circulating hexacosanoic acid concentration" ;
    dcterms:description "Elevated concentration of hexacosanoic acid (a C26 straight-chain saturated fatty acid) in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating cerotic acid concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated circulating cerotic acid concentration" .

<http://purl.obolibrary.org/obo/HP_0034368> rdfs:label "Urolithiasis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Renal stones are formed within the kidneys, and this is called nephrolithiasis. Urolithiasis is a condition that occurs when these stones exit the renal pelvis and move into the remainder of the urinary collecting system, which includes the ureters, bladder, and urethra."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034373> rdfs:label "External tibial torsion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "External twisting of the tibia resulting in the toes of each foot pointing outward (outtoeing) ."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "External tibial rotation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "External tibial rotation" .

<http://purl.obolibrary.org/obo/HP_0034396> rdfs:label "Hippocampal malrotation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hippocampal malrotation, also termed incomplete inversion of the hippocampus or hippocampal malformation, is an increasingly recognized neuroimaging finding of undetermined clinical significance. It is characterized by features including (i) Round or pyramidal shape instead of ovoid shape; (ii) Medial position of the hippocampus on the hippocampal sulcus; (iii) The collateral sulcus is excessively deep or verticalized; (iv) Fimbria located medial to the hippocampus; (v) Small or displaced fornix; (vi) Enlarged temporal horn and empty choroid fissure; (vii) Thickened subiculum; (viii) Reduced upper horizontal portion of the parahippocampal gyrus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034397> rdfs:label "Claw toe deformity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Claw toes are characterized by hyperextension at the metatarsal-phalangeal joints and flexion of the interphalangeal joints."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034454> rdfs:label "Arachnoid granulation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Arachnoid granulations (AGs) are tufts of arachnoid membrane invaginated into the dural sinuses through which cerebrospinal fluid (CSF) enters the venous system. The lesions are primarily located in the parasagittal region along the superior sagittal sinus, which is occasionally seen at the transverse sinus. Normally dural venous sinus AGs typically range from 2 to 8 mm in size, but may grow enough to expand the dural sinuses, and even the inner table, diploic space and outer table of the skull." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034585> rdfs:label "Cochlear nerve hypoplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A developmental defect characterized by underdevelopment of the cochlear nerve." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034649> rdfs:label "Elevated urine N-acetylaspartic acid level" ;
    dcterms:description "The amount of N-acetylaspartate in the urine, when corrected for urine concentration, is above upper limit of normal. This feature can be measured using gas chromatography-mass spectrometry."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urinary N-acetylaspartic acid level"^^<http://example.org/invalidDatatype>,
        "N-acetylaspartate high in urine"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated urinary N-acetylaspartic acid level"^^<http://example.org/invalidDatatype>,
        "N-acetylaspartate high in urine" .

<http://purl.obolibrary.org/obo/HP_0040022> rdfs:label "Clinodactyly of the 2nd finger"^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Curvature of index finger" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Second finger clinodactyly" ;
    ns1:synonym "Curvature of index finger"^^<http://example.org/invalidDatatype>,
        "Second finger clinodactyly"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022486"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040130> rdfs:label "Abnormal circulating iron concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of iron in the blood circulation is outside the limits of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal serum iron concentration" ;
    ns1:synonym "Abnormal serum iron concentration" ;
    ns1:xref "UMLS:C0235760"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040144> rdfs:label "L-2-hydroxyglutaric aciduria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of L-2-hydroxyglutaric acid in the urine." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1855995"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:237961001" .

<http://purl.obolibrary.org/obo/HP_0040146> rdfs:label "D-2-hydroxyglutaric acidemia" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022415"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040173> rdfs:label "Abnormality of the tongue muscle"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of lingual muscle"^^<http://example.org/invalidDatatype>,
        "Abnormality of the tongue muscle" ;
    ns1:synonym "Abnormality of lingual muscle"^^<http://example.org/invalidDatatype>,
        "Abnormality of the tongue muscle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4073139" .

<http://purl.obolibrary.org/obo/HP_0040188> rdfs:label "Osteochondrosis" ;
    dcterms:description "Abnormal growth ossification centers in children. Initially a degeneration/ necrosis followed by regeneration or recalcification." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0029429"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:19579005" .

<http://purl.obolibrary.org/obo/HP_0040264> rdfs:label "Jaw pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the jaw." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Jaw pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Jaw pain" ;
    ns1:xref "SNOMEDCT_US:274667000",
        "UMLS:C0236000" .

<http://purl.obolibrary.org/obo/HP_0040293> rdfs:label "Right hemiplegia"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hemiplegia (right)" ;
    ns1:synonym "Hemiplegia (right)" .

<http://purl.obolibrary.org/obo/HP_0040303> rdfs:label "Decreased circulating iron concentration" ;
    dcterms:description "The concentration of iron in the blood circulation is below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low serum iron"^^<http://example.org/invalidDatatype>,
        "Decreased serum iron",
        "Hypoferremia" ;
    ns1:synonym "Hypoferremia"^^<http://example.org/invalidDatatype>,
        "Decreased serum iron",
        "Low serum iron" .

<http://purl.obolibrary.org/obo/HP_0040328> rdfs:label "Focal hyperintensity of cerebral white matter on MRI"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal area of increased brightness (hyperintensity) that is limited to one particular area." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040330> rdfs:label "Confluent hyperintensity of cerebral white matter on MRI"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Areas of brighter than expected MRI signal in the white matter of the brain whereby individual patches run together." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0041093> rdfs:label "Beau's lines"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A nail dystrophy that is preseents as grooved lines that run from side to side on the fingernail or the toenail that may look like indentations or ridges on the nail plate. They are caused by temporary disruption in the growth of proximal nail matrix. Trauma is usually the initiating factor such as infections, severe medical illnesses, major surgery/anesthesia, medication side effects, and autoimmune disease."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Beau lines"^^<http://example.org/invalidDatatype>,
        "Ladder nail"^^<http://example.org/invalidDatatype>,
        "Ladder nail sign" ;
    ns1:synonym "Beau lines"^^<http://example.org/invalidDatatype>,
        "Ladder nail"^^<http://example.org/invalidDatatype>,
        "Ladder nail sign"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0045026> rdfs:label "Abnormal mediastinum morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the central compartment of the thoracic cavity." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the mediastinum"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of the mediastinum"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022395"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0045054> rdfs:label "Brachial plexus neuropathy"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0700251"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:3548001" .

<http://purl.obolibrary.org/obo/HP_0045082> rdfs:label "Decreased body mass index"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally decreased weight-to-height squared ratio, calculated by dividing the individual's weight in kilograms by the square of the individual's height in meters and used as an indicator of underweight compared to averages."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased BMI"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased BMI"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0046504> rdfs:label "Decreased libido" ;
    dcterms:description "Decreased sexual desire."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0046505> rdfs:label "Hand pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort localized to the hand." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0100009> rdfs:label "Intracranial meningioma"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:302820008",
        "UMLS:C0349604" .

<http://purl.obolibrary.org/obo/HP_0100020> rdfs:label "Posterior capsular cataract" ;
    dcterms:description "A cataract which is found in the back outer layer of the lens. This type often develops more rapidly." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022388" .

<http://purl.obolibrary.org/obo/HP_0100028> rdfs:label "Ectopic thyroid" ;
    dcterms:description "Mislocalised thyroid gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aberrant thyroid"^^<http://example.org/invalidDatatype>,
        "Heteropic thyroid gland"^^<http://example.org/invalidDatatype>,
        "Aberrant thyroid gland",
        "Abnormal thyroid location",
        "Ectopic thyroid gland" ;
    ns1:synonym "Aberrant thyroid gland"^^<http://example.org/invalidDatatype>,
        "Heteropic thyroid gland"^^<http://example.org/invalidDatatype>,
        "Aberrant thyroid",
        "Abnormal thyroid location",
        "Ectopic thyroid gland" ;
    ns1:xref "SNOMEDCT_US:214660000",
        "UMLS:C0266283" .

<http://purl.obolibrary.org/obo/HP_0100267> rdfs:label "Lip pit"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A depression located on a lip." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0341059" .

<http://purl.obolibrary.org/obo/HP_0100287> rdfs:label "EMG: slow motor conduction" ;
    dcterms:description "The presence of reduced conduction velocity of motor nerves on electromyography." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022167" .

