        "icd11.foundation:1601555981" .

<http://purl.obolibrary.org/obo/MONDO_0016454> rdfs:label "Charcot-Marie-Tooth disease type 2B5" ;
    dcterms:description "A rare axonal hereditary motor and sensory neuropathy characterized by infantile onset of slowly progressive distal motor weakness and atrophy (more severe in legs and moderate in arms) with mildly delayed motor development, hypotonia, and distal sensory impairment of all sensory modalities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
