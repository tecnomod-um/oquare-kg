        <http://purl.obolibrary.org/obo/HP_0009027>,
        <http://purl.obolibrary.org/obo/HP_0009130>,
        <http://purl.obolibrary.org/obo/HP_0030237> ;
    ns1:related_synonym "Charcot-Marie-Tooth disease, axonal, type 2U"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "CMT2U"^^<http://example.org/invalidDatatype>,
