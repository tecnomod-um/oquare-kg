    ns1:synonym "Reduced amplitude of dark-adapted bright flash electroretinogram b-wave"^^<http://example.org/invalidDatatype>,
        "Reduced electroretinogram rod b-wave"^^<http://example.org/invalidDatatype>,
        "Electronegative ERG",
        "Electroretinogram: reduced b-wave amplitude",
        "Reduced ERG amplitude of b-wave" ;
    ns1:xref "UMLS:C4021561" .

