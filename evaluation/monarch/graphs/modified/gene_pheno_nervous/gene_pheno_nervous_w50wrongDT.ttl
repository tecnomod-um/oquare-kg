<http://purl.obolibrary.org/obo/HP_0009183> rdfs:label "Joint contracture of the 5th finger" ;
    dcterms:description "Chronic loss of joint motion in the 5th finger due to structural changes in non-bony tissue. The term camptodactyly of the 5th finger is used if the distal and/or proximal interphalangeal joints are affected."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "5th finger camptodactyly"^^<http://example.org/invalidDatatype>,
        "Fifth finger camptodactyly"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "5th finger camptodactyly"^^<http://example.org/invalidDatatype>,
        "Fifth finger camptodactyly"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1865702"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0009594> rdfs:label "Retinal hamartoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A hamartoma (a benign, focal malformation consisting of a disorganized mixture of cells and tissues) of the retina." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1863411"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0009729> rdfs:label "Cardiac rhabdomyoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A benign tumor of cardiac striated muscle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1332852"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0009733> rdfs:label "Glioma" ;
    dcterms:description "The presence of a glioma, which is a neoplasm of the central nervous system originating from a glial cell (astrocytes or oligodendrocytes)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3059"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:393564001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0017638"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:115240006",
        "SNOMEDCT_US:74532006" .

<http://purl.obolibrary.org/obo/HP_0009771> rdfs:label "Osteolytic defects of the phalanges of the hand" ;
    dcterms:description "Dissolution or degeneration of bone tissue of the phalanges of the hand."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Acro-osteolysis"^^<http://example.org/invalidDatatype>,
        "Acroosteolysis"^^<http://example.org/invalidDatatype>,
        "Breakdown of small bones of fingers"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Acro-osteolysis",
        "Acroosteolysis",
        "Breakdown of small bones of fingers" ;
    ns1:xref "UMLS:C0917990"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:27201004",
        "SNOMEDCT_US:63122002" .

<http://purl.obolibrary.org/obo/HP_0009792> rdfs:label "Teratoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a teratoma." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3403"^^<http://example.org/invalidDatatype>,
        "UMLS:C0039538"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:55818009" .

<http://purl.obolibrary.org/obo/HP_0009794> rdfs:label "Branchial anomaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Congenital developmental defect arising from the primitive branchial apparatus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of branchial arch"^^<http://example.org/invalidDatatype>,
        "Branchial abnormality"^^<http://example.org/invalidDatatype>,
        "Branchial anomalies"^^<http://example.org/invalidDatatype>,
        "Abnormality of branchial apparatus" ;
    ns1:synonym "Abnormality of branchial arch"^^<http://example.org/invalidDatatype>,
        "Abnormality of branchial apparatus",
        "Branchial abnormality",
        "Branchial anomalies" ;
    ns1:xref "UMLS:C1862066"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0009888> rdfs:label "Abnormality of secondary sexual hair" ;
    dcterms:description "Abnormality of the growth of secondary sexual hair, which normally ensues during puberty. In males, secondary sexual hair usually comprises body hair, including underarm, abdominal, chest, and pubic hair. In females, secondary sexual hair usually comprises a lesser degree of body hair, most prominently underarm and pubic hair." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of secondary sexual hair" ;
    ns1:synonym "Abnormality of secondary sexual hair"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4024171" .

<http://purl.obolibrary.org/obo/HP_0009917> rdfs:label "Persistent pupillary membrane" ;
    dcterms:description "The presence of remnants of a fetal membrane that persist as strands of tissue crossing the pupil."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:95500008",
        "UMLS:C0344541" .

<http://purl.obolibrary.org/obo/HP_0010059> rdfs:label "Broad hallux phalanx"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in width in one or more phalanges of the big toe."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad phalanges of the hallux"^^<http://example.org/invalidDatatype>,
        "Wide bone of big toe"^^<http://example.org/invalidDatatype>,
        "Broad bone of big toe" ;
    ns1:synonym "Broad bone of big toe"^^<http://example.org/invalidDatatype>,
        "Wide bone of big toe"^^<http://example.org/invalidDatatype>,
        "Broad phalanges of the hallux" ;
    ns1:xref "UMLS:C4021343" .

<http://purl.obolibrary.org/obo/HP_0010301> rdfs:label "Spinal dysraphism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A heterogeneous group of congenital spinal anomalies that result from defective closure of the neural tube early in fetal life."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Incomplete closure of the vertebral arch" ;
    ns1:synonym "Incomplete closure of the vertebral arch" ;
    ns1:xref "SNOMEDCT_US:253098009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0027794"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010499> rdfs:label "Patellar subluxation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The kneecap normally is located within the groove termed trochlea on the distal femur and can slide up and down in it. Patellar subluxation refers to an unstable kneecap that does not slide centrally within its groove, i.e., a partial dislocation of the patella." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial knee cap dislocation"^^<http://example.org/invalidDatatype>,
        "Subluxation of patella"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Partial knee cap dislocation"^^<http://example.org/invalidDatatype>,
        "Subluxation of patella" ;
    ns1:xref "UMLS:C0857276" .

<http://purl.obolibrary.org/obo/HP_0010508> rdfs:label "Metatarsus valgus" ;
    dcterms:description "A condition in which the anterior part of the foot rotates outward away from the midline of the body and the heel remains straight." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4082144"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010615> rdfs:label "Angiofibromas"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Angiofibroma consist of many often dilated vessels." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3799"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:302857002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:60392001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0206731" .

<http://purl.obolibrary.org/obo/HP_0010626> rdfs:label "Anterior pituitary agenesis" ;
    dcterms:description "Absence of the anterior pituitary gland resulting from a developmental defect." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent pituitary gland"^^<http://example.org/invalidDatatype>,
        "Aplasia of the pituitary gland"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Absent pituitary gland"^^<http://example.org/invalidDatatype>,
        "Aplasia of the pituitary gland" ;
    ns1:xref "UMLS:C4021249"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010662> rdfs:label "Abnormal diencephalon morphology" ;
    dcterms:description "An abnormality of the Diencephalon, which together with the cerebrum (telencephalon) makes up the forebrain."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the diencephalon" ;
    ns1:synonym "Abnormality of the diencephalon"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023752"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010751> rdfs:label "Dimple chin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A persistent midline depression of the skin over the fat pad of the chin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chin butt"^^<http://example.org/invalidDatatype>,
        "Chin dent"^^<http://example.org/invalidDatatype>,
        "Chin skin dimple"^^<http://example.org/invalidDatatype>,
        "Dimple chin"^^<http://example.org/invalidDatatype>,
        "Chin dimple",
        "Gelasin of chin",
        "Indentation of chin" ;
    ns1:related_synonym "Chin dimples"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Chin butt"^^<http://example.org/invalidDatatype>,
        "Chin dent"^^<http://example.org/invalidDatatype>,
        "Chin dimple"^^<http://example.org/invalidDatatype>,
        "Chin dimples"^^<http://example.org/invalidDatatype>,
        "Gelasin of chin"^^<http://example.org/invalidDatatype>,
        "Indentation of chin"^^<http://example.org/invalidDatatype>,
        "Chin skin dimple",
        "Dimple chin" ;
    ns1:xref "UMLS:C1849227"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010832> rdfs:label "Abnormality of pain sensation" ;
    dcterms:description "Pain is an unpleasant sensation that can range from mild, localized discomfort to agony, whereby the physical part of pain results from nerve stimulation and is often accompanied by an emotional component. This term groups abnormalities in pain sensation presumed to result from abnormalities related to the specific nerve fibers that carry the pain impulses to the brain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023691" .

<http://purl.obolibrary.org/obo/HP_0010833> rdfs:label "Spontaneous pain sensation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Spontaneous pain is a kind of neuropathic pain which occurs without an identifiable trigger."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023690"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010843> rdfs:label "EEG with focal slow activity" ;
    dcterms:description "Focal (localized) slow activity reflects focal dysfunction, not diffuse dysfunction (i.e., encephalopathy)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EEG: localised slow activity"^^<http://example.org/invalidDatatype>,
        "EEG: localized slow activity"^^<http://example.org/invalidDatatype>,
        "EEG: focal slow activity" ;
    ns1:synonym "EEG: focal slow activity"^^<http://example.org/invalidDatatype>,
        "EEG: localised slow activity"^^<http://example.org/invalidDatatype>,
        "EEG: localized slow activity"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021218"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010849> rdfs:label "EEG with spike-wave complexes (>3.5 Hz)" ;
    dcterms:description "The presence of complexes of spikes and waves (>3.5 Hz) in electroencephalography (EEG)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "EEG with 3-4-Hz spike waves"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "EEG with 3-4-Hz spike waves" ;
    ns1:xref "UMLS:C4020765"^^<http://example.org/invalidDatatype>,
        "UMLS:C4023684" .

<http://purl.obolibrary.org/obo/HP_0010863> rdfs:label "Receptive language delay" ;
    dcterms:description "A delay in the acquisition of the ability to understand the speech of others." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:229736005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0454642"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010946> rdfs:label "Dilatation of the renal pelvis" ;
    dcterms:description "The presence of dilatation of the renal pelvis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1868864" .

<http://purl.obolibrary.org/obo/HP_0010952> rdfs:label "Mild fetal ventriculomegaly" ;
    dcterms:description "A kind of ventriculomegaly occurring in the fetal period and usually diagnosed by prenatal ultrasound. Cerebral ventriculomegaly is defined by atrial measurements 10 mm or more. Mild ventriculomegaly (MVM) is defined as measurements between 10 and 15 mm. Measurements are obtained from an axial plane at the level of the thalamic nuclei just below the standard image to measure the BPD (PMID:16100637)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mild foetal ventriculomegaly" ;
    ns1:synonym "Mild foetal ventriculomegaly" ;
    ns1:xref "UMLS:C4023628" .

<http://purl.obolibrary.org/obo/HP_0010978> rdfs:label "Abnormality of immune system physiology" ;
    dcterms:description "A functional abnormality of the immune system."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023616" .

<http://purl.obolibrary.org/obo/HP_0011087> rdfs:label "Talon cusp" ;
    dcterms:description "Talon cusp is an accessory cusp located near the cingulum (the portion of the lingual or palatal aspect of the tooth that forms a convex protuberance at the cervical third of the anatomic crown)."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Extra cusp on inside of front tooth"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Talon cusps"^^<http://example.org/invalidDatatype>,
        "Dens evaginatus" ;
    ns1:synonym "Dens evaginatus"^^<http://example.org/invalidDatatype>,
        "Extra cusp on inside of front tooth"^^<http://example.org/invalidDatatype>,
        "Talon cusps" ;
    ns1:xref "UMLS:C4280335"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:234955005",
        "SNOMEDCT_US:63691004",
        "UMLS:C0266034",
        "UMLS:C0399357" .

<http://purl.obolibrary.org/obo/HP_0011099> rdfs:label "Spastic hemiparesis" ;
    dcterms:description "Unilateral paresis (weakness) with spasticity of the affected muscles and increased tendon reflexes." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spastic hemiplegia" ;
    ns1:synonym "Spastic hemiplegia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0154694"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:79633009" .

<http://purl.obolibrary.org/obo/HP_0011120> rdfs:label "Concave nasal ridge"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Nasal ridge curving posteriorly to an imaginary line that connects the nasal root and tip."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Boxer's nasal deformity"^^<http://example.org/invalidDatatype>,
        "Boxer's nose deformity"^^<http://example.org/invalidDatatype>,
        "Concave nasal dorsum"^^<http://example.org/invalidDatatype>,
        "Concave dorsum of nose",
        "Saddle nose",
        "Saddle shaped nasal dorsum",
        "Ski jump nose" ;
    ns1:related_synonym "Saddle nose deformity" ;
    ns1:synonym "Boxer's nose deformity"^^<http://example.org/invalidDatatype>,
        "Concave dorsum of nose"^^<http://example.org/invalidDatatype>,
        "Concave nasal dorsum"^^<http://example.org/invalidDatatype>,
        "Saddle shaped nasal dorsum"^^<http://example.org/invalidDatatype>,
        "Boxer's nasal deformity",
        "Saddle nose",
        "Saddle nose deformity",
        "Ski jump nose" ;
    ns1:xref "SNOMEDCT_US:710234009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0264169"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011151> rdfs:label "Atypical absence status epilepticus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atypical absence status epilepticus is a type of generalized non-convulsive status epilepticus without coma that is semiologically a prolonged atypical absence seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Obtundation status" ;
    ns1:synonym "Obtundation status"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023511"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011157> rdfs:label "Focal sensory seizure" ;
    dcterms:description "A focal sensory seizure is a type seizure beginning with a subjective sensation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal sensory seizures"^^<http://example.org/invalidDatatype>,
        "Partial sensory seizure"^^<http://example.org/invalidDatatype>,
        "Sensory aura" ;
    ns1:synonym "Focal sensory seizures"^^<http://example.org/invalidDatatype>,
        "Sensory aura"^^<http://example.org/invalidDatatype>,
        "Partial sensory seizure" ;
    ns1:xref "SNOMEDCT_US:18618006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0236018" .

<http://purl.obolibrary.org/obo/HP_0011195> rdfs:label "EEG with focal sharp slow waves"^^<http://example.org/invalidDatatype> ;
    dcterms:description "EEG with focal sharp transient waves of a duration between 80 and 200 msec followed by a slow wave."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023479"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011302> rdfs:label "Long palm" ;
    dcterms:description "For children from birth to 16 years of age the length of the palm is more than the 97th centile; or, the length of the palm appears relatively long compared to the finger length or the limb length." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Long palm" ;
    ns1:synonym "Long palm"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023422"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011335> rdfs:label "Frontal hirsutism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excessive amount of hair growth on forehead." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hairy forehead"^^<http://example.org/invalidDatatype>,
        "Hirsute forehead" ;
    ns1:synonym "Hairy forehead",
        "Hirsute forehead" ;
    ns1:xref "UMLS:C1839830"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011362> rdfs:label "Abnormal hair quantity" ;
    dcterms:description "An abnormal amount of hair."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal hair quantity"^^<http://example.org/invalidDatatype>,
        "Abnormality of hair density" ;
    ns1:synonym "Abnormal hair quantity",
        "Abnormality of hair density" ;
    ns1:xref "UMLS:C4023397"^^<http://example.org/invalidDatatype>,
        "UMLS:C4023401" .

<http://purl.obolibrary.org/obo/HP_0011380> rdfs:label "Abnormal semicircular canal morphology" ;
    dcterms:description "An abnormality of the morphology of the semicircular canal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Morphological abnormality of the semicircular canal" ;
    ns1:synonym "Morphological abnormality of the semicircular canal" ;
    ns1:xref "UMLS:C4023386" .

<http://purl.obolibrary.org/obo/HP_0011441> rdfs:label "Abnormal medulla oblongata morphology" ;
    dcterms:description "An abnormality of the medulla oblongata, the lower half of the brainstem." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the medulla oblongata"^^<http://example.org/invalidDatatype>,
        "Abnormality of the myencephalon" ;
    ns1:synonym "Abnormality of the medulla oblongata"^^<http://example.org/invalidDatatype>,
        "Abnormality of the myencephalon" ;
    ns1:xref "UMLS:C4021148" .

<http://purl.obolibrary.org/obo/HP_0011516> rdfs:label "Achromatopsia" ;
    dcterms:description "A condition where the retina contains no functional cone cells, so that in addition to the absence of color discrimination, vision in lights of normal intensity is difficult." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Rod monochromacy",
        "Rod monochromatism" ;
    ns1:synonym "Rod monochromatism"^^<http://example.org/invalidDatatype>,
        "Rod monochromacy" ;
    ns1:xref "UMLS:C0302129"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:102450007" .

<http://purl.obolibrary.org/obo/HP_0011803> rdfs:label "Bifid nose"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Visually assessable vertical indentation, cleft, or depression of the nasal bridge, ridge and tip." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bifid nasal bridge"^^<http://example.org/invalidDatatype>,
        "Indentation or clefting of the nose" ;
    ns1:related_synonym "Cleft nose"^^<http://example.org/invalidDatatype>,
        "Indented bridge of nose"^^<http://example.org/invalidDatatype>,
        "Cleft nasal bridge" ;
    ns1:synonym "Bifid nasal bridge"^^<http://example.org/invalidDatatype>,
        "Cleft nasal bridge"^^<http://example.org/invalidDatatype>,
        "Cleft nose"^^<http://example.org/invalidDatatype>,
        "Indented bridge of nose"^^<http://example.org/invalidDatatype>,
        "Indentation or clefting of the nose" ;
    ns1:xref "UMLS:C4280318"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:204521002",
        "UMLS:C0221363",
        "UMLS:C4280319" .

<http://purl.obolibrary.org/obo/HP_0011886> rdfs:label "Hyphema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bleeding in the anterior chamber of the eye."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:75229002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0020581"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011931> rdfs:label "Abnormal cerebellar peduncle morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of the cerebellar peduncles. The superior, middle, and inferior cerebellar peduncles emerge from the cerebellum. The superior cerebellar penduncles connect the cerebellum to the midbrain, the middle cerebellar peduncles connect the cerebellum to the pons, and the inferior cerebellar peduncle connects the medulla spinalis and medulla oblongata with the cerebellum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the cerebellar peduncle" ;
    ns1:synonym "Abnormality of the cerebellar peduncle"^^<http://example.org/invalidDatatype> ;
