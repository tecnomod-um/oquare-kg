<http://purl.obolibrary.org/obo/HP_0009129> rdfs:label "Upper limb amyotrophy" ;
    dcterms:description "Muscular atrophy involving the muscles of the upper limbs." ;
    ns1:category ns1:PhenotypicFeature ;
