<http://purl.obolibrary.org/obo/MONDO_0001835> rdfs:label "facial paralysis" ;
    dcterms:description "Severe or complete loss of facial muscle motor function. This condition may result from central or peripheral lesions. Damage to CNS motor pathways from the cerebral cortex to the facial nuclei in the pons leads to facial weakness that generally spares the forehead muscles. facial nerve diseases generally results in generalized hemifacial weakness. neuromuscular junction diseases and muscular diseases may also cause facial paralysis or paresis." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "face palsy",
        "palsy of face" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0000297> ;
    ns1:synonym "face palsy"^^<http://example.org/invalidDatatype>,
        "palsy of face"^^<http://example.org/invalidDatatype> ;
