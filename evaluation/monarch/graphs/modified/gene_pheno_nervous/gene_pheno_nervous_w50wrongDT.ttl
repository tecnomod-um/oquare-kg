<http://purl.obolibrary.org/obo/HP_0009049> rdfs:label "Peroneal muscle atrophy" ;
    dcterms:description "Atrophy of the peroneous muscles, peroneus longus (also known as Fibularis longus), Peroneus brevis (also known as fibularis brevis, and Peroneus tertius (also known as fibularis tertius)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Peroneal atrophy"^^<http://example.org/invalidDatatype> ;
