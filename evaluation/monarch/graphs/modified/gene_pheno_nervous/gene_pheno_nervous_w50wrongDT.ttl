<http://purl.obolibrary.org/obo/HP_0000243> rdfs:label "Trigonocephaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Wedge-shaped, or triangular head, with the apex of the triangle at the midline of the forehead and the base of the triangle at the occiput." ;
    ns1:broad_synonym "Triangular head shape"^^<http://example.org/invalidDatatype>,
        "Wedge shaped head"^^<http://example.org/invalidDatatype> ;
