    ns1:xref "UMLS:C4022420" .

<http://purl.obolibrary.org/obo/HP_0040135> rdfs:label "Abnormal transferrin saturation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any abnormality in the serum transferrin saturation, which is calculated by dividing the serum iron level by total iron-binding capacity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022419" .

<http://purl.obolibrary.org/obo/HP_0040137> rdfs:label "Comedonal acne"^^<http://example.org/invalidDatatype> ;
