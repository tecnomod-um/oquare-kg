<http://purl.obolibrary.org/obo/HP_0100274> rdfs:label "Gustatory lacrimation" ;
    dcterms:description "Gustatory lacrimation results from an aberrant innervation of fibers from the seventh cranial nerve to the pterygopalatine ganglion which are destined originally for the submandibular ganglion. This aberrant innervation leads to uncontrollable tearing while eating or in anticipation of a meal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1862052" .

<http://purl.obolibrary.org/obo/HP_0100277> rdfs:label "Periauricular skin pits" ;
