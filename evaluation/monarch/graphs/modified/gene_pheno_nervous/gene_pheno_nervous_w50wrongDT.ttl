<http://purl.obolibrary.org/obo/HP_0001133> rdfs:label "Constriction of peripheral visual field" ;
    dcterms:description "An absolute or relative decrease in retinal sensitivity extending from edge (periphery) of the visual field in a concentric pattern. The visual field is the area that is perceived simultaneously by a fixating eye." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Concentric narrowing of visual field"^^<http://example.org/invalidDatatype>,
