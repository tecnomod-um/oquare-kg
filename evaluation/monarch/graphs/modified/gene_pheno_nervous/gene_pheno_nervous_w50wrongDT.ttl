        "SNOMEDCT_US:78894008" .

<http://purl.obolibrary.org/obo/HP_0001493> rdfs:label "Falciform retinal fold"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An area of the retina that is buckled so that a sector-shaped sheet of retina lies in front of the normal retina. This feature is of congenital onset." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Congenital retinal fold"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Congenital retinal fold" ;
    ns1:xref "SNOMEDCT_US:204181009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0344550" .

<http://purl.obolibrary.org/obo/HP_0001519> rdfs:label "Disproportionate tall stature"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A tall and slim body build with increased arm span to height ratio (>1.05) and a reduced upper-to-lower segment ratio (<0.85), i.e., unusually long arms and legs. The extremities as well as the hands and feet are unusually slim." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dolichostenomelia",
        "Marfanoid body habitus",
        "Marfanoid habitus",
        "Reduced upper-lower segment ratio" ;
    ns1:synonym "Dolichostenomelia"^^<http://example.org/invalidDatatype>,
        "Marfanoid body habitus"^^<http://example.org/invalidDatatype>,
        "Marfanoid habitus",
        "Reduced upper-lower segment ratio" ;
    ns1:xref "UMLS:C1836996"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:62250003",
        "UMLS:C0003706" .

<http://purl.obolibrary.org/obo/HP_0001539> rdfs:label "Omphalocele" ;
    dcterms:description "A midline anterior incomplete closure of the abdominal wall in which there is herniation of the abdominal viscera into the base of the abdominal cord."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Exomphalos"^^<http://example.org/invalidDatatype>,
        "Omphalocoele" ;
    ns1:synonym "Omphalocoele"^^<http://example.org/invalidDatatype>,
        "Exomphalos" ;
    ns1:xref "MEDDRA:10030309"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:18735004"^^<http://example.org/invalidDatatype>,
        "Fyler:4404",
        "UMLS:C0795690" .

<http://purl.obolibrary.org/obo/HP_0001667> rdfs:label "Right ventricular hypertrophy" ;
    dcterms:description "In this case the right ventricle is more muscular than normal, causing a characteristic boot-shaped (coeur-en-sabot) appearance as seen on anterior- posterior chest x-rays. Right ventricular hypertrophy is commonly associated with any form of right ventricular outflow obstruction or pulmonary hypertension, which may in turn owe its origin to left-sided disease. The echocardiographic signs are thickening of the anterior right ventricular wall and the septum. Cavity size is usually normal, or slightly enlarged. In many cases there is associated volume overload present due to tricuspid regurgitation, in the absence of this, septal motion is normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Heart right ventricle hypertrophy" ;
    ns1:synonym "Heart right ventricle hypertrophy"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:89792004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0162770"^^<http://example.org/invalidDatatype>,
        "Fyler:3609" .

<http://purl.obolibrary.org/obo/HP_0001696> rdfs:label "Situs inversus totalis" ;
    dcterms:description "A left-right reversal (or mirror reflection) of the anatomical location of the major thoracic and abdominal organs."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "All organs on wrong side of body"^^<http://example.org/invalidDatatype>,
        "situs oppositus"^^<http://example.org/invalidDatatype>,
        "situs transversus"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Situs inversus" ;
    ns1:synonym "Situs inversus"^^<http://example.org/invalidDatatype>,
        "All organs on wrong side of body",
        "situs oppositus",
        "situs transversus" ;
    ns1:xref "Fyler:100"^^<http://example.org/invalidDatatype>,
        "Fyler:0100",
        "SNOMEDCT_US:14821001",
        "SNOMEDCT_US:24614000",
        "SNOMEDCT_US:27317008",
        "SNOMEDCT_US:43876007",
        "UMLS:C0037221",
        "UMLS:C0266642" .

<http://purl.obolibrary.org/obo/HP_0001698> rdfs:label "Pericardial effusion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Accumulation of fluid within the pericardium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fluid around heart"^^<http://example.org/invalidDatatype>,
        "Pericardial effusions" ;
    ns1:synonym "Fluid around heart"^^<http://example.org/invalidDatatype>,
        "Pericardial effusions"^^<http://example.org/invalidDatatype> ;
