        "UMLS:C4022484" .

<http://purl.obolibrary.org/obo/HP_0040031> rdfs:label "Chorioretinal hyperpigmentation"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022482"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040036> rdfs:label "Onychogryphosis of fingernail" ;
    dcterms:description "Thickened fingernails." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Overgrowth and curving of fingernail" ;
    ns1:synonym "Overgrowth and curving of fingernail" ;
    ns1:xref "UMLS:C4022477"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040069> rdfs:label "Abnormal lower limb bone morphology"^^<http://example.org/invalidDatatype> ;
