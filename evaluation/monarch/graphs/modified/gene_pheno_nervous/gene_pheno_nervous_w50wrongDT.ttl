<http://purl.obolibrary.org/obo/HP_0008523> rdfs:label "Posterior helix pit"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Permanent indentation on the posteromedial aspect of the helix that may be sharply or indistinctly delineated."^^<http://example.org/invalidDatatype> ;
