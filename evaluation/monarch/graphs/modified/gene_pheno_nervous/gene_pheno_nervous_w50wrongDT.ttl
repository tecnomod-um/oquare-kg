        "Missing part of vertebrae" ;
    ns1:xref "UMLS:C0265677"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:68359008" .

<http://purl.obolibrary.org/obo/HP_0002983> rdfs:label "Micromelia" ;
    dcterms:description "The presence of abnormally small extremities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Smaller or shorter than typical limbs" ;
    ns1:synonym "Smaller or shorter than typical limbs"^^<http://example.org/invalidDatatype> ;
    ns1:xref "MEDDRA:10027546"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:74370006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0025995" .

<http://purl.obolibrary.org/obo/HP_0003134> rdfs:label "Abnormality of peripheral nerve conduction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the conduction of electrical impulses by peripheral (motor or sensory) nerves. This finding is elicited by a nerve conduction study (NCS)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Sensory and motor nerve conduction abnormalities" ;
    ns1:related_synonym "Abnormal peripheral nerve transmission"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal peripheral nerve transmission",
        "Sensory and motor nerve conduction abnormalities" ;
    ns1:xref "UMLS:C4020690"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003737> rdfs:label "Mitochondrial myopathy" ;
    dcterms:description "A type of myopathy associated with mitochondrial disease and characterized by findings on biopsy such as ragged red muscle fibers."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:16851005",
        "UMLS:C0162670" .

<http://purl.obolibrary.org/obo/HP_0004422> rdfs:label "Biparietal narrowing"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A narrowing of the biparietal diameter (i.e., of the transverse distance between the protuberances of the two parietal bones of the skull)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Decreased width of the skull"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased width of the skull"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1854418",
        "UMLS:C4280532" .

<http://purl.obolibrary.org/obo/HP_0007068> rdfs:label "Inferior cerebellar vermis hypoplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Underdevelopment of the inferior portion of the vermis of cerebellum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplasia of inferior vermis"^^<http://example.org/invalidDatatype>,
        "Inferior vermis hypoplasia" ;
    ns1:synonym "Inferior vermis hypoplasia"^^<http://example.org/invalidDatatype>,
        "Hypoplasia of inferior vermis" ;
    ns1:xref "UMLS:C1855350" .

<http://purl.obolibrary.org/obo/HP_0007301> rdfs:label "Oromotor apraxia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Oral-motor apraxia is the inability to volitionally sequence oral movements of the speech structure for nonspeech tasks in the absence of neuromuscular deficits such as paralysis or muscle weakness. Oral-motor apraxia is diagnosed when, despite intact sensory motor function an individual is unable to use these effector systems under voluntary control." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Oral-motor apraxia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Oral-motor apraxia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021845" .

<http://purl.obolibrary.org/obo/HP_0007351> rdfs:label "Upper limb postural tremor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of tremors that is triggered by holding an arm in a fixed position." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Postural tremor of arms" ;
    ns1:synonym "Postural tremor of arms" ;
    ns1:xref "UMLS:C1867138" .

<http://purl.obolibrary.org/obo/HP_0007377> rdfs:label "Abnormality of somatosensory evoked potentials"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of somatosensory evoked potentials (SSEP), i.e., of the electrical signals of sensation going from the body to the brain in response to a defined stimulus. Recording electrodes are placed over the scalp, spine, and peripheral nerves proximal to the stimulation site. Clinical studies generally use electrical stimulation of peripheral nerves to elicit potentials. SSEP testing determines whether peripheral sensory nerves are able to transmit sensory information like pain, temperature, and touch to the brain. Abnormal SSEPs can result from dysfunction at the level of the peripheral nerve, plexus, spinal root, spinal cord, brain stem, thalamocortical projections, or primary somatosensory cortex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of SSEPs" ;
    ns1:synonym "Abnormality of SSEPs" ;
    ns1:xref "UMLS:C4021577" .

<http://purl.obolibrary.org/obo/HP_0007598> rdfs:label "Bilateral single transverse palmar creases"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The distal and proximal transverse palmar creases are merged into a single transverse palmar crease on both hands." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1862095"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007688> rdfs:label "Undetectable light- and dark-adapted electroretinogram"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of the combined rod-and-cone response on electroretinogram." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent cone and rod functions by electroretinogram"^^<http://example.org/invalidDatatype>,
        "Absent rod-and cone-mediated responses on ERG" ;
    ns1:synonym "Absent cone and rod functions by electroretinogram"^^<http://example.org/invalidDatatype>,
        "Absent rod-and cone-mediated responses on ERG" ;
    ns1:xref "UMLS:C4021570" .

<http://purl.obolibrary.org/obo/HP_0007773> rdfs:label "Vitreoretinopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Ocular abnormality characterized by premature degeneration of the vitreous and the retina that may be associated with increased risk of retinal detachment."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Vitreoretinal abnormality"^^<http://example.org/invalidDatatype>,
