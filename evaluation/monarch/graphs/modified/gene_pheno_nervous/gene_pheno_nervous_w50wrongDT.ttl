    ns1:synonym "Extra-axial CSF accumulation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022871"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012708> rdfs:label "Reduced brain N-acetyl aspartate level by MRS"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A decrease in the level of N-acetyl aspartate in the brain identified by magnetic resonance spectroscopy (MRS)." ;
