        "Legg-Calve-Perthes syndrome"^^<http://example.org/invalidDatatype>,
        "Legg-Perthes disease",
        "Morbus Legg-Calve-Perthes" ;
    ns1:synonym "Coxa plana"^^<http://example.org/invalidDatatype>,
        "Legg-Perthes disease"^^<http://example.org/invalidDatatype>,
        "Morbus Legg-Calve-Perthes"^^<http://example.org/invalidDatatype>,
        "Osteochondrosis of the femoral head"^^<http://example.org/invalidDatatype>,
        "Osteonecrosis of the femoral head"^^<http://example.org/invalidDatatype>,
        "Legg-Calve-Perthes syndrome",
        "Perthes-like femoral head changes" ;
