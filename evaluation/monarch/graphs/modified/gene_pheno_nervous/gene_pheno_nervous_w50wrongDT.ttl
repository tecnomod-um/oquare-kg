<http://purl.obolibrary.org/obo/HP_0030497> rdfs:label "Macular cotton wool spot"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fluffy white patch in the macula, representing localized areas of dense white swelling of the retinal nerve fiber layer."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072985"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030498> rdfs:label "Macular thickening"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal increase in retinal thickness in the macular area observed on fundoscopy or fundus imaging."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072986" .

<http://purl.obolibrary.org/obo/HP_0030503> rdfs:label "Macular telangiectasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Localized irregular dilatation of small tortuous intraretinal blood vessels in the macular area." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Parafoveal telangiectasia"^^<http://example.org/invalidDatatype>,
