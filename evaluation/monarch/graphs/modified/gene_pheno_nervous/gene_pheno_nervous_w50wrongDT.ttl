<http://purl.obolibrary.org/obo/HP_0040198> rdfs:label "Non-medullary thyroid carcinoma" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nonmedullary thyroid carcinoma"^^<http://example.org/invalidDatatype>,
        "Thyroid cancer, nonmedullary"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Thyroid cancer, nonmedullary"^^<http://example.org/invalidDatatype>,
        "Nonmedullary thyroid carcinoma" ;
