<http://purl.obolibrary.org/obo/MONDO_0005015> rdfs:label "diabetes mellitus" ;
    dcterms:description "A metabolic disorder characterized by abnormally high blood sugar levels due to diminished production of insulin or insulin resistance/desensitization." ;
