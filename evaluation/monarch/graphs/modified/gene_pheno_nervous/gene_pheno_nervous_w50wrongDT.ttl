<http://purl.obolibrary.org/obo/HP_0000876> rdfs:label "Oligomenorrhea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Infrequent menses (less than 6 per year or more than 35 days between cycles)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Light or infrequent menstrual periods" ;
    ns1:synonym "Light or infrequent menstrual periods" ;
    ns1:xref "SNOMEDCT_US:52073004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0028949" .

<http://purl.obolibrary.org/obo/HP_0000926> rdfs:label "Platyspondyly" ;
    dcterms:description "A flattened vertebral body shape with reduced distance between the vertebral endplates." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flat vertebral bodies"^^<http://example.org/invalidDatatype>,
        "Flattened vertebral bodies"^^<http://example.org/invalidDatatype>,
        "Flattened vertebrae" ;
    ns1:synonym "Flat vertebral bodies",
        "Flattened vertebrae",
        "Flattened vertebral bodies" ;
    ns1:xref "UMLS:C1844704"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000965> rdfs:label "Cutis marmorata"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reticular discoloration of the skin with cyanotic (reddish-blue appearing) areas surrounding pale central areas due to dilation of capillary blood vessels and stagnation of blood within the vessels. Cutis marmorata generally occurs on the legs, arms and trunk and is often more severe in cold weather." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0263401"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001004> rdfs:label "Lymphedema" ;
    dcterms:description "Localized fluid retention and tissue swelling caused by a compromised lymphatic system." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lymphatic obstruction"^^<http://example.org/invalidDatatype>,
        "Lymphoedema",
        "Onset of lymphedema around puberty",
        "Swelling caused by excess lymph fluid under skin" ;
    ns1:synonym "Lymphatic obstruction"^^<http://example.org/invalidDatatype>,
        "Lymphoedema"^^<http://example.org/invalidDatatype>,
        "Onset of lymphedema around puberty",
        "Swelling caused by excess lymph fluid under skin" ;
    ns1:xref "SNOMEDCT_US:234097001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:30213001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0024236",
        "UMLS:C0240278",
        "UMLS:C1835229" .

<http://purl.obolibrary.org/obo/HP_0001067> rdfs:label "Neurofibroma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A benign peripheral nerve sheath tumor that generally appears as a soft, skin-colored papule or small subcutaneous nodule. Individuals with neurofibromatosis can have numerous neurofibromas." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neurofibromata"^^<http://example.org/invalidDatatype>,
        "Neurofibromatosis"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "multiple neurofibromas"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Neurofibromatosis"^^<http://example.org/invalidDatatype>,
        "multiple neurofibromas"^^<http://example.org/invalidDatatype>,
        "Neurofibromata" ;
    ns1:xref "SNOMEDCT_US:19133005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0162678"^^<http://example.org/invalidDatatype>,
        "NCIT:C3272",
        "SNOMEDCT_US:81669005" .

<http://purl.obolibrary.org/obo/HP_0001100> rdfs:label "Heterochromia iridis" ;
    dcterms:description "Heterochromia iridis is a difference in the color of the iris in the two eyes." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Different colored eyes"^^<http://example.org/invalidDatatype>,
        "Different coloured eyes",
