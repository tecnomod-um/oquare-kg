    ns1:synonym "Downturned corners of mouth"^^<http://example.org/invalidDatatype>,
        "Downturned corners of the mouth",
        "Downturned mouth",
        "Downturned oral commisures" ;
    ns1:xref "UMLS:C1866195" .

<http://purl.obolibrary.org/obo/HP_0025336> rdfs:label "Delayed ability to sit"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A failure to achieve the ability to sit at an appropriate developmental stage. Most children sit with support at 6 months of age and sit steadily without support at 9 months of age." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0000954> rdfs:label "Single transverse palmar crease" ;
    dcterms:description "The distal and proximal transverse palmar creases are merged into a single transverse palmar crease." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Simian crease"^^<http://example.org/invalidDatatype>,
        "Simian creases"^^<http://example.org/invalidDatatype>,
        "Simian line"^^<http://example.org/invalidDatatype>,
