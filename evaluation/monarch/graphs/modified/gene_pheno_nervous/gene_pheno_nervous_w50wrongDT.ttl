    ns1:synonym "Large central loss of field of vision" ;
    ns1:xref "UMLS:C4025800" .

<http://purl.obolibrary.org/obo/HP_0001139> rdfs:label "Chorioretinal scalloped atrophy" ;
    dcterms:description "Well-defined, pale patches in the fundus."^^<http://example.org/invalidDatatype> ;
