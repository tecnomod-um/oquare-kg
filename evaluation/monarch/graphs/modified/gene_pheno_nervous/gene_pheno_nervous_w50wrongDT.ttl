<http://purl.obolibrary.org/obo/HP_0002871> rdfs:label "Central apnea" ;
    dcterms:description "Apnea resulting from depression of the respiratory centers in the medulla oblongata. There is a lack of respiratory effort rather than obstruction of airflow."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Central apnoea"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Central apnoea" ;
    ns1:xref "UMLS:C0520680"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003189> rdfs:label "Long nose"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Distance from nasion to subnasale more than two standard deviations above the mean, or alternatively, an apparently increased length from the nasal root to the nasal base." ;
