    ns1:xref "UMLS:C0007194"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:233873004",
        "SNOMEDCT_US:45227007" .

<http://purl.obolibrary.org/obo/HP_0002415> rdfs:label "Leukodystrophy" ;
    dcterms:description "Leukodystrophy refers to deterioration of white matter of the brain resulting from degeneration of myelin sheaths in the CNS. Their basic defect is directly related to the synthesis and maintenance of myelin membranes. Symmetric white matter involvement at MRI is a typical finding in patients with leukodystrophies."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Degeneration of white matter of brain" ;
    ns1:synonym "Degeneration of white matter of brain"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:192781003"^^<http://example.org/invalidDatatype>,
