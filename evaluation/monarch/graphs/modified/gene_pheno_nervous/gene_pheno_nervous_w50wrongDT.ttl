        "Accessory nipple",
        "Accessory nipples",
        "Increased nipple number",
        "accessory mamillas" ;
    ns1:xref "SNOMEDCT_US:50956007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0266011"^^<http://example.org/invalidDatatype>,
        "Fyler:4234" .

<http://purl.obolibrary.org/obo/HP_0002673> rdfs:label "Coxa valga" ;
    dcterms:description "Coxa valga is a deformity of the hip in which the angle between the femoral shaft and the femoral neck is increased compared to age-adjusted values (about 150 degrees in newborns gradually reducing to 120-130 degrees in adults)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Valgus hip"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Coxa valga deformity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Coxa valga deformity"^^<http://example.org/invalidDatatype>,
        "Valgus hip" ;
    ns1:xref "SNOMEDCT_US:299236004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0239137",
        "UMLS:C3549698" .

<http://purl.obolibrary.org/obo/HP_0002757> rdfs:label "Recurrent fractures" ;
    dcterms:description "The repeated occurrence of bone fractures (implying an abnormally increased tendency for fracture)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
