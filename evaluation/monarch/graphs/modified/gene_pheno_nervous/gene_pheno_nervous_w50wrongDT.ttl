        "Methymalonicaciduria"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1855119"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012125> rdfs:label "Prostate cancer" ;
    dcterms:description "A cancer of the prostate." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Prostatic cancer"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Prostatic cancer"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0376358"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:399068003" .

<http://purl.obolibrary.org/obo/HP_0012167> rdfs:label "Hair-pulling"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A phenomenon in which persons repetitively pull out their own hair, resulting in noticeable hair loss." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Trichotillomania" ;
    ns1:synonym "Trichotillomania" ;
    ns1:xref "SNOMEDCT_US:17155009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0040953"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012174> rdfs:label "Glioblastoma multiforme" ;
    dcterms:description "A tumor arising from glia in the central nervous system with macroscopic regions of necrosis and hemorrhage. Microscopically, glioblastoma multiforme is characterized by regions of pseudopalisading necrosis, pleomorphic nuclei and cells, and microvascular proliferation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Glioblastoma" ;
    ns1:synonym "Glioblastoma"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:393563007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:63634009",
        "UMLS:C1621958" .

<http://purl.obolibrary.org/obo/HP_0012194> rdfs:label "Episodic hemiplegia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Transient episodes of weakness of the arm, leg, and in some cases the face on one side of the body." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1863061"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012226> rdfs:label "Ovarian teratoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a teratoma in the ovary."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3403"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:716077006",
        "UMLS:C0280131" .

<http://purl.obolibrary.org/obo/HP_0012241> rdfs:label "Levator palpebrae superioris atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atrophy of the levator palpebrae superioris, the extraocular muscle that elevates the superior eyelid." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1851107" .

<http://purl.obolibrary.org/obo/HP_0012287> rdfs:label "Hypothalamic luteinizing hormone-releasing hormone deficiency"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased secretion of luteinizing hormone-releasing hormone by the hypothalamus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022967" .

<http://purl.obolibrary.org/obo/HP_0012321> rdfs:label "D-2-hydroxyglutaric aciduria" ;
    dcterms:description "An increased concentration of 2-hydroxyglutaric acid in the urine." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1833429"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:237960000" .

<http://purl.obolibrary.org/obo/HP_0012343> rdfs:label "Decreased circulating ferritin concentration" ;
    dcterms:description "Abnormally reduced concentration of ferritin, a ubiquitous intracellular protein that stores iron, in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased plasma ferritin"^^<http://example.org/invalidDatatype>,
        "Low ferritin level"^^<http://example.org/invalidDatatype>,
        "Decreased serum ferritin",
        "Reduced serum ferritin" ;
    ns1:synonym "Decreased plasma ferritin"^^<http://example.org/invalidDatatype>,
        "Low ferritin level"^^<http://example.org/invalidDatatype>,
        "Decreased serum ferritin",
        "Reduced serum ferritin" ;
    ns1:xref "UMLS:C0241012" .

<http://purl.obolibrary.org/obo/HP_0012400> rdfs:label "Abnormal circulating aldolase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal concentration of aldolase in the serum. Aldolase is an enzyme responsible for converting fructose 1,6-bisphosphate into the triose phosphates dihydroxyacetone phosphate and glyceraldehyde 3-phosphate." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal aldolase level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal aldolase level" ;
    ns1:xref "UMLS:C4022916" .

<http://purl.obolibrary.org/obo/HP_0012427> rdfs:label "Increased femoral anteversion" ;
    dcterms:description "An increased degree of femoral version, which is defined as the angular difference between axis of femoral neck and transcondylar axis of the knee. Thus, femoral anteversion is an inward twisting of the femur that causes the knees and feet to turn inward." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Excessive femoral anteversion",
        "Increased femoral neck anteversion",
        "Internally rotated hips" ;
    ns1:synonym "Internally rotated hips"^^<http://example.org/invalidDatatype>,
        "Excessive femoral anteversion",
        "Increased femoral neck anteversion" ;
    ns1:xref "UMLS:C4022909"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012462> rdfs:label "Chin myoclonus" ;
    dcterms:description "Involuntary and irregular twitches of the chin." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Geniospasm"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Chin spasms"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Chin spasms",
        "Geniospasm" ;
    ns1:xref "UMLS:C1860972"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012465> rdfs:label "Elevated hepatic iron concentration" ;
    dcterms:description "An increased level of iron in liver tissues." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased iron concentration in liver"^^<http://example.org/invalidDatatype>,
        "Increased liver iron level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased iron concentration in liver"^^<http://example.org/invalidDatatype>,
        "Increased liver iron level"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022891" .

<http://purl.obolibrary.org/obo/HP_0012539> rdfs:label "Non-Hodgkin lymphoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of lymphoma characterized microscopically by the absence of multinucleated Reed-Sternberg cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:128929007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:188675007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:1929004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:118601006",
        "UMLS:C0024305" .

<http://purl.obolibrary.org/obo/HP_0012557> rdfs:label "EEG with centrotemporal focal spike waves"^^<http://example.org/invalidDatatype> ;
    dcterms:description "EEG with focal sharp transient waves in the centrotemporal region of the brain (also known as the central sulcus), i.e., focal sharp waves of a duration less than 80 msec followed by a slow wave."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022848" .

<http://purl.obolibrary.org/obo/HP_0012692> rdfs:label "Focal T2 hyperintense thalamic lesion" ;
    dcterms:description "A lighter than expected T2 signal on magnetic resonance imaging (MRI) of the thalamus. This term refers to a localized hyperintensity affecting a particular region of the thalamus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022774" .

<http://purl.obolibrary.org/obo/HP_0012695> rdfs:label "Decreased thalamic volume" ;
    dcterms:description "A reduction in the quantity of space occupied by the thalamus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022771"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012698> rdfs:label "Cerebellar gliosis" ;
    dcterms:description "Focal proliferation of glial cells in the cerebellum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022768"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012700> rdfs:label "Abnormal large intestine physiology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A functional anomaly of the large intestine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022766"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012718> rdfs:label "Abnormal gastrointestinal tract morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal structure of the gastrointestinal tract."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal shape of the digestive system"^^<http://example.org/invalidDatatype>,
        "Morphological abnormality of the gastrointestinal tract"^^<http://example.org/invalidDatatype>,
        "Morphological abnormality of the GI tract",
        "Morphological anomaly of the digestive system" ;
    ns1:synonym "Morphological abnormality of the GI tract"^^<http://example.org/invalidDatatype>,
        "Morphological abnormality of the gastrointestinal tract"^^<http://example.org/invalidDatatype>,
        "Morphological anomaly of the digestive system"^^<http://example.org/invalidDatatype>,
        "Abnormal shape of the digestive system" ;
    ns1:xref "UMLS:C4021073"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012719> rdfs:label "Functional abnormality of the gastrointestinal tract" ;
    dcterms:description "Abnormal functionality of the gastrointestinal tract." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Functional abnormality of the GI tract"^^<http://example.org/invalidDatatype>,
        "GI dysfunction"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Functional abnormality of the GI tract"^^<http://example.org/invalidDatatype>,
        "GI dysfunction" ;
    ns1:xref "UMLS:C4022755"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012725> rdfs:label "Cutaneous syndactyly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A soft tissue continuity in the A/P axis between two digits that extends distally to at least the level of the proximal interphalangeal joints, or a soft tissue continuity in the A/P axis between two digits that lies significantly distal to the flexion crease that overlies the metacarpophalangeal or metatarsophalangeal joint of the adjacent digits."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cutaneous syndactyly of digits"^^<http://example.org/invalidDatatype>,
        "Syndactyly, cutaneous" ;
    ns1:synonym "Cutaneous syndactyly of digits"^^<http://example.org/invalidDatatype>,
        "Syndactyly, cutaneous" ;
    ns1:xref "UMLS:C1861921" .

<http://purl.obolibrary.org/obo/HP_0012753> rdfs:label "T2 hypointense basal ganglia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A darker than expected T2 signal on magnetic resonance imaging (MRI) of the basal ganglia. This term refers to a diffuse hypointensity affecting all of the basal ganglia." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022743"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012768> rdfs:label "Neonatal asphyxia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Respiratory failure in the newborn."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Asphyxia neonatorum"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Asphyxia neonatorum" ;
    ns1:xref "UMLS:C0004045"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:28314004",
        "SNOMEDCT_US:413654009" .

<http://purl.obolibrary.org/obo/HP_0012775> rdfs:label "Stellate iris" ;
    dcterms:description "A lacy pattern or iris pigmentation that resembles the spokes of a bicycle wheel."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022727" .

<http://purl.obolibrary.org/obo/HP_0012795> rdfs:label "Abnormal optic disc morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A morphological abnormality of the optic disc, i.e., of the portion of the optic nerve clinically visible on fundoscopic examination."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3808249" .

<http://purl.obolibrary.org/obo/HP_0012798> rdfs:label "Pulmonary lymphangiomyomatosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Infiltration of smooth muscle-like cells in lymph vessels as well as the lung (pleura, alveolar septa, bronchi, pulmonary vessels and lymphatics as well as lymph nodes, especially in posterior mediastinum and retroperitoneum). Focal emphysema can develop because of airway narrowing, and the thoracic duct may be obliterated. Pulmonary lymphangiomyomatosis may lead to multiple small cysts with a hamartomatous proliferation of smooth muscle in their walls." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pulmonary myomatosis" ;
    ns1:related_synonym "Lymphangioleiomyomatosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Lymphangioleiomyomatosis",
        "Pulmonary myomatosis" ;
    ns1:xref "SNOMEDCT_US:73017001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0238399"^^<http://example.org/invalidDatatype>,
        "UMLS:C0751674" .

<http://purl.obolibrary.org/obo/HP_0012801> rdfs:label "Narrow jaw"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bigonial distance (lower facial width) more than 2 standard deviations below the mean (objective); or an apparently decreased width of the lower jaw (mandible) when viewed from the front (subjective)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Narrow jaw"^^<http://example.org/invalidDatatype>,
        "Narrow lower face"^^<http://example.org/invalidDatatype>,
        "Narrow lower jaw",
        "Narrow mandible" ;
    ns1:related_synonym "Thin lower face"^^<http://example.org/invalidDatatype>,
        "Thin lower jaw"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Narrow lower jaw"^^<http://example.org/invalidDatatype>,
        "Narrow mandible"^^<http://example.org/invalidDatatype>,
        "Narrow jaw",
        "Narrow lower face",
        "Thin lower face",
        "Thin lower jaw" ;
    ns1:xref "UMLS:C4280310"^^<http://example.org/invalidDatatype>,
        "UMLS:C4021066" .

<http://purl.obolibrary.org/obo/HP_0012903> rdfs:label "Myotonia of the upper limb" ;
    dcterms:description "Slowed relaxation of muscles in the arm." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022683" .

<http://purl.obolibrary.org/obo/HP_0020068> rdfs:label "Intranuclear inclusion bodies" ;
    dcterms:description "Inclusion bodies (deposits of stainable material, usually misfolded proteins) localized in the nucleus." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020217> rdfs:label "Focal aware motor seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of focal motor seizure in which awareness is retained throughout the seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal motor aware seizure" ;
    ns1:synonym "Focal motor aware seizure"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025145> rdfs:label "Rigors" ;
    dcterms:description "Severe chills with violent shivering. A rigor is an episode of shaking or exaggerated shivering which can occur with a high fever." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Rigours" ;
    ns1:synonym "Rigours" .

<http://purl.obolibrary.org/obo/HP_0025152> rdfs:label "Poor visual behavior for age" ;
    dcterms:description "Lack of visual responsiveness or decrease in visual capabilities suggesting a lack of visual responsiveness or decrease in visual capabilities in an infant or young child in which visual behavior fails to meet normal developmental milestones."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal visual behaviour for age"^^<http://example.org/invalidDatatype>,
        "Poor visual behavior for age"^^<http://example.org/invalidDatatype>,
        "Abnormal visual behavior for age" ;
    ns1:synonym "Abnormal visual behavior for age"^^<http://example.org/invalidDatatype>,
        "Poor visual behavior for age"^^<http://example.org/invalidDatatype>,
        "Abnormal visual behaviour for age" .

<http://purl.obolibrary.org/obo/HP_0025158> rdfs:label "Hyperautofluorescent retinal lesion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased amount of autofluorescence in the retina as ascertained by fundus autofluorescence imaging."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Retinal lipofuscin accumulation" ;
    ns1:synonym "Retinal lipofuscin accumulation" .

<http://purl.obolibrary.org/obo/HP_0025162> rdfs:label "Severe temper tantrums" ;
    dcterms:description "Temper tantrums, which occur with more severe symptomatology compared to a temper tantrum that occurs as a part of normal developmental process." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025186> rdfs:label "Marcus Gunn jaw winking synkinesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Unilateral ptosis with associated upper eyelid contraction and contraction of either the external or the internal pterygoid muscle. It is thought to occur because of congenital miswiring of a branch of the fifth cranial nerve into the branch of the third cranial nerve supplying the levator muscle. In Marcus Gunn jaw winking synkinesis, elevation and even retraction of the affected eyelid is triggered by chewing, suction, lateral mandible movement, smiling, sternocleidomastoid contraction, protruding tongue, Valsalva maneuver and even by breathing." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pterygoid-levator synkinesis"^^<http://example.org/invalidDatatype>,
        "Trigemino-oculomotor synkinesis"^^<http://example.org/invalidDatatype>,
        "Marcus Gunn jaw-winking syndrome" ;
    ns1:synonym "Marcus Gunn jaw-winking syndrome"^^<http://example.org/invalidDatatype>,
        "Trigemino-oculomotor synkinesis"^^<http://example.org/invalidDatatype>,
        "Pterygoid-levator synkinesis" .

<http://purl.obolibrary.org/obo/HP_0025267> rdfs:label "Snoring" ;
    dcterms:description "Deep, noisy breathing during sleep, accompanied by hoarse or harsh sounds, is caused by the vibration of respiratory structures, especially the soft palate. This vibration results in sound due to obstructed air movement during breathing while sleeping."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Snoring symptoms"^^<http://example.org/invalidDatatype>,
        "Snore",
        "Snores" ;
    ns1:synonym "Snore",
        "Snores",
        "Snoring symptoms" .

<http://purl.obolibrary.org/obo/HP_0025278> rdfs:label "Cold-induced sweating"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Sweating provoked by cold temperature rather than by heat." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025325> rdfs:label "Sparse medial eyebrow" ;
    dcterms:description "Decreased density/number and/or decreased diameter of medial eyebrow hairs." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Medial thinning of eyebrow"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Medial thinning of eyebrow" .

<http://purl.obolibrary.org/obo/HP_0025386> rdfs:label "Bitemporal hollowing" ;
    dcterms:description "Depression of profile in both temporal regions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025430> rdfs:label "High-pitched cry" ;
    dcterms:description "A type of crying in an abnormally high-pitched voice."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025439> rdfs:label "Pharyngitis" ;
    dcterms:description "Inflammation (due to infection or irritation) of the pharynx."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025479> rdfs:label "Self-neglect"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A pathological neglect of personal needs and well-being that includes attending to self-grooming, personal care and the attention to cleanliness of personal space." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025549> rdfs:label "Eccentric visual fixation" ;
    dcterms:description "A uniocular condition in which there is fixation of an object by a point other than the fovea. This point adopts the principal visual direction. The degree of the eccentric fixation is defined by its distance from the fovea in degrees." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Eccentric fixation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Eccentric fixation"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025584> rdfs:label "Hypotropia" ;
    dcterms:description "A form of manifest strabismus (heterotropia) in which one eye is deviated downwards when both eyes are open." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025722> rdfs:label "Cerebral infarct"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A necrotic lesion in the cerebrum resulting from a sudden insufficiency of arterial or venous blood supply due to emboli, thrombi or mechanical factors."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030015> rdfs:label "Female anorgasmia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The persistent of recurrent difficulty, delay in, or absence of attaining orgasm following sufficient sexual stimulation and arousal." ;
    ns1:broad_synonym "Female orgasmic disorder" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Female orgasmic disorder" ;
    ns1:xref "UMLS:C0033948"^^<http://example.org/invalidDatatype>,
        "UMLS:C4022677"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:60103007" .

<http://purl.obolibrary.org/obo/HP_0030016> rdfs:label "Dyspareunia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Recurrent or persistent genital pain associated with sexual intercourse."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:71315007",
        "UMLS:C1384606" .

<http://purl.obolibrary.org/obo/HP_0030095> rdfs:label "Reduced muscle collagen VI"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A decreased amount of collagen VI in muscle tissue. Collagen VI is a primarily associated with the extracellular matrix of skeletal muscle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced collagen 6 in muscle"^^<http://example.org/invalidDatatype>,
        "Reduced collagen VI immunolabeling in muscle biopsy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced collagen VI immunolabeling in muscle biopsy"^^<http://example.org/invalidDatatype>,
        "Reduced collagen 6 in muscle" ;
    ns1:xref "UMLS:C4021054"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030166> rdfs:label "Night sweats"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Occurrence of excessive sweating during sleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Night sweats",
        "Nocturnal hyperhidrosis" ;
    ns1:synonym "Night sweats",
        "Nocturnal hyperhidrosis" ;
    ns1:xref "SNOMEDCT_US:42984000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0028081" .

<http://purl.obolibrary.org/obo/HP_0030195> rdfs:label "Fatigable weakness of swallowing muscles" ;
    dcterms:description "A type of weakness of the muscles involved in swallowing that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022588" .

<http://purl.obolibrary.org/obo/HP_0030235> rdfs:label "Extremely elevated creatine kinase" ;
    dcterms:description "An increased creatine kinase level more than 50X above the upper normal level."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Extremely high CPK level"^^<http://example.org/invalidDatatype>,
        "Extremely elevated CPK",
        "Extremely elevated creatine phosphokinase",
        "Extremely elevated phospho-CK serum level",
        "Extremely elevated serum CK level" ;
    ns1:synonym "Extremely elevated CPK"^^<http://example.org/invalidDatatype>,
        "Extremely elevated creatine phosphokinase"^^<http://example.org/invalidDatatype>,
        "Extremely elevated phospho-CK serum level"^^<http://example.org/invalidDatatype>,
        "Extremely elevated serum CK level"^^<http://example.org/invalidDatatype>,
        "Extremely high CPK level"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022564" .

<http://purl.obolibrary.org/obo/HP_0030264> rdfs:label "Webbed penis" ;
    dcterms:description "Ventral skinfold extending from penis to scrotum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Webbed penis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Webbed penis" ;
    ns1:xref "SNOMEDCT_US:253852007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0431670" .

<http://purl.obolibrary.org/obo/HP_0030269> rdfs:label "Increased circulating insulin-like growth factor 1 concentration" ;
    dcterms:description "An elevated level of insulin-like growth factor 1 (IGF1) in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated serum IGF1"^^<http://example.org/invalidDatatype>,
        "Increased serum IGF1"^^<http://example.org/invalidDatatype>,
        "Increased serum insulin-like growth factor 1" ;
    ns1:synonym "Elevated serum IGF1"^^<http://example.org/invalidDatatype>,
        "Increased serum IGF1",
        "Increased serum insulin-like growth factor 1" ;
    ns1:xref "UMLS:C2676198" .

<http://purl.obolibrary.org/obo/HP_0030405> rdfs:label "Pancreatic endocrine tumor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A neuroendocrine tumor originating in a hormone-producing cell (islet cell) of the pancreas."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pancreatic endocrine tumour"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pancreatic endocrine tumour"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:128878003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:76345009"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:126864006",
        "SNOMEDCT_US:237596009",
        "SNOMEDCT_US:399528006",
        "UMLS:C0242363" .

<http://purl.obolibrary.org/obo/HP_0030465> rdfs:label "Undetectable light-adapted electroretinogram" ;
    dcterms:description "No detectable response to the light-adapted 3.0 ERG (single-flash cone response). This type of ERG measures responses of the cone system; a-waves arise from cone photoreceptors and cone off-bipolar cells; the b-wave comes from On- and Off-cone bipolar cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent photopic (cone) responses on ERG"^^<http://example.org/invalidDatatype>,
        "non-detectable photopic ERG" ;
    ns1:synonym "Absent photopic (cone) responses on ERG"^^<http://example.org/invalidDatatype>,
        "non-detectable photopic ERG" ;
    ns1:xref "UMLS:C4072955"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030500> rdfs:label "Yellow/white macular lesion" ;
    dcterms:description "A type of white and/or yellow lesion located anywhere within the macula. These lesions can be flat or raised and can vary in size from very small to bigger."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Yellow/white lesion of the macula" ;
    ns1:synonym "Yellow/white lesion of the macula"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072987" .

<http://purl.obolibrary.org/obo/HP_0030506> rdfs:label "Yellow/white retinal lesion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An area anywhere within the retina showing pale yellow or white discoloration. Such lesions can be flat or raised and there size can range from very small to big." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Yellow/white lesions of the retina"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Yellow/white lesions of the retina" ;
    ns1:xref "UMLS:C4072991"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030511> rdfs:label "Bradyopsia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Difficulty in seeing moving objects." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Difficulty seeing moving objects" ;
    ns1:synonym "Difficulty seeing moving objects" ;
    ns1:xref "SNOMEDCT_US:711163009"^^<http://example.org/invalidDatatype>,
        "UMLS:C1842073"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030517> rdfs:label "Heteronymous hemianopia"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Heteronymous hemianopsia" ;
    ns1:synonym "Heteronymous hemianopsia" ;
    ns1:xref "SNOMEDCT_US:344104004",
        "SNOMEDCT_US:345121001",
        "UMLS:C0271207" .

<http://purl.obolibrary.org/obo/HP_0030534> rdfs:label "Abnormal best corrected visual acuity test"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073008"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030584> rdfs:label "Color vision test abnormality" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Colour vision test abnormality" ;
    ns1:synonym "Colour vision test abnormality"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4073057" .

<http://purl.obolibrary.org/obo/HP_0030591> rdfs:label "Abnormal kinetic perimetry test"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073063"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030663> rdfs:label "Optically empty vitreous" ;
    dcterms:description "Vestigial vitreous gel occupying the immediate retrolental space and minimal to no discernible gel in the central vitreous cavity, giving the appearance of an empty vitreous cavity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073118" .

<http://purl.obolibrary.org/obo/HP_0030664> rdfs:label "Beevor's sign"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Weakness of the inferior portion of the rectus abdominal muscle, which is ascertained clinically as follows. When a patient sits up or raises the head from a recumbent position, the umbilicus is displaced toward the head. This is the result of paralysis of the inferior portion of the rectus abdominal muscle, so that the upper fibers predominate pulling upwards the umbilicus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:61282003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0231616"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030667> rdfs:label "Peripheral retinal neovascularization"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of retinal neovascularization that affects the periphery of the retina."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:247100001",
        "UMLS:C0474355" .

<http://purl.obolibrary.org/obo/HP_0030672> rdfs:label "Asteroid hyalosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of small, white vitreous opacities consisting of calcium phosphate and complex, layered lipid deposits." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:95800001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0521770"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030766> rdfs:label "Ear pain" ;
    dcterms:description "Pain in the ear can be a consequence of otologic disease (primary or otogenic otalgia), or can arise from pathologic processes and structures other than the ear (secondary or referred otalgia)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ear pain"^^<http://example.org/invalidDatatype>,
        "Otalgia",
        "Pain in the ear" ;
    ns1:synonym "Ear pain"^^<http://example.org/invalidDatatype>,
        "Otalgia"^^<http://example.org/invalidDatatype>,
        "Pain in the ear"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:162356005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0013456"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:16001004" .

<http://purl.obolibrary.org/obo/HP_0030838> rdfs:label "Hip pain" ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the hip."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hip pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hip pain" ;
    ns1:xref "UMLS:C0019559"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:49218002" .

<http://purl.obolibrary.org/obo/HP_0030878> rdfs:label "Abnormality on pulmonary function testing" ;
    dcterms:description "Any anomaly measure by pulmonary function testing, which includes spirometry, measures of diffusing capacity, and plethysmography."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal pulmonary function test" ;
    ns1:related_synonym "Abnormal spirometry test" ;
    ns1:synonym "Abnormal pulmonary function test"^^<http://example.org/invalidDatatype>,
        "Abnormal spirometry test" ;
    ns1:xref "UMLS:C4280728" .

<http://purl.obolibrary.org/obo/HP_0030902> rdfs:label "Palmomental reflex"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of primitive reflex characterized by an involuntary contraction of the mentalis muscle of the chin caused by stimulation of the thenar eminence of the palm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030903> rdfs:label "Grasp reflex" ;
    dcterms:description "A type of primitive reflex that can be elicated when the hand of the examiner is gently inserted into the palm of the patient's hand. The palmar surface is stroked or simply touched. The flexor surfaces of the fingers may be stimulated also by the examiner's fingers. The stimulus should be in a distal direction. With a positive response, the patient grasps the examiner's hand with variable strength and continues to grasp as the examiner's hand is moved. Ability to release the grip voluntarily depends on the activity of the reflex; some patients can do so readily, while others can even be lifted off the bed, since the grasp has such power [NCBI Books:NBK395]." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Palmar grasp reflex" ;
    ns1:synonym "Palmar grasp reflex" .

<http://purl.obolibrary.org/obo/HP_0030917> rdfs:label "Low APGAR score" ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031047> rdfs:label "Paraproteinemia" ;
    dcterms:description "An abnormal immunoglobulin or part of an Ig (light chain) in the circulation. Paraproteins are typically produced by a clonal population of B-cell derived plasma cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Monoclonal hypergammaglobulinemia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Monoclonal hypergammaglobulinemia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031061> rdfs:label "Impaired toileting ability"^^<http://example.org/invalidDatatype> ;
    dcterms:description "This term applies to an individual who requires help transferring to the toilet, cleaning self or who uses bedpan or commode."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031064> rdfs:label "Impaired continence"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Partial or total incontinence of bowel or bladder." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031079> rdfs:label "Impaired growth-hormone response to insulin stimulation test"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Failure of growth hormone levels to respond adequately (by increasing) to the insulin tolerance test (ITT)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031087> rdfs:label "Absent pubertal growth spurt"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The abrupt and transient increase in the annual growth rate normally observed in adolescent individuals does not occur." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent adolescent growth spurt" ;
    ns1:synonym "Absent adolescent growth spurt"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031139> rdfs:label "Frog-leg posture" ;
    dcterms:description "A type of rest posture in an infant that indicated a generalized reduction in muscle tone. The hips are flexed and the legs are abducted to an extent that causes the lateral thigh to rest upon the supporting surface. This posture is said to resemble the legs of a frog." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031273> rdfs:label "Shock"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The state in which profound and widespread reduction of effective tissue perfusion leads first to reversible, and then if prolonged, to irreversible cellular injury." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031355> rdfs:label "Maintenance insomnia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Individuals affected by abnormal difficulty in staying asleep tend to wake up at night and struggle to return to sleep. This condition typically involves spending more than 30 minutes awake during the night." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Difficulty staying asleep"^^<http://example.org/invalidDatatype>,
        "Insomnia middle",
        "Middle insomnia",
        "Waking up several times during the night" ;
    ns1:synonym "Difficulty staying asleep"^^<http://example.org/invalidDatatype>,
        "Insomnia middle"^^<http://example.org/invalidDatatype>,
        "Middle insomnia"^^<http://example.org/invalidDatatype>,
        "Waking up several times during the night" .

<http://purl.obolibrary.org/obo/HP_0031372> rdfs:label "Cold paresis" ;
    dcterms:description "Increased muscle weakness upon exposure to cold temperatures." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031435> rdfs:label "Monotonic speech" ;
    dcterms:description "A speech pattern characterized by a persistently abnormal lack of tone in the voice. Monotonic speech is typically ongoing, lasting throughout the day, but may have a diurnal variation in the pattern, i.e. slower at specific times of the day."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flat speech" ;
    ns1:synonym "Flat speech"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031526> rdfs:label "Subretinal fluid"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fluid accumulating between the neuroretina and retinal pigment epithelium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Sub-retinal fluid"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Sub-retinal fluid" .

<http://purl.obolibrary.org/obo/HP_0031605> rdfs:label "Abnormal fundus pigmentation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any anomaly of the pigmentation of the fundus, the posterior part of the eye including the retina and optic nerve. Fundus pigmentation should be evaluated in the context of skin and hair color."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of fundus pigmentation" ;
    ns1:synonym "Abnormality of fundus pigmentation" .

<http://purl.obolibrary.org/obo/HP_0031627> rdfs:label "Globus pallidus calcification"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pathological deposition of calcium salts in the globus pallidus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031691> rdfs:label "Severe viral infection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unusually severe viral infection." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031703> rdfs:label "Abnormal ear morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the ear."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "Fyler:4867"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031705> rdfs:label "Compensatory head posture" ;
    dcterms:description "A compensatory head posture occurs when the head is deviated out of the normal primary straight head position in order to compensate for an ocular problem." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031814> rdfs:label "Palilalia" ;
    dcterms:description "Palilalia is the involuntary repetition of one's own phrases, words, or syllables 2 or more times in a row. Typically, palilalic utterances decrease in volume with the increasing number of repetitions. Sometimes, the repetitions are also uttered with an accelerating speed." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032121> rdfs:label "Froment sign" ;
    dcterms:description "An abnormal result of a physical examination of the the hand that tests for palsy of the ulnar nerve. This nerve innervates the adductor pollicis and interossei muscles and thereby enables adduction of the thumb and extension of the interphalangeal joint. An abnormal result consists in reduced functionality and muscular weakness in the pinch grip between the thumb and index finger of the affected hand as the patient attempts to pinch a piece of paper that the examiner tries to pull away. The flexor pollicis longus muscle tries to compensate for the weakness by flexing the tip of the thumb at the interphalangeal joint." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Froment thumb sign" ;
    ns1:synonym "Froment thumb sign"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032148> rdfs:label "Episodic pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Intermittent pain, i.e., pain that occurs occasionally and at irregular intervals." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032407> rdfs:label "Bilateral perisylvian polymicrogyria" ;
    dcterms:description "A type of perisylvian polymicrogyria that affects both sides of the brain." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032466> rdfs:label "Aplasia of the olfactory bulb" ;
    dcterms:description "Lack of formation (congenital absence) of the olfactory bulb." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aplastic olfactory bulb"^^<http://example.org/invalidDatatype>,
        "Olfactory bulb aplasia" ;
    ns1:synonym "Aplastic olfactory bulb",
        "Olfactory bulb aplasia" .

<http://purl.obolibrary.org/obo/HP_0032471> rdfs:label "Focal polymicrogyria" ;
    dcterms:description "Polymicrogyria affecting one or multiple small areas of the cerebral cortex." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032492> rdfs:label "Anti-myelin oligodendrocyte glycoprotein antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Presence of antibodies in the serum that react against myelin oligodendrocyte glycoprotein." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-MOG antibody positivity" ;
    ns1:synonym "Anti-MOG antibody positivity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032615> rdfs:label "Abnormal diffusion weighted cerebral MRI morphology" ;
    dcterms:description "A diffusion abnormality observed in diffusion-weighted magnetic resonance imaging (MRI) of the brain. Molecular diffusion refers to the notion that any type of molecule in a fluid (eg, water) is randomly displaced as the molecule is agitated by thermal energy. Restricted diffusion of water appears bright on diffusion-weighted images."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Diffusion weighted imaging (DWI) abnormality"^^<http://example.org/invalidDatatype>,
        "Diffusion weighted magnetic resonance imaging (DWI) abnormality"^^<http://example.org/invalidDatatype>,
        "MRI diffusion abnormality of the cerebrum"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Diffusion weighted imaging (DWI) abnormality"^^<http://example.org/invalidDatatype>,
        "MRI diffusion abnormality of the cerebrum"^^<http://example.org/invalidDatatype>,
        "Diffusion weighted magnetic resonance imaging (DWI) abnormality" .

<http://purl.obolibrary.org/obo/HP_0032656> rdfs:label "Febrile status epilepticus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A seizure lasting 30 minutes without fully regaining consciousness, provoked by fever (temperature greater than 38.0 degrees Celcius) at the time of seizure-onset, without a prior history of afebrile seizure and with no evidence of an acute central nervous system infection or insult."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fever-induced status epilepticus" ;
    ns1:synonym "Fever-induced status epilepticus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032671> rdfs:label "Non-convulsive status epilepticus without coma" ;
    dcterms:description "A type of status epilepticus without prominent motor symptoms in the absence of coma." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033031> rdfs:label "Hyperpyrexia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An extreme elevation of core body temperature above normal defined as a rectal temperature of 41.1 degrees Celsius (106 degrees Fahrenheit)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033078> rdfs:label "Decreased circulating free T4 concentration" ;
    dcterms:description "A reduced concentration of free thyroxine (fT4) in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased circulating free T4 level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased circulating free T4 level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033379> rdfs:label "Bilateral superior vena cava" ;
    dcterms:description "The presence of a left and a right superior vena cava."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bilateral SVC"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Bilateral SVC" .

<http://purl.obolibrary.org/obo/HP_0033687> rdfs:label "Short term memory impairment"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deficit in the retention of pieces of information (memory chunks) for a relatively short time (usually up to 30 seconds)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Short term memory loss"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Short term memory loss" .

<http://purl.obolibrary.org/obo/HP_0033715> rdfs:label "Hippocampal sclerosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hippocampal sclerosis is a neuropathologic finding characterized by neuronal loss and gliosis in the CA-1 and subiculum of the hippocampus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mesial temporal sclerosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Mesial temporal sclerosis" .

<http://purl.obolibrary.org/obo/HP_0033747> rdfs:label "Abnormal exteroceptive sensation" ;
    dcterms:description "A type of somatic sensory dysfunction characterized by abnormality of superficial sensation that is mediated by receptors in skin and mucous membranes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033794> rdfs:label "Acral overgrowth" ;
    dcterms:description "Excessive growth of hands and feet (predominantly due to soft tissue swelling). Typical manifestations include shoe size increase, foot enlargement, glove tightness, and hand enlargement."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Acromegalic growth"^^<http://example.org/invalidDatatype>,
        "Acral enlargement",
        "Acral hypertrophy" ;
    ns1:related_synonym "Acromegaly" ;
    ns1:synonym "Acral enlargement"^^<http://example.org/invalidDatatype>,
        "Acromegalic growth"^^<http://example.org/invalidDatatype>,
        "Acral hypertrophy",
        "Acromegaly" .

<http://purl.obolibrary.org/obo/HP_0034360> rdfs:label "Action myoclonus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of myoclonus (arrhythmic muscular jerking) that is induced by voluntary movement. It is made worse by attempts at precise or coordinated movement (intention myoclonus) and may also be provoked by certain sensory stimuli."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034362> rdfs:label "Dull foveal reflex" ;
    dcterms:description "Reduced brightness of the foveal reflex, which normally is a bright pinpoint of light that is observed to move sideways or up and down in response to movement of the opthalmoscope."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased foveal light reflex"^^<http://example.org/invalidDatatype>,
        "Muted foveal light reflex"^^<http://example.org/invalidDatatype>,
        "Poor foveal light reflex" ;
    ns1:synonym "Muted foveal light reflex"^^<http://example.org/invalidDatatype>,
        "Poor foveal light reflex"^^<http://example.org/invalidDatatype>,
        "Decreased foveal light reflex" .

<http://purl.obolibrary.org/obo/HP_0034665> rdfs:label "Shoulder contracture" ;
    dcterms:description "Lack of full passive range of motion (restrictions in flexion, extension, or other movements) of the shoulder joint resulting from structural changes of non-bony tissues, such as muscles, tendons, ligaments, joint capsules and/or skin." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040030> rdfs:label "Chorioretinal hypopigmentation" ;
    dcterms:description "Focal or global or heterogeneous loss of choroidal and retinal pigment epithelium (RPE) pigmentation in the absence of atrophy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022483"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040126> rdfs:label "Abnormal circulating vitamin B12 concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deviation from the normal concentration of cobalamin (vitamin B12) in the blood. Vitamin B12 is one of the eight B vitamins."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal vitamin B12 level"^^<http://example.org/invalidDatatype>,
