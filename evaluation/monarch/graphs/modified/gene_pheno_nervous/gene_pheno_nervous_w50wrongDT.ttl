        "SNOMEDCT_US:1023001",
        "SNOMEDCT_US:248583008" .

<http://purl.obolibrary.org/obo/HP_0002187> rdfs:label "Profound intellectual disability" ;
    dcterms:description "Profound intellectual disability (ID) is defined as a type of ID characterized by profoundly sub-average adaptive functioning and intellectual functioning, with an intelligence quotient (IQ) below 20."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intellectual disability, profound"^^<http://example.org/invalidDatatype>,
