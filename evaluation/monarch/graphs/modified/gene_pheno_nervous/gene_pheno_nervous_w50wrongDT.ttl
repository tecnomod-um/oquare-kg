        "UMLS:C0011854" .

<http://purl.obolibrary.org/obo/HP_0100678> rdfs:label "Premature skin wrinkling" ;
    dcterms:description "The presence of an increased degree of wrinkling (irregular folds and indentations) of the skin as compared with age-related norms." ;
