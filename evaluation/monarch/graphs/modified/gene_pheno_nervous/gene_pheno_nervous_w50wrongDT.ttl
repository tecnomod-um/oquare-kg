<http://purl.obolibrary.org/obo/HP_0000141> rdfs:label "Amenorrhea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of menses for an interval of time equivalent to a total of more than (or equal to) 3 previous cycles or 6 months."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal absence of menstruation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal absence of menstruation" ;
    ns1:xref "UMLS:C2219717" .

<http://purl.obolibrary.org/obo/HP_0000744> rdfs:label "Low frustration tolerance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The feeling of frustration can be defined as an emotional reaction that occurs when a desired goal is not achieved. Frustration intolerance is defined as an age-inappropriate response to frustration, characterized by crying or temper tantrums in children, or aggressive or other maladaptive behaviors."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intolerance to frustration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Intolerance to frustration"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0548883" .

