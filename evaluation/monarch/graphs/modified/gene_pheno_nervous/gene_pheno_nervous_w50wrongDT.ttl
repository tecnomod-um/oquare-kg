<http://purl.obolibrary.org/obo/HP_0012418> rdfs:label "Hypoxemia" ;
    dcterms:description "An abnormally low level of blood oxygen."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low blood oxygen level"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Hypoxia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Low blood oxygen level"^^<http://example.org/invalidDatatype>,
        "Hypoxia" ;
    ns1:xref "UMLS:C0700292"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:389087006" .

<http://purl.obolibrary.org/obo/HP_0012420> rdfs:label "Meconium stained amniotic fluid"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Amniotic fluid containing the earliest stools of a mammalian infant."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Meconium-stained amniotic fluid"^^<http://example.org/invalidDatatype>,
        "Meconium staining of amniotic fluid" ;
    ns1:synonym "Meconium staining of amniotic fluid",
        "Meconium-stained amniotic fluid" ;
    ns1:xref "SNOMEDCT_US:168092006"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:249135009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0426209"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012429> rdfs:label "Aplasia/Hypoplasia of the cerebral white matter" ;
    dcterms:description "Absence or underdevelopment of the cerebral white matter." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent/small cerebral white matter"^^<http://example.org/invalidDatatype>,
        "Absent/underdeveloped cerebral white matter"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Absent/small cerebral white matter"^^<http://example.org/invalidDatatype>,
        "Absent/underdeveloped cerebral white matter" ;
    ns1:xref "UMLS:C4021844"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012486> rdfs:label "Myelitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the spinal cord." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inflammation of spinal cord" ;
    ns1:synonym "Inflammation of spinal cord"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:41370002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0026975"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012505> rdfs:label "Enlarged pituitary gland" ;
    dcterms:description "An abnormally increased size of the pituitary gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0342422"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:237718009" .

<http://purl.obolibrary.org/obo/HP_0012513> rdfs:label "Upper limb pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the arm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Upper limb pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Upper limb pain"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:102556003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0239377"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012569> rdfs:label "Delayed menarche"^^<http://example.org/invalidDatatype> ;
    dcterms:description "First period after the age of 15 years."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Delayed start of first period" ;
    ns1:synonym "Delayed start of first period"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0949173" .

<http://purl.obolibrary.org/obo/HP_0012638> rdfs:label "Abnormal nervous system physiology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A functional anomaly of the nervous system."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of nervous system physiology" ;
    ns1:synonym "Abnormality of nervous system physiology"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022811" .

<http://purl.obolibrary.org/obo/HP_0012670> rdfs:label "Orthostatic syncope" ;
    dcterms:description "Syncope following a quick change in position from lying down to standing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0749201"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012690> rdfs:label "T2 hypointense thalamus" ;
    dcterms:description "A darker than expected T2 signal on magnetic resonance imaging (MRI) of the thalamus. This term refers to a diffuse hypointensity affecting the entire thalamus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022776" .

<http://purl.obolibrary.org/obo/HP_0012724> rdfs:label "Upper eyelid edema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Edema in the region of the upper eyelid." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Puffiness of upper eyelid"^^<http://example.org/invalidDatatype>,
        "Swelling of upper eyelid"^^<http://example.org/invalidDatatype>,
        "Upper eyelid oedema"^^<http://example.org/invalidDatatype>,
        "Cellulitis of upper eyelid",
        "Fullness of upper eyelid" ;
    ns1:synonym "Cellulitis of upper eyelid"^^<http://example.org/invalidDatatype>,
        "Fullness of upper eyelid"^^<http://example.org/invalidDatatype>,
        "Puffiness of upper eyelid"^^<http://example.org/invalidDatatype>,
        "Swelling of upper eyelid",
        "Upper eyelid oedema" ;
    ns1:xref "UMLS:C2025988"^^<http://example.org/invalidDatatype>,
        "UMLS:C3839407"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:700339006" .

<http://purl.obolibrary.org/obo/HP_0012757> rdfs:label "Abnormal neuron morphology" ;
    dcterms:description "A structural anomaly of a neuron. Neurons are electrically excitable cells that transmit signals throughout the body. Neurons employ both electrical and chemical components in the transmission of information. Neurons are connected to other neurons at synapses and connected to effector organs or cells at neuroeffector junctions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal neuron shape",
        "Abnormal neuronal morphology" ;
    ns1:synonym "Abnormal neuronal morphology"^^<http://example.org/invalidDatatype>,
        "Abnormal neuron shape" ;
    ns1:xref "UMLS:C4022739"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012847> rdfs:label "Epilepsia partialis continua" ;
    dcterms:description "Epilepsia partialis continua (also called Kojevnikov's or Kozhevnikov's epilepsia) is a type of focal motor status epilepticus characterized by repeated stereotyped simple motor manifestations such as jerks, typically of a limb or the face, recurring every few seconds or minutes for extended periods (days or years)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Epilepsia partialis continua of Kojevnikov"^^<http://example.org/invalidDatatype>,
        "Kojevnikov's epilepsia"^^<http://example.org/invalidDatatype>,
        "Kozhevnikov's epilepsia" ;
    ns1:synonym "Epilepsia partialis continua of Kojevnikov",
        "Kojevnikov's epilepsia",
        "Kozhevnikov's epilepsia" ;
    ns1:xref "UMLS:C0085543"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:241006" .

<http://purl.obolibrary.org/obo/HP_0020216> rdfs:label "Visually-induced seizure" ;
    dcterms:description "Seizures evoked by visual stimuli. This includes clinical seizures induced by strobe lighting, television and other screens, flickering environmental lighting and self-induction by causing a strobe effect."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Photosensitive seizure"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Photosensitive seizure" .

<http://purl.obolibrary.org/obo/HP_0025153> rdfs:label "Transient"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Short-lived and not permanent. This term applies to a phenotypic abnormality that is temporary and of short duration."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025159> rdfs:label "Hypoautofluorescent retinal lesion" ;
    dcterms:description "Decreased amount of autofluorescence in the retina as ascertained by fundus autofluorescence imaging." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypo-autofluorescent retinal lesion" ;
    ns1:synonym "Hypo-autofluorescent retinal lesion" .

<http://purl.obolibrary.org/obo/HP_0025169> rdfs:label "Left ventricular systolic dysfunction" ;
    dcterms:description "Abnormality of left ventricular contraction, often defined operationally as an ejection fraction of less than 40 percent." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025233> rdfs:label "Sleep paralysis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inability to move trunk and limbs and inability to speak during transition into or out of sleep; awareness is preserved and recall is present."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025312> rdfs:label "Esophoria" ;
    dcterms:description "A form of strabismus with both eyes turned inward to a relatively mild degree, usually defined as less than 10 prism diopters."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025357> rdfs:label "Erratic myoclonus" ;
    dcterms:description "A type of myoclonus in which the myoclonias shift from body region to another in a random and asynchronous fashion. Erratic myoclonus can affect the face or limbs, are brief, single or repetitive, very frequent and nearly continuous."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fragmentary myoclonus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Fragmentary myoclonus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025402> rdfs:label "Square-wave jerks" ;
    dcterms:description "Square wave jerks are saccadic eye movements which, when recorded with open eyes are considered to be a pathological sign, caused by fixation instability, and pointing to a central neurological lesion." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025514> rdfs:label "Morning glory anomaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the optic nerve in which the optic nerve is large and funneled and displays a conical excavation of the optic disc. The optic disc appears dysplastic."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Morning glory disc anomaly"^^<http://example.org/invalidDatatype>,
        "Morning glory disk anomaly"^^<http://example.org/invalidDatatype>,
        "Morning glory optic disc"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Morning glory disc anomaly"^^<http://example.org/invalidDatatype>,
        "Morning glory disk anomaly"^^<http://example.org/invalidDatatype>,
        "Morning glory optic disc"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030074> rdfs:label "Chemodectoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A usually benign neoplasm originating in the chemoreceptor tissue of the carotid body, glomus jugulare, glomus tympanicum, aortic bodies, or the female genital tract."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chemodectomas" ;
    ns1:synonym "Chemodectomas" ;
    ns1:xref "SNOMEDCT_US:127028003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:30699005",
        "UMLS:C0007279" .

<http://purl.obolibrary.org/obo/HP_0030117> rdfs:label "Absent muscle fiber emerin" ;
    dcterms:description "Immunohistochemistry shows complete lack of emerin protein in the muscle biopsy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent muscle fibre emerin"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Absent muscle fibre emerin" ;
    ns1:xref "UMLS:C4022628"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030164> rdfs:label "Jaw claudication"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pain in the jaw or ear induced by chewing or otherwise moving the jaw." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Jaw pain while chewing"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Jaw pain while chewing"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:43922008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0239064" .

<http://purl.obolibrary.org/obo/HP_0030177> rdfs:label "Abnormality of peripheral nervous system electrophysiology" ;
    dcterms:description "An abnormality of the function of the electrical signals with which peripheral nerve cells communicate with each other or with muscles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal nerve conduction study"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal nerve conduction study"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0853150" .

<http://purl.obolibrary.org/obo/HP_0030188> rdfs:label "Tremor by anatomical site" ;
    dcterms:description "Tremor classified by the affected body part." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tremor of a body part" ;
    ns1:synonym "Tremor of a body part"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022593"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030222> rdfs:label "Visual agnosia" ;
    dcterms:description "The condition is known as visual agnosia, which refers to the inability to recognize objects that are visually presented, even though the individual may have normal visual field, acuity, color vision, brightness discrimination, language, and memory." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:25762009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0234502" .

<http://purl.obolibrary.org/obo/HP_0030230> rdfs:label "Central core regions in muscle fibers" ;
    dcterms:description "The presence of disorganized areas called cores in the center of muscle fibers. There is a typical appearance of the biopsy on light microscopy, where the muscle cells have cores that are devoid of mitochondria and specific enzymes. Cores are typically well demarcated and centrally located, but may occasionally be multiple and of eccentric."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Central core regions in muscle fibres"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Central core regions in muscle fibres" ;
    ns1:xref "UMLS:C4022568"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030260> rdfs:label "Microphallus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Length of penis more than 2 SD below the mean for age accompanied by hypospadias."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:276333003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0240701"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030391> rdfs:label "Spoken word recognition deficit"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced ability of lexical discrimination, which refers to the process of distinguishing a stimulus word from other phonologically similar words. Lexical discrimination can be defined as the process of correctly identifying words in the mental lexicon to match the phonological input of a stimulus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072928" .

<http://purl.obolibrary.org/obo/HP_0030434> rdfs:label "Pilomatrixoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pilomatricoma is an asymptomatic slowly growing benign cutaneous tumor, differentiating towards the hair matrix of the hair follicle. It is covered by normal or hyperemic skin, and usually varies in size from 0.5 to 3 cm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:274901004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:44155009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0206711" .

<http://purl.obolibrary.org/obo/HP_0030455> rdfs:label "Abnormality of pattern visual evoked potentials" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072946"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030491> rdfs:label "Choriocapillaris atrophy" ;
    dcterms:description "Atrophy of the capillary lamina of choroid." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3275758"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030499> rdfs:label "Macular drusen"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Drusen localted in the macula."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Lipid accumulation in macula" ;
    ns1:synonym "Lipid accumulation in macula"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:247154004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0677628" .

<http://purl.obolibrary.org/obo/HP_0030631> rdfs:label "Hyperautofluorescent macular lesion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased amount of autofluorescence in the macula as ascertained by fundus autofluorescence imaging."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073101"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030822> rdfs:label "Hooded upper eyelid" ;
    dcterms:description "Upper eyelid partly covered by skin when eyes are open." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280749"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030824> rdfs:label "Mizuo phenomenon" ;
    dcterms:description "Change in the color of the fundus from red in the dark-adapted state to golden immediately or shortly after the onset of the light. The color of the fundus reflex in the light adapted state has also been described as golden-yellow, gray-white, and yellow-white. This reflex can appear either homogeneous or in streaks in the fundus. The retinal vessels appear to be protruding in contrast to the radiant background. Dark adaptation leads to disappearance of the unusual fundus coloration [Digital Journal of Ophthalmology 2008; Volume 14, Number 14]." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mizuo-Nakamura phenomenon" ;
    ns1:synonym "Mizuo-Nakamura phenomenon" ;
    ns1:xref "UMLS:C4280748" .

<http://purl.obolibrary.org/obo/HP_0030856> rdfs:label "Posterior staphyloma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A localized defect in the posterior eye wall with protrusion of uveal tissue due to alterations in scleral thickness and structure." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:87819007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0155360"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030892> rdfs:label "Deep cerebral white matter hyperintensities" ;
    dcterms:description "Areas of brighter than expected signal on magnetic resonance imaging emanating from locations distant from the ventricular system." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "DWMH"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "DWMH"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030904> rdfs:label "Glabellar reflex" ;
    dcterms:description "A type of primitive reflex that is elicited by repetitive tapping on the forehead. Normal subjects usually blink in response to the first several taps, but if blinking persists, the response is abnormal and considered to be a sign of frontal release. Persistent blinking is also known as Myerson's sign." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Myerson's sign"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Myerson's sign"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030915> rdfs:label "Cerebellar edema" ;
    dcterms:description "Swelling from fluid accumulation (serous fluid infiltration into the interstitial space) in the cerebellum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cerebellar edema"^^<http://example.org/invalidDatatype>,
        "Edema of the cerebellum",
        "Oedema of the cerebellum" ;
    ns1:synonym "Edema of the cerebellum"^^<http://example.org/invalidDatatype>,
        "Cerebellar edema",
        "Oedema of the cerebellum" .

<http://purl.obolibrary.org/obo/HP_0030953> rdfs:label "Conjunctival hyperemia" ;
    dcterms:description "Dilatation of the blood vessels of the conjunctiva leading to a red appearance of the sclera."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Conjunctival vascular congestion"^^<http://example.org/invalidDatatype>,
        "Conjunctival hyperaemia",
        "Conjunctival injection" ;
    ns1:synonym "Conjunctival vascular congestion"^^<http://example.org/invalidDatatype>,
        "Conjunctival hyperaemia",
        "Conjunctival injection" .

<http://purl.obolibrary.org/obo/HP_0031169> rdfs:label "Postterm pregnancy" ;
    dcterms:description "A pregnancy that extends to 42 weeks of gestation or beyond."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031206> rdfs:label "Striatal T2 hyperintensity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally bright T2 signal from the striatum on brain magnetic resonance imaging."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031507> rdfs:label "Decreased circulating T4 concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction below the normal concentration of thyroxine in the blood. Thyroxine (also known as T4) is the main hormone secreted by the thyroid gland into the blood. It can be converted into the active form triiodothyronine (also known as T3)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced T4 plasma level"^^<http://example.org/invalidDatatype>,
        "Decreased circulating T4 level",
        "Decreased circulating thyroxine level" ;
    ns1:synonym "Reduced T4 plasma level"^^<http://example.org/invalidDatatype>,
        "Decreased circulating T4 level",
        "Decreased circulating thyroxine level" .

<http://purl.obolibrary.org/obo/HP_0031535> rdfs:label "Increased theta frequency activity in EEG" ;
    dcterms:description "Increased frequency of theta wave activity in the electroencephalogram. Theta waves have a frequency of 3.5-7.5 Hertz, and are present in very small amounts in healthy waking adult EEGs. Theta activity is normal in small very amounts in the healthy waking adult EEG in a symmetrical distribution." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031609> rdfs:label "Macular geographic atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Chronic progressive degeneration of the macula that can be seen as part of late-stage age-related macular degeneration (AMD)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Geographic atrophy"^^<http://example.org/invalidDatatype>,
        "Geographic atrophy of the macula"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Geographic atrophy"^^<http://example.org/invalidDatatype>,
        "Geographic atrophy of the macula"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031624> rdfs:label "Moderate myopia" ;
    dcterms:description "A moderate form of myopia with refractive error of between -3.00 and -6.00 diopters."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031860> rdfs:label "Abnormal heart rate variability"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any abnormality in the variability of the time interval between successive heartbeats."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031861> rdfs:label "Decreased heart rate variability" ;
    dcterms:description "Reduced variation of beat-to-beat intervals of the heart that occurs in conjunction with the respiratory cycle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced heart rate variability" ;
    ns1:synonym "Reduced heart rate variability" .

<http://purl.obolibrary.org/obo/HP_0031954> rdfs:label "Dystonic gait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dystonic gait disorders frequently appear bizarre, particularly because activity increases dystonic tonus and posture. The abnormal posture of the foot in dystonic gait typically involves inversion, plantar flexion and tonic extension of the big toe. In many patients complex types of walking, such as walking backwards and running are paradoxically less impaired than walking forward and may seem completely unaffected. Sensory tricks, for instance, if the affected individual rests a hand on his or her neck, may improve or even normalize dystonic gait in some patients."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031982> rdfs:label "Abnormal putamen morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the putamen, a brain nucleus which together with the caudate nucleus and fundus striati makes up the striatum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032005> rdfs:label "Hemidystonia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hemidystonia refers to dystonia which involves the ipsilateral face, arm, and leg."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032027> rdfs:label "Retinal dots"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Yellow, white or grayish lesions in the retina that are well-defined/distinct, individual and mostly uniform in size." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032044> rdfs:label "Decreased vigilance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A decrease in the ability to maintain sustained attention is characterized by reduced alertness."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased alertness"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased alertness" .

<http://purl.obolibrary.org/obo/HP_0032325> rdfs:label "Lacunar stroke"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A stroke related to a small infarct (2-20 mm in diameter) in the deep cerebral white matter, basal ganglia, or pons, that is presumed to result from the occlusion of a single small perforating artery supplying the subcortical areas of the brain." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032391> rdfs:label "Subcortical heterotopia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of heterotopia were the mislocalized gray matter is located deep within the white matter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032653> rdfs:label "Elevated lactate:pyruvate ratio" ;
    dcterms:description "An abnormal increase in the molar ratio of lactate to pyruvate in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032663> rdfs:label "Focal motor status epilepticus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Status epilepticus with focal motor signs originating within networks limited to one hemisphere. Involves musculature in any form. The motor event could consist of an increase (positive) or decrease (negative) in muscle contraction to produce a movement." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033049> rdfs:label "Globus pallidus hypointensity on susceptibility-weighted imaging" ;
    dcterms:description "Hypointence (dark) appearance of the globus pallidus inmagnetic resonance imaging using susceptibility weighted imaging (SWI)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033142> rdfs:label "Long nasal bridge"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased superior-inferior length of the nasal bridge, which is the saddle-shaped area that includes the nasal root and the lateral aspects of the nose."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033505> rdfs:label "Livedo reticularis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Livedo reticularis is characterized by the presence of a bluish purple, mottled or netlike pattern in unbroken circles on the skin. Exposure to cold environments usually intensifies the vascular pattern. Presumably, the condition results from slow or stagnant blood flow, vessel-wall pathology, and decreased oxygen tension." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033660> rdfs:label "Hand paresthesia" ;
    dcterms:description "Tingling (often referred to as a pins and needles feeling) and numbness in the hand."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hand tingling" ;
    ns1:synonym "Hand tingling" .

<http://purl.obolibrary.org/obo/HP_0033850> rdfs:label "Coldness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Relative coldness of a body part to palpitation, often acccompanied by feelings of coldness."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cold skin temperature"^^<http://example.org/invalidDatatype>,
        "Cool skin"^^<http://example.org/invalidDatatype>,
        "Cool skin temperature",
        "Coolness to palpation" ;
    ns1:synonym "Cold skin temperature"^^<http://example.org/invalidDatatype>,
        "Cool skin"^^<http://example.org/invalidDatatype>,
        "Cool skin temperature"^^<http://example.org/invalidDatatype>,
        "Coolness to palpation" .

<http://purl.obolibrary.org/obo/HP_0033978> rdfs:label "Reduced beta-hexosaminidase B activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diminished activity of the enzyme beta-hexosaminidase in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hexosaminidase B low in blood"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hexosaminidase B low in blood" .

<http://purl.obolibrary.org/obo/HP_0034322> rdfs:label "Reduced tissue galactocerebrosidase activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration or activity of galactocerebrosidase (EC 3.2.1.46) below the lower limit of normal. This enzyme can be measured in multiple tissues including leukocytes and cultured fibroblasts."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:narrow_synonym "Reduced circulating galactocerebrosidase activity"^^<http://example.org/invalidDatatype>,
        "Reduced leukocyte galactocerebrosidase activity"^^<http://example.org/invalidDatatype>,
        "Reduced galactocerebrosidase activity in cultured fibroblasts" ;
    ns1:synonym "Reduced circulating galactocerebrosidase activity"^^<http://example.org/invalidDatatype>,
        "Reduced galactocerebrosidase activity in cultured fibroblasts",
        "Reduced leukocyte galactocerebrosidase activity" .

<http://purl.obolibrary.org/obo/HP_0034332> rdfs:label "Cognitive regression" ;
    dcterms:description "Loss of cognitive developmental skills, as manifested by loss of developmental cognitive milestones." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034681> rdfs:label "Finger joint contracture" ;
    dcterms:description "Lack of full passive range of motion (restrictions in flexion, extension, or other movements) of a finger joint resulting from structural changes of non-bony tissues, such as muscles, tendons, ligaments, joint capsules and/or skin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040064> rdfs:label "Abnormality of limbs" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal limbs"^^<http://example.org/invalidDatatype>,
        "Limb anomaly"^^<http://example.org/invalidDatatype>,
        "Abnormality of limbs" ;
    ns1:related_synonym "Dysmelia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal limbs"^^<http://example.org/invalidDatatype>,
        "Dysmelia"^^<http://example.org/invalidDatatype>,
        "Abnormality of limbs",
        "Limb anomaly" ;
    ns1:xref "UMLS:C0239337"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:445144002",
        "UMLS:C4073131" .

<http://purl.obolibrary.org/obo/HP_0040183> rdfs:label "Encopresis" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Stool holding",
        "Stool soiling" ;
    ns1:synonym "Stool holding"^^<http://example.org/invalidDatatype>,
        "Stool soiling" ;
    ns1:xref "SNOMEDCT_US:302690004"^^<http://example.org/invalidDatatype>,
        "UMLS:C2945606" .

<http://purl.obolibrary.org/obo/HP_0040195> rdfs:label "Decreased head circumference"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally reduced head circumference in a growing child. Head circumference is measured with a nonelastic tape and comprises the distance from above the eyebrows and ears and around the back of the head. The measured HC is then plotted on an appropriate growth chart. Microcephaly is defined as a head circumference (HC) that is great than two standard deviations below the mean of age- and gender-matched population based samples. Severe microcephaly is defined with an HC that is three standard deviations below the mean." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased head circumference" ;
    ns1:synonym "Decreased head circumference"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:271611007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0424688" .

<http://purl.obolibrary.org/obo/HP_0040270> rdfs:label "Impaired glucose tolerance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal resistance to glucose, i.e., a reduction in the ability to maintain glucose levels in the blood stream within normal limits following oral or intravenous administration of glucose." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased glucose tolerance"^^<http://example.org/invalidDatatype>,
        "Glucose tolerance decreased" ;
    ns1:synonym "Decreased glucose tolerance",
        "Glucose tolerance decreased" ;
    ns1:xref "MP:0005291"^^<http://example.org/invalidDatatype>,
        "UMLS:C0151671"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040272> rdfs:label "Hyperintensity of MRI T2 signal of the spinal cord" ;
    dcterms:description "A region of high intensity (brightness) observed upon magnetic resonance imaging (MRI) scans of the spinal cord." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280684" .

<http://purl.obolibrary.org/obo/HP_0040327> rdfs:label "Abnormal morphology of the olfactory bulb" ;
    dcterms:description "An abnormal morphology of the olfactory bulb (bulbus olfactorius), which is involved in olfaction, i.e. the sense of smell." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0100018> rdfs:label "Nuclear cataract"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A nuclear cataract is an opacity or clouding that develops in the lens nucleus. That is, a nuclear cataract is one that is located in the center of the lens. The nucleus tends to darken changing from clear to yellow and sometimes brown."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Yellowish cloudy center of lens"^^<http://example.org/invalidDatatype>,
        "Yellowish cloudy centre of lens"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Yellowish cloudy centre of lens"^^<http://example.org/invalidDatatype>,
        "Yellowish cloudy center of lens" ;
    ns1:xref "UMLS:C0392557"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:53889007" .

<http://purl.obolibrary.org/obo/HP_0100019> rdfs:label "Cortical cataract" ;
    dcterms:description "A cataract which affects the layer of the lens surrounding the nucleus, i.e., the lens cortex. It is identified by its unique wedge or spoke appearance." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:193576003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0271160"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100026> rdfs:label "Arteriovenous malformation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomalous configuration of blood vessels that shunts arterial blood directly into veins without passing through the capillaries." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:24551003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0003857"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:234141001" .

<http://purl.obolibrary.org/obo/HP_0100248> rdfs:label "Hemiballismus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hemiballismus is a rare movement disorder that is caused primarily by damage to various areas in the basal ganglia. Hemiballismus is usually characterized by involuntary flinging motions of the extremities. The movements are often violent and have wide amplitudes of motion. They are continuous and random and can involve proximal and/or distal muscles on one side of the body, while some cases even include the facial muscles. The more a patient is active, the more the movements increase. With relaxation comes a decrease in movements." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Ballismus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Ballismus"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:66637005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0221169" .

<http://purl.obolibrary.org/obo/HP_0100308> rdfs:label "Cerebral cortical hemiatrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atrophy of one side of the brain, characterized by findings including thinning of the cerebral cortex, reduced volume of the cerebral white matter with abnormal myelination, and enlargement of the ispilateral fourth ventricle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022153"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100318> rdfs:label "Lafora bodies" ;
    dcterms:description "An intraneuronal inclusion body composed of acid mucopolysaccharides." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:87554006",
        "UMLS:C0333749" .

<http://purl.obolibrary.org/obo/HP_0100513> rdfs:label "Decreased circulating vitamin E concentration" ;
    dcterms:description "A reduced concentration of vitamin E in the blood circulation. Vitamin E is a lipophilic vitamin that is also known as alpha-tocopherol."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Alpha-tocopherol deficiency"^^<http://example.org/invalidDatatype>,
        "Vitamin E deficiency"^^<http://example.org/invalidDatatype>,
        "Low levels of vitamin E" ;
    ns1:synonym "Low levels of vitamin E"^^<http://example.org/invalidDatatype>,
        "Alpha-tocopherol deficiency",
        "Vitamin E deficiency" ;
    ns1:xref "UMLS:C0042875"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:54137008" .

<http://purl.obolibrary.org/obo/HP_0100542> rdfs:label "Abnormal localization of kidney"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal site of the kidney." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal localisation of kidneys"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal localisation of kidneys"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4020968" .

<http://purl.obolibrary.org/obo/HP_0100555> rdfs:label "Asymmetric growth"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A growth pattern that displays an abnormal difference between the left and the right side." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Uneven or disproportionate growth of one body part compared to another"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Uneven or disproportionate growth of one body part compared to another"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022025" .

<http://purl.obolibrary.org/obo/HP_0100556> rdfs:label "Hemiatrophy" ;
    dcterms:description "Undergrowth of the limbs that affects only one side." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Asymmetric limb shortening"^^<http://example.org/invalidDatatype>,
        "Hemiatrophy of the body"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Asymmetric limb shortening",
        "Hemiatrophy of the body" ;
    ns1:xref "SNOMEDCT_US:34087007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0333662"^^<http://example.org/invalidDatatype> .

