<http://purl.obolibrary.org/obo/MONDO_0011957> rdfs:label "retinal macular dystrophy type 2" ;
    dcterms:description "Retinal macular dystrophy type 2 is a rare, genetic macular dystrophy disorder characterized by slowly progressive ''bull's eye'' maculopathy associated, in most cases, with mild decrease in visual acuity and central scotomata. Usually, only the central retina is involved, however some cases of more widespread rod and cone anomalies have been reported. Rare additional features include empty sella turcica, impaired olfaction, renal infections, hematuria and recurrent miscarriages." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "MCDR2"^^<http://example.org/invalidDatatype>,
        "macular dystrophy, retinal, type 2"^^<http://example.org/invalidDatatype> ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0000603>,
