        "SNOMEDCT_US:69943009",
        "UMLS:C0334008",
        "UMLS:C4020878" .

<http://purl.obolibrary.org/obo/HP_0001098> rdfs:label "Abnormal fundus morphology" ;
    dcterms:description "Any structural abnormality of the fundus of the eye."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the fundus" ;
    ns1:synonym "Abnormality of the fundus"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4025804"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001103> rdfs:label "Abnormal macular morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A structural abnormality of the macula, a region that, in a clinical context, is typically used to describe the central part of the retina within the vascular arcades."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macula abnormality"^^<http://example.org/invalidDatatype>,
        "Macular abnormality"^^<http://example.org/invalidDatatype>,
        "Abnormality of the macula" ;
    ns1:synonym "Abnormality of the macula"^^<http://example.org/invalidDatatype>,
        "Macula abnormality"^^<http://example.org/invalidDatatype>,
        "Macular abnormality" ;
    ns1:xref "SNOMEDCT_US:312999006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0730362"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001147> rdfs:label "Retinal exudate" ;
    dcterms:description "Yellow-white intraretinal deposits in the retina typically associated with damaged inner blood-retina barrier and exudation of serous fluid and lipids from the retinal microvasculature." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal exudates"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Retinal exudates" ;
    ns1:xref "SNOMEDCT_US:39832008",
        "UMLS:C0240897" .

<http://purl.obolibrary.org/obo/HP_0001373> rdfs:label "Joint dislocation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Displacement or malalignment of joints."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Joint dislocations"^^<http://example.org/invalidDatatype>,
        "Joint dislocation" ;
    ns1:synonym "Joint dislocation",
        "Joint dislocations" ;
    ns1:xref "SNOMEDCT_US:108367008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0012691"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:87642003" .

<http://purl.obolibrary.org/obo/HP_0001483> rdfs:label "Eye poking"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Repetitive pressing, poking, and/or rubbing in the eyes." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blindism"^^<http://example.org/invalidDatatype>,
        "Eye pressing"^^<http://example.org/invalidDatatype>,
        "Ocular auto-stimulation"^^<http://example.org/invalidDatatype>,
        "Oculodigital phenomenon" ;
    ns1:synonym "Eye pressing"^^<http://example.org/invalidDatatype>,
