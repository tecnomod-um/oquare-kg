<http://purl.obolibrary.org/obo/MONDO_0007639> rdfs:label "fundus albipunctatus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fundus albipunctatus is a rare, genetic retinal dystrophy characterized by the presence of numerous small, round, yellowish-white retinal lesions that are distributed throughout the retina but spare the fovea. Patients present in childhood with non-progressive night blindness with prolonged cone and rod adaptation times. The macula may or may not be involved, which may result in a decrease of central visual acuity with age." ;
    ns1:broad_synonym "retinitis punctata albescens"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "pigmentary retinal dystrophy"^^<http://example.org/invalidDatatype>,
