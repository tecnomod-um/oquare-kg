        "Supernumerary thumb"^^<http://example.org/invalidDatatype>,
        "thumb polydactyly" ;
    ns1:xref "SNOMEDCT_US:445216006"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:205135003",
        "UMLS:C1395852" .

<http://purl.obolibrary.org/obo/HP_0001217> rdfs:label "Clubbing"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Broadening of the soft tissues (non-edematous swelling of soft tissues) of the digital tips in all dimensions associated with an increased longitudinal and lateral curvature of the nails." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Clubbing of fingers and toes",
