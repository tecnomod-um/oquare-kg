<http://purl.obolibrary.org/obo/HP_0010867> rdfs:label "Dyssynergia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of ataxia characterized by the impairment of the ability to smoothly perform the elements of a voluntary movement in the appropriate order and speed. With dyssynergia, a voluntary movement appears broken down into its component parts."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:20262006"^^<http://example.org/invalidDatatype>,
