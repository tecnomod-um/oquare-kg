    ns1:exact_synonym "Dental enamel pits",
        "Dental enamel pitting",
        "Pitting of tooth enamel",
        "Tooth enamel pits" ;
    ns1:synonym "Dental enamel pits",
        "Dental enamel pitting",
        "Pitting of tooth enamel",
        "Tooth enamel pits" ;
    ns1:xref "UMLS:C1860711" .

