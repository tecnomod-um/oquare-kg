    dcterms:description "Narrowing or constriction of the inner surface (lumen) of the anterior cerebral artery." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1504567" .

<http://purl.obolibrary.org/obo/HP_0012496> rdfs:label "Reduced maximal inspiratory pressure" ;
    dcterms:description "A decrease in the maximum amount of negative pressure a person can generate during an inhalation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022880"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012497> rdfs:label "Reduced maximal expiratory pressure" ;
    dcterms:description "A decrease in the maximum amount of pressure of expired air achieved by a person after a full inspiration." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022879"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012498> rdfs:label "Nuchal cord" ;
    dcterms:description "A complication of pregnancy and delivery in which the umbilical cord wraps around the fetal neck once or multiple times." ;
    ns1:category ns1:PhenotypicFeature ;
