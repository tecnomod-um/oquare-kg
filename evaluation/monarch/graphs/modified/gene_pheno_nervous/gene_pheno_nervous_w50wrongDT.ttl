        <http://purl.obolibrary.org/obo/HP_0200042> ;
    ns1:related_synonym "cervical hypertrichosis peripheral neuropathy"^^<http://example.org/invalidDatatype>,
        "hypertrichosis, congenital anterior cervical, with peripheral sensory and motor neuropathy" ;
    ns1:synonym "cervical hypertrichosis peripheral neuropathy",
        "hypertrichosis, congenital anterior cervical, with peripheral sensory and motor neuropathy" ;
