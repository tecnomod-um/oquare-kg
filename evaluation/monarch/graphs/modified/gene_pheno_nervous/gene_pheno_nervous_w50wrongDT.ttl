<http://purl.obolibrary.org/obo/HP_0012588> rdfs:label "Steroid-resistant nephrotic syndrome" ;
    dcterms:description "A form of nephrotic syndrome that does not respond to treatment with steroid medication, defined as persistent proteinuria despite 60mg/m2 or 2mg/kg for 8 weeks, after insuring no infection or non-adherence to medication." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "SRNS"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "SRNS" ;
    ns1:xref "SNOMEDCT_US:236381000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0403397" .

