<http://purl.obolibrary.org/obo/HP_0009736> rdfs:label "Tibial pseudarthrosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pseudarthrosis, or \"false joint\" of the tibia is the result of a developmental failure in the tibia progressing to spontaneous fracture and subsequent fibrous nonunion. The fracture is rarely present at birth but commonly develops during the first 18 months of life."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tibial pseudoarthrosis"^^<http://example.org/invalidDatatype> ;
