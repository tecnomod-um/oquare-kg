        "SNOMEDCT_US:387778001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:423902002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0034150" .

<http://purl.obolibrary.org/obo/HP_0001025> rdfs:label "Urticaria" ;
    dcterms:description "Raised, well-circumscribed areas of erythema and edema involving the dermis and epidermis. Urticaria is intensely pruritic, and blanches completely with pressure."^^<http://example.org/invalidDatatype> ;
