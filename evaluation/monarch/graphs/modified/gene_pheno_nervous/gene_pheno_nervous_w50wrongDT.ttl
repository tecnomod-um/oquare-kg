<http://purl.obolibrary.org/obo/HP_0010957> rdfs:label "Congenital posterior urethral valve"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A developmental defect resulting in an obstructing membrane in the posterior male urethra." ;
