<http://purl.obolibrary.org/obo/HP_0011171> rdfs:label "Simple febrile seizure" ;
    dcterms:description "A short generalized seizure, of a duration of <15 min, not recurring within 24 h, occurring during a febrile episode not caused by an acute disease of the nervous system intracranial infection or severe metabolic disturbance." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Simple febrile convulsion",
        "Simple febrile seizures",
        "Simple fever fit" ;
    ns1:synonym "Simple febrile convulsion"^^<http://example.org/invalidDatatype>,
        "Simple fever fit"^^<http://example.org/invalidDatatype>,
        "Simple febrile seizures" ;
    ns1:xref "SNOMEDCT_US:432354000",
        "UMLS:C0149886" .

<http://purl.obolibrary.org/obo/HP_0011185> rdfs:label "EEG with focal epileptiform discharges" ;
    dcterms:description "EEG discharges recorded in particular areas of a localized (focal) abnormality in cerebral electrical activity recorded along the scalp by electroencephalography (EEG)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal EEG Abnormality"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Focal EEG Abnormality"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021199" .

<http://purl.obolibrary.org/obo/HP_0011330> rdfs:label "Metopic synostosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Premature fusion of the metopic suture."^^<http://example.org/invalidDatatype> ;
