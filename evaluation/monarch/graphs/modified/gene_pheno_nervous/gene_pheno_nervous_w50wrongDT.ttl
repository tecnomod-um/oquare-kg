<http://purl.obolibrary.org/obo/HP_0007807> rdfs:label "Optic nerve compression"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:72983001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0271344" .

<http://purl.obolibrary.org/obo/HP_0007817> rdfs:label "Horizontal supranuclear gaze palsy" ;
    dcterms:description "A supranuclear gaze palsy is an inability to look in a horizontal direction as a result of cerebral impairment. There is a loss of the voluntary aspect of eye movements, but, as the brainstem is still intact, all the reflex conjugate eye movements are normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4024794"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007819> rdfs:label "Presenile cataracts"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Presenile cataract is a kind of cataract that occurs in early adulthood, that is, at an age that is younger than usual." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Presenile cataract"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Presenile cataract"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:441622000",
        "UMLS:C0154971" .

<http://purl.obolibrary.org/obo/HP_0007838> rdfs:label "Progressive ptosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A progressive form of ptosis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Progressive drooping of upper eyelid" ;
    ns1:synonym "Progressive drooping of upper eyelid" ;
    ns1:xref "UMLS:C1834015"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007858> rdfs:label "Chorioretinal lacunae" ;
    dcterms:description "Punched out lesions in the pigmented layer of the retina."^^<http://example.org/invalidDatatype> ;
