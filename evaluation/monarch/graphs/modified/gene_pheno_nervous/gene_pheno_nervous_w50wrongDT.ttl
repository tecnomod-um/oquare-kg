    ns1:synonym "Elevated levels of phytanic acid"^^<http://example.org/invalidDatatype>,
        "Elevated level of phytanic acid" ;
    ns1:xref "UMLS:C4023786"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010636> rdfs:label "Schizencephaly" ;
    dcterms:description "The presence of a cleft in the cerebral cortex unilaterally or bilaterally, usually located in the frontal area." ;
