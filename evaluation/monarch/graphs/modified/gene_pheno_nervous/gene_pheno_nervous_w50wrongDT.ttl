<http://purl.obolibrary.org/obo/HP_0000556> rdfs:label "Retinal dystrophy" ;
    dcterms:description "Retinal dystrophy is an abnormality of the retina associated with a hereditary process. Retinal dystrophies are defined by their predominantly monogenic inheritance and they are frequently associated with loss or dysfunction of photoreceptor cells as a primary or secondary event."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Breakdown of light-sensitive cells in back of eye" ;
    ns1:synonym "Breakdown of light-sensitive cells in back of eye" ;
    ns1:xref "SNOMEDCT_US:314407005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0854723"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000608> rdfs:label "Macular degeneration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A nonspecific term denoting degeneration of the retinal pigment epithelium and/or retinal photoreceptor cells of the macula lutea."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0000819> rdfs:label "Diabetes mellitus"^^<http://example.org/invalidDatatype> ;
