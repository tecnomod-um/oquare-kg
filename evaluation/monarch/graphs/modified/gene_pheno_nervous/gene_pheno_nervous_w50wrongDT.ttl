<http://purl.obolibrary.org/obo/MONDO_0019846> rdfs:label "acquired central diabetes insipidus" ;
    dcterms:description "Acquired central diabetes insipidus (acquired CDI) is a subtype of central diabetes insipidus (CDI), characterized by polyuria and polydipsia, due to an idiopathic or secondary decrease in vasopressin (AVP) production." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "acquired neurogenic diabetes insipidus"^^<http://example.org/invalidDatatype>,
        "acquired CDI",
        "acquired central diabetes insipidus" ;
