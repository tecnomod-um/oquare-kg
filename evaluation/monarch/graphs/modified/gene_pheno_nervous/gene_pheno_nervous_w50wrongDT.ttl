        "MR Spectroscopy: N-acetylaspartate low in brain" ;
    ns1:xref "UMLS:C4022761"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025269> rdfs:label "Panic attack"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A sudden episode of intense fear in a situation where there is no danger or apparent cause." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Panic attack"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Panic attack"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030825> rdfs:label "Absent foveal reflex"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absent reflectivity of the fovea, which normally is a bright pinpoint of light that is observed to move sideways or up and down in response to movement of the opthalmoscope." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Foveal reflex absent",
        "Loss of foveal reflex" ;
    ns1:synonym "Foveal reflex absent"^^<http://example.org/invalidDatatype>,
        "Loss of foveal reflex"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:247144003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0423420" .

<http://purl.obolibrary.org/obo/HP_0031964> rdfs:label "Elevated circulating alanine aminotransferase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally high concentration in the circulation of alanine aminotransferase (ALT)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated serum glutamic-pyruvic transaminase"^^<http://example.org/invalidDatatype>,
        "Alanine aminotransferase increased",
        "Elevated serum ALT",
        "Elevated serum alanine aminotransferase" ;
