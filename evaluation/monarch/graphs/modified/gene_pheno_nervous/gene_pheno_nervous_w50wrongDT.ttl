<http://purl.obolibrary.org/obo/HP_0000239> rdfs:label "Large fontanelles" ;
    dcterms:description "In newborns, the two frontal bones, two parietal bones, and one occipital bone are joined by fibrous sutures, which form a small posterior fontanelle, and a larger, diamond-shaped anterior fontanelle. These regions allow for the skull to pass the birth canal and for later growth. The fontanelles gradually ossify, whereby the posterior fontanelle usually closes by eight weeks and the anterior fontanelle by the 9th to 16th month of age. Large fontanelles are diagnosed if the fontanelles are larger than age-dependent norms." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Enlarged fontanelles"^^<http://example.org/invalidDatatype>,
        "Large fontanel"^^<http://example.org/invalidDatatype>,
        "Large fontanelle"^^<http://example.org/invalidDatatype>,
        "Large fontanels"^^<http://example.org/invalidDatatype>,
        "Persistent wide fontanel",
        "Wide fontanelles" ;
    ns1:narrow_synonym "Large bregma sutures"^^<http://example.org/invalidDatatype>,
        "Wide bregma sutures"^^<http://example.org/invalidDatatype>,
        "Large, late-closing fontanelle" ;
    ns1:synonym "Enlarged fontanelles"^^<http://example.org/invalidDatatype>,
        "Large bregma sutures"^^<http://example.org/invalidDatatype>,
        "Large, late-closing fontanelle"^^<http://example.org/invalidDatatype>,
        "Wide bregma sutures"^^<http://example.org/invalidDatatype>,
        "Large fontanel",
        "Large fontanelle",
        "Large fontanels",
        "Persistent wide fontanel",
        "Wide fontanelles" ;
