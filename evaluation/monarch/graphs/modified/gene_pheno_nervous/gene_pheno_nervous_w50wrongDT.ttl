    ns1:xref "UMLS:C4023073" .

<http://purl.obolibrary.org/obo/HP_0012071> rdfs:label "Abnormal circulating acylcarnitine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation from the normal concentration in the blood circulation of an acylcarnitine, which is produced by reversible esterification of the 3-hydroxyl group of carnitine." ;
