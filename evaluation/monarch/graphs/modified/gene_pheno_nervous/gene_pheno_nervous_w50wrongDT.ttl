        "UMLS:C4280538"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002384> rdfs:label "Focal impaired awareness seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Focal impaired awareness seizure (or focal seizure with impaired or lost awareness) is a type of focal-onset seizure characterized by some degree (which may be partial) of impairment of the person's awareness of themselves or their surroundings at any point during the seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Complex focal seizures"^^<http://example.org/invalidDatatype>,
