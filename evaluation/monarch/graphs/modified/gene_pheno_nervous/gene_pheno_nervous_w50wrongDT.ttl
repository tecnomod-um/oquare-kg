<http://purl.obolibrary.org/obo/MONDO_0016723> rdfs:label "pineocytoma" ;
    dcterms:description "Pineocytoma is the least aggressive form of pineal parenchymal tumors, manifesting with symptoms such as Parinaud's syndrome (a group of eye movement abnormalities and pupil dysfunction, including deficiency in upward-gaze and convergence-retraction nystagmus), headaches, balance impairment, urinary incontinence, and changes in mood and that are not known to disseminate in a diffuse manner. They are usually associated with a good prognosis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Pineocytoma (WHO grade I)"^^<http://example.org/invalidDatatype>,
        "benign pinealoma"^^<http://example.org/invalidDatatype>,
        "pineocytoma, benign"^^<http://example.org/invalidDatatype>,
        "pinealocytoma",
        "pineocytoma",
        "pineocytoma (disease)" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0000238>,
