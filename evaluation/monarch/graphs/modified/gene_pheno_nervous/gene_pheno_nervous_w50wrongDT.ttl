<http://purl.obolibrary.org/obo/HP_0002323> rdfs:label "Anencephaly" ;
    dcterms:description "Anencephaly is a developmental anomaly characterized by a fetus that has no calvarium, with a lack of most or all of the fetus' brain tissue. Anencephaly belongs to a collective group known as neural tube defects (NTD) and is a result of the neural tube failing to close in its rostral end during fetal development." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Embryonic anencephaly",
        "Fetal anencephaly",
        "Foetal anencephaly" ;
    ns1:synonym "Embryonic anencephaly"^^<http://example.org/invalidDatatype>,
        "Fetal anencephaly",
        "Foetal anencephaly" ;
    ns1:xref "Fyler:4332"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:89369001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0002902" .

<http://purl.obolibrary.org/obo/HP_0002334> rdfs:label "Abnormal cerebellar vermis morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of the vermis of cerebellum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
