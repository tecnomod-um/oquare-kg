<http://purl.obolibrary.org/obo/MONDO_0006372> rdfs:label "pituicytoma" ;
    dcterms:description "An extremely rare, WHO grade I, circumscribed and slow-growing tumor that arises from the neurohypophysis or infundibulum and described in adults. It is characterized by the presence of elongated, spindle-shaped neoplastic glial cells that form storiform patterns or interlacing fascicular arrangements. Signs and symptoms include visual disturbances, headache, amenorrhea, and decreased libido." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "pituicytoma"^^<http://example.org/invalidDatatype>,
        "posterior pituitary astrocytoma"^^<http://example.org/invalidDatatype>,
