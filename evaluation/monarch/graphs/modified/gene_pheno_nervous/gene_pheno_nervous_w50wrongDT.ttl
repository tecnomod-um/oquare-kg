<http://purl.obolibrary.org/obo/HP_0012499> rdfs:label "Descending aortic dissection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A separation of the layers within the wall of the descending aorta. Tears in the intimal layer result in the propagation of dissection (proximally or distally) secondary to blood entering the intima-media space." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Type B aortic dissection" ;
    ns1:synonym "Type B aortic dissection" ;
