    dcterms:description "Evidence of chronic denervation on electromyography." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025614"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003712> rdfs:label "Skeletal muscle hypertrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal increase in muscle size and mass not due to training."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypertrophic muscles"^^<http://example.org/invalidDatatype>,
        "Increased skeletal muscle cells"^^<http://example.org/invalidDatatype>,
        "Muscle hypertrophy"^^<http://example.org/invalidDatatype>,
        "Muscular hypertrophy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Muscular hypertrophy"^^<http://example.org/invalidDatatype>,
        "Hypertrophic muscles",
        "Increased skeletal muscle cells",
        "Muscle hypertrophy" ;
    ns1:xref "UMLS:C2265792" .

<http://purl.obolibrary.org/obo/HP_0000488> rdfs:label "Retinopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any noninflammatory disease of the retina. This nonspecific term is retained here because of its wide use in the literature, but if possible new annotations should indicate the precise type of retinal abnormality." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Noninflammatory retina disease" ;
    ns1:synonym "Noninflammatory retina disease" ;
    ns1:xref "SNOMEDCT_US:29555009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0035309"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000998> rdfs:label "Hypertrichosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hypertrichosis is increased hair growth that is abnormal in quantity or location."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Excessive hair growth",
        "Increased hair growth on body" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Excessive hair growth"^^<http://example.org/invalidDatatype>,
        "Increased hair growth on body" ;
    ns1:xref "SNOMEDCT_US:29966009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0020555"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:271607001" .

<http://purl.obolibrary.org/obo/HP_0001212> rdfs:label "Prominent fingertip pads" ;
    dcterms:description "A soft tissue prominence of the ventral aspects of the fingertips. The term \"persistent fetal fingertip pads\" is often used as a synonym, but should better not be used because it implies knowledge of history of the patient which often does not exist." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Persistent fetal fingertip pads"^^<http://example.org/invalidDatatype>,
        "Persistent foetal fingertip pads"^^<http://example.org/invalidDatatype>,
        "Prominent fingertip pads"^^<http://example.org/invalidDatatype>,
        "Persistence of fingerpads",
        "Prominent finger pads" ;
    ns1:synonym "Persistence of fingerpads"^^<http://example.org/invalidDatatype>,
        "Persistent fetal fingertip pads"^^<http://example.org/invalidDatatype>,
        "Prominent fingertip pads"^^<http://example.org/invalidDatatype>,
        "Persistent foetal fingertip pads",
        "Prominent finger pads" ;
    ns1:xref "UMLS:C1835807"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002089> rdfs:label "Pulmonary hypoplasia" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplastic lungs"^^<http://example.org/invalidDatatype>,
        "Lung hypoplasia"^^<http://example.org/invalidDatatype>,
        "Poorly developed lungs"^^<http://example.org/invalidDatatype>,
        "Small lung"^^<http://example.org/invalidDatatype>,
        "Hypoplastic lung",
        "Underdeveloped lung" ;
    ns1:synonym "Hypoplastic lung"^^<http://example.org/invalidDatatype>,
