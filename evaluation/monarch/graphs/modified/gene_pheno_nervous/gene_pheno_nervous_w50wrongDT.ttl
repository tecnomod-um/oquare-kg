<http://purl.obolibrary.org/obo/HP_0011097> rdfs:label "Epileptic spasm" ;
    dcterms:description "A sudden flexion, extension, or mixed extension-flexion of predominantly proximal and truncal muscles that is usually more sustained than a myoclonic movement but not as sustained as a tonic seizure. Limited forms may occur: Grimacing, head nodding, or subtle eye movements. Epileptic spasms frequently occur in clusters. Infantile spasms are the best known form, but spasms can occur at all ages"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Salaam convulsion"^^<http://example.org/invalidDatatype>,
        "Salaam convulsions"^^<http://example.org/invalidDatatype>,
        "Salaam seizures"^^<http://example.org/invalidDatatype>,
        "Epileptic spasms",
        "Salaam seizure" ;
    ns1:related_synonym "West syndrome" ;
    ns1:synonym "Epileptic spasms"^^<http://example.org/invalidDatatype>,
        "Salaam convulsion"^^<http://example.org/invalidDatatype>,
