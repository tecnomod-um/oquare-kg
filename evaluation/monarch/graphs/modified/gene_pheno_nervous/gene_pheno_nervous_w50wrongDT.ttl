<http://purl.obolibrary.org/obo/HP_0012402> rdfs:label "Increased urine alpha-ketoglutarate concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A greater than normal concentration of 2-oxoglutaric acid in the urine." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urinary 2-oxoglutarate"^^<http://example.org/invalidDatatype>,
