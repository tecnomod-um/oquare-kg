        "SNOMEDCT_US:64305001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:126485001",
        "UMLS:C0042109" .

<http://purl.obolibrary.org/obo/HP_0001051> rdfs:label "Seborrheic dermatitis" ;
    dcterms:description "Seborrheic dermatitis is a form of eczema which is closely related to dandruff. It causes dry or greasy peeling of the scalp, eyebrows, and face, and sometimes trunk." ;
