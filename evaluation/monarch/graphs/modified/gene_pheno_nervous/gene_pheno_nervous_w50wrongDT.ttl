<http://purl.obolibrary.org/obo/MONDO_0010564> rdfs:label "red-green color blindness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Deuteranopia is a type of color vision deficiency where the green photoreceptors are absent. It affects hue discrimination in the same way as protanopia, but without the dimming effect. Like protanopia, it is hereditary, sex-linked, and found in about 1% of the male population." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "colorblindness, deutan"^^<http://example.org/invalidDatatype>,
        "Deutan defect",
        "deuteranopia",
        "partial achromatopsia, deutan type" ;
