<http://purl.obolibrary.org/obo/HP_0005155> rdfs:label "Ventricular escape rhythm" ;
    dcterms:description "A ventricular escape rhythm occurs whenever higher-lever pacemakers in AV junction or sinus node fail to control ventricular activation. Escape rate is usually 20-40 bpm, often associated with broad QRS complexes (at least 120 ms)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Idioventricular escape rhythm" ;
    ns1:synonym "Idioventricular escape rhythm" ;
