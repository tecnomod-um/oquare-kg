        "UMLS:C0004096"^^<http://example.org/invalidDatatype>,
        "UMLS:C3714497"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:195967001" .

<http://purl.obolibrary.org/obo/HP_0002145> rdfs:label "Frontotemporal dementia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A dementia associated with degeneration of the frontotemporal lobe and clinically associated with personality and behavioral changes such as disinhibition, apathy, and lack of insight. The hallmark feature of frontotemporal dementia is the presentation with focal syndromes such as progressive language dysfunction, or aphasia, or behavioral changes characteristic of frontal lobe disorders." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:230270009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0338451" .

