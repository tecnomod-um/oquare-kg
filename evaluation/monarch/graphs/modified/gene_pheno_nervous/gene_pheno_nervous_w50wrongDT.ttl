        "SNOMEDCT_US:205135003" .

<http://purl.obolibrary.org/obo/HP_0100291> rdfs:label "Delayed somatosensory central conduction time" ;
    dcterms:description "An abnormal increase (delay) in the somatosensory central conduction time (CCT), which can be measured from the peak of N13 to the peak of N20 (peak CCT) or from the onset of N11 to the onset of N20 (onset CCT)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022163"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100337> rdfs:label "Bilateral cleft palate" ;
    dcterms:description "Nonmidline cleft palate on the left and right sides."^^<http://example.org/invalidDatatype> ;
