<http://purl.obolibrary.org/obo/MONDO_0020380> rdfs:label "autosomal dominant cerebellar ataxia" ;
    dcterms:description "A clinically and genetically heterogeneous group of neurodegenerative diseases characterized by a slowly progressive ataxia of gait, stance and limbs, dysarthria and/or oculomotor disorder, due to cerebellar degeneration in the absence of coexisting diseases. The degenerative process can be limited to the cerebellum (ADCA type 3) or may additionally involve the retina (ADCA type 2), optic nerve, ponto-medullary systems, basal ganglia, cerebral cortex, spinal tracts or peripheral nerves (ADCA type 1). In ACDA type 4, a cerebellar syndrome is associated with epilepsy."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "SCA"^^<http://example.org/invalidDatatype>,
        "spinocerebellar ataxia" ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "autosomal dominant spinocerebellar ataxia"^^<http://example.org/invalidDatatype>,
        "cerebellar ataxia, autosomal dominant"^^<http://example.org/invalidDatatype>,
        "ADCA",
        "Autosomal Dominant Hereditary Ataxia" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0002503> ;
    ns1:related_synonym "Pierre Marie cerebellar ataxia (formerly)" ;
    ns1:synonym "ADCA"^^<http://example.org/invalidDatatype>,
        "Autosomal Dominant Hereditary Ataxia"^^<http://example.org/invalidDatatype>,
        "SCA"^^<http://example.org/invalidDatatype>,
        "autosomal dominant spinocerebellar ataxia"^^<http://example.org/invalidDatatype>,
        "Pierre Marie cerebellar ataxia (formerly)",
        "cerebellar ataxia, autosomal dominant",
        "spinocerebellar ataxia" ;
    ns1:xref "DOID:1441"^^<http://example.org/invalidDatatype>,
        "GARD:0004346"^^<http://example.org/invalidDatatype>,
        "ICD9:334.3"^^<http://example.org/invalidDatatype>,
