<http://purl.obolibrary.org/obo/HP_0002493> rdfs:label "Upper motor neuron dysfunction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A functional anomaly of the upper motor neuron. The upper motor neurons are neurons of the primary motor cortex which project to the brainstem and spinal chord via the corticonuclear, corticobulbar and corticospinal (pyramidal) tracts. They are involved in control of voluntary movements. Dysfunction leads to weakness, impairment of fine motor movements, spasticity, hyperreflexia and abnormal pyramidal signs."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pyramidal tract dysfunction"^^<http://example.org/invalidDatatype>,
        "Corticospinal tract dysfunction" ;
    ns1:synonym "Corticospinal tract dysfunction"^^<http://example.org/invalidDatatype>,
        "Pyramidal tract dysfunction" ;
    ns1:xref "UMLS:C1504405"^^<http://example.org/invalidDatatype>,
        "UMLS:C1839042"^^<http://example.org/invalidDatatype> .

