        "Ragged red muscle fibers",
        "Ragged red muscle fibres",
        "Ragged-red fibers" ;
    ns1:xref "UMLS:C3275417" .

<http://purl.obolibrary.org/obo/HP_0006970> rdfs:label "Periventricular leukomalacia" ;
    dcterms:description "Periventricular leukomalacia is characterized by diffuse injury of deep cerebral white matter, accompanied in its most severe form by focal necrosis. The neuropathologic hallmarks of PVL are microglial activation and focal and diffuse periventricular depletion of premyelinating oligodendroglia." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "PVL"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "PVL"^^<http://example.org/invalidDatatype> ;
