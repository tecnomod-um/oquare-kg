<http://purl.obolibrary.org/obo/HP_4000076> rdfs:label "Use of another person's body to communicate" ;
    dcterms:description "Moving another person's hand, body part, or body to communicate a desire, e.g. pushing or pulling someone toward a desired object or placing someone's hand on something." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hand-leading gesture"^^<http://example.org/invalidDatatype>,
        "Hand-taking gestures"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hand-leading gesture",
        "Hand-taking gestures" .

<http://purl.obolibrary.org/obo/HP_4000105> rdfs:label "Abnormal four chamber view of the fetal heart" ;
    dcterms:description "The four-chamber (4Ch) view of the fetal heart is the most widely used screening examination for the detection of structural cardiac abnormalities during routine fetal ultrasonography. In the healthy normal fetus, the apical 4Ch view demonstrates four well-developed chambers, a concordant atrioventricular (AV) connection, unobstructed AV valves (mitral and tricuspid valves), the foramen ovale flap opening into left atrium (LA), and an intact interventricular septum. Additionally, the pulmonary venous opening can be visualized at the LA wall. Any structural deviations from normal anatomy may lead to congenital heart disease that can be determined by the 4Ch view of the fetal heart's ultrasound imaging." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal four chamber view"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal four chamber view"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_4000169> rdfs:label "Pontine T2 hypointensity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A darker than expected T2 signal on magnetic resonance imaging (MRI) of the pons." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_4000205> rdfs:label "Reduced tissue beta-mannosidase activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration or activity of beta-mannosidase (EC 3.2.1.25) below the lower limit of normal. Beta-mannosidas enzyme can be measured in multiple tissues including leukocytes and cultured fibroblasts."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:narrow_synonym "Reduced beta-mannosidase activity in cultured fibroblasts"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced beta-mannosidase activity in cultured fibroblasts" .

<http://purl.obolibrary.org/obo/HP_5000006> rdfs:label "Anti-CV2/CRMP5 antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against CV2/CRMP5. Anti-CV2/CRMP5 autoantibody is the most commonly detected anti-neuronal autoantibody. Patients with typical paraneoplastic chorea show fully developed chorea in the course of weeks to months with acute inflammation in the striatum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-CV2 antibody"^^<http://example.org/invalidDatatype>,
        "Anti-collapsin response-mediated protein 5 antibody"^^<http://example.org/invalidDatatype>,
        "Anti-CV2/collapsin response mediator protein (CRMP)5 antibody" ;
    ns1:synonym "Anti-CV2 antibody"^^<http://example.org/invalidDatatype>,
        "Anti-collapsin response-mediated protein 5 antibody"^^<http://example.org/invalidDatatype>,
        "Anti-CV2/collapsin response mediator protein (CRMP)5 antibody" .

<http://purl.obolibrary.org/obo/HP_5000010> rdfs:label "Anti-GABA(B)R antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against gamma-aminobutyric acid B receptor, i.e., GABA(B)R."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-gamma-aminobutyric acid B receptor antibody"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-gamma-aminobutyric acid B receptor antibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000011> rdfs:label "Anti-GAD65 antibody"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against glutamic acid decarboxylase 65 (GAD65)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-glutamic acid decarboxylase 65 antibody" ;
    ns1:synonym "Anti-glutamic acid decarboxylase 65 antibody" .

<http://purl.obolibrary.org/obo/HP_5000013> rdfs:label "Anti-GFAP antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against glial fibrillary acidic protein (GFAP)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-glial fibrillary acidic protein antibody"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-glial fibrillary acidic protein antibody" .

<http://purl.obolibrary.org/obo/HP_5000014> rdfs:label "Anti-GlyR antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against Glycine receptor (GlyR)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-glycine receptor antibody"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-glycine receptor antibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000020> rdfs:label "Anti-LGI1 antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against leucine-rich glioma-inactivated 1 (LGI1)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-Anti-leucine-rich glioma-inactivated 1 antibody" ;
    ns1:synonym "Anti-Anti-leucine-rich glioma-inactivated 1 antibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000024> rdfs:label "Anti-mGluR1 antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against metabotropic glutamate receptor 1 (mGluR1)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-metabotropic glutamate receptor 1 antibody" ;
    ns1:synonym "Anti-metabotropic glutamate receptor 1 antibody" .

<http://purl.obolibrary.org/obo/HP_5000027> rdfs:label "Anti-P/Q-type VGCC antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against P/Q-type voltage-gated calcium channels (VGCCs)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-P/Q-type voltage-gated calcium-channel antibody"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-P/Q-type voltage-gated calcium-channel antibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000030> rdfs:label "Anti-Ri antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against Ri, an antineuronal antibody." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-ANNA-2 antibody" ;
    ns1:synonym "Anti-ANNA-2 antibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000034> rdfs:label "Anti-Tr/DNER antibody"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against Tr/DNER. Anti-Tr antibodies are directed against cerebellar Purkinje cells (termed anti-Tr or PCA-Tr). Anti-Tr autoantibodies are frequently associated with Hodgkin lymphoma (HL). Anti-Tr antibodies are defined by a specific staining pattern in cerebellar tissue that is characterized by punctate immunoreactivity in both the dendritic tree and soma of Purkinje cells but not in their axons. This characteristic pattern is indicative of the presence of anti-Tr antibodies. The Delta/Notch-like epidermal growth factor-related receptor (DNER) was identified as the target antigen of anti-Tr."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-delta/notch-like epidermal growth factor-related receptor antibody"^^<http://example.org/invalidDatatype>,
        "PCA-Tr"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-delta/notch-like epidermal growth factor-related receptor antibody"^^<http://example.org/invalidDatatype>,
        "PCA-Tr"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000037> rdfs:label "Anti-Yo antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against Yo."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-Purkinje cell cytoplasmic antibody 1"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-Purkinje cell cytoplasmic antibody 1"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000038> rdfs:label "Anti-titin antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against titin." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_5000046> rdfs:label "Anti-Lrp4 antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against low-density lipoprotein receptor (Lrp4)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-low-density lipoprotein receptor-related protein 4 antibody" ;
    ns1:synonym "Anti-low-density lipoprotein receptor-related protein 4 antibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000047> rdfs:label "Anti-ryanodine receptor antibody"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against ryanodine receptor." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-RyR antibody"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-RyR antibody"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5000048> rdfs:label "Anti-Kv1.4 antibody" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against the voltage-gated potassium channel Kv1.4." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_5200044> rdfs:label "Reduced attention regulation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality in one's ability to control their attention towards a specific subject or task can include difficulties in changing or maintaining attention."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_5200045> rdfs:label "Reduced impulse control" ;
    dcterms:description "Reduced ability to control, or a failure to resist a temptation, urge, or impulse." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Impaired self-restraint" ;
    ns1:synonym "Impaired self-restraint" .

<http://purl.obolibrary.org/obo/HP_5200061> rdfs:label "Tactile hypersensitivity" ;
    dcterms:description "A decreased tolerance to physical touch." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_5200069> rdfs:label "Spinning"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An excessive frequency of spinning one's body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Twirling"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Twirling" .

<http://purl.obolibrary.org/obo/HP_5200134> rdfs:label "Jumping" ;
    dcterms:description "An excessive frequency of jumping in place." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pogo-ing"^^<http://example.org/invalidDatatype>,
        "Bouncing",
        "Hopping" ;
    ns1:synonym "Pogo-ing"^^<http://example.org/invalidDatatype>,
        "Bouncing",
        "Hopping" .

<http://purl.obolibrary.org/obo/HP_5200136> rdfs:label "Reduced social reciprocity" ;
    dcterms:description "Reduced responses to other people's emotions and/or a lack of modulation of behaviour according to social context." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced social reciprocity with peers" ;
    ns1:narrow_synonym "Reduced friendship reciprocity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced friendship reciprocity"^^<http://example.org/invalidDatatype>,
        "Reduced social reciprocity with peers" .

<http://purl.obolibrary.org/obo/HP_5200310> rdfs:label "Diminishment of social interactions"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction in the tendency of a person to seek or maintain social connections or interactions with others compared to previous norms for an individual."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced, declined or lessened social interactions"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced, declined or lessened social interactions"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_5200356> rdfs:label "Sleep onset rapid eye movement period"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Entering REM sleep immediately upon falling asleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Sleep-onset (REM) period"^^<http://example.org/invalidDatatype>,
        "SOREMP",
        "Sleep-onset rapid eye movement (REM) period" ;
    ns1:synonym "SOREMP"^^<http://example.org/invalidDatatype>,
        "Sleep-onset rapid eye movement (REM) period"^^<http://example.org/invalidDatatype>,
        "Sleep-onset (REM) period" .

<http://purl.obolibrary.org/obo/HP_5201016> rdfs:label "Submucous cleft palate"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A cleft of the muscular portion of the palate that is covered by mucous membrane." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Submucosal cleft palate"^^<http://example.org/invalidDatatype>,
        "Submucous clefting"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Submucosal cleft palate"^^<http://example.org/invalidDatatype>,
        "Submucous clefting"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6000029> rdfs:label "Social anxiety"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excessive fear of embarrassment, humiliation, or rejection when exposed to possible negative evaluation by others when engaged in a public performance or social interaction." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000109> rdfs:label "Supernumerary finger flexion crease" ;
    dcterms:description "The presence of an extra digital crease in and individual with normal joint anatomy."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000122> rdfs:label "Increased urinary N-acetylglucosamine-rich oligosaccharide level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Presence of N-acetylglucosamine-rich oligosaccharides in the urine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000147> rdfs:label "Elevated methylhex-dienedioic level by MRS"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of 3-methylhex-2,4-dienedioic acid or 3-methylhex-3,4-dienedioic acid in the brain identified by magnetic resonance spectroscopy (MRS)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000203> rdfs:label "Elevated CSF cholestanol concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of cholestanol in the cerebrospinal fluid (CSF) is above the upper limit of normal. Cholestanol is the 5-alpha-dihydro derivative of cholesterol." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated CSF cholestanol"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated CSF cholestanol" .

<http://purl.obolibrary.org/obo/HP_6000234> rdfs:label "Elevated circulating dihydroxyphenylacetic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of dihydroxyphenylacetic acid in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating DOPAC concentration" ;
    ns1:synonym "Elevated circulating DOPAC concentration" .

<http://purl.obolibrary.org/obo/HP_6000262> rdfs:label "Pseudoglioma" ;
    dcterms:description "A circumscribed whitish-yellow mass in the posterior chamber associated with retinal folds and sometimes retinal detachment and is said to resemble a retinal glioma."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000268> rdfs:label "Elevated circulating pipecolic acid concentration" ;
    dcterms:description "The concentration of pipecolic acid in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperpipecolatemia"^^<http://example.org/invalidDatatype>,
        "Pipecolic acid high in blood" ;
    ns1:synonym "Hyperpipecolatemia"^^<http://example.org/invalidDatatype>,
        "Pipecolic acid high in blood"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6000354> rdfs:label "Reduced aspartoacylase activity in cultured fibroblasts" ;
    dcterms:description "Activity of aspartoacylase below the lower limit of normal in cultured fibroblasts. Aspartoacylase (EC 3.5.1.15), also called aminoacylase-2, is an enzyme that hydrolyzes N-acetyl-L-aspartic acid (NAA) to aspartate and acetate."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000367> rdfs:label "Central thinning of the outer nuclear layer of the retina"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced thickness of the outer nuclear layer in the middle region of the retina. The outer nuclear layer (ONL) of the retina contains the nuclei of the cone and rod photoreceptors. Loss of the cellular machinery found in these nuclei causes irreparable loss of the photoreceptors and the capacity for visual function. This feature can be appreciated by directional optical coherence tomography." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Central thinning of the ONL"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Central thinning of the ONL" .

<http://purl.obolibrary.org/obo/HP_6000393> rdfs:label "Elevated urine trihydroxycholestanoic acid level" ;
    dcterms:description "Presence of trihydroxycholestanoic acid in the urine. Trihydroxycholestanoic acid is an intermediate in the biosynthesis of cholic acid. Elevated plasma levels of trihydroxycholestanoic acid have been found in patients with Zellweger syndrome." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urine THCA level"^^<http://example.org/invalidDatatype>,
        "Elevated urine trihydroxycoprostanic acid level" ;
    ns1:synonym "Elevated urine THCA level"^^<http://example.org/invalidDatatype>,
        "Elevated urine trihydroxycoprostanic acid level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6000396> rdfs:label "Elevated CSF guanidinoacetic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of guanidinoacetic acid in the cerebrospinal fluid (CSF) is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000447> rdfs:label "Decreased CSF asialotransferrin to transferrin ratio"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of asialotransferrin relative to that of transferrin in the cerebrospinal fluid (CSF) is below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000460> rdfs:label "Ectopic testis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Localization of the testis in an anatomic location other than the scrotum." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000465> rdfs:label "Elevated urine mesaconic acid level" ;
    dcterms:description "The amount of mesaconic acid in the urine, normalized for urine concentration, is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000466> rdfs:label "Elevated urine 3-methyladipic acid level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The amount of 3-methyladipic acid in the urine, normalized for urine concentration, is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000476> rdfs:label "Elevated circulating tetradecenoylcarnitine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of tetradecenoylcarnitine (C14:1) in the blood circulation is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000478> rdfs:label "Elevated circulating 2-trans,4-cis-decadienoylcarnitine concentration" ;
    dcterms:description "The concentration of 2-trans,4-cis-decadienoylcarnitine in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000490> rdfs:label "Impaired heel-walking ability" ;
    dcterms:description "Difficulty or reduced ability to walk on heels. Heel-walking can be tested as a part of the neurological examination. Foot dorsal extension weakness leads to difficulties in walking on heels." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000502> rdfs:label "Elevated circulating calprotectin concentration" ;
    dcterms:description "The concentration of calprotectin in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000503> rdfs:label "4-5 toe cutaneous syndactyly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A soft tissue continuity in the anteroposterior axis between the toes 4 and 5." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000509> rdfs:label "Elevated CSF L-2-hydroxyglutaric acid concentration" ;
    dcterms:description "The concentration of L-2-hydroxyglutaric acid in the cerebrospinal fluid (CSF) is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000556> rdfs:label "Reduced circulating dopamine beta-hydroxylase activity" ;
    dcterms:description "Concentration of Dopamine beta-hydroxylase (DBH; EC 1.14.17.1) in the blood circulation below the lower limit of normal. DBH catalyzes the oxidative hydroxylation of dopamine to norepinephrine." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000563> rdfs:label "Reduced sepiapterin reductase activity in cultured fibroblasts" ;
    dcterms:description "Activity of sepiapterin reductase (7,8-dihydrobiopterin:NADP+ oxidoreductase; EC 1.1.1.153) below the lower limit of normal in cultured fibroblasts." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000570> rdfs:label "Reduced tissue thymidine phosphorylase activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Activity of thymidine phosphorylase (EC 2.4.2.4) in the tissues below the lower limit of normal. The activity can be measured in multiple tissues including leukocytes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced leukocyte thymidine phosphorylase activity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced leukocyte thymidine phosphorylase activity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6000571> rdfs:label "Reduced tissue tripeptidyl peptidase 1 activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Activity of tripeptidyl peptidase 1 (TPP1;EC 3.4.14.9) in the tissues below the lower limit of normal. TTP1 activity can be measured in tissues including fibroblasts and leukocytes muscle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced leukocyte tripeptidyl peptidase 1 activity",
        "Reduced tripeptidyl peptidase 1 activity in cultured fibroblasts" ;
    ns1:synonym "Reduced leukocyte tripeptidyl peptidase 1 activity"^^<http://example.org/invalidDatatype>,
        "Reduced tripeptidyl peptidase 1 activity in cultured fibroblasts"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6000659> rdfs:label "Elevated muscle fiber laminin alpha 5 expression"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A decreased amount of laminin alpha-5 in muscle tissue. This feature can be shown by immunohistochemistry or Western blotting of muscle tissue. Laminin subunit alpha-5 is a protein encoded by the LAMA5 gene." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000675> rdfs:label "Elevated urinary mevalonate lactone level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The amount of mevalonate lactone in the urine, normalized for urine concentration, is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000709> rdfs:label "Absent Bell phenomenon"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The Bell phenomenon is the reflex upward movement of the front of the eyeball when the eyelids close (or blink). It protects the eye by helping to keep the cornea moist. This term refers to a lack of this phenomenon, which can be observed with certain conditions such as congenital fibrosis of the extraocular muscles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent palpebral-oculogyric reflex"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Absent palpebral-oculogyric reflex"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6000720> rdfs:label "Reduced tissue fatty aldehyde dehydrogenase activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Activity of fatty aldehyde dehydrogenase (EC 1.2.1.3) in tissues below the lower limit of normal. The activity can be measured in multiple tissues including culutured fibroblasts and leukocytes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000751> rdfs:label "Decreased urinary dopamine level" ;
    dcterms:description "The concentration of dopamine in the urine, normalized for urine concentration, is below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000752> rdfs:label "Elevated erythrocyte AICA-ribotide concentration" ;
    dcterms:description "Concentration of 5-amino-4-imidazolecarboxamide (AICA-riboside) in red blood cells is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000756> rdfs:label "Elevated urinary 5-hydroxyindoleacetic acid level" ;
    dcterms:description "The amount of 5-hydroxyindoleacetic acid (5-HIAA) in the urine, normalized for urine concentration, is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000783> rdfs:label "Reduced tissue palmitoyl-protein thioesterase activity" ;
    dcterms:description "Activity of the enzyme palmitoyl-protein thioesterase (PPT; EC 3.1.2.22) in tissues below the lower limit of normal. The activity can be measured in multiple tissues including culutured fibroblasts and leukocytes." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000821> rdfs:label "Elevated circulating bile alcohol concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of bile alcohols in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000830> rdfs:label "Diminished alpha-ketoglutarate dehydrogenase activity in cultured fibroblasts"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration or activity of the alpha-ketoglutarate dehydrogenase complex as measured in cultured fibroblasts is below the limits of normal. This enzyme is a multienzyme complex consisting of 3 protein subunits, oxoglutarate dehydrogenase, also known as alpha-ketoglutarate dehydrogenase or E1k (EC 1.2.4.2.), dihydrolipoyl succinyltransferase (DLST, or E2k; 126063), and dihydrolipoyl dehydrogenase (DLD, or E3; 238331). The complex catalyzes a key reaction in the Krebs tricarboxylic acid cycle." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000833> rdfs:label "Hyperkalemia while symptomatic" ;
    dcterms:description "Increased concentration of potassium in the blood circulation specifically measured during a disease flareup, attack, or exacerbation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperkalemia during attack"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hyperkalemia during attack" .

<http://purl.obolibrary.org/obo/HP_6000864> rdfs:label "Transverse smile"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inability to raise the corners of the mouth during the act of smiling due to facial muscle weakness. The act of smiling is accompanied by a horizontal movement of the mouth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000881> rdfs:label "Anti-DCC netrin 1 receptor antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies in the serum that react against Netrin-1 receptors DCC (deleted in colorectal carcinoma)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000882> rdfs:label "Anti-recoverin antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies in the serum that react against recoverin. Recoverins are calcium-binding proteins primarily expressed in retinal rod photoreceptors and primarily involved in phototransduction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-retinal CAR antigen antibody" ;
    ns1:synonym "Anti-retinal CAR antigen antibody" .

<http://purl.obolibrary.org/obo/HP_6000915> rdfs:label "Dysorthography" ;
    dcterms:description "A specific disorder of spelling. A score on a standardized spelling test is at least two standard errors of prediction below the level expected on the basis of the child's chronological age and general intelligence in the context of scores on reading accuracy and comprehension and on arithmetic that are within the normal range (within two standard deviations from the mean)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000988> rdfs:label "Cochlear nerve aplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A developmental defect causing an absence of the cochlear nerve resulting in sensorineural hearing loss."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000989> rdfs:label "Slit-like lateral ventricle"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally small lateral ventricle with a slit-like appearance."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000993> rdfs:label "Pupillary hypersensitivity to parasympathomimetic agents" ;
    dcterms:description "A higher than normal tendency of parasympathomimetic agents to induce miosis." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000994> rdfs:label "Lack of pupillary response to hydroxyamphetamine" ;
    dcterms:description "4-hydroxyamphetamine is used in eye drops to dilate the pupil, e.g.., to induce mydriasis for fundus examinations. This term refers to a lack of response of the pupil to topical application of 4-hydroxyamphetamine." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000995> rdfs:label "Subcortical U fiber lesion" ;
    dcterms:description "Abnormal morphology of subcortical U fibers, typically as assessed by abnromal intensity on magnetic resonance imaging of the brain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Subcortical U fiber involvement" ;
    ns1:synonym "Subcortical U fiber involvement" .

<http://purl.obolibrary.org/obo/HP_6001007> rdfs:label "Elevated urinary bile alcohol level" ;
    dcterms:description "The amount of bile alcohol in the urine, normalized for urine concentration, is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001010> rdfs:label "Inability to protrude lips" ;
    dcterms:description "Lack of ability to purse or pucker the lips." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001011> rdfs:label "Wet voice"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Wet voice is a perceptual vocal quality that is gurgly or liquid sounding and is due to the voice being produced through moisture. It is commonly used as an indicator of penetration and/or aspiration in clinical swallowing assessments and bedside screening tests." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001054> rdfs:label "Intoeing"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal gait caused by a rotational variation anywhere in the lower extremity that causes the foot to point inward, instead of pointing straight ahead or outward, when walking or running." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pigeon-toed" ;
    ns1:synonym "Pigeon-toed"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6001062> rdfs:label "Eosinophilic neuronal inclusion bodies"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of intracellular inclusion bodies (aggregates of stainable substances, usually proteins) in neurons that stain with eosin, a red or pink dye." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001070> rdfs:label "Subdural hygroma" ;
    dcterms:description "Accumulation of cerebral spinal fluid in the subdural space." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001102> rdfs:label "Inability to puff cheeks"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced ability to inflate the cheeks by blowing air into them while keeping the lips closed." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001115> rdfs:label "EEG with temporal slowing" ;
    dcterms:description "Slow-wave activity observed in the temporal area of the scalp electro-encephalogram (EEG)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EEG with slow activity in temporal lobes",
        "EEG with slow-wave activity involving the temporal lobes" ;
    ns1:synonym "EEG with slow-wave activity involving the temporal lobes"^^<http://example.org/invalidDatatype>,
        "EEG with slow activity in temporal lobes" .

<http://purl.obolibrary.org/obo/HP_6001124> rdfs:label "Sphenoid wing dysplasia" ;
    dcterms:description "Hypoplasia or aplasia of the greater or lesser wing of the sphenoid bone, typically resulting in widening of the superior orbital fissure, elevation of the [lesser sphenoid wing, and ipsilateral orbital enlargement." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001181> rdfs:label "Choroid thickening"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A condition characterized by an abnormal increase in the thickness of the choroid, which may be associated with various ocular or systemic conditions. Choroid thickening can be measured using imaging techniques such as optical coherence tomography (OCT)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased choroidal thickness"^^<http://example.org/invalidDatatype>,
        "Pachychoroid"^^<http://example.org/invalidDatatype>,
        "Thickened choroid" ;
    ns1:synonym "Increased choroidal thickness"^^<http://example.org/invalidDatatype>,
        "Pachychoroid"^^<http://example.org/invalidDatatype>,
        "Thickened choroid" .

<http://purl.obolibrary.org/obo/HP_6001185> rdfs:label "Elevated circulating glucosylsphingosine concentration" ;
    dcterms:description "Concentration of D-glucosylsphingosine in the blood circulation above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001189> rdfs:label "Onychoheterotopia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Growth of nail tissue outside the ungual plate, generally in the finger." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ectopic fingernail"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Ectopic fingernail" .

<http://purl.obolibrary.org/obo/HP_6001360> rdfs:label "Hyperlordotic gait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A gait abnormality characterized by excessive lumbar lordosis (swayback posture, i.e., an inward curvature of the lower spine) and gait pattern with forward tilt of the pelvis and increased lumbar curvature. Hyperlordotic gait is often as a compensatory mechanism for hip extensor weakness, proximal muscle weakness, or hip flexion contracture." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Gait with exaggerated lumbar lordosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Gait with exaggerated lumbar lordosis" .

<http://purl.obolibrary.org/obo/HP_6001380> rdfs:label "Elevated circulating lysosphingomyelin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of lysosphingomyelin in the blood circulation is above the upper limit of normal. Acid sphingomyelinase deficiency (ASMD) or Niemann-Pick type A/B is a lysosomal disorder caused by the deficiency of acid sphingomyelinase (ASM) due to pathogenic variants in the SMPD1 gene. Sphingomyelin (SM) is the substrate for ASM that cleaves the phosphorylcholine linkage of SM producing ceramide. SM is a major compound of most cell membranes and coupled with cholesterol constitutes most of the membrane rafts. In the deficiency of ASM, there is primary storage of SM, and the concentration of lysosphingomyelin in dried blood spots and in the blood circulation is typically elevated." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6001439> rdfs:label "Tigroid fundus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Enhanced visibility of large choroidal vessels through the retinal pigment epithelium (RPE). This reticulated pattern is commonly observed on fundus examination and color fundus photography. Such hypopigmented areas alternate with hyperpigmented zones in a tigroid pattern. Fundus tessellation is often associated with myopia and choroidal thinning."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fundus tesselation"^^<http://example.org/invalidDatatype>,
        "Tessellated fundus"^^<http://example.org/invalidDatatype>,
        "Mosaic fundus" ;
    ns1:synonym "Fundus tesselation"^^<http://example.org/invalidDatatype>,
        "Mosaic fundus"^^<http://example.org/invalidDatatype>,
        "Tessellated fundus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_6001454> rdfs:label "Putaminal eye sign" ;
    dcterms:description "An imaging anomly of the putamen that is thought to be pathognomic for MEGDEL syndrome (3-MethylGlutaconic aciduria, Deafness, Encephalopathy, Leigh-like syndrome MIM #614739). In stage 1 of the disease, T2 signal changes of the pallidum are present. In stage 2, swelling of the putamen and caudate nucleus is seen. The dorsal putamen contains an eye that shows no signal alteration and (thus) seems to be spared during this stage of the disease. It later increases, reflecting progressive putaminal involvement. Sparing of the mid dorsal putamen (showing normal signal surrounded by T2 hyperintense signal) is referred to as the putaminal eye."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/MONDO_0000211> rdfs:label "striatal degeneration, autosomal dominant"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An adult-onset movement disorder characterized by bradykinesia, dysarthria and muscle rigidity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "ADSD"^^<http://example.org/invalidDatatype>,
        "autosomal dominant striatal neurodegeneration"^^<http://example.org/invalidDatatype> ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0001260>,
        <http://purl.obolibrary.org/obo/HP_0001288>,
        <http://purl.obolibrary.org/obo/HP_0002015>,
        <http://purl.obolibrary.org/obo/HP_0002063>,
        <http://purl.obolibrary.org/obo/HP_0002067>,
        <http://purl.obolibrary.org/obo/HP_0002075>,
        <http://purl.obolibrary.org/obo/HP_0100022> ;
    ns1:synonym "ADSD",
        "autosomal dominant striatal neurodegeneration" ;
    ns1:xref "GARD:0017146"^^<http://example.org/invalidDatatype>,
        "MEDGEN:322971"^^<http://example.org/invalidDatatype>,
        "OMIMPS:609161"^^<http://example.org/invalidDatatype>,
        "MESH:C563783",
        "Orphanet:228169",
        "UMLS:C1836694" .

<http://purl.obolibrary.org/obo/MONDO_0000902> rdfs:label "agenesis of the corpus callosum with peripheral neuropathy" ;
    dcterms:description "Corpus callosum agenesis-neuropathy is a neurodegenerative disorder characterized by severe progressive sensorimotor neuropathy beginning in infancy with resulting hypotonia, areflexia, amyotrophy and variable degrees of dysgenesis of the corpus callosum. Additional features include mild-to-severe intellectual and developmental delays, and psychiatric manifestations that include paranoid delusions, depression, hallucinations, and \"autistic-like\" features. Affected individuals are usually wheelchair restricted in the second decade of life and die in the third decade of life. The disease is inherited as an autosomal recessive trait." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "corpus callosum agenesis-neuronopathy syndrome"^^<http://example.org/invalidDatatype>,
        "hereditary motor and sensory neuropathy with agenesis of the corpus callosum"^^<http://example.org/invalidDatatype>,
        "peripheral neuropathy associated with agenesis of the corpus callosum"^^<http://example.org/invalidDatatype>,
        "Andermann syndrome",
        "Charlevoix disease",
        "agenesis of the corpus callosum with peripheral neuropathy" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0000218>,
        <http://purl.obolibrary.org/obo/HP_0000248>,
        <http://purl.obolibrary.org/obo/HP_0000252>,
        <http://purl.obolibrary.org/obo/HP_0000262>,
        <http://purl.obolibrary.org/obo/HP_0000276>,
        <http://purl.obolibrary.org/obo/HP_0000294>,
        <http://purl.obolibrary.org/obo/HP_0000316>,
        <http://purl.obolibrary.org/obo/HP_0000324>,
        <http://purl.obolibrary.org/obo/HP_0000327>,
        <http://purl.obolibrary.org/obo/HP_0000341>,
        <http://purl.obolibrary.org/obo/HP_0000400>,
        <http://purl.obolibrary.org/obo/HP_0000431>,
        <http://purl.obolibrary.org/obo/HP_0000486>,
        <http://purl.obolibrary.org/obo/HP_0000508>,
        <http://purl.obolibrary.org/obo/HP_0000545>,
        <http://purl.obolibrary.org/obo/HP_0000565>,
        <http://purl.obolibrary.org/obo/HP_0000639>,
        <http://purl.obolibrary.org/obo/HP_0000709>,
        <http://purl.obolibrary.org/obo/HP_0000762>,
        <http://purl.obolibrary.org/obo/HP_0000763>,
        <http://purl.obolibrary.org/obo/HP_0001182>,
        <http://purl.obolibrary.org/obo/HP_0001249>,
        <http://purl.obolibrary.org/obo/HP_0001250>,
        <http://purl.obolibrary.org/obo/HP_0001252>,
        <http://purl.obolibrary.org/obo/HP_0001256>,
        <http://purl.obolibrary.org/obo/HP_0001263>,
        <http://purl.obolibrary.org/obo/HP_0001270>,
        <http://purl.obolibrary.org/obo/HP_0001271>,
        <http://purl.obolibrary.org/obo/HP_0001274>,
        <http://purl.obolibrary.org/obo/HP_0001284>,
        <http://purl.obolibrary.org/obo/HP_0001319>,
        <http://purl.obolibrary.org/obo/HP_0001337>,
        <http://purl.obolibrary.org/obo/HP_0001344>,
        <http://purl.obolibrary.org/obo/HP_0001349>,
        <http://purl.obolibrary.org/obo/HP_0001363>,
        <http://purl.obolibrary.org/obo/HP_0001371>,
        <http://purl.obolibrary.org/obo/HP_0002091>,
        <http://purl.obolibrary.org/obo/HP_0002119>,
        <http://purl.obolibrary.org/obo/HP_0002353>,
        <http://purl.obolibrary.org/obo/HP_0002410>,
        <http://purl.obolibrary.org/obo/HP_0002540>,
        <http://purl.obolibrary.org/obo/HP_0002650>,
        <http://purl.obolibrary.org/obo/HP_0002922>,
