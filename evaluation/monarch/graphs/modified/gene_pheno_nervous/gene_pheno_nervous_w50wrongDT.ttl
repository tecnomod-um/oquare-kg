<http://purl.obolibrary.org/obo/MONDO_0013316> rdfs:label "occult macular dystrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Occult macular dystrophy is a rare, genetic retinal dystrophy disease characterized by bilateral progressive decline of visual acuity, due to retinal dysfunction confined only to the macula, associated with normal fundus and fluorescein angiograms and severely attenuated focal macular and multifocal electroretinograms." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "OCMD"^^<http://example.org/invalidDatatype>,
