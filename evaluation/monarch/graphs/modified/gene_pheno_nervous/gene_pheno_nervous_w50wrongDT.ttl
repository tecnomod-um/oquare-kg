<http://purl.obolibrary.org/obo/HP_0000081> rdfs:label "Duplicated collecting system"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A duplication of the collecting system of the kidney, defined as a kidney with two (instead of, normally, one) pyelocaliceal systems. The pyelocaliceal system is comprised of the renal pelvis and calices. The duplicated renal collecting system can be associated with a single ureter or with double ureters. In the latter case, the two ureters empty separately into the bladder or fuse to form a single ureteral orifice." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Duplicated renal collecting system"^^<http://example.org/invalidDatatype>,
        "Double collecting system",
        "Double urinary collecting systems on intravenous pyelography",
        "Duplex collecting system" ;
    ns1:synonym "Duplex collecting system"^^<http://example.org/invalidDatatype>,
        "Duplicated renal collecting system"^^<http://example.org/invalidDatatype>,
        "Double collecting system",
        "Double urinary collecting systems on intravenous pyelography" ;
    ns1:xref "UMLS:C1858565" .

