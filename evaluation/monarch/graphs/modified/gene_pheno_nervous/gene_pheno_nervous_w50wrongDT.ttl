<http://purl.obolibrary.org/obo/HP_0012534> rdfs:label "Dysesthesia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Painful sensations elicited by a nonpainful cutaneous stimulus such as a light touch or gentle stroking over affected areas of the body. Sometimes referred to as hyperpathia or hyperalgesia. Often perceived as an intense burning, dyesthesias may outlast the stimulus by several seconds." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperalgesia"^^<http://example.org/invalidDatatype>,
        "Dysaesthesia",
