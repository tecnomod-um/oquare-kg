<http://purl.obolibrary.org/obo/HP_0007002> rdfs:label "Motor axonal neuropathy" ;
    dcterms:description "Progressive impairment of function of motor axons with muscle weakness, atrophy, and cramps. The deficits are length-dependent, meaning that muscles innervated by the longest nerves are affected first, so that for instance the arms are affected at a later age than the onset of deficits involving the lower leg."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Distal motor neuropathy"^^<http://example.org/invalidDatatype>,
        "Length dependent motor neuropathy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Distal motor neuropathy",
        "Length dependent motor neuropathy" ;
    ns1:xref "UMLS:C1854570"^^<http://example.org/invalidDatatype>,
        "UMLS:C2749625"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020811"^^<http://example.org/invalidDatatype> .

