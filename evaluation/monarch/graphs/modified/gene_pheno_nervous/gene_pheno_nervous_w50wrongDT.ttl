        "SNOMEDCT_US:94706008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0685707" .

<http://purl.obolibrary.org/obo/HP_0011703> rdfs:label "Sinus tachycardia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Heart rate of greater than 100 beats per minute."^^<http://example.org/invalidDatatype> ;
