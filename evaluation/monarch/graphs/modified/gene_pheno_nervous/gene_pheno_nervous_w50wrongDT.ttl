<http://purl.obolibrary.org/obo/HP_0001332> rdfs:label "Dystonia" ;
    dcterms:description "An abnormally increased muscular tone that causes fixed abnormal postures. There is a slow, intermittent twisting motion that leads to exaggerated turning and posture of the extremities and trunk."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dystonic movements" ;
