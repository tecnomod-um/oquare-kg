<http://purl.obolibrary.org/obo/HP_0001047> rdfs:label "Atopic dermatitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atopic dermatitis (AD) or atopic eczema is an itchy, inflammatory skin condition with a predilection for the skin flexures. It is characterized by poorly defined erythema with edema, vesicles, and weeping in the acute stage and skin thickening (lichenification) in the chronic stage." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Allergic eczema"^^<http://example.org/invalidDatatype>,
        "Atopic eczema"^^<http://example.org/invalidDatatype>,
