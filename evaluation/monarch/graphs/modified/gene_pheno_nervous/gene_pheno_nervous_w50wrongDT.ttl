    ns1:xref "UMLS:C0426790"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:249671009" .

<http://purl.obolibrary.org/obo/HP_0000870> rdfs:label "Increased circulating prolactin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of abnormally increased levels of prolactin in the blood. Prolactin is a peptide hormone produced by the anterior pituitary gland that plays a role in breast development and lactation during pregnancy."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperprolactinaemia"^^<http://example.org/invalidDatatype>,
        "Hyperprolactinemia"^^<http://example.org/invalidDatatype>,
