    ns1:xref "UMLS:C1856478"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007985> rdfs:label "Retinal arteriolar occlusion"^^<http://example.org/invalidDatatype> ;
