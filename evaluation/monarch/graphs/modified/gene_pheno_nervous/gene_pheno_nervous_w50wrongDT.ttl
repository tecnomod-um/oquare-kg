    dcterms:description "Muscular hypotonia (abnormally low muscle tone) manifesting in the neonatal period."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypotonia, neonatal"^^<http://example.org/invalidDatatype>,
        "Low muscle tone, in neonatal onset"^^<http://example.org/invalidDatatype>,
        "Hypotonia, in neonatal onset" ;
    ns1:related_synonym "Congenital hypotonia" ;
    ns1:synonym "Congenital hypotonia"^^<http://example.org/invalidDatatype>,
        "Hypotonia, in neonatal onset",
        "Hypotonia, neonatal",
        "Low muscle tone, in neonatal onset" ;
    ns1:xref "SNOMEDCT_US:205294008",
        "UMLS:C2267233" .

<http://purl.obolibrary.org/obo/HP_0001320> rdfs:label "Cerebellar vermis hypoplasia" ;
    dcterms:description "Underdevelopment of the vermis of cerebellum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplasia of the cerebellar vermis"^^<http://example.org/invalidDatatype>,
        "Cerebellar vermal hypoplasia",
        "Hypoplastic cerebellar vermis" ;
    ns1:synonym "Cerebellar vermal hypoplasia"^^<http://example.org/invalidDatatype>,
        "Hypoplastic cerebellar vermis"^^<http://example.org/invalidDatatype>,
        "Hypoplasia of the cerebellar vermis" ;
    ns1:xref "UMLS:C1840379" .

<http://purl.obolibrary.org/obo/HP_0000322> rdfs:label "Short philtrum" ;
    dcterms:description "Distance between nasal base and midline upper lip vermilion border more than 2 SD below the mean. Alternatively, an apparently decreased distance between nasal base and midline upper lip vermilion border."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased height of philtrum",
        "Decreased length of philtrum",
        "Decreased vertical dimension of philtrum",
        "Vertical hypoplasia of philtrum" ;
    ns1:synonym "Decreased vertical dimension of philtrum"^^<http://example.org/invalidDatatype>,
        "Vertical hypoplasia of philtrum"^^<http://example.org/invalidDatatype>,
        "Decreased height of philtrum",
        "Decreased length of philtrum" ;
    ns1:xref "UMLS:C1861324"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002307> rdfs:label "Drooling" ;
    dcterms:description "Habitual flow of saliva out of the mouth." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dribbling"^^<http://example.org/invalidDatatype>,
        "Drooling"^^<http://example.org/invalidDatatype>,
        "Sialorrhea"^^<http://example.org/invalidDatatype> ;
