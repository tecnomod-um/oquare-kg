<http://purl.obolibrary.org/obo/HP_0009890> rdfs:label "High anterior hairline"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Distance between the hairline (trichion) and the glabella (the most prominent point on the frontal bone above the root of the nose), in the midline, more than two SD above the mean. Alternatively, an apparently increased distance between the hairline and the glabella." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High frontal hairline" ;
    ns1:synonym "High frontal hairline"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C3276036"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010550> rdfs:label "Paraplegia" ;
    dcterms:description "Severe or complete weakness of both lower extremities with sparing of the upper extremities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Leg paralysis" ;
    ns1:synonym "Leg paralysis" ;
    ns1:xref "SNOMEDCT_US:60389000",
        "UMLS:C0030486" .

<http://purl.obolibrary.org/obo/HP_0010830> rdfs:label "Impaired tactile sensation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduced sense of touch (tactile sensation). This is usually tested with a wisp of cotton or a fine camel's hair brush, by asking patients to say 'now' each time they feel the stimulus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Loss of tactile sensation"^^<http://example.org/invalidDatatype>,
        "Abnormal thigmesthesia",
        "Impaired touch sensation" ;
    ns1:synonym "Abnormal thigmesthesia"^^<http://example.org/invalidDatatype>,
        "Impaired touch sensation"^^<http://example.org/invalidDatatype>,
        "Loss of tactile sensation" ;
    ns1:xref "UMLS:C4021221"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011505> rdfs:label "Cystoid macular edema" ;
    dcterms:description "Cystoid thickening of the retina that takes place due to accumulation of extracellular fluid in the macula as a nonspecific response to blood-retinal barrier breakdown. Histological studies show that radially orientated cystoid spaces consisting of ophthalmoscopically clear fluid are often clinically detectable in the macula area."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cystoid macular edema" ;
    ns1:synonym "Cystoid macular edema"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0024440"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:193387007" .

<http://purl.obolibrary.org/obo/HP_0012379> rdfs:label "Abnormal circulating enzyme concentration or activity" ;
    dcterms:description "Concentration or activity of an enzyme is above or below the limits of normal in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022922" .

<http://purl.obolibrary.org/obo/HP_0025373> rdfs:label "Interictal EEG abnormality"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Interictal refers to a period of time between epileptic seizures. Electroencephalographic (EEG) patterns are important in the differential diagnosis of epilepsy, and the EEG is almost always abnormal during a seizure. Some persons with seizures may show EEG abnormalities between seizures, while others do not. In some cases, multiple interictal EEGs must be recorded before an abnormality is observed. In most cases the electrographic pattern of seizure onset is completely different from the activity recorded during interictal discharge." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0045084> rdfs:label "Limb myoclonus" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Myoclonus of limbs" ;
    ns1:synonym "Myoclonus of limbs"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000202> rdfs:label "Orofacial cleft"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a cleft (gap, opening, or groove) in the oral cavity, including cleft of the upper lip and/or cleft of the palate. Cleft of the upper lip is visible as a groove or fissure in the lip, most frequently due to a congenital failure of the maxillary and median nasal processes to fuse. Cleft palate is characterized by a grooved depression or fissure in the roof of the mouth, most often resulting from a congenital failure of the palate to fuse properly. Clefts of the lip and palate can occur individually or together. It is preferable to code each defect separately."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Oral cleft"^^<http://example.org/invalidDatatype>,
        "Cleft of the mouth",
        "Oral clefting" ;
    ns1:narrow_synonym "Cleft lip, cleft palate" ;
    ns1:related_synonym "Cleft lip/palate"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Cleft lip, cleft palate"^^<http://example.org/invalidDatatype>,
        "Cleft lip/palate"^^<http://example.org/invalidDatatype>,
        "Oral cleft"^^<http://example.org/invalidDatatype>,
        "Cleft of the mouth",
        "Oral clefting" ;
    ns1:xref "SNOMEDCT_US:66948001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:253983005",
        "UMLS:C0158646",
        "UMLS:C4021813" .

