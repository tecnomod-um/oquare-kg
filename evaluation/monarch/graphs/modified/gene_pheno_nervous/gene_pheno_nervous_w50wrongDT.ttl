<http://purl.obolibrary.org/obo/HP_0100753> rdfs:label "Schizophrenia" ;
    dcterms:description "A mental disorder characterized by a disintegration of thought processes and emotional responsiveness. It most commonly manifests as auditory hallucinations, paranoid or bizarre delusions, or disorganized speech and thinking. It is accompanied by significant social or occupational dysfunction. The onset of symptoms typically occurs in young adulthood, with a global lifetime prevalence of about 1%. This term is not a helpful parent term to describe abnormal experiences."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:191526005"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:58214004",
        "UMLS:C0036341" .

