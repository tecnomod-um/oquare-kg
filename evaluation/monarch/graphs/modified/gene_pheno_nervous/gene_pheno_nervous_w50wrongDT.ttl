    ns1:exact_synonym "Muscular subaortic stenosis" ;
    ns1:synonym "Muscular subaortic stenosis"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C3887554"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001708> rdfs:label "Right ventricular failure" ;
    dcterms:description "Reduced ability of the right ventricle to perform its function (to receive blood from the right atrium and to eject blood into the pulmonary artery), often leading to pitting peripheral edema, ascites, and hepatomegaly."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Impaired right ventricular function"^^<http://example.org/invalidDatatype>,
