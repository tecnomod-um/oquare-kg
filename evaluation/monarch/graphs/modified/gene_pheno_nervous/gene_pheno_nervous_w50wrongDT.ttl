<http://purl.obolibrary.org/obo/HP_0002445> rdfs:label "Tetraplegia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Paralysis of all four limbs, and trunk of the body below the level of an associated injury to the spinal cord. The etiology of quadriplegia is similar to that of paraplegia except that the lesion is in the cervical spinal cord rather than in the thoracic or lumbar segments of the spinal cord." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Paralysis of all four limbs"^^<http://example.org/invalidDatatype>,
        "Quadriplegia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Paralysis of all four limbs"^^<http://example.org/invalidDatatype>,
        "Quadriplegia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0034372"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:11538006" .

<http://purl.obolibrary.org/obo/HP_0002483> rdfs:label "Bulbar signs" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1856507"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002835> rdfs:label "Aspiration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inspiration of a foreign object into the airway."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Pulmonary aspiration" ;
    ns1:synonym "Pulmonary aspiration" ;
    ns1:xref "SNOMEDCT_US:68052005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0700198"^^<http://example.org/invalidDatatype>,
        "UMLS:C2712334"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:413585005" .

<http://purl.obolibrary.org/obo/HP_0003403> rdfs:label "EMG: decremental response of compound muscle action potential to repetitive nerve stimulation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A compound muscle action potential (CMAP) is a type of electromyography (EMG). CMAP refers to a group of almost simultaneous action potentials from several muscle fibers in the same area evoked by stimulation of the supplying motor nerve and are recorded as one multipeaked summated action potential. This abnormality refers to a greater than normal decrease in the amplitude during the course of the investigation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EMG: decremental response of CMAP to repetitive nerve stimulation" ;
    ns1:related_synonym "EMG: decrement at repetitive stimulation" ;
    ns1:synonym "EMG: decrement at repetitive stimulation",
        "EMG: decremental response of CMAP to repetitive nerve stimulation" ;
    ns1:xref "UMLS:C4020841"^^<http://example.org/invalidDatatype>,
        "UMLS:C4021728"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003470> rdfs:label "Paralysis" ;
    dcterms:description "Paralysis of voluntary muscles means loss of contraction due to interruption of one or more motor pathways from the brain to the muscle fibers. Although the word paralysis is often used interchangeably to mean either complete or partial loss of muscle strength, it is preferable to use paralysis or plegia for complete or severe loss of muscle strength, and paresis for partial or slight loss. Motor paralysis results from deficits of the upper motor neurons (corticospinal, corticobulbar, or subcorticospinal). Motor paralysis is often accompanied by an impairment in the facility of movement."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inability to move",
        "Paralysis" ;
    ns1:synonym "Inability to move",
        "Paralysis" ;
    ns1:xref "SNOMEDCT_US:44695005",
        "UMLS:C0522224" .

<http://purl.obolibrary.org/obo/HP_0006610> rdfs:label "Wide intermamillary distance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A larger than usual distance between the left and right nipple." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Wide-spaced nipples"^^<http://example.org/invalidDatatype>,
        "Widely spaced nipples",
        "Widely-spaced nipples" ;
    ns1:synonym "Widely spaced nipples"^^<http://example.org/invalidDatatype>,
        "Widely-spaced nipples"^^<http://example.org/invalidDatatype>,
        "Wide-spaced nipples" ;
    ns1:xref "SNOMEDCT_US:423230008"^^<http://example.org/invalidDatatype>,
        "UMLS:C1827524" .

<http://purl.obolibrary.org/obo/HP_0006895> rdfs:label "Lower limb hypertonia"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1845245" .

<http://purl.obolibrary.org/obo/HP_0007108> rdfs:label "Demyelinating peripheral neuropathy" ;
    dcterms:description "Demyelinating neuropathy is characterized by slow nerve conduction velocities with reduced amplitudes of sensory/motor nerve conduction and prolonged distal latencies." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:23414001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0270922"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007305> rdfs:label "CNS demyelination"^^<http://example.org/invalidDatatype> ;
