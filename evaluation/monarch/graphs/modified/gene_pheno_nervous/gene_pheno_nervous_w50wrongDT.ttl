<http://purl.obolibrary.org/obo/HP_0100651> rdfs:label "Type I diabetes mellitus" ;
    dcterms:description "A chronic condition in which the pancreas produces little or no insulin. Type I diabetes mellitus is manifested by the sudden onset of severe hyperglycemia with rapid progression to diabetic ketoacidosis unless treated with insulin." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Type 1 diabetes"^^<http://example.org/invalidDatatype>,
        "Diabetes mellitus Type I",
