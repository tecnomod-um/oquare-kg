<http://purl.obolibrary.org/obo/HP_0000100> rdfs:label "Nephrotic syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Nephrotic syndrome is a collection of findings resulting from glomerular dysfunction with an increase in glomerular capillary wall permeability associated with pronounced proteinuria. Nephrotic syndrome refers to the constellation of clinical findings that result from severe renal loss of protein, with Proteinuria and hypoalbuminemia, edema, and hyperlipidemia."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nephrosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nephrosis" ;
