<http://purl.obolibrary.org/obo/HP_0002549> rdfs:label "Deficit in phonologic short-term memory"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Impaired ability to repeat non-word sounds. The test for nonword repetition involves the repetition of nonsensical words of increasing length and complexity and is regarded as a measure of phonological (speech sound) processing and short-term memory" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Deficit in non-word repetition"^^<http://example.org/invalidDatatype>,
