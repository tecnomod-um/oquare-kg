<http://purl.obolibrary.org/obo/HP_0001363> rdfs:label "Craniosynostosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Craniosynostosis refers to the premature closure of the cranial sutures. Primary craniosynostosis refers to the closure of one or more sutures due to abnormalities in skull development, and secondary craniosynostosis results from failure of brain growth."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Deformity of the skull" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Craniosyostosis"^^<http://example.org/invalidDatatype>,
