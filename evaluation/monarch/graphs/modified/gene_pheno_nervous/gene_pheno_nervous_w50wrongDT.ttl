<http://purl.obolibrary.org/obo/HP_0001340> rdfs:label "Enhancement of the C-reflex"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increase in amplitude of a long-loop response upon somatosensory evoked potential testing, representing an electrically evoked myoclonic response." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3552824"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001351> rdfs:label "Jerk-locked premyoclonus spikes" ;
    dcterms:description "Jerk-locked averaging (JLA) is used to record the timing and distribution of brain activity preceding brisk involuntary movements such as those observed in patients with myoclonus. JLA is capable of revealing a premyoclonus spike in the absence of paroxysmal activity in the routine EEG." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3552825"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001406> rdfs:label "Intrahepatic cholestasis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Impairment of bile flow due to obstruction in the small bile ducts within the liver."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Impaired release of bile from liver" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Impaired release of bile from liver"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:4637005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0008372"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001413> rdfs:label "Micronodular cirrhosis" ;
    dcterms:description "A type of cirrhosis characterized by the presence of small regenerative nodules." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:21861000",
