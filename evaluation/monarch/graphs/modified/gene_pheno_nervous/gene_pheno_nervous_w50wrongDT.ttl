        "Increased international normalised ratio",
        "Low factor II activity",
        "Prolonged PT" ;
    ns1:synonym "Increased international normalized ratio"^^<http://example.org/invalidDatatype>,
        "Low factor II activity"^^<http://example.org/invalidDatatype>,
        "Prolonged PT"^^<http://example.org/invalidDatatype>,
        "Increased INR",
        "Increased international normalised ratio",
        "Reduced factor II activity",
        "Reduced prothrombin activity" ;
    ns1:xref "UMLS:C0151872"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:409674002" .

