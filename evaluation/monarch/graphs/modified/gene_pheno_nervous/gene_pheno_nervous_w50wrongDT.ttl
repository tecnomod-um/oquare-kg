        "Muscle biopsy shows dystrophic changes" ;
    ns1:xref "SNOMEDCT_US:73297009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0026850"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:193225000",
        "UMLS:C1864711" .

