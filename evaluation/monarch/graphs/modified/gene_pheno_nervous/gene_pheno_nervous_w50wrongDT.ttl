<http://purl.obolibrary.org/obo/HP_0100954> rdfs:label "Open operculum" ;
    dcterms:description "Underdevelopment of the operculum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C2675973" .

<http://purl.obolibrary.org/obo/HP_0200020> rdfs:label "Corneal erosion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An erosion or abrasion of the cornea's outermost layer of epithelial cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Damage to outer layer of the cornea of the eye" ;
    ns1:synonym "Damage to outer layer of the cornea of the eye"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:50792001",
        "UMLS:C0392163" .

<http://purl.obolibrary.org/obo/HP_0200025> rdfs:label "Mandibular pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the mandible." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lower jaw pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Lower jaw pain"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:274667000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0236000"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410005> rdfs:label "Cleft hard palate" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cleft bony palate"^^<http://example.org/invalidDatatype>,
        "Cleft of hard palate" ;
    ns1:synonym "Cleft bony palate",
        "Cleft of hard palate" ;
    ns1:xref "SNOMEDCT_US:448915004",
        "UMLS:C0432090" .

<http://purl.obolibrary.org/obo/HP_0410031> rdfs:label "Submucous cleft of soft and hard palate"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Soft and hard-palate submucous clefts are characterized by bony defects in the midline of the soft and hard palate that are covered by the lining (ie mucous membrane) of the roof of the mouth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410174> rdfs:label "Increased circulating troponin T concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased concentration of tropnin T in the blood, which is a cardiac regulatory protein that controls the calcium mediated interaction between actin and myosin. Raised cardiac troponin concentrations are now accepted as the standard biochemical marker for the diagnosis of myocardial infarction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased troponin T level in blood"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased troponin T level in blood" .

<http://purl.obolibrary.org/obo/HP_0430015> rdfs:label "Abnormal morphology of musculature of pharynx" ;
    dcterms:description "An abnormality of any of the muscles of the pharynx."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of muscles of the pharynx"^^<http://example.org/invalidDatatype>,
        "Abnormality of musculature of pharynx",
        "Abnormality of pharyngeal musculature",
        "Abnormality of pharynx musculature" ;
    ns1:synonym "Abnormality of pharynx musculature"^^<http://example.org/invalidDatatype>,
        "Abnormality of muscles of the pharynx",
        "Abnormality of musculature of pharynx",
        "Abnormality of pharyngeal musculature" ;
    ns1:xref "UMLS:C4073197"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0430022> rdfs:label "Abnormality of the sphenoid sinus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the sphenoid sinus, one of the mucosa-lined, normally air-filled paranasal sinuses of the bones of the skull. The sphenoid sinus is located within the sphenoid bone."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the sphenoidal sinus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of the sphenoidal sinus"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4073204"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0430028> rdfs:label "Hyperplasia of the maxilla"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally increased dimension of the maxilla, especially relative to the mandible, resulting in a malocclusion or malalignment between the upper and lower teeth or in anterior positioning of the nasal base, increased convexity of the face, increased nasolabial angle, or increased width (transverse dimension of the maxilla."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased size of upper jaw"^^<http://example.org/invalidDatatype>,
