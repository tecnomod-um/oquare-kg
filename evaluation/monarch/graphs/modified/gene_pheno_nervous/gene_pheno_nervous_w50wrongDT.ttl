        "Transverse palmar crease" ;
    ns1:xref "SNOMEDCT_US:248409006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0424731" .

<http://purl.obolibrary.org/obo/HP_0002071> rdfs:label "Abnormality of extrapyramidal motor function" ;
    dcterms:description "A neurological condition related to lesions of the basal ganglia leading to typical abnormalities including akinesia (inability to initiate changes in activity and perform volitional movements rapidly and easily), muscular rigidity (continuous contraction of muscles with constant resistance to passive movement), chorea (widespread arrhythmic movements of a forcible, rapid, jerky, and restless nature), athetosis (inability to sustain the muscles of the fingers, toes, or other group of muscles in a fixed position), and akathisia (inability to remain motionless)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Extrapyramidal dysfunction"^^<http://example.org/invalidDatatype>,
        "Extrapyramidal symptoms"^^<http://example.org/invalidDatatype>,
        "Extrapyramidal syndrome"^^<http://example.org/invalidDatatype>,
        "Extrapyramidal signs",
        "Extrapyramidal tract signs" ;
    ns1:synonym "Extrapyramidal signs"^^<http://example.org/invalidDatatype>,
        "Extrapyramidal symptoms"^^<http://example.org/invalidDatatype>,
        "Extrapyramidal syndrome"^^<http://example.org/invalidDatatype>,
        "Extrapyramidal dysfunction",
        "Extrapyramidal tract signs" ;
    ns1:xref "SNOMEDCT_US:43378000"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:76349003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0015371"^^<http://example.org/invalidDatatype>,
        "UMLS:C0234133" .

<http://purl.obolibrary.org/obo/HP_0002123> rdfs:label "Generalized myoclonic seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A generalized myoclonic seizure is a type of generalized motor seizure characterized by bilateral, sudden, brief (<100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal). Myoclonus is less regularly repetitive and less sustained than is clonus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Generalised epileptic myoclonus"^^<http://example.org/invalidDatatype>,
        "Generalised myoclonic seizure"^^<http://example.org/invalidDatatype>,
        "Generalised myoclonic seizures"^^<http://example.org/invalidDatatype>,
        "Generalized epileptic myoclonus"^^<http://example.org/invalidDatatype>,
        "Myoclonus seizures"^^<http://example.org/invalidDatatype>,
        "Generalized myoclonic seizures" ;
    ns1:related_synonym "Myoclonic epilepsy, progressive" ;
    ns1:synonym "Generalised myoclonic seizure"^^<http://example.org/invalidDatatype>,
        "Generalized epileptic myoclonus"^^<http://example.org/invalidDatatype>,
        "Myoclonus seizures"^^<http://example.org/invalidDatatype>,
        "Generalised epileptic myoclonus",
        "Generalised myoclonic seizures",
        "Generalized myoclonic seizures",
        "Myoclonic epilepsy, progressive" ;
    ns1:xref "SNOMEDCT_US:192992007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:267581004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:37356005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0014550",
        "UMLS:C0751778",
        "UMLS:C4021759" .

