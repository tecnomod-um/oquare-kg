<http://purl.obolibrary.org/obo/HP_0010548> rdfs:label "Percussion myotonia" ;
    dcterms:description "A localized myotonic contraction in a muscle in reaction to percussion (tapping with the examiner's finger, a rubber percussion hammer, or a similar object)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Transient swelling of muscle induced by percussion" ;
    ns1:synonym "Transient swelling of muscle induced by percussion"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0751359" .

<http://purl.obolibrary.org/obo/HP_0010549> rdfs:label "Weakness due to upper motor neuron dysfunction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Paralysis of voluntary muscles means loss of contraction due to interruption of one or more motor pathways from the brain to the muscle fibers. Although the word paralysis is often used interchangeably to mean either complete or partial loss of muscle strength, it is preferable to use paralysis or plegia for complete or severe loss of muscle strength, and paresis for partial or slight loss. Paralysis due to lesions of the principle motor tracts is related to a lesion in the corticospinal, corticobulbar or brainstem descending (subcorticospinal) neurons."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Paralysis due to lesions of the principle motor tracts" ;
    ns1:synonym "Paralysis due to lesions of the principle motor tracts"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021255"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010579> rdfs:label "Cone-shaped epiphysis" ;
    dcterms:description "Cone-shaped epiphyses (also known as coned epiphyses) are epiphyses that invaginate into cupped metaphyses. That is, the epiphysis has a cone-shaped distal extension resulting from increased growth of the central portion of the epiphysis relative to its periphery."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Coned epiphyses"^^<http://example.org/invalidDatatype>,
        "Cone-shaped end part of bone",
        "Cone-shaped epiphyses" ;
    ns1:synonym "Coned epiphyses"^^<http://example.org/invalidDatatype>,
        "Cone-shaped end part of bone",
        "Cone-shaped epiphyses" ;
    ns1:xref "UMLS:C1865037" .

<http://purl.obolibrary.org/obo/HP_0010803> rdfs:label "Everted upper lip vermilion" ;
    dcterms:description "Inner aspect of the upper lip vermilion (normally apposing the teeth) visible in a frontal view, i.e., the presence of an everted upper lip."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Everted prominent upper lip"^^<http://example.org/invalidDatatype>,
        "Eclabium of upper lip",
        "Everted upper lip",
        "Outward turned upper lip" ;
    ns1:related_synonym "Drooping upper lip"^^<http://example.org/invalidDatatype>,
        "Protruding upper lip" ;
    ns1:synonym "Drooping upper lip"^^<http://example.org/invalidDatatype>,
        "Eclabium of upper lip"^^<http://example.org/invalidDatatype>,
        "Everted prominent upper lip"^^<http://example.org/invalidDatatype>,
        "Outward turned upper lip"^^<http://example.org/invalidDatatype>,
        "Everted upper lip",
        "Protruding upper lip" ;
    ns1:xref "UMLS:C4023698"^^<http://example.org/invalidDatatype>,
        "UMLS:C3275452",
        "UMLS:C4280363" .

<http://purl.obolibrary.org/obo/HP_0010821> rdfs:label "Focal emotional seizure with laughing" ;
    dcterms:description "Focal emotional seizure with laughing (gelastic) is characterized by bursts of laughter or giggling, usually without appropriate related emotion of happiness, and described as 'mirthless'."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Gelastic seizure",
        "Gelastic seizures" ;
    ns1:synonym "Gelastic seizures"^^<http://example.org/invalidDatatype>,
        "Gelastic seizure" ;
    ns1:xref "UMLS:C0270820"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:89525009" .

<http://purl.obolibrary.org/obo/HP_0011024> rdfs:label "Abnormality of the gastrointestinal tract"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the gastrointestinal tract."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the GI tract"^^<http://example.org/invalidDatatype>,
        "Abnormality of the gastrointestinal tract"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Digestive system disease"^^<http://example.org/invalidDatatype>,
        "Gastrointestinal disease" ;
    ns1:synonym "Abnormality of the GI tract"^^<http://example.org/invalidDatatype>,
        "Abnormality of the gastrointestinal tract"^^<http://example.org/invalidDatatype>,
        "Digestive system disease",
        "Gastrointestinal disease" ;
    ns1:xref "SNOMEDCT_US:119292006"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:25374005"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:53619000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0012242"^^<http://example.org/invalidDatatype>,
        "UMLS:C0017178",
        "UMLS:C4023588" .

<http://purl.obolibrary.org/obo/HP_0011150> rdfs:label "Myoclonic absence seizure" ;
    dcterms:description "Myoclonic absence seizure is a type of generalized non-motor (absence) seizure characterized by an interruption of ongoing activities, a blank stare and rhythmic three-per-second myoclonic movements, causing ratcheting abduction of the upper limbs leading to progressive arm elevation, and associated with 3 Hz generalized spike-wave discharges on the electroencephalogram. Duration is typically 10-60 s. Whilst impairment of consciousness may not be obvious the ILAE classified this seizure as a generalized non-motor seizure in 2017."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Myoclonic absence"^^<http://example.org/invalidDatatype>,
        "Myoclonic absences" ;
    ns1:synonym "Myoclonic absence",
        "Myoclonic absences" ;
    ns1:xref "UMLS:C4023512"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011170> rdfs:label "Generalized myoclonic-atonic seizure" ;
    dcterms:description "A generalized myoclonic-atonic seizure is a type of generalized motor seizure characterized by a myoclonic jerk followed by an atonic motor component." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Generalised myoclonic-atonic seizure"^^<http://example.org/invalidDatatype>,
        "Myoclonic atonic seizures",
        "Myoclonic-astatic seizure" ;
    ns1:synonym "Myoclonic atonic seizures"^^<http://example.org/invalidDatatype>,
        "Myoclonic-astatic seizure"^^<http://example.org/invalidDatatype>,
        "Generalised myoclonic-atonic seizure" ;
    ns1:xref "SNOMEDCT_US:230421008",
        "UMLS:C0393702" .

<http://purl.obolibrary.org/obo/HP_0011203> rdfs:label "EEG with abnormally slow frequencies" ;
    dcterms:description "EEG with abnormally slow frequencies."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023471" .

<http://purl.obolibrary.org/obo/HP_0011468> rdfs:label "Facial tics"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Sudden, repetitive, nonrhythmic motor movements (spasms), involving the eyes and muscles of the face."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Myoclonus of facial muscles"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cramping of facial muscles"^^<http://example.org/invalidDatatype>,
        "Facial spasms"^^<http://example.org/invalidDatatype>,
        "Facial tics",
        "Jerking of facial muscles",
        "Mimic spasms",
        "Spasms of facial muscles",
        "Twitching of facial muscles" ;
    ns1:related_synonym "Involuntary facial muscle spasms",
        "Muscle spasm of face" ;
    ns1:synonym "Cramping of facial muscles"^^<http://example.org/invalidDatatype>,
        "Facial spasms"^^<http://example.org/invalidDatatype>,
        "Facial tics"^^<http://example.org/invalidDatatype>,
