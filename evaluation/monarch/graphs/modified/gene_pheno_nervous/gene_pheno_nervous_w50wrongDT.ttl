<http://purl.obolibrary.org/obo/HP_0010524> rdfs:label "Disturbed sensory perception"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Alteration or impairment in the processing or interpretation of sensory information can lead to abnormal perceptions or experiences."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Agnosia"^^<http://example.org/invalidDatatype> ;
