        "Prurigo Besnier" ;
    ns1:related_synonym "Baby eczema"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Infantile eczema"^^<http://example.org/invalidDatatype>,
        "Neurodermatitis"^^<http://example.org/invalidDatatype>,
        "Allergic eczema",
        "Atopic dermatitis, chronic",
        "Atopic eczema",
        "Baby eczema",
        "Dermatitis, Atopic",
        "Prurigo Besnier" ;
    ns1:xref "SNOMEDCT_US:200775004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:24079001",
        "UMLS:C0011615",
        "UMLS:C4280605" .

