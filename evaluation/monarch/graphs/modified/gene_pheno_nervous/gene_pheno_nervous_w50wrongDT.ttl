<http://purl.obolibrary.org/obo/MONDO_0015355> rdfs:label "distal hereditary motor neuropathy type 7"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Distal hereditary motor neuropathy type 7 is a rare, slowly progressive genetic peripheral neuropathy characterized by distal atrophy and weakness affecting the upper limbs (with a predilection for the thenar eminence) and subsequently the lower limbs, associated with uni- or bilateral vocal cord paresis leading to hoarse voice and breathing difficulties, and facial weakness."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "dHMN7"^^<http://example.org/invalidDatatype>,
        "distal spinal muscular atrophy with vocal cord paralysis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "dHMN7"^^<http://example.org/invalidDatatype>,
        "distal spinal muscular atrophy with vocal cord paralysis" ;
    ns1:xref "DOID:0111199"^^<http://example.org/invalidDatatype>,
