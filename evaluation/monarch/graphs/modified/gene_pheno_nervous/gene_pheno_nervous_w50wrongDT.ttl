        "Dislocation of the femoral head" ;
    ns1:xref "SNOMEDCT_US:157265008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0019554"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003383> rdfs:label "Onion bulb formation" ;
    dcterms:description "Repeated episodes of segmental demyelination and remyelination lead to the accumulation of supernumerary Schwann cells around axons, which is referred to as onion bulb formation. This finding affects peripheral nerves." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Onion bulb formations" ;
    ns1:synonym "Onion bulb formations" ;
    ns1:xref "UMLS:C1847906" .

<http://purl.obolibrary.org/obo/HP_0003445> rdfs:label "EMG: neuropathic changes"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of characteristic findings of denervation on electromyography (fibrillations, positive sharp waves, and giant motor unit potentials)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EMG: neurogenic abnormalities"^^<http://example.org/invalidDatatype>,
        "EMG: neurogenic findings"^^<http://example.org/invalidDatatype>,
