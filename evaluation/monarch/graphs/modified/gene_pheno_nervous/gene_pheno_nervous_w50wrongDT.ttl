<http://purl.obolibrary.org/obo/HP_0001591> rdfs:label "Bell-shaped thorax"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The rib cage has the shape of a wide mouthed bell. That is, the superior portion of the rib cage is constricted, followed by a convex region, and the inferior portion of the rib cage expands again to have a large diameter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bell-shaped chest"^^<http://example.org/invalidDatatype>,
