<http://purl.obolibrary.org/obo/MONDO_0007688> rdfs:label "Myhre syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Myhre syndrome is characterized by striking muscular build, short stature, reduced joint mobility, brachydactyly, mixed hearing loss and mental retardation of variable severity. Facial dysmorphism with short palpebral fissures, short philtrum, thin lips, maxillary hypoplasia and prognathism is present. Thick skin has been observed in six patients."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Myhre syndrome"^^<http://example.org/invalidDatatype>,
        "facial dysmorphism-intellectual disability-short stature-hearing loss syndrome"^^<http://example.org/invalidDatatype> ;
