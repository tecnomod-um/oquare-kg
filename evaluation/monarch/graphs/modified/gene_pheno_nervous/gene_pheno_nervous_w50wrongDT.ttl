<http://purl.obolibrary.org/obo/HP_0000580> rdfs:label "Pigmentary retinopathy" ;
    dcterms:description "An abnormality of the retina characterized by pigment deposition. It is typically associated with migration and proliferation of macrophages or retinal pigment epithelial cells into the retina; melanin from these cells causes the pigmentary changes. Pigmentary retinopathy is a common final pathway of many retinal conditions and is often associated with visual loss." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal pigmentary clumping"^^<http://example.org/invalidDatatype>,
        "Retinal pigmentary degeneration"^^<http://example.org/invalidDatatype>,
