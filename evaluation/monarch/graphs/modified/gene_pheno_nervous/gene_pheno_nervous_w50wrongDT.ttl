    ns1:xref "SNOMEDCT_US:7305005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0003492" .

<http://purl.obolibrary.org/obo/HP_0001852> rdfs:label "Sandal gap" ;
    dcterms:description "A widely spaced gap between the first toe (the great toe) and the second toe." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Gap between 1st and 2nd toes"^^<http://example.org/invalidDatatype>,
