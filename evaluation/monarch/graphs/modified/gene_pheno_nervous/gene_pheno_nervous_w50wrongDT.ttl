<http://purl.obolibrary.org/obo/HP_0011449> rdfs:label "Knee clonus" ;
    dcterms:description "Clonus is an involuntary tendon reflex that causes repeated flexion and extension of the foot. Knee clonus can be tested by rapidly pushing the patella towards the toes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Patellar clonus" ;
    ns1:synonym "Patellar clonus" ;
