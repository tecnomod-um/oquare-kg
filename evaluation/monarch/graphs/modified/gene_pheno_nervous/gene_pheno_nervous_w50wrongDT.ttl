        <http://purl.obolibrary.org/obo/HP_0006579>,
        <http://purl.obolibrary.org/obo/HP_0006958>,
        <http://purl.obolibrary.org/obo/HP_0011968>,
        <http://purl.obolibrary.org/obo/HP_0012696>,
        <http://purl.obolibrary.org/obo/HP_0025331>,
