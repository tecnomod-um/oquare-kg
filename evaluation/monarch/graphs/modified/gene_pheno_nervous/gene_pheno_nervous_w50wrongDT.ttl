<http://purl.obolibrary.org/obo/HP_0500230> rdfs:label "Increased CSF glycine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally increased levels of glycine in cerebrospinal fluid." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High glycine levels in cerebrospinal fluid" ;
    ns1:synonym "High glycine levels in cerebrospinal fluid"^^<http://example.org/invalidDatatype> .

