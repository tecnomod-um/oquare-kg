        "Prolactin excess" ;
    ns1:xref "UMLS:C0020514"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:237662005" .

<http://purl.obolibrary.org/obo/HP_0001171> rdfs:label "Split hand"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A condition in which middle parts of the hand (fingers and metacarpals) are missing giving a cleft appearance. The severity is very variable ranging from slightly hypoplastic middle fingers over absent middle fingers as far as oligo- or monodactyl hands."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Split hand"^^<http://example.org/invalidDatatype>,
        "Ectrodactyly of the hand",
        "Hand ectrodactyly",
        "Split-hand" ;
    ns1:synonym "Ectrodactyly of the hand",
        "Hand ectrodactyly",
        "Split hand",
        "Split-hand" ;
    ns1:xref "SNOMEDCT_US:299034005",
        "UMLS:C0221373" .

<http://purl.obolibrary.org/obo/HP_0001188> rdfs:label "Hand clenching"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal hand posture in which the hands are clenched to fists. All digits held completely flexed at the metacarpophalangeal and interphalangeal joints. In prenatal sonography of the fetal clenched hand, the index finger overlaps a clenched fist formed by the other digits. The proximal interphalangeal articulation of the index finger is flexed and ulnarly deviated, and the thumb is adducted." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Clenched hands"^^<http://example.org/invalidDatatype>,
        "Fisted hand"^^<http://example.org/invalidDatatype>,
        "Fisting"^^<http://example.org/invalidDatatype>,
        "Hands fisted"^^<http://example.org/invalidDatatype>,
        "Hands tightly fisted"^^<http://example.org/invalidDatatype>,
        "Clenched hand",
        "Hand clenching",
        "Thumb clasp" ;
    ns1:synonym "Clenched hand"^^<http://example.org/invalidDatatype>,
        "Clenched hands"^^<http://example.org/invalidDatatype>,
        "Fisted hand"^^<http://example.org/invalidDatatype>,
        "Hand clenching"^^<http://example.org/invalidDatatype>,
        "Hands fisted"^^<http://example.org/invalidDatatype>,
        "Thumb clasp"^^<http://example.org/invalidDatatype>,
        "Fisting",
        "Hands tightly fisted" ;
    ns1:xref "UMLS:C0239815" .

<http://purl.obolibrary.org/obo/HP_0001355> rdfs:label "Megalencephaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diffuse enlargement of the entire cerebral hemispheres leading to macrocephaly (with or without overlying cortical dysplasia)." ;
    ns1:broad_synonym "Enlarged brain" ;
