    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073219" .

<http://purl.obolibrary.org/obo/HP_3000022> rdfs:label "Abnormal external ear cartilage morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of a cartilage of external ear." ;
