        <http://purl.obolibrary.org/obo/HP_0001824>,
        <http://purl.obolibrary.org/obo/HP_0001959>,
        <http://purl.obolibrary.org/obo/HP_0100515> ;
    ns1:synonym "acquired CDI"^^<http://example.org/invalidDatatype>,
        "acquired central diabetes insipidus"^^<http://example.org/invalidDatatype>,
        "acquired neurogenic diabetes insipidus" ;
