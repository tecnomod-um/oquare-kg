    ns1:xref "SNOMEDCT_US:267044007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0424551"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003547> rdfs:label "Shoulder girdle muscle weakness" ;
    dcterms:description "The shoulder, or pectoral, girdle is composed of the clavicles and the scapulae. Shoulder-girdle weakness refers to lack of strength of the muscles attaching to these bones, that is, lack of strength of the muscles around the shoulders." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Shoulder girdle weakness"^^<http://example.org/invalidDatatype>,
        "Muscle weakness, shoulder-girdle",
        "Shoulder weakness",
        "Weak shoulder muscles" ;
    ns1:synonym "Muscle weakness, shoulder-girdle"^^<http://example.org/invalidDatatype>,
        "Shoulder weakness"^^<http://example.org/invalidDatatype>,
        "Shoulder girdle weakness",
        "Weak shoulder muscles" ;
    ns1:xref "SNOMEDCT_US:249940002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0427063",
        "UMLS:C0748691" .

<http://purl.obolibrary.org/obo/HP_0007270> rdfs:label "Atypical absence seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An atypical absence seizure is a type of generalized non-motor (absence) seizure characterized by interruption of ongoing activities and reduced responsiveness. In comparison to a typical absence seizure, changes in tone may be more pronounced, onset and/or cessation may be less abrupt, and the duration of the ictus and post-ictal recovery may be longer. Although not always available, an EEG often demonstrates slow (<3 Hz), irregular, generalized spike-wave activity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Atypical absence"^^<http://example.org/invalidDatatype>,
        "Atypical absence seizures"^^<http://example.org/invalidDatatype>,
        "Atypical petit mal seizures" ;
    ns1:synonym "Atypical absence seizures"^^<http://example.org/invalidDatatype>,
        "Atypical petit mal seizures"^^<http://example.org/invalidDatatype>,
        "Atypical absence" ;
    ns1:xref "SNOMEDCT_US:23374007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0595948"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007366> rdfs:label "Atrophy/Degeneration affecting the brainstem" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brainstem atrophy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Brainstem atrophy" ;
