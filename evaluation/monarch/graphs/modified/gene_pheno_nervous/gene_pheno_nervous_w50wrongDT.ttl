        "Generalized tonic seizures"^^<http://example.org/invalidDatatype>,
        "Generalised hypertonic seizure",
        "Generalised tonic seizure",
        "Hypertonic seizures" ;
    ns1:xref "UMLS:C1836508"^^<http://example.org/invalidDatatype> .

