    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023394" .

<http://purl.obolibrary.org/obo/HP_0011373> rdfs:label "Incomplete partition of the cochlea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Incomplete formation of the cochlear partition. The scala vestibuli and scala tympani separated by the cochlear partition, except in the apical turn where the two scalae are in continuity via the helicotrema." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023392"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011375> rdfs:label "Cochlear aplasia" ;
    dcterms:description "Absence of the cochlea, a spiral shaped cavity in the inner ear, owing to a developmental defect."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent cochlea"^^<http://example.org/invalidDatatype> ;
