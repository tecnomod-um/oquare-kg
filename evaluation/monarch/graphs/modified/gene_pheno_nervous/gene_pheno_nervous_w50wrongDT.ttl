    ns1:synonym "Abnormal kidney"^^<http://example.org/invalidDatatype>,
        "Abnormality of the kidney"^^<http://example.org/invalidDatatype>,
        "Renal anomalies"^^<http://example.org/invalidDatatype>,
        "Renal anomaly" ;
    ns1:xref "UMLS:C0022658"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:44513007",
        "SNOMEDCT_US:90708001",
        "UMLS:C0266292" .

<http://purl.obolibrary.org/obo/HP_0000176> rdfs:label "Submucous cleft hard palate"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hard-palate submucous clefts are characterized by bony defects in the midline of the bony palate that are covered by the mucous membrane of the roof of the mouth. It may be possible to detect a submucous cleft hard palate upon palpation as a notch in the bony palate." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial thickness cleft hard palate" ;
    ns1:synonym "Partial thickness cleft hard palate" ;
    ns1:xref "SNOMEDCT_US:43437003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0432103"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020894"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000399> rdfs:label "Prelingual sensorineural hearing impairment"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of sensorineural deafness with either congenital onset or infantile onset, i.e., before the acquisition of speech." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Deafness, sensorineural, prelingual",
        "Prelingual sensorineural deafness" ;
    ns1:synonym "Prelingual sensorineural deafness"^^<http://example.org/invalidDatatype>,
        "Deafness, sensorineural, prelingual" ;
    ns1:xref "UMLS:C4021806" .

<http://purl.obolibrary.org/obo/HP_0000677> rdfs:label "Oligodontia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The absence of six or more teeth from the normal series by a failure to develop." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Failure of development of more than six teeth"^^<http://example.org/invalidDatatype>,
        "Partial anodontia" ;
    ns1:related_synonym "Missing more than six teeth"^^<http://example.org/invalidDatatype>,
        "Number of teeth decreased by more than six" ;
    ns1:synonym "Failure of development of more than six teeth"^^<http://example.org/invalidDatatype>,
        "Missing more than six teeth"^^<http://example.org/invalidDatatype>,
        "Partial anodontia"^^<http://example.org/invalidDatatype>,
        "Number of teeth decreased by more than six" ;
    ns1:xref "UMLS:C4082304",
        "UMLS:C4280619" .

<http://purl.obolibrary.org/obo/HP_0000748> rdfs:label "Inappropriate laughter" ;
    dcterms:description "Laughing that may be excessive and/or inappropriate in context (e.g., laughing at a funeral while others are crying)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inappropriate laughter" ;
    ns1:synonym "Inappropriate laughter"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:247985007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0424304" .

<http://purl.obolibrary.org/obo/HP_0000771> rdfs:label "Gynecomastia" ;
    dcterms:description "Abnormal development of large mammary glands in males resulting in breast enlargement."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Enlarged male breast",
        "Gynaecomastia" ;
    ns1:synonym "Enlarged male breast",
        "Gynaecomastia" ;
    ns1:xref "SNOMEDCT_US:4754008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0018418" .

<http://purl.obolibrary.org/obo/HP_0000787> rdfs:label "Nephrolithiasis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of calculi (stones) in the kidneys." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Kidney stones"^^<http://example.org/invalidDatatype>,
        "Renal calculi"^^<http://example.org/invalidDatatype>,
