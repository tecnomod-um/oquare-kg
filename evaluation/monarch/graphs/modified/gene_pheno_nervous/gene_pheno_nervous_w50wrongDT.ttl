<http://purl.obolibrary.org/obo/HP_0200023> rdfs:label "Priapism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A painful and harmful medical condition in which the erect penis doesn't return to its flaccid state, despite the absence of both physical and psychological stimulation, within four hours."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "hulseyism"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "hulseyism" ;
    ns1:xref "SNOMEDCT_US:6273006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0033117" .

<http://purl.obolibrary.org/obo/HP_0200024> rdfs:label "Premature chromatid separation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of premature sister chromatid segregation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4021899"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0200028> rdfs:label "Pretibial myxedema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A diffuse, non-pitting edema and thickening of the skin usually on the anterior aspect of the lower legs spreading to the dorsum of the feet." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Graves dermopathy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Graves dermopathy"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0033103"^^<http://example.org/invalidDatatype>,
        "UMLS:C0342554"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:237825005",
        "SNOMEDCT_US:78146007" .

<http://purl.obolibrary.org/obo/HP_0200029> rdfs:label "Vasculitis in the skin" ;
    dcterms:description "A type of vasculitis (inflammation of blood vessel walls) that affects skeletal muscle tissue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cutaneous vasculitis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Cutaneous vasculitis" ;
    ns1:xref "SNOMEDCT_US:53312001",
        "UMLS:C0262988" .

<http://purl.obolibrary.org/obo/HP_0200030> rdfs:label "Punctate vasculitis skin lesions"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3277693" .

<http://purl.obolibrary.org/obo/HP_0200035> rdfs:label "Skin plaque"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A plaque is a solid, raised, plateau-like (flat-topped) lesion greater than 1 cm in diameter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:128177006"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:276322001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0241148" .

<http://purl.obolibrary.org/obo/HP_0200037> rdfs:label "Skin vesicle" ;
    dcterms:description "A circumscribed, fluid-containing, epidermal elevation less than 10mm in diameter at the widest point that (i) Contain serous exudates or serum mixed with blood or pus; (ii) Are discrete, grouped, irregularly distributed, or linear as in Rhus dermatitis; (iii) Are short-lived. Vesicles may break spontaneously or evolve into bullae by enlarging or coalescing with other vesicles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3814530" .

<http://purl.obolibrary.org/obo/HP_0200040> rdfs:label "Epidermoid cyst"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Nontender, round and firm, but slightly compressible, intradermal or subcutaneous cyst measuring 0.5-5 cm in diameter. Epidermal cysts are intradermal or subcutaneous tumors, grow slowly and occur on the face, neck, back and scrotum. They usually appear at or around puberty, and as a rule an affected individual has one solitary or a few cysts. A central, dark comedone opening (punctum) may be present."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Keratin cyst"^^<http://example.org/invalidDatatype>,
        "Epidermal cyst",
        "Epidermal inclusion cyst",
        "Infundibular cyst" ;
    ns1:related_synonym "Central punctum opening in cyst"^^<http://example.org/invalidDatatype>,
        "Epidermoid cysts"^^<http://example.org/invalidDatatype>,
        "Sebaceous cyst"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Central punctum opening in cyst"^^<http://example.org/invalidDatatype>,
        "Epidermoid cysts"^^<http://example.org/invalidDatatype>,
        "Infundibular cyst"^^<http://example.org/invalidDatatype>,
        "Epidermal cyst",
        "Epidermal inclusion cyst",
        "Keratin cyst",
        "Sebaceous cyst" ;
    ns1:xref "SNOMEDCT_US:399999000"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:418630001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:419670003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:417992006",
        "SNOMEDCT_US:418323001",
        "SNOMEDCT_US:419603000",
        "SNOMEDCT_US:419893006",
        "UMLS:C0014511" .

<http://purl.obolibrary.org/obo/HP_0200043> rdfs:label "Verrucae"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Warts, benign growths on the skin or mucous membranes that cause cosmetic problems as well as pain and discomfort. Warts most often occur on the hands, feet, and genital areas."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Warts" ;
    ns1:synonym "Warts" ;
    ns1:xref "SNOMEDCT_US:30285000",
        "SNOMEDCT_US:57019003",
        "UMLS:C3665596" .

<http://purl.obolibrary.org/obo/HP_0200046> rdfs:label "Cat cry" ;
    dcterms:description "The presence of a characteristic high-pitched cry that sounds similar to the meowing of a kitten." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cat cry"^^<http://example.org/invalidDatatype>,
        "cat-like cry" ;
    ns1:related_synonym "cri de chat-associated cry" ;
    ns1:synonym "cat-like cry"^^<http://example.org/invalidDatatype>,
        "cri de chat-associated cry"^^<http://example.org/invalidDatatype>,
        "Cat cry" ;
    ns1:xref "SNOMEDCT_US:42712003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0234861" .

<http://purl.obolibrary.org/obo/HP_0200056> rdfs:label "Macular scar" ;
    dcterms:description "Fibrous connective tissue consequent upon healing of a wound (i.e., a scar) located in the macula."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular scarring" ;
    ns1:synonym "Macular scarring"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:18410006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0423428"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0200058> rdfs:label "Angiosarcoma" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:403977003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:33176006",
        "SNOMEDCT_US:39000009",
        "UMLS:C0018923" .

<http://purl.obolibrary.org/obo/HP_0200059> rdfs:label "Metastatic angiosarcoma"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0854892" .

<http://purl.obolibrary.org/obo/HP_0200068> rdfs:label "Nonprogressive visual loss"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Decreased visual acuity, nonprogressive"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased visual acuity, nonprogressive"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021893"^^<http://example.org/invalidDatatype>,
        "UMLS:C3553696" .

<http://purl.obolibrary.org/obo/HP_0200114> rdfs:label "Metabolic alkalosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Metabolic alkalosis is defined as a disease state where the pH is elevated to greater than 7.45 secondary to some metabolic process."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:1388004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0220983" .

<http://purl.obolibrary.org/obo/HP_0200128> rdfs:label "Biventricular hypertrophy" ;
    dcterms:description "Thickening of the heart walls in both ventricles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0281788" .

<http://purl.obolibrary.org/obo/HP_0400005> rdfs:label "Short ear" ;
    dcterms:description "Median longitudinal ear length less than two SD above the mean determined by the maximal distance from the superior aspect to the inferior aspect of the external ear." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Short ears"^^<http://example.org/invalidDatatype>,
        "Short ear" ;
    ns1:synonym "Short ear"^^<http://example.org/invalidDatatype>,
        "Short ears"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C3551041" .

<http://purl.obolibrary.org/obo/HP_0410019> rdfs:label "Epigastric pain" ;
    dcterms:description "Pain that is localized to the region of the upper abdomen immediately below the ribs." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Epigastrium pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Epigastrium pain" .

<http://purl.obolibrary.org/obo/HP_0410054> rdfs:label "Decreased circulating GABA concentration" ;
    dcterms:description "A decrease in the level of GABA in the serum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased circulating gamma-aminobutyric acid concentration"^^<http://example.org/invalidDatatype>,
        "Decreased level of gamma-aminobutyric acid in serum" ;
    ns1:synonym "Decreased circulating gamma-aminobutyric acid concentration",
        "Decreased level of gamma-aminobutyric acid in serum" .

<http://purl.obolibrary.org/obo/HP_0410055> rdfs:label "Decreased level of erythritol in urine" ;
    dcterms:description "A decrease in the level of erythritol in the urine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410056> rdfs:label "Decreased CSF erythritol concentration" ;
    dcterms:description "Concentration of erythritol in the cerebrospinal fluid below the lower limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased level of erythritol in cerebrospinal fluid" ;
    ns1:synonym "Decreased level of erythritol in cerebrospinal fluid"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410057> rdfs:label "Increased level of D-threitol in plasma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of D-threitol in the plasma."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410058> rdfs:label "Increased CSF D-threitol concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of D-threitol in the cerebrospinal fluid is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased level of D-threitol in CSF",
        "Increased level of D-threitol in cerebrospinal fluid" ;
    ns1:synonym "Increased level of D-threitol in CSF",
        "Increased level of D-threitol in cerebrospinal fluid" .

<http://purl.obolibrary.org/obo/HP_0410059> rdfs:label "Increased level of D-threitol in urine"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of D-threitol in the urine." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410070> rdfs:label "Increased level of ribitol in urine"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of ribitol in the urine. Ribotol is a crystalline pentose alcohol (C5H12O5) and is a metabolic end product formed by the reduction of ribose."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410071> rdfs:label "Increased CSF ribitol concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of ribitol in the cerebrospinal fluid is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased level of ribitol in cerebrospinal fluid"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased level of ribitol in cerebrospinal fluid"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410072> rdfs:label "Increased level of ribose in urine" ;
    dcterms:description "An increase in the level of ribose in the urine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410073> rdfs:label "Increased CSF ribose concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of ribose in the cerebrospinal fluid is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased level of ribose in CSF"^^<http://example.org/invalidDatatype>,
        "Increased level of ribose in cerebrospinal fluid"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased level of ribose in CSF",
        "Increased level of ribose in cerebrospinal fluid" .

<http://purl.obolibrary.org/obo/HP_0410074> rdfs:label "Increased level of xylitol in urine"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of xylitol in the urine." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410075> rdfs:label "Increased CSF xylitol concentration" ;
    dcterms:description "The concentration of xylitol in the cerebrospinal fluid is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased level of xylitol in CSF",
        "Increased level of xylitol in cerebrospinal fluid" ;
    ns1:synonym "Increased level of xylitol in CSF"^^<http://example.org/invalidDatatype>,
        "Increased level of xylitol in cerebrospinal fluid" .

<http://purl.obolibrary.org/obo/HP_0410135> rdfs:label "Cold urticaria" ;
    dcterms:description "Urticaria may be caused by cold temperatures."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410173> rdfs:label "Increased circulating troponin I concentration" ;
    dcterms:description "An increased concentration of tropnin I in the blood, which is a cardiac regulatory protein that controls the calcium mediated interaction between actin and myosin. Raised cardiac troponin concentrations are now accepted as the standard biochemical marker for the diagnosis of myocardial infarction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased troponin I level in blood" ;
    ns1:synonym "Increased troponin I level in blood" .

<http://purl.obolibrary.org/obo/HP_0410175> rdfs:label "Hyperketonemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of ketone bodies (acetoacetic acid, beta-hydroxybutyric acid, and acetone) in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased level of ketone bodies in blood"^^<http://example.org/invalidDatatype>,
        "Ketonemia"^^<http://example.org/invalidDatatype>,
        "Elevated circulating ketone body concentration" ;
    ns1:synonym "Ketonemia"^^<http://example.org/invalidDatatype>,
        "Elevated circulating ketone body concentration",
        "Increased level of ketone bodies in blood" .

<http://purl.obolibrary.org/obo/HP_0410262> rdfs:label "Lower cranial nerve dysfunction" ;
    dcterms:description "A functional abnormality affecting the lower cranial nerves, which include the paired 9th (glossopharyngeal), 10th (vagal), 11th (accessory) and 12th (hypoglossal) cranial nerves."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal lower cranial nerve function"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal lower cranial nerve function"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410264> rdfs:label "Subglottic hemangioma" ;
    dcterms:description "A hemangioma, a benign tumor of the vascular endothelial cells, located in the airway, typically below the vocal chords, that can cause severe obstruction of the airway." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Airway hemangioma"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Airway hemangioma"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410275> rdfs:label "Lumbosacral hemangioma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A spinal cord hemangioma located in the lumbosacral spine region." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lumbar/sacral hemangioma" ;
    ns1:synonym "Lumbar/sacral hemangioma"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410278> rdfs:label "Pituitary gland cyst"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A fluid-filled sacs that develop on or near the pituitary gland."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cyst of the pituitary gland" ;
    ns1:synonym "Cyst of the pituitary gland"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410279> rdfs:label "Atrophic pituitary gland"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Partial or complete wasting (loss) of the pituitary gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Atrophic pituitary"^^<http://example.org/invalidDatatype>,
        "Pituitary gland atrophy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Atrophic pituitary"^^<http://example.org/invalidDatatype>,
        "Pituitary gland atrophy"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410291> rdfs:label "Negativism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Opposing or not responding to instructions or external stimuli." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0410309> rdfs:label "Alpha-aminoadipic aciduria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of alpha-aminoadipic acid in the urine, normalized for urine concentration, is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "2-aminoadipic aciduria"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "2-aminoadipic aciduria"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0410362> rdfs:label "Decreased O-mannosyl glycans on alpha-dystroglycan" ;
    dcterms:description "Hypoglycosylation of alpha-dystroglycan with O-mannosyl glycans. Alpha-dystroglycan is a functional target of O-mannosyl glycosylation and functional glycosylation of alpha-DG is essential in its interaction with the extracellular matrix." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced O-mannosyl glycans on alpha-dystroglycan"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced O-mannosyl glycans on alpha-dystroglycan" .

<http://purl.obolibrary.org/obo/HP_0430000> rdfs:label "Abnormal frontal bone morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the frontal bone." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the frontal bone"^^<http://example.org/invalidDatatype>,
        "Abnormality of the bone of the forehead" ;
    ns1:narrow_synonym "Abnormal morphology of frontal bone"^^<http://example.org/invalidDatatype>,
        "Anomaly of the frontal bone"^^<http://example.org/invalidDatatype>,
        "Deformity of the frontal bone"^^<http://example.org/invalidDatatype>,
        "Malformation of the frontal bone"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of the bone of the forehead"^^<http://example.org/invalidDatatype>,
        "Abnormal morphology of frontal bone",
        "Abnormality of the frontal bone",
        "Anomaly of the frontal bone",
        "Deformity of the frontal bone",
        "Malformation of the frontal bone" ;
    ns1:xref "UMLS:C4021873" .

<http://purl.obolibrary.org/obo/HP_0430043> rdfs:label "Thoracic lordosis" ;
    dcterms:description "Thoracic lordosis refers to an abnormal curvature of the thoracic spine in which the thoracic spine displays lordosis (inward curve) instead of the normal kyphosis (outward curve)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0430058> rdfs:label "Anti-herpes simplex antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of antibodies in the blood circulation that react against a component of herpes simplex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "HSV antibody titer high in blood" ;
    ns1:synonym "HSV antibody titer high in blood"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0430088> rdfs:label "Anti-measles antibody positivity" ;
    dcterms:description "The presence of antibodies in the blood circulation that react against a component of measles virus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Measles antibody titer high in blood" ;
    ns1:synonym "Measles antibody titer high in blood"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0500081> rdfs:label "Pseudophakia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The term pseudophakia refers to having an artificial lens implanted after the natural eye lens has been removed. During cataract surgery the natural cloudy lens is replaced by an pseudophakia intraocular lens (IOL)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0500089> rdfs:label "Optic nerve sheath meningioma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A benign tumor of meningothelial cells of the meninges that usually occurs in middle age. It is typically unilateral and there is an association with neurofibromatosis type 2."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0500093> rdfs:label "Food allergy" ;
    dcterms:description "Primary food allergies primarily occur as a result (most likely) of gastrointestinal sensitization to predominantly stable food allergens (glycoproteins). A secondary food allergy develops after primary sensitization to airborne allergens (e. g., pollen allergens) with subsequent reactions (due to cross-reactivity) to structurally related often labile allergens in (plant) foods." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "IgE-mediated food allergy"^^<http://example.org/invalidDatatype>,
        "Allergic reaction to foods",
        "Food allergy",
        "Immunoglobulin E-mediated food allergy",
        "Reaction to food allergens" ;
    ns1:synonym "Allergic reaction to foods"^^<http://example.org/invalidDatatype>,
        "Food allergy"^^<http://example.org/invalidDatatype>,
        "IgE-mediated food allergy"^^<http://example.org/invalidDatatype>,
        "Immunoglobulin E-mediated food allergy",
        "Reaction to food allergens" .

<http://purl.obolibrary.org/obo/HP_0500147> rdfs:label "Hypoglutaminemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased amount of glutamine in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased blood glutamine concentration"^^<http://example.org/invalidDatatype>,
        "Low blood glutamine level" ;
    ns1:synonym "Decreased blood glutamine concentration"^^<http://example.org/invalidDatatype>,
        "Low blood glutamine level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0500149> rdfs:label "Hyperglutamatemia" ;
    dcterms:description "Concentration of glutamate in the blood circulation above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High blood glutamate levels",
        "Increased blood glutamate concentration",
        "Increased level of L-glutamic acid in blood" ;
    ns1:synonym "High blood glutamate levels"^^<http://example.org/invalidDatatype>,
        "Increased blood glutamate concentration"^^<http://example.org/invalidDatatype>,
        "Increased level of L-glutamic acid in blood"^^<http://example.org/invalidDatatype> .

