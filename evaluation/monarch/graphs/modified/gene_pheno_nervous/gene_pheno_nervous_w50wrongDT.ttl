        "Poorly developed lungs",
        "Small lung" ;
    ns1:xref "UMLS:C0265783"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:80825009" .

<http://purl.obolibrary.org/obo/HP_0002162> rdfs:label "Low posterior hairline" ;
    dcterms:description "Hair on the neck extends more inferiorly than usual."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low hairline at back of neck",
        "Low posterior hair line" ;
    ns1:synonym "Low posterior hair line"^^<http://example.org/invalidDatatype>,
        "Low hairline at back of neck" ;
    ns1:xref "UMLS:C1855728"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002464> rdfs:label "Spastic dysarthria" ;
    dcterms:description "A type of dysarthria related to bilateral damage of the upper motor neuron tracts of the pyramidal and extra- pyramidal tracts. Speech of affected individuals is slow, effortful, and has a harsh vocal quality."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Rigid dysarthria" ;
    ns1:synonym "Rigid dysarthria"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0454596"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:229684006" .

<http://purl.obolibrary.org/obo/HP_0004279> rdfs:label "Short palm" ;
    dcterms:description "Short palm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Short palm" ;
    ns1:related_synonym "Short hands"^^<http://example.org/invalidDatatype>,
        "Hypoplastic hands",
        "Short palms" ;
    ns1:synonym "Short hands"^^<http://example.org/invalidDatatype>,
        "Hypoplastic hands",
        "Short palm",
        "Short palms" ;
    ns1:xref "UMLS:C1843108"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0004326> rdfs:label "Cachexia" ;
    dcterms:description "Severe weight loss, wasting of muscle, loss of appetite, and general debility related to a chronic disease."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Wasting syndrome"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Wasting syndrome" ;
    ns1:xref "SNOMEDCT_US:238108007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0006625"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:285384003" .

<http://purl.obolibrary.org/obo/HP_0004374> rdfs:label "Hemiplegia/hemiparesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Loss of strength in the arm, leg, and sometimes face on one side of the body. Hemiplegia refers to a severe or complete loss of strength, whereas hemiparesis refers to a relatively mild loss of strength." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Paralysis or weakness of one side of body" ;
    ns1:synonym "Paralysis or weakness of one side of body" ;
    ns1:xref "UMLS:C0375206" .

<http://purl.obolibrary.org/obo/HP_0007021> rdfs:label "Pain insensitivity" ;
    dcterms:description "Inability to perceive painful stimuli." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absence of pain sensation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Absence of pain sensation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:38433004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0344307"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007874> rdfs:label "Almond-shaped palpebral fissure" ;
    dcterms:description "A shape created by an acute downward arching of the upper eyelid and upward arching of the lower eyelid, toward the medial canthus, which gives the outline of the palpebral fissures the configuration of an almond. Thus, the maximum distance between the fissures is offset from, and medial to, the center point." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Almond shaped eyes"^^<http://example.org/invalidDatatype>,
        "Almond-shaped opening between the eyelids" ;
    ns1:synonym "Almond-shaped opening between the eyelids"^^<http://example.org/invalidDatatype>,
        "Almond shaped eyes" ;
    ns1:xref "UMLS:C4024780" .

<http://purl.obolibrary.org/obo/HP_0011098> rdfs:label "Speech apraxia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of apraxia that is characterized by difficulty or inability to execute speech movements because of problems with coordination and motor problems, leading to incorrect articulation. An increase of errors with increasing word and phrase length may occur."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Apraxia of speech",
        "Verbal dyspraxia" ;
    ns1:related_synonym "Speech dyspraxia" ;
    ns1:synonym "Speech dyspraxia"^^<http://example.org/invalidDatatype>,
        "Verbal dyspraxia"^^<http://example.org/invalidDatatype>,
        "Apraxia of speech" ;
    ns1:xref "SNOMEDCT_US:361277007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0264611"^^<http://example.org/invalidDatatype>,
        "UMLS:C0349391"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:361276003",
        "SNOMEDCT_US:74227009" .

<http://purl.obolibrary.org/obo/HP_0011182> rdfs:label "Interictal epileptiform activity" ;
    dcterms:description "Epileptiform activity refers to distinctive EEG waves or complexes distinguished from background activity found in in a proportion of human subjects with epilepsy, but which can also be found in subjects without seizures. Interictal epileptiform activity refers to such activity that occurs in the absence of a clinical or subclinical seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Epileptiform EEG discharges"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Epileptiform EEG discharges"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023491" .

<http://purl.obolibrary.org/obo/HP_0020221> rdfs:label "Clonic seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A clonic seizure is a type of motor seizure characterized by sustained rhythmic jerking, that is regularly repetitive." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0000011> rdfs:label "Neurogenic bladder"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of bladder dysfunction caused by neurologic damage. Neurogenic bladder can be flaccid or spastic. Common manifestatios of neurogenic bladder are overflow incontinence, frequency, urgency, urge incontinence, and retention." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lack of bladder control due to nervous system injury" ;
    ns1:synonym "Lack of bladder control due to nervous system injury"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:397732007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:398064005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0005697" .

<http://purl.obolibrary.org/obo/HP_0000408> rdfs:label "Progressive sensorineural hearing impairment" ;
    dcterms:description "A progressive form of sensorineural hearing impairment." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bilateral progressive sensorineural hearing loss"^^<http://example.org/invalidDatatype>,
        "Hearing loss, progressive sensorineural"^^<http://example.org/invalidDatatype>,
        "Progressive bilateral sensorineural hearing loss"^^<http://example.org/invalidDatatype>,
        "Sensorineural hearing loss, progressive"^^<http://example.org/invalidDatatype>,
        "Hearing loss, sensorineural, bilateral, progressive",
