<http://purl.obolibrary.org/obo/HP_0002205> rdfs:label "Recurrent respiratory infections"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased susceptibility to respiratory infections as manifested by a history of recurrent respiratory infections."^^<http://example.org/invalidDatatype> ;
