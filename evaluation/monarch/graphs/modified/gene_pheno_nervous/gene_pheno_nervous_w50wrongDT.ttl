<http://purl.obolibrary.org/obo/HP_0000483> rdfs:label "Astigmatism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of refraction error associated with abnormal curvatures on the anterior and/or posterior surface of the cornea." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal curving of the cornea or lens of the eye",
