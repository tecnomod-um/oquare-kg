<http://purl.obolibrary.org/obo/HP_0002099> rdfs:label "Asthma" ;
    dcterms:description "Asthma is characterized by increased responsiveness of the tracheobronchial tree to multiple stimuli, leading to narrowing of the air passages with resultant dyspnea, cough, and wheezing." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Asthma",
        "Bronchial asthma" ;
    ns1:related_synonym "Reactive airway disease"^^<http://example.org/invalidDatatype> ;
