    ns1:exact_synonym "SLE"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "SLE" ;
    ns1:xref "SNOMEDCT_US:55464009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0024141"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002861> rdfs:label "Melanoma" ;
    dcterms:description "The presence of a melanoma, a malignant cancer originating from pigment producing melanocytes. Melanoma can originate from the skin or the pigmented layers of the eye (the uvea)." ;
    ns1:broad_synonym "Skin cancer (melanoma)"^^<http://example.org/invalidDatatype>,
