<http://purl.obolibrary.org/obo/HP_0000511> rdfs:label "Vertical supranuclear gaze palsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A supranuclear gaze palsy is an inability to look in a vertical direction as a result of cerebral impairment. There is a loss of the voluntary aspect of eye movements, but, as the brainstem is still intact, all the reflex conjugate eye movements are normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "VSGP",
        "Vertical gaze palsy" ;
    ns1:synonym "VSGP",
        "Vertical gaze palsy" ;
    ns1:xref "SNOMEDCT_US:246773002"^^<http://example.org/invalidDatatype>,
        "UMLS:C1843369"^^<http://example.org/invalidDatatype>,
        "UMLS:C0339652" .

<http://purl.obolibrary.org/obo/HP_0000570> rdfs:label "Abnormal saccadic eye movements" ;
    dcterms:description "An abnormality of eye movement characterized by impairment of fast (saccadic) eye movements."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of saccadic eye movements" ;
    ns1:related_synonym "Impaired saccades" ;
    ns1:synonym "Abnormality of saccadic eye movements"^^<http://example.org/invalidDatatype>,
        "Impaired saccades"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4025841"^^<http://example.org/invalidDatatype>,
        "UMLS:C1842584" .

<http://purl.obolibrary.org/obo/HP_0000571> rdfs:label "Hypometric saccades" ;
    dcterms:description "Saccadic undershoot, i.e., a saccadic eye movement that has less than the magnitude that would be required to gain fixation of the object." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:246768008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0423082"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000605> rdfs:label "Supranuclear gaze palsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A supranuclear gaze palsy is an inability to look in a particular direction as a result of cerebral impairment. There is a loss of the voluntary aspect of eye movements, but, as the brainstem is still intact, all the reflex conjugate eye movements are normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Supranuclear gaze paralysis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Supranuclear gaze paralysis" ;
    ns1:xref "SNOMEDCT_US:420675003"^^<http://example.org/invalidDatatype>,
        "UMLS:C1720037"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000629> rdfs:label "Periorbital fullness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increase in periorbital soft tissue." ;
    ns1:category ns1:PhenotypicFeature ;
