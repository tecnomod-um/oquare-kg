        "SNOMEDCT_US:607007" .

<http://purl.obolibrary.org/obo/HP_0002803> rdfs:label "Congenital contracture" ;
    dcterms:description "One or more flexion contractures (a bent joint that cannot be straightened actively or passively) that are present at birth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Congenital joint contractures",
