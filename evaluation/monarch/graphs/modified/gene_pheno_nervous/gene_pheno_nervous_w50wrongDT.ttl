<http://purl.obolibrary.org/obo/HP_0030955> rdfs:label "Addictive alcohol use" ;
    dcterms:description "An addictive behavior is defined as drinking excessive amounts of alcohol over a prolonged period of time, having difficulty in reducing the amount of alcohol consumed, strongly desiring alcohol, and experiencing withdrawal symptoms when not drinking alcohol."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Alcoholism"^^<http://example.org/invalidDatatype>,
        "Alcohol addiction" ;
    ns1:synonym "Alcoholism"^^<http://example.org/invalidDatatype>,
        "Alcohol addiction" .

<http://purl.obolibrary.org/obo/HP_0031008> rdfs:label "Lingual dystonia" ;
    dcterms:description "Involuntary protrusions, movements, spams and contortions of the tongue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tongue dystonia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tongue dystonia" .

<http://purl.obolibrary.org/obo/HP_0031058> rdfs:label "Impairment of activities of daily living" ;
    dcterms:description "Difficulty in performing one or more activities normally performed every day, such as eating, bathing, dressing, grooming, work, homemaking, and leisure." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031374> rdfs:label "Ankle weakness" ;
    dcterms:description "Reduced strength of the muscles that lift or otherwise move the foot at the ankle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031843> rdfs:label "Abnormally slow thought process" ;
    dcterms:description "An inner sense from the self that thoughts are abnormally slow and the individual feels that they are unable to increase their rate of thinking. The primary pathology is the decreased rate and other qualities of thinking (e.g. naming of objects) are intact, just slowed. This may be associated with slowed speech, but may be internal and masked by speech that is limited to brief (yes or no) answers." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormally slow thought processes"^^<http://example.org/invalidDatatype>,
        "Bradyphrenia"^^<http://example.org/invalidDatatype>,
        "Slow thought processes"^^<http://example.org/invalidDatatype>,
        "Slowed thoughts"^^<http://example.org/invalidDatatype>,
        "Slowness of thought"^^<http://example.org/invalidDatatype>,
        "Mental slowness",
        "Slowed thinking" ;
    ns1:synonym "Abnormally slow thought processes"^^<http://example.org/invalidDatatype>,
        "Bradyphrenia"^^<http://example.org/invalidDatatype>,
        "Mental slowness"^^<http://example.org/invalidDatatype>,
        "Slowed thinking"^^<http://example.org/invalidDatatype>,
        "Slow thought processes",
        "Slowed thoughts",
        "Slowness of thought" .

<http://purl.obolibrary.org/obo/HP_0032037> rdfs:label "Mildly reduced visual acuity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Mild reduction of the ability to see. On the 6m visual acuity scale, mild reduction is defined as less than 6/12 but at least 6/18. On the 20ft visual acuity scale, mild reduction is defined as less than 20/40 but at least 20/70. On the decimal visual acuity scale, mild reduction is defined as less than 0.5 but at least 0.3." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mild reduction in visual acuity"^^<http://example.org/invalidDatatype>,
        "Mild visual loss"^^<http://example.org/invalidDatatype>,
        "Mild vision loss" ;
    ns1:synonym "Mild reduction in visual acuity",
        "Mild vision loss",
        "Mild visual loss" .

<http://purl.obolibrary.org/obo/HP_0032409> rdfs:label "Subcortical band heterotopia" ;
    dcterms:description "A form of subcortical heterotopia with mislocalized gray matter within the white matter.It is defined as longitudinal bands of gray matter located deep to the cerebral cortex and separated from it by a thin layer of normal appearing white matter. It is part of the lissencephaly spectrum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040019> rdfs:label "Finger clinodactyly"^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Curvature of finger"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Curvature of finger" ;
    ns1:xref "SNOMEDCT_US:17268007",
        "UMLS:C0265610",
        "UMLS:C4280298" .

<http://purl.obolibrary.org/obo/HP_0040140> rdfs:label "Degeneration of the striatum"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022417"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0045005> rdfs:label "Neural tube defect"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A neural tube defect arises when the neural tube, the embryonic precursor of the brain and spinal cord, fails to close during neurulation. The cranial region (anencephaly) or the low spine (open spina bifida; myelomeningocele) are most commonly affected although, in the severe NTD craniorachischisis, almost the entire neural tube remains open, from midbrain to low spine." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of neural tube closure"^^<http://example.org/invalidDatatype>,
        "NTD" ;
    ns1:synonym "Abnormality of neural tube closure",
        "NTD" ;
    ns1:xref "UMLS:C0027794"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:253098009" .

<http://purl.obolibrary.org/obo/HP_0045007> rdfs:label "Abnormal substantia nigra morphology" ;
    dcterms:description "A structural anomaly of the substantia nigra, which is a midbrain dopaminergic nucleus which has a critical role in modulating motor movement and reward functions as part of the basal ganglia circuitry." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the substantia nigra" ;
    ns1:synonym "Abnormality of the substantia nigra" ;
    ns1:xref "UMLS:C4022403" .

<http://purl.obolibrary.org/obo/HP_0100008> rdfs:label "Schwannoma" ;
    dcterms:description "A benign nerve sheath tumor composed of Schwann cells." ;
    ns1:category ns1:PhenotypicFeature ;
