        "Constricted, bell-shaped thorax" ;
    ns1:xref "UMLS:C1865186"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001600> rdfs:label "Abnormality of the larynx"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the larynx." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Laryngeal abnormalities",
        "Laryngeal anomalies" ;
    ns1:synonym "Laryngeal anomalies"^^<http://example.org/invalidDatatype>,
        "Laryngeal abnormalities" ;
    ns1:xref "UMLS:C4021777"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001651> rdfs:label "Dextrocardia" ;
    dcterms:description "The heart is located in the right hand sided hemithorax. That is, there is a left-right reversal (or \"mirror reflection\") of the anatomical location of the heart in which the heart is locate on the right side instead of the left."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Heart tip and four chambers point towards right side of body",
        "Thoracic situs inversus" ;
    ns1:synonym "Thoracic situs inversus"^^<http://example.org/invalidDatatype>,
        "Heart tip and four chambers point towards right side of body" ;
    ns1:xref "EPCC:02.01.02",
        "Fyler:0110",
        "Fyler:110",
        "ICD-10:Q24.0",
        "SNOMEDCT_US:27637000",
        "UMLS:C0011813" .

<http://purl.obolibrary.org/obo/HP_0001660> rdfs:label "Truncus arteriosus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A single arterial trunk arises from the cardiac mass. The pulmonary arteries, aorta and coronary arteries arise from this single trunk with no evidence of another outflow tract."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Common arterial trunk"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Persistent truncus arteriosus" ;
    ns1:synonym "Common arterial trunk"^^<http://example.org/invalidDatatype>,
        "Persistent truncus arteriosus"^^<http://example.org/invalidDatatype> ;
    ns1:xref "Fyler:0500"^^<http://example.org/invalidDatatype>,
        "Fyler:500"^^<http://example.org/invalidDatatype>,
        "ICD-10:Q20.0"^^<http://example.org/invalidDatatype>,
        "UMLS:C0041206"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:58140002",
        "UMLS:C4020867" .

<http://purl.obolibrary.org/obo/HP_0001699> rdfs:label "Sudden death" ;
    dcterms:description "Rapid and unexpected death."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:26636000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0011071"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001701> rdfs:label "Pericarditis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of the sac-like covering around the heart (pericardium)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Swelling or irritation of membrane around heart"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Swelling or irritation of membrane around heart"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:3238004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0031046" .

<http://purl.obolibrary.org/obo/HP_0001723> rdfs:label "Restrictive cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Restrictive left ventricular physiology is characterized by a pattern of ventricular filling in which increased stiffness of the myocardium causes ventricular pressure to rise precipitously with only small increases in volume, defined as restrictive ventricular physiology in the presence of normal or reduced diastolic volumes (of one or both ventricles), normal or reduced systolic volumes, and normal ventricular wall thickness." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:415295002",
        "SNOMEDCT_US:90828009",
        "UMLS:C0007196" .

<http://purl.obolibrary.org/obo/HP_0001734> rdfs:label "Annular pancreas" ;
    dcterms:description "A congenital anomaly in which the pancreas completely (or sometimes incompletely) encircles the second portion of duodenum and occasionally obstructs the more proximal duodenum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:40315008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0149955" .

<http://purl.obolibrary.org/obo/HP_0001737> rdfs:label "Pancreatic cysts" ;
    dcterms:description "A cyst of the pancreas that possess a lining of mucous epithelium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pancreatic cysts" ;
    ns1:related_synonym "Multiple pancreatic cysts"^^<http://example.org/invalidDatatype>,
        "Pancreatic cyst" ;
    ns1:synonym "Multiple pancreatic cysts",
        "Pancreatic cyst",
        "Pancreatic cysts" ;
    ns1:xref "SNOMEDCT_US:31258000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0030283"^^<http://example.org/invalidDatatype>,
        "UMLS:C1860394" .

<http://purl.obolibrary.org/obo/HP_0001772> rdfs:label "Talipes equinovalgus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deformity of foot and ankle in which the foot is bent down and outwards."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Equinovalgus deformity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Equinovalgus deformity"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0265642"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:68284008",
        "UMLS:C4020866" .

<http://purl.obolibrary.org/obo/HP_0001780> rdfs:label "Abnormal toe morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of a toe."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormalities of the toes"^^<http://example.org/invalidDatatype>,
        "Abnormality of toe"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormalities of the toes"^^<http://example.org/invalidDatatype>,
        "Abnormality of toe"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C2674738"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001820> rdfs:label "Leukonychia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "White discoloration of the nails." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "White discoloration of nails" ;
    ns1:synonym "White discoloration of nails" ;
    ns1:xref "UMLS:C0240182"^^<http://example.org/invalidDatatype>,
        "MEDDRA:10050658",
        "SNOMEDCT_US:111202002" .

<http://purl.obolibrary.org/obo/HP_0001830> rdfs:label "Postaxial foot polydactyly" ;
    dcterms:description "Polydactyly of the foot most commonly refers to the presence of six toes on one foot. Postaxial polydactyly affects the lateral ray and the duplication may range from a well-formed articulated digit to a rudimentary digit." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Extra toe attached near the little toe"^^<http://example.org/invalidDatatype>,
        "Polydactyly affecting the 5th toe"^^<http://example.org/invalidDatatype>,
        "Postaxial polydactyly of foot"^^<http://example.org/invalidDatatype>,
        "Postaxial polydactyly of feet",
        "Posterior polydactyly of foot" ;
    ns1:related_synonym "Fibular polydactyly" ;
    ns1:synonym "Polydactyly affecting the 5th toe"^^<http://example.org/invalidDatatype>,
        "Postaxial polydactyly of feet"^^<http://example.org/invalidDatatype>,
        "Posterior polydactyly of foot"^^<http://example.org/invalidDatatype>,
        "Extra toe attached near the little toe",
        "Fibular polydactyly",
        "Postaxial polydactyly of foot" ;
    ns1:xref "UMLS:C2112129"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020865"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001837> rdfs:label "Broad toe"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Visible increase in width of the non-hallux digit without an increase in the dorso-ventral dimension."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad toe",
        "Wide toe" ;
    ns1:synonym "Broad toe"^^<http://example.org/invalidDatatype>,
        "Wide toe"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1865038" .

<http://purl.obolibrary.org/obo/HP_0001864> rdfs:label "Clinodactyly of the 5th toe"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bending or curvature of a fifth toe in the tibial direction (i.e., towards the big toe)." ;
    ns1:broad_synonym "Curvature of the little toe"^^<http://example.org/invalidDatatype>,
        "Curvature of the pinkie toe"^^<http://example.org/invalidDatatype>,
        "Curvature of the pinky toe"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Curvature of the little toe",
        "Curvature of the pinkie toe",
        "Curvature of the pinky toe" ;
    ns1:xref "UMLS:C4025741",
        "UMLS:C4280586" .

<http://purl.obolibrary.org/obo/HP_0001884> rdfs:label "Talipes calcaneovalgus" ;
    dcterms:description "Talipes calcaneovalgus is a flexible foot deformity (as opposed to a rigid congenital vertical talus foot deformity) that can either present as a positional or structural foot deformity depending on severity and/or causality. The axis of calcaneovalgus deformity is in the tibiotalar joint, where the foot is positioned in extreme hyperextension. On inspection, the foot has an \"up and out\" appearance, with the dorsal forefoot practically touching the anterior aspect of the ankle and lower leg."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pes calcaneovarus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pes calcaneovarus"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:31668003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0152237"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:205083002" .

<http://purl.obolibrary.org/obo/HP_0001888> rdfs:label "Decreased total lymphocyte count"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduced number of lymphocytes in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased blood lymphocyte number"^^<http://example.org/invalidDatatype>,
        "Low lymphocyte number"^^<http://example.org/invalidDatatype>,
        "Lymphocytopenia"^^<http://example.org/invalidDatatype>,
        "Lymphopenia"^^<http://example.org/invalidDatatype>,
        "Absolute lymphocyte count decrease" ;
    ns1:synonym "Absolute lymphocyte count decrease"^^<http://example.org/invalidDatatype>,
        "Decreased blood lymphocyte number",
        "Low lymphocyte number",
        "Lymphocytopenia",
        "Lymphopenia" ;
    ns1:xref "UMLS:C0024312"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:48813009" .

<http://purl.obolibrary.org/obo/HP_0001947> rdfs:label "Renal tubular acidosis" ;
    dcterms:description "Acidosis owing to malfunction of the kidney tubules with accumulation of metabolic acids and hyperchloremia, potentially leading to complications including hypokalemia, hypercalcinuria, nephrolithiasis and nephrocalcinosis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Accumulation of acid in body due to kidney problem"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Accumulation of acid in body due to kidney problem" ;
    ns1:xref "SNOMEDCT_US:1776003",
        "UMLS:C0001126" .

<http://purl.obolibrary.org/obo/HP_0002032> rdfs:label "Esophageal atresia" ;
    dcterms:description "A developmental defect resulting in complete obliteration of the lumen of the esophagus such that the esophagus ends in a blind pouch rather than connecting to the stomach." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Birth defect in which part of esophagus did not develop"^^<http://example.org/invalidDatatype>,
        "Birth defect in which part of oesophagus did not develop" ;
    ns1:synonym "Birth defect in which part of esophagus did not develop"^^<http://example.org/invalidDatatype>,
        "Birth defect in which part of oesophagus did not develop" ;
    ns1:xref "Fyler:4412"^^<http://example.org/invalidDatatype>,
        "UMLS:C0014850"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:26179002" .

<http://purl.obolibrary.org/obo/HP_0002103> rdfs:label "Abnormal pleura morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the pulmonary pleura, the thin, transparent membrane which covers the lungs and lines the inside of the chest walls."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the pleura" ;
    ns1:synonym "Abnormality of the pleura" ;
    ns1:xref "UMLS:C4025726" .

<http://purl.obolibrary.org/obo/HP_0002173> rdfs:label "Hypoglycemic seizures"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0877056"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002193> rdfs:label "Pseudobulbar affect" ;
    dcterms:description "Pseudobulbar affect (PBA) is characterized by uncontrolled crying or laughing which may be disproportionate or inappropriate to the social context. Thus, there is a disparity between the patient's emotional expression and his or her emotional experience."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pseudobulbar behavioural symptoms"^^<http://example.org/invalidDatatype>,
        "Pseudobulbar behavioral symptoms" ;
    ns1:synonym "Pseudobulbar behavioral symptoms"^^<http://example.org/invalidDatatype>,
        "Pseudobulbar behavioural symptoms"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4025720"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002195> rdfs:label "Dysgenesis of the cerebellar vermis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Defective development of the vermis of cerebellum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025719" .

<http://purl.obolibrary.org/obo/HP_0002204> rdfs:label "Pulmonary embolism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An embolus (that is, an abnormal particle circulating in the blood) located in the pulmonary artery and thereby blocking blood circulation to the lung. Usually the embolus is a blood clot that has developed in an extremity (for instance, a deep venous thrombosis), detached, and traveled through the circulation before becoming trapped in the pulmonary artery." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blood clot in artery of lung" ;
    ns1:synonym "Blood clot in artery of lung"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:59282003",
        "UMLS:C0034065" .

<http://purl.obolibrary.org/obo/HP_0002219> rdfs:label "Facial hypertrichosis" ;
    dcterms:description "Excessive, increased hair growth located in the facial region." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased facial hair growth"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased facial hair growth"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1851400" .

<http://purl.obolibrary.org/obo/HP_0002223> rdfs:label "Absent eyebrow"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of the eyebrow." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent eyebrow",
        "Absent eyebrows",
        "Failure of development of eyebrows" ;
    ns1:narrow_synonym "Agenesis of eyebrows"^^<http://example.org/invalidDatatype>,
        "Aplasia of eyebrows"^^<http://example.org/invalidDatatype>,
        "Loss of eyebrows"^^<http://example.org/invalidDatatype>,
        "Missing eyebrows"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Loss of eyebrows"^^<http://example.org/invalidDatatype>,
        "Absent eyebrow",
        "Absent eyebrows",
        "Agenesis of eyebrows",
        "Aplasia of eyebrows",
        "Failure of development of eyebrows",
        "Missing eyebrows" ;
    ns1:xref "SNOMEDCT_US:253208007"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280581"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:422441003",
        "UMLS:C0431448",
        "UMLS:C0578682",
        "UMLS:C4280582" .

<http://purl.obolibrary.org/obo/HP_0002224> rdfs:label "Woolly hair"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The term wooly hair refers to an abnormal variant of hair that is fine, with tightly coiled curls, and often hypopigmented. Optical microscopy may reveal the presence of tight spirals and a clear diameter reduction as compared with normal hair. Electron microscopy may show flat, oval hair shafts with reduced transversal diameter."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Nappy hair texture"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Wooly hair"^^<http://example.org/invalidDatatype>,
        "Kinked hair" ;
    ns1:related_synonym "Afro-textured hair",
        "Kinky hair texture" ;
    ns1:synonym "Afro-textured hair"^^<http://example.org/invalidDatatype>,
        "Kinked hair"^^<http://example.org/invalidDatatype>,
        "Nappy hair texture"^^<http://example.org/invalidDatatype>,
        "Kinky hair texture",
        "Wooly hair" ;
    ns1:xref "MEDDRA:10048017"^^<http://example.org/invalidDatatype>,
        "UMLS:C4072835"^^<http://example.org/invalidDatatype>,
        "UMLS:C4072836"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:52564001",
        "UMLS:C0343073",
        "UMLS:C4073292" .

<http://purl.obolibrary.org/obo/HP_0002254> rdfs:label "Intermittent diarrhea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Repeated episodes of diarrhea separated by periods without diarrhea." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Episodic diarrhoea"^^<http://example.org/invalidDatatype>,
        "Episodic diarrhea",
        "Intermittent diarrhoea" ;
    ns1:synonym "Episodic diarrhea"^^<http://example.org/invalidDatatype>,
        "Episodic diarrhoea"^^<http://example.org/invalidDatatype>,
        "Intermittent diarrhoea"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0239181"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002372> rdfs:label "Normal interictal EEG" ;
    dcterms:description "Lack of observable abnormal electroencephalographic (EEG) patterns in an individual with a history of seizures. About half of individuals with epilepsy show interictal epileptiform discharges upon the first investigation. The yield can be increased by repeated studies, sleep studies, or by ambulatory EEG recordings over 24 hours. Normal interictal EEG is a sign that can be useful in the differential diagnosis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1843146"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002418> rdfs:label "Abnormal midbrain morphology" ;
    dcterms:description "An abnormality of the midbrain, which has as its parts the tectum, cerebral peduncle, midbrain tegmentum and cerebral aqueduct."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the mesencephalon"^^<http://example.org/invalidDatatype>,
        "Abnormality of the midbrain"^^<http://example.org/invalidDatatype>,
        "Abnormal shape of midbrain",
        "Abnormality of midbrain morphology" ;
    ns1:synonym "Abnormal shape of midbrain"^^<http://example.org/invalidDatatype>,
        "Abnormality of the midbrain"^^<http://example.org/invalidDatatype>,
        "Abnormality of midbrain morphology",
        "Abnormality of the mesencephalon" ;
    ns1:xref "UMLS:C4021755" .

<http://purl.obolibrary.org/obo/HP_0002423> rdfs:label "Long-tract sign"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Long-tract signs refer to symptoms that are attributable to the involvement of the long fiber tracts in the spinal cord, which connect the spinal cord to the brain and mediate spinal and motor functions. These include spasticity, hyperreflexia, and abnormal reflexes such as Babinski or Hoffman's sign. If possible, it is preferable to use the precise HPO terms for these abnormalities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Long tract signs"^^<http://example.org/invalidDatatype>,
        "Long-tract signs" ;
    ns1:synonym "Long tract signs"^^<http://example.org/invalidDatatype>,
        "Long-tract signs" ;
    ns1:xref "UMLS:C1865903" .

<http://purl.obolibrary.org/obo/HP_0002444> rdfs:label "Hypothalamic hamartoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a hamartoma of the hypothalamus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:237714006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0342418"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002480> rdfs:label "Hepatic encephalopathy" ;
    dcterms:description "Central nervous system dysfunction in association with liver failure and characterized clinically (depending on degree of severity) by lethargy, confusion, nystagmus, decorticate posturing, spasticity, and bilateral Babinski reflexes." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:13920009",
        "SNOMEDCT_US:449902003",
        "UMLS:C0019151" .

<http://purl.obolibrary.org/obo/HP_0002538> rdfs:label "Abnormal cerebral cortex morphology" ;
    dcterms:description "Any structural abnormality of the cerebral cortex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the cerebral cortex" ;
    ns1:synonym "Abnormality of the cerebral cortex"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4025701"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002542> rdfs:label "Olivopontocerebellar atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Neuronal degeneration in the cerebellum, pontine nuclei, and inferior olivary nucleus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Olivopontocerebellar degeneration" ;
    ns1:synonym "Olivopontocerebellar degeneration"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:67761004",
        "UMLS:C0028968" .

<http://purl.obolibrary.org/obo/HP_0002601> rdfs:label "Paresis of extensor muscles of the big toe" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025696"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002691> rdfs:label "Platybasia" ;
    dcterms:description "A developmental malformation of the occipital bone and upper end of the cervical spine, in which the latter appears to have pushed the floor of the occipital bone upward such that there is an abnormal flattening of the skull base." ;
    ns1:broad_synonym "Flattening of the skull base"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased basal angle of skull base"^^<http://example.org/invalidDatatype>,
        "Obtuse basal angle of skull base" ;
    ns1:synonym "Flattening of the skull base"^^<http://example.org/invalidDatatype>,
        "Increased basal angle of skull base"^^<http://example.org/invalidDatatype>,
        "Obtuse basal angle of skull base"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:86587003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0032209" .

<http://purl.obolibrary.org/obo/HP_0002761> rdfs:label "Generalized joint hypermobility"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Joint hypermobility (ability of a joint to move beyond its normal range of motion) affecting many or all joints of the body. In individuals with Joint hypermobility at multiple sites (usually five or more), the term generalized joint hypermobility is preferred." ;
