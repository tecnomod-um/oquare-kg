    ns1:xref "SNOMEDCT_US:91514001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0010043"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020203> rdfs:label "Z-band streaming"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Streaming or smearing of the Z band, which is then no longer confined to a narrow zone which bisects the I band. The Z disk may extend across the I band or the entire sarcomere in a zigzag manner. Focal thickening, smudging, and blurring of the Z band takes place concurrently. Myofibrillar disorganization is a frequent but not invariable accompanying change."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025041> rdfs:label "Thalamic calcification"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Calcium deposition in the thalamus." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025102> rdfs:label "Dysgenesis of the basal ganglia" ;
    dcterms:description "Structural abnormality of the basal ganglia related to defective development." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Basal ganglia dysgenesis" ;
    ns1:synonym "Basal ganglia dysgenesis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025387> rdfs:label "Pill-rolling tremor" ;
    dcterms:description "A type of resting tremor characterized by simultaneous rubbing movements of thumb and index fingers against each other."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pill rolling"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pill rolling" .

<http://purl.obolibrary.org/obo/HP_0025425> rdfs:label "Laryngospasm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A spasm (involuntary contraction) of the vocal cords that can make it difficult to speak or breathe."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025461> rdfs:label "Abnormal cell morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any anomaly of cell structure." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025573> rdfs:label "Mild myopia" ;
    dcterms:description "A mild form of myopia with up to -3.00 diopters." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030014> rdfs:label "Female sexual dysfunction" ;
    dcterms:description "A problem occurring during any phase of the female sexual response cycle that prevents the individual from experiencing satisfaction from the sexual activity"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1112442"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030047> rdfs:label "Abnormal lateral ventricle morphology" ;
    dcterms:description "A morphological anomaly of the lateral ventricle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of lateral ventricle"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of lateral ventricle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022662"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030081> rdfs:label "Punctate periventricular T2 hyperintense foci" ;
    dcterms:description "Multiple pointlike areas of high T2 signal observed upon magnetic resonance imaging of the periventricular cerebral white matter." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022658"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030148> rdfs:label "Heart murmur" ;
    dcterms:description "An extra or unusual sound heard during a heartbeat caused vibrations resulting from the flow of blood through the heart." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cardiac murmur"^^<http://example.org/invalidDatatype>,
        "Cardiac murmurs"^^<http://example.org/invalidDatatype>,
        "Heart murmur"^^<http://example.org/invalidDatatype>,
        "Heart murmurs"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Cardiac murmur",
        "Cardiac murmurs",
        "Heart murmur",
        "Heart murmurs" ;
    ns1:xref "SNOMEDCT_US:414786004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:421493004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:88610006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0018808" .

<http://purl.obolibrary.org/obo/HP_0030205> rdfs:label "Increased jitter at single fiber EMG"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The variation in the time interval between the two action potentials of the same motor unit is called jitter. This term therefore applies to increased variability in the interval between successive action potentials of the same motor unit, which is measured by electromyography (EMG)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased jitter at single fibre EMG"^^<http://example.org/invalidDatatype>,
        "Increased jitter at single fibre electromyography" ;
    ns1:synonym "Increased jitter at single fibre EMG"^^<http://example.org/invalidDatatype>,
        "Increased jitter at single fibre electromyography"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021045" .

<http://purl.obolibrary.org/obo/HP_0030217> rdfs:label "Limb apraxia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Difficulty in performing the correct execution of limbs movements in absence of motor impairment." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022574"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030303> rdfs:label "Hypoplastic anterior commissure" ;
    dcterms:description "Underdevelopment of the anterior commissure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022524" .

<http://purl.obolibrary.org/obo/HP_0030357> rdfs:label "Small cell lung carcinoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Small cell lung cancer (SCLC) is a type of highly malignant lung cancer that is composed of small ovoid cells. In the past, SCLC was called oat cell carcinoma because the microscopic appearance of the cells was felt to resemble oats. SLCLC usually originates near the bronchi and in many cases may grow and metastasize quickly."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Oat cell carcinoma of lung"^^<http://example.org/invalidDatatype>,
        "Small cell lung cancer"^^<http://example.org/invalidDatatype>,
        "Oat cell lung cancer" ;
    ns1:synonym "Oat cell carcinoma of lung"^^<http://example.org/invalidDatatype>,
        "Oat cell lung cancer"^^<http://example.org/invalidDatatype>,
        "Small cell lung cancer"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:254633006"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:254632001",
        "UMLS:C0149925" .

<http://purl.obolibrary.org/obo/HP_0030466> rdfs:label "Abnormal full-field electroretinogram" ;
    dcterms:description "An anomaly observed by full-field electroretinogram (ffERG). The ffERG measures the light-induced electrical activity of the retina at the corneal surface. Specifically, the ffERG records the global or total retinal electrical response to a full-field (Ganzfield) light stimulus. Isolation of the rod and cone components has important diagnostic value in differentiating between various retinal diseases. Modifying the properties of the light-stimulus (wavelength, strength, and flicker rate) as well as the adaptive state of the retina can separate the rod and cone functions of the ffERG."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072956" .

<http://purl.obolibrary.org/obo/HP_0030502> rdfs:label "Retinoschisis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Splitting of the neuroretinal layers of the retina." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:44268007",
        "UMLS:C0152439" .

<http://purl.obolibrary.org/obo/HP_0030505> rdfs:label "Nummular pigmentation of the retina" ;
    dcterms:description "Clumped pigmentary changes of nummular appearance (i.e., thought to resemble the shape of a coin or multiple coins stuck together) at the level of the retinal pigment epithelium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nummular pigmentation of the fundus"^^<http://example.org/invalidDatatype>,
        "Nummular pigmentation of the retina"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nummular pigmentation of the fundus"^^<http://example.org/invalidDatatype>,
        "Nummular pigmentation of the retina"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072990"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030588> rdfs:label "Abnormal visual field test"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal result of a test designed to test an individual's central and peripheral vision by determining the ability of the individual to perceive objects at differing locations of the visual field."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0854021" .

<http://purl.obolibrary.org/obo/HP_0030692> rdfs:label "Brain neoplasm" ;
    dcterms:description "A benign or malignant neoplasm that arises from or metastasizes to the brain."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brain tumour"^^<http://example.org/invalidDatatype>,
        "Brain tumor" ;
    ns1:synonym "Brain tumor"^^<http://example.org/invalidDatatype>,
        "Brain tumour" ;
    ns1:xref "NCIT:C2907"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:126952004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:254935002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0006118" .

<http://purl.obolibrary.org/obo/HP_0030833> rdfs:label "Neck pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the neck." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neck pain" ;
    ns1:synonym "Neck pain"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:81680005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0007859" .

<http://purl.obolibrary.org/obo/HP_0030843> rdfs:label "Cardiac amyloidosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Extracellular deposition in cardiac tissue of a proteinaceous material that, when stained with Congo red, demonstrates apple-green birefringence under polarized light and that has a distinct color when stained with sulfated Alcian blue. Viewed with electron microscopy, the amyloid deposits are seen to be composed of a beta-sheet fibrillar material. These nonbranching fibrils have a diameter of 7.5 to 10 nm and are the result of protein misfolding." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Amyloid cardiomyopathy" ;
    ns1:synonym "Amyloid cardiomyopathy" ;
    ns1:xref "SNOMEDCT_US:16573007",
        "UMLS:C0268407" .

<http://purl.obolibrary.org/obo/HP_0031098> rdfs:label "Decreased thyroid-stimulating hormone level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced amount of the thyroid-stimulating hormone (TSH), which is produced by the anterior pituitary gland and stimulates the function of the thyroid gland."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased plasma TSH",
        "Decreased thyrotropin level" ;
    ns1:synonym "Decreased thyrotropin level"^^<http://example.org/invalidDatatype>,
        "Decreased plasma TSH" .

<http://purl.obolibrary.org/obo/HP_0031100> rdfs:label "Decreased circulating inhibin B concentration" ;
    dcterms:description "The concentration of inhibin B in the blood circulation is below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031162> rdfs:label "Impaired oropharyngeal swallow response"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Delay or absence of the swallow response, reflexes triggered by the contact the food bolus makes with the anterior faucial pillars." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031179> rdfs:label "Nuchal rigidity" ;
    dcterms:description "Resistance of the extensor muscles of the neck to being bent forwards (i.e., impaired neck flexion) as a result of muscle spasm of the extensor muscles of the neck. Nuchal rigidity is not a fixed rigidity. Nuchal rigidity has been used as a bedside test for meningism, although its sensitivity for this purpose has been debated."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Meningism" ;
    ns1:synonym "Meningism"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031354> rdfs:label "Sleep onset insomnia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Difficulty initiating sleep, that is, increased sleep onset latency, refers to the condition where it takes 30 minutes or more to fall asleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Difficulty falling asleep"^^<http://example.org/invalidDatatype>,
        "Increased sleep latency"^^<http://example.org/invalidDatatype>,
        "Sleep onset insomnia"^^<http://example.org/invalidDatatype>,
        "Trouble falling asleep"^^<http://example.org/invalidDatatype>,
        "Early insomnia" ;
    ns1:synonym "Difficulty falling asleep"^^<http://example.org/invalidDatatype>,
        "Early insomnia",
        "Increased sleep latency",
        "Sleep onset insomnia",
        "Trouble falling asleep" .

<http://purl.obolibrary.org/obo/HP_0031417> rdfs:label "Rhinorrhea" ;
    dcterms:description "Increased discharge of mucus from the nose."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nasal Discharge",
        "Runny Nose" ;
    ns1:synonym "Nasal Discharge",
        "Runny Nose" .

<http://purl.obolibrary.org/obo/HP_0031434> rdfs:label "Abnormal prosody"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Prosody refers to the patterns of rhythm, stress, and intonation in spoken language. Abnormal prosody refers to abnormalities in the patterns of rhythm, stress, or intonation of speech or vocalization that can be heard by the observer. In general, this refers to overt and clear deviations in patterns from culturally accepted norms but many also include differences noted in comparison to the usual patterns of the individual (a quiet person suddenly becomes loud or vice versa)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031473> rdfs:label "Anger" ;
    dcterms:description "A state of excessive negative emotional reactivity characterized by strong feelings of hostility or antagonism typically in response to perceived provocation. It is often accompanied by physiological arousal (e.g., increased heart rate, muscle tension, or activation of the sympathetic nervous system) and expressions of blame, perceived injustice, or judgment. The experience of anger may be directed outwardly toward individuals, groups, objects, or abstract entities, or inwardly toward oneself." ;
    ns1:broad_synonym "Extreme hostility"^^<http://example.org/invalidDatatype>,
        "Furious"^^<http://example.org/invalidDatatype>,
        "Rage"^^<http://example.org/invalidDatatype>,
        "Fury",
        "Unmanaged hostility",
        "Wrath" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Boiling mad"^^<http://example.org/invalidDatatype>,
        "Hostile"^^<http://example.org/invalidDatatype>,
        "Hostility",
        "Pissed off" ;
    ns1:narrow_synonym "Hostile outbursts"^^<http://example.org/invalidDatatype>,
        "Explosive temper",
        "Prolonged resentment",
        "Resentment" ;
    ns1:synonym "Explosive temper"^^<http://example.org/invalidDatatype>,
        "Furious"^^<http://example.org/invalidDatatype>,
        "Hostile outbursts"^^<http://example.org/invalidDatatype>,
        "Hostility"^^<http://example.org/invalidDatatype>,
        "Pissed off"^^<http://example.org/invalidDatatype>,
        "Prolonged resentment"^^<http://example.org/invalidDatatype>,
        "Rage"^^<http://example.org/invalidDatatype>,
        "Resentment"^^<http://example.org/invalidDatatype>,
        "Unmanaged hostility"^^<http://example.org/invalidDatatype>,
        "Boiling mad",
        "Extreme hostility",
        "Fury",
        "Hostile",
        "Wrath" .

<http://purl.obolibrary.org/obo/HP_0031528> rdfs:label "Subretinal deposits"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Deposits accumulating between the outer retina and the retinal pigment epithelium." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031845> rdfs:label "Abnormal libido" ;
    dcterms:description "Any deviation from the normal sexual drive or desire for sexual activity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031910> rdfs:label "Abnormal cranial nerve physiology" ;
    dcterms:description "A functional abnormality affecting one or more of the cranial nerves, which emerge directly from the brain stem."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032106> rdfs:label "Conjunctival icterus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Conjunctival icterus is a condition where there is yellowing of the whites of the eyes. This is most commonly seen in patients who have liver disease."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Scleral icterus"^^<http://example.org/invalidDatatype>,
        "Yellowing of the whites of the eyes"^^<http://example.org/invalidDatatype>,
        "Yellow conjunctiva",
        "Yellow sclera" ;
    ns1:synonym "Scleral icterus"^^<http://example.org/invalidDatatype>,
        "Yellow conjunctiva"^^<http://example.org/invalidDatatype>,
        "Yellowing of the whites of the eyes"^^<http://example.org/invalidDatatype>,
        "Yellow sclera" .

<http://purl.obolibrary.org/obo/HP_0032169> rdfs:label "Severe infection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of infection that is regarded as a sign of a pathological susceptibility to infection because of unusual severity or intensity of the infection." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Unusual course of infection" ;
    ns1:synonym "Unusual course of infection" .

<http://purl.obolibrary.org/obo/HP_0032327> rdfs:label "Interhemispheric cyst" ;
    dcterms:description "Cystic collection (sac-like, fluid containing pocket of membranous tissue) located in the interhemispheric fissure, with or without communication with the ventricular system." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032667> rdfs:label "Myoclonic status epilepticus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of motor status epilepticus with repeating bilateral sudden brief (less than 100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032807> rdfs:label "Neonatal seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A seizure occurring within the neonatal period (28 days beyond the full term date)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034369> rdfs:label "Decreased level of coenzyme Q10 in skeletal muscle"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced amount of coenzyme Q10,a naturally occurring quinone, in skeletal muscle tissue." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040010> rdfs:label "Small posterior fossa"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022496"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040086> rdfs:label "Abnormal prolactin level" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal prolactin level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal prolactin level" ;
    ns1:xref "UMLS:C4022448"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040189> rdfs:label "Scaling skin" ;
    dcterms:description "Refers to the loss of the outer layer of the epidermis in large, scale-like flakes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Desquamation",
        "Scaling skin",
        "Scaly skin",
        "flaking skin",
        "peeling skin" ;
    ns1:related_synonym "Exfoliation" ;
    ns1:synonym "Desquamation"^^<http://example.org/invalidDatatype>,
        "Exfoliation"^^<http://example.org/invalidDatatype>,
        "Scaly skin"^^<http://example.org/invalidDatatype>,
        "flaking skin"^^<http://example.org/invalidDatatype>,
        "Scaling skin",
        "peeling skin" ;
    ns1:xref "SNOMEDCT_US:14411002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:271767006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0237849" .

<http://purl.obolibrary.org/obo/HP_0040197> rdfs:label "Encephalomalacia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Encephalomalacia is the softening or loss of brain tissue after cerebral infarction, cerebral ischemia, infection, craniocerebral trauma, or other injury."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cerebral softening"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Cerebral softening" ;
    ns1:xref "SNOMEDCT_US:58762006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0014068"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040307> rdfs:label "Male sexual dysfunction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A problem occurring during any phase of the male sexual response cycle that prevents the individual from experiencing satisfaction from the sexual activity" ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0045028> rdfs:label "Microlissencephaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Severe microcephaly and lissencephaly with granular surfaces with immature cortical plate, reduced in thickness, with focal polymicrogyria and immature small neurons with rare processes, intermingled with a considerable number of glial elements." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lissencephaly type III",
        "Type 3 lissencephaly",
        "Type III lissencephaly" ;
    ns1:synonym "Type III lissencephaly"^^<http://example.org/invalidDatatype>,
        "Lissencephaly type III",
        "Type 3 lissencephaly" ;
    ns1:xref "UMLS:C4021030"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100006> rdfs:label "Neoplasm of the central nervous system" ;
    dcterms:description "A neoplasm of the central nervous system." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neoplasm of the CNS",
        "Tumors of the central nervous system",
        "Tumours of the central nervous system" ;
    ns1:related_synonym "Neoplasia of the central nervous system"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tumors of the central nervous system"^^<http://example.org/invalidDatatype>,
        "Neoplasia of the central nervous system",
        "Neoplasm of the CNS",
        "Tumours of the central nervous system" ;
    ns1:xref "NCIT:C3262"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:126951006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085136"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100025> rdfs:label "Overfriendliness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of hypersociability that presents as mostly inappropriate friendliness towards others."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Excessive gregariousness"^^<http://example.org/invalidDatatype>,
        "Hypersociability"^^<http://example.org/invalidDatatype>,
        "Excessive eagerness to interact with others",
        "Excessive friendliness",
        "Overfamiliarity" ;
    ns1:synonym "Excessive eagerness to interact with others"^^<http://example.org/invalidDatatype>,
        "Excessive friendliness"^^<http://example.org/invalidDatatype>,
