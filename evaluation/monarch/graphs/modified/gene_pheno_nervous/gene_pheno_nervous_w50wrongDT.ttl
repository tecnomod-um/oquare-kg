<http://purl.obolibrary.org/obo/MONDO_0010826> rdfs:label "childhood absence epilepsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A familial generalized pediatric epilepsy, characterized by very frequent (multiple per day) absence seizures, usually occurring in children between the ages of 4 and 10 years, with, in most cases, a good prognosis." ;
    ns1:category ns1:Disease ;
