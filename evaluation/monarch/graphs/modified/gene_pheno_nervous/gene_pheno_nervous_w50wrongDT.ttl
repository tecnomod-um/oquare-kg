<http://purl.obolibrary.org/obo/HP_0002356> rdfs:label "Writer's cramp"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A focal dystonia of the fingers, hand, and/or forearm that appears when the affected person attempts to do a task that requires fine motor movements such as writing or playing a musical instrument." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Writer's cramp" ;
    ns1:synonym "Writer's cramp" ;
    ns1:xref "SNOMEDCT_US:52008007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0154676"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002366> rdfs:label "Abnormal lower motor neuron morphology" ;
    dcterms:description "Any structural anomaly of the lower motor neuron." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lower motor neuron signs"^^<http://example.org/invalidDatatype>,
        "Lower motor neuron disease",
        "Lower motor neuron manifestations" ;
    ns1:synonym "Lower motor neuron manifestations"^^<http://example.org/invalidDatatype>,
        "Lower motor neuron disease",
        "Lower motor neuron signs" ;
    ns1:xref "UMLS:C1865412" .

<http://purl.obolibrary.org/obo/HP_0002367> rdfs:label "Visual hallucination"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Visual perception in the absence of a visual stimulus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Visual hallucinations" ;
    ns1:synonym "Visual hallucinations"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:64269007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0233763" .

<http://purl.obolibrary.org/obo/HP_0002578> rdfs:label "Gastroparesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased strength of the muscle layer of stomach, which leads to a decreased ability to empty the contents of the stomach despite the absence of obstruction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Delayed gastric emptying"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Delayed gastric emptying"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:196753007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:235675006",
        "UMLS:C0152020" .

<http://purl.obolibrary.org/obo/HP_0002599> rdfs:label "Head titubation" ;
    dcterms:description "A head tremor of moderate speed (3 to 4 Hz) in the anterior-posterior direction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1608410" .

<http://purl.obolibrary.org/obo/HP_0002615> rdfs:label "Hypotension" ;
    dcterms:description "Low Blood Pressure, vascular hypotension."^^<http://example.org/invalidDatatype> ;
