<http://purl.obolibrary.org/obo/MONDO_0008718> rdfs:label "Morvan syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Morvan syndrome is a rare, life-threatening, acquired neurologic disease characterized by neuromyotonia, dysautonomia and encephalopathy with severe insomnia. Signs involving central (e.g. hallucinations, confusion, amnesia, myoclonus), autonomic (e.g. variations in blood pressure, hyperhidrosis) and peripheral (e.g. painful cramps, myokymia) hyperactivity, as well as systemic manifestations (such as weight loss, pruritus, fever), are reported. Thymoma is present in some cases."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Morvan's fibrillary chorea"^^<http://example.org/invalidDatatype>,
        "limbic encephalitis-neuromyotonia-hyperhidrosis-polyneuropathy syndrome"^^<http://example.org/invalidDatatype> ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_5000005> ;
    ns1:synonym "Morvan's fibrillary chorea",
        "limbic encephalitis-neuromyotonia-hyperhidrosis-polyneuropathy syndrome" ;
    ns1:xref "EFO:1001897"^^<http://example.org/invalidDatatype>,
        "GARD:0009766"^^<http://example.org/invalidDatatype>,
        "MEDGEN:1632829"^^<http://example.org/invalidDatatype>,
        "SCTID:763803004"^^<http://example.org/invalidDatatype>,
        "Orphanet:83467",
        "UMLS:C3854373" .

