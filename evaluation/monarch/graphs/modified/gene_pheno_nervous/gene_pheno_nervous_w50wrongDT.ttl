<http://purl.obolibrary.org/obo/HP_0012105> rdfs:label "Occipital cortical atrophy" ;
    dcterms:description "Atrophy of the occipital cortex."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023040"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012157> rdfs:label "Subcortical cerebral atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atrophy of the cerebral subcortical white and gray matter, termed subcortical atrophy, reflects loss of nerve cells in the basal ganglia or fibers in the deep white matter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023018"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012230> rdfs:label "Rhegmatogenous retinal detachment"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of retinal detachment associated with a full-thickness defect in the retina that allows fluid to pass from the vitreous space into the subretinal space between the sensory retina and the retinal pigment epithelium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:19620000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0271055"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012511> rdfs:label "Temporal optic disc pallor" ;
    dcterms:description "A pale yellow discoloration of the temporal (lateral) portion of the optic disc."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:247220006",
        "UMLS:C0344299" .

<http://purl.obolibrary.org/obo/HP_0012515> rdfs:label "Hip flexor weakness" ;
    dcterms:description "Reduced ability to flex the femur, that is, to pull the knee upward."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3279725" .

<http://purl.obolibrary.org/obo/HP_0012672> rdfs:label "Akinetic mutism" ;
    dcterms:description "The combined absence of spontaneous movement (akinesia) and speech (mutism). There may be eye movements consistent with visual tracking and the person may remember the events occurring at the time of the experience of stupor."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Stuporous mutism"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Stuporous mutism"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0001889"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:53333005" .

<http://purl.obolibrary.org/obo/HP_0012678> rdfs:label "Iron accumulation in substantia nigra"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomalous build up of iron (Fe) in the substantia nigra."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022785"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012683> rdfs:label "Pineal cyst"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A glial uniloculated or multiloculated fluid-filled sac that either reside within or completely replace the pineal gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:413099000"^^<http://example.org/invalidDatatype>,
        "UMLS:C1335411" .

<http://purl.obolibrary.org/obo/HP_0012733> rdfs:label "Macule"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A flat, distinct, discolored area of skin less than 1 cm wide that does not involve any change in the thickness or texture of the skin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flat, discolored area of skin"^^<http://example.org/invalidDatatype>,
