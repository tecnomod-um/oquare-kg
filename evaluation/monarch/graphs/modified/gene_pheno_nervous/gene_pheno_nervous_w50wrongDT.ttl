<http://purl.obolibrary.org/obo/HP_0025502> rdfs:label "Overweight"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased body weight with a body mass index of 25-29.9 kg per square meter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030223> rdfs:label "Perseverative thought"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The repetitive production of the same response to different commands."^^<http://example.org/invalidDatatype> ;
