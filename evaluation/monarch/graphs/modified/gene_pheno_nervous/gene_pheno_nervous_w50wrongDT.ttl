        <http://purl.obolibrary.org/obo/HP_0001627>,
        <http://purl.obolibrary.org/obo/HP_0001999> ;
    ns1:synonym "trisomy 7p22.1"^^<http://example.org/invalidDatatype>,
        "dup(7)(p22.1)" ;
