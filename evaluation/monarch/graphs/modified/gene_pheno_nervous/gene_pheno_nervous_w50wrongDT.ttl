    ns1:synonym "Abnormality of the cerebellar vermis"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4025712" .

<http://purl.obolibrary.org/obo/HP_0002401> rdfs:label "Stroke-like episode" ;
    dcterms:description "No consensus exists on what a stroke-like episode is, but these episodes can be functionally defined as a new neurological deficit, occurring with or without the context of seizures, which last longer than 24 hours." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Stroke-like episodes"^^<http://example.org/invalidDatatype>,
        "Strokelike episodes" ;
    ns1:synonym "Strokelike episodes"^^<http://example.org/invalidDatatype>,
        "Stroke-like episodes" ;
    ns1:xref "UMLS:C1857287" .

<http://purl.obolibrary.org/obo/HP_0002416> rdfs:label "Subependymal cysts" ;
    dcterms:description "Cerebral cysts, usually located in the wall of the caudate nucleus or in the caudothalamic groove. They are found in up to 5.2% of all neonates, using transfontanellar ultrasound in the first days of life."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Subependymal germinolytic cyst"^^<http://example.org/invalidDatatype>,
        "Subependymal pseudocyst"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Subependymal germinolytic cyst",
        "Subependymal pseudocyst" ;
    ns1:xref "UMLS:C1833431" .

<http://purl.obolibrary.org/obo/HP_0002435> rdfs:label "Meningocele"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Protrusion of the meninges through a defect of the skull or vertebral column." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0025299"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:171131006" .

