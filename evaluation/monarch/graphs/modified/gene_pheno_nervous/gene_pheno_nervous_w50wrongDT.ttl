    ns1:synonym "Abnormality of the neostriatum",
        "Abnormality of the striate nucleus",
        "Abnormality of the striatum" ;
    ns1:xref "UMLS:C4023607" .

<http://purl.obolibrary.org/obo/HP_0011196> rdfs:label "EEG with focal sharp waves"^^<http://example.org/invalidDatatype> ;
    dcterms:description "EEG with focal sharp transient waves of a duration between 80 and 200 msec."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023478"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011399> rdfs:label "Tibialis anterior muscle atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Wasting of the tibialis anterior muscle." ;
