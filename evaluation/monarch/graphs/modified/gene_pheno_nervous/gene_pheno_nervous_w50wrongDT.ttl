        "Fyler:310",
        "ICD-10:Q23.2",
        "UMLS:C0344760" .

<http://purl.obolibrary.org/obo/HP_0011577> rdfs:label "Partial atrioventricular canal defect" ;
    dcterms:description "A specific combination of heart defects including a primum atrial septal defect and cleft anterior mitral valve leaflet. There is not an inlet ventricular septal defect present. There are two valve annuluses and two valve orifices."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Incomplete AVSD"^^<http://example.org/invalidDatatype>,
        "Partial AVC defect"^^<http://example.org/invalidDatatype>,
        "Partial AVSD"^^<http://example.org/invalidDatatype>,
        "Partial atrioventricular septal defect"^^<http://example.org/invalidDatatype>,
        "Incomplete atrioventricular septal defect",
        "PAVSD" ;
    ns1:synonym "Incomplete AVSD"^^<http://example.org/invalidDatatype>,
        "PAVSD"^^<http://example.org/invalidDatatype>,
        "Partial AVC defect"^^<http://example.org/invalidDatatype>,
        "Partial atrioventricular septal defect"^^<http://example.org/invalidDatatype>,
        "Incomplete atrioventricular septal defect",
        "Partial AVSD" ;
    ns1:xref "SNOMEDCT_US:718216009",
        "UMLS:C4023290" .

<http://purl.obolibrary.org/obo/HP_0011590> rdfs:label "Double aortic arch"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A conenital abnormality of the aortic arch in which the two embryonic aortc arches form a vascular ring that surrounds the trachea or esophagus and then join to form the descending aorta. Double aortic arch can cause symptoms because of compression of the esophagus (dysphagia, cyanosis while eating) or trachea (stridor)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "Fyler:2761"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:10451007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265883" .

<http://purl.obolibrary.org/obo/HP_0011695> rdfs:label "Cerebellar hemorrhage"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hemorrhage into the parenchyma of the cerebellum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cerebellar haemorrhage" ;
    ns1:synonym "Cerebellar haemorrhage"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:75038005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0149854" .

<http://purl.obolibrary.org/obo/HP_0011706> rdfs:label "Second degree atrioventricular block" ;
    dcterms:description "An intermittent atrioventricular block with failure of some atrial impulses to conduct to the ventricles, i.e., some but not all atrial impulses are conducted through the atrioventricular node and trigger ventricular contraction." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:195042002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0264906" .

<http://purl.obolibrary.org/obo/HP_0011733> rdfs:label "Abnormality of adrenal physiology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A functional abnormality of the adrenal glands." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023212" .

<http://purl.obolibrary.org/obo/HP_0011752> rdfs:label "Neoplasm of the posterior pituitary"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a neoplasm (tumor) in the neurohypophysis, which is also known as the posterior lobe of the hypophysis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neoplasm of the neurohypophysis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Neoplasm of the neurohypophysis" ;
    ns1:xref "NCIT:C3262"^^<http://example.org/invalidDatatype>,
        "UMLS:C1334957" .

<http://purl.obolibrary.org/obo/HP_0011759> rdfs:label "Pituitary gonadotropic cell adenoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of pituitary adenoma that produces gonadotropins."^^<http://example.org/invalidDatatype> ;
