<http://purl.obolibrary.org/obo/MONDO_0008442> rdfs:label "spastic paraplegia-neuropathy-poikiloderma syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Spastic paraplegia-neuropathy-poikiloderma syndrome is a complex form of hereditary spastic paraplegia characterized by spastic paraplegia, demyelinating peripheral sensorimotor neuropathy, poikiloderma (manifesting with loss of eyebrows and eyelashes in childhood in addition to delicate, smooth, and wasted skin) and distal amyotrophy (presenting after puberty). There have been no further descriptions in the literature since 1992."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Antinolo-Nieto-Borrego syndrome"^^<http://example.org/invalidDatatype> ;
