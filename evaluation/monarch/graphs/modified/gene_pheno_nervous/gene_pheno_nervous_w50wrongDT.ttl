    dcterms:description "An abnormality of a masseter muscle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073214" .

<http://purl.obolibrary.org/obo/HP_3000047> rdfs:label "Abnormal glossopharyngeal nerve morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the glossopharyngeal nerve, the ninth paired cranial nerve (CN IX)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of glossopharyngeal nerve" ;
    ns1:synonym "Abnormality of glossopharyngeal nerve" ;
    ns1:xref "UMLS:C4073255" .

<http://purl.obolibrary.org/obo/HP_4000064> rdfs:label "Poor sleep"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Subjectively or observationally reported sleep that is insufficiently restorative, disrupted, or of inadequate quality, regardless of duration. Poor sleep may involve difficulty maintaining sleep continuity, frequent awakenings, a sense of light or shallow sleep, or waking up feeling unrefreshed. It is typically identified through self-report or clinical interview and not by objective measurements."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low-quality sleep",
        "Poor sleep quality",
        "Sleeping badly" ;
    ns1:synonym "Low-quality sleep"^^<http://example.org/invalidDatatype>,
        "Poor sleep quality"^^<http://example.org/invalidDatatype>,
        "Sleeping badly" .

<http://purl.obolibrary.org/obo/HP_5000002> rdfs:label "Anti-Amphiphysin antibody"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against Amphiphysin." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_5000005> rdfs:label "Anti-CASPR2" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against contactin-associated protein-like 2 (CASPR2)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-Caspr2 antibody"^^<http://example.org/invalidDatatype>,
        "Anti-contactin-associated protein-like 2 antibody"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-Caspr2 antibody"^^<http://example.org/invalidDatatype>,
        "Anti-contactin-associated protein-like 2 antibody" .

<http://purl.obolibrary.org/obo/HP_5000016> rdfs:label "Anti-Hu antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against Hu." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-ANNA-1 antibody",
        "Anti-Neuronal Nuclear Antibody type-1 antibody" ;
    ns1:synonym "Anti-Neuronal Nuclear Antibody type-1 antibody"^^<http://example.org/invalidDatatype>,
        "Anti-ANNA-1 antibody" .

<http://purl.obolibrary.org/obo/HP_5200102> rdfs:label "Reduced social smiling" ;
    dcterms:description "Reduced production of smiles during engagement with an interactive parent, caregiver, or peer." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000246> rdfs:label "Elevated CSF D-2-hydroxyglutaric acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of D-2-hydroxyglutaric acid in the cerebrospinal fluid (CSF) is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000461> rdfs:label "Cerebral subcortical cyst" ;
    dcterms:description "A fluid-filled sac (cyst) in the region below the cortex of the cerebrum. In magnetic resonance imaging, the fluid within the cyst has the same appearance as cerebrospinal fluid (CSF)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_6000950> rdfs:label "Breath-holding spell"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A benign paroxysmal nonepileptic disorder occurring in healthy children 6 to 48 months of age. The episodes start with a provocation such as emotional upset or minor injury, and might progress to breath holding, cyanosis, and syncope." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/MONDO_0000507> rdfs:label "inclusion body myopathy with Paget disease of bone and frontotemporal dementia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inclusion body myopathy with Paget disease of bone and frontotemporal dementia (IBMPFD) is a multisystem degenerative genetic disorder characterized by adult-onset proximal and distal muscle weakness (clinically resembling limb-girdle muscular dystrophy); early-onset Paget disease of bone, manifesting with bone pain, deformity and enlargement of the long-bones; and premature frontotemporal dementia, manifesting first with dysnomia, dyscalculia and comprehension deficits followed by progressive aphasia, alexia, and agraphia. As the disease progresses, muscle weakness begins to affect the other limbs and respiratory muscles, ultimately resulting in respiratory or cardiac failure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "inclusion body myopathy with early-onset Paget disease with or without frontotemporal dementia"^^<http://example.org/invalidDatatype>,
        "limb-girdle muscular dystrophy with Paget disease of bone"^^<http://example.org/invalidDatatype>,
        "pagetoid neuroskeletal syndrome"^^<http://example.org/invalidDatatype>,
