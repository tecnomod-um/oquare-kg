<http://purl.obolibrary.org/obo/HP_0012760> rdfs:label "Reduced social responsiveness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduced ability to participate in the back-and-forth flow of social interaction appropriate to culture and developmental level, which is normally characterized by an influence of the behavior of one person on the behavior of another person. This results in difficulty interacting with others through emotional, physical, or verbal communication."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Impaired social interaction"^^<http://example.org/invalidDatatype>,
        "Impaired social interactions"^^<http://example.org/invalidDatatype>,
        "Impaired social reciprocity"^^<http://example.org/invalidDatatype>,
        "Poor social interactions"^^<http://example.org/invalidDatatype> ;
