<http://purl.obolibrary.org/obo/HP_0011333> rdfs:label "Asymmetric crying face" ;
    dcterms:description "Asymmetry observed in the face of a neonate or infant whose face appears symmetric at rest and asymmetric during crying as the mouth is pulled downward on one side while not moving on the other side."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial unilateral facial paresis"^^<http://example.org/invalidDatatype>,
        "Asymmetric crying face" ;
