        "Duane retraction syndrome 3 with or without deafness"^^<http://example.org/invalidDatatype>,
        "Duane retraction syndrome caused by mutation in MAFB"^^<http://example.org/invalidDatatype>,
        "Duane syndrome type 3"^^<http://example.org/invalidDatatype>,
        "MAFB Duane retraction syndrome"^^<http://example.org/invalidDatatype>,
        "Duane retraction syndrome 3" ;
