    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High lysine levels in cerebrospinal fluid" ;
    ns1:synonym "High lysine levels in cerebrospinal fluid"^^<http://example.org/invalidDatatype> .

