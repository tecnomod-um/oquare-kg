<http://purl.obolibrary.org/obo/HP_0000124> rdfs:label "Renal tubular dysfunction" ;
    dcterms:description "Abnormal function of the renal tubule. The basic functional unit of the kidney, the nephron, consists of a renal corpuscle attached to a renal tubule, with roughly 0.8 to 1.5 nephrons per adult kidney. The functions of the renal tubule include reabsorption of water, electrolytes, glucose, and amino acids and secretion of substances such as uric acid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Renal tubular defect"^^<http://example.org/invalidDatatype>,
        "Abnormal function of filtrating structures in kidney" ;
    ns1:related_synonym "Renal tubular disease" ;
