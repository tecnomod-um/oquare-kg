<http://purl.obolibrary.org/obo/HP_0012484> rdfs:label "Abnormal dense granules"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Defective structure, size or content of dense granules, platelet organelles that contain granules proaggregatory factors such as adenosine diphosphate (ADP), adenosine triphosphate (ATP), ionized calcium, histamine and serotonin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022885"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012492> rdfs:label "Cerebral artery stenosis" ;
    dcterms:description "Narrowing or constriction of the inner surface (lumen) of a cerebral artery." ;
