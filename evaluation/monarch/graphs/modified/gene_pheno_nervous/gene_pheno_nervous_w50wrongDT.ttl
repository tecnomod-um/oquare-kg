    ns1:synonym "Abnormality of the brainstem white matter"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022876" .

<http://purl.obolibrary.org/obo/HP_0012518> rdfs:label "Abnormal circle of Willis morphology" ;
    dcterms:description "An anomaly of the circle of Willis, also known as the cerebral arterial circle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the cerebral arterial circle" ;
    ns1:synonym "Abnormality of the cerebral arterial circle" ;
    ns1:xref "UMLS:C4022868" .

<http://purl.obolibrary.org/obo/HP_0012521> rdfs:label "Optic nerve aplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Congenital absence of the optic nerve."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent optic nerve",
        "Aplastic optic nerve" ;
    ns1:synonym "Absent optic nerve"^^<http://example.org/invalidDatatype>,
        "Aplastic optic nerve"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021084"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012535> rdfs:label "Abnormal synaptic transmission" ;
    dcterms:description "An anomaly in the communication from a neuron to a target across a synapse. This is a four step process, comprising (i) synthesis and storage of neurotransmitters; (ii) neurotransmitter release; (iii) activation of postsynaptic receptors by the neurotransmitter; and (iv) inactivation of the neurotransmitter. Thus, this term is defined as an anomaly of neurotransmitter metabolic process." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of neurotransmitter metabolism" ;
    ns1:synonym "Abnormality of neurotransmitter metabolism"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021083" .

<http://purl.obolibrary.org/obo/HP_0012541> rdfs:label "Cephalohematoma" ;
    dcterms:description "Hemorrhage between the skull and periosteum of a newborn resulting from rupture of blood vessels that cross the periosteum."^^<http://example.org/invalidDatatype> ;
