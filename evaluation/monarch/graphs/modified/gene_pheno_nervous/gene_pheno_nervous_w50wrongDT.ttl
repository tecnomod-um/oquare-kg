        "icd11.foundation:1067045592" .

<http://purl.obolibrary.org/obo/MONDO_0015346> rdfs:label "epilepsy with eyelid myoclonia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare, idiopathic, generalized form of reflex epilepsy characterized by childhood onset, unique seizure manifestations, striking light sensitivity, and possible occurrence of generalized tonic-clonic seizures."^^<http://example.org/invalidDatatype> ;
