<http://purl.obolibrary.org/obo/MONDO_0019838> rdfs:label "adenohypophysitis" ;
    dcterms:description "A rare, acquired pituitary hormone deficiency characterized by an inflammation of anterior pituitary with varying degrees of pituitary hormonal impairment and/or with symptoms related to pituitary enlargement. Clinical presentation is variable and includes headaches, visual disturbances, symptoms of adrenal insufficiency, hyperprolactinemia, hypothyroidism and hypogonadism. It most commonly affects young women during pregnancy or postpartum period."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "adenohypophysis inflammation"^^<http://example.org/invalidDatatype>,
