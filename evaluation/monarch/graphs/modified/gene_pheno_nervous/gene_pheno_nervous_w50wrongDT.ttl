    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal brain imaging" ;
    ns1:synonym "Abnormal brain imaging"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001622> rdfs:label "Premature birth" ;
    dcterms:description "The birth of a baby of less than 37 weeks of gestational age."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
