    ns1:xref "UMLS:C4073099"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031284> rdfs:label "Flushing" ;
    dcterms:description "Recurrent episodes of redness of the skin together with a sensation of warmth or burning of the affected areas of skin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031491> rdfs:label "Continuous spike and waves during slow sleep"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diffuse, bilateral and recently also unilateral or focal localization spike-wave occurring in slow sleep or non-rapid eye movement sleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "CSWS",
        "Electrical status epilepticus during slow-wave sleep" ;
    ns1:synonym "CSWS"^^<http://example.org/invalidDatatype>,
        "Electrical status epilepticus during slow-wave sleep" .

<http://purl.obolibrary.org/obo/HP_0031993> rdfs:label "Hoffmann sign"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A Hoffmann test is performed by flicking the fingernail of the long finger, from dorsal to volar, on each hand while the hand was supported by the examiner's hand. The test was done with the neck in the neutral position and then with the neck maximally forward flexed. Any flexion of the ipsilateral thumb and/or index finger was interpreted as a positive test." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hoffmann's sign"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hoffmann's sign" .

<http://purl.obolibrary.org/obo/HP_0032046> rdfs:label "Focal cortical dysplasia" ;
    dcterms:description "A type of malformation of cortical development that primarily affects areas of neocortex. It can be identified on conventional magnetic resonance imaging as focal cortical thickening, abnormal gyration, and blurring between gray and white matter, often associated with clusters of heterotopic neurons."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033044> rdfs:label "Motor regression" ;
    dcterms:description "Loss of previously achieved motor skills, as manifested by loss of developmental motor milestones." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Regression of motor skills" ;
    ns1:synonym "Regression of motor skills" .

<http://purl.obolibrary.org/obo/HP_0033051> rdfs:label "Impaired executive functioning" ;
    dcterms:description "A disturbance of executive functioning, which is broadly defined as the set of abilities that allow for the planning, executing, monitoring, and self-correcting of goal-directed behavior while inhibiting task-irrelevant behavior. At least some degree of executive skill is needed to complete most cognitive tasks, and deficits in executive abilities are central to many clinical conditions, including fronto-temporal dementia." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040049> rdfs:label "Macular edema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Thickening of the retina that takes place due to accumulation of extracellular fluid in the macula as a nonspecific response to blood-retinal barrier breakdown. It can either have a cystoid aspect in the fovea, or a more diffuse aspect."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular oedema" ;
    ns1:synonym "Macular oedema"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0271051"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:37231002" .

