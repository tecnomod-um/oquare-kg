<http://purl.obolibrary.org/obo/HP_0011163> rdfs:label "Focal sensory seizure with somatosensory features"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A seizure characterized by sensory phenomena including tingling, numbness, electric-shock like sensation, pain, sense of movement, or desire to move as its first clinical manifestation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal somatosensory seizure"^^<http://example.org/invalidDatatype>,
