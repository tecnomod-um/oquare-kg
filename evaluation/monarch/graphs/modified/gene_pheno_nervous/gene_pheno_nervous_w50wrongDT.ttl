<http://purl.obolibrary.org/obo/HP_0009775> rdfs:label "Amniotic constriction ring" ;
    dcterms:description "Annular constrictions around the digits, limbs, or trunk, occurring congenitally (sometimes causing intrauterine autoamputation) and also associated with a wide variety of disorders. Constrictive amniotic bands are the result of primary amniotic rupture, which can lead to entanglement of fetal tissue (especially limbs) in fibrous amniotic strands." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Amniotic bands",
        "Congenital constriction band sequence",
        "Pseudoainhum" ;
    ns1:related_synonym "Amniotic constriction band" ;
