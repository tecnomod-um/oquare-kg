<http://purl.obolibrary.org/obo/MONDO_0006626> rdfs:label "diabetic neuropathy" ;
    dcterms:description "A chronic, pathological complication associated with diabetes mellitus, where nerve damages are incurred due to diabetic microvascular injury involving small blood vessels that supply these nerves, resulting in peripheral and/or autonomic nerve dysfunction."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/MONDO_0005015> ;
