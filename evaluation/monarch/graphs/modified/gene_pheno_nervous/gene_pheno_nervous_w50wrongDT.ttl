    ns1:synonym "Heterochromia irides"^^<http://example.org/invalidDatatype>,
        "Different colored eyes",
        "Different coloured eyes" ;
    ns1:xref "SNOMEDCT_US:247033008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0423318"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001116> rdfs:label "Macular pseudocoloboma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A so-called macular coloboma is characterized by a sharply defined, usually excavated, area without neuroretina and RPE tissues in the central area of the fundus. This lesion is not related to classical colobomas associated with optic fissure closure defects."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macular coloboma"^^<http://example.org/invalidDatatype>,
        "Coloboma of the macula" ;
    ns1:synonym "Macular coloboma"^^<http://example.org/invalidDatatype>,
        "Coloboma of the macula" ;
    ns1:xref "UMLS:C1852767" .

<http://purl.obolibrary.org/obo/HP_0001169> rdfs:label "Broad palm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "For children from birth to 4 years of age the palm width is more than 2 SD above the mean; for children from 4 to 16 years of age the palm width is above the 95th centile; or, the width of the palm appears disproportionately wide for the length." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broad hands"^^<http://example.org/invalidDatatype>,
        "Broad palm"^^<http://example.org/invalidDatatype>,
        "Wide palm"^^<http://example.org/invalidDatatype>,
        "Broad hand" ;
    ns1:synonym "Broad hands"^^<http://example.org/invalidDatatype>,
        "Wide palm"^^<http://example.org/invalidDatatype>,
        "Broad hand",
        "Broad palm" ;
    ns1:xref "UMLS:C0264142"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:48251003" .

<http://purl.obolibrary.org/obo/HP_0001178> rdfs:label "Ulnar claw" ;
    dcterms:description "An abnormal hand position characterized by hyperextension of the fourth and fifth fingers at the metacarpophalangeal joints and flexion of the interphalangeal joints of the same fingers such that they are curled towards the palm." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025799" .

