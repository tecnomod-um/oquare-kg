<http://purl.obolibrary.org/obo/HP_0009077> rdfs:label "Weakness of long finger extensor muscles"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4024601" .

<http://purl.obolibrary.org/obo/HP_0009099> rdfs:label "Median cleft palate" ;
    dcterms:description "Cleft palate of the midline of the palate." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Central cleft palate"^^<http://example.org/invalidDatatype>,
        "Midline cleft palate"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Central cleft palate"^^<http://example.org/invalidDatatype>,
        "Midline cleft palate" ;
    ns1:xref "UMLS:C1850968" .

<http://purl.obolibrary.org/obo/HP_0009592> rdfs:label "Astrocytoma" ;
    dcterms:description "Astrocytoma is a neoplasm of the central nervous system derived from astrocytes. Astrocytes are a type of glial cell, and thus astrocytoma is a subtype of glioma."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:38713004",
        "UMLS:C0004114" .

<http://purl.obolibrary.org/obo/HP_0009710> rdfs:label "Chilblains" ;
    dcterms:description "Chilblains, also called perniosis, are an inflammatory skin condition related to an abnormal vascular response to the cold. We are unaware of a reliable estimate of incidence. It typically presents as tender, pruritic red or bluish lesions located symmetrically on the dorsal aspect of the fingers, toes, ears and nose. Less commonly, reports describe involvement of the thighs and buttocks. The lesions present hours after exposure to cold and usually resolve spontaneously in one to three weeks." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chilblain lesions"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Chilblain lesions"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4024224" .

<http://purl.obolibrary.org/obo/HP_0009737> rdfs:label "Lisch nodules" ;
    dcterms:description "The presence of pigmented, oval and dome-shaped raised hamartomatous nevi of the iris.." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Iris hamartomas" ;
    ns1:synonym "Iris hamartomas"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1860334" .

