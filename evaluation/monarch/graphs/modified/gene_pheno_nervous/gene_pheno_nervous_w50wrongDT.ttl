    dcterms:description "Nodding movement of the head or body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0231690"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:78691002" .

<http://purl.obolibrary.org/obo/HP_0030353> rdfs:label "Decreased circulating serum insulin-like growth factor 1 concentration" ;
    dcterms:description "A reduced level of insulin-like growth factor 1 (IGF1) in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072897"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030666> rdfs:label "Retinal neovascularization" ;
    dcterms:description "In ischemic retinal disease, neovascularization (NV) involves the sprouting of new vessels from pre-existent vessels. Ischemia invariably leads to the upregulation of Vascular Endothelial Growth Factor (VEGF) production. Most frequently the new vessels grow internal to the plane of the retina. However, intraretinal proliferation of new vessels can also occur." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal vascular proliferation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Retinal vascular proliferation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:61267008",
        "UMLS:C0035320" .

<http://purl.obolibrary.org/obo/HP_0030786> rdfs:label "Photopsia" ;
    dcterms:description "Perceived flashes of light."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:56170001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085635"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030842> rdfs:label "Choking episodes"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Incidents in which a piece of food or other objects get stuck in the upper airway and provoke coughing, gagging, inability to talk, and difficulty breathing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280747"^^<http://example.org/invalidDatatype> .

