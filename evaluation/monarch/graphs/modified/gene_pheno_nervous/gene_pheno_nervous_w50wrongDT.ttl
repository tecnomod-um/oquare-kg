        "Chronic lymphocytic leukaemia",
        "Chronic lymphocytic leukemia" ;
    ns1:xref "SNOMEDCT_US:277473004"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:92814006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0023434"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:51092000" .

