<http://purl.obolibrary.org/obo/HP_0006897> rdfs:label "Abducens palsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Malfunction of the abducens nerve as manifested by impairment of the ability of the affected eye to be moved outward. Patients who develop abducens nerve palsy often present with binocular horizontal diplopia, which is a double vision when looking at objects side by side. There will be a notable weakness of the ipsilateral lateral rectus muscle leading to a deficit in of eye abduction on the affected side. Some patients may present with a constant head turning movement to maintain binocular fusion and to lessen the degree of diplopia."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abducens nerve palsy"^^<http://example.org/invalidDatatype>,
        "Lateral rectus muscle denervation paresis"^^<http://example.org/invalidDatatype>,
        "Abducens nerve paralysis",
        "Abducens nerve paresis",
        "Cranial nerve VI palsy",
        "Sixth nerve palsy" ;
    ns1:synonym "Abducens nerve paralysis"^^<http://example.org/invalidDatatype>,
        "Lateral rectus muscle denervation paresis"^^<http://example.org/invalidDatatype>,
        "Sixth nerve palsy"^^<http://example.org/invalidDatatype>,
        "Abducens nerve palsy",
        "Abducens nerve paresis",
        "Cranial nerve VI palsy" ;
    ns1:xref "SNOMEDCT_US:398760006"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:398925009"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:398963001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0271355" .

