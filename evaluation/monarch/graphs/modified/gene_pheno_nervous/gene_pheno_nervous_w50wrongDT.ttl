    ns1:xref "UMLS:C1401781"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010815> rdfs:label "Nevus sebaceous"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A congenital, hairless plaque consisting of overgrown epidermis, sebaceous glands, hair follicles, apocrine glands and connective tissue. They are a variant of epidermal naevi. Sebaceous naevi most often appear on the scalp, but they may also arise on the face, neck or forehead. At birth, a sevaceous nevus typically appears as a solitary, smooth, yellow-orange hairless patch. Sebaceous naevi become more pronounced around adolescence, often appearing bumpy, warty or scaly." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Organoid nevus"^^<http://example.org/invalidDatatype>,
        "Sebaceous mole"^^<http://example.org/invalidDatatype>,
        "Naevus sebaceous",
        "Sebaceous naevus",
        "Sebaceous nevus" ;
    ns1:synonym "Sebaceous mole"^^<http://example.org/invalidDatatype>,
        "Sebaceous naevus"^^<http://example.org/invalidDatatype>,
        "Naevus sebaceous",
        "Organoid nevus",
        "Sebaceous nevus" ;
    ns1:xref "SNOMEDCT_US:52298009"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:707136009"^^<http://example.org/invalidDatatype>,
        "UMLS:C3854181"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:239112008" .

<http://purl.obolibrary.org/obo/HP_0010817> rdfs:label "Linear nevus sebaceous" ;
    dcterms:description "A type of nevus sebaceous with a linear form, raised borders and yellowish color." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:239112008"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:707136009"^^<http://example.org/invalidDatatype>,
        "UMLS:C3854181"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:52298009" .

<http://purl.obolibrary.org/obo/HP_0010822> rdfs:label "Scintillating scotoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A scintillating scotoma is a common visual aura that can precede a migraine, whereby a spot of flickering light near the center of the visual fields occurs. The spot prevents vision, and is thus termed scotoma. The scotoma can extend into one or more shimmering arcs of white or colored flashing lights." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:2228002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0235068" .

<http://purl.obolibrary.org/obo/HP_0010826> rdfs:label "Abnormality of the twelfth cranial nerve" ;
    dcterms:description "Abnormality of the twelfth cranial nerve." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the hypoglossal nerve"^^<http://example.org/invalidDatatype>,
        "Abnormality of cranial nerve 12",
        "Abnormality of cranial nerve xii" ;
    ns1:synonym "Abnormality of cranial nerve 12"^^<http://example.org/invalidDatatype>,
        "Abnormality of cranial nerve xii"^^<http://example.org/invalidDatatype>,
        "Abnormality of the hypoglossal nerve"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021224" .

<http://purl.obolibrary.org/obo/HP_0010828> rdfs:label "Hemifacial spasm" ;
    dcterms:description "Intermittent clonic or tonic contraction of muscles supplied by facial nerve. Muscles are relaxed in between contractions." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spasms on one side of the face"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Hemifacial spasms"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hemifacial spasms"^^<http://example.org/invalidDatatype>,
        "Spasms on one side of the face" ;
    ns1:xref "SNOMEDCT_US:13753008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0278152"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010834> rdfs:label "Trophic changes related to pain" ;
    dcterms:description "Trophic changes is a term used to describe abnormalities in the area of pain that include primarily wasting away of the skin, tissues, or muscle, thinning of the bones, and changes in how the hair or nails grow, including thickening or thinning of hair or brittle nails."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Trophic changes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Trophic changes"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021220"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010835> rdfs:label "Dissociated sensory loss"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A pattern of sensory loss with selective loss of touch sensation and proprioception without loss of pain and temperature, or vice-versa."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:87275002",
        "UMLS:C0278136" .

<http://purl.obolibrary.org/obo/HP_0010844> rdfs:label "EEG with multifocal slow activity" ;
    dcterms:description "Multifocal slowing of cerebral electrical activity recorded along the scalp by electroencephalography (EEG)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023687" .

<http://purl.obolibrary.org/obo/HP_0010846> rdfs:label "EEG with persistent abnormal rhythmic activity" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EEG: persistent abnormal rhythmic activity" ;
    ns1:synonym "EEG: persistent abnormal rhythmic activity" ;
    ns1:xref "UMLS:C4021216"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010848> rdfs:label "EEG with spike-wave complexes (2.5-3.5 Hz)"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of complexes of spikes and waves (2.5-3.5 Hz) in electroencephalography (EEG)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023685"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010874> rdfs:label "Tendon xanthomatosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of xanthomas (intra-and extra-cellular accumulations of cholesterol) extensor tendons (typically over knuckles, Achilles tendon, knee, and elbows)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tendon xanthomas" ;
    ns1:synonym "Tendon xanthomas" ;
    ns1:xref "SNOMEDCT_US:69880002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0221253"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010875> rdfs:label "Chaddock reflex"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A diagnostic reflex elicited by stimulation of the skin over the surface of the lateral malleolus of the foot. The Chaddock refelx is present if there is extension of one or more or all of the toes with or without fanning of them when the external inframalleolar skin is stimulated. The Chaddock sign, similar to the Babinski sign, is taken to be an indication of disease of the spinocortical (pyramidal) tract."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:413813004"^^<http://example.org/invalidDatatype>,
        "UMLS:C1531651"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010883> rdfs:label "Aortic valve atresia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A congenital disorder of the aortic valve in which the orifice of the valve fails to develop."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aortic atresia" ;
    ns1:synonym "Aortic atresia" ;
    ns1:xref "SNOMEDCT_US:51442005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265843"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010920> rdfs:label "Zonular cataract" ;
    dcterms:description "Zonular cataracts are defined to be cataracts that affect specific regions of the lens." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1861821"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010935> rdfs:label "Abnormality of the upper urinary tract" ;
