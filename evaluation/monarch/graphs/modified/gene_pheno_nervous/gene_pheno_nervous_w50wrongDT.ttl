        "Premature suture closure" ;
    ns1:related_synonym "Craniostenosis" ;
    ns1:synonym "Premature closure of cranial sutures"^^<http://example.org/invalidDatatype>,
        "Cranial suture synostosis",
        "Craniostenosis",
        "Craniosyostosis",
        "Deformity of the skull",
        "Early fusion of cranial sutures",
        "Premature suture closure" ;
