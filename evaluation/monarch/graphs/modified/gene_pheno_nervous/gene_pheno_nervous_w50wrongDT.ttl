    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High glutamic acid levels in cerebrospinal fluid"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "High glutamic acid levels in cerebrospinal fluid"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0500208> rdfs:label "Increased CSF lysine concentration" ;
