<http://purl.obolibrary.org/obo/HP_0002046> rdfs:label "Heat intolerance" ;
    dcterms:description "The inability to maintain a comfortable body temperature in warm or hot weather."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intolerance to heat and fevers"^^<http://example.org/invalidDatatype>,
