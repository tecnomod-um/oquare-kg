<http://purl.obolibrary.org/obo/HP_0001477> rdfs:label "Compensatory chin elevation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A tendency to hold the chin elevated by about 20 to 30 degrees to compensate for a limitation of eye movement."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Compensatory head tilt/chin elevation" ;
    ns1:synonym "Compensatory head tilt/chin elevation"^^<http://example.org/invalidDatatype> ;
