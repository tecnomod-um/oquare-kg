<http://purl.obolibrary.org/obo/HP_0045025> rdfs:label "Narrow palpebral fissure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduction in the vertical distance between the upper and lower eyelids."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Narrow palpebral fissures"^^<http://example.org/invalidDatatype>,
