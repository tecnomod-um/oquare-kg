<http://purl.obolibrary.org/obo/HP_0001339> rdfs:label "Lissencephaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A spectrum of malformations of cortical development caused by insufficient neuronal migration that subsumes the terms agyria, pachygyria and subcortical band heterotopia. See also neuropathological definitions for 2-, 3-, and 4-layered lissencephaly." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fewer or absent grooves in brain" ;
    ns1:synonym "Fewer or absent grooves in brain" ;
    ns1:xref "UMLS:C0266463"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:204036008",
        "UMLS:C1879312" .

<http://purl.obolibrary.org/obo/HP_0001611> rdfs:label "Hypernasal speech" ;
