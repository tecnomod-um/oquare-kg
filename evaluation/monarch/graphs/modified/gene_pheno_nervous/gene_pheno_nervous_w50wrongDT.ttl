<http://purl.obolibrary.org/obo/HP_0002667> rdfs:label "Nephroblastoma" ;
    dcterms:description "The presence of a nephroblastoma, which is a neoplasm of the kidney that primarily affects children."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Wilms tumor"^^<http://example.org/invalidDatatype>,
