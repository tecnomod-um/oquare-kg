<http://purl.obolibrary.org/obo/MONDO_0017649> rdfs:label "hemidystonia-hemiatrophy syndrome" ;
    dcterms:description "Hemidystonia-hemiatrophy (HD-HA) is a rare dystonia, usually caused by a static cerebral injury occurring at birth or during infancy, that is characterized by a combination of hemidystonia (HD), involving one half of the body, and hemiatrophy (HA) on the same side as the HD."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "HD-HA syndrome" ;
