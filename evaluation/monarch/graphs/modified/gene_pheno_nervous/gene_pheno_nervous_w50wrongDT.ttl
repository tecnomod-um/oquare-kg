<http://purl.obolibrary.org/obo/HP_0003396> rdfs:label "Syringomyelia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dilated, glial-lined cavity in spinal cord. This cavity does not communicate with the central canal, and usually is between the dorsal columns unilaterally or bilaterally along the side of the cord."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Syrinx"^^<http://example.org/invalidDatatype>,
        "Fluid-filled cyst in spinal cord" ;
    ns1:synonym "Syrinx"^^<http://example.org/invalidDatatype>,
        "Fluid-filled cyst in spinal cord" ;
    ns1:xref "SNOMEDCT_US:111496009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0039144" .

<http://purl.obolibrary.org/obo/HP_0003798> rdfs:label "Nemaline bodies" ;
    dcterms:description "Nemaline rods are abnormal bodies that can occur in skeletal muscle fibers. The rods can be observed on histological analysis of muscle biopsy tissue or upon electron microscopy, where they appear either as extensions of sarcomeric Z-lines, in random array without obvious attachment to Z-lines (often in areas devoid of sarcomeres) or in large clusters localized at the sarcolemma or intermyofibrillar spaces." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nemaline rods"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nemaline rods" ;
    ns1:xref "UMLS:C3808039"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0004482> rdfs:label "Relative macrocephaly" ;
    dcterms:description "A relatively mild degree of macrocephaly in which the head circumference is not above two standard deviations from the mean, but appears dysproportionately large when other factors such as body stature are taken into account."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Disproportionately large head"^^<http://example.org/invalidDatatype>,
