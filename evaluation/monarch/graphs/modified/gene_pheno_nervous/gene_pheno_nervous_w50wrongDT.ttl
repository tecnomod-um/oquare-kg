    ns1:xref "UMLS:C1854928" .

<http://purl.obolibrary.org/obo/HP_0001540> rdfs:label "Diastasis recti" ;
    dcterms:description "A separation of the rectus abdominis muscle into right and left halves (which are normally joined at the midline at the linea alba)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Gap between large left and right abdominal muscles" ;
    ns1:synonym "Gap between large left and right abdominal muscles"^^<http://example.org/invalidDatatype> ;
