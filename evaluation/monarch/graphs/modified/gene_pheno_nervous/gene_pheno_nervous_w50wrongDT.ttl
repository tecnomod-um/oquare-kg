        "Echogenic bowel",
        "Echogenic foetal bowel",
        "Hyperechogenic fetal bowel" ;
    ns1:xref "UMLS:C2936423"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010963> rdfs:label "Absence of stomach bubble on fetal sonography" ;
    dcterms:description "By the 14th week of gestation it is nearly always possible to visualized the fluid-filled fetal stomach bubble on prenatal sonography. This term refers to the absence of a normal fetal stomach bubble on fetal ultrasonography performed at around 16 to 20 weeks' gestation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absence of stomach bubble on foetal sonography"^^<http://example.org/invalidDatatype>,
