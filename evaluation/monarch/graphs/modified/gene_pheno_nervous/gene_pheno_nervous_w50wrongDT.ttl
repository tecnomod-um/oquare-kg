<http://purl.obolibrary.org/obo/HP_0010818> rdfs:label "Generalized tonic seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A generalized tonic seizure is a type of generalized motor seizure characterized by bilateral limb stiffening or elevation, often with neck stiffening without a subsequent clonic phase. The tonic activity can be a sustained abnormal posture, either in extension or flexion, sometimes accompanied by tremor of the extremities." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Generalised tonic seizure"^^<http://example.org/invalidDatatype>,
        "Generalised tonic seizures"^^<http://example.org/invalidDatatype>,
