        "GARD:0005860"^^<http://example.org/invalidDatatype>,
        "ICDO:9401/3"^^<http://example.org/invalidDatatype>,
        "MedDRA:10002224"^^<http://example.org/invalidDatatype>,
        "MedDRA:10060971"^^<http://example.org/invalidDatatype>,
