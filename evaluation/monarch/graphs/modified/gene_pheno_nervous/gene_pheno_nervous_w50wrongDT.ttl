        "UMLS:C0038379" .

<http://purl.obolibrary.org/obo/HP_0001257> rdfs:label "Spasticity" ;
    dcterms:description "A motor disorder characterized by a velocity-dependent increase in tonic stretch reflexes with increased muscle tone, exaggerated (hyperexcitable) tendon reflexes."^^<http://example.org/invalidDatatype> ;
