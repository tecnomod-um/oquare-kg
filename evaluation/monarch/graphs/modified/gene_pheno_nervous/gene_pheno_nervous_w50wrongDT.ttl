    dcterms:description "A bilateral vestibular schwannoma (acoustic neurinoma)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bilateral acoustic neuromas"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Bilateral acoustic neuromas"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1136042" .

<http://purl.obolibrary.org/obo/HP_0009591> rdfs:label "Abnormal vestibulocochlear nerve morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the vestibulocochlear nerve. The vestibulocochlear nerve consists of the vestibular and cochlear nerves, also known as cranial nerve eight (CN VIII). Each nerve has distinct nuclei within the brainstem. The vestibular nerve is primarily responsible for maintaining body balance and eye movements, while the cochlear nerve is responsible for hearing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal eighth cranial nerve morphology"^^<http://example.org/invalidDatatype>,
        "Abnormality of the VIIIth cranial nerve"^^<http://example.org/invalidDatatype>,
        "Abnormality of the vestibulocochlear nerve" ;
    ns1:synonym "Abnormal eighth cranial nerve morphology"^^<http://example.org/invalidDatatype>,
        "Abnormality of the vestibulocochlear nerve"^^<http://example.org/invalidDatatype>,
        "Abnormality of the VIIIth cranial nerve" ;
    ns1:xref "UMLS:C4021431" .

<http://purl.obolibrary.org/obo/HP_0009704> rdfs:label "Chronic CSF lymphocytosis" ;
    dcterms:description "Chronic cerebrospinal fluid (CSF) lymphocytosis is defined as the finding, in at least two serial CSF examinations, of more than 5 cells per cubic millimeter." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic cerebrospinal fluid lymphocytosis" ;
    ns1:synonym "Chronic cerebrospinal fluid lymphocytosis" ;
    ns1:xref "UMLS:C4024229" .

<http://purl.obolibrary.org/obo/HP_0009709> rdfs:label "Increased CSF interferon alpha" ;
    dcterms:description "Increased concentration of interferon alpha in the cerebrospinal fluid (CSF)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1856983"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0009711> rdfs:label "Retinal capillary hemangioma" ;
    dcterms:description "A benign vascular tumor of the retina without any neoplastic characteristics."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3801"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:312935003"^^<http://example.org/invalidDatatype>,
        "UMLS:C1514915"^^<http://example.org/invalidDatatype>,
        "UMLS:C0730303" .

<http://purl.obolibrary.org/obo/HP_0009717> rdfs:label "Cortical tubers" ;
    dcterms:description "Cortical tubers in the brain are hamartomatous lesions typically located at the gray-white matter interface, commonly in the frontal and parietal lobes. Cortical tubers are composed of abnormal glial and neural cells, and the size, number, and location vary among patients."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1968959" .

<http://purl.obolibrary.org/obo/HP_0009719> rdfs:label "Hypomelanotic macule" ;
    dcterms:description "Hypomelanotic macules (\"ash leaf spots\") are white or lighter patches of skin that may appear anywhere on the body and are caused by a lack of melanin. White ash leaf-shaped macules are considered to be characteristic of tuberous sclerosis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypomelanotic macules" ;
    ns1:synonym "Hypomelanotic macules" ;
    ns1:xref "UMLS:C4024220" .

<http://purl.obolibrary.org/obo/HP_0009720> rdfs:label "Adenoma sebaceum" ;
    dcterms:description "The presence of a sebaceous adenoma with origin in the sebum secreting cells of the skin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Facial angiofibromas"^^<http://example.org/invalidDatatype>,
        "Sebaceous adenoma"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Sebaceous adenomas" ;
    ns1:synonym "Sebaceous adenomas"^^<http://example.org/invalidDatatype>,
        "Facial angiofibromas",
        "Sebaceous adenoma" ;
    ns1:xref "SNOMEDCT_US:78424008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265319"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:36025004",
        "UMLS:C1368816" .

<http://purl.obolibrary.org/obo/HP_0009721> rdfs:label "Shagreen patch" ;
    dcterms:description "A plaque representing a connective-tissue nevus. Connective tissue naevi are uncommon skin lesions that occur when the deeper layers of the skin do not develop correctly or the components of these layers occur in the wrong proportion. Shagreen patches are oval-shaped and nevoid, skin-colored or occasionally pigmented, smooth or crinkled. The word shagreen refers to a type of roughened untanned leather."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:254244007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0432363"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0009738> rdfs:label "Abnormal antihelix morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the antihelix."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal antehelix"^^<http://example.org/invalidDatatype>,
        "Abnormal antihelix"^^<http://example.org/invalidDatatype>,
        "Abnormal anthelix" ;
    ns1:synonym "Abnormal antehelix",
        "Abnormal anthelix",
        "Abnormal antihelix" ;
    ns1:xref "UMLS:C4021395" .

<http://purl.obolibrary.org/obo/HP_0009797> rdfs:label "Cholesteatoma" ;
    dcterms:description "Cholesteatoma is a benign but potentially destructive growth consisting of keratinizing epithelium located in the middle ear and/or mastoid process. In cholesteatoma, a skin cyst grows into the middle ear and mastoid. The cyst is not cancerous but can erode tissue and cause destruction of the ear." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:363668000",
        "SNOMEDCT_US:575006",
        "UMLS:C0008373" .

<http://purl.obolibrary.org/obo/HP_0009834> rdfs:label "Abnormal proximal phalanx morphology of the hand"^^<http://example.org/invalidDatatype> ;
