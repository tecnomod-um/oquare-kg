<http://purl.obolibrary.org/obo/HP_0008321> rdfs:label "Reduced factor X activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced activity of coagulation factor X. The extrinsic and intrinsic pathways converge at factor X (fX). The extrinsic pathway activates fX by means of d factor VII with its cofactor, tissue factor. The intrinsic pathway activates fX by means of the tenase complex (Ca2+ and factors VIIIa, IXa and X) on the surface of activated platelets. Factor Xa in turn activates prothrombin (factor II) to thrombin (factor IIa)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased factor x activity" ;
    ns1:related_synonym "Factor X deficiency" ;
    ns1:synonym "Factor X deficiency"^^<http://example.org/invalidDatatype>,
        "Decreased factor x activity" ;
    ns1:xref "UMLS:C0015519"^^<http://example.org/invalidDatatype>,
        "UMLS:C4024702"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:76642003" .

