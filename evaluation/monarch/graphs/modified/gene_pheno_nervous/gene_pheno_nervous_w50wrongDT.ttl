<http://purl.obolibrary.org/obo/HP_0001254> rdfs:label "Lethargy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A state of fatigue, either physical or mental slowness and sluggishness, with difficulties in initiating or performing simple tasks. Distinguished from apathy which implies indifference and a lack of desire or interest in the task. A person with lethargy may have the desire, but not the energy to engage in personal or socially relevant tasks."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dullness"^^<http://example.org/invalidDatatype>,
        "Lethargy"^^<http://example.org/invalidDatatype>,
        "Inaction",
        "Inactivity",
        "Languor",
        "Slowness",
        "Torpor" ;
    ns1:synonym "Inaction"^^<http://example.org/invalidDatatype>,
        "Inactivity"^^<http://example.org/invalidDatatype>,
        "Languor"^^<http://example.org/invalidDatatype>,
