<http://purl.obolibrary.org/obo/HP_0010976> rdfs:label "Decreased total B cell count"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The absolute number of B cells in the blood, per microlitre is below the lower limit of normal of the reference range for the appropriate sex and age-group."^^<http://example.org/invalidDatatype> ;
