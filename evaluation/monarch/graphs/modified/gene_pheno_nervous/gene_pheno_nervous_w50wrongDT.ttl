    ns1:xref "SNOMEDCT_US:249311009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0426415"^^<http://example.org/invalidDatatype>,
        "UMLS:C1400105"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280629"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001638> rdfs:label "Cardiomyopathy" ;
    dcterms:description "A myocardial disorder in which the heart muscle is structurally and functionally abnormal, in the absence of coronary artery disease, hypertension, valvular disease and congenital heart disease sufficient to cause the observed myocardial abnormality." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Disease of the heart muscle" ;
    ns1:synonym "Disease of the heart muscle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:57809008"^^<http://example.org/invalidDatatype>,
        "Fyler:1840",
        "SNOMEDCT_US:85898001",
        "UMLS:C0878544" .

<http://purl.obolibrary.org/obo/HP_0002197> rdfs:label "Generalized-onset seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A generalized-onset seizure is a type of seizure originating at some point within, and rapidly engaging, bilaterally distributed networks. The networks may include cortical and subcortical structures but not necessarily the entire cortex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Generalised onset seizure"^^<http://example.org/invalidDatatype>,
        "Generalised seizures"^^<http://example.org/invalidDatatype>,
        "Generalized seizures"^^<http://example.org/invalidDatatype>,
        "Generalized-onset seizures"^^<http://example.org/invalidDatatype>,
        "Primary generalised seizure"^^<http://example.org/invalidDatatype>,
        "Generalised-onset seizure",
        "Generalized onset seizure",
        "Primary generalized seizure" ;
    ns1:synonym "Generalised onset seizure"^^<http://example.org/invalidDatatype>,
        "Generalized onset seizure"^^<http://example.org/invalidDatatype>,
        "Generalized-onset seizures"^^<http://example.org/invalidDatatype>,
        "Generalised seizures",
        "Generalised-onset seizure",
        "Generalized seizures",
        "Primary generalised seizure",
        "Primary generalized seizure" ;
    ns1:xref "SNOMEDCT_US:246545002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0234533"^^<http://example.org/invalidDatatype>,
        "UMLS:C1833488" .

<http://purl.obolibrary.org/obo/HP_0002311> rdfs:label "Incoordination"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deficit in coordination of muscle movements. Coordination is defined as the orchestrated movement of multiple body parts as required to accomplish intended actions, like walking." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Incoordination"^^<http://example.org/invalidDatatype>,
        "Incoordination of limb movements"^^<http://example.org/invalidDatatype>,
        "Limb incoordination"^^<http://example.org/invalidDatatype>,
        "Poor motor coordination"^^<http://example.org/invalidDatatype>,
        "Difficulties in coordination",
        "Poor coordination" ;
    ns1:synonym "Difficulties in coordination"^^<http://example.org/invalidDatatype>,
        "Limb incoordination"^^<http://example.org/invalidDatatype>,
        "Poor coordination"^^<http://example.org/invalidDatatype>,
        "Poor motor coordination"^^<http://example.org/invalidDatatype>,
        "Incoordination",
        "Incoordination of limb movements" ;
    ns1:xref "SNOMEDCT_US:302289002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:281016006",
        "UMLS:C0520966" .

<http://purl.obolibrary.org/obo/HP_0003307> rdfs:label "Hyperlordosis" ;
    dcterms:description "Abnormally increased curvature (anterior concavity) of the lumbar or cervical spine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lordosis"^^<http://example.org/invalidDatatype>,
        "Prominent swayback" ;
    ns1:synonym "Lordosis",
        "Prominent swayback" ;
    ns1:xref "SNOMEDCT_US:61960001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:249710008",
        "UMLS:C0024003" .

<http://purl.obolibrary.org/obo/HP_0008947> rdfs:label "Floppy infant"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Floppiness/hypotonia is defined as reduced resistance to passive movement of joints. Physical examination of floppy/hypotonic infants shows head lag, lack of shoulder and elbow muscle contraction on traction response, inability to tighten the shoulder girdle muscles (or slipping through) when held under the axillae, scarf sign (when the arm is pulled to the opposite side, the arm wraps around the neck with the elbow crossing midline), hyperdorsiflexion of the feet, easy apposition of the thumb against the forearm, feet touching the cheek with ease and without discomfort, frog leg position, and inverted U sign on ventral suspension (head, arms, and legs hanging down without elbow or knee flexion and the trunk rounded in a dome shape)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypotonia early"^^<http://example.org/invalidDatatype>,
        "Infantile hypotonia"^^<http://example.org/invalidDatatype>,
        "Infantile muscular hypotonia"^^<http://example.org/invalidDatatype>,
        "Decreased muscle tone in infant",
        "Hypotonia in infancy",
        "Hypotonia, early" ;
    ns1:synonym "Decreased muscle tone in infant"^^<http://example.org/invalidDatatype>,
        "Hypotonia early"^^<http://example.org/invalidDatatype>,
        "Infantile hypotonia"^^<http://example.org/invalidDatatype>,
        "Infantile muscular hypotonia"^^<http://example.org/invalidDatatype>,
        "Hypotonia in infancy",
        "Hypotonia, early" ;
    ns1:xref "UMLS:C1860834"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000501> rdfs:label "Glaucoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Glaucoma refers loss of retinal ganglion cells in a characteristic pattern of optic neuropathy usually associated with increased intraocular pressure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0017601"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:23986001" .

<http://purl.obolibrary.org/obo/HP_0000657> rdfs:label "Oculomotor apraxia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Ocular motor apraxia is a deficiency in voluntary, horizontal, lateral, fast eye movements (saccades) with retention of slow pursuit movements. The inability to follow objects visually is often compensated by head movements. There may be decreased smooth pursuit, and cancelation of the vestibulo-ocular reflex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ocular motor apraxia"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Defective or absent horizontal voluntary eye movements"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Defective or absent horizontal voluntary eye movements"^^<http://example.org/invalidDatatype>,
        "Ocular motor apraxia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4020886"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:193662007",
        "UMLS:C3489733" .

<http://purl.obolibrary.org/obo/HP_0000666> rdfs:label "Horizontal nystagmus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Nystagmus consisting of horizontal to-and-fro eye movements." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nystagmus, horizontal" ;
    ns1:synonym "Nystagmus, horizontal" ;
    ns1:xref "SNOMEDCT_US:81756001",
        "UMLS:C0271385" .

<http://purl.obolibrary.org/obo/HP_0001298> rdfs:label "Encephalopathy" ;
    dcterms:description "Encephalopathy is a term that means brain disease, damage, or malfunction. In general, encephalopathy is manifested by an altered mental state."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:81308009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085584"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001302> rdfs:label "Pachygyria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pachygyria is a malformation of cortical development with abnormally wide gyri with sulci 1,5-3 cm apart and abnormally thick cortex measuring more than 5 mm (radiological definition). See also neuropathological definitions for 2-, 3-, and 4-layered lissencephaly."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fewer and broader ridges in brain"^^<http://example.org/invalidDatatype>,
        "Cerebral pachygyria",
        "Macrogyria" ;
    ns1:synonym "Macrogyria"^^<http://example.org/invalidDatatype>,
        "Cerebral pachygyria",
        "Fewer and broader ridges in brain" ;
    ns1:xref "UMLS:C0266483"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:23024003" .

<http://purl.obolibrary.org/obo/HP_0001357> rdfs:label "Plagiocephaly" ;
    dcterms:description "Asymmetric head shape, which is usually a combination of unilateral occipital flattening with ipsilateral frontal prominence, leading to rhomboid cranial shape." ;
    ns1:broad_synonym "Asymmetry of the posterior cranium",
        "Asymmetry of the posterior head",
        "Asymmetry of the posterior skull",
        "Flat head",
        "Rhomboid shaped head" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flattening of cranium"^^<http://example.org/invalidDatatype>,
        "Flat head syndrome",
        "Flattening of cranial vault",
        "Flattening of skull",
        "Rhomboid shaped cranium",
        "Rhomboid shaped skull" ;
    ns1:narrow_synonym "Deformational plagiocephaly"^^<http://example.org/invalidDatatype>,
        "Flattening of head"^^<http://example.org/invalidDatatype>,
        "Positional plagiocephaly"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Asymmetry of the posterior cranium"^^<http://example.org/invalidDatatype>,
        "Asymmetry of the posterior head"^^<http://example.org/invalidDatatype>,
        "Asymmetry of the posterior skull"^^<http://example.org/invalidDatatype>,
        "Flattening of cranial vault"^^<http://example.org/invalidDatatype>,
        "Flattening of cranium"^^<http://example.org/invalidDatatype>,
        "Positional plagiocephaly"^^<http://example.org/invalidDatatype>,
        "Rhomboid shaped cranium"^^<http://example.org/invalidDatatype>,
        "Deformational plagiocephaly",
        "Flat head",
        "Flat head syndrome",
        "Flattening of head",
        "Flattening of skull",
        "Rhomboid shaped head",
        "Rhomboid shaped skull" ;
    ns1:xref "SNOMEDCT_US:21850008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265529"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280598"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280807"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:254024005",
        "UMLS:C1450010",
        "UMLS:C4072830",
        "UMLS:C4280597" .

<http://purl.obolibrary.org/obo/HP_0003376> rdfs:label "Steppage gait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal gait pattern that arises from weakness of the pretibial and peroneal muscles due to a lower motor neuron lesion. Affected patients have footdrop and are unable to dorsiflex and evert the foot. The leg is lifted high on walking so that the toes clear the ground, and there may be a slapping noise when the foot strikes the ground again."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High stepping"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "High stepping" ;
    ns1:xref "UMLS:C0427149"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:27253007" .

<http://purl.obolibrary.org/obo/HP_0001518> rdfs:label "Small for gestational age" ;
    dcterms:description "Smaller than normal size according to sex and gestational age related norms, defined as a weight below the 10th percentile for the gestational age." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low birth weight"^^<http://example.org/invalidDatatype>,
        "Small for gestational age"^^<http://example.org/invalidDatatype>,
        "Birth weight less than 10th percentile" ;
    ns1:synonym "Birth weight less than 10th percentile",
        "Low birth weight",
        "Small for gestational age" ;
    ns1:xref "UMLS:C0235991"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:267258002",
        "SNOMEDCT_US:276610007",
        "UMLS:C0024032" .

<http://purl.obolibrary.org/obo/HP_0002151> rdfs:label "Increased circulating lactate concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally increased level of blood lactate (2-hydroxypropanoic acid). Lactate is produced from pyruvate by lactate dehydrogenase during normal metabolism. The terms lactate and lactic acid are often used interchangeably but lactate (the component measured in blood) is strictly a weak base whereas lactic acid is the corresponding acid. Lactic acidosis is often used clinically to describe elevated lactate but should be reserved for cases where there is a corresponding acidosis (pH below 7.35)." ;
    ns1:broad_synonym "Higher than normal levels of lactate in blood" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased blood lactate",
        "Increased serum lactate" ;
    ns1:synonym "Higher than normal levels of lactate in blood"^^<http://example.org/invalidDatatype>,
        "Increased blood lactate"^^<http://example.org/invalidDatatype>,
        "Increased serum lactate"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1836440" .

<http://purl.obolibrary.org/obo/HP_0003474> rdfs:label "Somatic sensory dysfunction"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the primary sensation that is mediated by peripheral nerves (pain, temperature, touch, vibration, joint position). The word hypoesthesia (or hypesthesia) refers to a reduction in cutaneous sensation to a specific type of testing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Sensory impairment" ;
    ns1:synonym "Sensory impairment"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:397974008"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:398026008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0020580"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:59073000" .

<http://purl.obolibrary.org/obo/HP_0030051> rdfs:label "Tip-toe gait" ;
    dcterms:description "An abnormal gait pattern characterized by the failure of the heel to contact the floor at the onset of stance during gait." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tiptoe gait"^^<http://example.org/invalidDatatype>,
        "Toe walking"^^<http://example.org/invalidDatatype>,
        "Walking on tiptoes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tiptoe gait"^^<http://example.org/invalidDatatype>,
        "Toe walking",
        "Walking on tiptoes" ;
    ns1:xref "UMLS:C1843570"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000340> rdfs:label "Sloping forehead" ;
    dcterms:description "Inclination of the anterior surface of the forehead from the vertical more than two standard deviations above the mean (objective); or apparently excessive posterior sloping of the forehead in a lateral view."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inclined forehead"^^<http://example.org/invalidDatatype>,
        "Sloping forehead"^^<http://example.org/invalidDatatype>,
        "Posteriorly sloping forehead",
        "Receding forehead" ;
    ns1:synonym "Inclined forehead",
        "Posteriorly sloping forehead",
        "Receding forehead",
        "Sloping forehead" ;
    ns1:xref "UMLS:C1857679" .

<http://purl.obolibrary.org/obo/HP_0000709> rdfs:label "Psychosis" ;
    dcterms:description "A condition characterized by changes in personality and thought patterns, often accompanied by hallucinations and delusional beliefs, is known as psychosis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Psychosis" ;
    ns1:synonym "Psychosis"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:69322001",
        "UMLS:C0033975" .

<http://purl.obolibrary.org/obo/HP_0002033> rdfs:label "Poor suck" ;
    dcterms:description "An inadequate sucking reflex, resulting in the difficult of newborns to be breast-fed."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Poor suck"^^<http://example.org/invalidDatatype>,
        "Poor sucking"^^<http://example.org/invalidDatatype>,
        "Sucking weakness"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Poor suck"^^<http://example.org/invalidDatatype>,
        "Poor sucking"^^<http://example.org/invalidDatatype>,
        "Sucking weakness"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1837142"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002395> rdfs:label "Lower limb hyperreflexia" ;
    dcterms:description "Increased intensity of the a reflex in the leg."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperreflexia in lower limbs"^^<http://example.org/invalidDatatype>,
        "Increased deep tendon reflexes in the lower limbs"^^<http://example.org/invalidDatatype>,
        "Leg hyperreflexia"^^<http://example.org/invalidDatatype>,
        "Brisk lower extremity reflexes",
        "Hyperreflexia in the lower limbs",
        "Overactive lower leg reflex" ;
    ns1:synonym "Hyperreflexia in the lower limbs"^^<http://example.org/invalidDatatype>,
        "Leg hyperreflexia"^^<http://example.org/invalidDatatype>,
        "Overactive lower leg reflex"^^<http://example.org/invalidDatatype>,
        "Brisk lower extremity reflexes",
        "Hyperreflexia in lower limbs",
        "Increased deep tendon reflexes in the lower limbs" ;
    ns1:xref "UMLS:C1836696"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003458> rdfs:label "EMG: myopathic abnormalities" ;
    dcterms:description "The presence of abnormal electromyographic patterns indicative of myopathy, such as small-short polyphasic motor unit potentials."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Myopathic electromyogram"^^<http://example.org/invalidDatatype>,
        "EMG: myopathic changes",
        "EMG: myopathy" ;
    ns1:synonym "Myopathic electromyogram"^^<http://example.org/invalidDatatype>,
        "EMG: myopathic changes",
        "EMG: myopathy" ;
    ns1:xref "UMLS:C4021726"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000473> rdfs:label "Torticollis" ;
    dcterms:description "Involuntary contractions of the neck musculature resulting in an abnormal posture of or abnormal movements of the head." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cervical dystonia"^^<http://example.org/invalidDatatype>,
        "Spasmodic torticollis"^^<http://example.org/invalidDatatype>,
        "Loxia",
        "Wry neck" ;
    ns1:synonym "Wry neck"^^<http://example.org/invalidDatatype>,
        "Cervical dystonia",
        "Loxia",
        "Spasmodic torticollis" ;
    ns1:xref "SNOMEDCT_US:270476009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0040485"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:70070008",
        "SNOMEDCT_US:74333002",
        "UMLS:C0152116",
        "UMLS:C0949445" .

<http://purl.obolibrary.org/obo/HP_0000712> rdfs:label "Emotional lability" ;
    dcterms:description "Unstable emotional experiences and frequent mood changes; emotions that are easily aroused, intense, and/or disproportionate to events and circumstances." ;
    ns1:broad_synonym "Emotional instability"^^<http://example.org/invalidDatatype>,
        "Can't control feelings",
        "Mood lability" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Can't control feelings",
        "Emotional instability",
        "Mood lability" ;
    ns1:xref "UMLS:C0085633"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:18963009" .

<http://purl.obolibrary.org/obo/HP_0001348> rdfs:label "Brisk reflexes"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Tendon reflexes that are noticeably more active than usual (conventionally denoted 3+ on clinical examination). Brisk reflexes may or may not indicate a neurological lesion. They are distinguished from hyperreflexia by the fact that hyerreflexia is characterized by hyperactive repeating (clonic) reflexes, which are considered to be always abnormal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brisk deep tendon reflexes" ;
    ns1:synonym "Brisk deep tendon reflexes"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C2673700"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002312> rdfs:label "Clumsiness" ;
    dcterms:description "Lack of physical coordination resulting in an abnormal tendency to drop items or bump into objects." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Clumsiness"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Clumsiness" ;
    ns1:xref "SNOMEDCT_US:7006003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0233844" .

<http://purl.obolibrary.org/obo/HP_0002380> rdfs:label "Fasciculations"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fasciculations are observed as small, local, involuntary muscle contractions (twitching) visible under the skin. Fasciculations result from increased irritability of an axon (which in turn is often a manifestation of disease of a motor neuron). This leads to sporadic discharges of all the muscle fibers controlled by the axon in isolation from other motor units."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fasciculation"^^<http://example.org/invalidDatatype>,
        "Muscle fasciculation"^^<http://example.org/invalidDatatype>,
        "Muscle twitch" ;
    ns1:synonym "Fasciculation"^^<http://example.org/invalidDatatype>,
        "Muscle fasciculation",
        "Muscle twitch" ;
    ns1:xref "UMLS:C0015644"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:82470000" .

<http://purl.obolibrary.org/obo/HP_0002714> rdfs:label "Downturned corners of mouth" ;
    dcterms:description "A morphological abnormality of the mouth in which the angle of the mouth is downturned. The oral commissures are positioned inferior to the midline labial fissure." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Downturned corners of mouth"^^<http://example.org/invalidDatatype>,
        "Downturned oral commisures"^^<http://example.org/invalidDatatype>,
