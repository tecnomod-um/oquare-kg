<http://purl.obolibrary.org/obo/HP_0002021> rdfs:label "Pyloric stenosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pyloric stenosis, also known as infantile hypertrophic pyloric stenosis, is an uncommon condition in infants characterized by abnormal thickening of the pylorus muscles in the stomach leading to gastric outlet obstruction. Clinically infants are well at birth. Then, at 3 to 6 weeks of age, the infants present with projectile vomiting, potentially leading to dehydration and weight loss."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Infantile hypertrophic pyloric stenosis"^^<http://example.org/invalidDatatype>,
        "Pylorus stenosis" ;
    ns1:synonym "Infantile hypertrophic pyloric stenosis"^^<http://example.org/invalidDatatype>,
        "Pylorus stenosis" ;
    ns1:xref "MEDDRA:10037621"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:367403001"^^<http://example.org/invalidDatatype>,
        "Fyler:4444",
        "UMLS:C0034194" .

