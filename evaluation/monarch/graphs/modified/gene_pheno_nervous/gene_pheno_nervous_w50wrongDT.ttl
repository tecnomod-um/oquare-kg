        "Dullness",
        "Slowness" ;
    ns1:xref "UMLS:C0023380"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:214264003" .

<http://purl.obolibrary.org/obo/HP_0001639> rdfs:label "Hypertrophic cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hypertrophic cardiomyopathy (HCM) is defined by the presence of increased ventricular wall thickness or mass in the absence of loading conditions (hypertension, valve disease) sufficient to cause the observed abnormality." ;
