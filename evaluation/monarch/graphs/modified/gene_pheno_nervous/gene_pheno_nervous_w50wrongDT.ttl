    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025344" .

<http://purl.obolibrary.org/obo/HP_0004362> rdfs:label "Abnormal enteric ganglion morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the enteric nervous system, which comprises two types of ganglia, the myenteric (Auerbach's) and submucosal (Meissner's) plexuses. The enteric nervous system functions to control gut movement, fluid exchange between the gut and its lumen, and local blood flow."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of enteric ganglion morphology" ;
    ns1:related_synonym "Abnormality of the enteric ganglia" ;
    ns1:synonym "Abnormality of enteric ganglion morphology"^^<http://example.org/invalidDatatype>,
        "Abnormality of the enteric ganglia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4025338"^^<http://example.org/invalidDatatype> .

