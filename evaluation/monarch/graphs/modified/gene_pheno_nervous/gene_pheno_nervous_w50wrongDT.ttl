    ns1:xref "UMLS:C0423414"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:247138002" .

<http://purl.obolibrary.org/obo/HP_0012185> rdfs:label "Constrictive median neuropathy" ;
    dcterms:description "Injury to the median nerve caused by its entrapment at the wrist as it traverses through the carpal tunnel. Clinically, constrictive median neuropathy is characterized by pain, paresthesia, and weakness in the median nerve distribution of the hand."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Carpal tunnel syndrome"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Carpal tunnel syndrome" ;
    ns1:xref "UMLS:C4023009" .

<http://purl.obolibrary.org/obo/HP_0012411> rdfs:label "Premature pubarche" ;
