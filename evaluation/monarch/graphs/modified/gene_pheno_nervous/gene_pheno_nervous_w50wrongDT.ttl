<http://purl.obolibrary.org/obo/HP_0012412> rdfs:label "Premature adrenarche"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Onset of adrenarche at an earlier age than usual." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0342546"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:103021001" .

<http://purl.obolibrary.org/obo/HP_0012430> rdfs:label "Cerebral white matter hypoplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Underdevelopment of the cerebral white matter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Paucity of cerebral white matter" ;
    ns1:synonym "Paucity of cerebral white matter" ;
    ns1:xref "UMLS:C4020727"^^<http://example.org/invalidDatatype>,
        "UMLS:C4022908"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012675> rdfs:label "Iron accumulation in brain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal build up of iron (Fe) in brain tissue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brain iron deposition",
        "Iron accumulation in brain" ;
    ns1:synonym "Iron accumulation in brain"^^<http://example.org/invalidDatatype>,
        "Brain iron deposition" ;
    ns1:xref "UMLS:C4021076"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012751> rdfs:label "Abnormal basal ganglia MRI signal intensity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deviation from normal signal on magnetic resonance imaging (MRI) of the basal ganglia." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022745" .

<http://purl.obolibrary.org/obo/HP_0025258> rdfs:label "Stiff neck"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A sensation of tightness in the neck when attempting to move it, especially after a period of inactivity. Neck stiffness often involves soreness and difficulty moving the neck, especially when trying to turn the head to the side." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neck stiffness"^^<http://example.org/invalidDatatype>,
        "Stiff neck" ;
    ns1:synonym "Neck stiffness"^^<http://example.org/invalidDatatype>,
        "Stiff neck"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025335> rdfs:label "Delayed ability to stand" ;
    dcterms:description "A failure to achieve the ability to stand up at an appropriate developmental stage. Most children begin to walk alone at 11 to 15 months of age. On average, children can stand while holding on at the age of 9 to 10 months, can pull up to stand and walk with one hand being held at 12 months, and can stand alone and walk well at 18 months." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025405> rdfs:label "Visual fixation instability" ;
    dcterms:description "A deficit in the ability to fixate eye movements in order to stabilize images on the retina" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Instability of ocular fixation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Instability of ocular fixation" .

<http://purl.obolibrary.org/obo/HP_0025517> rdfs:label "Hypoplastic hippocampus" ;
    dcterms:description "Underdevelopment of the hippocampus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Small hippocampus"^^<http://example.org/invalidDatatype>,
        "Underdeveloped hippocampus" ;
    ns1:synonym "Small hippocampus"^^<http://example.org/invalidDatatype>,
        "Underdeveloped hippocampus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030046> rdfs:label "Hypoglycosylation of alpha-dystroglycan"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction in the degree of glycosylation of alpha-dystroglycan in muscle tissue."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4015098" .

<http://purl.obolibrary.org/obo/HP_0030186> rdfs:label "Kinetic tremor" ;
    dcterms:description "Tremor that occurs during any voluntary movement. It may include visually or non-visually guided movements. Tremor during target directed movement is called intention tremor." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Essential tremor"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Essential tremor"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:30721006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0234376"^^<http://example.org/invalidDatatype>,
        "UMLS:C0270736"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:609558009" .

<http://purl.obolibrary.org/obo/HP_0030215> rdfs:label "Inappropriate crying"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Uncontrolled episodes of crying occur without any apparent motivating stimuli." ;
    ns1:category ns1:PhenotypicFeature ;
