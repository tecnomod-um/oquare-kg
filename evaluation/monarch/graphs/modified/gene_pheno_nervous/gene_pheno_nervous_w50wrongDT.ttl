        "Cardiac conduction abnormalities"^^<http://example.org/invalidDatatype>,
        "Cardiac conduction defects"^^<http://example.org/invalidDatatype>,
        "Abnormality of cardiac conduction",
        "Heart conduction disorder" .

<http://purl.obolibrary.org/obo/HP_0031589> rdfs:label "Suicidal ideation"^^<http://example.org/invalidDatatype> ;
