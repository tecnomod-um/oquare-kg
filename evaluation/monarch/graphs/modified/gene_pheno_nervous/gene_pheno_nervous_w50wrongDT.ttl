    ns1:xref "UMLS:C4021094"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012304> rdfs:label "Hypoplastic aortic arch"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Underdevelopment of the arch of aorta." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aortic arch hypoplasia"^^<http://example.org/invalidDatatype>,
        "Underdeveloped aortic arch" ;
    ns1:synonym "Aortic arch hypoplasia",
        "Underdeveloped aortic arch" ;
