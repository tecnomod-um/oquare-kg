<http://purl.obolibrary.org/obo/HP_0011234> rdfs:label "Absent antihelix"^^<http://example.org/invalidDatatype> ;
    dcterms:description "No discernible ridge between concha and triangular fossa and helix."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023448"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011245> rdfs:label "Abnormality of superior crus of antihelix"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the superior crus of the antihelix is the upper cartilaginous ridge arising at the bifurcation of the antihelix that ends beneath the fold of the ascending helix, and separates the concha from the triangular fossa." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of posterior crus of antihelix"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of posterior crus of antihelix" ;
    ns1:xref "UMLS:C4021190" .

<http://purl.obolibrary.org/obo/HP_0011261> rdfs:label "Darwin tubercle of helix"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Small expansion of the helical fold at the junction of the superior and descending portions of the helix." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Helix, Darwin tubercle" ;
    ns1:synonym "Helix, Darwin tubercle"^^<http://example.org/invalidDatatype> ;
