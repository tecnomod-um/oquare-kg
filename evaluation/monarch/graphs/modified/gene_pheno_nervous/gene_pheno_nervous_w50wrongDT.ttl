        "MEDGEN:1662655"^^<http://example.org/invalidDatatype>,
        "icd11.foundation:80361835"^^<http://example.org/invalidDatatype>,
        "Orphanet:139589",
        "UMLS:C4749653" .

<http://purl.obolibrary.org/obo/MONDO_0015587> rdfs:label "rolandic epilepsy-speech dyspraxia syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare, genetic epilepsy characterized by speech disorder (including a range of symptoms from dysarthria, speech dyspraxia, receptive and expressive language delay/regression and acquired aphasia to subtle impairments of conversational speech) and epilepsy (mostly focal and secondary generalized childhood-onset seizures, sometimes with aura). Mild to severe intellectual disability may also be observed."^^<http://example.org/invalidDatatype> ;
