<http://purl.obolibrary.org/obo/HP_0004345> rdfs:label "Ganglioside accumulation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Defects in the lysosomal glycosidases or specific co-activators, result in accumulation of the substrates, such as glycosphingolipids, including gangliosides in GM1 gangliosidosis (Tay-Sachs disease) and GM2 gangliosidosis (Sandhoff disease)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025348" .

<http://purl.obolibrary.org/obo/HP_0004347> rdfs:label "Weakness of muscles of respiration" ;
    dcterms:description "Reduced function of the muscles required to generate subatmospheric pressure in the thoracic cavity during breathing: the diaphragm, the external intercostal and the interchondral part of the internal intercostal muscles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025347"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0004354> rdfs:label "Abnormal circulating carboxylic acid concentration" ;
