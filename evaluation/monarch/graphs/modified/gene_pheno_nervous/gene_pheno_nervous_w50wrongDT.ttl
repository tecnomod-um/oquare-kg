<http://purl.obolibrary.org/obo/HP_0032794> rdfs:label "Myoclonic seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A myoclonic seizure is a type of motor seizure characterized by sudden, brief (<100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal). Myoclonus is less regularly repetitive and less sustained than is clonus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0100704> rdfs:label "Cerebral visual impairment" ;
    dcterms:description "A form of loss of vision caused by damage to the visual cortex rather than a defect in the eye." ;
    ns1:category ns1:PhenotypicFeature ;
