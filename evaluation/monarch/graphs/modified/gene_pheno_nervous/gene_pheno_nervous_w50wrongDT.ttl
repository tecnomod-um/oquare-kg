<http://purl.obolibrary.org/obo/HP_0100293> rdfs:label "Hypertrophied muscle fibers"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of an increased amount of muscle fibers with an increased diameter. This feature can be ascertained by microscopic examination of a muscle biopsy sample. Together with fiber size variation and atrophied muscle fibers, and hypertrophied muscle fibers are commonly found in myopathies."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Muscle fibre hypertrophy"^^<http://example.org/invalidDatatype>,
        "Muscle fiber hypertrophy" ;
    ns1:synonym "Muscle fibre hypertrophy"^^<http://example.org/invalidDatatype>,
        "Muscle fiber hypertrophy" ;
    ns1:xref "UMLS:C0333759"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:42091004" .

<http://purl.obolibrary.org/obo/HP_0100301> rdfs:label "Muscle fiber tubular inclusions" ;
    dcterms:description "Unusual regions of densely packed membranous tubules known as tubular aggregates which present as membranous inclusions, derived from membranes of sarcoplasmic reticulum and mitochondria, containing miscellaneous proteins with a variety of enzymatic activities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Muscle fiber tubular aggregates"^^<http://example.org/invalidDatatype>,
        "Muscle fibre tubular inclusions"^^<http://example.org/invalidDatatype>,
        "Muscle fibre tubular aggregates" ;
    ns1:synonym "Muscle fiber tubular aggregates",
        "Muscle fibre tubular aggregates",
        "Muscle fibre tubular inclusions" ;
    ns1:xref "UMLS:C4021024" .

<http://purl.obolibrary.org/obo/HP_0100306> rdfs:label "Muscle fiber hyaline bodies"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Subsarcolemmal, eosinophilic glass-like regions in the cytoplasm of muscle fibers. Hyaline bodies show significant reactivity to myofibrillar ATPase after acid pre-incubation and with immunohistochemistry, show intense reactivity with only slow myosin heavy chain. Electron microscopy of the affected areas show a lack of myofibrils and a uniform, finely granular matrix, sometimes suggesting a filamentous nature, containing few scattered nuclei and mitochondria." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Muscle fibre hyaline bodies"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Muscle fibre hyaline bodies" ;
    ns1:xref "UMLS:C4022155" .

