<http://purl.obolibrary.org/obo/MONDO_0010269> rdfs:label "Coats disease" ;
    dcterms:description "Coats disease (CD) is an idiopathic disorder characterized by retinal telangiectasia with deposition of intraretinal or subretinal exudates, potentially leading to retinal detachment and unilateral blindness. CD is classically an isolated and unilateral condition affecting otherwise healthy young children." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Coats disease"^^<http://example.org/invalidDatatype>,
        "Leber miliary aneurysm"^^<http://example.org/invalidDatatype>,
