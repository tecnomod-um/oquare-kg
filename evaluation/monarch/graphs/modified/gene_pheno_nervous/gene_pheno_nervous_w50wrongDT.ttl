        "UMLS:C0277799" .

<http://purl.obolibrary.org/obo/HP_0002028> rdfs:label "Chronic diarrhea" ;
    dcterms:description "The presence of chronic diarrhea, which is usually taken to mean diarrhea that has persisted for over 4 weeks." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic diarrhea"^^<http://example.org/invalidDatatype>,
        "Chronic diarrhoea"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Diarrhea, recurrent"^^<http://example.org/invalidDatatype>,
        "Recurrent diarrhea"^^<http://example.org/invalidDatatype>,
