<http://purl.obolibrary.org/obo/MONDO_0800453> rdfs:label "juvenile absence epilepsy" ;
    dcterms:description "A genetic epilepsy with onset occurring around puberty. Juvenile absence epilepsy is characterized by sporadic occurrence of absence seizures, frequently associated with a long-life prevalence of generalized tonic-clonic seizures (GTCS) and sporadic myoclonic jerks." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "JAE" ;
