    ns1:synonym "Intermittent atrial fibrillation"^^<http://example.org/invalidDatatype>,
        "Atrial fibrillation, paroxysmal",
        "Paroxysmal AF" ;
    ns1:xref "SNOMEDCT_US:282825002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0235480"^^<http://example.org/invalidDatatype> .

