        "Increased cup disc ratio"^^<http://example.org/invalidDatatype>,
        "Increased cup disk ratio"^^<http://example.org/invalidDatatype>,
        "Optic cupping"^^<http://example.org/invalidDatatype>,
        "Elevated cup to disk ratio" ;
    ns1:xref "UMLS:C3805911"^^<http://example.org/invalidDatatype> .

