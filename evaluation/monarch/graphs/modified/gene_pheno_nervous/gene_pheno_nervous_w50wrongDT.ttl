        "Inability to sleep" ;
    ns1:xref "SNOMEDCT_US:193462001",
        "UMLS:C0917801" .

<http://purl.obolibrary.org/obo/MONDO_0018998> rdfs:label "Leber congenital amaurosis" ;
    dcterms:description "Leber congenital amaurosis (LCA) is a retinal dystrophy defined by blindness and responses to electrophysiological stimulation (Ganzfeld electroretinogram (ERG)) below threshold, associated with severe visual impairment within the first year of life." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Leber congenital amaurosis",
        "amaurosis congenita of Leber" ;
