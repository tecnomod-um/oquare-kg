<http://purl.obolibrary.org/obo/HP_0011705> rdfs:label "First degree atrioventricular block"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Delay of conduction through the atrioventricular node, which is manifested as prolongation of the PR interval in the electrocardiogram (EKG). All atrial impulses reach the ventricles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0085614"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:270492004" .

