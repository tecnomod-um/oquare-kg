<http://purl.obolibrary.org/obo/HP_0030445> rdfs:label "Pulmonary carcinoid tumor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A malignant neuroendocrine tumor of the lung. According to histopathologic criteria (WHO 2004), carcinoids are divided into four groups i.e. typical and atypical carcinoids, large cell neuroendocrine carcinoma and small cell lung carcinoma." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lung carcinoid tumour"^^<http://example.org/invalidDatatype>,
        "Pulmonary carcinoid tumour"^^<http://example.org/invalidDatatype>,
        "Lung carcinoid tumor" ;
    ns1:synonym "Lung carcinoid tumor"^^<http://example.org/invalidDatatype>,
