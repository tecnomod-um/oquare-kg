<http://purl.obolibrary.org/obo/HP_0012036> rdfs:label "Sternocleidomastoid amyotrophy" ;
    dcterms:description "Wasting of the sternocleidomastoid muscle, the muscle in the anterior part of the neck that acts to flex and rotate the head."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023067"^^<http://example.org/invalidDatatype> .

