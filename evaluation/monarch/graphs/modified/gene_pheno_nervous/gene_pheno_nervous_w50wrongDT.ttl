<http://purl.obolibrary.org/obo/MONDO_0016703> rdfs:label "anaplastic oligoastrocytoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An oligoastrocytoma characterized by the presence of increased cellularity, nuclear atypia, pleomorphism, and high mitotic activity."^^<http://example.org/invalidDatatype> ;
