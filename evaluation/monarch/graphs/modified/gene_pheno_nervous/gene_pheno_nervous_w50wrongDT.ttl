        "Impaired social interactions" ;
    ns1:xref "UMLS:C4022736"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000212> rdfs:label "Gingival overgrowth"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hyperplasia of the gingiva (that is, a thickening of the soft tissue overlying the alveolar ridge. The degree of thickening ranges from involvement of the interdental papillae alone to gingival overgrowth covering the entire tooth crown."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypertrophic gingivitis"^^<http://example.org/invalidDatatype>,
        "Gingival enlargement",
        "Gingival hyperplasia",
        "Gum enlargement",
        "Gum hypertrophy" ;
    ns1:related_synonym "Oral soft tissue hyperplasia" ;
    ns1:synonym "Gingival enlargement"^^<http://example.org/invalidDatatype>,
        "Gum hypertrophy"^^<http://example.org/invalidDatatype>,
        "Gingival hyperplasia",
        "Gum enlargement",
        "Hypertrophic gingivitis",
        "Oral soft tissue hyperplasia" ;
    ns1:xref "SNOMEDCT_US:441798003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:54711002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0376480"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:441787004",
        "UMLS:C0017566",
        "UMLS:C0017567" .

<http://purl.obolibrary.org/obo/HP_0001152> rdfs:label "Saccadic smooth pursuit interruptions"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of tracking eye movements in which smooth pursuit is interrupted by an abnormally high number of saccadic movements."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Saccadic pursuit movements"^^<http://example.org/invalidDatatype>,
