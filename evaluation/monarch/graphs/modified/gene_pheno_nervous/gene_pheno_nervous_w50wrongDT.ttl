    ns1:xref "UMLS:C4023502" .

<http://purl.obolibrary.org/obo/HP_0011174> rdfs:label "Focal hyperkinetic seizure" ;
    dcterms:description "A focal seizure characterized at onset by predominantly proximal limb or axial muscles producing irregular sequential ballistic movements, such as pedaling, pelvic thrusting, thrashing, rocking movements." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Localised hyperkinetic seizure"^^<http://example.org/invalidDatatype>,
