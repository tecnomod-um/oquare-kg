<http://purl.obolibrary.org/obo/HP_0011039> rdfs:label "Abnormal helix morphology" ;
    dcterms:description "An abnormality of the helix. The helix is the outer rim of the ear that extends from the insertion of the ear on the scalp (root) to the termination of the cartilage at the earlobe."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal helices"^^<http://example.org/invalidDatatype>,
