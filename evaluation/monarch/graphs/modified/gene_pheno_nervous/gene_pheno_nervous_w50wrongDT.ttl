<http://purl.obolibrary.org/obo/HP_0011446> rdfs:label "Abnormality of mental function"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Cognitive, psychiatric, or memory anomaly."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of higher mental function"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of higher mental function"^^<http://example.org/invalidDatatype> ;
