<http://purl.obolibrary.org/obo/HP_0002083> rdfs:label "Migraine without aura"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Repeated headache attacks lasting 4-72 h fulfilling at least two of the following criteria: 1) unilateral location, 2) pulsating quality, 3) moderate or severe pain intensity, and 4) aggravation by or causing avoidance of routine physical activity such as climbing stairs. Headache attacks are commonly accompanied by nausea, vomiting, photophobia, or phonophobia." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:56097005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0338480"^^<http://example.org/invalidDatatype> .

