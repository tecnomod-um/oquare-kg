<http://purl.obolibrary.org/obo/HP_0001792> rdfs:label "Small nail"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A nail that is diminished in length and width, i.e., underdeveloped nail."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplastic nail"^^<http://example.org/invalidDatatype>,
        "Hypoplastic nails"^^<http://example.org/invalidDatatype>,
        "Small nail"^^<http://example.org/invalidDatatype>,
        "Nail hypoplasia",
        "Small nails" ;
    ns1:synonym "Hypoplastic nail"^^<http://example.org/invalidDatatype>,
        "Small nails"^^<http://example.org/invalidDatatype>,
        "Hypoplastic nails",
        "Nail hypoplasia",
        "Small nail" ;
    ns1:xref "SNOMEDCT_US:11375002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0263523" .

<http://purl.obolibrary.org/obo/HP_0001822> rdfs:label "Hallux valgus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Lateral deviation of the great toe (i.e., in the direction of the little toe)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bunion"^^<http://example.org/invalidDatatype>,
        "Lateral deviation of great toe"^^<http://example.org/invalidDatatype>,
        "Lateral deviation of halluces" ;
    ns1:synonym "Bunion"^^<http://example.org/invalidDatatype>,
        "Lateral deviation of halluces"^^<http://example.org/invalidDatatype>,
        "Lateral deviation of great toe" ;
    ns1:xref "SNOMEDCT_US:122480009",
        "SNOMEDCT_US:415692008",
        "UMLS:C0006386",
        "UMLS:C0018536" .

<http://purl.obolibrary.org/obo/HP_0001942> rdfs:label "Metabolic acidosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Metabolic acidosis (MA) is characterized by a fall in blood pH due to a reduction of serum bicarbonate concentration. This can occur as a result of either the accumulation of acids (high anion gap MA) or the loss of bicarbonate from the gastrointestinal tract or the kidney (hyperchloremic MA). By definition, MA is not due to a respirary cause." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:59455009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0220981" .

<http://purl.obolibrary.org/obo/HP_0002185> rdfs:label "Neurofibrillary tangles" ;
    dcterms:description "Pathological protein aggregates formed by hyperphosphorylation of a microtubule-associated protein known as tau, causing it to aggregate in an insoluble form."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "NFTs"^^<http://example.org/invalidDatatype>,
        "Tau-positive tangle"^^<http://example.org/invalidDatatype>,
        "Neurofibrillary tangles composed of disordered microtubules in neurons",
        "Paired helical filaments",
        "Tau-positive neurofibrillary tangles" ;
    ns1:synonym "NFTs"^^<http://example.org/invalidDatatype>,
        "Neurofibrillary tangles composed of disordered microtubules in neurons"^^<http://example.org/invalidDatatype>,
        "Paired helical filaments"^^<http://example.org/invalidDatatype>,
        "Tau-positive neurofibrillary tangles"^^<http://example.org/invalidDatatype>,
        "Tau-positive tangle"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:85775002",
        "UMLS:C0085400" .

<http://purl.obolibrary.org/obo/HP_0002269> rdfs:label "Abnormality of neuronal migration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality resulting from an anomaly of neuronal migration, i.e., of the process by which neurons travel from their origin to their final position in the brain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neuronal migration disorder"^^<http://example.org/invalidDatatype>,
        "Abnormal neuronal migration",
        "Heterotopias/abnormal migration",
        "Migrational brain disorder" ;
    ns1:synonym "Abnormal neuronal migration"^^<http://example.org/invalidDatatype>,
        "Heterotopias/abnormal migration"^^<http://example.org/invalidDatatype>,
        "Migrational brain disorder"^^<http://example.org/invalidDatatype>,
        "Neuronal migration disorder" ;
    ns1:xref "UMLS:C1837249"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002363> rdfs:label "Abnormal brainstem morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of the brainstem." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal shape of brainstem"^^<http://example.org/invalidDatatype>,
        "Abnormality of brainstem morphology"^^<http://example.org/invalidDatatype>,
        "Abnormality of the brainstem"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal shape of brainstem"^^<http://example.org/invalidDatatype>,
        "Abnormality of brainstem morphology"^^<http://example.org/invalidDatatype>,
        "Abnormality of the brainstem"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1850601"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002385> rdfs:label "Paraparesis" ;
    dcterms:description "Weakness or partial paralysis in the lower limbs."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial paralysis of legs" ;
    ns1:synonym "Partial paralysis of legs" ;
    ns1:xref "UMLS:C0221166"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:1845001" .

<http://purl.obolibrary.org/obo/HP_0002396> rdfs:label "Cogwheel rigidity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of rigidity in which a muscle responds with cogwheellike jerks to the use of constant force in bending the limb (i.e., it gives way in little, repeated jerks when the muscle is passively stretched)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:55630000",
        "UMLS:C0151564" .

<http://purl.obolibrary.org/obo/HP_0002664> rdfs:label "Neoplasm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An organ or organ-system abnormality that consists of uncontrolled autonomous cell-proliferation which can occur in any part of the body as a benign or malignant neoplasm (tumor)."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Abnormal tissue mass" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neoplasia"^^<http://example.org/invalidDatatype>,
        "Tumor"^^<http://example.org/invalidDatatype>,
        "Oncological abnormality",
        "Tumour" ;
    ns1:related_synonym "Cancer"^^<http://example.org/invalidDatatype>,
        "Oncology" ;
    ns1:synonym "Abnormal tissue mass"^^<http://example.org/invalidDatatype>,
        "Cancer"^^<http://example.org/invalidDatatype>,
        "Neoplasia"^^<http://example.org/invalidDatatype>,
        "Oncology"^^<http://example.org/invalidDatatype>,
        "Tumour"^^<http://example.org/invalidDatatype>,
        "Oncological abnormality",
        "Tumor" ;
    ns1:xref "NCIT:C3262"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:108369006"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:363346000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0006826"^^<http://example.org/invalidDatatype>,
        "UMLS:C0027651" .

<http://purl.obolibrary.org/obo/HP_0003186> rdfs:label "Inverted nipples"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of nipples that instead of pointing outward are retracted inwards." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inverted nipples"^^<http://example.org/invalidDatatype>,
        "Invaginated nipples" ;
    ns1:synonym "Inverted nipples"^^<http://example.org/invalidDatatype>,
        "Invaginated nipples" ;
    ns1:xref "SNOMEDCT_US:82231009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0269269" .

<http://purl.obolibrary.org/obo/HP_0003448> rdfs:label "Decreased sensory nerve conduction velocity" ;
    dcterms:description "Reduced speed of conduction of the action potential along a sensory nerve." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased sensory nerve conduction velocities"^^<http://example.org/invalidDatatype>,
        "Decreased sensory NCV" ;
    ns1:synonym "Decreased sensory NCV",
        "Decreased sensory nerve conduction velocities" ;
    ns1:xref "UMLS:C1849148" .

<http://purl.obolibrary.org/obo/HP_0003698> rdfs:label "Difficulty standing" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Difficulty in standing"^^<http://example.org/invalidDatatype>,
        "Standing instability" ;
    ns1:synonym "Difficulty in standing",
        "Standing instability" ;
    ns1:xref "UMLS:C0241237"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:249902000" .

<http://purl.obolibrary.org/obo/HP_0007099> rdfs:label "Chiari type I malformation" ;
    dcterms:description "Arnold-Chiari type I malformation refers to a relatively mild degree of herniation of the posteroinferior region of the cerebellum (the cerebellar tonsils) into the cervical canal with little or no displacement of the fourth ventricle. It is characterized by one or both pointed (not rounded) cerebellar tonsils that project 5 mm below the foramen magnum, measured by a line drawn from the basion to the opisthion (McRae Line)" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Arnold Chiari type I malformation"^^<http://example.org/invalidDatatype>,
        "Arnold-Chiari type I malformation",
        "Chiari I malformation" ;
    ns1:synonym "Arnold Chiari type I malformation"^^<http://example.org/invalidDatatype>,
        "Arnold-Chiari type I malformation"^^<http://example.org/invalidDatatype>,
        "Chiari I malformation" ;
    ns1:xref "SNOMEDCT_US:253185002",
        "UMLS:C0750929" .

<http://purl.obolibrary.org/obo/HP_0008064> rdfs:label "Ichthyosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the skin characterized the presence of excessive amounts of dry surface scales on the skin resulting from an abnormality of keratinization."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ichthyotic skin"^^<http://example.org/invalidDatatype>,
        "Ichthyosiform abnormality of the skin" ;
    ns1:related_synonym "Hypertrophic ichthyosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hypertrophic ichthyosis"^^<http://example.org/invalidDatatype>,
        "Ichthyotic skin"^^<http://example.org/invalidDatatype>,
        "Ichthyosiform abnormality of the skin" ;
    ns1:xref "MEDDRA:10021198",
        "UMLS:C0020757" .

<http://purl.obolibrary.org/obo/HP_0009473> rdfs:label "Joint contracture of the hand" ;
    dcterms:description "Contractures of one ore more joints of the hands meaning chronic loss of joint motion due to structural changes in non-bony tissue."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Contractures of the hands"^^<http://example.org/invalidDatatype>,
        "Contractures involving the hands" ;
    ns1:synonym "Contractures involving the hands"^^<http://example.org/invalidDatatype>,
        "Contractures of the hands" ;
    ns1:xref "SNOMEDCT_US:86414002"^^<http://example.org/invalidDatatype>,
        "MEDDRA:10010821",
        "UMLS:C0158113" .

<http://purl.obolibrary.org/obo/HP_0010529> rdfs:label "Echolalia" ;
    dcterms:description "Echolalia is the automatic imitative repetition of sounds, words, or phrases in the absence of explicit awareness. The repeated words or phrases are typically odd or used in a non-social manner. These can be words or phrases that the affected individual has heard or invented."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Echologia"^^<http://example.org/invalidDatatype>,
        "Echophrasia"^^<http://example.org/invalidDatatype>,
        "Echoing another person's speech",
        "Repeated speech" ;
    ns1:synonym "Echoing another person's speech"^^<http://example.org/invalidDatatype>,
        "Echologia"^^<http://example.org/invalidDatatype>,
        "Echophrasia",
        "Repeated speech" ;
    ns1:xref "SNOMEDCT_US:64712007"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280380"^^<http://example.org/invalidDatatype>,
        "UMLS:C0013528" .

<http://purl.obolibrary.org/obo/HP_0010536> rdfs:label "Central sleep apnea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Sleep apnea results from a temporary loss of the central drive to the muscles responsible for breathing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Central sleep apnoea"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Central sleep apnoea"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0520680"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010871> rdfs:label "Sensory ataxia" ;
    dcterms:description "Incoordination of movement caused by a deficit in the sensory nervous system. Sensory ataxia can be distinguished from cerebellar ataxia by asking the patient to close his or her eyes. Persons with cerebellar ataxia show only a minimal worsening of symptoms, whereas persons with sensory ataxia show a marked worsening of symptoms." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ataxia, sensory"^^<http://example.org/invalidDatatype>,
        "Afferent ataxia",
        "Spinal ataxia" ;
    ns1:synonym "Afferent ataxia",
        "Ataxia, sensory",
        "Spinal ataxia" ;
    ns1:xref "SNOMEDCT_US:445458007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:69131009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0037921"^^<http://example.org/invalidDatatype>,
        "UMLS:C0240991"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012043> rdfs:label "Pendular nystagmus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Rhythmic, involuntary sinusoidal oscillations of one or both eyes. The waveform of pendular nystagmus may occur in any direction."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Nystagmus, continuous pendular"^^<http://example.org/invalidDatatype>,
        "Nystagmus, pendular"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nystagmus, continuous pendular"^^<http://example.org/invalidDatatype>,
        "Nystagmus, pendular"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:35743001",
        "UMLS:C0271388",
        "UMLS:C4020734" .

<http://purl.obolibrary.org/obo/HP_0012048> rdfs:label "Oromandibular dystonia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A kind of focal dystonia characterized by forceful contractions of the face, jaw, and/or tongue causing difficulty in opening and closing the mouth and often affecting chewing and speech."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cranial dystonia" ;
    ns1:synonym "Cranial dystonia" ;
    ns1:xref "UMLS:C2242577" .

<http://purl.obolibrary.org/obo/HP_0012389> rdfs:label "Appendicular hypotonia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Muscular hypotonia of one or more limbs."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022919" .

<http://purl.obolibrary.org/obo/HP_0031165> rdfs:label "Multifocal seizures" ;
    dcterms:description "Seizures that start from several different areas of the brain (i.e., with multiple ictal onset locations)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Multifocal onset seizures" ;
    ns1:synonym "Multifocal onset seizures"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031882> rdfs:label "Agyria" ;
    dcterms:description "A congenital abnormality of the cerebral hemisphere characterized by lack of gyrations (convolutions) of the cerebral cortex. Agyria is defined as cortical regions lacking gyration with sulci great than 3 cm apart and cerebral cortex thicker than 5 mm." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Agyria diffuse"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Agyria diffuse" .

<http://purl.obolibrary.org/obo/HP_0033383> rdfs:label "Decreased compound muscle action potential amplitude"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced level of the compound muscle action potential (CMAP), which is recorded following electrical stimulation of a nerve from surface electrodes overlying a muscle supplied by that nerve."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased CMAP amplitude" ;
    ns1:synonym "Decreased CMAP amplitude" .

<http://purl.obolibrary.org/obo/HP_0033748> rdfs:label "Hypoesthesia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased ability to perceive touch." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoaesthesia"^^<http://example.org/invalidDatatype>,
        "Numbness" ;
    ns1:synonym "Hypoaesthesia",
        "Numbness" .

<http://purl.obolibrary.org/obo/HP_0040078> rdfs:label "Axonal degeneration"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1837496" .

<http://purl.obolibrary.org/obo/HP_0040081> rdfs:label "Abnormal circulating creatine kinase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation from the normal circulating creatine kinase concentration." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal levels of creatine kinase in blood"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating CK concentration",
        "Abnormal circulating CPK concentration",
        "Abnormal circulation phospho-CK concentration" ;
    ns1:synonym "Abnormal circulating CK concentration"^^<http://example.org/invalidDatatype>,
        "Abnormal circulation phospho-CK concentration"^^<http://example.org/invalidDatatype>,
        "Abnormal levels of creatine kinase in blood"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating CPK concentration" ;
    ns1:xref "UMLS:C4022449"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040082> rdfs:label "Happy demeanor" ;
    dcterms:description "A conspicuously happy disposition, characterized by frequent smiling and laughing, which may be contextually inappropriate or unrelated to the situation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Happy demeanour"^^<http://example.org/invalidDatatype>,
        "Happy demeanor" ;
    ns1:synonym "Happy demeanor"^^<http://example.org/invalidDatatype>,
        "Happy demeanour" ;
    ns1:xref "UMLS:C1856115" .

<http://purl.obolibrary.org/obo/MONDO_0800491> rdfs:label "early-infantile DEE" ;
    dcterms:description "A neonatal/infantile epilepsy syndrome characterized by frequent drug-resistant seizures that begin ≤3 months of age, with abnormal interictal EEG and neurological examination. In up to 80% of patients, EIDEE is caused by an underlying structural, genetic, or metabolic reason." ;
