    ns1:xref "SNOMEDCT_US:392288006",
        "UMLS:C0017606" .

<http://purl.obolibrary.org/obo/HP_0012120> rdfs:label "Methylmalonic aciduria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased concentration of methylmalonic acid in the urine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High blood methylmalonic acid levels",
        "Methymalonicaciduria" ;
