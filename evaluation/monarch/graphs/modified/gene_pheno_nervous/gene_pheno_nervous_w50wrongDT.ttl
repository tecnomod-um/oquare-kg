        "Hearing loss, sensorineural, bilateral, progressive",
        "Hearing loss, sensorineural, progressive",
        "Progressive bilateral sensorineural hearing loss" ;
    ns1:xref "UMLS:C1843156" .

<http://purl.obolibrary.org/obo/HP_0000482> rdfs:label "Microcornea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A congenital abnormality of the cornea in which the cornea and the anterior segment of the eye are smaller than normal. The horizontal diameter of the cornea does not reach 10 mm even in adulthood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cornea of eye less than 10mm in diameter"^^<http://example.org/invalidDatatype>,
        "Decreased corneal diameter"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased corneal diameter"^^<http://example.org/invalidDatatype>,
        "Cornea of eye less than 10mm in diameter" ;
    ns1:xref "SNOMEDCT_US:26098002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0266544",
        "UMLS:C1167713" .

<http://purl.obolibrary.org/obo/HP_0000544> rdfs:label "External ophthalmoplegia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Paralysis of the external ocular muscles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "CPEO"^^<http://example.org/invalidDatatype>,
        "Chronic progressive external ophthalmoplegia"^^<http://example.org/invalidDatatype>,
