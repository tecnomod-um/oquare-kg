<http://purl.obolibrary.org/obo/MONDO_0019549> rdfs:label "severe early-onset axonal neuropathy due to MFN2 deficiency"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare axonal hereditary motor and sensory neuropathy characterized by early onset (<10 years) progressive distal muscle weakness and wasting of the lower limbs and later, to a lesser extent the upper limbs resulting in foot and wrist drop, areflexia, skeletal deformities (kyphoscoliosis, pes cavus with flattening, joint contractures), mild sensory impairment with vibration sense reduced to a greater extent than pain, optic atrophy and hearing loss. Wheelchair dependence by adolescence is usual and respiratory impairment with diaphragmatic paralysis may develop."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "AR-CMT2, Ouvrier type"^^<http://example.org/invalidDatatype>,
        "SEOAN due to MFN2 deficiency",
        "autosomal recessive Charcot-Marie-Tooth disease, Ouvrier type" ;
    ns1:synonym "SEOAN due to MFN2 deficiency"^^<http://example.org/invalidDatatype>,
        "AR-CMT2, Ouvrier type",
        "autosomal recessive Charcot-Marie-Tooth disease, Ouvrier type" ;
    ns1:xref "GARD:0019123"^^<http://example.org/invalidDatatype>,
        "MEDGEN:1641956"^^<http://example.org/invalidDatatype>,
        "Orphanet:90118"^^<http://example.org/invalidDatatype>,
        "SCTID:766977007"^^<http://example.org/invalidDatatype>,
        "UMLS:C4707897"^^<http://example.org/invalidDatatype> .

