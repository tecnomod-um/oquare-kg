<http://purl.obolibrary.org/obo/HP_0002131> rdfs:label "Episodic ataxia" ;
    dcterms:description "Periodic spells of incoordination and imbalance, that is, episodes of ataxia typically lasting from 10 minutes to several hours or days."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intermittent cerebellar ataxia",
        "Paroxysmal ataxia" ;
