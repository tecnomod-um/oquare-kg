<http://purl.obolibrary.org/obo/HP_0002403> rdfs:label "Positive Romberg sign"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The patient stands with the feet placed together and balance and is asked to close his or her eyes. A loss of balance upon eye closure is a positive Romberg sign and is interpreted as indicating a deficit in proprioception." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:298310004",
        "UMLS:C0240914" .

<http://purl.obolibrary.org/obo/HP_0003546> rdfs:label "Exercise intolerance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A functional motor deficit where individuals whose responses to the challenges of exercise fail to achieve levels considered normal for their age and gender."^^<http://example.org/invalidDatatype> ;
