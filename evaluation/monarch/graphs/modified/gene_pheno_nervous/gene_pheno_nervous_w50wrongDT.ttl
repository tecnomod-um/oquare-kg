<http://purl.obolibrary.org/obo/HP_0002136> rdfs:label "Broad-based gait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal gait pattern in which persons stand and walk with their feet spaced widely apart. This is often a component of cerebellar ataxia."^^<http://example.org/invalidDatatype> ;
