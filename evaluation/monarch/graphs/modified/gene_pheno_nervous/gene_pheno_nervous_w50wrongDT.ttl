<http://purl.obolibrary.org/obo/HP_0002036> rdfs:label "Hiatus hernia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a hernia in which the upper part of the stomach, i.e., mainly the gastric cardia protrudes through the diaphragmatic esophageal hiatus."^^<http://example.org/invalidDatatype> ;
