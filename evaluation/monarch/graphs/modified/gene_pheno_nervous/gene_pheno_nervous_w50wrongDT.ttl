<http://purl.obolibrary.org/obo/HP_0030652> rdfs:label "Vitreous haze"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Vitreous haze is the obscuration of fundus details by vitreous cells and protein exudation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073113"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030682> rdfs:label "Left ventricular noncompaction" ;
    dcterms:description "Left ventricular noncompaction (LVNC) is defined by 3 markers: prominent left ventricular (LV) trabeculae, deep intertrabecular recesses, and the thin compacted layer." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1960469"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030690> rdfs:label "Gingival cleft"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A fissure in the gingiva (gums), i.e., the mucosal tissue that lies over the mandible and maxilla." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0426489"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:109622003" .

<http://purl.obolibrary.org/obo/HP_0030691> rdfs:label "Divergence nystagmus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A condition in which both eyes beat outward simultaneously." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4073130"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030713> rdfs:label "Vein of Galen aneurysmal malformation" ;
    dcterms:description "Vein of Galen aneurysmal malformation is a choroidal type of arteriovenous malformation that develops between 6 and 11 weeks of gestation. It results from 1 or more arteriovenous fistulas shunting blood toward the prosencephalic vein of Markowski, the embryonic precursor of the vein of Galen. This abnormal shunt leads to progressive dilation of the vein and prevents its involution and subsequent development into the vein of Galen." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Median prosencephalic arteriovenous fistula",
        "Vein of Galen aneurysm",
        "Vein of Galen malformation" ;
    ns1:synonym "Vein of Galen aneurysm"^^<http://example.org/invalidDatatype>,
        "Median prosencephalic arteriovenous fistula",
        "Vein of Galen malformation" ;
    ns1:xref "UMLS:C0431420"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:253194008" .

<http://purl.obolibrary.org/obo/HP_0030718> rdfs:label "Right atrial enlargement" ;
    dcterms:description "Increase in size of the right atrium." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Right atrial dilatation"^^<http://example.org/invalidDatatype>,
        "Dilated right atrium",
        "Enlarged heart right atrium" ;
    ns1:synonym "Dilated right atrium",
        "Enlarged heart right atrium",
        "Right atrial dilatation" ;
    ns1:xref "UMLS:C0748427"^^<http://example.org/invalidDatatype>,
        "Fyler:1771",
        "Fyler:2859",
        "SNOMEDCT_US:67751000119106" .

<http://purl.obolibrary.org/obo/HP_0030724> rdfs:label "Central nervous system cyst"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A fluid-filled sac (cyst) located within the central nervous system." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "CNS cyst"^^<http://example.org/invalidDatatype>,
        "Cyst of the central nervous system" ;
    ns1:synonym "Cyst of the central nervous system"^^<http://example.org/invalidDatatype>,
        "CNS cyst" ;
    ns1:xref "UMLS:C0349606"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:277333006" .

<http://purl.obolibrary.org/obo/HP_0030731> rdfs:label "Carcinoma" ;
    dcterms:description "A malignant tumor arising from epithelial cells. Carcinomas that arise from glandular epithelium are called adenocarcinomas, those that arise from squamous epithelium are called squamous cell carcinomas, and those that arise from transitional epithelium are called transitional cell carcinomas (NCI Thesaurus)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C2916",
        "SNOMEDCT_US:68453008",
        "UMLS:C0007097" .

<http://purl.obolibrary.org/obo/HP_0030736> rdfs:label "Sacrococcygeal teratoma" ;
    dcterms:description "A teratoma arising in the sacro-coccygeal region." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:281561000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0559459"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030743> rdfs:label "Glial remnants anterior to the optic disc" ;
    dcterms:description "Persistence of a posterior remnant of the hyaloid artery located at the optic disc."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bergmeister papilla"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Bergmeister papilla" ;
    ns1:xref "UMLS:C4280791" .

<http://purl.obolibrary.org/obo/HP_0030744> rdfs:label "Hyaloid vascular remnant and retrolental mass"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of persistence of the hyaloid vascular system associated with a retrolental mass that may lead to fetal cataract."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280790" .

<http://purl.obolibrary.org/obo/HP_0030756> rdfs:label "Erythrodontia" ;
    dcterms:description "Reddish, brown opalescent discoloration of teeth in normal light."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Red teeth" ;
    ns1:synonym "Red teeth"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4280783" .

<http://purl.obolibrary.org/obo/HP_0030757> rdfs:label "Tooth abscess"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A pocket of pus located within a region of a tooth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dentoalveolar abscess"^^<http://example.org/invalidDatatype>,
        "Dental abscess" ;
    ns1:synonym "Dentoalveolar abscess"^^<http://example.org/invalidDatatype>,
        "Dental abscess" ;
    ns1:xref "SNOMEDCT_US:299709002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0518988" .

<http://purl.obolibrary.org/obo/HP_0030765> rdfs:label "Sleep terror"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Autonomic arousal, screaming, sweating, crying, outbursts during sleep, usually no recollection at the individual level; typically observed by others." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Night terror"^^<http://example.org/invalidDatatype>,
        "Sleep terrors"^^<http://example.org/invalidDatatype>,
        "Pavor nocturnus",
        "Waking up screaming" ;
    ns1:synonym "Waking up screaming"^^<http://example.org/invalidDatatype>,
        "Night terror",
        "Pavor nocturnus",
        "Sleep terrors" ;
    ns1:xref "SNOMEDCT_US:89675003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0037320" .

<http://purl.obolibrary.org/obo/HP_0030769> rdfs:label "Exencephaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A malformation of the neural tube with a large amount of protruding brain tissue and absence of calvarium." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:84461004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0266453" .

<http://purl.obolibrary.org/obo/HP_0030773> rdfs:label "Internuclear ophthalmoplegia" ;
    dcterms:description "An abnormality of conjugate lateral gaze in which the affected eye shows impairment of adduction. The pathognomonic clinical sign of internuclear ophthalmoplegia is an impaired adduction while testing horizontal saccades on the side of the lesion in the ipsilateral medial longitudinal fascicule."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:49823009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0152134"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030774> rdfs:label "Mitochondrial swelling"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The mitochondrial matrix refers to the substance occupying the space enclosed by the inner membrane of a mitochondrion, which contains enzymes, DNA, granules, and inclusions of protein crystals, glycogen, and lipid. Mitochondrial swelling refers to an increase in size of the mitochondrial matrix. This phenomenon is thought to be related to a permeabilized inner membrane that originates a large swelling in the mitochondrial matrix. Mitochondrial swelling may distend the outer membrane until it ruptures." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:125429001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0026244"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030779> rdfs:label "Ethmocephaly" ;
    dcterms:description "Ethmocephaly is the rarest form of holoprosencephaly, which occurs due to an incomplete cleavage of the forebrain. Clinically, the disease presents with a proboscis, hypotelorism, microphthalmos and malformed ears."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:55709000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0266680" .

<http://purl.obolibrary.org/obo/HP_0030783> rdfs:label "Increased circulating interleukin 6 concentration" ;
    dcterms:description "The concentration of interleukin-6 in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum IL-6"^^<http://example.org/invalidDatatype>,
        "Increased serum interleukin-6" ;
    ns1:synonym "Increased serum IL-6",
        "Increased serum interleukin-6" ;
    ns1:xref "UMLS:C4280771"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030791> rdfs:label "Abnormal jaw morphology" ;
    dcterms:description "A structural anomaly of the jaw, the bony structure of the mouth that consists of the mandible and the maxilla." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280767"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030793> rdfs:label "Jaw swelling"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal enlargement in the upper jaw (maxilla) or in the lower jaw (mandible)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280766"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030810> rdfs:label "Abnormal tongue physiology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any functional anomaly of the tongue."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280754"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030813> rdfs:label "Absent tonsils"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Lack of observable tonsillar tissue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tonsillar hypoplasia"^^<http://example.org/invalidDatatype>,
        "Hypoplastic tonsils" ;
    ns1:synonym "Hypoplastic tonsils"^^<http://example.org/invalidDatatype>,
        "Tonsillar hypoplasia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:249393008"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:300277007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0576999" .

<http://purl.obolibrary.org/obo/HP_0030826> rdfs:label "Eyelid fasciculation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Tiny, repetitive muscle contractions in the eyelids, causing the appearance of twitching."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fasciculation of the eyelid"^^<http://example.org/invalidDatatype>,
        "Muscle twitches in eye lid"^^<http://example.org/invalidDatatype>,
        "Twitching around eyes"^^<http://example.org/invalidDatatype>,
        "Eyelid fluttering",
        "Muscle twitches in eyelid" ;
    ns1:synonym "Eyelid fluttering",
        "Fasciculation of the eyelid",
        "Muscle twitches in eye lid",
        "Muscle twitches in eyelid",
        "Twitching around eyes" ;
    ns1:xref "UMLS:C4280682"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030828> rdfs:label "Wheezing" ;
    dcterms:description "A high-pitched whistling sound associated with labored breathing." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Wheezing"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Wheezing"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0043144"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:56018004" .

<http://purl.obolibrary.org/obo/HP_0030834> rdfs:label "Shoulder pain" ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the shoulder."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Shoulder pain"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Shoulder pain" ;
    ns1:xref "SNOMEDCT_US:45326000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0037011"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030840> rdfs:label "Ankle pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the ankle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ankle pain" ;
    ns1:synonym "Ankle pain" ;
    ns1:xref "SNOMEDCT_US:247373008"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:202490009",
        "UMLS:C0238656" .

<http://purl.obolibrary.org/obo/HP_0030850> rdfs:label "Abnormal pulse pressure" ;
    dcterms:description "An anomaly of the pulse pressure, which is defined as the systolic pressured minus the diastolic pressure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0855322" .

<http://purl.obolibrary.org/obo/HP_0030853> rdfs:label "Heterotaxy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality in which the internal thoraco-abdominal organs demonstrate abnormal arrangement across the left-right axis of the body." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Heterotaxia" ;
    ns1:synonym "Heterotaxia" ;
    ns1:xref "Fyler:0190"^^<http://example.org/invalidDatatype>,
        "Fyler:190",
        "SNOMEDCT_US:14821001",
        "SNOMEDCT_US:24614000",
        "UMLS:C0266642" .

<http://purl.obolibrary.org/obo/HP_0030857> rdfs:label "Eye movement-induced pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the eye that is worse in certain directions of gaze and during prolonged gaze holding."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4280742" .

<http://purl.obolibrary.org/obo/HP_0030858> rdfs:label "Addictive behavior" ;
    dcterms:description "When an activity, substance, object, or behavior becomes a major focus of a person's life, excluding other activities, or has begun to harm the individual or others physically, mentally, or socially, it can be considered addictive behavior. A person can become addicted or compulsively engaged with anything." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Addictive behaviour"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Addictive behaviour"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0085281"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:32709003" .

<http://purl.obolibrary.org/obo/HP_0030874> rdfs:label "Oxygen desaturation on exertion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Oxygen saturation less than 95% on exertion or arterial partial pressure of oxygen falling by more than 1kPa."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "O2 desaturation on exertion"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "O2 desaturation on exertion"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4280731"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030877> rdfs:label "Reduced FEV1/FVC ratio" ;
    dcterms:description "Abnormally low FEV1/FVC (FEV1 - forced expiratory volume in 1 second; FVC forced vital capacity)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Obstructive deficit on pulmonary function test"^^<http://example.org/invalidDatatype>,
        "Obstructive deficit on pulmonary function testing" ;
    ns1:synonym "Obstructive deficit on pulmonary function test",
        "Obstructive deficit on pulmonary function testing" ;
    ns1:xref "UMLS:C4280729"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030884> rdfs:label "Gastrojejunal tube feeding in infancy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Feeding problem necessitating gastrojejunal tube feeding." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Gastro-jejunal tube feeding in infancy" ;
    ns1:synonym "Gastro-jejunal tube feeding in infancy" ;
    ns1:xref "UMLS:C4280681"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030918> rdfs:label "Low 1-minute APGAR score"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low one-minute APGAR score" ;
    ns1:synonym "Low one-minute APGAR score" .

<http://purl.obolibrary.org/obo/HP_0030919> rdfs:label "Low 5-minute APGAR score"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low five-minute APGAR score" ;
    ns1:synonym "Low five-minute APGAR score" .

<http://purl.obolibrary.org/obo/HP_0030921> rdfs:label "5-minute APGAR score of 1" ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030927> rdfs:label "1-minute APGAR score of 0"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030939> rdfs:label "Palpebral thickening" ;
    dcterms:description "An increased thickness of the eyelid not related to acute inflammation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Thick eyelids"^^<http://example.org/invalidDatatype>,
        "Thickened but nonswollen eyelids"^^<http://example.org/invalidDatatype>,
        "Eyelid thickening",
        "Thickened eyelid" ;
    ns1:synonym "Eyelid thickening",
        "Thick eyelids",
        "Thickened but nonswollen eyelids",
        "Thickened eyelid" .

<http://purl.obolibrary.org/obo/HP_0030943> rdfs:label "Vulvodynia" ;
    dcterms:description "Pain in the vulvar area" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Vulvar pain" ;
    ns1:synonym "Vulvar pain" .

<http://purl.obolibrary.org/obo/HP_0030951> rdfs:label "Skeletal muscle fibrosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excessive formation of fibrous bands of scar tissue in between muscle fibers." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Muscle biopsy: fibrosis" ;
    ns1:synonym "Muscle biopsy: fibrosis" .

<http://purl.obolibrary.org/obo/HP_0030962> rdfs:label "Abnormal morphology of the great vessels" ;
    dcterms:description "A structural anomaly affecting a blood vessel involved in the circulation of the heart, i.e., the superior or inferior vena cava, the pulmonary arteries, the pulmonary veins, and the aorta." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030973> rdfs:label "Postexertional symptom exacerbation" ;
    dcterms:description "Post-exertional symptom exacerbation (PESE), also referred to as post-exertional malaise (PEM), is defined as the worsening of symptoms that can follow minimal cognitive, physical, emotional, or social activity, or activity that could previously be tolerated. Symptoms typically worsen 12 to 72 hours after activity and can last for days or even weeks, sometimes leading to a relapse."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Postexertional malaise"^^<http://example.org/invalidDatatype>,
        "Exercise-induced malaise" ;
    ns1:synonym "Postexertional malaise"^^<http://example.org/invalidDatatype>,
        "Exercise-induced malaise" .

<http://purl.obolibrary.org/obo/HP_0030975> rdfs:label "Pontine tegmental cap"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal curved or vaulted (capped) structure covering the middle third of the dorsal pontine tegmentum and projecting into the fourth ventricle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Vaulted pontine tegmentum"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Vaulted pontine tegmentum" .

<http://purl.obolibrary.org/obo/HP_0030998> rdfs:label "Cerebrospinal fluid rhinorrhoea" ;
    dcterms:description "Drainage of cerebrospinal fluid through the nose. This can occur when there is a fistula between the dura and the skull base and discharge of cerebrospinal fluid (CSF) from the nose." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "CSF rhinorrhoea" ;
    ns1:synonym "CSF rhinorrhoea"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031003> rdfs:label "Polyneuritis" ;
    dcterms:description "Simultaneous inflammation of multiple nerves." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Multiple neuritis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Multiple neuritis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031020> rdfs:label "Bone marrow hypercellularity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A larger than normal amount or percentage of hematopoietic cells relative to marrow fat."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Myeloid hyperplasia" ;
    ns1:synonym "Myeloid hyperplasia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031023> rdfs:label "Multiple mucosal neuromas" ;
    dcterms:description "Multiple painful, dome-shaped, translucent pink to skin-colored papules on oral mucosa. Histologically, the lesions may demonstrate dermal proliferation of well-demarcated nerve bundles associated with abundant mucin and surrounded by a distinct perineural sheath." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C6559" .

<http://purl.obolibrary.org/obo/HP_0031030> rdfs:label "Elevated circulating carcinoma antigen 125 concentration" ;
    dcterms:description "An increased blood concentration of carcinoma antigen 125 (CA-125). CA-125, also known as mucin 16, can exhibit increased blood levels in certain types of cancer." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated carcinoma antigen 125 level"^^<http://example.org/invalidDatatype>,
        "Increased plasma CA125" ;
    ns1:synonym "Increased plasma CA125"^^<http://example.org/invalidDatatype>,
        "Elevated carcinoma antigen 125 level" .

<http://purl.obolibrary.org/obo/HP_0031032> rdfs:label "Decreased circulating retinol-binding protein concentration" ;
    dcterms:description "The concentration of retinol-binding protein in the blood circulation is below the lower limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031035> rdfs:label "Chronic infection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Presence of a protracted or persistent infection by a pathogen potentially related to an underlying abnormality of the immune system that is not able to clear the infection." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031045> rdfs:label "Acral blistering"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bullae (defined as fluid-filled blisters more than 5 mm in diameter with thin walls) of the skin with an acral distribution (affecting peripheral regions such as hands and feet)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031052> rdfs:label "Elevated vascular endothelial growth factor level" ;
    dcterms:description "Increased blood concentration of vascular endothelial growth factor (VEGF)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating VEGF concentration" ;
    ns1:synonym "Elevated circulating VEGF concentration"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031056> rdfs:label "Fusiform cerebral aneurysm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A localized circumferential (i.e., bulges on all sides) dilatation or ballooning of a cerebral artery."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intracranial fusiform aneurysm" ;
    ns1:synonym "Intracranial fusiform aneurysm"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031060> rdfs:label "Impaired ability to dress oneself" ;
    dcterms:description "This applies to an individual who needs help with dressing or needs to be completely dressed." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031097> rdfs:label "Abnormal thyroid-stimulating hormone level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation from the normal amount of the thyroid-stimulating hormone (TSH), which is produced by the anterior pituitary gland and stimulates the function of the thyroid gland."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal TSH level"^^<http://example.org/invalidDatatype>,
        "Abnormal thyrotropin level"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating thyrotropin concentration" ;
    ns1:synonym "Abnormal TSH level"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating thyrotropin concentration"^^<http://example.org/invalidDatatype>,
        "Abnormal thyrotropin level" .

<http://purl.obolibrary.org/obo/HP_0031103> rdfs:label "Decreased circulating antimullerian hormone circulation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction below the normal range of the antimullerian hormone in the circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-Mullerian hormone low"^^<http://example.org/invalidDatatype>,
        "Decreased plasma AMH"^^<http://example.org/invalidDatatype>,
        "Decreased antimullerian hormone level" ;
    ns1:synonym "Decreased antimullerian hormone level"^^<http://example.org/invalidDatatype>,
        "Decreased plasma AMH"^^<http://example.org/invalidDatatype>,
        "Anti-Mullerian hormone low" .

<http://purl.obolibrary.org/obo/HP_0031109> rdfs:label "Agalactia" ;
    dcterms:description "Failure of secretion of milk following childbirth associated with an inability to breastfeed an infant." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lactation incapacity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Lactation incapacity" .

<http://purl.obolibrary.org/obo/HP_0031123> rdfs:label "Recurrent gastroenteritis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased susceptibility to gastroenteritis, an infectious inflammationof the stomach and small intestines manifested by signs and symptoms such as diarheas and abdominal pain, as manifested by recurrent episodes of gastroenteritis." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031145> rdfs:label "Starry sky appearance on hepatic sonography" ;
    dcterms:description "An abnormal echotexture visible in liver ultrasound manifesting as a diffuse hyperechoic liver echotexture with multiple, small hypoechoic lesions. The appearance is said to resemble a starry sky (multiple white spots on a dark background)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031146> rdfs:label "Impaired oral bolus formation" ;
    dcterms:description "An abnormality of swallowing characterized by reduced tongue coordination to form bolus after chewing. Food material spreads over the oral cavity instead of being concentrated into a bolus that is easily swallowed."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031154> rdfs:label "Beaded vitreous appearance"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Vitreous humor of the eye displaying beaded bundles of irregular diameters." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031161> rdfs:label "Reduced brain glutamate level by MRS"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An decrease in the level of glutamate (Glu) in the brain identified by magnetic resonance spectroscopy (MRS)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031166> rdfs:label "Eyelid myokymia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Involuntary, fine, continuous, undulating contractions of the eyelid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Myokymia orbicularis",
        "Orbicularis myokymia" ;
    ns1:synonym "Myokymia orbicularis"^^<http://example.org/invalidDatatype>,
        "Orbicularis myokymia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031218> rdfs:label "Inappropriate antidiuretic hormone secretion" ;
    dcterms:description "A state of increased circulating antidiuretic hormone despite hyponatremia and hypo-osmolality with normal or increased plasma volume." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inappropriate ADH secretion" ;
    ns1:related_synonym "SIADH"^^<http://example.org/invalidDatatype>,
        "Syndrome of inappropriate antidiuretic hormone secretion" ;
    ns1:synonym "Syndrome of inappropriate antidiuretic hormone secretion"^^<http://example.org/invalidDatatype>,
        "Inappropriate ADH secretion",
        "SIADH" .

<http://purl.obolibrary.org/obo/HP_0031244> rdfs:label "Swollen lip"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Enlargement of the lip typically due to fluid buildup or inflammation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Swelling of the lip"^^<http://example.org/invalidDatatype>,
        "Edematous lip",
        "Lip swelling" ;
    ns1:synonym "Edematous lip",
        "Lip swelling",
        "Swelling of the lip" .

<http://purl.obolibrary.org/obo/HP_0031245> rdfs:label "Productive cough" ;
    dcterms:description "A cough that produces phlegm or mucus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Wet cough"^^<http://example.org/invalidDatatype>,
        "Cough with mucus production" ;
    ns1:synonym "Wet cough"^^<http://example.org/invalidDatatype>,
        "Cough with mucus production" .

<http://purl.obolibrary.org/obo/HP_0031274> rdfs:label "Hypovolemic shock" ;
    dcterms:description "A state of shock characterized by decreased circulating blood volume in relation to total vascular capacity. This type of shock is characterized by a reduction of diastolic filling pressures."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031288> rdfs:label "Cobblestone-like hyperkeratosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of verrucous, cobblestone-like papules and nodules in a region of skin that is said to have an appearance like that of cobblestones."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031290> rdfs:label "Tuberous xanthoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of xanthoma characterized by a nodular form. Tuberous xanthomas are firm subcutaneous nodules,whereby the overlying skin can have red or red-yellow color changes." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031298> rdfs:label "Coronary sinus enlargement"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal increase in size of the coronary sinus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Coronary sinus dilatation"^^<http://example.org/invalidDatatype>,
        "Enlarged coronary sinus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Coronary sinus dilatation"^^<http://example.org/invalidDatatype>,
        "Enlarged coronary sinus" .

<http://purl.obolibrary.org/obo/HP_0031320> rdfs:label "Cardiomyocyte mitochondrial proliferation" ;
    dcterms:description "An abnormal increase in the number of mitochondria per cardiac myocyte."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031326> rdfs:label "Monoclonal light chain cardiac amyloidosis" ;
    dcterms:description "A type of cardiac amyloidosis related to deposition of an immunoglobulin light chain. The current gold standard of amyloid typing is to determine the precursor protein using laser microdissection mass spectrometry."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031327> rdfs:label "Cardiac transthyretin amyloid deposition"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of cardiac amyloidosis related to deposition of transthyretin (TTR), which is identified by immunohistochemical staining." ;
    ns1:broad_synonym "Transthyretin cardiac amyloidosis"^^<http://example.org/invalidDatatype>,
        "TTR cardiac amyloidosis" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "TTR cardiac amyloidosis"^^<http://example.org/invalidDatatype>,
        "Transthyretin cardiac amyloidosis" .

<http://purl.obolibrary.org/obo/HP_0031329> rdfs:label "Interstitial cardiac fibrosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of myocardial fibrosis characterized by excessive diffuse collagen accumulation concentrated in interstitial spaces." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031348> rdfs:label "Dextrotransposition of the great arteries"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of transposition of the great arteries (TGA) in which aorta is in front of and primarily to the right of the pulmonary artery. This is the most common kind of TGA."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "D-TGA"^^<http://example.org/invalidDatatype>,
        "D-loop transposition of the great arteries" ;
    ns1:synonym "D-TGA"^^<http://example.org/invalidDatatype>,
        "D-loop transposition of the great arteries" ;
    ns1:xref "Fyler:0700",
        "Fyler:700" .

<http://purl.obolibrary.org/obo/HP_0031352> rdfs:label "Chest tightness" ;
    dcterms:description "An unpleasant sensation of tightness or pressure in the chest."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tightness in chest"^^<http://example.org/invalidDatatype>,
        "Tightness of chest"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Chest distress"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Chest distress"^^<http://example.org/invalidDatatype>,
        "Tightness in chest"^^<http://example.org/invalidDatatype>,
        "Tightness of chest"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031353> rdfs:label "Otitis media with effusion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Otitis media characterized by thick or sticky fluid behind the tympanic membrane."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fluid behind eardrum"^^<http://example.org/invalidDatatype>,
        "Middle ear effusions"^^<http://example.org/invalidDatatype>,
        "OME"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Middle ear effusions"^^<http://example.org/invalidDatatype>,
        "Fluid behind eardrum",
        "OME" .

<http://purl.obolibrary.org/obo/HP_0031357> rdfs:label "Glomeruloid hemangioma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A histologically distinctive, cutaneous, benign vascular tumor that is characterized by a solitary or multiple blue-red papules and histologically resembles renal glomeruli." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031368> rdfs:label "Intestinal perforation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A hole (perforation) in the wall of the intestine." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031375> rdfs:label "Refractory" ;
    dcterms:description "Applies to a sign or symptom that is difficult to treat or cure." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031392> rdfs:label "Abnormal CD4+ T cell subset proportion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal increase or decrease of any CD4+ T cell subpopulation, measured as percentage of total CD4+ T cells in the blood, compared to a reference range for a given sex and age-group."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal CD4+ T cell subsets"^^<http://example.org/invalidDatatype>,
        "Abnormal proportion of CD4-positive T cells"^^<http://example.org/invalidDatatype>,
        "Abnormal proportion of CD4-positive helper T cells"^^<http://example.org/invalidDatatype>,
        "Abnormal proportion of CD4-positive, alpha-beta T cells"^^<http://example.org/invalidDatatype>,
        "Abnormal CD4+ T cell subset",
        "Abnormal helper T cell proportion",
        "Abnormal proportion of CD4+ T cells",
        "Abnormal proportion of circulating T-helper cells" ;
    ns1:synonym "Abnormal CD4+ T cell subset"^^<http://example.org/invalidDatatype>,
        "Abnormal CD4+ T cell subsets"^^<http://example.org/invalidDatatype>,
        "Abnormal helper T cell proportion"^^<http://example.org/invalidDatatype>,
        "Abnormal proportion of CD4+ T cells"^^<http://example.org/invalidDatatype>,
        "Abnormal proportion of CD4-positive T cells",
        "Abnormal proportion of CD4-positive helper T cells",
        "Abnormal proportion of CD4-positive, alpha-beta T cells",
        "Abnormal proportion of circulating T-helper cells" .

<http://purl.obolibrary.org/obo/HP_0031408> rdfs:label "Increased proportion of CD25+ mast cells" ;
    dcterms:description "An increased proportion of mast cells are positive for the cell surface marker CD25 (also called interleukin-2 receptor alpha chain)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031413> rdfs:label "Short telomere length"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal reduction in telomere length. Telomeres are non-coding, repetitive sequences of DNA at the ends of the chromosomes of eukaryotic cells which become shorter as cells divide, and when telomere attrition reaches its limit, cell proliferation arrest, senescence, and apoptosis can occur."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031418> rdfs:label "Increased body mass index" ;
    dcterms:description "Abnormally increased weight-to-height squared ratio, calculated by dividing the individual's weight in kilograms by the square of the individual's height in meters and used as an indicator of overweight compared to averages."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased BMI"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased BMI"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031429> rdfs:label "Decreased circulating osteocalcin level" ;
    dcterms:description "A reduced level of osteocalcin in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031500> rdfs:label "Abdominal mass"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal enlargement or swelling in the abdomen."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031501> rdfs:label "Pelvic mass"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal enlargement or swelling in the pelvic region."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031510> rdfs:label "Linear earlobe crease" ;
    dcterms:description "A transverse linear fissure (crease) in the lobule of the ear." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031518> rdfs:label "Absent posterior alpha rhythm" ;
    dcterms:description "Lack of normal alpha rhythm in the EEG. Alpha rhythm has been defined as a rhythm at 8-13 Hz occurring during wakefulness over the posterior regions of the head, generally with higher voltage over the occipital areas. Amplitude is variable but is mostly below 50 microvolt in adults. It is best seen with eyes closed and under conditions of physical relaxation and relative mental inactivity. It is blocked or attenuated by attention, especially visual and mental effort. One should here note the difference between the terms alpha rhythm and alpha activity: Alpha activity refers to activity in the range of 8-13 Hz and alpha rhythm is the activity of 8-13 Hz with specific characteristics as defined above."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031531> rdfs:label "Sub-RPE deposits"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Deposits accumulating between the retinal pigment epithelium (RPE) and Bruch's membrane."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031544> rdfs:label "Elevated circulating palmitoleylcarnitine concentration" ;
    dcterms:description "An elevated level of propionylcarnitine in the circulation. Propionylcarnitine is present in high abundance in the urine of patients with Methylmalonyl-CoA mutase (MUT) deficiency." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated plasma palmitoleylcarnitine, C16:1"^^<http://example.org/invalidDatatype>,
        "Elevated circulating O-propionylcarnitine concentration",
        "Elevated plasma propionylcarnitine, C3:0",
        "Elevated propionylcarnitine level" ;
    ns1:synonym "Elevated plasma propionylcarnitine, C3:0"^^<http://example.org/invalidDatatype>,
        "Elevated circulating O-propionylcarnitine concentration",
        "Elevated plasma palmitoleylcarnitine, C16:1",
        "Elevated propionylcarnitine level" .

<http://purl.obolibrary.org/obo/HP_0031595> rdfs:label "Abnormal P wave"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any anomaly of the P wave of the EKG, which results from atrial depolarization. The P wave occurs when the sinoatrial node creates an action potential that depolarizes the atria." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031606> rdfs:label "Retinal cotton wool spot" ;
    dcterms:description "Fluffy white patch in the inner retina, representing localized areas of dense white swelling of the retinal nerve fiber layer." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031615> rdfs:label "Hypopyon"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Presence of pus (appears as a white fluid) producing a fluid level in the inferior part of the anterior chamber."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031622> rdfs:label "Brown anomaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An ocular motility defect where the affected eye(s) does not elevate in adduction but has full depression in adduction. It can be congenital or acquired from injury to or defect of the superior oblique tendon or trochlea and has a positive forced duction test result."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brown syndrome" ;
    ns1:synonym "Brown syndrome"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031653> rdfs:label "Abnormal heart valve physiology" ;
    dcterms:description "Any functional abnormality of a cardiac valve." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031677> rdfs:label "Polymorphic ventricular tachycardia" ;
    dcterms:description "A type of ventricular tachycardia that is characterized by variable QRS complexes within each lead (i.e., QRS complexes may be different from beat to beat)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031690> rdfs:label "Opportunistic infection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An infection that is caused by a pathogen that would generally not be able to cause an infection in a host with a normal immune system. Such pathogens take advantage of the opportunity, so to speak, that is provided by a weakened immune system." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031693> rdfs:label "Severe Epstein Barr virus infection" ;
    dcterms:description "An unusually severe Epstein Barr virus (EBV) infection."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fulminant infectious mononucleosis",
        "Severe EBV infection" ;
    ns1:synonym "Fulminant infectious mononucleosis"^^<http://example.org/invalidDatatype>,
        "Severe EBV infection" .

<http://purl.obolibrary.org/obo/HP_0031695> rdfs:label "Severe parainfluenza infection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unusually severe infection by a parainfluenza virus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031696> rdfs:label "Disseminated viral infection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A viral infection that fails to be contained by the immune system and spreads throughout the body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031700> rdfs:label "Invasive parasitic infection" ;
    dcterms:description "A parasitic infection whereby the parasite invades (migrates through) tissues of the infected host."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031717> rdfs:label "Alternating exotropia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of exotropia in which either eye may be used for fixation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Alternating strabismus" ;
    ns1:synonym "Alternating strabismus" .

<http://purl.obolibrary.org/obo/HP_0031721> rdfs:label "Sensory exotropia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of divergent strabismus (exotropia) that develops in a poorly seeing eye." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Secondary exotropia" ;
    ns1:synonym "Secondary exotropia" .

<http://purl.obolibrary.org/obo/HP_0031723> rdfs:label "Secondary esotropia" ;
    dcterms:description "Convergent squint which follows loss or impairment of vision."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Sensory esotropia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Sensory esotropia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031728> rdfs:label "Mild hypermetropia" ;
    dcterms:description "A form of hypermetropia with not more than +2.00 diopters."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mild hyperopia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Mild hyperopia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031729> rdfs:label "Moderate hypermetropia" ;
    dcterms:description "A form of hypermetropia with more than +2.00 diopters but not more than +5.00 diopters." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Moderate hyperopia" ;
    ns1:synonym "Moderate hyperopia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031731> rdfs:label "Increased tear production" ;
    dcterms:description "Increased lacrimation owing to overproduction of tears." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031747> rdfs:label "Superior rectus muscle underaction" ;
    dcterms:description "Reduced movement of the superior rectus muscle which improves on testing ductions, typically associated with neurogenic palsy."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031790> rdfs:label "Mixed astigmatism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of astigmatism in which an unequal curvature of the cornea and some cases additionally of the lens causes one meridian of the eye to be hyperopic (farsighted) and a second meridian that is perpendicular to the first to be myopic (nearsighted)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031793> rdfs:label "Increased serum leptin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased concentration of leptin in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating leptin level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated circulating leptin level" .

<http://purl.obolibrary.org/obo/HP_0031799> rdfs:label "Decreased circulating apolipoprotein A-I concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of apolipoprotein A-I below the lower limit of normal. Apolipoprotein A-I is the major protein component of high density lipoprotein (HDL) in plasma. Defects in this gene are associated with HDL deficiencies, including Tangier disease." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased apo-AI level",
        "Decreased apoA-I level",
        "Decreased apolipoprotein AI level" ;
    ns1:synonym "Decreased apo-AI level",
        "Decreased apoA-I level",
        "Decreased apolipoprotein AI level" .

<http://purl.obolibrary.org/obo/HP_0031805> rdfs:label "Intraretinal hemorrhage" ;
    dcterms:description "A subtype of fundus hemorrhage occurring within the neurosensory retina. Intraretinal hemorrhages may be 'dot' or' blot' shaped, flame shaped or confluent depending upon their depth within the retina." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Intraretinal haemorrhage" ;
    ns1:synonym "Intraretinal haemorrhage" .

<http://purl.obolibrary.org/obo/HP_0031817> rdfs:label "Decreased circulating parathyroid hormone level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally decreased concentration of parathyroid hormone."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased serum PTH"^^<http://example.org/invalidDatatype>,
        "Decreased serum parathyroid hormone level"^^<http://example.org/invalidDatatype>,
        "Decreased circulating PTH level",
        "Decreased serum parathyroid hormone" ;
    ns1:synonym "Decreased circulating PTH level"^^<http://example.org/invalidDatatype>,
        "Decreased serum parathyroid hormone"^^<http://example.org/invalidDatatype>,
        "Decreased serum parathyroid hormone level"^^<http://example.org/invalidDatatype>,
        "Decreased serum PTH" .

<http://purl.obolibrary.org/obo/HP_0031830> rdfs:label "Pinguecula" ;
    dcterms:description "A pinguecula is a yellowish to brown protruding lesion in the conjunctiva that is easily seen on the nasal and temporal sides of the cornea." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031833> rdfs:label "Hypometric upward saccades"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Saccadic undershoot of upward saccadic eye movements, i.e., an upward saccadic eye movement that has less than the magnitude that would be required to gain fixation of the object."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031834> rdfs:label "Aortopulmonary collateral arteries"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Small ectopic arteries or arterial branches that connect the aorta, aortic branches and/or subclavian artery regions directly to the lung parenchyma, usually seen in conjunction with pulmonary atresia, ventricular septal defect (VSD) and/or closed ductus arteriosus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031844> rdfs:label "Euphoria" ;
    dcterms:description "Elevation of emotional tone or mood that significantly deviates from normative affective functioning. This state is characterized by an overwhelming and all-encompassing sense of joyous well-being; it is associated with unfounded grandiosity, or grossly inflated self-esteem, rapid speech, impulsivity, and an impaired capacity for self-regulation, irrespective of context."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Emotional hyperexcitability"^^<http://example.org/invalidDatatype>,
        "Exhilaration"^^<http://example.org/invalidDatatype>,
        "Extreme hedonic state"^^<http://example.org/invalidDatatype>,
        "Extreme positive valence"^^<http://example.org/invalidDatatype>,
        "High emotions"^^<http://example.org/invalidDatatype>,
        "Hyperthymic state"^^<http://example.org/invalidDatatype>,
        "Revved"^^<http://example.org/invalidDatatype>,
        "Abnormal positive emotional state",
        "Emotional high",
        "High mood",
        "Hyperthymia",
        "Jubilation" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Extreme elation"^^<http://example.org/invalidDatatype>,
        "Euphoric mood",
        "Inappropriate elation" ;
    ns1:related_synonym "Abnormally elevated mood"^^<http://example.org/invalidDatatype>,
        "Enhanced pleasure response"^^<http://example.org/invalidDatatype>,
        "Pathological emotional elevation"^^<http://example.org/invalidDatatype>,
        "Elevated positive affect",
        "Excessive joyfulness",
        "Inappropriately happy",
        "Pathological cheerfulness" ;
    ns1:synonym "Abnormal positive emotional state"^^<http://example.org/invalidDatatype>,
        "Abnormally elevated mood"^^<http://example.org/invalidDatatype>,
        "Elevated positive affect"^^<http://example.org/invalidDatatype>,
        "Emotional hyperexcitability"^^<http://example.org/invalidDatatype>,
        "Enhanced pleasure response"^^<http://example.org/invalidDatatype>,
        "Excessive joyfulness"^^<http://example.org/invalidDatatype>,
        "Exhilaration"^^<http://example.org/invalidDatatype>,
        "High mood"^^<http://example.org/invalidDatatype>,
        "Hyperthymia"^^<http://example.org/invalidDatatype>,
        "Hyperthymic state"^^<http://example.org/invalidDatatype>,
        "Emotional high",
        "Euphoric mood",
        "Extreme elation",
        "Extreme hedonic state",
        "Extreme positive valence",
        "High emotions",
        "Inappropriate elation",
        "Inappropriately happy",
        "Jubilation",
        "Pathological cheerfulness",
        "Pathological emotional elevation",
        "Revved" .

<http://purl.obolibrary.org/obo/HP_0031849> rdfs:label "Sleep-wake inversion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reversal of sleeping habits, with a tendency to sleep during the day and be awake at night." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Inverted sleep-wake cycle"^^<http://example.org/invalidDatatype>,
        "Reversed sleep-wake cycle"^^<http://example.org/invalidDatatype>,
        "Sleep rhythm inversion" ;
    ns1:synonym "Reversed sleep-wake cycle"^^<http://example.org/invalidDatatype>,
        "Sleep rhythm inversion"^^<http://example.org/invalidDatatype>,
        "Inverted sleep-wake cycle" .

<http://purl.obolibrary.org/obo/HP_0031857> rdfs:label "Ineffective esophageal peristalsis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced or inadequate esophageal peristalsis, with resultant slow passage of contents through the esophagus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ineffective esophageal motility" ;
    ns1:synonym "Ineffective esophageal motility" .

<http://purl.obolibrary.org/obo/HP_0031866> rdfs:label "Clasp-knife sign"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Clasp-knife phenomenon refers to increased muscle tone while bending or stretching a limb, whereby there is a sudden relaxation (decrease in resistance) as the muscle continues to be stretched. This phenomenon has been likened to opening a clasp knife."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031868> rdfs:label "Optic ataxia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Difficulty reaching visually guided goals in peripheral vision, with the deficit, leaves voluntary eye movements largely unaffected."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031876> rdfs:label "Decreased circulating hepcidin concentration" ;
    dcterms:description "Concentration of hepcidin in the blood circulation below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased hepcidin level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased hepcidin level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031903> rdfs:label "Abnormal circulating selenium concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation from the normal circulating concentration of selenium." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal serum selenium concentration" ;
    ns1:synonym "Abnormal serum selenium concentration"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031909> rdfs:label "Unicornuate uterus" ;
    dcterms:description "A uterus that has a single horn, with a banana-like shape that may or may not have a secondary rudimentary uterine horn."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031912> rdfs:label "Trigeminal anesthesia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Decreased or absent sensation in the distribution of the trigeminal nerve, which provides tactile, proprioceptive, and nociceptive sensation in the area of the face and mouth." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Trigeminal anaesthesia" ;
    ns1:synonym "Trigeminal anaesthesia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031921> rdfs:label "Gastrocnemius myalgia" ;
    dcterms:description "Pain of the gastrocnemius muscle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Calf myalgia"^^<http://example.org/invalidDatatype>,
        "Calf muscle pain" ;
    ns1:synonym "Calf myalgia"^^<http://example.org/invalidDatatype>,
        "Calf muscle pain" .

<http://purl.obolibrary.org/obo/HP_0031935> rdfs:label "Ascending aorta hypoplasia" ;
    dcterms:description "Significant luminal narrowing of a long segment of or the entire ascending aorta."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031943> rdfs:label "Akathisia" ;
    dcterms:description "A state of motor restlessness, usually in the lower extremities, that is often but not always accompanied by a subjective sense of inner restlessness, an urge to move, and anxiety or dysphoria."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031955> rdfs:label "Antalgic gait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "To avoid pain weight is put on the affected leg for as short a time as possible, resulting in a limp. The patients appear to be walking as if there were a thorn in the sole of the foot. To reduce the load on the affected leg the patients lift and lower their foot in a fixed ankle position." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Limp" ;
    ns1:synonym "Limp"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031958> rdfs:label "Spastic paraparetic gait" ;
    dcterms:description "A type of spastic gait in which the legs are usually slightly bent at the hip and in an adducted position. The knees are extended or slightly bent and the feet are in a plantar flexion position. This posture requires circumduction of the legs during walking. The gait may appear stiff (spastic gait disorder) or stiff as well as insecure (spastic ataxic gait disorder). In spastic paraparetic gait, each leg appears to be dragged forward. If the muscle tone in the adductors is marked, the resulting gait disorder is referred to as scissor gait." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031986> rdfs:label "Polyminimyoclonus" ;
    dcterms:description "Minipolymyoclonus or polyminimyoclonus is a hyperkinetic movement disorder phenomenology characterized by intermittent, low-amplitude, arrhythmic movements of the hands, commonly of several fingers, with amplitudes just sufficient to produce visible and palpable movements of the joints. It is mostly noticed while the individual is maintaining a posture (commonly outstretched hands) or during action (especially the initial phase of movement)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Minipolymyoclonus"^^<http://example.org/invalidDatatype> ;
    ns1:narrow_synonym "Facial-faucial-finger minimyoclonus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Facial-faucial-finger minimyoclonus"^^<http://example.org/invalidDatatype>,
        "Minipolymyoclonus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032009> rdfs:label "Infantile constant exotropia" ;
    dcterms:description "Constant exotropia occurring before 6 months of age.; often associated with a large angle of deviation and ocular/CNS abnormalities."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Infantile (constant) exotropia" ;
    ns1:synonym "Infantile (constant) exotropia" .

<http://purl.obolibrary.org/obo/HP_0032014> rdfs:label "Dysmetric vertical saccades"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inaccurate saccades (rapid movement of the eye between fixation points) in the vertical direction."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032018> rdfs:label "Multiple mononeuropathy" ;
    dcterms:description "A type of peripheral neuropathy that happens when there is damage to two or more different nerve areas characterized by peripheral neuropathy of both the motor and sensory nerves of at least two different nerve trunks. Different nerves are affected either simultaneously or sequentially." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mononeuritis multiplex"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Mononeuritis multiplex"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032019> rdfs:label "Muscle eosinophilia" ;
    dcterms:description "Eosinophil infiltration of skeletal muscle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Eosinophilic infiltration of skeletal muscle"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Eosinophilic infiltration of skeletal muscle" .

<http://purl.obolibrary.org/obo/HP_0032028> rdfs:label "Macular dots" ;
    dcterms:description "Yellow, white or grayish lesions in the macula that are well-defined/distinct, individual and mostly uniform in size." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032036> rdfs:label "Reduced contrast sensitivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality in perception of contrast. Spatial contrast is a physical dimension referring to the light-dark transition of a border or an edge in an image that delineates the existence of a pattern or an object. Contrast sensitivity refers to a measure of how much contrast a person requires to see a target. Contrast-sensitivity measurements differ from acuity measurements; acuity is a measure of the spatial-resolving ability of the visual system under conditions of very high contrast, whereas contrast sensitivity is a measure of the threshold contrast for seeing a target."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal contrast sensitivity" ;
    ns1:synonym "Abnormal contrast sensitivity" .

<http://purl.obolibrary.org/obo/HP_0032041> rdfs:label "Vocal cord polyp" ;
    dcterms:description "A small growth on a vocal cord that may appear as pedunculated or sessile and have varying size, shape, and color."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032043> rdfs:label "Odynophagia" ;
    dcterms:description "Pain experienced with swallowing." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Painful swallowing" ;
    ns1:synonym "Painful swallowing"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032047> rdfs:label "Focal cortical dysplasia type I"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of focal cortical dysplasia that is characterized by abnormal cortical layering."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032067> rdfs:label "Elevated serum bicarbonate concentration" ;
    dcterms:description "An abnormal increase in the concentration of bicarbonate, HCO3[-], in the circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated serum HCO3 concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated serum HCO3 concentration"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032075> rdfs:label "Splenopancreatic fusion" ;
    dcterms:description "Fusion of the pancreatic tail and spleen." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032077> rdfs:label "Male urethral meatus stenosis" ;
    dcterms:description "An abnormal narrowing of the urethral opening (meatus) of the penis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Meatus stenosis"^^<http://example.org/invalidDatatype>,
        "Meatal stenosis" ;
    ns1:synonym "Meatal stenosis"^^<http://example.org/invalidDatatype>,
        "Meatus stenosis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032098> rdfs:label "Hypomanganesemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduction below the normal concentration of manganese in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032105> rdfs:label "Macrosaccadic oscillations"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of saccadic oscillations with brief periods of fixation between saccades (intersaccadic interval approximately 200 msec). Macrosaccadic oscillations (up to 40 degrees) straddle the intended fixation position and show a crescendo-decrescendo pattern." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Macrosaccadic oscillation" ;
    ns1:synonym "Macrosaccadic oscillation" .

<http://purl.obolibrary.org/obo/HP_0032123> rdfs:label "Ultra-low vision"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Best corrected visual acuity worse than 1.90 logMAR (roughly 20/1590)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032143> rdfs:label "Burning mouth"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An intense sensation of burning, scalding, or tingling feeling of the tongue or other regions of the oral mucosa." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032150> rdfs:label "Paroxysmal rectal pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excruciating burning pain in the rectal area that may be triggered by defecation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032155> rdfs:label "Abdominal cramps"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of abdominal pain characterized by a feeling of contractions and typically fluctuating in intensity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032177> rdfs:label "Parenchymal consolidation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Consolidation refers to an exudate or other product of disease that replaces alveolar air, rendering the lung solid (as in infective pneumonia)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032180> rdfs:label "Abnormal circulating metabolite concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal level of an analyte measured in the blood." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032209> rdfs:label "Abnormal circulating free T3 concentration" ;
    dcterms:description "A deviation from the normal concentration of free triiodothyronine (T3) in the blood circulation. A proportion of T3 is bound to plasma proteins in the blood, including mainly thyroxine binding globulin, transthyretin, and albumin. T3 that is not bound to a protein is referred to as free T3." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal circulating free T3 level",
        "Abnormal circulating free triiodotyronine concentration" ;
    ns1:synonym "Abnormal circulating free T3 level"^^<http://example.org/invalidDatatype>,
        "Abnormal circulating free triiodotyronine concentration" .

<http://purl.obolibrary.org/obo/HP_0032210> rdfs:label "Decreased circulating free T3"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduced concentration of free 3,3',5-triiodo-L-thyronine in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased circulating free triiodothyronine"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased circulating free triiodothyronine" .

<http://purl.obolibrary.org/obo/HP_0032218> rdfs:label "Decreased CD4+ T cell proportion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal decrease of helper CD3+CD4+ T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group. These are usually measured within the TCR alpha/beta positive population."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased helper T cell proportion"^^<http://example.org/invalidDatatype>,
        "Decreased proportion circulating T-helper cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of CD4-positive helper T cells"^^<http://example.org/invalidDatatype>,
        "Reduced proportion of CD4-positive cells"^^<http://example.org/invalidDatatype>,
        "CD4 T cell lymphopenia",
        "Decreased proportion of CD4+ T cells",
        "Decreased proportion of CD4+ cells",
        "Decreased proportion of CD4-positive T cells",
        "Decreased proportion of CD4-positive, alpha-beta T cells",
        "Reduced helper T cell proportion" ;
    ns1:synonym "Decreased helper T cell proportion"^^<http://example.org/invalidDatatype>,
        "Decreased proportion circulating T-helper cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of CD4+ T cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of CD4-positive T cells"^^<http://example.org/invalidDatatype>,
        "Decreased proportion of CD4-positive helper T cells"^^<http://example.org/invalidDatatype>,
        "Reduced proportion of CD4-positive cells"^^<http://example.org/invalidDatatype>,
        "CD4 T cell lymphopenia",
        "Decreased proportion of CD4+ cells",
        "Decreased proportion of CD4-positive, alpha-beta T cells",
        "Reduced helper T cell proportion" .

<http://purl.obolibrary.org/obo/HP_0032234> rdfs:label "Increased circulating creatine kinase MM isoform" ;
    dcterms:description "An increased concentration of the MM isoform of creatine kinase in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased circulating CK MM isoform"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased circulating CK MM isoform" .

<http://purl.obolibrary.org/obo/HP_0032252> rdfs:label "Granuloma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A compact, organized collection of mature mononuclear phagocytes, which may be but is not necessarily accompanied by accessory features such as necrosis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032263> rdfs:label "Increased blood pressure" ;
    dcterms:description "Abnormal increase in blood pressure. An individual measurement of increased blood pressure does not necessarily imply hypertension. In practical terms, multiple measurements are recommended to diagnose the presence of hypertension."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased BP"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased BP" .

<http://purl.obolibrary.org/obo/HP_0032264> rdfs:label "Anti-NMDA receptor antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against the NMDA (N-methyl-D-aspartate)-type glutamate receptor."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Presence of anti-N-methyl-D-aspartate Receptor antibody in blood"^^<http://example.org/invalidDatatype>,
        "Presence of anti-NMDAR antibody in blood" ;
    ns1:synonym "Presence of anti-N-methyl-D-aspartate Receptor antibody in blood",
        "Presence of anti-NMDAR antibody in blood" .

<http://purl.obolibrary.org/obo/HP_0032266> rdfs:label "CSF anti-NMDA receptor antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the cerebrospinal fluid (CSF) that react against the NMDA (N-methyl-D-aspartate)-type glutamate receptor."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Presence of NMDAR antibody in CSF"^^<http://example.org/invalidDatatype>,
        "Presence of anti-N-methyl-D-aspartate Receptor antibody in CSF"^^<http://example.org/invalidDatatype>,
        "Presence of anti-NMDAR antibody in cerebrospinal fluid" ;
    ns1:synonym "Presence of NMDAR antibody in CSF"^^<http://example.org/invalidDatatype>,
        "Presence of anti-NMDAR antibody in cerebrospinal fluid"^^<http://example.org/invalidDatatype>,
        "Presence of anti-N-methyl-D-aspartate Receptor antibody in CSF" .

<http://purl.obolibrary.org/obo/HP_0032273> rdfs:label "Increased circulating N-acetylaspartic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of N-acetylaspartic acid in the blood circulation above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased circulating N-acetyl aspartate level"^^<http://example.org/invalidDatatype>,
        "Increased circulating N-acetyl aspartic acid level",
        "Increased circulating N-acetyl-L-aspartic acid level",
        "Increased circulating N-acetylaspartate level",
        "Increased circulating NAA level" ;
    ns1:synonym "Increased circulating N-acetyl aspartic acid level"^^<http://example.org/invalidDatatype>,
        "Increased circulating N-acetyl-L-aspartic acid level"^^<http://example.org/invalidDatatype>,
        "Increased circulating N-acetylaspartate level"^^<http://example.org/invalidDatatype>,
        "Increased circulating N-acetyl aspartate level",
        "Increased circulating NAA level" .

<http://purl.obolibrary.org/obo/HP_0032274> rdfs:label "Increased CSF N-acetylaspartic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally increased concentration of N-acetylaspartic acid in the cerebrospinal fluid (CSF)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased N-acetyl aspartate levels in CSF"^^<http://example.org/invalidDatatype>,
        "Increased N-acetyl aspartic acid levels in CSF"^^<http://example.org/invalidDatatype>,
        "Increased N-acetyl-L-aspartic acid levels in CSF"^^<http://example.org/invalidDatatype>,
        "Increased N-acetylaspartate levels in CSF"^^<http://example.org/invalidDatatype>,
        "Increased NAA levels in CSF"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased N-acetyl aspartic acid levels in CSF"^^<http://example.org/invalidDatatype>,
        "Increased N-acetyl-L-aspartic acid levels in CSF"^^<http://example.org/invalidDatatype>,
        "Increased N-acetylaspartate levels in CSF"^^<http://example.org/invalidDatatype>,
        "Increased N-acetyl aspartate levels in CSF",
        "Increased NAA levels in CSF" .

<http://purl.obolibrary.org/obo/HP_0032276> rdfs:label "Prominent subcalcaneal fat pad"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally increased prominence of the fat pad underneath the heal. This feature can be appreciated in figure 1 of PMID:26769062."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032278> rdfs:label "2-hydroxyglutarate aciduria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of 2-hydroxyglutaric acid in the urine, normalized for urine concentration, is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032283> rdfs:label "Disseminated nontuberculous mycobacterial infection" ;
    dcterms:description "An infection with nontuberculous mycobacteria that affects multiple body sites. Such infections can occur in individuals with immune disease."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032284> rdfs:label "Ultra-low vision with retained motion projection"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Ultra-low vision but with retained ability to identify a moving object (typically hand motion at distance of 30 cm)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032286> rdfs:label "Ultra-low vision with retained light perception"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Ultra-low vision but with retained ability to perceive the difference between light and dark." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032287> rdfs:label "Ultra-low vision with no light perception"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Ultra-low vision with complete lack of light and form perception." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032290> rdfs:label "Monoclonal elevation of IgG"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in circulating immunoglobulins characterized by a single band in serum electrophoresis but not the broad diffuse band that characterizes a polyclonal increase in circulating immunoglobulins."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032335> rdfs:label "Monoclonal elevation of circulating IgA" ;
    dcterms:description "An increase in circulating IgA characterized by one predominant band in serum electrophoresis but not the broad diffuse band that characterizes a polyclonal increase in circulating immunoglobulins."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032342> rdfs:label "Reduced forced expiratory volume in one second" ;
    dcterms:description "An abnormal reduction in the amount of air a person can forcefully expel in one second." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced FEV1"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced FEV1" .

<http://purl.obolibrary.org/obo/HP_0032359> rdfs:label "Decreased forced expiratory flow 25-75%" ;
    dcterms:description "A reduction compared to the predicted value of the forced expiratory flow over the middle one-half of the FVC; the average flow from the point at which 25% of the FVC has been exhaled to the point at which 75% of the FVC has been exhaled." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased FEF25-75%" ;
    ns1:synonym "Decreased FEF25-75%"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032389> rdfs:label "Periventricular laminar heterotopia" ;
    dcterms:description "A large mass of heterotopia in a laminar configuration along the ventricular walls. Usually bilateral."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032390> rdfs:label "Periventricular ribbonlike heterotopia" ;
    dcterms:description "Heterotopia that forms a continuous wavy line along the ventricular wall."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032411> rdfs:label "Posterior predominant subcortical band heterotopia" ;
    dcterms:description "Longitudinal bands of gray matter located deep to the cerebral cortex and separated from it by a thin layer of normal appearing white matter visible along the occipital cortex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Occipital subcortical band heterotopia",
        "Subcortical band heterotopia posterior predominant" ;
    ns1:synonym "Occipital subcortical band heterotopia",
        "Subcortical band heterotopia posterior predominant" .

<http://purl.obolibrary.org/obo/HP_0032416> rdfs:label "Retinal microaneurysm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A localized dilation or outpouching of microvasculature formed due to disruption of the vessel wall of a retinal capillary blood vessel. The lesions present as small red dots with distinct margins and are not larger than a blood vessel width at the disk margin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032458> rdfs:label "Narrowing of medullary canal" ;
    dcterms:description "A reduction in diameter and volume of the central cavity of bone where red or yellow bone marrow is located."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Narrowing of the marrow cavity"^^<http://example.org/invalidDatatype>,
        "Medullary cavity obliteration",
        "Narrowing of bone marrow canal",
        "Narrowing of bone medullary canal" ;
    ns1:synonym "Narrowing of the marrow cavity"^^<http://example.org/invalidDatatype>,
        "Medullary cavity obliteration",
        "Narrowing of bone marrow canal",
        "Narrowing of bone medullary canal" .

<http://purl.obolibrary.org/obo/HP_0032460> rdfs:label "Decreased phosphoribosylpyrophosphate synthetase level" ;
    dcterms:description "Abnormally reduced level of the enzyme phosphoribosyl pyrophosphatesynthetase, which catalyzes the synthesis of PP-ribose-P from ATP and ribose-5-phosphate."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032464> rdfs:label "Ureteral hypoplasia" ;
    dcterms:description "Underdevelopment of the ureter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplasia of the ureter"^^<http://example.org/invalidDatatype>,
        "Ureter hypoplasia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Ureter hypoplasia"^^<http://example.org/invalidDatatype>,
        "Hypoplasia of the ureter" .

<http://purl.obolibrary.org/obo/HP_0032499> rdfs:label "Giant neutrophil granules"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of abnormally large granules in neutrophils. This finding can be appreciated on a peripheral blood smear. The finding is characteristic of Chediak Higashi syndrome. The giant granules are derived from azurophil granules, whereas peroxidase-negative granules are not involved in their formation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032508> rdfs:label "Polyembolokoilamania"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Habitual insertion of foreign bodies into bodily orifices."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032509> rdfs:label "Onychotillomania" ;
    dcterms:description "Onychotillomania is characterized by the compulsive or irresistible urge in patients to pick at, pull off, or harmfully bite or chew their nails."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032524> rdfs:label "Long thumb" ;
    dcterms:description "Length of the thumb is greater than normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032548> rdfs:label "Increased placental thickness" ;
    dcterms:description "Abnormally elevated placental thickness."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Placental thickness increased" ;
    ns1:synonym "Placental thickness increased"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032549> rdfs:label "Persistent asymmetrical tonic neck reflex" ;
    dcterms:description "Persistence beyond the normal age (roughly the first half of the first year of life) of the asymmetric tonic neck reflex (ATNR), which is an easily elicited primitive reflex in the immediate newborn period. The ATNR refers to the phenomenon whereby when the face of an infant is turned to one side, the ipsilateral arm and leg extend and the contralateral arm and leg flex. This posture has been compared to a typical posture of fencers." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Persistent fencer's reflex"^^<http://example.org/invalidDatatype>,
        "Tonic neck reflex asymmetrical and persistent" ;
    ns1:synonym "Tonic neck reflex asymmetrical and persistent"^^<http://example.org/invalidDatatype>,
        "Persistent fencer's reflex" .

<http://purl.obolibrary.org/obo/HP_0032556> rdfs:label "Circumoral cyanosis" ;
    dcterms:description "Persistent blue color of the skin that surrounds the mouth." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bluish around mouth" ;
    ns1:synonym "Bluish around mouth" .

<http://purl.obolibrary.org/obo/HP_0032592> rdfs:label "Aplasia of the right hemidiaphragm" ;
    dcterms:description "Congenital absence of the right-sided diaphragm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Right diaphragmatic hernia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Right diaphragmatic hernia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032613> rdfs:label "Renal interstitial amyloid deposits" ;
    dcterms:description "Deposition of amyloid in the interstitial tissue of the kidney. Amyloid is is made up of 10 nm (on average) fibrils that are most commonly composed of monoclonal light chains (AL), transthyretin (TTR), amd LECT2, or occur in the setting of long standing systemic inflammation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Renal interstitial amyloid deposition"^^<http://example.org/invalidDatatype>,
        "Renal interstitial amyloid",
        "Renal interstitial amyloidosis" ;
    ns1:synonym "Renal interstitial amyloid"^^<http://example.org/invalidDatatype>,
        "Renal interstitial amyloid deposition",
        "Renal interstitial amyloidosis" .

<http://purl.obolibrary.org/obo/HP_0032614> rdfs:label "Renal glomerular amyloid deposition"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Amyloid deposits located in the glomeruli in a focal segmental, diffuse segmental or diffuse global fashion. This abnormality can be accompanied by mesangial involvement and in later stages also involvement of the peripheral capillaries." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032640> rdfs:label "Elevated circulating CCL18 level" ;
    dcterms:description "An increased concentration of C-C motif chemokine ligand 18 in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased C-C motif chemokine ligand 18 concentration" ;
    ns1:synonym "Increased C-C motif chemokine ligand 18 concentration" .

<http://purl.obolibrary.org/obo/HP_0032661> rdfs:label "Generalized convulsive status epilepticus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of bilateral convulsive seizure of generalized onset that is sufficiently prolonged (or repeated without recovery) to reach the threshold for status epilepticus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Generalised convulsive status epilepticus" ;
    ns1:synonym "Generalised convulsive status epilepticus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032665> rdfs:label "Repeated focal motor seizures" ;
    dcterms:description "A type of focal motor status epilepticus characterized by repeated motor, typically clonic events repeatedly affecting the same segments of the body with spread of clonic movements through contiguous body parts unilaterally, and repeating over a sufficiently prolonged period to reach a diagnosis of status epilepticus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Jacksonian status epilepticus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Jacksonian status epilepticus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032670> rdfs:label "Tonic status epilepticus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Tonic status epilepticus is a type of status epilepticus characterized by focal or bilateral limb stiffening or elevation, which may be electrographically generalized or focal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032705> rdfs:label "Focal aware cognitive seizure with forced thinking" ;
    dcterms:description "A focal cognitive seizure with forced thinking characterized by retained awareness throughout the seizure." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032712> rdfs:label "Focal impaired awareness motor seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of focal motor seizure in which awareness is partially or fully impaired at some point during the seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal motor impaired awareness seizure" ;
    ns1:synonym "Focal motor impaired awareness seizure" .

<http://purl.obolibrary.org/obo/HP_0032724> rdfs:label "Focal impaired awareness tonic seizure" ;
    dcterms:description "A focal tonic seizure in which awareness is partially or fully impaired at some point during the seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032755> rdfs:label "Focal impaired awareness autonomic seizure" ;
    dcterms:description "A focal autonomic seizure characterized by impaired awareness at some point within the seizure." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial autonomic seizure with altered responsiveness"^^<http://example.org/invalidDatatype>,
        "Focal autonomic seizure with altered responsiveness",
        "Localised autonomic seizure with altered responsiveness",
        "Localized autonomic seizure with altered responsiveness" ;
    ns1:synonym "Focal autonomic seizure with altered responsiveness"^^<http://example.org/invalidDatatype>,
        "Partial autonomic seizure with altered responsiveness"^^<http://example.org/invalidDatatype>,
        "Localised autonomic seizure with altered responsiveness",
        "Localized autonomic seizure with altered responsiveness" .

<http://purl.obolibrary.org/obo/HP_0032759> rdfs:label "Focal sensory seizure with vestibular features" ;
    dcterms:description "A seizure characterized by symptoms of dizziness, spinning, vertigo or sense of rotation as its first clinical manifestation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial vestibular seizure"^^<http://example.org/invalidDatatype>,
        "Focal vestibular seizure",
        "Vestibular aura" ;
    ns1:synonym "Partial vestibular seizure"^^<http://example.org/invalidDatatype>,
        "Focal vestibular seizure",
        "Vestibular aura" .

<http://purl.obolibrary.org/obo/HP_0032785> rdfs:label "Focal aware autonomic seizure with epigastric sensation/nausea/vomiting/other gastrointestinal phenomena" ;
    dcterms:description "A focal autonomic seizure with epigastric sensation / nausea / vomiting / other gastrointestinal phenomena characterized by retained awareness throughout the seizure." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032786> rdfs:label "Migrating focal seizure" ;
    dcterms:description "A migrating focal seizure is a seizure that involves different body parts, usually without overlap, in a consecutive manner so that the offset of a seizure in one part coincides with its onset in another, even shifting multiple times between the sides of the body. They can be associated with autonomic manifestations."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Migrating partial seizure" ;
    ns1:synonym "Migrating partial seizure"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032799> rdfs:label "Focal impaired awareness hemiclonic seizure" ;
    dcterms:description "A focal hemiclonic seizure in which awareness is impaired at some point during the seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032823> rdfs:label "Neonatal electro-clinical seizure with behavior arrest"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Neonatal electro-clinical non-motor seizure with behavior arrest is a type of neonatal electro-clinical seizure characterized by an arrest of activities, freezing, immobilization, with or without apnea and/or other autonomic manifestations." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neonatal electro-clinical seizure with behaviour arrest"^^<http://example.org/invalidDatatype>,
        "Neonatal electroclinical seizure with behavioural arrest"^^<http://example.org/invalidDatatype>,
        "Neonatal electroclinical seizure with behavioral arrest" ;
    ns1:synonym "Neonatal electroclinical seizure with behavioural arrest"^^<http://example.org/invalidDatatype>,
        "Neonatal electro-clinical seizure with behaviour arrest",
        "Neonatal electroclinical seizure with behavioral arrest" .

<http://purl.obolibrary.org/obo/HP_0032860> rdfs:label "Generalized non-convulsive status epilepticus without coma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Generalized non-convulsive status epilepticus without coma is a type of status epilepticus without prominent motor signs, which is electrographically generalized. It is a prolonged absence seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absence status epilepticus"^^<http://example.org/invalidDatatype>,
        "Petit mal status epilepticus"^^<http://example.org/invalidDatatype>,
        "Generalised non-convulsive status epilepticus without coma" ;
    ns1:synonym "Absence status epilepticus"^^<http://example.org/invalidDatatype>,
        "Generalised non-convulsive status epilepticus without coma"^^<http://example.org/invalidDatatype>,
        "Petit mal status epilepticus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0032895> rdfs:label "Febrile seizure outside the age of 3 months to 6 years"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any type of seizure (most often a generalized tonic-clonic seizure) occurring with fever (at least 38.0 degrees Celsius) but in the absence of central nervous system infection, severe metabolic disturbance or other alternative precipitant in people beyond the typical arrange of 3 months-6 years with no prior history of afebrile seizure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032898> rdfs:label "Focal automatism seizure" ;
    dcterms:description "A focal seizure characterized at onset by coordinated motor activity. This often resembles a voluntary movement and may consist of an inappropriate continuation of preictal motor activity." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032900> rdfs:label "Focal manual automatism seizure" ;
    dcterms:description "A type of focal automatism seizure characterized by manual automatisms at onset." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032901> rdfs:label "Focal pedal automatism seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of focal automatism seizure characterized by coordinated bilateral or unilateral movements of the feet or legs at onset. The movement is more reminiscent of normal movements in amplitude, and is less frenetic or rapid in comparison to the movements seen in focal hyperkinetic seizures involving the legs."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032906> rdfs:label "Focal head nodding automatism seizure" ;
    dcterms:description "A type of focal automatism seizure characterized by involuntary head nodding at onset." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032909> rdfs:label "Focal impaired awareness automatism seizure" ;
    dcterms:description "A focal seizure with automatism in which awareness is partially or fully impaired at some point during the seizure." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032945> rdfs:label "Renal interstitial inflammation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Histopathological findings of inflammation of the renal interstitium potentially involving fibrotic as well as non-fibrotic areas, composed of lymphocytes, monocytes, plasma cells."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032948> rdfs:label "Renal interstitial fibrosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The accumulation of collagen and related extracellular matrix (ECM) molecules in the interstitium of the kidney. The interstitium is expanded by the presence of collagen that stain blue on trichrome. Tubules are not back to back, but rather separated by fibrosis and can be atrophic."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032976> rdfs:label "Elevated bronchoalveolar lavage fluid lymphocyte proportion" ;
    dcterms:description "Usually, Lymphoycytes make up less than 15% of all cells found in the bronchoalveloar lavage fluid. This elevated cell proportion can be induced by virus or drugs, or is associated with specific diseases."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032977> rdfs:label "Elevated bronchoalveolar lavage fluid neutrophil proportion" ;
    dcterms:description "Usually, Neutrophils make up less than 3% of all cells found in the broncho-alveloar lavage fluid. In children, standard value of neutrophils is higher depending on their age (children under the age of 5 show a maximum value of 10%). This elevated cell proportion is a sign for acute and chronic infections (HP:0012387, HP:0006538) and can be associated to specific diseases." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated level of neutrophils in broncho-alveolar lavage fluid" ;
    ns1:synonym "Elevated level of neutrophils in broncho-alveolar lavage fluid" .

<http://purl.obolibrary.org/obo/HP_0033008> rdfs:label "Increased Z-disc width" ;
    dcterms:description "Abnormally increased width of the Z-disk of the sarcomere, resulting from splitting or opening of the Z-disc (c.f., Figure 2 of PMID:28732005)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased Z-disk width"^^<http://example.org/invalidDatatype>,
        "Widened z-discs"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased Z-disk width"^^<http://example.org/invalidDatatype>,
        "Widened z-discs"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033020> rdfs:label "Female reproductive system neoplasm" ;
    dcterms:description "A neoplasm that affects the female reproductive system." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3053"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033036> rdfs:label "Decreased nasal nitric oxide" ;
    dcterms:description "Reduced level of nasal nitric oxide (nNO). Current American Thoracic Society/European Respiratory Society (ATS/ERS) guidelines for nNO measurements recommend air aspiration via a nasal probe while the subject exhales through the mouth against resistance in order to maintain velum closure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low nasal nitric oxide level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Low nasal nitric oxide level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033048> rdfs:label "Substantia nigra hypointensity on susceptibility-weighted imaging" ;
    dcterms:description "Hypointence (dark) appearance of the substantia nigra inmagnetic resonance imaging using susceptibility weighted imaging (SWI)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low signal intensity in the substantia nigra on susceptibility-weighted imaging (SWI)"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Low signal intensity in the substantia nigra on susceptibility-weighted imaging (SWI)" .

<http://purl.obolibrary.org/obo/HP_0033063> rdfs:label "Shortened sleep phase"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A tendency to sleep fewer hours than usual while feeling well-rested." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Short sleep"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Short sleep" .

<http://purl.obolibrary.org/obo/HP_0033083> rdfs:label "Increased circulating farnesol concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevated level of farnesol in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033122> rdfs:label "Absent P wave"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The P wave that normally precedes each QRS complex by a fixed PR interval of 120 to 200 milliseconds is not present." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absence of P wave on electrocardiography"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Absence of P wave on electrocardiography"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033123> rdfs:label "Elevated circulating osteopontin level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally increased level of osteopontin in the blood circulation"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033124> rdfs:label "Increased serum sorbitol concentration" ;
    dcterms:description "An increased level of sorbitol in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033125> rdfs:label "Follicular lymphoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An indolent B cell lymphoproliferative disorder of transformed follicular center B cells. Follicular lymphoma is characterized by diffuse lymphadenopathy, bone marrow involvement, splenomegaly and less commonly other extranodal sites of involvement."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033140> rdfs:label "Blake's pouch cyst" ;
    dcterms:description "The presence of an upwardly displaced normal cerebellar vermis, normal appearance of the fastigium, tentorium and size of the cisterna magna."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033144> rdfs:label "Abnormal circulating ceruloplasmin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any deviation of the concentration of ceruloplasmin in the blood from the normal range."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033146> rdfs:label "Elevated circulating methylsuccinic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased concentration of methylsuccinic acid in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033149> rdfs:label "Intrahepatic bile duct dilatation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased diameter (caliber) of intrahepatic bile ducts (bile ducts that transport bile between the Canals of Hering and the interlobar bile ducts)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dilatation of intrahepatic biliary ducts"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dilatation of intrahepatic biliary ducts"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033165> rdfs:label "Necrotizing enterocolitis" ;
    dcterms:description "Inflammation of the intestine leading to bacterial invasion causing cellular damage and death which causes necrosis of the colon and intestine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033200> rdfs:label "Triceps hyporeflexia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced intensity of the triceps tendon reflex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyporeflexia of triceps"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hyporeflexia of triceps"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033201> rdfs:label "Biceps hyporeflexia" ;
    dcterms:description "Reduced intensity of the biceps tendon reflex."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyporeflexia of biceps" ;
    ns1:synonym "Hyporeflexia of biceps"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033202> rdfs:label "Brachioradialis hyporeflexia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced intensity of the brachioradialis tendon reflex." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033204> rdfs:label "Triceps hyperreflexia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased intensity of the triceps reflex." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033249> rdfs:label "Focal substantia nigra T2 hyperintensity" ;
    dcterms:description "Hyperintense lesion in the substantia nigra on magnetic resonance T2 imaging."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal substantia nigra T2 hyperintense lesion" ;
    ns1:synonym "Focal substantia nigra T2 hyperintense lesion"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033260> rdfs:label "Livedo racemosa"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Livedo racemosa describes a reddish-blue mottling of the skin in an irregular, reticular pattern. It differs from the more common livedo reticularis by its shape. Livedo racemosa consists of broken circular segments resulting in a seemingly larger pattern, as opposed to the fine, regular, complete network of livedo reticularis. Livedo racemosa results from permanent impairment of peripheral blood flow and, unlike livedo reticularis, it persists on warming." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033342> rdfs:label "Anti-aquaporin 4 antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against aquaporin-4." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-AQP4 antibody positivity" ;
    ns1:synonym "Anti-AQP4 antibody positivity" .

<http://purl.obolibrary.org/obo/HP_0033345> rdfs:label "Neuralgia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pain (An unpleasant sensory and emotional experience) along the course of a nerve." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033362> rdfs:label "Recurrent coughing spasms"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Repeated occurrence of episodes of coughing, with each episode consisting of at least five minutes of continuous coughing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033363> rdfs:label "Hyaline membranes"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hyaline membranes are homogeneous eosinophilic material composed of cellular debris, plasma proteins, and surfactant plastered against alveolar ducts and alveolar walls. The hyaline membranes are deposited along the walls of the alveoli, where gas exchange typically occurs, thereby making gas exchange difficult." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033407> rdfs:label "Elevated urine acetoacetic acid level" ;
    dcterms:description "Elevated amount of acetoacetic acid in the urine." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033442> rdfs:label "Elevated circulating glutarylcarnitine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of glutarylcarnitine in the blood circulation above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating C5-DC acylcarnitine concentration",
        "Elevated circulating O-glutarylcarnitine concentration",
        "Elevated plasma glutarylcarnitine, C5-DC" ;
    ns1:synonym "Elevated circulating C5-DC acylcarnitine concentration"^^<http://example.org/invalidDatatype>,
        "Elevated circulating O-glutarylcarnitine concentration"^^<http://example.org/invalidDatatype>,
        "Elevated plasma glutarylcarnitine, C5-DC"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033466> rdfs:label "Weak grip" ;
    dcterms:description "Reduced grip strength. Gripping is the motion by which the hand tightly grasps an object or other hand."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033511> rdfs:label "Addictive substance use"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Chronic compulsive drug seeking and continued use despite harmful consequences." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Drug addiction"^^<http://example.org/invalidDatatype>,
        "Addictive drug use" ;
    ns1:synonym "Addictive drug use"^^<http://example.org/invalidDatatype>,
        "Drug addiction"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033542> rdfs:label "Bronchial wall thickening"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Radiological appearance of increased density around the walls of a bronchus or large bronchiole. This feature is thought to be related to edema involving the bronchial wall as well as the peribronchial interstitial space. If the cross section of a bronchus is captured in a radiograph or computed tomography image, it is said to have the appearance of a donut because of the central lucency representing the airway of the bronchus surrounded by a circular region of increased density."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Peribronchial cuffing"^^<http://example.org/invalidDatatype>,
        "Peribronchial thickening" ;
    ns1:synonym "Peribronchial thickening"^^<http://example.org/invalidDatatype>,
        "Peribronchial cuffing" .

<http://purl.obolibrary.org/obo/HP_0033606> rdfs:label "Bone marrow maturation arrest" ;
    dcterms:description "Interruption of the procecss of diffferentiation of hematopoietic cells in the bone marrow, manifested by an increased proportion of immature cells in the bone marrow." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Haematopoietic maturation arrest",
        "Hematopoietic maturation arrest" ;
    ns1:synonym "Hematopoietic maturation arrest"^^<http://example.org/invalidDatatype>,
        "Haematopoietic maturation arrest" .

<http://purl.obolibrary.org/obo/HP_0033672> rdfs:label "Positive carpal Tinel sign" ;
    dcterms:description "The Tinel test is performed by lightly tapping (percussing) over the median nerve. It is positive (abnormal) if the patient experiences pain and paresthesias (tingling, numbness) along the distribution of the median nerve." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Positive carpal Hoffmann Tinel sign"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Positive carpal Hoffmann Tinel sign" .

<http://purl.obolibrary.org/obo/HP_0033673> rdfs:label "Positive Phalen test"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The Phalen maneuver is performed by having the patient hold both wrists in complete and forced flexion (pushing the dorsal surfaces of both hands together) for 30-60 seconds. This can increase the pressure in the carpal tunnel. The test is positive (abnormal) if the patient experiences characteristic symptoms of carpal tunnel syndrome (pain and paresthesias along the distribution of the median nerve, i.e., thumb, index finger, and middle finger)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Phalen maneuver"^^<http://example.org/invalidDatatype>,
        "Phalen manoeuvre"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Phalen maneuver",
        "Phalen manoeuvre" .

<http://purl.obolibrary.org/obo/HP_0033680> rdfs:label "Pilocytic astrocytoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The most common form of astrocytoma (WHO Grade I) in childhood. These typically have MAPK signaling pathway abnormalities." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C4047"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033681> rdfs:label "Oligodendroglioma" ;
    dcterms:description "Oligodendroglioma is a type of diffusely infiltrating glioma and constitutes approximately 5% of primary intracranial tumors. They often involve the cortical gray matter and are most commonly seen in the frontal lobes. OGs are generally low grade WHO grade II neoplasms that are slow-growing tumors and have a favorable treatment response when compared to other gliomas. Grade III anaplastic OG is a more malignant form of the tumor which portends a less favorable prognosis and may occur de novo or as degeneration from the lower grade OG."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3288"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033682> rdfs:label "Pleomorphic xanthoastrocytoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pleomorphic xanthoastrocytomas (PXA) are rare low-grade astrocytomas (WHO Grade II) typically found in the temporal lobe and classically presenting with epilepsy. PXA is an astrocytic neoplasm that most often presents in children or young adults but can also occur in adults. The diagnosis of anaplastic PXA is made based upon tumor histopathologic characteristics and requires increased proliferative activity (mitotic index at least 5 mitoses/10 HPF), which is associated with worse overall survival. In general, anaplastic PXAs acquire features of a more aggressive astrocytic neoplasm that can include increased proliferation, necrosis, microvascular proliferation, loss of pericellular reticulin, and increased infiltrative growth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033689> rdfs:label "Anterograde memory impairment"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The impaired ability to establish new long-term memories."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anterograde amnesia" ;
    ns1:synonym "Anterograde amnesia"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033705> rdfs:label "Tearfulness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A feeling of sadness characterized by episodes of crying that can occur suddenly and are not easily controlled in social situations." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Crying episodes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Crying episodes"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033716> rdfs:label "EEG with frontal epileptiform discharges"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Focal epileptiform EEG discharges recorded in the frontal region." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033717> rdfs:label "EEG with temporal epileptiform discharges"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Focal epileptiform EEG discharges recorded in the temporal region." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033757> rdfs:label "Pancreatic steatosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fat infiltration in the pancreas." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pancreatic fatty infiltration"^^<http://example.org/invalidDatatype>,
        "Pancreatic lipomatosis"^^<http://example.org/invalidDatatype>,
        "Pancreatic lipomatous pseudohypertrophy"^^<http://example.org/invalidDatatype>,
        "Fatty pancreas",
        "Non-alcoholic fatty pancreatic disease",
        "Pancreatic fatty replacement" ;
    ns1:synonym "Fatty pancreas"^^<http://example.org/invalidDatatype>,
        "Pancreatic fatty infiltration"^^<http://example.org/invalidDatatype>,
        "Non-alcoholic fatty pancreatic disease",
        "Pancreatic fatty replacement",
        "Pancreatic lipomatosis",
        "Pancreatic lipomatous pseudohypertrophy" .

<http://purl.obolibrary.org/obo/HP_0033802> rdfs:label "Intra-epidermal blistering"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of blistering in which the lesions are located within the epidermis with loss of cell-cell adhesion of keratinocytes. In simplex EB, cleavage occurs in the basal layer, which is the innermost layer of the epidermis and consists of a single layer of basal germinative cells (mostly epidermal Keratinocytes) that proliferate and thereby produce new cells for other epidermal layers. As the cells move towards the upper layers of the epidermis they mature and eventually form cornified cells. The suprabasal cell layer lies directly above the basal layer and is composed of five to ten layers of cells." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033832> rdfs:label "Livedo"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reddish-blue mottled condition of skin caused by inflammation of the cutaneous blood vessels."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Livedoid dermatitis" ;
    ns1:synonym "Livedoid dermatitis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033838> rdfs:label "Dysphoria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A pervasive state of negatively valenced emotional unease and dissatisfaction along with an inner discomfort that is disproportionate to external circumstances and may include heightened emotional reactivity. It is associated with a mixture of overlapping negative emotions that are difficult to disentangle."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Emotional discomfort"^^<http://example.org/invalidDatatype>,
        "Emotional discontent"^^<http://example.org/invalidDatatype>,
        "Emotional discord"^^<http://example.org/invalidDatatype>,
        "Inner distress",
        "Inner turmoil" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Emotionally unsettled"^^<http://example.org/invalidDatatype>,
        "Feeling off inside"^^<http://example.org/invalidDatatype>,
        "Ill at ease"^^<http://example.org/invalidDatatype>,
        "Dysphoric mood" ;
    ns1:related_synonym "Emotional unrest"^^<http://example.org/invalidDatatype>,
        "Psychological unease"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Emotional discontent"^^<http://example.org/invalidDatatype>,
        "Emotional unrest"^^<http://example.org/invalidDatatype>,
        "Feeling off inside"^^<http://example.org/invalidDatatype>,
        "Ill at ease"^^<http://example.org/invalidDatatype>,
        "Inner distress"^^<http://example.org/invalidDatatype>,
        "Inner turmoil"^^<http://example.org/invalidDatatype>,
        "Dysphoric mood",
        "Emotional discomfort",
        "Emotional discord",
        "Emotionally unsettled",
        "Psychological unease" .

<http://purl.obolibrary.org/obo/HP_0033842> rdfs:label "Early satiety" ;
    dcterms:description "The condition of being unable to eat a full meal because of a feeling of fullness (satiety), or or feeling very full after eating only a small amount of food."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Feeling full quickly when eating"^^<http://example.org/invalidDatatype>,
        "Not able to finish a normal-sized meal" ;
    ns1:synonym "Feeling full quickly when eating"^^<http://example.org/invalidDatatype>,
        "Not able to finish a normal-sized meal" .

<http://purl.obolibrary.org/obo/HP_0033980> rdfs:label "Paroxysmal tonic upgaze"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Recurrent episodes of sustained upward deviation of the eyes and incomplete downward saccades, and normal horizontal eye movements without impairment of consciousness."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033981> rdfs:label "Vertebral artery tortuosity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal tortuous (i.e., twisted) form of the vertebral arteries." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tortuous vertebral arteries" ;
    ns1:synonym "Tortuous vertebral arteries"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034007> rdfs:label "Posterior atrophy of corpus callosum" ;
    dcterms:description "The presence of atrophy (wasting) of the posterior portion of the corpus callosum." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034063> rdfs:label "Anti-islet antigen-2 antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against tyrosine phosphatase IA-2." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-IA2A"^^<http://example.org/invalidDatatype>,
        "Anti-IA2 antibody positivity",
        "ICA512" ;
    ns1:synonym "Anti-IA2 antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-IA2A",
        "ICA512" .

<http://purl.obolibrary.org/obo/HP_0034075> rdfs:label "Decreased circulating apolipoprotein B concentration" ;
    dcterms:description "The concentration of apolipoprotein B in the blood circulation is below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034122> rdfs:label "Anti-GQ1b antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against ganglioside Q1b." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034135> rdfs:label "Anti-neurofascin-155 antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against NF155."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-NF155 antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-NF155 antibody positivity" .

<http://purl.obolibrary.org/obo/HP_0034136> rdfs:label "Anti-neurofascin 186 antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against NF186." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-NF186 antibody positivity" ;
    ns1:synonym "Anti-NF186 antibody positivity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034137> rdfs:label "Anti-contactin-1 antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against CNTN1." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-CNTN1 antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-CNTN1 antibody positivity" .

<http://purl.obolibrary.org/obo/HP_0034138> rdfs:label "Anti-contactin-associated protein 1 antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the blood circulation that react against anti-contactin-associated protein 1."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-CASPR1 antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-CASPR1 antibody positivity"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034180> rdfs:label "Fusion of the caudate and putamen" ;
    dcterms:description "Abnormal joined appearance of the caudate and putamen with an absence of the anterior limb of the internal capsule." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034187> rdfs:label "Clavicular pseudarthrosis" ;
    dcterms:description "A developmental defect in a the clavicule leading to bending and pathologic fracture, with inability to form a normal bony callus with subsequent fibrous nonunion, leading to the pseudarthrosis (or false joint)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034201> rdfs:label "Increased CSF homovanillic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Elevated concentration of homovanillic acid (HVA) in the cerebrospinal fluid. HVA is a metabolite of dopamine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034210> rdfs:label "Fetal intraventricular hemorrhage"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of fetal intracranial hemorrhage with bleeding into the ventricular system of the brain."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034227> rdfs:label "Aortic isthmus hypoplasia" ;
    dcterms:description "A type of aortic arch hypoplasia whereby the isthmus (arch between the left subclavian and insertion of the patent ductus arteriosus/ligamentum arteriosum) has a diameter of less than 40% of the diameter of the ascending aorta."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034259> rdfs:label "Hypoplasia of the midbrain" ;
    dcterms:description "A developmental defect characterized by underdevelopment of the mesencephalon." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplasia of the mesencephalon",
        "Hypoplastic mesencephalon" ;
    ns1:synonym "Hypoplasia of the mesencephalon",
        "Hypoplastic mesencephalon" .

<http://purl.obolibrary.org/obo/HP_0034267> rdfs:label "Pelvic pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pain perceived in the area of the pelvis, the lower part of the abdomen located between the hip bones."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pain in the pelvis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pain in the pelvis" .

<http://purl.obolibrary.org/obo/HP_0034276> rdfs:label "Elevated circulating thymidine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of thymidine in the blood circulation above the normal range."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased serum thymidine"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased serum thymidine"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034277> rdfs:label "Elevated circulating deoxyuridine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of 2-deoxyuridine in the blood circulation is above the normal range."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034280> rdfs:label "Target cells" ;
    dcterms:description "Target cells (codocytes) have a centrally located disk of hemoglobin surrounded by an area of pallor with an outer rim of hemoglobin adjacent to the cell membrane giving the cell the appearance of a target." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Codocytes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Codocytes"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034290> rdfs:label "Elevated circulating tiglylglycine concentration" ;
    dcterms:description "Concentration of tiglylglycine in the blood circulation above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034291> rdfs:label "Elevated circulating creatine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevation above the normal range of creatine in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034297> rdfs:label "Elevated circulating tetracosanoic acid concentration" ;
    dcterms:description "Elevated concentration of tetracosanoic acid (a C24 straight-chain saturated fatty acid) in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034300> rdfs:label "Decreased acid sphingomyelinase activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced activity of the enzyme acid sphingomyelinase activity in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034302> rdfs:label "Megalopapilla"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A congenitally anomalous enlarged optic disc (surface area greater than 2.50 square millimeters). It is considered to be a normal variant without physiological defects." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034306> rdfs:label "Ventricular bigeminy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An electrocardiographic finding of a normal QRS followed by a premature ventricular contraction; a rhythmic pairing of normal and atypical beats originating in the ventricles in a 1-1 ratio such that an ectopic ventricular beat follows each regular heartbeat." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034311> rdfs:label "Hypoplastic optic chiasm" ;
    dcterms:description "Developmental defect characterized by undergrowth of the optic chiasm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Optic chiasm hypoplasia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Optic chiasm hypoplasia" .

<http://purl.obolibrary.org/obo/HP_0034316> rdfs:label "Thinning of the substantia nigra pars compacta" ;
    dcterms:description "Reduced volume of pars compacta of the substantia nigra."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034336> rdfs:label "Splenic infarction" ;
    dcterms:description "Ischemia and necrosis of part or all of the spleen resulting from compromise of blood supply resulting from arterial or venous occlusion."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spleen infarct"^^<http://example.org/invalidDatatype>,
        "Spleen infarction",
        "Splenic infarct" ;
    ns1:synonym "Spleen infarction"^^<http://example.org/invalidDatatype>,
        "Splenic infarct"^^<http://example.org/invalidDatatype>,
        "Spleen infarct" .

<http://purl.obolibrary.org/obo/HP_0034347> rdfs:label "Greater auricular nerve thickening"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increase in thickness of the great auricular nerve, a cutaneous nerve of the head. It originates from the cervical plexus, with branches of spinal nerves C2 and C3. Thickening may lead to the nerve being palpable or even visible in this region."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Palpable great auricular nerve"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Palpable great auricular nerve" .

<http://purl.obolibrary.org/obo/HP_0034365> rdfs:label "Elevated circulating alpha-aminoadipic semialdehyde concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased concentration of alpha-aminoadipic semialdehyde in the blood circulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating piperideine-6-carboxylic acid concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated circulating piperideine-6-carboxylic acid concentration" .

<http://purl.obolibrary.org/obo/HP_0034367> rdfs:label "Decreased circulating beta-mannosidase activity" ;
    dcterms:description "Activity of the enzyme beta-mannosidase below the lower limit of normal. Beta-mannosidase is a lysosomal enzyme that catabolizes oligosaccharides." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034372> rdfs:label "Internal tibial torsion" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Internal tibial rotation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Internal tibial rotation"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034381> rdfs:label "Central nervous system axonal spheroid" ;
    dcterms:description "Axonal spheroids are bubble-like biological features that form on most degenerating axons. During neurodegeneration, bubble-like swellings form along the length of the axon, a primary and early effect of dynamic axonal deformation. These varicosities, spheroids, or swellings have been described as beads on a string and branches bearing fruit, and they frequently appear on degenerating axons. The focal swellings on degenerating axons, axonal spheroids, are often filled with cellular debris such as organelles, pathological proteins, and disorganized cytoskeletal elements."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "CNS axonal spheroid"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "CNS axonal spheroid" .

<http://purl.obolibrary.org/obo/HP_0034394> rdfs:label "Forearm supination contracture" ;
    dcterms:description "A contracture that limits the ability of the forearm to stabilize the hand in pronation (pronation refers to a rotation of the forearm that causes the palm and forearm to face downwards), meaning that the palm is fixed in a upward orientation. Restriction of supination/pronation can occur at the elbow (radial-humeral joint), at the wrist (radial-ulnar joint), and anywhere in between."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Supination contracture of the forearm" ;
    ns1:synonym "Supination contracture of the forearm"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034399> rdfs:label "Prolonged central motor conduction time" ;
    dcterms:description "Increased duration of the central motor conduction time (CMCT). The CMCT estimates the conduction time of corticospinal fibers between motor cortex and spinal (or bulbar) motoneurons. It includes the times for excitation of cortical cells, conduction via the corticobulbar-corticospinal tract and excitation of the motoneuron sufficient to reach its firing threshold. CMCT is calculated by subtracting the peripheral conduction time from the MEP latency recorded after cortical stimulation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034401> rdfs:label "Atypical teratoid/rhabdoid tumor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An aggressive malignant embryonal neoplasm arising from the central nervous system. It is composed of cells with a large eccentric nucleus, prominent nucleolus, and abundant cytoplasm. Mutations of the SMARCB1 gene or very rarely SMARCA4 (BRG1) gene are present. The vast majority of cases occur in childhood. Symptoms include lethargy, vomiting, cranial nerve palsy, headache, and hemiplegia." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034402> rdfs:label "Rhabdoid tumor of the kidney" ;
    dcterms:description "A highly aggressive, extremely rare neoplasm of the kidney that is usually seen in children. The term rhabdoid is used because the tumor cells resemble rhabdomyoblasts but lack myogenic markers, and pathologic diagnosis requires familiarity with these microscopic features plus awareness that adult onset is possible. It can be associated with abnormalities of chromosome 22. It is characterized by the presence of cells with a large eccentric nucleus, prominent nucleolus, and abundant cytoplasm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Malignant rhabdoid tumor of the kidney"^^<http://example.org/invalidDatatype>,
        "Malignant rhabdoid tumour of the kidney"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Malignant rhabdoid tumor of the kidney",
        "Malignant rhabdoid tumour of the kidney" .

<http://purl.obolibrary.org/obo/HP_0034405> rdfs:label "Enlarged tectum"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increasaed size of the tectum, which is the region of the midbrain posterior to the cerebral aqueduct of Sylvius. The midbrain is the most superior portion of the brainstem." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Thick tectum" ;
    ns1:synonym "Thick tectum" .

<http://purl.obolibrary.org/obo/HP_0034435> rdfs:label "Abnormal eye contact"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any abnormality of eye contact behavior. We define eye contact as a form of nonverbal communication between two individuals who are facing each other in which an individual directs the eyes towards the eyes or face of the other individual. Eye contact occurs frequently and voluntarily during face-to-face verbal communication. The duration and frequency of eye contact that is interpreted to be appropriate may follow social and situational norms." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034494> rdfs:label "Opacified paranasal sinuses" ;
    dcterms:description "White appearance (radio-opaqueness) of a paranasal sinus on radiography." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Paranasal sinuses opacification"^^<http://example.org/invalidDatatype>,
        "Paranasal sinuses opacified"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Paranasal sinuses opacified"^^<http://example.org/invalidDatatype>,
        "Paranasal sinuses opacification" .

<http://purl.obolibrary.org/obo/HP_0034499> rdfs:label "Increased bone marrow iron" ;
    dcterms:description "An increased amount of iron in the bone marrow."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bone marrow: iron stores increased"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Bone marrow: iron stores increased" .

<http://purl.obolibrary.org/obo/HP_0034513> rdfs:label "Increased circulating Interferon-alpha concentration" ;
    dcterms:description "An elevation in the concentration of interferon alpha measured in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Interferon-alpha high in blood"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Interferon-alpha high in blood"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034553> rdfs:label "Absence of peroxisomes"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Lack of observable peroxisomes. This feature can be observed by immunohistochemical staining of cultured cells (such as fibroblasts) or by electronmicroscopy." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034565> rdfs:label "Elevated urinary 5-amino-4-imidazolecarboxamide-riboside level" ;
    dcterms:description "Increased amount of 5-amino-4-imidazolecarboxamide(AICA)-riboside in the urine. AICA-riboside is the dephosphorylated counterpart of AICAR, an intermediate of de novo purine biosynthesis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urinary AICA-riboside level" ;
    ns1:synonym "Elevated urinary AICA-riboside level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034648> rdfs:label "Elevated urine fumaric acid level" ;
    dcterms:description "The concentration of fumaric acid in the urine, normalized for urine concentration, is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated urine fumarate level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated urine fumarate level" .

<http://purl.obolibrary.org/obo/HP_0034656> rdfs:label "Elevated urine 3-hydroxyglutaric level" ;
    dcterms:description "The concentration of 3-hydroxyglutaric acid in the urine, normalized for urine concentration, is above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "3-hydroxyglutaric acid high in urine" ;
    ns1:synonym "3-hydroxyglutaric acid high in urine"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034687> rdfs:label "Impaired cerebroside sulfate hydrolysis" ;
    dcterms:description "Reduced hydrolysis (splitting of a bond and the addition of the hydrogen anion of water) of the sulfuric ester linkage in the molecule of cerebroside sulfate, possibly leading to accumuation of cerebroside sulfate."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034688> rdfs:label "Reduced peroxisomal glutaryl-CoA oxidase activity" ;
    dcterms:description "Diminished enzyme activity of peroxisomal glutaryl-CoA oxidase, an enzyme that metabolizes glutaryl-CoA (a metabolite of L-lysine, L-hydroxy-lysine and L-tryptophan) by dehydrogenation to glutaconyl-CoA directly followed by decarboxylation of this to crotonyl-CoA."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034697> rdfs:label "Cutaneous telangiectasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dilated blood vessels on the skin." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034721> rdfs:label "Elevated circulating pristanic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of pristanic acid in the blood circulation above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034730> rdfs:label "Elevated circulating S-adenosyl-L-homocysteine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased concentration of S-adenosyl-L-homocysteine in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated AdoHcy concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated AdoHcy concentration"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034731> rdfs:label "Elevated circulating S-adenosyl-L-methionine concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration S-adenosyl-L-methionine in the blood circulation above the upper limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High blood AdoMet"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "High blood AdoMet" .

<http://purl.obolibrary.org/obo/HP_0034770> rdfs:label "Lumbar hypolordosis" ;
    dcterms:description "Flattening of a curve in the spine in the lumbar (lower back) region."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced lumbar lordosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced lumbar lordosis"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034773> rdfs:label "Oscillopsia" ;
    dcterms:description "A visual disturbance in which objects in the visual field appear to oscillate (jump, jiggle, vibrate)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034782> rdfs:label "Obstipation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Obstipation is the inability to pass either stool or flatus (gas)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lack of flatulence",
        "No gas passage" ;
    ns1:related_synonym "Tympanic distended abdomen" ;
    ns1:synonym "Lack of flatulence"^^<http://example.org/invalidDatatype>,
        "No gas passage",
        "Tympanic distended abdomen" .

<http://purl.obolibrary.org/obo/HP_0034805> rdfs:label "Buttock pain" ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the buttock (round fleshy area at the lower rear area of a human trunk)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034806> rdfs:label "Vaginal foreign body sensation" ;
    dcterms:description "A perception that an object located in the vagina."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034819> rdfs:label "Iris nodule"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of a nodule (small rounded lump of tissue) in the iris."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034823> rdfs:label "Decreased CSF copper concentration" ;
    dcterms:description "Concentration of copper in the cerebrospinal fluid (CSF) below the lower limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Copper low in cerebrospinal fluid" ;
    ns1:synonym "Copper low in cerebrospinal fluid"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034863> rdfs:label "Reduced leukocyte arylsulfatase A activity" ;
    dcterms:description "Concentration or activity of the lysosomal enzyme arylsulfatase A (EC 3.1.6.8) as measured in leukocytes is below the limits of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034893> rdfs:label "Elevated brain glycine level by MRS" ;
    dcterms:description "An increase in the level of glycine in the brain identified by magnetic resonance spectroscopy (MRS)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034894> rdfs:label "Elevated brain polyol compounds by MRS" ;
    dcterms:description "An increase in the level of polyol compounds in the brain identified by magnetic resonance spectroscopy (MRS)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034918> rdfs:label "Reduced muscle 2,4-dienoyl-CoA reductase activity" ;
    dcterms:description "Diminished activity of the enzyme 2,4-dienoyl-CoA reductase in muscle tissue."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Muscle biopsy: 2,4-dienoyl-CoA reductase activity low"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Muscle biopsy: 2,4-dienoyl-CoA reductase activity low"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034919> rdfs:label "Reduced liver 2,4-dienoyl-CoA reductase activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diminished activity of the enzyme 2,4-dienoyl-CoA reductase in liver tissue." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034940> rdfs:label "Muscle fiber calsequestrin 1-containing inclusion bodies" ;
    dcterms:description "The presence of inclusion bodies within the cytoplasm of muscle cells that demonstrate immunoreactivity for calsequestrin 1." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034964> rdfs:label "Wide cavum septum pellucidum"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Width of the cavum septum pellucidum above the upper limit of normal, which is defined as a separation of greater than one cm of the leaves of the cavum septum pellucidum."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034976> rdfs:label "Absent pituitary stalk" ;
    dcterms:description "A developmental defect characterized by failure to develop of the pituitary stalk. The pituitary stalk, also known as the infundibulum or infundibular stalk, is the connection between the hypothalamus and the pituitary gland."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0034978> rdfs:label "Interrupted pituitary stalk"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A developmental defect characterized by a discontinuity of the pituitary stalk. The pituitary stalk, also known as the infundibulum or infundibular stalk, is the connection between the hypothalamus and the pituitary gland."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0035006> rdfs:label "Hepatic sinusoidal dilatation" ;
    dcterms:description "Presence of an increased amount of blood in the hepatic capillaries."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040013> rdfs:label "Decreased mitochondrial number"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022493" .

