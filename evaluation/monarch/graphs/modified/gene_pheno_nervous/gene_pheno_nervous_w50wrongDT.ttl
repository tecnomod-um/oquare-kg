    ns1:related_synonym "Lacunar retinal depigmentation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Lacunar retinal depigmentation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072866"^^<http://example.org/invalidDatatype>,
        "UMLS:C1844751" .

<http://purl.obolibrary.org/obo/HP_0007859> rdfs:label "Congenital horizontal nystagmus" ;
    dcterms:description "Horizontal nystagmus dating from or present at birth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nystagmus, congenital horizontal"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nystagmus, congenital horizontal" ;
    ns1:xref "UMLS:C1866180"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007872> rdfs:label "Choroidal hemangioma" ;
    dcterms:description "Benign choroidal tumour, seen in the fundus as a reddish or orange choroidal lesion and usually associated with cystoid edema, and less commonly with Subretinal fluid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3086"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:255022003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0346390" .

<http://purl.obolibrary.org/obo/HP_0007899> rdfs:label "Retinal nonattachment" ;
    dcterms:description "Failure of attachment of the retina during development." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Congenital retinal non-attachment"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Congenital retinal non-attachment" ;
    ns1:xref "UMLS:C4021563"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007922> rdfs:label "Hypermyelinated retinal nerve fibers" ;
    dcterms:description "Myelinated retinal nerve fiber (MRNF) layer is a rare and mostly benign congenital anomaly in which the retinal nerve fibers anterior to the lamina cribrosa have a myelin sheath."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypermyelinated retinal nerve fibres",
        "MRNF",
        "Retinal striation" ;
    ns1:synonym "Retinal striation"^^<http://example.org/invalidDatatype>,
        "Hypermyelinated retinal nerve fibres",
        "MRNF" ;
    ns1:xref "UMLS:C1849151" .

<http://purl.obolibrary.org/obo/HP_0007937> rdfs:label "Reticular pigmentary degeneration" ;
    dcterms:description "A pattern of peripheral netlike retinal pigmentation that forms a polygonal arrangement of hyperpigmented lines forming geometric patterns in the fundus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reticular degeneration of the RPE"^^<http://example.org/invalidDatatype>,
        "Fishnet retinal pigmentation",
        "Honeycomb retinal degeneration" ;
    ns1:synonym "Fishnet retinal pigmentation"^^<http://example.org/invalidDatatype>,
        "Honeycomb retinal degeneration",
        "Reticular degeneration of the RPE" ;
    ns1:xref "UMLS:C4024769"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007944> rdfs:label "Intermittent microsaccadic pursuits"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4024768"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007946> rdfs:label "Unilateral narrow palpebral fissure" ;
    dcterms:description "A fixed reduction in the vertical distance between the upper and lower eyelids with short palpebral fissures on one side only." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Narrow palpebral fissure, unilateral" ;
    ns1:related_synonym "Unequal size of opening between the eyelids" ;
    ns1:synonym "Unequal size of opening between the eyelids"^^<http://example.org/invalidDatatype>,
        "Narrow palpebral fissure, unilateral" ;
    ns1:xref "UMLS:C1866805"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280419" .

<http://purl.obolibrary.org/obo/HP_0007963> rdfs:label "Pattern dystrophy of the retina"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A spectrum of fundoscopic appearances characterized by the development of a variety of patterns of deposits predominantly in the macular area. The deposits are typically bilateral, relatively symmetrical, yellow/white and associated with changes at the level of the retinal pigment epithelium. With time, retinal atrophy may occur. A number of pattern dystrophy subtypes have been described including butterfly-shaped dystrophy, reticular dystrophy (net-like pattern) and fundus pulverulentus (granular, mottled pigmentation)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4024762" .

<http://purl.obolibrary.org/obo/HP_0007964> rdfs:label "Degenerative vitreoretinopathy" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1843486"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007976> rdfs:label "Cerulean cataract" ;
    dcterms:description "Cerulean cataracts are a kind of congenital cataract having peripheral bluish and white opacifications in concentric layers with occasional central lesions arranged radially. Although the opacities may be observed during fetal development and childhood, usually visual acuity is only mildly reduced until adulthood, when lens extraction is generally necessary." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cataracts, congenital, cerulean" ;
    ns1:synonym "Cataracts, congenital, cerulean" ;
    ns1:xref "UMLS:C0344523"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:204138006" .

<http://purl.obolibrary.org/obo/HP_0008049> rdfs:label "Abnormality of the extraocular muscles"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of an extraocular muscle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4024751"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0008050> rdfs:label "Abnormality of the palpebral fissures" ;
    dcterms:description "An anomaly of the space between the medial and lateral canthi of the two open eyelids."^^<http://example.org/invalidDatatype> ;
