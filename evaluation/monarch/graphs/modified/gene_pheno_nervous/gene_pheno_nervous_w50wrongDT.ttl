<http://purl.obolibrary.org/obo/HP_0011499> rdfs:label "Mydriasis" ;
    dcterms:description "Abnormal dilatation of the iris." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dilated pupil"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dilated pupil" ;
    ns1:xref "SNOMEDCT_US:37125009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0026961"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011712> rdfs:label "Complete right bundle branch block"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A conduction block of the right branch of the bundle of His. This manifests as a prolongation of the QRS complex (greater than 0.12 s) with delayed activation of the right ventricle and terminal delay on the EKG."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Right bundle branch block",
        "Right bundle-branch block" ;
    ns1:synonym "Right bundle-branch block"^^<http://example.org/invalidDatatype>,
        "Right bundle branch block" ;
    ns1:xref "UMLS:C0085615"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:59118001" .

<http://purl.obolibrary.org/obo/HP_0012104> rdfs:label "Parietal cortical atrophy" ;
    dcterms:description "Atrophy of the parietal cortex."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023041"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012169> rdfs:label "Self-biting"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Habitual biting of one's own body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:248072009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0424375" .

<http://purl.obolibrary.org/obo/HP_0012172> rdfs:label "Stereotypical body rocking" ;
    dcterms:description "Habitual repetitive movement of the entire body, front to back or side to side." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023013" .

<http://purl.obolibrary.org/obo/HP_0012231> rdfs:label "Serous retinal detachment" ;
    dcterms:description "A type of retinal detachment such that fluid is present in the subretinal space and separate the neurosensory retina from the retinal pigment epithelium. It is not associated with a full-thickness break nor a tractional component. Due to breakdown of outer blood-retina barrier or increased exudation from abnormal vasculature or defective outflow." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Exudative retinal detachment"^^<http://example.org/invalidDatatype>,
        "Non-rhegmatogenous retinal detachment" ;
    ns1:related_synonym "Exudative retinopathy" ;
    ns1:synonym "Exudative retinal detachment"^^<http://example.org/invalidDatatype>,
        "Non-rhegmatogenous retinal detachment"^^<http://example.org/invalidDatatype>,
        "Exudative retinopathy" ;
    ns1:xref "SNOMEDCT_US:38599001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0154822"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012506> rdfs:label "Small pituitary gland" ;
    dcterms:description "An abnormally decreased size of the pituitary gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022873"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012533> rdfs:label "Allodynia" ;
    dcterms:description "Pain due to a stimulus that does not normally provoke pain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0458247"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:247404004" .

<http://purl.obolibrary.org/obo/HP_0012759> rdfs:label "Neurodevelopmental abnormality" ;
    dcterms:description "A deviation from normal of the neurological development of a child, which may include any or all of the aspects of the development of personal, social, gross or fine motor, and cognitive abilities." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022737"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012810> rdfs:label "Wide nasal base"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased distance between the attachments of the alae nasi to the face."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased width of base of nose"^^<http://example.org/invalidDatatype>,
        "Increased width of nasal base"^^<http://example.org/invalidDatatype>,
        "Wide base of nose"^^<http://example.org/invalidDatatype>,
        "Wide nasal base"^^<http://example.org/invalidDatatype>,
        "Broad base of nose",
        "Broad nasal base" ;
    ns1:synonym "Broad nasal base"^^<http://example.org/invalidDatatype>,
        "Increased width of base of nose"^^<http://example.org/invalidDatatype>,
        "Wide base of nose"^^<http://example.org/invalidDatatype>,
        "Wide nasal base"^^<http://example.org/invalidDatatype>,
        "Broad base of nose",
        "Increased width of nasal base" ;
    ns1:xref "UMLS:C1849667"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012898> rdfs:label "Abnormal lower-limb motor evoked potentials" ;
    dcterms:description "An anomaly identified by motor evoked potentials (MEPs) in the leg."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal motor evoked potentials in the lower limb"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal motor evoked potentials in the lower limb"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021058" .

<http://purl.obolibrary.org/obo/HP_0020206> rdfs:label "Simple ear"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The pinna has fewer folds and grooves than usual."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025013> rdfs:label "Decerebrate rigidity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of rigidity that is manifested by an exaggerated extensor posture of all extremities." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decerebrate posturing" ;
    ns1:synonym "Decerebrate posturing"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025268> rdfs:label "Stuttering"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Disruptions in the production of speech sounds, with involuntary repetitions of words or parts of words, prolongations of speech sounds, or complete blockage of speech production for several seconds."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Stammering"^^<http://example.org/invalidDatatype>,
        "Stuttering" ;
    ns1:synonym "Stammering"^^<http://example.org/invalidDatatype>,
        "Stuttering"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025404> rdfs:label "Abnormal visual fixation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any anomaly in the process of ocular fixation, which is the maintaining of the visual gaze on a single location." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030200> rdfs:label "Fatiguable weakness of proximal limb muscles"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of weakness of a skeletal muscle of proximal part of a limb that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022583"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031108> rdfs:label "Triceps weakness" ;
    dcterms:description "A lack of strength in the triceps muscle, which normally is responsible for extending (straightening) the elbow and mediating certain shoulder movements."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031237> rdfs:label "Internally nucleated skeletal muscle fibers" ;
    dcterms:description "An abnormally increased proportion of nuclei of sarcomeres with an internal localization. Individual muscle fibers are syncytia, formed by embryonic fusion of many myoblasts or later, myosatellite cells. Each muscle fiber contains many nuclei, peripherally positioned immediately adjacent to the sarcolemmal membrane. In healthy muscle only 3-5% of fibers contain nuclei that are located internally, within the cell, but many disease processes lead to internal nuclei."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Internally nucleated skeletal muscle fibres"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Internally nucleated skeletal muscle fibres" .

<http://purl.obolibrary.org/obo/HP_0032152> rdfs:label "Keratosis pilaris"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of the hair follicles of the skin that typically presents as small, rough, brown folliculocentric papules distributed over characteristic areas of the skin, particularly the outer-upper arms and thighs." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Follicular keratosis"^^<http://example.org/invalidDatatype>,
        "Carpet tack sign",
        "Chicken skin",
        "Follicular keratotic plug",
        "Follicular plugging",
        "Hyperkeratosis pilaris",
        "Lichen pilaris" ;
    ns1:synonym "Carpet tack sign"^^<http://example.org/invalidDatatype>,
        "Follicular keratotic plug"^^<http://example.org/invalidDatatype>,
        "Follicular plugging"^^<http://example.org/invalidDatatype>,
        "Chicken skin",
        "Follicular keratosis",
        "Hyperkeratosis pilaris",
        "Lichen pilaris" .

<http://purl.obolibrary.org/obo/HP_0032660> rdfs:label "Convulsive status epilepticus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of status epilepticus characterized by a prolonged bilateral tonic-clonic seizure, or repeated bilateral tonic-clonic seizures without recovery between."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tonic-clonic status epilepticus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tonic-clonic status epilepticus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0033683> rdfs:label "Jaw hyperreflexia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased intensity of muscle tendon reflexes in jaw." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Brisk jaw jerk" ;
    ns1:synonym "Brisk jaw jerk"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040080> rdfs:label "Anteverted ears"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1857055"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100749> rdfs:label "Chest pain"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the chest."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chest pain",
        "Thoracic pain" ;
    ns1:related_synonym "Chest discomfort" ;
    ns1:synonym "Chest discomfort",
        "Chest pain",
        "Thoracic pain" ;
    ns1:xref "SNOMEDCT_US:29857009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0008031" .

<http://purl.obolibrary.org/obo/HP_0100852> rdfs:label "Abnormal fear-induced behavior" ;
    dcterms:description "An abnormal fear-induced behavior includes observable actions. This behavior is characterized by abnormal responses to fear or abnormal fear levels. Examples of such behavior include avoiding fear-inducing situations." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal fear-induced behavior"^^<http://example.org/invalidDatatype>,
        "Abnormal fear/anxiety-related behavior"^^<http://example.org/invalidDatatype>,
        "Abnormal fear/anxiety-related behaviour" ;
    ns1:synonym "Abnormal fear/anxiety-related behaviour"^^<http://example.org/invalidDatatype>,
        "Abnormal fear-induced behavior",
        "Abnormal fear/anxiety-related behavior" ;
