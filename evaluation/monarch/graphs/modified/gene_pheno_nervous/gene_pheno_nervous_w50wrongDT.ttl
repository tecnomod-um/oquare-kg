        "Maternal oligohydramnios" ;
    ns1:xref "UMLS:C0079924"^^<http://example.org/invalidDatatype>,
        "UMLS:C3550658"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:59566000" .

<http://purl.obolibrary.org/obo/HP_0002378> rdfs:label "Hand tremor" ;
    dcterms:description "An unintentional, oscillating to-and-fro muscle movement affecting the hand."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hand tremor"^^<http://example.org/invalidDatatype>,
        "Tremor of hand"^^<http://example.org/invalidDatatype>,
        "Tremor of hands"^^<http://example.org/invalidDatatype>,
