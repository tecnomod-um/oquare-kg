<http://purl.obolibrary.org/obo/HP_0002721> rdfs:label "Immunodeficiency"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Failure of the immune system to protect the body adequately from infection, due to the absence or insufficiency of some component process or substance." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased immune function"^^<http://example.org/invalidDatatype>,
