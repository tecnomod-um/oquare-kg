        "Increased width of menton region" ;
    ns1:xref "UMLS:C4023172"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011923> rdfs:label "Decreased activity of mitochondrial complex I" ;
    dcterms:description "A reduction in the activity of the mitochondrial respiratory chain complex I, which is part of the electron transport chain in mitochondria." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Respiratory complex I deficiency" ;
    ns1:synonym "Respiratory complex I deficiency" ;
