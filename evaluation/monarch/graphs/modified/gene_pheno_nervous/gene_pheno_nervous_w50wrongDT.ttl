<http://purl.obolibrary.org/obo/HP_0012166> rdfs:label "Skin-picking" ;
    dcterms:description "Repetitive and compulsive picking of skin which results in tissue damage."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dermatillomania"^^<http://example.org/invalidDatatype>,
        "Compulsive skin picking" ;
    ns1:synonym "Compulsive skin picking",
