        "Pulmonary carcinoid tumour" ;
    ns1:xref "UMLS:C0280089"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:254627002" .

<http://purl.obolibrary.org/obo/HP_0030446> rdfs:label "Atypical pulmonary carcinoid tumor" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Atypical pulmonary carcinoid tumour" ;
    ns1:synonym "Atypical pulmonary carcinoid tumour"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4072942"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030447> rdfs:label "Merkel cell skin cancer" ;
    dcterms:description "A malignant cutaneous tumor of the elderly that is characterized by an aggressive course with regional nodal involvement, distant metastases and a high rate of recurrence. Most patients present with rapidly growing, painless, firm, non-tender, dome-shaped red, occasionally ulcerated skin nodules, which have a red or bluish color, measuring up to several centimeters, on predominantly sun-exposed areas of the body. The overlying skin is smooth and shiny, sometimes exhibiting ulcerative, acneiform or telangiectatic features." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anaplastic carcinoma of the skin"^^<http://example.org/invalidDatatype>,
        "Cutaneous APUDoma"^^<http://example.org/invalidDatatype>,
        "Merkel cell cancer of the skin"^^<http://example.org/invalidDatatype>,
        "Neuroendocrine tumor of the skin"^^<http://example.org/invalidDatatype>,
        "Neuroendocrine tumour of the skin"^^<http://example.org/invalidDatatype>,
        "Primary small cell carcinoma of the skin"^^<http://example.org/invalidDatatype>,
        "Primary undifferentiated carcinoma of the skin"^^<http://example.org/invalidDatatype>,
        "Neuroendocrine carcinoma of the skin" ;
    ns1:synonym "Anaplastic carcinoma of the skin"^^<http://example.org/invalidDatatype>,
        "Cutaneous APUDoma"^^<http://example.org/invalidDatatype>,
        "Neuroendocrine carcinoma of the skin"^^<http://example.org/invalidDatatype>,
        "Neuroendocrine tumor of the skin"^^<http://example.org/invalidDatatype>,
        "Neuroendocrine tumour of the skin"^^<http://example.org/invalidDatatype>,
        "Primary small cell carcinoma of the skin"^^<http://example.org/invalidDatatype>,
        "Merkel cell cancer of the skin",
        "Primary undifferentiated carcinoma of the skin" ;
    ns1:xref "SNOMEDCT_US:5052009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0007129"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:253001006",
        "SNOMEDCT_US:254729005" .

<http://purl.obolibrary.org/obo/HP_0030448> rdfs:label "Soft tissue sarcoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of sarcoma (A connective tissue neoplasm formed by proliferation of mesodermal cells) that develops from soft tissues like fat, muscle, nerves, fibrous tissues, blood vessels, or deep skin tissues." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Soft tissue sarcomas"^^<http://example.org/invalidDatatype> ;
