        "UMLS:C1854114"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002421> rdfs:label "Poor head control" ;
    dcterms:description "Difficulty to maintain correct position of the head while standing or sitting. Infant head lag is observed when the head seems to flop around or lags posteriorly behind the trunk. Several articles have maintained that head lag should be absent by age 3 to 4 months."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Delay in head control"^^<http://example.org/invalidDatatype>,
        "Delay in head righting"^^<http://example.org/invalidDatatype>,
        "Infant head lag",
        "Poor head control" ;
    ns1:synonym "Delay in head righting"^^<http://example.org/invalidDatatype>,
        "Delay in head control",
        "Infant head lag",
        "Poor head control" ;
    ns1:xref "UMLS:C1836038" .

<http://purl.obolibrary.org/obo/HP_0004209> rdfs:label "Clinodactyly of the 5th finger" ;
    dcterms:description "Clinodactyly refers to a bending or curvature of the fifth finger in the radial direction (i.e., towards the 4th finger)."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Curvature of little finger"^^<http://example.org/invalidDatatype>,
        "Curvature of pinkie finger",
        "Curvature of pinky finger" ;
