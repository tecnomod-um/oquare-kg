    ns1:xref "UMLS:C1858036" .

<http://purl.obolibrary.org/obo/HP_0000641> rdfs:label "Dysmetric saccades" ;
    dcterms:description "The controller signal for saccadic eye movements has two components: the pulse that moves the eye rapidly from one point to the next, and the step that holds the eye in the new position. When both the pulse and the step are not the correct size, a dysmetric refixation eye movement results."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysmetric eye saccades"^^<http://example.org/invalidDatatype>,
        "Dysmetric eye movements",
        "Uncoordinated eye movement" ;
    ns1:synonym "Dysmetric eye movements"^^<http://example.org/invalidDatatype>,
        "Dysmetric eye saccades",
        "Uncoordinated eye movement" ;
    ns1:xref "UMLS:C1836392"^^<http://example.org/invalidDatatype> .

