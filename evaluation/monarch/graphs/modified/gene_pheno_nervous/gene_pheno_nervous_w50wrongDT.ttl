        "UMLS:C4280576"^^<http://example.org/invalidDatatype>,
        "UMLS:C1411876" .

<http://purl.obolibrary.org/obo/HP_0002454> rdfs:label "Eye of the tiger anomaly of globus pallidus" ;
    dcterms:description "The presence, on T2-weighted magnetic resonance imaging, of markedly low signal intensity of the globus pallidus that surrounds a central region of high signal intensity in the anteromedial globus pallidus, producing an eye-of-the-tiger appearance. The sign is thought to represent iron accumulation in the globus pallidus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4025705"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002616> rdfs:label "Aortic root aneurysm"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal localized widening (dilatation) of the aortic root."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Aortic root dilatation"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Enlarged aortic root"^^<http://example.org/invalidDatatype>,
        "Bulge in wall of root of large artery that carries blood away from heart",
        "Increased aortic root diameter" ;
    ns1:synonym "Enlarged aortic root"^^<http://example.org/invalidDatatype>,
        "Increased aortic root diameter"^^<http://example.org/invalidDatatype>,
        "Aortic root dilatation",
        "Bulge in wall of root of large artery that carries blood away from heart" ;
    ns1:xref "SNOMEDCT_US:251036003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0238669" .

<http://purl.obolibrary.org/obo/HP_0002793> rdfs:label "Abnormal pattern of respiration" ;
    dcterms:description "An anomaly of the rhythm or depth of breathing."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal pattern of respiration",
        "Abnormal respiratory patterns",
        "Unusual breathing patterns" ;
    ns1:synonym "Abnormal pattern of respiration"^^<http://example.org/invalidDatatype>,
        "Abnormal respiratory patterns"^^<http://example.org/invalidDatatype>,
        "Unusual breathing patterns"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1837388" .

<http://purl.obolibrary.org/obo/HP_0002877> rdfs:label "Nocturnal hypoventilation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal reduction in alveolar ventilation occurring during sleep. This is characterized by a rise in arterial carbon dioxide."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nocturnal hypopnea"^^<http://example.org/invalidDatatype>,
        "Nocturnal slow breathing"^^<http://example.org/invalidDatatype>,
        "Nocturnal under breathing"^^<http://example.org/invalidDatatype>,
        "Hypoventilation during sleep" ;
    ns1:synonym "Hypoventilation during sleep"^^<http://example.org/invalidDatatype>,
        "Nocturnal hypopnea",
        "Nocturnal slow breathing",
        "Nocturnal under breathing" ;
    ns1:xref "UMLS:C1843643"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002937> rdfs:label "Hemivertebrae"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of one half of the vertebral body." ;
