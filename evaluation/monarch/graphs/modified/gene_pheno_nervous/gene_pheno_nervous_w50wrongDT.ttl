        "Alanine aminotransferase increased",
        "Elevated serum alanine aminotransferase" .

<http://purl.obolibrary.org/obo/HP_0032388> rdfs:label "Periventricular nodular heterotopia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Nodules of heterotopia along the ventricular walls. There can be a single nodule or a large number of nodules, they can exist on either or both sides of the brain at any point along the higher ventricle margins, they can be small or large, single or multiple." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0100033> rdfs:label "Tics"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Repeated, individually recognizable, intermittent movements or movement fragments that are almost always briefly suppressible and are usually associated with awareness of an urge to perform the movement." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tic disorder"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tic disorder"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C2169806" .

<http://purl.obolibrary.org/obo/HP_0100259> rdfs:label "Postaxial polydactyly" ;
    dcterms:description "A form of polydactyly in which the extra digit or digits are localized on the side of the fifth finger or fifth toe." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Polydactyly, postaxial"^^<http://example.org/invalidDatatype>,
        "Postaxial hexadactyly" ;
    ns1:synonym "Polydactyly, postaxial"^^<http://example.org/invalidDatatype>,
        "Postaxial hexadactyly"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0220697"^^<http://example.org/invalidDatatype> .

