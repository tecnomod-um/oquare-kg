<http://purl.obolibrary.org/obo/HP_0000160> rdfs:label "Narrow mouth"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Distance between the commissures of the mouth more than 2 SD below the mean. Alternatively, an apparently decreased width of the oral aperture (subjective)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Small oral aperture"^^<http://example.org/invalidDatatype>,
