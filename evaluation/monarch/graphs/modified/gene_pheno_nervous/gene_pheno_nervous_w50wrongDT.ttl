<http://purl.obolibrary.org/obo/HP_0001059> rdfs:label "Pterygium"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pterygia are 'winglike' triangular membranes occurring in the neck, eyes, knees, elbows, ankles or digits."^^<http://example.org/invalidDatatype> ;
