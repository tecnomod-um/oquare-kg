        "Congenital obstructing posterior urethral membranes",
        "Posterior urethral valve",
        "Posterior urethral valves" ;
    ns1:xref "UMLS:C0238506"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:253900005" .

<http://purl.obolibrary.org/obo/HP_0010958> rdfs:label "Bilateral renal agenesis" ;
