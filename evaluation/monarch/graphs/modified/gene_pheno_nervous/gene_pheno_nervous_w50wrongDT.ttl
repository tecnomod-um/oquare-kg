        "Cleft of upper lip",
        "Harelip" ;
    ns1:xref "SNOMEDCT_US:80281008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0008924"^^<http://example.org/invalidDatatype>,
        "Fyler:4875" .

<http://purl.obolibrary.org/obo/HP_0000336> rdfs:label "Prominent supraorbital ridges" ;
    dcterms:description "Greater than average forward and/or lateral protrusion of the supraorbital portion of the frontal bones."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Prominent brow"^^<http://example.org/invalidDatatype>,
        "Prominent supraorbital ridge"^^<http://example.org/invalidDatatype>,
        "Prominent supraorbital margins",
        "Protruding supraorbital ridge",
