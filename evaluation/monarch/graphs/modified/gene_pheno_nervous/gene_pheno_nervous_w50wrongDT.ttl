        "UMLS:C0030779"^^<http://example.org/invalidDatatype>,
        "UMLS:C4023351" .

<http://purl.obolibrary.org/obo/HP_0011467> rdfs:label "Absent gallbladder"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A developmental defect in which the gallbladder fails to form." ;
