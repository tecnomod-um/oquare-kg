    ns1:synonym "Narrowing of a cerebral artery" ;
    ns1:xref "UMLS:C1504438"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012493> rdfs:label "Middle cerebral artery stenosis" ;
    dcterms:description "Narrowing or constriction of the inner surface (lumen) of the middle cerebral artery." ;
    ns1:category ns1:PhenotypicFeature ;
