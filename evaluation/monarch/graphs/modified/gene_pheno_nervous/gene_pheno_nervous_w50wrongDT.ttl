    ns1:xref "UMLS:C1839666" .

<http://purl.obolibrary.org/obo/HP_0003774> rdfs:label "Stage 5 chronic kidney disease" ;
    dcterms:description "A degree of kidney failure severe enough to require dialysis or kidney transplantation for survival characterized by a severe reduction in glomerular filtration rate (less than 15 ml/min/1.73 m2) and other manifestations including increased serum creatinine." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "End stage renal disease"^^<http://example.org/invalidDatatype>,
        "End-stage renal disease"^^<http://example.org/invalidDatatype>,
        "End-stage renal failure"^^<http://example.org/invalidDatatype>,
        "Chronic renal failure",
        "End stage renal failure",
        "Stage 5 chronic kidney disease" ;
    ns1:related_synonym "Renal failure, endstage" ;
    ns1:synonym "End stage renal disease"^^<http://example.org/invalidDatatype>,
        "End stage renal failure"^^<http://example.org/invalidDatatype>,
        "End-stage renal disease"^^<http://example.org/invalidDatatype>,
        "End-stage renal failure"^^<http://example.org/invalidDatatype>,
        "Renal failure, endstage"^^<http://example.org/invalidDatatype>,
        "Chronic renal failure",
        "Stage 5 chronic kidney disease" ;
    ns1:xref "SNOMEDCT_US:433146000"^^<http://example.org/invalidDatatype>,
        "UMLS:C2316810"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0005968> rdfs:label "Temperature instability" ;
    dcterms:description "Disordered thermoregulation characterized by an impaired ability to maintain a balance between heat production and heat loss, with resulting instability of body temperature."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Temperature instability"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Body temperature instability" ;
    ns1:synonym "Temperature instability"^^<http://example.org/invalidDatatype>,
        "Body temperature instability" ;
    ns1:xref "UMLS:C1820737"^^<http://example.org/invalidDatatype>,
        "UMLS:C3279038"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0006844> rdfs:label "Absent patellar reflexes" ;
    dcterms:description "Absence of the knee jerk reflex, which can normally be elicited by tapping the patellar tendon with a reflex hammer just below the patella." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent knee jerk reflex" ;
    ns1:synonym "Absent knee jerk reflex" ;
    ns1:xref "UMLS:C0558844"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:274817009" .

<http://purl.obolibrary.org/obo/HP_0006938> rdfs:label "Impaired vibration sensation at ankles"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A decrease in the ability to perceive vibration at the ankles. Clinically, this is usually tested with a tuning fork which vibrates at 128 Hz and is applied to the malleoli of the ankles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased vibration sense at ankles"^^<http://example.org/invalidDatatype>,
        "Decreased vibration sense in feet",
        "Impaired vibration sensation at ankles" ;
    ns1:synonym "Decreased vibration sense at ankles",
        "Decreased vibration sense in feet",
        "Impaired vibration sensation at ankles" ;
    ns1:xref "UMLS:C1854372" .

<http://purl.obolibrary.org/obo/HP_0006958> rdfs:label "Abnormal auditory evoked potentials"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the auditory evoked potentials, which are used to trace the signal generated by a sound, from the cochlear nerve, through the lateral lemniscus, to the medial geniculate nucleus, and to the cortex."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal brainstem auditory-evoked potentials" ;
    ns1:synonym "Abnormal brainstem auditory-evoked potentials" ;
    ns1:xref "SNOMEDCT_US:102971006",
        "UMLS:C0522216" .

<http://purl.obolibrary.org/obo/HP_0007074> rdfs:label "Thick corpus callosum" ;
    dcterms:description "Increased vertical dimension of the corpus callosum. This feature can be visualized by sagittal sections on magnetic resonance tomography imaging of the brain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal size of corpus callosum",
        "Large corpus callosum" ;
    ns1:synonym "Abnormal size of corpus callosum"^^<http://example.org/invalidDatatype>,
        "Large corpus callosum" ;
    ns1:xref "UMLS:C1835194" .

<http://purl.obolibrary.org/obo/HP_0007165> rdfs:label "Periventricular heterotopia" ;
    dcterms:description "A form of gray matter heterotopia were the mislocalized gray matter is typically located periventricularly, also sometimes called subependymal heterotopia. Periventricular means beside the ventricles. This is by far the most common location for heterotopia. Subependymal heterotopia present in a wide array of variations. There can be a small single node or a large number of nodes, can exist on either or both sides of the brain at any point along the higher ventricle margins, can be small or large, single or multiple, and can form a small node or a large wavy or curved mass."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Periventricular gray matter heterotopia"^^<http://example.org/invalidDatatype>,
        "Periventricular neuronal heterotopia"^^<http://example.org/invalidDatatype>,
        "Subependymal grey matter heterotopia"^^<http://example.org/invalidDatatype>,
        "Periventricular grey matter heterotopia",
        "Subependymal gray matter heterotopia",
        "Subependymal neuronal heterotopia" ;
    ns1:synonym "Periventricular gray matter heterotopia"^^<http://example.org/invalidDatatype>,
        "Periventricular neuronal heterotopia"^^<http://example.org/invalidDatatype>,
        "Subependymal grey matter heterotopia"^^<http://example.org/invalidDatatype>,
        "Periventricular grey matter heterotopia",
        "Subependymal gray matter heterotopia",
        "Subependymal neuronal heterotopia" ;
    ns1:xref "UMLS:C1849173"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007166> rdfs:label "Paroxysmal dyskinesia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Episodic bouts of involuntary movements with dystonic, choreic, ballistic movements, or a combination thereof. There is no loss of consciousness during the attacks."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Involuntary dystonic or choreiform movements" ;
    ns1:synonym "Involuntary dystonic or choreiform movements" ;
    ns1:xref "UMLS:C0752210",
        "UMLS:C1836174" .

<http://purl.obolibrary.org/obo/HP_0007260> rdfs:label "Type II lissencephaly" ;
    dcterms:description "A form of lissencephaly characterized by an uneven cortical surface with a so called 'cobblestone' appearace. There are no distinguishable cortical layers." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Lissencephaly type II"^^<http://example.org/invalidDatatype>,
        "Cobblestone lissencephaly",
        "Type 2 lissencephaly" ;
    ns1:synonym "Lissencephaly type II"^^<http://example.org/invalidDatatype>,
        "Type 2 lissencephaly"^^<http://example.org/invalidDatatype>,
        "Cobblestone lissencephaly" ;
    ns1:xref "SNOMEDCT_US:253149002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0431376"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007973> rdfs:label "Retinal dysplasia" ;
    dcterms:description "Abnormal growth and differentiation, structure and appearance of the retina present from birth."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysplasia/hypoplasia of the retina",
        "Retinal dysgenesis" ;
    ns1:narrow_synonym "Retinal hypoplasia" ;
    ns1:synonym "Retinal dysgenesis"^^<http://example.org/invalidDatatype>,
        "Retinal hypoplasia"^^<http://example.org/invalidDatatype>,
        "Dysplasia/hypoplasia of the retina" ;
    ns1:xref "SNOMEDCT_US:95494009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0035313"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0007979> rdfs:label "Gaze-evoked horizontal nystagmus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Horizontal nystagmus made apparent by looking to the right or to the left."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nystagmus, horizontal, gaze-evoked" ;
    ns1:related_synonym "Nystagmus, horizontal gaze-evoked"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nystagmus, horizontal gaze-evoked",
        "Nystagmus, horizontal, gaze-evoked" ;
    ns1:xref "UMLS:C1853394" .

<http://purl.obolibrary.org/obo/HP_0009088> rdfs:label "Speech articulation difficulties" ;
    dcterms:description "Impairment in the physical production of speech sounds." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1865313"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010845> rdfs:label "EEG with generalized slow activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diffuse slowing of cerebral electrical activity recorded along the scalp by electroencephalography (EEG)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EEG with generalised slow activity"^^<http://example.org/invalidDatatype>,
        "EEG: generalised slow activity"^^<http://example.org/invalidDatatype>,
        "EEG: generalized slow activity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "EEG: generalised slow activity"^^<http://example.org/invalidDatatype>,
        "EEG: generalized slow activity"^^<http://example.org/invalidDatatype>,
        "EEG with generalised slow activity" ;
    ns1:xref "UMLS:C4021217"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011167> rdfs:label "Focal tonic seizure" ;
    dcterms:description "A type of focal motor seizure characterized by sustained increase in muscle contraction, lasting a few seconds to minutes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal tonic seizures"^^<http://example.org/invalidDatatype>,
        "Local tonic seizures"^^<http://example.org/invalidDatatype>,
        "Localised tonic seizure"^^<http://example.org/invalidDatatype>,
        "Localized tonic seizure"^^<http://example.org/invalidDatatype>,
        "Partial tonic seizures"^^<http://example.org/invalidDatatype>,
        "Segmental tonic seizure"^^<http://example.org/invalidDatatype>,
        "Partial tonic seizure" ;
    ns1:synonym "Localised tonic seizure"^^<http://example.org/invalidDatatype>,
        "Localized tonic seizure"^^<http://example.org/invalidDatatype>,
        "Partial tonic seizure"^^<http://example.org/invalidDatatype>,
        "Focal tonic seizures",
        "Local tonic seizures",
        "Partial tonic seizures",
        "Segmental tonic seizure" ;
    ns1:xref "UMLS:C0752324" .

<http://purl.obolibrary.org/obo/HP_0011228> rdfs:label "Horizontal eyebrow"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An eyebrow that extends straight across the brow, without curve." ;
    ns1:broad_synonym "Lack of eyebrow arch"^^<http://example.org/invalidDatatype>,
        "Lack of eyebrow curvature" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flat eyebrow"^^<http://example.org/invalidDatatype>,
        "Horizontal eyebrow"^^<http://example.org/invalidDatatype>,
        "Straight eyebrow" ;
    ns1:related_synonym "Straight eyebrows"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Flat eyebrow"^^<http://example.org/invalidDatatype>,
        "Horizontal eyebrow"^^<http://example.org/invalidDatatype>,
        "Lack of eyebrow arch"^^<http://example.org/invalidDatatype>,
        "Lack of eyebrow curvature"^^<http://example.org/invalidDatatype>,
        "Straight eyebrow"^^<http://example.org/invalidDatatype>,
        "Straight eyebrows" ;
    ns1:xref "UMLS:C3277019" .

<http://purl.obolibrary.org/obo/HP_0012049> rdfs:label "Laryngeal dystonia" ;
    dcterms:description "A form of focal dystonia that affects the vocal cords, associated with involuntary contractions of the vocal cords causing interruptions of speech and affecting the voice quality and often leading to patterned, repeated breaks in speech."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Spasmodic dysphonia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Spasmodic dysphonia" ;
    ns1:xref "SNOMEDCT_US:3331000119108"^^<http://example.org/invalidDatatype>,
        "UMLS:C1963946" .

<http://purl.obolibrary.org/obo/HP_0012179> rdfs:label "Craniofacial dystonia" ;
    dcterms:description "A form of focal dystonia affecting the face and especially the jaw that is induced by the act of speaking. It is an involuntary contraction of the masticatory muscles, resulting in dysarthria or dysphagia."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Distorted craniofacial posture"^^<http://example.org/invalidDatatype>,
        "Abnormal craniofacial posture" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal craniofacial muscle tone"^^<http://example.org/invalidDatatype> ;
    ns1:narrow_synonym "Abnormal facial muscle tone",
        "Facial Dystonia" ;
    ns1:synonym "Abnormal craniofacial posture"^^<http://example.org/invalidDatatype>,
        "Facial Dystonia"^^<http://example.org/invalidDatatype>,
        "Abnormal craniofacial muscle tone",
        "Abnormal facial muscle tone",
        "Distorted craniofacial posture" ;
    ns1:xref "UMLS:C1851915"^^<http://example.org/invalidDatatype>,
        "UMLS:C4072883"^^<http://example.org/invalidDatatype>,
        "UMLS:C4023011" .

<http://purl.obolibrary.org/obo/HP_0012443> rdfs:label "Abnormal brain morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A structural abnormality of the brain, which has as its parts the forebrain, midbrain, and hindbrain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal shape of brain"^^<http://example.org/invalidDatatype>,
        "Abnormality of brain morphology"^^<http://example.org/invalidDatatype>,
        "Abnormality of the brain" ;
    ns1:synonym "Abnormal shape of brain"^^<http://example.org/invalidDatatype>,
        "Abnormality of brain morphology"^^<http://example.org/invalidDatatype>,
        "Abnormality of the brain"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021085" .

<http://purl.obolibrary.org/obo/HP_0012520> rdfs:label "Dilation of Virchow-Robin spaces"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased dimensions of the Virchow-Robin spaces (also known as perivascular spaces), which surround the walls of vessels as they course from the subarachnoid space through the brain parenchyma. Perivascular spaces are commonly microscopic, and not visible on conventional neuroimaging. This term refers to an increase of size of these spaces such that they are visible on neuroimaging (usually magnetic resonance imaging). The dilatations are regular cavities that always contain a patent artery." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dilated Virchow-Robin spaces"^^<http://example.org/invalidDatatype>,
        "Perivascular spaces"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Dilated cerebral perivascular spaces"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dilated Virchow-Robin spaces"^^<http://example.org/invalidDatatype>,
        "Dilated cerebral perivascular spaces"^^<http://example.org/invalidDatatype>,
        "Perivascular spaces" ;
    ns1:xref "UMLS:C1853618"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020719"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012696> rdfs:label "Abnormal thalamic MRI signal intensity" ;
    dcterms:description "A deviation from normal signal on magnetic resonance imaging (MRI) of the thalamus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022770"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012762> rdfs:label "Cerebral white matter atrophy" ;
    dcterms:description "The presence of atrophy (wasting) of the cerebral white matter." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022735"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025331> rdfs:label "Upgaze palsy" ;
    dcterms:description "A limitation of the ability to direct one's gaze above the horizontal meridian."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Supranuclear upgaze palsy",
        "Upgaze paresis" ;
    ns1:synonym "Supranuclear upgaze palsy"^^<http://example.org/invalidDatatype>,
        "Upgaze paresis" .

<http://purl.obolibrary.org/obo/HP_0025435> rdfs:label "Increased circulating lactate dehydrogenase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevated level of the enzyme lactate dehydrogenase in the blood circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased lactate dehydrogenase level"^^<http://example.org/invalidDatatype>,
        "Increased circulating LDH concentration" ;
    ns1:synonym "Increased circulating LDH concentration"^^<http://example.org/invalidDatatype>,
        "Increased lactate dehydrogenase level" .

<http://purl.obolibrary.org/obo/HP_0000077> rdfs:label "Abnormality of the kidney"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the kidney." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal kidney"^^<http://example.org/invalidDatatype>,
        "Renal anomalies"^^<http://example.org/invalidDatatype>,
        "Renal anomaly"^^<http://example.org/invalidDatatype>,
