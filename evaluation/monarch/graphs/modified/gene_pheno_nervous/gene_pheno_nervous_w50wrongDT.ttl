    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Enlarged liver" ;
    ns1:synonym "Enlarged liver"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:80515008",
