    ns1:xref "UMLS:C3161330"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:31216003",
        "UMLS:C0020796" .

<http://purl.obolibrary.org/obo/HP_0002240> rdfs:label "Hepatomegaly" ;
