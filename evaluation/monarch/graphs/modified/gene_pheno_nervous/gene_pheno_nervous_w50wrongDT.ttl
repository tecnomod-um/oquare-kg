<http://purl.obolibrary.org/obo/HP_0002324> rdfs:label "Hydranencephaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A defect of development of the brain characterized by replacement of greater portions of the cerebral hemispheres and the corpus striatum by cerebrospinal fluid (CSF) and glial tissue."^^<http://example.org/invalidDatatype> ;
