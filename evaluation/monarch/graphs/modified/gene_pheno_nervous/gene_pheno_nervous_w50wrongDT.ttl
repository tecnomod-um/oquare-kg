<http://purl.obolibrary.org/obo/MONDO_0958094> rdfs:label "adult-onset progressive leukoencephalopathy-early-onset deafness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare genetic neurological disorder characterized by congenital or early-onset sensorineural deafness and adult-onset progressive leukoencephalopathy. Progressive cognitive impairment and behavioral abnormalities are observed in the second or third decade of life, sometimes preceded by mild developmental delay and learning difficulties. Visual impairment in adult age has been reported. No central nervous system calcification is reported."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:xref "Orphanet:652532"^^<http://example.org/invalidDatatype>,
        "GARD:0026925",
        "MEDGEN:1859137",
        "UMLS:C5921954" .

