        "Abnormality of the cerebral blood vessels" ;
    ns1:xref "UMLS:C4022001"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0100661> rdfs:label "Trigeminal neuralgia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A neuropathic disorder characterized by episodes of intense pain in the face, originating from the trigeminal nerve. One, two, or all three branches of the nerve may be affected." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tic douloureux" ;
    ns1:synonym "Tic douloureux" ;
    ns1:xref "UMLS:C0040997"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:31681005" .

<http://purl.obolibrary.org/obo/HP_0100829> rdfs:label "Galactorrhea" ;
    dcterms:description "Spontaneous flow of milk from the breast, unassociated with childbirth or nursing." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Galactorrhoea"^^<http://example.org/invalidDatatype>,
