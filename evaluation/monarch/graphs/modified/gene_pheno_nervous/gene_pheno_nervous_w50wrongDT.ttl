<http://purl.obolibrary.org/obo/HP_0030018> rdfs:label "Decreased female libido"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diminished sexual desire in female."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased female sex drive"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased female sex drive"^^<http://example.org/invalidDatatype> ;
