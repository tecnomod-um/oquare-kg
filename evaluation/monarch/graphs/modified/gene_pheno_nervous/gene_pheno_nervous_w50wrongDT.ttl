        "Hypoplastic tragus",
        "Hypotrophic tragus" ;
    ns1:xref "UMLS:C4013429"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011289> rdfs:label "EEG with temporal sharp slow waves" ;
    dcterms:description "EEG with sharp slow waves in the temporal region. Sharp slow waves are focal sharp transient waves of a duration between 80 and 200 msec followed by a slow wave." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023427"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011308> rdfs:label "Slender toe" ;
    dcterms:description "Toes that are disproportionately narrow (reduced girth) for the hand/foot size or build of the individual."^^<http://example.org/invalidDatatype> ;
