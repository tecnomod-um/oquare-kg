<http://purl.obolibrary.org/obo/HP_0009073> rdfs:label "Progressive proximal muscle weakness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Lack of strength of the proximal muscles that becomes progressively more severe."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Muscle weakness, progressive, proximal"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Muscle weakness, progressive, proximal" ;
    ns1:xref "UMLS:C1836156" .

<http://purl.obolibrary.org/obo/HP_0010546> rdfs:label "Muscle fibrillation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fine, rapid twitching of individual muscle fibers with little or no movement of the muscle as a whole as ascertained by electromyography (EMG). If a motor neuron or its axon is destroyed, the muscle fibers it innervates undergo denervation atrophy. This leads to hypersensitivity of individual muscle fibers to acetyl choline so that they may contract spontaneously. Isolated activity of individual muscle fibers is generally so fine it cannot be seen through the intact skin, although it can be recorded as a short-duration spike in the EMG." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EMG: fibrillations on electromyogram"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Twitching" ;
    ns1:synonym "EMG: fibrillations on electromyogram",
        "Twitching" ;
    ns1:xref "SNOMEDCT_US:41405005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0231531" .

<http://purl.obolibrary.org/obo/HP_0010794> rdfs:label "Impaired visuospatial constructive cognition"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced ability affecting mainly visuospatial cognition which may be tested using pattern construction (for example by Differential Ability Scales, which test a person's strengths and weaknesses across a range of intellectual abilities)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023701"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010880> rdfs:label "Increased nuchal translucency"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Nuchal translucency is the sonographic appearance of subcutaneous accumulation of liquid in the back of the fetal neck in the first trimester of pregnancy (11-14 gestational weeks of pregnancy)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023676" .

<http://purl.obolibrary.org/obo/HP_0011504> rdfs:label "Bull's eye maculopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Progressive maculopathy characterized by concentric regions of hyper- and hypopigmentation, with an initial foveal sparing and whose appearance is said to resemble the central target of a dart board."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0012452> rdfs:label "Restless legs"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An irresistible urge to move the legs, usually accompanied by unpleasant sensations deep within the limbs. Symptoms typically begin or worsen during periods of rest or inactivity, are most pronounced in the evening or at night, and are temporarily relieved by movement such as walking or stretching. The disturbance often interferes with the initiation or maintenance of sleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Restless legs syndrome"^^<http://example.org/invalidDatatype>,
        "Tachyathetosis"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Ekbom syndrome"^^<http://example.org/invalidDatatype>,
        "Willis-Ekbom disease"^^<http://example.org/invalidDatatype>,
        "Wittmaack-Ekbom syndrome" ;
    ns1:synonym "Ekbom syndrome"^^<http://example.org/invalidDatatype>,
        "Restless legs syndrome"^^<http://example.org/invalidDatatype>,
        "Willis-Ekbom disease"^^<http://example.org/invalidDatatype>,
        "Tachyathetosis",
        "Wittmaack-Ekbom syndrome" ;
    ns1:xref "UMLS:C0035258"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:32914008" .

<http://purl.obolibrary.org/obo/HP_0012510> rdfs:label "Extra-axial cerebrospinal fluid accumulation" ;
    dcterms:description "An increased amount of cerebrospinal fluid (CSF) in the subarachnoid space."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
