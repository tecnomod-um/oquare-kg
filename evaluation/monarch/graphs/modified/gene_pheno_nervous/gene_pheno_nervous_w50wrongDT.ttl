<http://purl.obolibrary.org/obo/MONDO_0007667> rdfs:label "subependymoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Subependymoma is a rare and slow growing type of ependymoma, often presenting in middle-aged adults, found more commonly in men than in women, usually located in the fourth and lateral ventricles and manifesting with variable symptoms including headache, nausea, and loss of balance. In some cases it can be asymptomatic. It is usually associated with a better prognosis than other forms of ependymoma." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "WHO grade I ependymal tumor"^^<http://example.org/invalidDatatype>,
