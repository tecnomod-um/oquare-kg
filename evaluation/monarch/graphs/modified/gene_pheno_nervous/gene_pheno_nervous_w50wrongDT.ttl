<http://purl.obolibrary.org/obo/HP_0009909> rdfs:label "Uplifted earlobe" ;
    dcterms:description "An abnormal orientation of the earlobes such that they point out- and upward. That is, the lateral surface of ear lobe faces superiorly." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fleshy upturned lobules"^^<http://example.org/invalidDatatype>,
