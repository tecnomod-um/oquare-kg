    ns1:synonym "Clubbing of fingers and toes"^^<http://example.org/invalidDatatype>,
        "Digital clubbing"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:367004",
        "UMLS:C0149651" .

<http://purl.obolibrary.org/obo/HP_0001311> rdfs:label "Abnormal nervous system electrophysiology" ;
    dcterms:description "An abnormality of the function of the electrical signals with which nerve cells communicate with each other or with muscles as measured by electrophysiological investigations." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neurophysiologic abnormalities",
