        "Twitching of facial muscles"^^<http://example.org/invalidDatatype>,
        "Jerking of facial muscles",
        "Muscle spasm of face",
        "Spasms of facial muscles" ;
    ns1:xref "UMLS:C0338467"^^<http://example.org/invalidDatatype>,
        "UMLS:C0858722"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280325"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:230335009",
        "SNOMEDCT_US:32402008",
        "UMLS:C0278151",
        "UMLS:C4280324" .

<http://purl.obolibrary.org/obo/HP_0011476> rdfs:label "Profound sensorineural hearing impairment" ;
    dcterms:description "Complete loss of hearing related to a sensorineural defect." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023338" .

<http://purl.obolibrary.org/obo/HP_0011510> rdfs:label "Drusen" ;
    dcterms:description "Drusen (singular, 'druse') are tiny yellow or white accumulations of extracellular material (lipofuscin) that build up in the Bruch membrane of the eye." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:18695008"^^<http://example.org/invalidDatatype>,
        "UMLS:C1260959"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011530> rdfs:label "Retinal hole" ;
    dcterms:description "A full-thickness defect in the retina." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal holes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Retinal holes"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:232003005"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:302888003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:40024006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0035321"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:95690009" .

<http://purl.obolibrary.org/obo/HP_0011727> rdfs:label "Peroneal muscle weakness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Weakness of the peroneal muscles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fibularis muscle weakness"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Fibularis muscle weakness" ;
    ns1:xref "UMLS:C0240733"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011735> rdfs:label "Adrenocorticotropin deficient adrenal insufficiency"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Adrenal insufficiency secondary to a defect in ACTH production." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "ACTH deficient adrenal insufficiency" ;
    ns1:synonym "ACTH deficient adrenal insufficiency"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023211"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011834> rdfs:label "Moyamoya phenomenon" ;
    dcterms:description "A noninflammatory, progressive occlusion of the intracranial carotid arteries owing to the formation of netlike collateral arteries arising from the circle of Willis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023169"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011856> rdfs:label "Pica" ;
    dcterms:description "An appetite for and the persistent ingestion of non-food substances such as clay. In order to diagnose pica, this behavior must have persisted over a period of at least one month."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:14077003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0031873"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011960> rdfs:label "Substantia nigra gliosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Focal proliferation of glial cells in the substantia nigra."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1846865" .

<http://purl.obolibrary.org/obo/HP_0011972> rdfs:label "Hypoglycorrhachia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally low glucose concentration in the cerebrospinal fluid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased CSF glucose",
        "Low glucose levels in cerebral spinal fluid" ;
    ns1:synonym "Low glucose levels in cerebral spinal fluid"^^<http://example.org/invalidDatatype>,
        "Decreased CSF glucose" ;
    ns1:xref "UMLS:C0598121"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012001> rdfs:label "EEG with generalized polyspikes" ;
    dcterms:description "EEG with repetitive generalized sharp transient waves of a duration less than 80 msec."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "EEG with generalised polyspikes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "EEG with generalised polyspikes"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023088" .

<http://purl.obolibrary.org/obo/HP_0012047> rdfs:label "Hemeralopia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A visual defect characterized by the inability to see as clearly in bright light as in dim light. The word hemeralopia literally means day blindness." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Day blindness" ;
    ns1:synonym "Day blindness" ;
    ns1:xref "SNOMEDCT_US:399323001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0018975" .

<http://purl.obolibrary.org/obo/HP_0012393> rdfs:label "Allergy" ;
    dcterms:description "An allergy is an immune response or reaction to substances that are usually not harmful."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Allergy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Allergy"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1527304"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:419076005" .

<http://purl.obolibrary.org/obo/HP_0012426> rdfs:label "Optic disc drusen"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Optic disc drusen are acellular, calcified deposits within the optic nerve head. Optic disc drusen are congenital and developmental anomalies of the optic nerve head, representing hyaline-containing bodies that, over time, appear as elevated, lumpy irregularities on the anterior portion of the optic nerve." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Optic nerve head drusen"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Optic nerve head drusen"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0029128"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:33629003" .

<http://purl.obolibrary.org/obo/HP_0012503> rdfs:label "Abnormal pituitary gland morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of the pituitary gland." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the pituitary gland",
        "disorder of pituitary gland" ;
    ns1:synonym "Abnormality of the pituitary gland"^^<http://example.org/invalidDatatype>,
        "disorder of pituitary gland"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:399244003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0032002" .

<http://purl.obolibrary.org/obo/HP_0012622> rdfs:label "Chronic kidney disease" ;
    dcterms:description "Functional anomaly of the kidney persisting for at least three months."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic kidney disease"^^<http://example.org/invalidDatatype>,
        "CKD" ;
    ns1:related_synonym "Loss of renal function"^^<http://example.org/invalidDatatype>,
        "Progressive renal failure"^^<http://example.org/invalidDatatype>,
        "Progressive renal insufficiency"^^<http://example.org/invalidDatatype>,
        "Renal insufficiency, progressive"^^<http://example.org/invalidDatatype>,
        "Renal failure, progressive" ;
    ns1:synonym "CKD"^^<http://example.org/invalidDatatype>,
        "Chronic kidney disease"^^<http://example.org/invalidDatatype>,
        "Progressive renal failure"^^<http://example.org/invalidDatatype>,
        "Progressive renal insufficiency"^^<http://example.org/invalidDatatype>,
        "Loss of renal function",
        "Renal failure, progressive",
        "Renal insufficiency, progressive" ;
    ns1:xref "SNOMEDCT_US:709044004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0748318",
        "UMLS:C1561643" .

<http://purl.obolibrary.org/obo/HP_0012706> rdfs:label "Elevated brain choline level by MRS"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase in the level of choline-containing compounds in the brain identified by magnetic resonance spectroscopy (MRS)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022763"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012806> rdfs:label "Proboscis" ;
    dcterms:description "A fleshy, tube-like structure usually located in the midline of the face or just to one side of the midline."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0687082" .

<http://purl.obolibrary.org/obo/HP_0012896> rdfs:label "Abnormal motor evoked potentials"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly identified by motor evoked potentials (MEPs). MEPs are measured following single-pulse or repetitive transcranial magnetic stimulation and can be used for the assessment of the excitability of the motor cortex and the integrity of conduction along the central and peripheral motor pathways."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022687" .

<http://purl.obolibrary.org/obo/HP_0012899> rdfs:label "Handgrip myotonia" ;
    dcterms:description "Difficulty releasing one's grip associated with prolonged first handgrip relaxation times." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Grip myotonia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Grip myotonia" ;
    ns1:xref "UMLS:C1868623" .

<http://purl.obolibrary.org/obo/HP_0020049> rdfs:label "Exodeviation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A manifest or latent ocular deviation in which one or both eyes tends to deviate temporally." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Divergent strabismus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Divergent strabismus" .

<http://purl.obolibrary.org/obo/HP_0020152> rdfs:label "Distal joint hypermobility" ;
    dcterms:description "Lack of stability of a distal joint (e.g., finger)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Distal joint laxity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Distal joint laxity" .

<http://purl.obolibrary.org/obo/HP_0030007> rdfs:label "EMG: positive sharp waves"^^<http://example.org/invalidDatatype> ;
    dcterms:description "These are spontaneous firing action potentials stimulated by needle movement of an injured muscle fiber. There is propagation to, but not past, the needle tip. This inhibits the display of the negative deflection of the waveform."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0429349"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:251527008" .

<http://purl.obolibrary.org/obo/HP_0030147> rdfs:label "Truncal titubation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Tremor of the trunk in an anterior-posterior plane at 3-4 Hz."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C2674512"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030196> rdfs:label "Fatigable weakness of respiratory muscles" ;
    dcterms:description "A type of weakness of the muscles involved in breathing (respiration) that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022587"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030234> rdfs:label "Highly elevated creatine kinase" ;
    dcterms:description "An increased CPK level between 4X and 50X above the upper normal level."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Highly elevated serum CPK"^^<http://example.org/invalidDatatype>,
        "Highly elevated serum phosph-CK"^^<http://example.org/invalidDatatype>,
        "Highly elevated CPK",
        "Highly elevated creatine phosphokinase",
        "Highly elevated serum CK" ;
    ns1:synonym "Highly elevated CPK"^^<http://example.org/invalidDatatype>,
        "Highly elevated creatine phosphokinase"^^<http://example.org/invalidDatatype>,
        "Highly elevated serum CPK"^^<http://example.org/invalidDatatype>,
        "Highly elevated serum CK",
        "Highly elevated serum phosph-CK" ;
    ns1:xref "UMLS:C4022565"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030521> rdfs:label "Bitemporal hemianopia" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:61917005",
        "UMLS:C0221184" .

<http://purl.obolibrary.org/obo/HP_0030528> rdfs:label "Paracentral scotoma"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:64418005",
        "UMLS:C0271197" .

<http://purl.obolibrary.org/obo/HP_0030529> rdfs:label "Ring scotoma" ;
    dcterms:description "An annular field defect centered on fixation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Annular scotoma" ;
    ns1:synonym "Annular scotoma"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:129625005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0438434" .

<http://purl.obolibrary.org/obo/HP_0030948> rdfs:label "Elevated gamma-glutamyltransferase level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased level of the enzyme gamma-glutamyltransferase (GGT). GGT is mainly present in kidney, liver, and pancreatic cells, but small amounts are present in other tissues." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated serum GGT"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated serum GGT"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031006> rdfs:label "Acroparesthesia" ;
    dcterms:description "A type of paresthesia (tingling, pins-and-needles, burning or numbness or stiffness) that occurs in the hands and feet and particularly in the fingers and toes." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031189> rdfs:label "Wrist drop" ;
    dcterms:description "A condition in which the affected individual cannot extend the wrist, which hangs flaccidly." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0031475> rdfs:label "Status epilepticus without prominent motor symptoms"^^<http://example.org/invalidDatatype> ;
    dcterms:description "There is inconclusive evidence to precisely define the duration of the seizure; however, based on current evidence an operational threshold of 10 minutes is appropriate as beyond this a seizure is likely to be more prolonged. The individual may or may not be aware or in coma."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Nonconvulsive status epilepticus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Nonconvulsive status epilepticus" .

<http://purl.obolibrary.org/obo/HP_0031825> rdfs:label "Freezing of gait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Freezing of gait is defined as a brief, episodic absence or marked reduction of forward progression of the feet despite the intention to walk."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Freezing gait"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Freezing gait"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0031908> rdfs:label "Micrographia" ;
    dcterms:description "Abnormally small-sized handwriting is formally defined as an impairment of fine motor skills, which mainly manifests as a progressive or stable reduction in amplitude during a writing task." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0032398> rdfs:label "Dysgyria" ;
    dcterms:description "An abnormal gyral pattern characterized by abnormalities of sulcal depth or orientation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033522> rdfs:label "Cerebral cavernous malformation" ;
    dcterms:description "A cerebral cavernous malformation (also known as cavernoma, cavernous angioma, cavernous hemangioma) is a collection of structurally abnormal slow-flow capillaries predominantly in the central nervous system. These are multiple mulberry-like distended caverns of dilated thin-walled capillaries without the normal intervening brain parenchymal architecture. Often, individual cavernomas are surrounded by hemosiderin representing remote oozing due to the abnormal capillaries." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0033643> rdfs:label "Increased circulating very long-chain fatty acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased concentration of very long-chain fatty acids in the blood circulation. Very long-chain fatty acids are fatty acids (FAs) with a chain-length of 22 or more carbons." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased plasma levels of very long-chain fatty acid"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased plasma levels of very long-chain fatty acid"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0034337> rdfs:label "Claw hand deformity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the hand characterized by metacarpophalangeal (MCP) hyperextension and proximal interphalangeal (PIP) and distal interphalangeal (DIP) flexion. The position of the affected hand is said to resemble a claw."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0040131> rdfs:label "Abnormal motor nerve conduction velocity"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4021031" .

<http://purl.obolibrary.org/obo/HP_0040194> rdfs:label "Increased head circumference"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally increased head circumference in a growing child. Head circumference is measured with a nonelastic tape and comprises the distance from above the eyebrows and ears and around the back of the head. The measured HC is then plotted on an appropriate growth chart." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased head circumference"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased head circumference"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4083076" .

