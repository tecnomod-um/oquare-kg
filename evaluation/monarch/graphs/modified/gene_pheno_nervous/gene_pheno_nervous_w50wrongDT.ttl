<http://purl.obolibrary.org/obo/MONDO_0010565> rdfs:label "red color blindness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Protanopia is a severe type of color vision deficiency caused by the complete absence of red retinal photoreceptors. Protans have difficulties distinguishing between blue and green colors and also between red and green colors. It is a form of dichromatism in which the subject can only perceive light wavelengths from 400 to 650 nm, instead of the usual 700 nm. Pure reds cannot be seen, instead appearing black; purple colors cannot be distinguished from blues; more orange-tinted reds may appear as very dim yellows, and all orange-yellow-green shades of too long a wavelength to stimulate the blue receptors appear as a similar yellow hue. It is hereditary, sex-linked, and present in 1% of males."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "protan defect"^^<http://example.org/invalidDatatype>,
        "colorblindness, protan",
        "partial achromatopsia, protan type",
        "protanopia",
        "red color blindness" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0200018> ;
    ns1:related_synonym "colorblindness, partial, protan series"^^<http://example.org/invalidDatatype>,
        "CBP" ;
    ns1:synonym "colorblindness, partial, protan series"^^<http://example.org/invalidDatatype>,
        "colorblindness, protan"^^<http://example.org/invalidDatatype>,
        "CBP",
        "partial achromatopsia, protan type",
        "protan defect",
        "protanopia",
        "red color blindness" ;
