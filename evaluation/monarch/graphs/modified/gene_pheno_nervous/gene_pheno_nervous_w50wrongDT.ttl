<http://purl.obolibrary.org/obo/MONDO_0011479> rdfs:label "postural orthostatic tachycardia syndrome" ;
    dcterms:description "A condition characterized by development of symptoms while standing. It is an autonomic nervous system disorder and the symptoms are relieved once the person sits back down. Symptoms include heart." ;
    ns1:category ns1:Disease ;
