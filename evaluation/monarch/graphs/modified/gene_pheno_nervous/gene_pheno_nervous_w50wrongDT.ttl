    ns1:xref "UMLS:C2675021"^^<http://example.org/invalidDatatype>,
        "UMLS:C1837464" .

<http://purl.obolibrary.org/obo/HP_0000044> rdfs:label "Hypogonadotropic hypogonadism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hypogonadotropic hypogonadism is characterized by reduced function of the gonads (testes in males or ovaries in females) and results from the absence of the gonadal stimulating pituitary hormones: follicle stimulating hormone (FSH) and luteinizing hormone (LH)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low gonadotropins (secondary hypogonadism)"^^<http://example.org/invalidDatatype>,
        "Hypogonadotrophic hypogonadism" ;
    ns1:related_synonym "Isolated hypogonadotropic hypogonadism"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Isolated hypogonadotropic hypogonadism"^^<http://example.org/invalidDatatype>,
        "Low gonadotropins (secondary hypogonadism)"^^<http://example.org/invalidDatatype>,
        "Hypogonadotrophic hypogonadism" ;
    ns1:xref "UMLS:C3489396"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:33927004",
        "UMLS:C0271623" .

<http://purl.obolibrary.org/obo/HP_0000360> rdfs:label "Tinnitus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Tinnitus is an auditory perception that can be described as the experience of sound, in the ear or in the head, in the absence of external acoustic stimulation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ringing in ears"^^<http://example.org/invalidDatatype>,
        "Ringing in the ears" ;
    ns1:synonym "Ringing in ears"^^<http://example.org/invalidDatatype>,
        "Ringing in the ears" ;
    ns1:xref "SNOMEDCT_US:60862001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:162349004",
        "SNOMEDCT_US:162352007",
        "UMLS:C0040264" .

<http://purl.obolibrary.org/obo/HP_0000713> rdfs:label "Agitation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A state of excessive motor activity that is associated with mental distress or a feeling of substantial unease or inner tension. Distinguished from restlessness by the increased level of emotional distress and negative intensity of the experience. Agitation has a significant level of physical activity that is typically threatening to the self or others." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Psychomotor agitation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Psychomotor agitation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:24199005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085631"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001159> rdfs:label "Syndactyly" ;
    dcterms:description "Webbing or fusion of the fingers or toes, involving soft parts only or including bone structure. Bony fusions are referred to as \"bony\" syndactyly if the fusion occurs in a radio-ulnar axis. Fusions of bones of the fingers or toes in a proximo-distal axis are referred to as \"symphalangism\"." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Webbed fingers or toes" ;
    ns1:synonym "Webbed fingers or toes"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C0039075"^^<http://example.org/invalidDatatype>,
        "Fyler:4174",
        "SNOMEDCT_US:373413006" .

<http://purl.obolibrary.org/obo/HP_0001387> rdfs:label "Joint stiffness" ;
    dcterms:description "Joint stiffness is a perceived sensation of tightness in a joint or joints when attempting to move them after a period of inactivity. Joint stiffness typically subsides over time."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Joint stiffness"^^<http://example.org/invalidDatatype>,
        "Stiff joints"^^<http://example.org/invalidDatatype>,
        "Stiff joint" ;
    ns1:synonym "Joint stiffness"^^<http://example.org/invalidDatatype>,
        "Stiff joint"^^<http://example.org/invalidDatatype>,
        "Stiff joints" ;
    ns1:xref "UMLS:C0162298"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:84445001" .

<http://purl.obolibrary.org/obo/HP_0001562> rdfs:label "Oligohydramnios"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Diminished amniotic fluid volume in pregnancy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low levels of amniotic fluid",
        "Maternal oligohydramnios" ;
    ns1:related_synonym "Decreased amniotic fluid index" ;
