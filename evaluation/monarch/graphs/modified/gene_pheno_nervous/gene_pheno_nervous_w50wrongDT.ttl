    ns1:exact_synonym "Microvesicular steatosis" ;
    ns1:synonym "Microvesicular steatosis" ;
    ns1:xref "UMLS:C1850415" .

<http://purl.obolibrary.org/obo/HP_0001460> rdfs:label "Aplasia/Hypoplasia involving the skeletal musculature"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence or underdevelopment of the musculature."^^<http://example.org/invalidDatatype> ;
