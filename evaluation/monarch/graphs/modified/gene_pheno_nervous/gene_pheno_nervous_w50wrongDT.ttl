<http://purl.obolibrary.org/obo/HP_0005575> rdfs:label "Hemolytic-uremic syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A thrombotic microangiopathy with presence of non-immune, intravascular hemolytic anemia, thrombocytopenia and acute kidney injury. A vicious cycle of complement activation, endothelial cell damage, platelet activation, and thrombosis is the hallmark of the disease." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hemolytic uremic syndrome" ;
    ns1:synonym "Hemolytic uremic syndrome"^^<http://example.org/invalidDatatype> ;
