        "UMLS:C0016655",
        "UMLS:C3805574",
        "UMLS:C3806283" .

<http://purl.obolibrary.org/obo/HP_0002783> rdfs:label "Recurrent lower respiratory tract infections" ;
    dcterms:description "An increased susceptibility to lower respiratory tract infections as manifested by a history of recurrent lower respiratory tract infections."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Chronic lung infections"^^<http://example.org/invalidDatatype>,
