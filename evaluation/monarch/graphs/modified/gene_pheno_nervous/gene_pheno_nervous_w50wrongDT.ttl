<http://purl.obolibrary.org/obo/HP_0002792> rdfs:label "Reduced vital capacity" ;
    dcterms:description "An abnormal reduction on the vital capacity, which is defined as the total lung capacity (volume of air in the lungs at maximal inflation) less the residual volume (i.e., volume of air in the lungs following maximal exhalation) of the lung." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased vital capacity"^^<http://example.org/invalidDatatype> ;
