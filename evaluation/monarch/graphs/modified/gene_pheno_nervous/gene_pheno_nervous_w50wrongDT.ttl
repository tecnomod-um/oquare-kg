<http://purl.obolibrary.org/obo/HP_0011401> rdfs:label "Delayed peripheral myelination"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Delayed myelination in the peripheral nervous system."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023374"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011427> rdfs:label "Enlarged fetal cisterna magna" ;
    dcterms:description "The cisterna magna is measured on a transaxial view of the fetal head angled 15 degrees caudal to the canthomeatal line. The anterior/posterior diameter is taken between the inferior/posterior surface of the vermis of the cerebellum to the inner surface of the cranium. An enlarged cisternal magna is defined by an anterior/posterior diameter of 10 mm or more (PMID:16100637)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Enlarged foetal cisterna magna" ;
    ns1:synonym "Enlarged foetal cisterna magna"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023365"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011445> rdfs:label "Athetoid cerebral palsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of cerebral palsy characterized by slow, involuntary muscle movement and mixed muscle tone." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Dyskinetic cerebral palsy" ;
    ns1:synonym "Dyskinetic cerebral palsy"^^<http://example.org/invalidDatatype> ;
