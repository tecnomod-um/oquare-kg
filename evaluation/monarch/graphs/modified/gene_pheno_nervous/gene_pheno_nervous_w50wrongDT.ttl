        "SNOMEDCT_US:81898007" .

<http://purl.obolibrary.org/obo/HP_0005184> rdfs:label "Prolonged QTc interval" ;
    dcterms:description "A longer than normal interval (corrected for heart rate) between the Q and T waves in the heart's cycle. Prolonged QTc can cause premature action potentials during late phase depolarizations thereby leading to ventricular arrhythmias and ventricular fibrillations." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1560305" .

