<http://purl.obolibrary.org/obo/HP_0009727> rdfs:label "Achromatic retinal patches" ;
    dcterms:description "Areas of the retina lacking pigmentation. Punched out areas of chorioretinal hypopigmentation less than 1 disk diameter in size and tending to be located in the midperiphery of the retina."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Punched out areas of chorioretinal hypopigmentation"^^<http://example.org/invalidDatatype> ;
