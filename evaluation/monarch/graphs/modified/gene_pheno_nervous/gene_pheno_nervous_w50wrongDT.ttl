<http://purl.obolibrary.org/obo/HP_0009748> rdfs:label "Large earlobe"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased volume of the earlobe, that is, abnormally prominent ear lobules." ;
    ns1:category ns1:PhenotypicFeature ;
