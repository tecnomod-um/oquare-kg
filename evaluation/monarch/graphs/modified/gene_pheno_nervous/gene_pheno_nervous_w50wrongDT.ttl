        "Decreased height of palpebral fissure",
        "Short opening between the eyelids" ;
    ns1:xref "UMLS:C0423112"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:246802000" .

<http://purl.obolibrary.org/obo/HP_0030890> rdfs:label "Hyperintensity of cerebral white matter on MRI"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A brighter than expected signal on magnetic resonance imaging emanating from the cerebral white matter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "White matter hyperintensity" ;
    ns1:synonym "White matter hyperintensity" .

<http://purl.obolibrary.org/obo/HP_0034392> rdfs:label "Joint contracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A limitation in the passive range of motion of a joint resulting from loss of elasticity in the periarticular tissues owing to structural changes of non-bony tissues, such as muscles, tendons, ligaments, joint capsules or skin. A contracture prevents movement of the associated body part."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Contracture"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Contracture"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000546> rdfs:label "Retinal degeneration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A nonspecific term denoting progressive loss of the retinal pigment epithelium (RPE) and/or neurosensory retinal cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retina degeneration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Retina degeneration" ;
    ns1:xref "SNOMEDCT_US:95695004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0035304" .

<http://purl.obolibrary.org/obo/HP_0000751> rdfs:label "Personality changes"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal shift in patterns of thinking, acting, or feeling." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Personality change"^^<http://example.org/invalidDatatype>,
        "Personality changes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Personality changes"^^<http://example.org/invalidDatatype>,
        "Personality change" ;
    ns1:xref "SNOMEDCT_US:102943000"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:192073007",
        "UMLS:C0240735" .

<http://purl.obolibrary.org/obo/HP_0001262> rdfs:label "Excessive daytime somnolence"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A state of abnormally strong desire for sleep during the daytime."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
