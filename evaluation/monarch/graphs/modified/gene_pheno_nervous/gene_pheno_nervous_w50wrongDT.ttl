<http://purl.obolibrary.org/obo/HP_0002067> rdfs:label "Bradykinesia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bradykinesia literally means slow movement, and is used clinically to denote a slowness in the execution of movement (in contrast to hypokinesia, which is used to refer to slowness in the initiation of movement)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Slow movements"^^<http://example.org/invalidDatatype>,
        "Slowness of movements"^^<http://example.org/invalidDatatype> ;
