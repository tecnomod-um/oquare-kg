        "Shortness of breath"^^<http://example.org/invalidDatatype>,
        "Trouble breathing"^^<http://example.org/invalidDatatype>,
        "Breathing difficulty",
        "Difficulty breathing",
        "Dyspnoea" ;
    ns1:related_synonym "Panting" ;
    ns1:synonym "Breathing difficulty"^^<http://example.org/invalidDatatype>,
        "Difficulty breathing"^^<http://example.org/invalidDatatype>,
        "Dyspnoea"^^<http://example.org/invalidDatatype>,
        "Trouble breathing"^^<http://example.org/invalidDatatype>,
        "Abnormal breathing",
        "Difficult to breathe",
        "Panting",
        "Shortness of breath" ;
    ns1:xref "SNOMEDCT_US:230145002"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:267036007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0013404" .

<http://purl.obolibrary.org/obo/HP_0002362> rdfs:label "Shuffling gait" ;
    dcterms:description "A type of gait (walking) characterized by by dragging one's feet along or without lifting the feet fully from the ground."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Shuffled walk"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Shuffled walk"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:43005009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0231688" .

<http://purl.obolibrary.org/obo/HP_0002371> rdfs:label "Loss of speech" ;
