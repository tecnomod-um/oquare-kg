    ns1:synonym "Saccadic slow pursuit"^^<http://example.org/invalidDatatype>,
        "Saccadic pursuit movements",
        "Saccadic smooth pursuit" ;
    ns1:xref "UMLS:C1836479"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001612> rdfs:label "Weak cry"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0234860"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:2120003" .

<http://purl.obolibrary.org/obo/HP_0001647> rdfs:label "Bicuspid aortic valve"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of an aortic valve with two instead of the normal three cusps (flaps). Bicuspid aortic valvue is a malformation of a commissure (small space between the attachment of each cusp to the aortic wall) and the adjacent parts of the two corresponding cusps forming a raphe (the fused area of the two underdeveloped cusps turning into a malformed commissure between both cusps; the raphe is a fibrous ridge that extends from the commissure to the free edge of the two underdeveloped, conjoint cusps)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aortic valve has two leaflets rather than three"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Aortic valve has two leaflets rather than three"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:72352009",
        "UMLS:C0149630" .

<http://purl.obolibrary.org/obo/HP_0001845> rdfs:label "Overlapping toe" ;
    dcterms:description "Describes a foot digit resting on the dorsal surface of an adjacent digit when the foot is at rest. Initially clawing may be dynamic and only noticeable on walking. Over time the plantar plate tears, subluxation occurs at the metatarsophalangeal joint (MTPJ), and the deformity becomes permanent." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Overlapping toe"^^<http://example.org/invalidDatatype>,
        "Overlapping toes"^^<http://example.org/invalidDatatype>,
        "Overriding toes" ;
    ns1:related_synonym "Crossover toe"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Overlapping toe"^^<http://example.org/invalidDatatype>,
        "Overlapping toes"^^<http://example.org/invalidDatatype>,
        "Overriding toes"^^<http://example.org/invalidDatatype>,
        "Crossover toe" ;
    ns1:xref "UMLS:C0920299"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:203541003" .

<http://purl.obolibrary.org/obo/HP_0002091> rdfs:label "Restrictive ventilatory defect" ;
    dcterms:description "A functional defect characterized by reduced total lung capacity (TLC) not associated with abnormalities of expiratory airflow or airway resistance. Spirometrically, a restrictive defect is defined as FEV1 (forced expiratory volume in 1 second) and FVC (forced vital capacity) less than 80 per cent. Restrictive lung disease may be caused by alterations in lung parenchyma or because of a disease of the pleura, chest wall, or neuromuscular apparatus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Restrictive respiratory syndrome"^^<http://example.org/invalidDatatype>,
        "Spirometric restriction"^^<http://example.org/invalidDatatype>,
        "Stiff lung or chest wall causing decreased lung volume"^^<http://example.org/invalidDatatype>,
        "Restrictive deficit on pulmonary function testing",
        "Restrictive deficit on pulmonary function tests",
        "Restrictive respiratory disease",
        "Restrictive respiratory insufficiency" ;
    ns1:related_synonym "Restrictive lung disease"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Restrictive respiratory disease"^^<http://example.org/invalidDatatype>,
        "Restrictive respiratory syndrome"^^<http://example.org/invalidDatatype>,
        "Stiff lung or chest wall causing decreased lung volume"^^<http://example.org/invalidDatatype>,
        "Restrictive deficit on pulmonary function testing",
        "Restrictive deficit on pulmonary function tests",
        "Restrictive lung disease",
        "Restrictive respiratory insufficiency",
        "Spirometric restriction" ;
    ns1:xref "SNOMEDCT_US:36485005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085581"^^<http://example.org/invalidDatatype>,
        "UMLS:C3277226" .

<http://purl.obolibrary.org/obo/HP_0002094> rdfs:label "Dyspnea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Difficult or labored breathing. Dyspnea is a subjective feeling only the patient can rate, e.g., on a Borg scale."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal breathing"^^<http://example.org/invalidDatatype>,
