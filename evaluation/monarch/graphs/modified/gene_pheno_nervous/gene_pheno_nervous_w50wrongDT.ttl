        <http://purl.obolibrary.org/obo/HP_0002354>,
        <http://purl.obolibrary.org/obo/HP_0007256> ;
    ns1:related_synonym "ataxia-dementia syndrome X-linked"^^<http://example.org/invalidDatatype>,
        "spinocerebellar ataxia X-linked type 4" ;
