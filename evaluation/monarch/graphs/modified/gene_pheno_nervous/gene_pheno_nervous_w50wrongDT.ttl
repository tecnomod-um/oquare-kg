<http://purl.obolibrary.org/obo/MONDO_0017196> rdfs:label "osteogenesis imperfecta-retinopathy-seizures-intellectual disability syndrome" ;
    dcterms:description "Osteogenesis imperfecta-retinopathy-seizures-intellectual disability syndrome is characterized by osteogenesis imperfecta, wormian bones, optic atrophy, retinopathy, seizures and severe developmental delay. It has been described in two sibs born to consanguineous parents." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Al Gazali-Nair syndrome" ;
