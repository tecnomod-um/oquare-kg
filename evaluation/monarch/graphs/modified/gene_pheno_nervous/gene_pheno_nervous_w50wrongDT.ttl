    ns1:xref "UMLS:C0728895"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:71358006" .

<http://purl.obolibrary.org/obo/HP_0009471> rdfs:label "Contracture of the proximal interphalangeal joint of the 3rd finger"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Chronic loss of joint motion of the proximal interphalangeal joint of the 3rd finger due to structural changes in non-bony tissue." ;
