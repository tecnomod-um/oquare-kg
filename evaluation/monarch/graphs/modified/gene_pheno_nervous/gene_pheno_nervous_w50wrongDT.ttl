<http://purl.obolibrary.org/obo/HP_0002267> rdfs:label "Exaggerated startle response" ;
    dcterms:description "An exaggerated startle reaction in response to a sudden unexpected visual or acoustic stimulus, or a quick movement near the face." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Exaggerated acoustic startle response"^^<http://example.org/invalidDatatype>,
        "Increased startle response" ;
    ns1:related_synonym "Hyperekplexia" ;
    ns1:synonym "Hyperekplexia"^^<http://example.org/invalidDatatype>,
        "Exaggerated acoustic startle response",
        "Increased startle response" ;
    ns1:xref "UMLS:C1740801"^^<http://example.org/invalidDatatype>,
        "UMLS:C1836014"^^<http://example.org/invalidDatatype>,
        "UMLS:C1848918"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:19557000",
        "UMLS:C0234166" .

<http://purl.obolibrary.org/obo/HP_0002375> rdfs:label "Hypokinesia" ;
    dcterms:description "Abnormally diminished motor activity. In contrast to paralysis, hypokinesia is not characterized by a lack of motor strength, but rather by a poverty of movement. The typical habitual movements (e.g., folding the arms, crossing the legs) are reduced in frequency." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased muscle movement",
        "Decreased spontaneous movement",
        "Decreased spontaneous movements" ;
    ns1:synonym "Decreased spontaneous movement"^^<http://example.org/invalidDatatype>,
        "Decreased muscle movement",
        "Decreased spontaneous movements" ;
    ns1:xref "SNOMEDCT_US:255385008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0086439"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:43994002" .

<http://purl.obolibrary.org/obo/HP_0002591> rdfs:label "Polyphagia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A neurological anomaly with gross overeating associated with an abnormally strong desire or need to eat."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperphagia"^^<http://example.org/invalidDatatype>,
        "Voracious appetite" ;
    ns1:related_synonym "Increased appetite"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Hyperphagia"^^<http://example.org/invalidDatatype>,
        "Increased appetite",
        "Voracious appetite" ;
    ns1:xref "SNOMEDCT_US:72405004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0020505"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:267023007",
        "SNOMEDCT_US:58424009",
        "UMLS:C0232461" .

<http://purl.obolibrary.org/obo/HP_0003273> rdfs:label "Hip contracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Lack of full passive range of motion (restrictions in flexion, extension, or other movements) of the hip joint resulting from structural changes of non-bony tissues, such as muscles, tendons, ligaments, joint capsules and/or skin." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Flexion contractures of hips"^^<http://example.org/invalidDatatype>,
        "Hip contractures"^^<http://example.org/invalidDatatype>,
        "Hip flexion contractures"^^<http://example.org/invalidDatatype>,
        "Flexion contracture of hips" ;
    ns1:synonym "Hip flexion contractures"^^<http://example.org/invalidDatatype>,
        "Flexion contracture of hips",
        "Flexion contractures of hips",
        "Hip contractures" ;
    ns1:xref "SNOMEDCT_US:202283002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0409354" .

<http://purl.obolibrary.org/obo/HP_0003473> rdfs:label "Fatigable weakness" ;
    dcterms:description "A type of weakness that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fatigable weakness of limb muscles"^^<http://example.org/invalidDatatype>,
        "Generalised muscle weakness due to defect at the neuromuscular junction"^^<http://example.org/invalidDatatype>,
        "Myasthenia"^^<http://example.org/invalidDatatype>,
        "Myasthenic weakness"^^<http://example.org/invalidDatatype>,
        "Proximal muscle weakness due to defect at the neuromuscular junction"^^<http://example.org/invalidDatatype>,
        "Generalized muscle weakness due to defect at the neuromuscular junction" ;
    ns1:synonym "Fatigable weakness of limb muscles"^^<http://example.org/invalidDatatype>,
        "Generalized muscle weakness due to defect at the neuromuscular junction"^^<http://example.org/invalidDatatype>,
        "Proximal muscle weakness due to defect at the neuromuscular junction"^^<http://example.org/invalidDatatype>,
        "Generalised muscle weakness due to defect at the neuromuscular junction",
        "Myasthenia",
        "Myasthenic weakness" ;
    ns1:xref "UMLS:C0947912" .

<http://purl.obolibrary.org/obo/HP_0003722> rdfs:label "Neck flexor weakness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Weakness of the muscles involved in neck flexion (sternocleidomastoid, longus capitus, longus colli, and scalenus anterior)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neck flexion weakness"^^<http://example.org/invalidDatatype>,
        "Neck flexor muscle weakness"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Neck flexion weakness",
        "Neck flexor muscle weakness" ;
    ns1:xref "UMLS:C1843637" .

<http://purl.obolibrary.org/obo/HP_0007360> rdfs:label "Aplasia/Hypoplasia of the cerebellum" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent/underdeveloped cerebellum"^^<http://example.org/invalidDatatype>,
        "Absent/small cerebellum",
        "Atrophy/Degeneration affecting the cerebellum",
        "Atrophy/Hypoplasia of the cerebellum",
