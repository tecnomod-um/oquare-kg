<http://purl.obolibrary.org/obo/MONDO_0009978> rdfs:label "retinal degeneration-nanophthalmos-glaucoma syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Retinal degeneration-nanophthalmos-glaucoma syndrome is characterized by progressive pigmentary retinal degeneration (with nyctalopia and visual field restriction), cystic macular degeneration and angle closure glaucoma. It has been described in seven members of one family. Patients also have hyperopia and nanophthalmos. The mode of transmission is autosomal recessive." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "Mackay-Shek-Carr syndrome" ;
