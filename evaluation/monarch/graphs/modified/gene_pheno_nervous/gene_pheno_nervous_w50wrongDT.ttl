<http://purl.obolibrary.org/obo/MONDO_0017276> rdfs:label "frontotemporal dementia" ;
    dcterms:description "Frontotemporal dementia (FTD) comprises a group of neurodegenerative disorders, characterized by progressive changes in behavior, executive dysfunction and language impairment, as a result of degeneration of the medial prefrontal and frontoinsular cortices. Four clinical subtypes have been identified: semantic dementia, progressive non-fluent aphasia, behavioral variant FTD and right temporal lobar atrophy." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "FTD" ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0002145> ;
    ns1:related_synonym "MSTD"^^<http://example.org/invalidDatatype>,
        "frontotemporal lobe dementia (FLDEM)" ;
    ns1:synonym "frontotemporal lobe dementia (FLDEM)"^^<http://example.org/invalidDatatype>,
        "FTD",
        "MSTD" ;
    ns1:xref "DOID:9255"^^<http://example.org/invalidDatatype>,
        "GARD:0008436"^^<http://example.org/invalidDatatype>,
