<http://purl.obolibrary.org/obo/HP_0001480> rdfs:label "Freckling"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of an increased number of freckles, small circular spots on the skin that are darker than the surrounding skin because of deposits of melanin."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Freckling" ;
    ns1:synonym "Freckling" ;
    ns1:xref "SNOMEDCT_US:699225003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0016689"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:403536009" .

<http://purl.obolibrary.org/obo/HP_0001538> rdfs:label "Protuberant abdomen"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A thrusting or bulging out of the abdomen."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Belly sticks out"^^<http://example.org/invalidDatatype>,
