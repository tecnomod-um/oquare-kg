<http://purl.obolibrary.org/obo/HP_0000639> rdfs:label "Nystagmus" ;
    dcterms:description "Rhythmic, involuntary oscillations of one or both eyes related to abnormality in fixation, conjugate gaze, or vestibular mechanisms."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
