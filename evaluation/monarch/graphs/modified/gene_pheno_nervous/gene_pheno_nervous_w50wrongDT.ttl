<http://purl.obolibrary.org/obo/HP_0040071> rdfs:label "Abnormal morphology of ulna" ;
    dcterms:description "Any structural anomaly of the ulna, a bone of the forearm the extends from the elbow to the little finger." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022453"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0040079> rdfs:label "Irregular dentition"^^<http://example.org/invalidDatatype> ;
