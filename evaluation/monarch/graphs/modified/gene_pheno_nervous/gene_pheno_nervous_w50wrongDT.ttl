    ns1:xref "SNOMEDCT_US:82649003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0004106"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000651> rdfs:label "Diplopia" ;
    dcterms:description "Diplopia is a condition in which a single object is perceived as two images, it is also known as double vision." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Double vision" ;
    ns1:synonym "Double vision" ;
    ns1:xref "UMLS:C0012569"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:24982008" .

<http://purl.obolibrary.org/obo/HP_0000717> rdfs:label "Autism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Autism is a neurodevelopmental disorder characterized by impaired social interaction and communication, and by restricted and repetitive behavior. Autism begins in childhood. It is marked by the presence of markedly abnormal or impaired development in social interaction and communication and a markedly restricted repertoire of activity and interest. Manifestations of the disorder vary greatly depending on the developmental level and chronological age of the individual (DSM-IV)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Autism"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Autism" ;
    ns1:xref "SNOMEDCT_US:408856003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:408857007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:43614003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0004352"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001643> rdfs:label "Patent ductus arteriosus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "In utero, the ductus arteriosus (DA) serves to divert ventricular output away from the lungs and toward the placenta by connecting the main pulmonary artery to the descending aorta. A patent ductus arteriosus (PDA) in the first 3 days of life is a physiologic shunt in healthy term and preterm newborn infants, and normally is substantially closed within about 24 hours after bith and completely closed after about three weeks. Failure of physiologcal closure is referred to a persistent or patent ductus arteriosus (PDA). Depending on the degree of left-to-right shunting, PDA can have clinical consequences."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ductus arteriosus"^^<http://example.org/invalidDatatype>,
        "PDA"^^<http://example.org/invalidDatatype>,
        "Patent ductus Botalli"^^<http://example.org/invalidDatatype>,
        "Persistent arterial duct",
        "Persistent ductus arteriosus" ;
    ns1:synonym "Ductus arteriosus"^^<http://example.org/invalidDatatype>,
        "PDA"^^<http://example.org/invalidDatatype>,
        "Patent ductus Botalli"^^<http://example.org/invalidDatatype>,
        "Persistent ductus arteriosus"^^<http://example.org/invalidDatatype>,
        "Persistent arterial duct" ;
    ns1:xref "UMLS:C0013274"^^<http://example.org/invalidDatatype>,
        "Fyler:2100",
        "SNOMEDCT_US:83330001" .

<http://purl.obolibrary.org/obo/HP_0011220> rdfs:label "Prominent forehead" ;
