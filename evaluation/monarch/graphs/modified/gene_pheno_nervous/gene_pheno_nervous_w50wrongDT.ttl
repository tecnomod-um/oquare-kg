    dcterms:description "A developmental defect of tooth color." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of dental color"^^<http://example.org/invalidDatatype>,
        "Abnormality of dental colour"^^<http://example.org/invalidDatatype>,
        "Abnormality of dental shade",
