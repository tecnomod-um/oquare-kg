        "Renal tubular disease"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:95568003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0151747"^^<http://example.org/invalidDatatype> .

