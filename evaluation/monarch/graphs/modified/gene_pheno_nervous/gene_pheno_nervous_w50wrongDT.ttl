<http://purl.obolibrary.org/obo/HP_0012078> rdfs:label "Motor conduction block" ;
    dcterms:description "Blockade of impulses at a focal site along the course of a motor axon." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023056"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012081> rdfs:label "Enlarged cerebellum" ;
    dcterms:description "An abnormally increased size of the cerebellum compared to other brain structures."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3278024" .

<http://purl.obolibrary.org/obo/HP_0012103> rdfs:label "Abnormality of the mitochondrion" ;
    dcterms:description "An anomaly of the mitochondrion, the membranous cytoplasmic organelle the interior of which is subdivided by cristae. The mitochondrion is a self replicating organelle that is the site of tissue respiration." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Mitochondrial abnormalities" ;
    ns1:synonym "Mitochondrial abnormalities" ;
    ns1:xref "UMLS:C4020732"^^<http://example.org/invalidDatatype>,
