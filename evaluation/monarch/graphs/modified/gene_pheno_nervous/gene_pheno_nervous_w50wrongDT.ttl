        "Kidney stones" ;
    ns1:xref "UMLS:C0392525"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000871> rdfs:label "Panhypopituitarism"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A pituitary functional deficit affecting all the anterior pituitary hormones (growth hormone, thyroid-stimulating hormone, follicle-stimulating hormone, luteinizing hormone, adrenocorticotropic hormone, and prolactin)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:32390006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0242343"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000961> rdfs:label "Cyanosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bluish discoloration of the skin and mucosa due to poor circulation or inadequate oxygenation of arterial or capillary blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Blue discoloration of the skin"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Blue discoloration of the skin" ;
    ns1:xref "SNOMEDCT_US:119419001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0010520"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:3415004" .

<http://purl.obolibrary.org/obo/HP_0001238> rdfs:label "Slender finger" ;
    dcterms:description "Fingers that are disproportionately narrow (reduced girth) for the hand/foot size or build of the individual." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Narrow fingers"^^<http://example.org/invalidDatatype>,
        "Slender finger"^^<http://example.org/invalidDatatype>,
        "thin fingers"^^<http://example.org/invalidDatatype>,
        "Slender fingers" ;
    ns1:synonym "Slender fingers"^^<http://example.org/invalidDatatype>,
        "Narrow fingers",
        "Slender finger",
        "thin fingers" ;
    ns1:xref "UMLS:C1857482" .

<http://purl.obolibrary.org/obo/HP_0001279> rdfs:label "Syncope" ;
    dcterms:description "A transient loss of consciousness (i.e., characterized by a rapid onset, a short duration, and a spontaneous and complete recovery) due to cerebral hypoperfusion." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fainting spell"^^<http://example.org/invalidDatatype> ;
