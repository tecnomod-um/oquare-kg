    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023793" .

<http://purl.obolibrary.org/obo/HP_0010542> rdfs:label "Vestibular nystagmus" ;
    dcterms:description "Nystagmus due to disturbance of the vestibular system; eye movements are rhythmic, with slow and fast components." ;
