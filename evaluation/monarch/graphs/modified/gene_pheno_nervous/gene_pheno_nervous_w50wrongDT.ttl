<http://purl.obolibrary.org/obo/HP_0012905> rdfs:label "Euryblepharon" ;
    dcterms:description "Euryblepharon is a congenital eyelid anomaly characterized by horizontal enlargement of the palpebral fissure. The eyelid is shortened vertically compared with the horizontal dimension, with associated lateral canthal malpositioning and lateral ectropion abnormally wide lid opening."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Kabuki syndrome eyelids"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Kabuki syndrome eyelids"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:400954002",
        "UMLS:C1303001",
        "UMLS:C4280305" .

<http://purl.obolibrary.org/obo/HP_0020006> rdfs:label "Ciliary body coloboma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A coloboma of the ciliary body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4072884"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020020> rdfs:label "Decreased CSF 5-hydroxyindoleacetic acid concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of 5-hydroxyindoleacetic acid in the cerebrospinal fluid (CSF) is below the lower limit of normal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020025> rdfs:label "Hip flexion contracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The inability to bring a flexed hip to neutral in the sagittal plane, where the neutral position for the hip is with the thigh segment in line with the anatomic plane of the pelvis, both in the coronal and sagittal planes." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020035> rdfs:label "Lower limb dysmetria" ;
    dcterms:description "A lack of coordination of leg movement manifested by undershoot or overshoot of the intended position of the leg."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020036> rdfs:label "Upper limb dysmetria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A lack of coordination of arm movement manifested by undershoot or overshoot of the intended position of the arm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020041> rdfs:label "Double elevator palsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of incomitant strabismus in which both elevator muscles (i.e., the inferior oblique and superior rectus muscles) of the same eye are weak leading to restricted elevation and hypotropia."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020062> rdfs:label "Decreased hemoglobin concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal reduction below normal hemoglobin concentration in the circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased Hb concentration"^^<http://example.org/invalidDatatype>,
        "Decreased haemoglobin concentration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased Hb concentration",
        "Decreased haemoglobin concentration" .

<http://purl.obolibrary.org/obo/HP_0020081> rdfs:label "Pappenheimer bodies"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of erythrocyte inclusion characterized by basophilic stippling of erythrocytes, that is, by numerous very small coarse or fine blue granules within the cytoplasm with the additional stipulation that the stippled particles are due to iron granules (demonstrable by the Prussian blue stain)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020088> rdfs:label "Post-vaccination measles" ;
    dcterms:description "Infection with the measles virus of the live-attenuated vaccine. This is an extremely rare event and may indicate immunocompromise in some cases."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Vaccine associated measles"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Vaccine associated measles" .

<http://purl.obolibrary.org/obo/HP_0020089> rdfs:label "Post-vaccination rubella" ;
    dcterms:description "Infection with the rubella virus of the live-attenuated vaccine."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020096> rdfs:label "Recurrent streptococcal infections" ;
    dcterms:description "Increased susceptibility to streptococcal infections, as manifested by recurrent episodes of streptococcal infections."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020110> rdfs:label "Bone fracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A partial or complete breakage of the continuity of a bone."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020120> rdfs:label "Retinal nerve fiber edema" ;
    dcterms:description "Swelling (edema) of the retinal nerve fibers."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal nerve fibre oedema" ;
    ns1:synonym "Retinal nerve fibre oedema"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020128> rdfs:label "Aplasia of the olfactory tract"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Aplasia (congenital absence) of the olfactory tract, which causes anosmia, a complete loss of the sense of smell." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020136> rdfs:label "Anticardiolipin IgG antibody positivity" ;
    dcterms:description "The presence of circulating IgG autoantibodies to cardiolipin." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020151> rdfs:label "Anti-dsDNA antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against double-stranded DNA."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-double-stranded DNA antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-double-stranded DNA antibody positivity" .

<http://purl.obolibrary.org/obo/HP_0020189> rdfs:label "Posterior predominant thick cortex pachygyria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pachygyria with cortical thickness above 10 mm with and a posterior predominant severity gradient. The severity gradient is determined based on the gyral width, with gyri typically wider than 5mm over the more severely affected regions. Posterior predominant gradient indicates pachygyria more severe other the occipital lobes but also includes a rare perisylvian-predominant pachygyria and a temporal predominant pachygyria."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Occipital predomimant classic pachygyria"^^<http://example.org/invalidDatatype>,
        "Pachygyria with cortical thickness over 10 mm posterior predominant"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Occipital predomimant classic pachygyria"^^<http://example.org/invalidDatatype>,
        "Pachygyria with cortical thickness over 10 mm posterior predominant" .

<http://purl.obolibrary.org/obo/HP_0020190> rdfs:label "Perisylvian predominant thick cortex pachygyria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pachygyria with cortical thickness greater than 10 mm and a perisylvian predominant severity gradient. The severity gradient is determined based on the gyral width, with gyri typically wider than 5mm over the more severely affected regions. Perisylvian predominant gradient indicates pachygyria more severe other the occipital lobes but also includes a rare perisylvian-predominant pachygyria and a temporal predominant pachygyria." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pachygyria with cortical thickness > 10 mm perisylvian predominant" ;
    ns1:synonym "Pachygyria with cortical thickness > 10 mm perisylvian predominant" .

<http://purl.obolibrary.org/obo/HP_0020191> rdfs:label "Anterior predominant thick cortex pachygyria" ;
    dcterms:description "Pachygyria with cortical thickness greater than 10 mm and an anterior predominant severity gradient. The severity gradient is determined based on the gyral width, with gyri typically wider than 5mm over the more severely affected regions. Anterior predominant gradient indicates pachygyria more severe over the frontal and temporal lobes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pachygyria with cortical thickness > 10 mm anterior predominant"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pachygyria with cortical thickness > 10 mm anterior predominant"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020202> rdfs:label "Abnormal Z disk morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any structural anomaly of the Z disk, which is the platelike region of a muscle sarcomere to which the plus ends of actin filaments are attached."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020208> rdfs:label "Eating-induced seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A seizure precipitated by aspects of anticipating food, eating itself, or the post-prandial period."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020214> rdfs:label "Startle-induced seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Startle-induced seizures are triggered by multiple and non-specific stimuli (auditory, somatosensory, and rarely visual) and are characterized by their sudden unexpected nature. Sudden noise rather than pure sound is the most effective acoustic stimulus." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0020220> rdfs:label "Focal atonic seizure" ;
    dcterms:description "A focal seizure characterized at onset by sudden loss or diminution of muscle tone without apparent preceding myoclonic or tonic activity, typically lasting more than 500 ms but less than 2 seconds. It may involve the head, trunk, jaw or limb musculature." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Localised atonic seizure"^^<http://example.org/invalidDatatype>,
        "Localized atonic seizure"^^<http://example.org/invalidDatatype>,
        "Partial hypotonic seizure"^^<http://example.org/invalidDatatype>,
        "Segmental atonic seizure"^^<http://example.org/invalidDatatype>,
        "Localised hypotonic seizure",
        "Localized hypotonic seizure",
        "Partial atonic seizure",
        "Segmental hypotonic seizure" ;
    ns1:synonym "Localised hypotonic seizure"^^<http://example.org/invalidDatatype>,
        "Partial atonic seizure"^^<http://example.org/invalidDatatype>,
        "Partial hypotonic seizure"^^<http://example.org/invalidDatatype>,
        "Segmental atonic seizure"^^<http://example.org/invalidDatatype>,
        "Segmental hypotonic seizure"^^<http://example.org/invalidDatatype>,
        "Localised atonic seizure",
        "Localized atonic seizure",
        "Localized hypotonic seizure" .

<http://purl.obolibrary.org/obo/HP_0020309> rdfs:label "Ankle instability" ;
    dcterms:description "Failure of ligamentous and muscular structures of the ankle to maintain normal joint alignment during movement, resulting in excessive motion that causes manifestations such as subjective or objective feeling of clunking/clicking in the ankle with movement, ankle 'giving way' or sensation of ankle dislocating."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025011> rdfs:label "Pyriform aperture stenosis" ;
    dcterms:description "Narrowing of the anterior nasal aperture (piriform or pyriform aperture), which is a pear-shaped opening in the skull that forms the bony inlet of the nose."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025022> rdfs:label "Decreased erythrocyte sedimentation rate" ;
    dcterms:description "A reduced erythrocyte sedimentation rate (ESR). The ESR is a test that measures the distance that erythrocytes have fallen after one hour in a vertical column of anticoagulated blood under the influence of gravity. The ESR is a nonspecific finding. A decreased ESR may be seen in polycythemia or in certain blood diseases in which red blood cells have an irregular or smaller shape that causes slower settling."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased ESR"^^<http://example.org/invalidDatatype>,
        "Low ESR" ;
    ns1:synonym "Decreased ESR",
        "Low ESR" .

<http://purl.obolibrary.org/obo/HP_0025028> rdfs:label "Abnormal enteric nervous system morphology" ;
    dcterms:description "A structural anomaly of nerves of the enteric nervous system."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of enteric nervous system morphology" ;
    ns1:synonym "Abnormality of enteric nervous system morphology" .

<http://purl.obolibrary.org/obo/HP_0025040> rdfs:label "Thalamic edema"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Swelling within the thalamus due to the accumulation of fluid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Thalamic edema"^^<http://example.org/invalidDatatype>,
        "Edema of the thalamus",
        "Oedema of the thalamus" ;
    ns1:synonym "Thalamic edema"^^<http://example.org/invalidDatatype>,
        "Edema of the thalamus",
        "Oedema of the thalamus" .

<http://purl.obolibrary.org/obo/HP_0025045> rdfs:label "Abnormal brain lactate level by MRS"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deviation from normal of the level of lactate in the brain identified by magnetic resonance spectroscopy (MRS)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal lactate level by magnetic resonance spectroscopy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal lactate level by magnetic resonance spectroscopy" .

<http://purl.obolibrary.org/obo/HP_0025058> rdfs:label "Hypothalamic atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Partial or complete wasting (loss) of hypothalamus tissue that was once present." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Atrophy of the hypothalamus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Atrophy of the hypothalamus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025072> rdfs:label "Prominent U wave"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Increased amplitude of the U wave, defined as an amplitude greater than 1-2mm or 25 percent of the height of the T wave." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased U wave amplitude"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased U wave amplitude" .

<http://purl.obolibrary.org/obo/HP_0025085> rdfs:label "Bloody diarrhea"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Passage of many stools containing blood." ;
    ns1:broad_synonym "Blood in stool"^^<http://example.org/invalidDatatype>,
        "Bloody stool"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bloody diarrhea"^^<http://example.org/invalidDatatype>,
        "Bloody bowel movement" ;
    ns1:synonym "Bloody stool"^^<http://example.org/invalidDatatype>,
        "Blood in stool",
        "Bloody bowel movement",
        "Bloody diarrhea" .

<http://purl.obolibrary.org/obo/HP_0025099> rdfs:label "Dysgenesis of the thalamus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Structural abnormality of the thalamus related to defective development." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Thalamic dysgenesis" ;
    ns1:synonym "Thalamic dysgenesis" .

<http://purl.obolibrary.org/obo/HP_0025105> rdfs:label "Nevus anemicus" ;
    dcterms:description "A congenital skin lesion characterized by irregular hypopigmented macules that coalesce to form plaques and occur particularly on the chest. It is generally present at birth or develops in the first days of life. It is more common in females. Diagnosis is confirmed by applying gentle friction to the lesion and the surrounding skin and checking that the erythema produced in the healthy skin does not appear in the hypopigmented lesion. This pale macule becomes more conspicuous when the lesion and its surroundings are rubbed. The margin of the naevus is ill-defined and consists of an archipelago of small anemic spots."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Naevus anaemicus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Naevus anaemicus" .

<http://purl.obolibrary.org/obo/HP_0025128> rdfs:label "Reduced intraabdominal adipose tissue" ;
    dcterms:description "An abnormally reduced amount of adipose tissue in the abdominal cavity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025144> rdfs:label "Shivering" ;
    dcterms:description "Involuntary contraction or twitching of the muscles."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Shivering"^^<http://example.org/invalidDatatype>,
        "Shuddering"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Shivering",
        "Shuddering" .

<http://purl.obolibrary.org/obo/HP_0025147> rdfs:label "Beaten bronze macular sheen"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An irregular grayish appearance of the macula, which is said to resemble beaten bronze or hammered metal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Beaten-bronze macular appearance"^^<http://example.org/invalidDatatype>,
        "Beaten-bronze macular sheen"^^<http://example.org/invalidDatatype>,
        "Beaten metal macular appearance" ;
    ns1:synonym "Beaten-bronze macular sheen"^^<http://example.org/invalidDatatype>,
        "Beaten metal macular appearance",
        "Beaten-bronze macular appearance" .

<http://purl.obolibrary.org/obo/HP_0025148> rdfs:label "Dark choroid" ;
    dcterms:description "A fluorescein angiographic finding of absence of the normal background fluorescence (a dark choroid)." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025149> rdfs:label "Atrophic muscularis propria" ;
    dcterms:description "Partial or complete wasting (loss) of muscularois propria tissue that was once present. The atrophy may involve a marked vacuolar degeneration of myocytes, loss of muscle fibers and some cases a highly characteristic honeycomb fibrosis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Autonomic visceral myopathy",
        "Degenerative enteric myopathy" ;
    ns1:synonym "Degenerative enteric myopathy"^^<http://example.org/invalidDatatype>,
        "Autonomic visceral myopathy" .

<http://purl.obolibrary.org/obo/HP_0025156> rdfs:label "Dependency on intravenous nutrition"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inability to be weaned from intravenous (parenteral) nutrition, as judged by the hydration status (urine output, blood urea nitrogen, creatinine, urine sodium concentration), ability to maintain weight, stool output, and serum electrolyte status." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dependency on IV nutrition" ;
    ns1:synonym "Dependency on IV nutrition" .

<http://purl.obolibrary.org/obo/HP_0025163> rdfs:label "Abnormal optic chiasm morphology" ;
    dcterms:description "A structural abnormality of the optic chiasm.The optic chiasm, located below the hypothalamus, is a partial crossing of the optic nerves."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of optic chiasm morphology" ;
    ns1:synonym "Abnormality of optic chiasm morphology"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025170> rdfs:label "Neuronal/glioneuronal neoplasm of the central nervous system" ;
    dcterms:description "A central nervous system neoplasm with neuronal and, less consistently, glial differentiation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neuronal and mixed neuronal-glial tumour"^^<http://example.org/invalidDatatype>,
        "Neuronal/glioneuronal neoplasm of the CNS"^^<http://example.org/invalidDatatype>,
        "Glioneuronal tumor",
        "Glioneuronal tumour",
        "Neuronal and mixed neuronal-glial tumor" ;
    ns1:synonym "Neuronal and mixed neuronal-glial tumour"^^<http://example.org/invalidDatatype>,
        "Glioneuronal tumor",
        "Glioneuronal tumour",
        "Neuronal and mixed neuronal-glial tumor",
        "Neuronal/glioneuronal neoplasm of the CNS" .

<http://purl.obolibrary.org/obo/HP_0025179> rdfs:label "Ground-glass opacification" ;
    dcterms:description "On chest radiographs, ground-glass opacity appears as an area of hazy increased lung opacity, usually extensive, within which margins of pulmonary vessels may be indistinct. On CT scans, it appears as hazy increased opacity of lung, with preservation of bronchial and vascular margins. It is caused by partial filling of airspaces, interstitial thickening (due to fluid, cells, and/or fibrosis), partial collapse of alveoli, increased capillary blood volume, or a combination of these, the common factor being the partial displacement of air. Ground-glass opacity is less opaque than consolidation, in which bronchovascular margins are obscured." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ground glass opacities"^^<http://example.org/invalidDatatype>,
        "GGO" ;
    ns1:narrow_synonym "Ground-glass opacification on pulmonary HRCT" ;
    ns1:synonym "GGO"^^<http://example.org/invalidDatatype>,
        "Ground glass opacities",
        "Ground-glass opacification on pulmonary HRCT" .

<http://purl.obolibrary.org/obo/HP_0025188> rdfs:label "Retinal vasculitis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Inflammation of retinal blood vessels as manifested by perivascular sheathing or cuffing, vascular leakage and/or occlusion. It can affect veins, arteries or both." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025195> rdfs:label "Central diaphragmatic hernia" ;
    dcterms:description "A congenital diaphragm defect involving the central tendinous (e.g., amuscular) portion of the diaphragm, whereby the entire rim of diaphragmatic musculature is present."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Central hernia" ;
    ns1:synonym "Central hernia" .

<http://purl.obolibrary.org/obo/HP_0025196> rdfs:label "Increased total iron binding capacity" ;
    dcterms:description "An elevation in the total-iron binding capacity, which measures how much serum iron is bound if an excess of radioactive iron is added. A high TIBC corresponds to a high transferrin concentration. The latent (or free) iron binding capacity is the difference between the TIBC and the measured serum iron, corresponding to the transferrin not bound to iron, i.e., free iron binding capacity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025201> rdfs:label "Abnormal circulating apolipoprotein concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deviation from the normal concentration in blood of an apolipoprotein, i.e., of a protein that binds lipids to form lipoprotein and is thereby responsible for the transport of lipids in the blood and lymph circulation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal apolipoprotein level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal apolipoprotein level"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025234> rdfs:label "Parasomnia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A clinically observable or self-reported abnormal behavior, experience, or physiological event that occurs in association with sleep, specific sleep stages, or sleep-wake transitions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Event that disrupts sleep" ;
    ns1:synonym "Event that disrupts sleep" .

<http://purl.obolibrary.org/obo/HP_0025236> rdfs:label "Sleep walking"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Ambulation during sleep with lack awareness and limited or no recall of the event."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Somnambulism"^^<http://example.org/invalidDatatype>,
        "Sleep walking" ;
    ns1:synonym "Somnambulism"^^<http://example.org/invalidDatatype>,
        "Sleep walking" .

<http://purl.obolibrary.org/obo/HP_0025240> rdfs:label "Preretinal hemorrhage"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An accumulation of blood that is located between the retina and the detached posterior hyaloid, or in the vitreous cavity. Subhyaloid premacular hemorrhage is typically characterized by a circumscribed, round or dumb-bell shaped, bright red mound of blood beneath the internal limiting membrane (ILM) or between the ILM and hyaloid face, in or near to the central macular area." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Preretinal haemorrhage"^^<http://example.org/invalidDatatype>,
        "Preretinal heme"^^<http://example.org/invalidDatatype>,
        "Preretinal haeme",
        "Subhyaloid haemorrhage",
        "Subhyaloid heme" ;
    ns1:narrow_synonym "Premacular hemorrhage"^^<http://example.org/invalidDatatype>,
        "Subhyaloid hemorrhage" ;
    ns1:synonym "Subhyaloid haemorrhage"^^<http://example.org/invalidDatatype>,
        "Subhyaloid hemorrhage"^^<http://example.org/invalidDatatype>,
        "Premacular hemorrhage",
        "Preretinal haeme",
        "Preretinal haemorrhage",
        "Preretinal heme",
        "Subhyaloid heme" .

<http://purl.obolibrary.org/obo/HP_0025244> rdfs:label "Sub-retinal pigment epithelium haemorrhage"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An accumulation of blood located between the retinal pigment epithelium (RPE) and Bruch membrane." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Subretinal pigment epithelium haemorrhage"^^<http://example.org/invalidDatatype>,
        "Sub-RPE hemorrhage",
        "Subretinal pigment epithelium hemorrhage" ;
    ns1:synonym "Subretinal pigment epithelium haemorrhage"^^<http://example.org/invalidDatatype>,
        "Sub-RPE hemorrhage",
        "Subretinal pigment epithelium hemorrhage" .

<http://purl.obolibrary.org/obo/HP_0025247> rdfs:label "Dermoid cyst" ;
    dcterms:description "A congenital subcutaneous cyst that arises from entrapment of skin along the lines of embryonic fusion. In contrast to epidermal cysts, dermoid cysts tend to contain various adnexal structures such as hair, sebaceous, eccrine or apocrine glands. Dermoid cysts are present at birth, and are indolent, firm, deep, subcutaneous nodules. They are often located on the head and neck, and rarely in the anogenital area. Dermoid cysts are slowly progressive and can grow to a size of 1 to 4 cm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025253> rdfs:label "Claustrophobia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal fear of being in a closed or narrow space with no escape is called claustrophobia." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025259> rdfs:label "Stiff elbow" ;
    dcterms:description "A sensation of tightness in the elbow joint when attempting to move it, especially after a period of inactivity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elbow stiffness",
        "Stiff elbow" ;
    ns1:synonym "Stiff elbow"^^<http://example.org/invalidDatatype>,
        "Elbow stiffness" .

<http://purl.obolibrary.org/obo/HP_0025262> rdfs:label "Stiff hip"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A sensation of tightness in the hip joint when attempting to move it, especially after a period of inactivity." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Stiff hip"^^<http://example.org/invalidDatatype>,
        "Hip stiffness" ;
    ns1:synonym "Hip stiffness"^^<http://example.org/invalidDatatype>,
        "Stiff hip"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025300> rdfs:label "Malar rash"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An erythematous (red), flat facial rash that affects the skin in the malar area (over the cheekbones) and extends over the bridge of the nose."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Butterfly rash"^^<http://example.org/invalidDatatype>,
        "Cheekbone rash"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Butterfly rash"^^<http://example.org/invalidDatatype>,
        "Cheekbone rash"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025321> rdfs:label "Copper accumulation in liver" ;
    dcterms:description "An anomalous build up of copper (Cu) in the liver." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Liver copper accumulation" ;
    ns1:synonym "Liver copper accumulation"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025329> rdfs:label "Anti-glutamic acid decarboxylase antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against glutamic acid decarboxylase." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Anti-GAD antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Anti-GAD antibody positivity" .

<http://purl.obolibrary.org/obo/HP_0025330> rdfs:label "Downgaze palsy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A limitation of the ability to direct one's gaze below the horizontal meridian."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Downgaze paresis"^^<http://example.org/invalidDatatype>,
        "Supranuclear downgaze palsy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Downgaze paresis",
        "Supranuclear downgaze palsy" .

<http://purl.obolibrary.org/obo/HP_0025337> rdfs:label "Red eye"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reddish appearance over the white part (sclera) of the eye ranging from a few enlarged blood vessels appearing as wiggly lines over the sclera to a bright red color completely covering to sclera." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Red eye",
        "Red eyes" ;
    ns1:synonym "Red eye",
        "Red eyes" .

<http://purl.obolibrary.org/obo/HP_0025346> rdfs:label "Increased circulating beta-2-microglobulin level"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Elevated concentration of beta-2-microglobulin in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Elevated circulating beta-2-microglobulin level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Elevated circulating beta-2-microglobulin level" .

<http://purl.obolibrary.org/obo/HP_0025354> rdfs:label "Abnormal cellular phenotype" ;
    dcterms:description "An anomaly of cellular morphology or physiology."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025355> rdfs:label "Retinal arteriolar macroaneurysms"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Acquired focal dilatations of branches of the retinal artery, usually second-order retinal arterioles, that range in size from 100 to 200 micrometers in diameter. Macroaneurysms are generally located at the temporal retina and may be hemorrhagic or exudative."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025361> rdfs:label "Abnormal medullary pyramid morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A structural anomaly of the pyramid of the adult kidney, cone-shaped structures with a broad base adjacent to the renal cortex and the narrow apex that is termed papilla."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of medullary pyramid morphology" ;
    ns1:synonym "Abnormality of medullary pyramid morphology"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025379> rdfs:label "Anti-thyroid peroxidase antibody positivity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against thyroid peroxidase."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Antimicrosomal antibodies"^^<http://example.org/invalidDatatype>,
        "Antimicrosomal antibody positivity"^^<http://example.org/invalidDatatype>,
        "Anti-TPO antibody positivity",
        "TPOAbs" ;
    ns1:synonym "Anti-TPO antibody positivity"^^<http://example.org/invalidDatatype>,
        "Antimicrosomal antibodies"^^<http://example.org/invalidDatatype>,
        "Antimicrosomal antibody positivity"^^<http://example.org/invalidDatatype>,
        "TPOAbs"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025389> rdfs:label "Pulmonary interstitial high-resolution computed tomography abnormality" ;
    dcterms:description "High-resolution computed tomography (HRCT) can distinguish findings that characterize characterize interstitial lung diseases in a way not possible with other modalities." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pulmonary interstitiatial HRCT abnormality" ;
    ns1:synonym "Pulmonary interstitiatial HRCT abnormality" .

<http://purl.obolibrary.org/obo/HP_0025394> rdfs:label "Cystic pattern on pulmonary HRCT"^^<http://example.org/invalidDatatype> ;
    dcterms:description "On pulmonary high-resolution computed tomography, the cystic pattern is composed by well-defined, round and circumscribed air-containing parenchymal spaces with a well-defined wall and interface with normal lung. The wall of the cysts may be uniform or varied in thickness, but usually is thin (less than 2 mm) and occurs without associated emphysema." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025408> rdfs:label "Abnormal spleen morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Any anomaly of the structure of the spleen."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Splenic lesion" ;
    ns1:synonym "Splenic lesion" .

<http://purl.obolibrary.org/obo/HP_0025444> rdfs:label "Reduced amygdala volume"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A decrease in the volume (size) of the amygdyla."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decrease in amygdala volume"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decrease in amygdala volume"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025459> rdfs:label "Increased CSF/serum albumin ratio"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increase above normal limits of the ratio of the cerebrospinal fluid (CSF) albumin concentration to serum albumin concentration." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025460> rdfs:label "High myoinositol in brain by MRS" ;
    dcterms:description "An elevated level of myoinositol in the brain identified by magnetic resonance spectroscopy (MRS)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High myo-inositol in brain by MRS" ;
    ns1:synonym "High myo-inositol in brain by MRS"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025464> rdfs:label "Increased reactive oxygen species production" ;
    dcterms:description "An accumulation of free radical groups in the body inadequately neutralized by antioxidants, which creates a potentially unstable and damaging cellular environment linked to tissue damage." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased ROS production" ;
    ns1:related_synonym "Oxidative stress" ;
    ns1:synonym "Increased ROS production"^^<http://example.org/invalidDatatype>,
        "Oxidative stress" .

<http://purl.obolibrary.org/obo/HP_0025474> rdfs:label "Erythematous plaque"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A plaque (a solid, raised, plateau-like (flat-topped) lesion greater than 1 cm in diameter) with a red or reddish color often associated with inflammation or irritation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Violaceous plaque"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Violaceous plaque"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025475> rdfs:label "Erythematous macule"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A macule (flat, distinct, discolored area of skin less than 1 cm wide that does not involve any change in the thickness or texture of the skin) with a red or reddish color often associated with inflammation or irritation." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025487> rdfs:label "Abnormal bladder morphology" ;
    dcterms:description "Any structural anomaly of the bladder."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of bladder morphology"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of bladder morphology" .

<http://purl.obolibrary.org/obo/HP_0025488> rdfs:label "Detrusor sphincter dyssynergia" ;
    dcterms:description "A urodynamic anomaly characterized by bladder outlet obstruction from detrusor muscle contraction with concomitant involuntary urethral sphincter activation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025492> rdfs:label "Microcoria" ;
    dcterms:description "A small pupil (typically diameter less than 2 mm) that dilates poorly or not at all in response to topically administered mydriatic drugs." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025498> rdfs:label "Aceruloplasminemia" ;
    dcterms:description "Absence of ceruloplasmin in the blood." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aceruloplasminaemia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Aceruloplasminaemia" .

<http://purl.obolibrary.org/obo/HP_0025501> rdfs:label "Class III obesity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Obesity with a body mass index of 40 kg per square meter or higher." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Obesity grade 3" ;
    ns1:synonym "Obesity grade 3"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025510> rdfs:label "Nevus spilus" ;
    dcterms:description "A tan, regularly bordered patch with darker macules within the lesion."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Speckled lentiginous Nevus" ;
    ns1:synonym "Speckled lentiginous Nevus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025516> rdfs:label "Coronary-pulmonary artery fistula"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A congenital malformation with abnormal connection between one of the coronary arteries and the pulmonary artery."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025550> rdfs:label "Elevated circulating ribitol concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The concentration of ribitol in the blood circulation is above the upper limit of normal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Increased circulating ribitol concentration"^^<http://example.org/invalidDatatype>,
        "Increased level of ribitol in serum" ;
    ns1:synonym "Increased circulating ribitol concentration",
        "Increased level of ribitol in serum" .

<http://purl.obolibrary.org/obo/HP_0025552> rdfs:label "Periorbital purpura"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Multiple red/purple spots on the skin that surrounds the eyes that do not blanch (whiten) upon pressure. Purpura is caused by subcutaneous bleeding."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025553> rdfs:label "Periorbital ecchymosis with tarsal plate sparing" ;
    dcterms:description "Subcutaneous bleeding with a diameter greater than 1 cm (ecchymosis). The bleeding does not extend into the tarsal plate (the comparatively thick, elongated plates of dense connective tissue within the eyelid) due to an anatomic structure called the orbital septum, which limits extravasation of blood beyond the tarsal plate."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Raccoon eyes"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Raccoon eyes"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025646> rdfs:label "Bilateral polymicrogyria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Polymicrogyria that affects all or some of both cerebral hemispheres."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025650> rdfs:label "Steroid-dependent nephrotic syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of nephrotic syndrome in which two consecutive relapses (albumin urine dipstick at least 3+ or proteinuria greater than 40 mg/m2/d or urinary protein to creatinine ratio at least 2000 mg/g for 3 consecutive days) occur during corticosteroid therapy, or within 14 days of ceasing therapy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "SDNS" ;
    ns1:synonym "SDNS" .

<http://purl.obolibrary.org/obo/HP_0025664> rdfs:label "Moderate to late preterm birth" ;
    dcterms:description "Birth at 32 to 36 completed weeks of gestation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025670> rdfs:label "Syntelencephaly" ;
    dcterms:description "Syntelencephaly is a rare malformation that consists of an abnormal midline connection of the cerebral hemispheres in the posterior frontal and parietal regions, with interhemispheric separation of the basal forebrain, anterior frontal lobes, and occipital regions." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025672> rdfs:label "Fetal skin edema" ;
    dcterms:description "A separation of skin in one or more regions of the body or even along the entire length of body wall (to a degree greater than gestational-age related norms) related to pathologically increased fluid accumulation in the subcutaneous tissue." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025680> rdfs:label "Compound muscle action potential amplitude facilitation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Compound muscle action potential amplitude (CMAP) facilitation denotes an increase in tendon reflexes, strength, or CMAP amplitude after 10 seconds of maximal voluntary contraction."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "CMAP facilitation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "CMAP facilitation" .

<http://purl.obolibrary.org/obo/HP_0025682> rdfs:label "Crouch gait" ;
    dcterms:description "A gait disturbance that is characterized by excessive ankle dorsiflexion, knee and hip flexion during the stance phase."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025693> rdfs:label "Pituitary macroadenoma" ;
    dcterms:description "A pituitary gland adenoma that is larger than 10mm." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pituitary gland macroadenoma"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pituitary gland macroadenoma" .

<http://purl.obolibrary.org/obo/HP_0025700> rdfs:label "Anhydramnios"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A complete or near-complete lack of amniotic fluid surrounding a fetus. This finding can be observed sonographically in the third trimesters if the deepest pocket of amniotic fluid is less than or equal to 2 cm."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025711> rdfs:label "Convergence-retraction nystagmus" ;
    dcterms:description "Convergence-retraction nystagmus is an irregular, jerky nystagmus in which both eyeballs rhythmically converge and retract into the orbit, particularly on attempting an upward gaze." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Convergence retraction nystagmus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Convergence retraction nystagmus"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0025714> rdfs:label "Cerebral cortical microinfarct"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An infarct located on the outer layer of the cerebrum that can only be observed microscopically. Cerebral microinfarcts are typically defined as sharply delimited microscopic regions of cellular death or tissue necrosis, sometimes with cavitation (that is, a central fluid-filled cavity). The term microscopic denotes that these lesions are not visible by gross inspection of the brain but seen by light microscopy. The term infarct is most commonly used for ischemia-related tissue loss, and indeed the pathologic appearance of microinfarcts is consistent with that of known ischemic infarctions." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025721> rdfs:label "Limited vertical extraocular movement" ;
    dcterms:description "Limited mobility of the eye to move up and down (vertically) within its socket."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025732> rdfs:label "Abnormal social development"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A substantial lag in the achievement of or divergence from typical milestones in social interaction and communication skills. Social-emotional competencies in young children include helping, sharing, comforting, and exhibiting empathy and compliance." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0025747> rdfs:label "Tongue spasticity" ;
    dcterms:description "Spasticity (velocity-dependent increase in tonic stretch reflexes with increased muscle tone and hyperexcitable tendon reflexes) in the muscles of the tongue." ;
    ns1:category ns1:PhenotypicFeature .

<http://purl.obolibrary.org/obo/HP_0030000> rdfs:label "EMG: repetitive nerve stimulation abnormality" ;
    dcterms:description "Abnormality observed upon electromyography when nerve studied is electrically stimulated six to ten times at 2 or 3 Hertz."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022681" .

<http://purl.obolibrary.org/obo/HP_0030002> rdfs:label "Nocturnal lagophthalmos" ;
    dcterms:description "The inability to close the eyelids during sleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Eyelids stay open at night",
        "Inability to close the eyelids at night" ;
    ns1:synonym "Inability to close the eyelids at night"^^<http://example.org/invalidDatatype>,
        "Eyelids stay open at night" ;
    ns1:xref "SNOMEDCT_US:417740005",
        "UMLS:C1563118" .

<http://purl.obolibrary.org/obo/HP_0030006> rdfs:label "Single fiber EMG abnormality" ;
    dcterms:description "Abnormality in single fiber EMG recording, a technique that allows identification of action potentials (APs) from individual muscle fibers." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Single fibre EMG abnormality" ;
    ns1:synonym "Single fibre EMG abnormality" ;
    ns1:xref "UMLS:C4022679"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030026> rdfs:label "Squared superior portion of helix" ;
    dcterms:description "Flattening instead of curving or rounded superior helix, allowing the superior helix to run more horizontally than usual."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022671" .

<http://purl.obolibrary.org/obo/HP_0030031> rdfs:label "Small toe"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Significant reduction in both length and girth of the toe compared to the contralateral toe, or alternatively, compared to a typical toe size for an age-matched individual." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Small toe" ;
    ns1:synonym "Small toe"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022667" .

<http://purl.obolibrary.org/obo/HP_0030033> rdfs:label "Small finger" ;
    dcterms:description "Significant reduction in both length and girth of the finger compared to the contralateral finger, or alternatively, compared to a typical finger size for an age-matched individual." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Small finger" ;
    ns1:synonym "Small finger"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:299058009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0575827" .

<http://purl.obolibrary.org/obo/HP_0030037> rdfs:label "Bifid ureter" ;
    dcterms:description "Incomplete duplication of the ureter."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C3887498"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030038> rdfs:label "Enchondroma" ;
    dcterms:description "A solitary, benign, intramedullary cartilage tumor that is often found in the short tubular bones of the hands and feet, distal femur, and proximal humerus." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:31186001"^^<http://example.org/invalidDatatype>,
        "UMLS:C1704356"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:423699002" .

<http://purl.obolibrary.org/obo/HP_0030053> rdfs:label "Stiff skin" ;
    dcterms:description "An induration (hardening) of the skin" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Stiff skin"^^<http://example.org/invalidDatatype>,
        "Indurated skin",
        "Skin induration" ;
    ns1:synonym "Indurated skin"^^<http://example.org/invalidDatatype>,
        "Skin induration"^^<http://example.org/invalidDatatype>,
        "Stiff skin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C3276815" .

<http://purl.obolibrary.org/obo/HP_0030067> rdfs:label "Peripheral primitive neuroectodermal neoplasm" ;
    dcterms:description "A primitive neuroectodermal neoplasm that occurs extracranially in soft tissue and bone." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0684337"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:253096008",
        "SNOMEDCT_US:703707001",
        "SNOMEDCT_US:73676002" .

<http://purl.obolibrary.org/obo/HP_0030070> rdfs:label "Central primitive neuroectodermal tumor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A primitive neuroectodermal neoplasm that occurs in the central nervous system." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Central primitive neuroectodermal tumour" ;
    ns1:synonym "Central primitive neuroectodermal tumour"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:39781001"^^<http://example.org/invalidDatatype>,
        "UMLS:C3887678" .

<http://purl.obolibrary.org/obo/HP_0030078> rdfs:label "Lung adenocarcinoma"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C2852"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:254626006",
        "UMLS:C0152013" .

<http://purl.obolibrary.org/obo/HP_0030082> rdfs:label "Abnormal drinking behavior"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal consumption of fluids with excessive or insufficient consumption of fluid or any other abnormal pattern of fluid consumption."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal drinking behavior",
        "Abnormal drinking behaviour" ;
    ns1:synonym "Abnormal drinking behavior",
        "Abnormal drinking behaviour" ;
    ns1:xref "UMLS:C4022657" .

<http://purl.obolibrary.org/obo/HP_0030083> rdfs:label "Salt craving" ;
    dcterms:description "Hypersalivation, also known as salt craving, refers to an excessive desire to consume salt (sodium chloride) or salty foods."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Salt craving" ;
    ns1:synonym "Salt craving" ;
    ns1:xref "UMLS:C0240928"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030089> rdfs:label "Abnormal muscle fiber protein expression"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomalous amount of protein present in or on the surface of muscle fibers. This feature may be appreciate upon immunohistochemical investigation of muscle biopsy tissue." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal muscle fibre protein expression" ;
    ns1:synonym "Abnormal muscle fibre protein expression"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022653"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030092> rdfs:label "Reduced muscle fiber merosin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A reduced amount of merosin in muscle fibers. This feature is usually assessed by immunohistochemical examination of muscle biopsy tissue."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reduced muscle fibre merosin"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reduced muscle fibre merosin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022651"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030097> rdfs:label "Absent muscle dystrophin expression" ;
    dcterms:description "Lack of dystrophin in muscle tissue. Immunohistochemistry reveals absent dystrophin protein in the muscle biopsy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022647" .

<http://purl.obolibrary.org/obo/HP_0030114> rdfs:label "Absent muscle fiber dysferlin" ;
    dcterms:description "Immunohistochemistry shows complete lack of dysferlin protein in the muscle biopsy."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent muscle fibre dysferlin" ;
    ns1:synonym "Absent muscle fibre dysferlin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022631"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030143> rdfs:label "Hyperactive bowel sounds"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally increased gurgling/rumbling sounds made by the movement of fluid and gas in the intestines." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Borborygmi"^^<http://example.org/invalidDatatype>,
        "Increased bowel sounds" ;
    ns1:synonym "Increased bowel sounds"^^<http://example.org/invalidDatatype>,
        "Borborygmi" ;
    ns1:xref "SNOMEDCT_US:18101008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0232694" .

<http://purl.obolibrary.org/obo/HP_0030144> rdfs:label "Hypoactive bowel sounds"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An decreased amount of bowel sounds." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased bowel sounds"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Decreased bowel sounds"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:15280003",
        "UMLS:C0232695" .

<http://purl.obolibrary.org/obo/HP_0030146> rdfs:label "Abnormal liver parenchyma morphology" ;
    dcterms:description "A structural anomaly of the liver located predominantly in the hepatocytes as opposed to stromal cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022605" .

<http://purl.obolibrary.org/obo/HP_0030149> rdfs:label "Cardiogenic shock" ;
    dcterms:description "Severely decreased cardiac output with evidence of inadequate end-organ perfusion (i.e., tissue hypoxia) in the presence of adequate intravascular volume."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cardiovascular shock" ;
    ns1:synonym "Cardiovascular shock"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:89138009",
        "UMLS:C0036980" .

<http://purl.obolibrary.org/obo/HP_0030151> rdfs:label "Cholangitis" ;
    dcterms:description "Inflammation of the biliary ductal system, affecting the intrahepatic or extrahepatic portions, or both." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bile duct inflammation"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Bile duct inflammation"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:82403002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0008311"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030155> rdfs:label "Scrotal pain" ;
    dcterms:description "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the scrotum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Scrotal pain" ;
    ns1:synonym "Scrotal pain"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:20502007",
        "UMLS:C0236078" .

<http://purl.obolibrary.org/obo/HP_0030175> rdfs:label "Myelin tomacula" ;
    dcterms:description "The presence of multiple sausage-shaped swellings of the myelin sheath (The Latin tomaculum means sausage)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tomacula"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tomacula"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4020904"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030182> rdfs:label "Tetraplegia/tetraparesis" ;
    dcterms:description "Loss of strength in all four limbs. Tetraplegia refers to a complete loss of strength, whereas Tetraparesis refers to an incomplete loss of strength." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022595"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030183> rdfs:label "Impaired visually enhanced vestibulo-ocular reflex" ;
    dcterms:description "The vestibulo-ocular reflex is responsible for the stabilization of the retinal image during movement. The visual vestibular ocular reflex (VVOR) or visual enhanced VOR, maintains ocular stability during head motion by generating compensatory eye movement opposite to head movement, and is a major component of visual vestibular interaction. This feature is an impairment of this reflex, manifested as the combined impairment of the three compensatory eye movement reflexes, namely the vestibulo-ocular reflex (VOR), smooth pursuit (SP) and optokinetic reflex (OKR)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "VVOR impairment"^^<http://example.org/invalidDatatype>,
        "Visually enhanced vestibulo-ocular reflex impairment" ;
    ns1:synonym "VVOR impairment"^^<http://example.org/invalidDatatype>,
        "Visually enhanced vestibulo-ocular reflex impairment" ;
    ns1:xref "UMLS:C4021047"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030190> rdfs:label "Oral motor hypotonia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Reduced muscle tone of oral musculature. In infants, this feature may be associated with difficulties in breast feeding, and may affect the latch, jaw motions, tongue placement, lip seal, suck/swallow/breathe pattern and overall feeding behavior." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022592"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030193> rdfs:label "Fatigable weakness of chewing muscles" ;
    dcterms:description "A type of weakness of the muscles involved in chewing that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022590"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030199> rdfs:label "Fatigable weakness of neck muscles" ;
    dcterms:description "A type of weakness of a skeletal muscle in the neck that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022584" .

<http://purl.obolibrary.org/obo/HP_0030203> rdfs:label "Unfavorable response of muscle weakness to acetylcholine esterase inhibitors" ;
    dcterms:description "Lack of improvement of muscle strength in response to administration of an acetylcholine esterase inhibitor."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Unfavourable response of muscle weakness to acetylcholine esterase inhibitors"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Unfavourable response of muscle weakness to acetylcholine esterase inhibitors"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022580" .

<http://purl.obolibrary.org/obo/HP_0030209> rdfs:label "Calcium channel antibody positivity" ;
    dcterms:description "The presence of autoantibodies (immunoglobulins) in the serum that react against voltage-gated calcium channels." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ca channel antibody positivity"^^<http://example.org/invalidDatatype>,
        "Ca2+ channel antibody positivity" ;
    ns1:synonym "Ca channel antibody positivity"^^<http://example.org/invalidDatatype>,
        "Ca2+ channel antibody positivity"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022577" .

<http://purl.obolibrary.org/obo/HP_0030218> rdfs:label "Punding"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Punding is a stereotypical motor behavior characterized by an intense fascination with repetitive, excessive and non-goal oriented handling, and examining of objects." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1963933" .

<http://purl.obolibrary.org/obo/HP_0030219> rdfs:label "Semantic dementia" ;
    dcterms:description "A progressive loss of the ability to remember the meaning of words, faces and objects." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "Trouble remembering words"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Trouble remembering words" ;
    ns1:xref "SNOMEDCT_US:230288001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0338462"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030225> rdfs:label "Accumulation of muscle fiber desmin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Immunohistochemistry shows accumulation of desmin protein in the muscle biopsy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Accumulation of muscle fibre desmin"^^<http://example.org/invalidDatatype>,
        "Muscle fiber desmin-reactive inclusion bodies"^^<http://example.org/invalidDatatype>,
        "Muscle fibre desmin-reactive inclusion bodies" ;
    ns1:synonym "Muscle fiber desmin-reactive inclusion bodies"^^<http://example.org/invalidDatatype>,
        "Muscle fibre desmin-reactive inclusion bodies"^^<http://example.org/invalidDatatype>,
        "Accumulation of muscle fibre desmin" ;
    ns1:xref "UMLS:C4021043"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030226> rdfs:label "Abnormal muscle fiber myotilin"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A deviation from normal in the expression of myotilin in muscle tissue. Myotilin is a 57kDa cytoskeletal protein."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal muscle fibre myotilin"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormal muscle fibre myotilin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022572" .

<http://purl.obolibrary.org/obo/HP_0030227> rdfs:label "Accumulation of muscle fiber myotilin" ;
    dcterms:description "Immunohistochemistry shows accumulation of myotilin protein in the muscle biopsy." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Accumulation of muscle fibre myotilin"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Accumulation of muscle fibre myotilin"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022571"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030236> rdfs:label "Abnormality of muscle size" ;
    dcterms:description "Abnormalities of the overall muscle bulk based on clinical observation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of muscle size" ;
    ns1:synonym "Abnormality of muscle size" ;
    ns1:xref "UMLS:C4022563" .

<http://purl.obolibrary.org/obo/HP_0030252> rdfs:label "Absent circulating B cells"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of detectable circulating B cells, commonly characterized as CD19+ or CD20+ lymphocytes, in the blood. Usually, less than 20 cells per microlitre is considered to be an absence."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absence of mature B cells" ;
    ns1:synonym "Absence of mature B cells" ;
    ns1:xref "UMLS:C4022558"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030261> rdfs:label "Absent penis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Lack of recognizable penile structures."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent penis"^^<http://example.org/invalidDatatype>,
        "Aplasia of the penis"^^<http://example.org/invalidDatatype>,
        "Aphallia",
        "Penis aplasia" ;
    ns1:synonym "Aphallia"^^<http://example.org/invalidDatatype>,
        "Absent penis",
        "Aplasia of the penis",
        "Penis aplasia" ;
    ns1:xref "SNOMEDCT_US:204908001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:59981001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0555231"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030272> rdfs:label "Abnormal erythrocyte enzyme concentration or activity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An altered level of any enzyme to act as catalysts within erythrocytes. This term includes changes due to altered activity of an enzyme." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal erythrocyte enzyme level" ;
    ns1:synonym "Abnormal erythrocyte enzyme level" ;
    ns1:xref "UMLS:C4022545"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030283> rdfs:label "Partial absence of the septum pellucidum"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Only part of the septum pellucidum (a thin, triangular, vertical membrane separating the lateral ventricles of the brain) is present. This feature can be appreciated on magnetic resonance tomography or computed tomography of the brain." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:422474003"^^<http://example.org/invalidDatatype>,
        "UMLS:C1827299" .

<http://purl.obolibrary.org/obo/HP_0030284> rdfs:label "Triangular tongue"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of macrogloassia (increased size of the tongue) characterized by a broad based root of the tongue but a small tongue tip, giving the appearance of a triangle."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Triangle shaped tongue",
        "Triangular tongue" ;
    ns1:synonym "Triangular tongue"^^<http://example.org/invalidDatatype>,
        "Triangle shaped tongue" ;
    ns1:xref "UMLS:C4022537"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030301> rdfs:label "Abnormality of the anterior commissure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An anomaly of the anterior commissure, a bundle of nerve fibers that connect the two cerebral hemispheres across the midline. The anterior commissure plays a role in pain sensation and contains decussating fibers from the olfactory tracts." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022525"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030311> rdfs:label "Lower extremity joint dislocation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Displacement or malalignment of one or more joints in the lower extremity (leg)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dislocated leg joints"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dislocated leg joints"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4022516"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030321> rdfs:label "Abnormal vertebral artery morphology" ;
    dcterms:description "An anomaly of the vertebral artery, the major artery of the neck that originates from the subclavian artery and merges to form the single midline basilar artery in a complex called the vertebrobasilar system." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the vertebral artery" ;
    ns1:synonym "Abnormality of the vertebral artery" ;
    ns1:xref "UMLS:C4022512"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030348> rdfs:label "Increased circulating androgen concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An elevation of the blood concentration of an androgen, that is, of a steroid hormone that controls development and maintenance of masculine characteristics. The androgens include testosterone and Dehydroepiandrosterone." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hyperandrogenemia"^^<http://example.org/invalidDatatype>,
        "Increased circulating androgen level"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Increased circulating androgen level"^^<http://example.org/invalidDatatype>,
        "Hyperandrogenemia" ;
    ns1:xref "UMLS:C4072893"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030360> rdfs:label "Large cell lung carcinoma" ;
    dcterms:description "A type of non-small cell lung carcinoma that is derived from undifferentiated malignant neoplasms originating from transformed epithelial cells in the lung, and which is differentiate from small-cell lung carcinoma by the larger size of the anaplastic cells, a higher cytoplasmic-to-nuclear size ratio, and a lack of salt-and-pepper appearance of the chromatin." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:254629004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0345958"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030392> rdfs:label "Choroid plexus carcinoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Intraventricular papillary neoplasm derived from choroid plexus epithelium. Plexus tumors are most common in the lateral and fourth ventricles; while 80% of lateral ventricle tumors present in children, fourth ventricle tumors are evenly distributed in all age groups. Clinically, choroid plexus tumors tend to cause hydrocephalus and increased intracranial pressure. Histologically, choroid plexus papillomas correspond to WHO grade I, choroid plexus carcinomas to WHO grade III." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:88252006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0431109" .

<http://purl.obolibrary.org/obo/HP_0030393> rdfs:label "Endolymphatic sac tumor"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A low-grade papillary epithelial neoplasm (adenocarcinoma) with a slow growth pattern. The endolymphatic duct emerges from the posterior wall of the saccule (of the inner ear) and ends in a blind pouch, the endolymphatic sac. Endolymphatic sac tumors (ELSTs) are known under different names in the literature (Heffner tumor, aggressive papillary middle ear tumor, and low-grade adenocarcinoma of endolymphatic sac origin)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aggressive papillary middle ear tumor"^^<http://example.org/invalidDatatype>,
        "Aggressive papillary middle ear tumour"^^<http://example.org/invalidDatatype>,
        "Endolymphatic sac tumour"^^<http://example.org/invalidDatatype>,
        "Heffner tumor"^^<http://example.org/invalidDatatype>,
        "Heffner tumour",
        "Low-grade adenocarcinoma of endolymphatic sac origin" ;
    ns1:synonym "Heffner tumour"^^<http://example.org/invalidDatatype>,
        "Low-grade adenocarcinoma of endolymphatic sac origin"^^<http://example.org/invalidDatatype>,
        "Aggressive papillary middle ear tumor",
        "Aggressive papillary middle ear tumour",
        "Endolymphatic sac tumour",
        "Heffner tumor" ;
    ns1:xref "SNOMEDCT_US:699817008",
        "UMLS:C2348239" .

<http://purl.obolibrary.org/obo/HP_0030402> rdfs:label "Abnormal platelet aggregation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality in the rate and degree to which platelets aggregate after the addition of an agonist that stimulates platelet clumping. Platelet aggregation is measured using aggregometer to measure the optical density of platelet-rich plasma, whereby platelet aggregation causes the plasma to become more transparent." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0541767"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0030408> rdfs:label "Pineoblastoma" ;
    dcterms:description "Pineoblastoma is a rare primitive neuroectodermal tumor (PNET) arising in the pineal gland. Pineoblastomas are classified as a WHO grade IV tumor and comprise one-fourth to one-half of pineal parenchymal tumors. Pineoblastoma is a highly cellular tumor originating in the pineal gland and containing small, poorly differentiated cells." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pinealoblastoma"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pinealoblastoma"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:31671006",
        "UMLS:C0205898" .

<http://purl.obolibrary.org/obo/HP_0030409> rdfs:label "Renal transitional cell carcinoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A malignant tumor that arises from the transitional (urothelial) epithelial cells lining the urinary tract from the renal calyces to the ureteral orifice."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "renal TCC"^^<http://example.org/invalidDatatype>,
        "Renal urothelial carcinoma",
        "Transitional renal cell carcinoma" ;
    ns1:synonym "Renal urothelial carcinoma"^^<http://example.org/invalidDatatype>,
        "Transitional renal cell carcinoma"^^<http://example.org/invalidDatatype>,
        "renal TCC"^^<http://example.org/invalidDatatype> ;
