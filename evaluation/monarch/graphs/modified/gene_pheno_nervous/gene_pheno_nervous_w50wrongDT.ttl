<http://purl.obolibrary.org/obo/HP_0010762> rdfs:label "Chordoma" ;
    dcterms:description "A chordoma is a tumor that arises from embryonic remnants of the notochord along the length of the neuraxis. Chordomas generally occur in the sacrum, intracranially at the clivus, or along the spinal axis." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C2947",
        "SNOMEDCT_US:50007008",
        "UMLS:C0008487" .

<http://purl.obolibrary.org/obo/HP_0010773> rdfs:label "Partial anomalous pulmonary venous return"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of anomalous pulmonary venous return in which not all pulmonary veins drain abnormally. Partial anomalous pulmonary venous return frequently involves one or both of the veins from one lung." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Partial anomalous pulmonary venous connection"^^<http://example.org/invalidDatatype>,
