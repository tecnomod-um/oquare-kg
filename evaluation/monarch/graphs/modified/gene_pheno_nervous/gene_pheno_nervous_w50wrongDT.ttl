        "UMLS:C0031039"^^<http://example.org/invalidDatatype>,
        "Fyler:1940" .

<http://purl.obolibrary.org/obo/HP_0001959> rdfs:label "Polydipsia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excessive thirst manifested by excessive fluid intake." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Extreme thirst" ;
    ns1:synonym "Extreme thirst"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:17173007"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:267026004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085602"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001989> rdfs:label "Fetal akinesia sequence" ;
    dcterms:description "Decreased fetal activity associated with multiple joint contractures, facial anomalies and pulmonary hypoplasia. Ultrasound examination may reveal polyhydramnios, ankylosis, scalp edema, and decreased chest movements (reflecting pulmonary hypoplasia)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Foetal akinesia sequence"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Early severe fetal akinesia sequence"^^<http://example.org/invalidDatatype>,
        "Fetal akinesia"^^<http://example.org/invalidDatatype>,
        "Foetal akinesia"^^<http://example.org/invalidDatatype>,
        "Early severe foetal akinesia sequence" ;
    ns1:synonym "Fetal akinesia"^^<http://example.org/invalidDatatype>,
        "Foetal akinesia sequence"^^<http://example.org/invalidDatatype>,
        "Early severe fetal akinesia sequence",
        "Early severe foetal akinesia sequence",
        "Foetal akinesia" ;
    ns1:xref "SNOMEDCT_US:401138005"^^<http://example.org/invalidDatatype>,
        "UMLS:C3151520"^^<http://example.org/invalidDatatype>,
        "UMLS:C1276035" .

<http://purl.obolibrary.org/obo/HP_0001992> rdfs:label "Organic aciduria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Excretion of non-amino organic acids in urine." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0241775"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002077> rdfs:label "Migraine with aura" ;
    dcterms:description "A type of migraine in which there is an aura characterized by focal neurological phenomena that usually proceed, but may accompany or occur in the absence of, the headache. The symptoms of an aura may include fully reversible visual, sensory, and speech symptoms but not motor weakness. Visual symptoms may include flickering lights, spots and lines and/or loss of vision and/or unilateral sensory symptoms such as paresthesias or numbness. At least one of the symptoms of an aura develops gradually over 5 or more minutes and/or different symptoms occur in succession." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:4473006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0154723" .

<http://purl.obolibrary.org/obo/HP_0002139> rdfs:label "Arrhinencephaly" ;
    dcterms:description "A defect of development of the brain characterized by congenital absence of the part of the brain that includes the olfactory bulbs, tracts, and other structures associated with the sense of smell." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Arhinencephaly"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Arhinencephaly" ;
    ns1:xref "UMLS:C0078982"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002164> rdfs:label "Nail dysplasia" ;
    dcterms:description "The presence of developmental dysplasia of the nail."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Atypical nail growth"^^<http://example.org/invalidDatatype>,
        "Dysplastic nails"^^<http://example.org/invalidDatatype>,
        "Onychodysplasia" ;
    ns1:synonym "Dysplastic nails"^^<http://example.org/invalidDatatype>,
        "Atypical nail growth",
        "Onychodysplasia" ;
    ns1:xref "UMLS:C1834405" .

<http://purl.obolibrary.org/obo/HP_0002196> rdfs:label "Myelopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Myelopathy is an descriptive term, referring to pathology leading to a neurologic deficit related to the spinal cord. The clinical diagnosis of myelopathy requires a detailed history and physical examination to define the clinical syndrome. Neuroimaging is indicated in most instances of new-onset myelopathy. It is indicated also when the worsening of a myelopathy is unexplained."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:48522003",
        "UMLS:C0037928" .

<http://purl.obolibrary.org/obo/HP_0002326> rdfs:label "Transient ischemic attack" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Transient ischaemic attack"^^<http://example.org/invalidDatatype>,
        "Mini stroke",
        "TIA",
        "Transient ischaemic attacks",
        "Transient ischemic attacks" ;
    ns1:synonym "Mini stroke"^^<http://example.org/invalidDatatype>,
        "TIA"^^<http://example.org/invalidDatatype>,
        "Transient ischemic attacks"^^<http://example.org/invalidDatatype>,
        "Transient ischaemic attack",
        "Transient ischaemic attacks" ;
    ns1:xref "UMLS:C0917805" .

<http://purl.obolibrary.org/obo/HP_0002331> rdfs:label "Recurrent paroxysmal headache"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Repeated episodes of headache with rapid onset, reaching a peak within minutes and of short duration (less than one hour) with pain that is throbbing, pulsating, or bursting in quality."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1854337" .

<http://purl.obolibrary.org/obo/HP_0002410> rdfs:label "Aqueductal stenosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Stenosis of the cerebral aqueduct (also known as the mesencephalic duct, aqueductus mesencephali, or aqueduct of Sylvius), which connects the third cerebral ventricle in the diencephalon to the fourth ventricle, which is between the pons and cerebellum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Aqueduct of Sylvius stenosis"^^<http://example.org/invalidDatatype>,
        "Aqueduct stenosis"^^<http://example.org/invalidDatatype>,
        "Narrowing of aqueduct of Sylvius"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Aqueduct of Sylvius stenosis"^^<http://example.org/invalidDatatype>,
        "Narrowing of aqueduct of Sylvius"^^<http://example.org/invalidDatatype>,
        "Aqueduct stenosis" ;
    ns1:xref "UMLS:C2936786" .

<http://purl.obolibrary.org/obo/HP_0002448> rdfs:label "Progressive encephalopathy"^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Progressive brain disease"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:synonym "Progressive brain disease" ;
    ns1:xref "UMLS:C1838578",
        "UMLS:C4280575" .

<http://purl.obolibrary.org/obo/HP_0002470> rdfs:label "Nonprogressive cerebellar ataxia" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1845029" .

<http://purl.obolibrary.org/obo/HP_0002533> rdfs:label "Abnormal posturing"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Involuntary flexion or extension of the arms and legs." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:43029002",
        "UMLS:C0231471" .

<http://purl.obolibrary.org/obo/HP_0002571> rdfs:label "Achalasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A disorder of esophageal motility characterized by the inability of the lower esophageal sphincter to relax during swallowing and by inadequate or lacking peristalsis in the lower half of the body of the esophagus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Achalasia of the oesophagus"^^<http://example.org/invalidDatatype>,
        "Achalasia of the esophagus" ;
    ns1:synonym "Achalasia of the esophagus",
        "Achalasia of the oesophagus" ;
    ns1:xref "MEDDRA:10030136"^^<http://example.org/invalidDatatype>,
        "UMLS:C0014848"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:45564002" .

<http://purl.obolibrary.org/obo/HP_0002637> rdfs:label "Cerebral ischemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Restriction of arterial blood supply to the brain associated with insufficient oxygenation to support the metabolic requirements of the tissue."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cerebrovascular ischemia"^^<http://example.org/invalidDatatype>,
        "Brain ischemia",
        "Disruption of blood oxygen supply to brain" ;
    ns1:synonym "Disruption of blood oxygen supply to brain"^^<http://example.org/invalidDatatype>,
        "Brain ischemia",
        "Cerebrovascular ischemia" ;
    ns1:xref "SNOMEDCT_US:287731003"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:389100007",
        "UMLS:C0007786",
        "UMLS:C0917798" .

<http://purl.obolibrary.org/obo/HP_0002659> rdfs:label "Increased susceptibility to fractures" ;
    dcterms:description "An abnormally increased tendency to fractures of bones caused by an abnormal reduction in bone strength that is generally associated with an increased risk of fracture." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormal susceptibility to fractures"^^<http://example.org/invalidDatatype>,
        "Bone fragility"^^<http://example.org/invalidDatatype>,
        "Increased susceptibility to fractures"^^<http://example.org/invalidDatatype>,
        "Increased tendency to fractures"^^<http://example.org/invalidDatatype>,
        "Frequent broken bones",
        "Increased bone fragility" ;
    ns1:synonym "Abnormal susceptibility to fractures"^^<http://example.org/invalidDatatype>,
        "Increased bone fragility"^^<http://example.org/invalidDatatype>,
        "Increased susceptibility to fractures"^^<http://example.org/invalidDatatype>,
        "Bone fragility",
        "Frequent broken bones",
        "Increased tendency to fractures" ;
    ns1:xref "UMLS:C1390474" .

<http://purl.obolibrary.org/obo/HP_0002668> rdfs:label "Paraganglioma" ;
    dcterms:description "A carotid body tumor (also called paraganglionoma or chemodectoma) is a tumor found in the upper neck at the branching of the carotid artery. They arise from the chemoreceptor organ (paraganglion) located in the adventitia of the carotid artery bifurcation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Carotid body tumors"^^<http://example.org/invalidDatatype>,
        "Carotid body tumours"^^<http://example.org/invalidDatatype>,
        "Paragangliomas" ;
    ns1:synonym "Carotid body tumors"^^<http://example.org/invalidDatatype>,
        "Carotid body tumours",
        "Paragangliomas" ;
    ns1:xref "NCIT:C3308"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:127027008"^^<http://example.org/invalidDatatype>,
