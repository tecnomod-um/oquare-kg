<http://purl.obolibrary.org/obo/MONDO_0017279> rdfs:label "young-onset Parkinson disease" ;
    dcterms:description "A form of Parkinson disease (PD) characterized by an age of onset between 21-45 years, rigidity, painful cramps followed by tremor, bradykinesia, dystonia, gait complaints and falls, and other non-motor symptoms. A slow disease progression and a more pronounced response to dopaminergic therapy are also observed in most YOPD forms."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "early-onset Parkinson disease"^^<http://example.org/invalidDatatype>,
