    ns1:xref "SNOMEDCT_US:40159009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0024433"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0003196> rdfs:label "Short nose" ;
    dcterms:description "Distance from nasion to subnasale more than two standard deviations below the mean, or alternatively, an apparently decreased length from the nasal root to the nasal tip." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Short nose"^^<http://example.org/invalidDatatype>,
