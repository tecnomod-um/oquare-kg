<http://purl.obolibrary.org/obo/HP_0000824> rdfs:label "Decreased response to growth hormone stimulation test" ;
    dcterms:description "Insufficient responses to growth hormone (GH) provocation tests. GH deficiency is defined as a serum peak GH concentration less than 10 ng/mL on provocation with a combination of at least two separate stimulation tests." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:2109003",
        "UMLS:C3714796" .

<http://purl.obolibrary.org/obo/HP_0001305> rdfs:label "Dandy-Walker malformation" ;
    dcterms:description "A congenital brain malformation typically characterized by incomplete formation of the cerebellar vermis, dilation of the fourth ventricle, and enlargement of the posterior fossa. In layman's terms, Dandy Walker malformation is a cyst in the cerebellum (typically symmetrical) that is involved with the fourth ventricle. This may interfere with the ability to drain cerebrospinal fluid from the brain, resulting in hydrocephalus. Dandy Walker cysts are formed during early embryonic development, while the brain forms. The cyst in the cerebellum typically has several blood vessels running through it connecting to the brain, thereby prohibiting surgical removal." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dandy-Walker cyst"^^<http://example.org/invalidDatatype>,
        "Dandy-walker anomaly"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dandy-Walker cyst"^^<http://example.org/invalidDatatype>,
        "Dandy-walker anomaly" ;
    ns1:xref "SNOMEDCT_US:14447001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0010964"^^<http://example.org/invalidDatatype> .

