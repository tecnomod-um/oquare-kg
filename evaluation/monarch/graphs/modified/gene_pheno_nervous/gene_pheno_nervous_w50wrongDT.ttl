<http://purl.obolibrary.org/obo/HP_0003552> rdfs:label "Muscle stiffness" ;
    dcterms:description "A condition in which muscles cannot be moved quickly without accompanying pain or spasm." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:16046003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0221170" .

<http://purl.obolibrary.org/obo/HP_0008997> rdfs:label "Proximal upper limb muscle weakness"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A lack of strength of the proximal muscles of the arms." ;
    ns1:category ns1:PhenotypicFeature ;
