        "UMLS:C1696701"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012407> rdfs:label "Scissor gait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of spastic paraparetic gait in which the muscle tone in the adductors is marked. It is characterized by hypertonia and flexion in the legs, hips and pelvis accompanied by extreme adduction leading to the knees and thighs hitting, or sometimes even crossing, in a scissors-like movement. The opposing muscles (abductors) become comparatively weak from lack of use." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Scissor gait"^^<http://example.org/invalidDatatype>,
        "Scissoring gait"^^<http://example.org/invalidDatatype>,
        "Scissor walk",
        "Scissoring of the lower extremities",
        "Scissoring of the lower limbs",
        "Scissors gait" ;
    ns1:synonym "Scissor gait"^^<http://example.org/invalidDatatype>,
        "Scissoring of the lower limbs"^^<http://example.org/invalidDatatype>,
        "Scissor walk",
        "Scissoring gait",
        "Scissoring of the lower extremities",
        "Scissors gait" ;
    ns1:xref "SNOMEDCT_US:22090007"^^<http://example.org/invalidDatatype>,
