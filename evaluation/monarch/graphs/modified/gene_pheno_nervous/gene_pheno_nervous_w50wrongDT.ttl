<http://purl.obolibrary.org/obo/HP_0000805> rdfs:label "Enuresis" ;
    dcterms:description "Lack of the ability to control the urinary bladder leading to involuntary urination at an age where control of the bladder should already be possible." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:8009008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0014394" .

<http://purl.obolibrary.org/obo/HP_0000845> rdfs:label "Elevated circulating growth hormone concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Acromegaly is a condition resulting from overproduction of growth hormone by the pituitary gland in persons with closed epiphyses, and consists chiefly in the enlargement of the distal parts of the body. The circumference of the skull increases, the nose becomes broad, the tongue becomes enlarged, the facial features become coarsened, the mandible grows excessively, and the teeth become separated. The fingers and toes grow chiefly in thickness."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Somatotropin excess"^^<http://example.org/invalidDatatype>,
