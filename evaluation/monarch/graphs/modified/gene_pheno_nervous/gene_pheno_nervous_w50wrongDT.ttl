<http://purl.obolibrary.org/obo/HP_0001909> rdfs:label "Leukemia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A cancer of the blood and bone marrow characterized by an abnormal proliferation of leukocytes."^^<http://example.org/invalidDatatype> ;
