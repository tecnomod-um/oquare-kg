<http://purl.obolibrary.org/obo/HP_0007766> rdfs:label "Optic disc hypoplasia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Underdevelopment of the optic disc, that is of the optic nerve head, where ganglion cell axons exit the eye to form the optic nerve." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypoplastic optic discs" ;
    ns1:synonym "Hypoplastic optic discs" ;
