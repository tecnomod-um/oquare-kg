        "Macrocephaly, relative"^^<http://example.org/invalidDatatype>,
        "Relatively large head"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:3961000119101"^^<http://example.org/invalidDatatype>,
        "UMLS:C1849075" .

