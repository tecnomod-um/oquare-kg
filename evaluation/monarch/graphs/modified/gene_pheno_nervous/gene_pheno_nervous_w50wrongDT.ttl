<http://purl.obolibrary.org/obo/HP_0010851> rdfs:label "EEG with burst suppression"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The burst suppression pattern in electroencephalography refers to a characteristic periodic pattern of low voltage (<10 microvolts) suppressed background and a relatively shorter pattern of higher amplitude slow, sharp, and spiking complexes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1969156" .

<http://purl.obolibrary.org/obo/HP_0025190> rdfs:label "Bilateral tonic-clonic seizure with generalized onset"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A bilateral tonic-clonic seizure with generalized onset is a type of bilateral tonic-clonic seizure characterized by generalized onset; these seizures rapidly engage networks in both hemispheres at the start of the seizure." ;
