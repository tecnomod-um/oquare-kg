        "UMLS:C1862475" .

<http://purl.obolibrary.org/obo/HP_0010535> rdfs:label "Sleep apnea" ;
    dcterms:description "An intermittent cessation of airflow at the mouth and nose during sleep is known as sleep apnea. Apneas that last at least 10 seconds are considered significant, but individuals with sleep apnea may experience apneas lasting from 20 seconds up to 2 or 3 minutes. Patients may have up to 15 events per hour of sleep." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pauses in breathing while sleeping"^^<http://example.org/invalidDatatype>,
        "Sleep apnea"^^<http://example.org/invalidDatatype>,
        "Sleep apnoea"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pauses in breathing while sleeping"^^<http://example.org/invalidDatatype>,
        "Sleep apnea"^^<http://example.org/invalidDatatype>,
        "Sleep apnoea" ;
    ns1:xref "UMLS:C0037315"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:73430006" .

