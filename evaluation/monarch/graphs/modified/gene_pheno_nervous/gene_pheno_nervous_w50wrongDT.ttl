        "UMLS:C4023528" .

<http://purl.obolibrary.org/obo/HP_0011123> rdfs:label "Inflammatory abnormality of the skin" ;
    dcterms:description "The presence of inflammation of the skin. That is, an abnormality of the skin resulting from the local accumulation of fluid, plasma proteins, and leukocytes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
