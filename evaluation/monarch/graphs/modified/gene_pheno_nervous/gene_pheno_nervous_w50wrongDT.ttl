<http://purl.obolibrary.org/obo/HP_0410145> rdfs:label "Decreased circulating biotinidase concentration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Concentration of biotinidase in the blood circulation below the lower limit of normal. Biotidinase is an enzyme that releases biotin from biocytin, the product of biotin-dependent carboxylases degradation."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decreased biotinidase level"^^<http://example.org/invalidDatatype> ;
