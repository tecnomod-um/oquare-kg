<http://purl.obolibrary.org/obo/MONDO_0016710> rdfs:label "medulloblastoma with extensive nodularity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Medulloblastoma with extensive nodularity (MBEN) is a histological variant of medulloblastoma, an embryonic malignancy, most often located in the inferior medullary velum and then growing into the fourth ventricle, and presenting in infants and young children with symptoms of increased intracranial pressure such as headache, listlessness, vomiting, diplopia and papilledema. It is often associated with Gorlin syndrome and has a relatively good prognosis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "MBEN"^^<http://example.org/invalidDatatype>,
        "medulloblastoma with extensive nodularity and advanced neuronal differentiation"^^<http://example.org/invalidDatatype>,
        "nodular medulloblastoma"^^<http://example.org/invalidDatatype>,
        "cerebellar neuroblastoma",
        "medulloblastoma with extensive nodularity" ;
    ns1:synonym "MBEN"^^<http://example.org/invalidDatatype>,
        "medulloblastoma with extensive nodularity"^^<http://example.org/invalidDatatype>,
