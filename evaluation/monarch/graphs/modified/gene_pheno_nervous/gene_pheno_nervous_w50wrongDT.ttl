    dcterms:description "An enduring pattern of uncooperative, defiant, and hostile behavior towards authority figures that does not involve major antisocial violations, is not accounted for by the child's developmental stage, and results in significant functional impairment. A certain level of oppositional behavior is common in children and adolescents."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "ODD"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "ODD"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:18941000",
        "UMLS:C0029121" .

<http://purl.obolibrary.org/obo/HP_0010873> rdfs:label "Cervical spinal cord atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atrophy of the cervical segment of the spinal cord." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0742191" .

<http://purl.obolibrary.org/obo/HP_0010945> rdfs:label "Fetal pyelectasis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Mild pyelectasis is defined as a hypoechoic spherical or elliptical space within the renal pelvis that measures at least 5mm and not more than 10 mm. The measurement is taken on a transverse section through the fetal renal pelvis using the maximum anterior-to-posterior measurement." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Foetal renal pelvic dilatation"^^<http://example.org/invalidDatatype>,
        "Mild fetal hydronephrosis"^^<http://example.org/invalidDatatype>,
        "Fetal renal pelvic dilatation",
        "Foetal pyelectasis",
        "Mild foetal hydronephrosis" ;
    ns1:synonym "Fetal renal pelvic dilatation"^^<http://example.org/invalidDatatype>,
        "Mild fetal hydronephrosis"^^<http://example.org/invalidDatatype>,
        "Foetal pyelectasis",
        "Foetal renal pelvic dilatation",
        "Mild foetal hydronephrosis" ;
    ns1:xref "SNOMEDCT_US:430035004"^^<http://example.org/invalidDatatype>,
        "UMLS:C2317073"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010994> rdfs:label "Abnormal corpus striatum morphology" ;
    dcterms:description "Abnormality of the striatum, which is the largest nucleus of the basal ganglia, comprising the caudate, putamen and ventral striatum, including the nucleus accumbens." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the neostriatum"^^<http://example.org/invalidDatatype>,
        "Abnormality of the striate nucleus"^^<http://example.org/invalidDatatype>,
