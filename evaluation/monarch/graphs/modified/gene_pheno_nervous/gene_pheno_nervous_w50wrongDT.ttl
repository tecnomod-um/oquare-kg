<http://purl.obolibrary.org/obo/MONDO_0010778> rdfs:label "cyclic vomiting syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare functional disorder characterized by recurrent, stereotypical episodes of severe nausea and vomiting separated by symptom-free intervals. Episodes are often accompanied by pallor, lethargy, and abdominal pain. The condition shows a strong association with migraine headaches and may have maternal inheritance patterns suggestive of mitochondrial involvement." ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "cyclic vomiting syndrome"^^<http://example.org/invalidDatatype> ;
