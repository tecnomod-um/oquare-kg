    ns1:synonym "tremors in hands"^^<http://example.org/invalidDatatype>,
        "Hand tremor",
        "Tremor of hand",
        "Tremor of hands" ;
    ns1:xref "UMLS:C0239842" .

<http://purl.obolibrary.org/obo/HP_0002827> rdfs:label "Hip dislocation" ;
    dcterms:description "Displacement of the femur from its normal location in the hip joint." ;
    ns1:category ns1:PhenotypicFeature ;
