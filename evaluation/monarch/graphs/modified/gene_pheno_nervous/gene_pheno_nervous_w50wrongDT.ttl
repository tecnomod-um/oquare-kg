<http://purl.obolibrary.org/obo/HP_0001272> rdfs:label "Cerebellar atrophy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Cerebellar atrophy is defined as a cerebellum with initially normal structures, in a posterior fossa with normal size, which displays enlarged fissures (interfolial spaces) in comparison to the foliae secondary to loss of tissue. Cerebellar atrophy implies irreversible loss of tissue and result from an ongoing progressive disease until a final stage is reached or a single injury, e.g. an intoxication or infectious event." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Atrophic cerebellum",
        "Degeneration of cerebellum" ;
    ns1:related_synonym "Infratentorial atrophy" ;
    ns1:synonym "Atrophic cerebellum"^^<http://example.org/invalidDatatype>,
        "Degeneration of cerebellum"^^<http://example.org/invalidDatatype>,
        "Infratentorial atrophy" ;
    ns1:xref "UMLS:C0740279"^^<http://example.org/invalidDatatype>,
        "UMLS:C4020873"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:95646004",
        "UMLS:C0262404" .

