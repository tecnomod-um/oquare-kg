<http://purl.obolibrary.org/obo/HP_0012199> rdfs:label "Cluster headache"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of headache characterized by repeated attacks of unilateral pain lasting 15 to 180 minutes and associated with local autonomic signs."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "ICD-10:G44.0"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:193031009"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:193947008"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:230473009",
        "UMLS:C0009088" .

<http://purl.obolibrary.org/obo/HP_0012280> rdfs:label "Hepatic amyloidosis" ;
    dcterms:description "A form of amyloidosis that affects the liver."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0267839"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:9551004" .

<http://purl.obolibrary.org/obo/HP_0012285> rdfs:label "Abnormal hypothalamus physiology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormal functionality of the hypothalamus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4022968" .

<http://purl.obolibrary.org/obo/HP_0012371> rdfs:label "Hyperplasia of midface"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally anterior positioning of the infraorbital and perialar regions, or increased convexity of the face, or increased nasolabial angle. The midface includes the maxilla, the cheeks, the zygomas, and the infraorbital and perialar regions of the face"^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Large midface"^^<http://example.org/invalidDatatype>,
        "Big midface" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Midface hyperplasia"^^<http://example.org/invalidDatatype>,
        "Midfacial excess"^^<http://example.org/invalidDatatype>,
        "Midfacial prominence"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Hypertrophy of midface"^^<http://example.org/invalidDatatype>,
        "Overgrowth of the midface" ;
    ns1:synonym "Big midface"^^<http://example.org/invalidDatatype>,
        "Large midface"^^<http://example.org/invalidDatatype>,
        "Midface hyperplasia"^^<http://example.org/invalidDatatype>,
