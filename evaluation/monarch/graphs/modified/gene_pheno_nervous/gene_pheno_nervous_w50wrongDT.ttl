        "Kidney Ca wasting",
        "Kidney Ca2+ wasting",
        "Kidney calcium wasting",
        "Renal Ca2+ wasting" ;
    ns1:xref "UMLS:C2673441"^^<http://example.org/invalidDatatype> .

