        "Stretch marks",
        "Striae atrophicae" ;
    ns1:synonym "Stretch marks"^^<http://example.org/invalidDatatype>,
        "Striae cutis distensae"^^<http://example.org/invalidDatatype>,
        "Purplish striae",
        "Striae",
        "Striae atrophicae" ;
    ns1:xref "MEDDRA:10040925",
        "SNOMEDCT_US:201066002",
        "SNOMEDCT_US:201067006",
        "SNOMEDCT_US:47212006",
        "UMLS:C0152459" .

