<http://purl.obolibrary.org/obo/MONDO_0971062> rdfs:label "developmental delay-language impairment-dopa responsive dystonia-parkinsonism syndrome due to a NR4A2 point mutation" ;
    dcterms:description "An intellectual developmental disorder with language impairment and early-onset DOPA-responsive dystonia-parkinsonism in which the cause of the disease is a point mutation in the gene NR4A2."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:xref "GARD:0027164"^^<http://example.org/invalidDatatype>,
        "MEDGEN:1863959"^^<http://example.org/invalidDatatype>,
