<http://purl.obolibrary.org/obo/HP_0002007> rdfs:label "Frontal bossing"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Bilateral bulging of the lateral frontal bone prominences with relative sparing of the midline."^^<http://example.org/invalidDatatype> ;
