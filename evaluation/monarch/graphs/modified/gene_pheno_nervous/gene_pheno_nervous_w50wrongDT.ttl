    ns1:synonym "Short-trunk dwarfism, identifiable in infancy"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1846061"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011413> rdfs:label "Shoulder dystocia" ;
    dcterms:description "Shoulder dystocia occurs when the fetal anterior shoulder impacts against the maternal symphysis following delivery of the vertex." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:89700002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0269825" .

<http://purl.obolibrary.org/obo/HP_0011444> rdfs:label "Decorticate rigidity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of rigidity in which the arms are in flexion and adduction and the legs are extended. This signifies a lesion in the cerebral white matter, internal capsules, or thalamus."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0231521"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:36423000" .

<http://purl.obolibrary.org/obo/HP_0011457> rdfs:label "Loss of eyelashes" ;
    dcterms:description "This term refers to the loss of eyelashes that were previously present." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ciliary Madarosis"^^<http://example.org/invalidDatatype>,
        "Eyelashes fell out"^^<http://example.org/invalidDatatype>,
        "Missing eyelashes"^^<http://example.org/invalidDatatype>,
        "Loss of eyelashes",
        "Milphosis" ;
    ns1:synonym "Ciliary Madarosis"^^<http://example.org/invalidDatatype>,
        "Eyelashes fell out"^^<http://example.org/invalidDatatype>,
        "Loss of eyelashes"^^<http://example.org/invalidDatatype>,
        "Milphosis"^^<http://example.org/invalidDatatype>,
        "Missing eyelashes" ;
    ns1:xref "SNOMEDCT_US:34887006",
        "UMLS:C0271321" .

<http://purl.obolibrary.org/obo/HP_0011458> rdfs:label "Abdominal symptom" ;
    dcterms:description "A subjective manifestation of disease localized to the abdomen."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0740651" .

<http://purl.obolibrary.org/obo/HP_0011474> rdfs:label "Childhood onset sensorineural hearing impairment"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Sensorineural hearing impairment with childhood onset."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023340" .

<http://purl.obolibrary.org/obo/HP_0011480> rdfs:label "Unilateral microphthalmos"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A developmental anomaly characterized by abnormal smallness of one eye." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormally small eyeball on one side" ;
    ns1:narrow_synonym "Unilateral nanophthalmos"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormally small eyeball on one side"^^<http://example.org/invalidDatatype>,
        "Unilateral nanophthalmos" ;
    ns1:xref "UMLS:C4280323"^^<http://example.org/invalidDatatype>,
        "UMLS:C3640024" .

<http://purl.obolibrary.org/obo/HP_0011488> rdfs:label "Abnormal corneal endothelium morphology"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormality of the corneal endothelium, that is, the single layer of cells on the inner surface of the cornea."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of corneal endothelium" ;
    ns1:synonym "Abnormality of corneal endothelium"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023332" .

<http://purl.obolibrary.org/obo/HP_0011497> rdfs:label "Rubeosis iridis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Formation of new blood vessels on the iris. The new vessels do not display the typical radially symmertic growth pattern of normal iris blood vessels, but rather appear disorganized. Rubeosis usually starts from the pupillary border with tiny tufts of dilated capillaries or red spots that can only be appreciated with high magnification."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Iris neovascularization",
        "Neovascularization of the iris",
        "New blood vessel formation in iris" ;
    ns1:synonym "New blood vessel formation in iris"^^<http://example.org/invalidDatatype>,
        "Iris neovascularization",
        "Neovascularization of the iris" ;
    ns1:xref "SNOMEDCT_US:51995000",
        "UMLS:C0154916" .

<http://purl.obolibrary.org/obo/HP_0011500> rdfs:label "Polycoria"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Multiple pupils." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Multiple pupils" ;
    ns1:synonym "Multiple pupils"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:204159004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0344544" .

<http://purl.obolibrary.org/obo/HP_0011507> rdfs:label "Macular flecks"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Pale, often indistinct, multiple lesions of the macula, of variable shape that is not round. The lesions can be notched, angular, or pisciform (said to resemble a fish)."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023322" .

<http://purl.obolibrary.org/obo/HP_0011513> rdfs:label "Retinal cavernous hemangioma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A benign tumor of the retina that appears as a grouping of blood-filled saccules within the inner retinal layers or on the surface of the optic disc. Retinal cavernous hemangioma are described as having a 'cluster of grapes' appearance."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Retinal cavernous angioma",
        "Retinal cavernous haemangioma" ;
    ns1:synonym "Retinal cavernous angioma"^^<http://example.org/invalidDatatype>,
        "Retinal cavernous haemangioma" ;
    ns1:xref "SNOMEDCT_US:312937006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0730304" .

<http://purl.obolibrary.org/obo/HP_0011514> rdfs:label "Abnormality of binocular vision" ;
    dcterms:description "An abnormality of binocular vision, that is of the ability to synthesize the visual inputs from both eyes to a single image with perception of depth." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023320" .

<http://purl.obolibrary.org/obo/HP_0011515> rdfs:label "Abnormal stereopsis" ;
    dcterms:description "Inability to make fine depth discriminations from parallax provided by the two eyes' different positions on the head."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023319" .

<http://purl.obolibrary.org/obo/HP_0011520> rdfs:label "Deuteranomaly"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of anomalous trichromacy associated with abnormal M photopigment, such that the absorption spectrum is shifted toward L wavelengths. Affected individuals have difficulties distinguishing between red and green." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Deuteranomoly",
        "Green-weak" ;
    ns1:synonym "Deuteranomoly"^^<http://example.org/invalidDatatype>,
        "Green-weak" ;
    ns1:xref "UMLS:C0155016"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:246674000",
        "SNOMEDCT_US:77479002" .

<http://purl.obolibrary.org/obo/HP_0011522> rdfs:label "Protanopia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Blue and green cones only; no functional red cones." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Red-blind"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Red-blind" ;
    ns1:xref "SNOMEDCT_US:51445007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0155015" .

<http://purl.obolibrary.org/obo/HP_0011524> rdfs:label "Iris melanoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Malignant tumor of melanocytes affecting the iris."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "NCIT:C3224"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:255012009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0346373"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011533> rdfs:label "Snowflake vitreoretinal degeneration"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The appearance of yellow/white crystalline-like (hence the name) spots in the retina and thickening of the peripheral part of the vitreous." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Snowflake retinal degeneration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Snowflake retinal degeneration" ;
    ns1:xref "UMLS:C1860405" .

<http://purl.obolibrary.org/obo/HP_0011567> rdfs:label "Sinus venosus atrial septal defect"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An interatrial communication caused by a deficiency of the common wall between the superior vena cava (SVC) and the right-sided pulmonary veins. SVASD is commonly associated with anomalous pulmonary venous connection (APVC) of some or all of the pulmonary veins, which produces additional left-to-right shunting." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "Fyler:2010",
        "ICD-10:Q21.1",
        "SNOMEDCT_US:95268002",
        "UMLS:C0344730" .

<http://purl.obolibrary.org/obo/HP_0011580> rdfs:label "Short chordae tendineae of the mitral valve"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormally short chordae tendineae of the mitral valve."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023288" .

<http://purl.obolibrary.org/obo/HP_0011599> rdfs:label "Mesocardia" ;
    dcterms:description "Mesocardia is an abnormal location of the heart in which the heart is in a midline position and the longitudinal axis of the heart lies in the mid-sagittal plane." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "Fyler:0140"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:16567006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265865"^^<http://example.org/invalidDatatype>,
        "Fyler:140" .

<http://purl.obolibrary.org/obo/HP_0011613> rdfs:label "Interrupted aortic arch type B"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Non-continuity of the aortic arch with an atretic point or absent segment between the left carotid and subclavian arteries."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Interrupted aortic arch, type b"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Interrupted aortic arch, type b" ;
    ns1:xref "Fyler:1252"^^<http://example.org/invalidDatatype>,
        "UMLS:C0345093"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:253682003" .

<http://purl.obolibrary.org/obo/HP_0011625> rdfs:label "Multiple muscular ventricular septal defects"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of muscular ventricular septal defect characterized by the presence of multiple small defects in the ventricular septum." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Swiss cheese ventricular septal defect"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Swiss cheese ventricular septal defect" ;
    ns1:xref "UMLS:C4023263" .

<http://purl.obolibrary.org/obo/HP_0011641> rdfs:label "Coronary artery fistula" ;
    dcterms:description "A congenital malformation with abnormal connection between one of the coronary arteries and a heart chamber or another blood vessel." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Coronary fistula" ;
    ns1:synonym "Coronary fistula"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:373093003"^^<http://example.org/invalidDatatype>,
        "UMLS:C0265898"^^<http://example.org/invalidDatatype>,
        "Fyler:2230" .

<http://purl.obolibrary.org/obo/HP_0011648> rdfs:label "Patent ductus arteriosus after birth at term" ;
    dcterms:description "Abnormal persistent patency of the ductus arteriosus in postnatal life when birth was at 37 completed weeks of gestation or greater." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023249"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011658> rdfs:label "Double outlet right ventricle with subpulmonary ventricular septal defect without pulmonary stenosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A double outlet right ventricle with a ventricular spetal defect (a hole between the two bottom chambers (ventricles) of the heart), that is considered to be closely related to the pulmonary origin. There is not associated pulmonary stenosis, the abnormal narrowing or constriction of the pulmonary artery, in the main pulmonary artery and/or in the left or right pulmonary artery branches."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "DORV with subpulmonary VSD without pulmonary stenosis"^^<http://example.org/invalidDatatype>,
        "Taussig-Bing anomaly" ;
    ns1:synonym "DORV with subpulmonary VSD without pulmonary stenosis"^^<http://example.org/invalidDatatype>,
        "Taussig-Bing anomaly" ;
    ns1:xref "UMLS:C4023241" .

<http://purl.obolibrary.org/obo/HP_0011662> rdfs:label "Tricuspid atresia" ;
    dcterms:description "Failure to develop of the tricuspid valve and thus lack of the normal connection between the right atrium and the right ventricle." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Tricuspid valve atresia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Tricuspid valve atresia" ;
    ns1:xref "Fyler:400"^^<http://example.org/invalidDatatype>,
        "ICD-10:Q22.4"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:63042009"^^<http://example.org/invalidDatatype>,
        "EPCC:06.01.01",
        "Fyler:0400",
        "SNOMEDCT_US:253455004",
        "UMLS:C0243002" .

<http://purl.obolibrary.org/obo/HP_0011664> rdfs:label "Left ventricular noncompaction cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Left ventricular non-compaction (LVNC) is characterized by prominent left ventricular trabeculae and deep inter-trabecular recesses. The myocardial wall is often thickened with a thin, compacted epicardial layer and a thickened endocardial layer. In some patients, LVNC is associated with left ventricular dilatation and systolic dysfunction, which can be transient in neonates."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Left ventricular non-compaction cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Left ventricular non-compaction cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4021133"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011665> rdfs:label "Takotsubo cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Transient left ventricular apical ballooning syndrome or takotsubo cardiomyopathy is characterized by transient regional systolic dysfunction involving the left ventricular apex and/or mid-ventricle in the absence of obstructive coronary disease on coronary angiography. Patients present with an abrupt onset of angina-like chest pain, and have diffuse T-wave inversion, sometimes preceded by ST-segment elevation, and mild cardiac enzyme elevation." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Broken-heart syndrome" ;
    ns1:synonym "Broken-heart syndrome" ;
    ns1:xref "SNOMEDCT_US:441541008"^^<http://example.org/invalidDatatype>,
        "UMLS:C1739395" .

<http://purl.obolibrary.org/obo/HP_0011670> rdfs:label "Left superior vena cava draining to coronary sinus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A persistent left superior vena cava (PLSVC) that drains into the right atrium via the coronary sinus. This is the case in 80-92% of cases of PLSVC and results in no hemodynamic consequence." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C2677768"^^<http://example.org/invalidDatatype>,
        "ICD-10:Q26.1" .

<http://purl.obolibrary.org/obo/HP_0011710> rdfs:label "Bundle branch block"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Block of conduction of electrical impulses along the Bundle of His or along one of its bundle branches." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Bundle-branch block"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Bundle-branch block" ;
    ns1:xref "SNOMEDCT_US:6374002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0006384"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011711> rdfs:label "Left anterior fascicular block"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Conduction block in the anterior division of the left bundle branch of the bundle of His." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Left anterior hemiblock" ;
    ns1:synonym "Left anterior hemiblock" ;
    ns1:xref "UMLS:C0264912"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:37760005" .

<http://purl.obolibrary.org/obo/HP_0011713> rdfs:label "Left bundle branch block" ;
    dcterms:description "A conduction block of the left branch of the bundle of His. This manifests as a generalized disturbance of QRS morphology on EKG."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:63467002"^^<http://example.org/invalidDatatype>,
        "UMLS:C0023211" .

<http://purl.obolibrary.org/obo/HP_0011717> rdfs:label "Atrioventricular reentrant tachycardia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Accessory pathway-related atrioventricular reentrant tachycardia (AVRT) involves an abnormal electrical conduction of the accessory pathway. The accessory pathway connecting impulses between the atrium and the ventricle can be seen at any site in the AV groove." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "AV nodal reentry tachycardia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "AV nodal reentry tachycardia" ;
    ns1:xref "UMLS:C4023220" .

<http://purl.obolibrary.org/obo/HP_0011729> rdfs:label "Abnormality of joint mobility"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality in the range and ease of motion of joints across their normal range." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023216" .

<http://purl.obolibrary.org/obo/HP_0011731> rdfs:label "Abnormality of circulating cortisol level" ;
    dcterms:description "An abnormality of the concentration of cortisol in the blood." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023214" .

<http://purl.obolibrary.org/obo/HP_0011744> rdfs:label "Secondary hypercortisolism" ;
    dcterms:description "Hypercortisolemia associated with a overproduction of ACTH (often from a tumor), leading secondarily to overproduction of cortisol."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:related_synonym "ACTH-dependent hypercortisolemia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "ACTH-dependent hypercortisolemia"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4020741",
        "UMLS:C4023207" .

<http://purl.obolibrary.org/obo/HP_0011751> rdfs:label "Abnormal posterior pituitary morphogenesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of the neurohypophysis, which is also known as the posterior lobe of the hypophysis."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of the neurohypophysis"^^<http://example.org/invalidDatatype>,
        "Abnormality of the posterior pituitary"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Abnormality of the neurohypophysis"^^<http://example.org/invalidDatatype>,
        "Abnormality of the posterior pituitary"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C4023204"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011754> rdfs:label "Pituicytoma" ;
    dcterms:description "A solid, low grade, spindle cell, glial neoplasm of adults that originates in the neurohypophysis or infundibulum. Clinical signs and symptoms include visual disturbance, headache and features of hypopituitarism. Pituicytomas are well-circumscribed, solid masses that can measure up to several centimeters. Histologically, they show a compact architecture consisting of elongate, bipolar spindle cells arranged in interlacing fascicles or assuming a storiform pattern."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:450901008"^^<http://example.org/invalidDatatype>,
        "ICD-O:9432/1",
        "SNOMEDCT_US:608817003",
        "UMLS:C2986550" .

<http://purl.obolibrary.org/obo/HP_0011756> rdfs:label "Posterior pituitary agenesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of the neurohypophysis owing to a developmental defect."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Neurohypophysis agenesis" ;
    ns1:synonym "Neurohypophysis agenesis" ;
    ns1:xref "UMLS:C4023203"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011761> rdfs:label "Pituitary null cell adenoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of pituitary adenoma that is of unknown cellular origin and that lacks immunocytochemical or fine structural markers. Null cell adenomas are not associated with hormone excess." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Clinically silent pituitary adenoma"^^<http://example.org/invalidDatatype>,
        "Non-functional pituitary adenoma"^^<http://example.org/invalidDatatype>,
        "Silent pituitary adenoma"^^<http://example.org/invalidDatatype>,
        "Hormonally silent pituitary adenoma" ;
    ns1:synonym "Clinically silent pituitary adenoma"^^<http://example.org/invalidDatatype>,
        "Hormonally silent pituitary adenoma"^^<http://example.org/invalidDatatype>,
        "Non-functional pituitary adenoma",
        "Silent pituitary adenoma" ;
    ns1:xref "SNOMEDCT_US:254962005",
        "UMLS:C0338078" .

<http://purl.obolibrary.org/obo/HP_0011762> rdfs:label "Pituitary thyrotropic cell adenoma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A type of pituitary adenoma that produces thyroid stimulating hormone (TSH)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Pituitary thyrotropinoma"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Pituitary thyrotropinoma" ;
    ns1:xref "UMLS:C4021121" .

<http://purl.obolibrary.org/obo/HP_0011780> rdfs:label "Thyroid hemiagenesis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of a lobe of the thyroid gland related to a failure of its embryologic development."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:715734006"^^<http://example.org/invalidDatatype>,
        "UMLS:C4023190" .

<http://purl.obolibrary.org/obo/HP_0011782> rdfs:label "Thyroid crisis" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:29028009",
        "UMLS:C0040127" .

<http://purl.obolibrary.org/obo/HP_0011784> rdfs:label "Thyrotoxicosis with diffuse goiter" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Thyrotoxicosis with diffuse goiter" ;
    ns1:synonym "Thyrotoxicosis with diffuse goiter"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:267374005"^^<http://example.org/invalidDatatype>,
        "UMLS:C0342122" .

