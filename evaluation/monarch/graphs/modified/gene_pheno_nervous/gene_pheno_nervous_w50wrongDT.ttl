<http://purl.obolibrary.org/obo/HP_0001609> rdfs:label "Hoarse voice" ;
    dcterms:description "Hoarseness refers to a change in the pitch or quality of the voice, with the voice sounding weak, very breathy, scratchy, or husky."^^<http://example.org/invalidDatatype> ;
