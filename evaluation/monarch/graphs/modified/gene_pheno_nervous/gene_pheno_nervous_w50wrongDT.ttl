        "UMLS:C1851731",
        "UMLS:C3150281" .

<http://purl.obolibrary.org/obo/HP_0001831> rdfs:label "Short toe"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A toe that appears disproportionately short compared to the foot." ;
