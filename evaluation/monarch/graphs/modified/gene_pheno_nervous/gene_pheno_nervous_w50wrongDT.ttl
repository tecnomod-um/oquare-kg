<http://purl.obolibrary.org/obo/HP_0000003> rdfs:label "Multicystic kidney dysplasia" ;
    dcterms:description "Multicystic dysplasia of the kidney is characterized by multiple cysts of varying size in the kidney and the absence of a normal pelvicaliceal system. The condition is associated with ureteral or ureteropelvic atresia, and the affected kidney is nonfunctional."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Multicystic dysplastic kidney"^^<http://example.org/invalidDatatype>,
        "Multicystic kidneys",
