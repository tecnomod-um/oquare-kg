    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Scapuloperoneal atrophy" ;
    ns1:synonym "Scapuloperoneal atrophy"^^<http://example.org/invalidDatatype> ;
    ns1:xref "UMLS:C1842162" .

