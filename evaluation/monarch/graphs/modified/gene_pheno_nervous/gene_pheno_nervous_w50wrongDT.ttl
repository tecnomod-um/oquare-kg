        "UMLS:C4305135"^^<http://example.org/invalidDatatype>,
        "GARD:0019062",
        "Orphanet:85336",
        "SCTID:718847005" .

<http://purl.obolibrary.org/obo/MONDO_0019430> rdfs:label "X-linked intellectual disability-ataxia-apraxia syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "X-linked intellectual disability-ataxia-apraxia syndrome is characterized by ataxia, apraxia, intellectual deficit and/or seizures. It has been described in nine males in two unrelated Danish families. It is transmitted as an X-linked recessive syndrome with partial clinical expression in obligate female carriers." ;
    ns1:category ns1:Disease ;
    ns1:has_phenotype <http://purl.obolibrary.org/obo/HP_0001250>,
        <http://purl.obolibrary.org/obo/HP_0001251>,
