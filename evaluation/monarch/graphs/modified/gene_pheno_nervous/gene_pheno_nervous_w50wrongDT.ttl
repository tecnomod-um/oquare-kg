    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C4023055"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012082> rdfs:label "Cerebellar Purkinje layer atrophy"^^<http://example.org/invalidDatatype> ;
