        "UMLS:C4280639" .

<http://purl.obolibrary.org/obo/HP_0000444> rdfs:label "Convex nasal ridge" ;
    dcterms:description "Nasal ridge curving anteriorly to an imaginary line that connects the nasal root and tip. The nose appears often also prominent, and the columella low."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Beaklike protrusion"^^<http://example.org/invalidDatatype>,
        "Convex dorsum of nose"^^<http://example.org/invalidDatatype>,
        "Convex nasal dorsum"^^<http://example.org/invalidDatatype>,
        "Beaked nose",
        "Hooked nose",
        "Polly beak nasal deformity" ;
    ns1:synonym "Beaked nose"^^<http://example.org/invalidDatatype>,
        "Convex nasal dorsum"^^<http://example.org/invalidDatatype>,
        "Hooked nose"^^<http://example.org/invalidDatatype>,
        "Beaklike protrusion",
        "Convex dorsum of nose",
        "Polly beak nasal deformity" ;
    ns1:xref "UMLS:C0240538" .

<http://purl.obolibrary.org/obo/HP_0000567> rdfs:label "Chorioretinal coloboma"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Absence of a region of the retina, retinal pigment epithelium, and choroid."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Birth defect that causes a hole in the innermost layer at the back of the eye"^^<http://example.org/invalidDatatype>,
        "Choroidoretinal coloboma"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Choroidal coloboma"^^<http://example.org/invalidDatatype>,
        "Choroid coloboma",
        "Coloboma of choroid" ;
    ns1:synonym "Birth defect that causes a hole in the innermost layer at the back of the eye"^^<http://example.org/invalidDatatype>,
        "Choroid coloboma",
        "Choroidal coloboma",
        "Choroidoretinal coloboma",
        "Coloboma of choroid" ;
    ns1:xref "UMLS:C0240896"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:39302008" .

<http://purl.obolibrary.org/obo/HP_0000691> rdfs:label "Microdontia" ;
    dcterms:description "Decreased size of the teeth, which can be defined as a mesiodistal tooth diameter (width) more than 2 SD below mean. Alternatively, an apparently decreased maximum width of tooth."^^<http://example.org/invalidDatatype> ;
    ns1:broad_synonym "Hypotrophic tooth"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Underdeveloped tooth"^^<http://example.org/invalidDatatype>,
        "Decreased size of tooth",
        "Decreased width of tooth",
        "Small teeth",
        "Small tooth",
        "Tooth hypoplasia",
        "Tooth hypotrophy" ;
    ns1:synonym "Decreased size of tooth"^^<http://example.org/invalidDatatype>,
        "Hypotrophic tooth"^^<http://example.org/invalidDatatype>,
        "Small teeth"^^<http://example.org/invalidDatatype>,
        "Underdeveloped tooth"^^<http://example.org/invalidDatatype>,
        "Decreased width of tooth",
        "Small tooth",
        "Tooth hypoplasia",
        "Tooth hypotrophy" ;
    ns1:xref "UMLS:C0240340"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280611"^^<http://example.org/invalidDatatype>,
        "UMLS:C4280612"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:32337007" .

<http://purl.obolibrary.org/obo/HP_0000746> rdfs:label "Delusion"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A delusion is a fixed false belief held despite evidence to the contrary. The term delusion broadly encompasses all false judgments that possess the following external characteristics to a significant, albeit unspecified, extent: (1) they are held with an exceptional level of conviction, accompanied by an unparalleled subjective certainty; (2) there is an inability to consider alternative experiences or compelling counter-arguments; (3) the content of the belief is impossible." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Delusions"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Delusions" ;
    ns1:xref "SNOMEDCT_US:2073000"^^<http://example.org/invalidDatatype>,
        "UMLS:C0011253"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000952> rdfs:label "Jaundice" ;
    dcterms:description "Yellow pigmentation of the skin due to bilirubin, which in turn is the result of increased bilirubin concentration in the bloodstream." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Icterus"^^<http://example.org/invalidDatatype>,
        "Yellow skin"^^<http://example.org/invalidDatatype>,
        "Jaundice",
        "Yellowing of the skin" ;
    ns1:synonym "Icterus"^^<http://example.org/invalidDatatype>,
        "Yellow skin"^^<http://example.org/invalidDatatype>,
        "Yellowing of the skin"^^<http://example.org/invalidDatatype>,
        "Jaundice" ;
    ns1:xref "SNOMEDCT_US:18165001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0022346" .

<http://purl.obolibrary.org/obo/HP_0001141> rdfs:label "Severely reduced visual acuity"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Severe reduction of the ability to see. On the 6m visual acuity scale, severe reduction is defined as less than 6/60 but at least 3/60. On the 20ft visual acuity scale, severe reduction is defined as less than 20/200 but at least 20/400. On the decimal visual acuity scale, severe reduction is defined as less than 0.1 but at least 0.05." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Marked vision impairment"^^<http://example.org/invalidDatatype>,
        "Severe reduction in visual acuity"^^<http://example.org/invalidDatatype>,
        "Severe vision loss"^^<http://example.org/invalidDatatype>,
        "Severely impaired vision"^^<http://example.org/invalidDatatype>,
        "Severe visual impairment",
        "Severe visual loss" ;
    ns1:synonym "Marked vision impairment"^^<http://example.org/invalidDatatype>,
        "Severe reduction in visual acuity"^^<http://example.org/invalidDatatype>,
        "Severe visual loss"^^<http://example.org/invalidDatatype>,
        "Severely impaired vision"^^<http://example.org/invalidDatatype>,
        "Severe vision loss",
        "Severe visual impairment" ;
    ns1:xref "SNOMEDCT_US:397541004",
        "UMLS:C1301509" .

<http://purl.obolibrary.org/obo/HP_0001278> rdfs:label "Orthostatic hypotension"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of hypotension characterized by a sudden fall in blood pressure that occurs when a person assumes a standing position."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Decrease in blood pressure upon standing up",
        "Postural hypotension" ;
    ns1:synonym "Decrease in blood pressure upon standing up"^^<http://example.org/invalidDatatype>,
        "Postural hypotension" ;
    ns1:xref "UMLS:C0020651"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:28651003" .

<http://purl.obolibrary.org/obo/HP_0001360> rdfs:label "Holoprosencephaly" ;
    dcterms:description "Holoprosencephaly is a structural anomaly of the brain in which the developing forebrain fails to divide into two separate hemispheres and ventricles." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Single brain ventricle" ;
    ns1:synonym "Single brain ventricle" ;
    ns1:xref "Fyler:4338"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:30915001"^^<http://example.org/invalidDatatype>,
        "UMLS:C0079541"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0001399> rdfs:label "Hepatic failure" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hepatic insufficiency"^^<http://example.org/invalidDatatype>,
        "Liver failure" ;
    ns1:synonym "Liver failure"^^<http://example.org/invalidDatatype>,
        "Hepatic insufficiency" ;
    ns1:xref "SNOMEDCT_US:59927004"^^<http://example.org/invalidDatatype>,
        "UMLS:C0085605"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002023> rdfs:label "Anal atresia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Congenital absence of the anus, i.e., the opening at the bottom end of the intestinal tract." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Absent anus"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Imperforate anus"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Imperforate anus"^^<http://example.org/invalidDatatype>,
        "Absent anus" ;
    ns1:xref "Fyler:4443"^^<http://example.org/invalidDatatype>,
        "MEDDRA:10002120"^^<http://example.org/invalidDatatype>,
        "UMLS:C0003466"^^<http://example.org/invalidDatatype>,
        "Fyler:4402",
        "SNOMEDCT_US:204712000",
        "SNOMEDCT_US:204731006" .

<http://purl.obolibrary.org/obo/HP_0002266> rdfs:label "Focal clonic seizure"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A focal clonic seizure is a type of focal motor seizure characterized by sustained rhythmic jerking, that is regularly repetitive."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Focal clonic seizures"^^<http://example.org/invalidDatatype>,
        "Localized clonic seizure"^^<http://example.org/invalidDatatype>,
        "Localised clonic seizure",
        "Partial clonic seizure",
        "Segmental clonic seizure" ;
    ns1:synonym "Focal clonic seizures"^^<http://example.org/invalidDatatype>,
        "Localised clonic seizure"^^<http://example.org/invalidDatatype>,
        "Localized clonic seizure"^^<http://example.org/invalidDatatype>,
        "Partial clonic seizure",
        "Segmental clonic seizure" ;
    ns1:xref "UMLS:C0752323"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002548> rdfs:label "Parkinsonism with favorable response to dopaminergic medication" ;
    dcterms:description "Parkinsonism is a clinical syndrome that is a feature of a number of different diseases, including Parkinson disease itself, other neurodegenerative diseases such as progressive supranuclear palsy, and as a side-effect of some neuroleptic medications. Some but not all individuals with Parkinsonism show responsiveness to dopaminergic medication defined as a substantial reduction of amelioration of the component signs of Parkinsonism (including mainly tremor, bradykinesia, rigidity, and postural instability) upon administration of dopaminergic medication."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Parkinsonism with favourable response to dopaminergic medication" ;
    ns1:related_synonym "Favourable response to levodopa"^^<http://example.org/invalidDatatype>,
        "Favorable response to levodopa" ;
    ns1:synonym "Favourable response to levodopa"^^<http://example.org/invalidDatatype>,
        "Favorable response to levodopa",
        "Parkinsonism with favourable response to dopaminergic medication" ;
    ns1:xref "UMLS:C1846868" .

<http://purl.obolibrary.org/obo/HP_0002579> rdfs:label "Gastrointestinal dysmotility"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Abnormal intestinal contractions, such as spasms and intestinal paralysis, related to the loss of the ability of the gut to coordinate muscular activity because of endogenous or exogenous causes." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "GI dysmotility"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "GI dysmotility" ;
    ns1:xref "UMLS:C1836923"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002902> rdfs:label "Hyponatremia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormally decreased sodium concentration in the blood."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Low blood sodium levels"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Low blood sodium levels" ;
    ns1:xref "UMLS:C0020625"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:89627008" .

<http://purl.obolibrary.org/obo/HP_0003155> rdfs:label "Elevated circulating alkaline phosphatase concentration" ;
    dcterms:description "Abnormally increased serum levels of alkaline phosphatase activity."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "High serum alkaline phosphatase"^^<http://example.org/invalidDatatype>,
        "Hyperphosphatasemia"^^<http://example.org/invalidDatatype>,
        "Hyperphosphatasia"^^<http://example.org/invalidDatatype>,
        "Elevated ALP",
        "Elevated alkaline phosphatase",
        "Greatly elevated alkaline phosphatase",
        "Increased alkaline phosphatase",
        "Increased serum alkaline phosphatase" ;
    ns1:synonym "Elevated ALP"^^<http://example.org/invalidDatatype>,
        "Elevated alkaline phosphatase"^^<http://example.org/invalidDatatype>,
        "High serum alkaline phosphatase"^^<http://example.org/invalidDatatype>,
        "Hyperphosphatasemia"^^<http://example.org/invalidDatatype>,
        "Hyperphosphatasia"^^<http://example.org/invalidDatatype>,
        "Increased alkaline phosphatase"^^<http://example.org/invalidDatatype>,
        "Increased serum alkaline phosphatase"^^<http://example.org/invalidDatatype>,
        "Greatly elevated alkaline phosphatase" ;
    ns1:xref "UMLS:C0750857" .

<http://purl.obolibrary.org/obo/HP_0003555> rdfs:label "Muscle fiber splitting"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Fiber splitting or branching is a common finding in human and rat skeletal muscle pathology. Fiber splitting refers to longitudinal halving of the complete fiber, while branching originates from a regenerating end of a necrotic fiber as invaginations of the sarcolemma. In fiber branching, one end of the fiber remains intact as a single entity, while the other end has several branches." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Fibre splitting"^^<http://example.org/invalidDatatype>,
        "Muscle fiber splitting"^^<http://example.org/invalidDatatype>,
        "Fiber splitting" ;
    ns1:synonym "Fiber splitting"^^<http://example.org/invalidDatatype>,
        "Fibre splitting",
        "Muscle fiber splitting" ;
    ns1:xref "UMLS:C1836057" .

<http://purl.obolibrary.org/obo/HP_0004373> rdfs:label "Focal dystonia" ;
    dcterms:description "A type of dystonia that is localized to a specific part of the body."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "SNOMEDCT_US:445006008"^^<http://example.org/invalidDatatype>,
        "UMLS:C0743332" .

<http://purl.obolibrary.org/obo/HP_0006989> rdfs:label "Dysplastic corpus callosum"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Dysplasia and dysgenesis of the corpus callosum are nonspecific descriptions that imply defective development of the corpus callosum. The term dysplasia is applied when the morphology of the corpus callosum is altered as a congenital trait. For instance, the corpus callosum may be hump-shaped, kinked, or a striped corpus callosum that lacks an anatomically distinct genu and splenium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Dysgenesis of corpus callosum"^^<http://example.org/invalidDatatype>,
        "Dysplasia of corpus callosum"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Dysgenesis of corpus callosum"^^<http://example.org/invalidDatatype>,
        "Dysplasia of corpus callosum" ;
    ns1:xref "UMLS:C0431369" .

<http://purl.obolibrary.org/obo/HP_0007641> rdfs:label "Dyschromatopsia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A form of colorblindness in which only two of the three fundamental colors can be distinguished due to a lack of one of the retinal cone pigments."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Color blindness",
        "Colour blindness" ;
    ns1:synonym "Color blindness",
        "Colour blindness" ;
    ns1:xref "UMLS:C0858618" .

<http://purl.obolibrary.org/obo/HP_0007814> rdfs:label "Retinal pigment epithelial mottling" ;
    dcterms:description "Mottling (spots or blotches of different shades) of the retinal pigment epithelium, i.e., localized or generalized fundus pigment granularity associated with processes at the level of the retinal pigment epithelium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "RPE mottling"^^<http://example.org/invalidDatatype>,
        "Salt and pepper retinal pigmentation"^^<http://example.org/invalidDatatype>,
        "Focal hypopigmentation of the retinal pigment epithelium",
        "RPE irregularity",
        "Retinal pigment epithelium irregularity",
        "Salt and pepper retinopathy" ;
    ns1:synonym "Focal hypopigmentation of the retinal pigment epithelium"^^<http://example.org/invalidDatatype>,
        "Retinal pigment epithelium irregularity"^^<http://example.org/invalidDatatype>,
        "Salt and pepper retinopathy"^^<http://example.org/invalidDatatype>,
        "RPE irregularity",
        "RPE mottling",
        "Salt and pepper retinal pigmentation" ;
    ns1:xref "UMLS:C1857644"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0008770> rdfs:label "Obsessive-compulsive trait"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The presence of one or more obsessive-compulsive personality traits. Obsessions refer to persistent intrusive thoughts, and compulsions to intrusive behaviors, which the affected person experiences as involuntary, senseless, or repugnant."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Obsessive-compulsive trait"^^<http://example.org/invalidDatatype>,
        "Obsessive-compulsive traits" ;
    ns1:synonym "Obsessive-compulsive trait",
        "Obsessive-compulsive traits" ;
    ns1:xref "UMLS:C1834433"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0010522> rdfs:label "Dyslexia" ;
    dcterms:description "A learning disorder characterized primarily by difficulties in learning to read and spell. Dyslectic children also exhibit a tendency to read words from right to left and to confuse letters such as b and d whose orientation is important for their identification. Children with dyslexia appear to be impaired in phonemic skills (the ability to associate visual symbols with the sounds they represent)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Reading disability"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Reading disability" ;
    ns1:xref "SNOMEDCT_US:52824009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0476254"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:59770006",
        "SNOMEDCT_US:9236007" .

<http://purl.obolibrary.org/obo/HP_0012650> rdfs:label "Perisylvian polymicrogyria" ;
    dcterms:description "Polymicrogyria (an excessive number of small gyri or convolutions) that is maximal in perisylvian regions (the regions that surround the Sylvian fissures), which may be symmetric or asymmetric and may extend beyond perisylvian regions. The Sylvian fissures often extend posteriorly and superiorly." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Frontoparietal polymicrogyria"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Frontoparietal polymicrogyria" ;
    ns1:xref "UMLS:C3279675"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0020045> rdfs:label "Esodeviation"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A manifest or latent ocular deviation in which one or both eyes tends to deviate nasally." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Convergent squint"^^<http://example.org/invalidDatatype>,
        "Convergent strabismus" ;
    ns1:synonym "Convergent squint",
        "Convergent strabismus" .

<http://purl.obolibrary.org/obo/HP_0032988> rdfs:label "Persistent head lag"^^<http://example.org/invalidDatatype> ;
    dcterms:description "The Premie-Neuro and the Dubowitz Neurological Examination score head lag in the same manner. Scoring for both is as follows: 0 = head drops and stays back, 1 = tries to lift head but drops it back, 2 = able to lift head slightly, 3 = lifts head in line with body, and 4 = head in front of body. This term applies if head lag persists beyond an expected age at a level of 0 or 1. Persistent head lag beyond age 4 mo has been linked to poor outcomes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Head lag",
        "Headlag" ;
    ns1:synonym "Head lag"^^<http://example.org/invalidDatatype>,
        "Headlag"^^<http://example.org/invalidDatatype> .

