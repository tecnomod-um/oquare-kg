        "Outer ear tumour" ;
    ns1:xref "UMLS:C4022443"^^<http://example.org/invalidDatatype>,
        "NCIT:C3262" .

<http://purl.obolibrary.org/obo/HP_0040113> rdfs:label "Old-aged sensorineural hearing impairment"^^<http://example.org/invalidDatatype> ;
