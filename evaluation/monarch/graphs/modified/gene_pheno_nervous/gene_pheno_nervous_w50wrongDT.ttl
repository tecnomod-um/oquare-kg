        "New blood vessel formation in cornea" ;
    ns1:xref "SNOMEDCT_US:19161004",
        "UMLS:C0085109" .

<http://purl.obolibrary.org/obo/HP_0011509> rdfs:label "Macular hyperpigmentation" ;
    dcterms:description "Increased amount of pigmentation in the macula."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0745109"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0011532> rdfs:label "Subretinal exudate" ;
    dcterms:description "A type of retinal exudate located in the subretinal space between the sensory retina and the retinal pigment epithelium." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C0423431"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:247156002" .

<http://purl.obolibrary.org/obo/HP_0011560> rdfs:label "Mitral atresia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A congenital defect with failure to open of the mitral valve orifice." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Mitral valve atresia"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Mitral valve atresia"^^<http://example.org/invalidDatatype> ;
