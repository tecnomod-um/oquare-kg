    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Failure to thrive in first year of life"^^<http://example.org/invalidDatatype>,
        "Faltering weight in infancy",
        "Weight faltering in infancy" ;
    ns1:synonym "Weight faltering in infancy"^^<http://example.org/invalidDatatype>,
