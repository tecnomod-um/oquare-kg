        "Generalized-onset clonic seizure" ;
    ns1:xref "UMLS:C4023499" .

<http://purl.obolibrary.org/obo/HP_0011410> rdfs:label "Caesarean section"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Delivery of a fetus through surgical incisions made through the abdominal wall (laparotomy) and the uterine wall (hysterotomy)."^^<http://example.org/invalidDatatype> ;
