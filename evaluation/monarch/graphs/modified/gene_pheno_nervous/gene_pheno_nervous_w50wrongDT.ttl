        "SNOMEDCT_US:62718007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0013132",
        "UMLS:C0037036" .

<http://purl.obolibrary.org/obo/HP_0002521> rdfs:label "Hypsarrhythmia"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Hypsarrhythmia is abnormal interictal high amplitude waves and a background of irregular spikes. There is continuous (during wakefulness), high-amplitude (>200 Hz), generalized polymorphic slowing with no organized background and multifocal spikes demonstrated by electroencephalography (EEG)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Hypsarrhythmia by EEG" ;
    ns1:synonym "Hypsarrhythmia by EEG"^^<http://example.org/invalidDatatype> ;
    ns1:xref "SNOMEDCT_US:28055006"^^<http://example.org/invalidDatatype>,
        "UMLS:C0684276" .

<http://purl.obolibrary.org/obo/HP_0008872> rdfs:label "Feeding difficulties in infancy" ;
    dcterms:description "Impaired feeding performance of an infant as manifested by difficulties such as weak and ineffective sucking, brief bursts of sucking, and falling asleep during sucking. There may be difficulties with chewing or maintaining attention."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C2674608"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0002093> rdfs:label "Respiratory insufficiency" ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Respiratory impairment" ;
    ns1:related_synonym "Respiratory function loss" ;
    ns1:synonym "Respiratory impairment"^^<http://example.org/invalidDatatype>,
        "Respiratory function loss" ;
    ns1:xref "UMLS:C4020855"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:409623005",
        "UMLS:C0035229" .

<http://purl.obolibrary.org/obo/HP_0200134> rdfs:label "Epileptic encephalopathy" ;
    dcterms:description "A condition in which epileptiform abnormalities are believed to contribute to the progressive disturbance in cerebral function. Epileptic encephalaopathy is characterized by (1) electrographic EEG paroxysmal activity that is often aggressive, (2) seizures that are usually multiform and intractable, (3) cognitive, behavioral and neurological deficits that may be relentless, and (4) sometimes early death." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Convulsive encephalopathy" ;
    ns1:synonym "Convulsive encephalopathy" ;
    ns1:xref "UMLS:C0543888"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0000540> rdfs:label "Hypermetropia" ;
    dcterms:description "An abnormality of refraction characterized by the ability to see objects in the distance clearly, while objects nearby appear blurry."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Farsightedness"^^<http://example.org/invalidDatatype>,
        "Hyperopia"^^<http://example.org/invalidDatatype>,
        "Long-sightedness" ;
    ns1:synonym "Farsightedness",
        "Hyperopia",
        "Long-sightedness" ;
    ns1:xref "UMLS:C0020490"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:38101003" .

<http://purl.obolibrary.org/obo/HP_0002133> rdfs:label "Status epilepticus" ;
    dcterms:description "Status epilepticus is a type of prolonged seizure resulting either from the failure of the mechanisms responsible for seizure termination or from the initiation of mechanisms which lead to abnormally prolonged seizures (after time point t1). It is a condition that can have long-term consequences (after time point t2), including neuronal death, neuronal injury, and alteration of neuronal networks, depending on the type and duration of seizures." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Prolonged seizure"^^<http://example.org/invalidDatatype>,
        "Repeated seizure without recovery"^^<http://example.org/invalidDatatype>,
        "Repeated seizures without recovery between them"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Prolonged seizure",
        "Repeated seizure without recovery",
        "Repeated seizures without recovery between them" ;
    ns1:xref "SNOMEDCT_US:230456007"^^<http://example.org/invalidDatatype>,
        "UMLS:C0038220" .

<http://purl.obolibrary.org/obo/HP_0002315> rdfs:label "Headache" ;
    dcterms:description "Cephalgia, or pain sensed in various parts of the head, not confined to the area of distribution of any nerve."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Headache"^^<http://example.org/invalidDatatype>,
        "Headaches" ;
    ns1:synonym "Headaches"^^<http://example.org/invalidDatatype>,
        "Headache" ;
    ns1:xref "SNOMEDCT_US:25064002",
        "UMLS:C0018681" .

<http://purl.obolibrary.org/obo/HP_0033725> rdfs:label "Thin corpus callosum" ;
    dcterms:description "An abnormally thin corpus callous, due to atrophy, hypoplasia or agenesis. This term is intended to be used in situations where it is not known if thinning of the corpus callosum (for instance, as visualized by magnetic resonance tomography) is due to abnormal development (e.g. a leukodystrophy) or atrophy following normal development (e.g. neurodegeneration)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Small corpus callosum"^^<http://example.org/invalidDatatype>,
        "Thinning of the corpus callosum" ;
    ns1:synonym "Small corpus callosum",
        "Thinning of the corpus callosum" .

<http://purl.obolibrary.org/obo/HP_0000358> rdfs:label "Posteriorly rotated ears" ;
    dcterms:description "A type of abnormal location of the ears in which the position of the ears is characterized by posterior rotation (the superior part of the ears is rotated towards the back of the head, and the inferior part of the ears towards the front)." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Ears rotated toward back of head"^^<http://example.org/invalidDatatype>,
        "Posteriorly rotated"^^<http://example.org/invalidDatatype>,
        "Posteriorly rotated auricles"^^<http://example.org/invalidDatatype>,
        "Ear, posterior angulation, increased",
        "Posteriorly angulated ears",
        "Posteriorly-angulated ears",
        "Posteriorly-rotated ears" ;
