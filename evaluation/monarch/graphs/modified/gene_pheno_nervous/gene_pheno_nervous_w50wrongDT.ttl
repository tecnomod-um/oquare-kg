        "UMLS:C1298695" .

<http://purl.obolibrary.org/obo/HP_0007917> rdfs:label "Tractional retinal detachment" ;
    dcterms:description "A type of retinal detachment arising due to a combination of contracting retinal membranes, abnormal vitreoretinal adhesions, and vitreous changes, in the absence of a full-thickness retinal defect."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:xref "UMLS:C1866178"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0008002> rdfs:label "Abnormal macular pigmentation" ;
    dcterms:description "Any deviation from the normal, uniform distribution or appearance of pigment within the macular region of the retina."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Abnormality of macular pigmentation" ;
    ns1:related_synonym "Macular pigmentary changes" ;
