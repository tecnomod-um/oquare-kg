<http://purl.obolibrary.org/obo/HP_0012196> rdfs:label "Cheyne-Stokes respiration" ;
    dcterms:description "An abnormal pattern of respiration characterized by cycles of respiration that are increasingly deeper then shallower with possible periods of apnea. Affected patients may display a 10 to 20 second episode of hypoventilation or apnea, followed by respiration of increased depth and frequency over the course of about one minute. The cycle repeats every 45 seconds to 3 minutes."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Cheyne-Stokes breathing"^^<http://example.org/invalidDatatype>,
        "Periodic respiration"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Periodic respiration"^^<http://example.org/invalidDatatype>,
        "Cheyne-Stokes breathing" ;
    ns1:xref "SNOMEDCT_US:271824009"^^<http://example.org/invalidDatatype>,
        "UMLS:C0008039"^^<http://example.org/invalidDatatype>,
        "UMLS:C1313952"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:309155007" .

