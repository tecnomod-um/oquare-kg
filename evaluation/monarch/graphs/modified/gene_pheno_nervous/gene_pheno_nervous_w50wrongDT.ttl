    dcterms:description "Spinal muscular atrophy with respiratory distress type 2 is a rare, genetic, motor neuron disease characterized by progressive early respiratory failure associated with diaphragm paralysis, distal muscular weakness, joint contractures, and axial hypotonia with preserved antigravity limb movements. Phenotype overlaps considerably with SMARD type 1 but is differentiated by a mutation in a different gene."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "SMARD2"^^<http://example.org/invalidDatatype>,
        "X-linked spinal muscular atrophy with respiratory distress"^^<http://example.org/invalidDatatype>,
        "severe infantile axonal neuropathy with respiratory failure type 2"^^<http://example.org/invalidDatatype>,
        "diaphragmatic spinal muscular atrophy type 2" ;
    ns1:synonym "X-linked spinal muscular atrophy with respiratory distress"^^<http://example.org/invalidDatatype>,
        "severe infantile axonal neuropathy with respiratory failure type 2"^^<http://example.org/invalidDatatype>,
        "SMARD2",
        "diaphragmatic spinal muscular atrophy type 2" ;
    ns1:xref "Orphanet:404521"^^<http://example.org/invalidDatatype>,
        "GARD:0021723",
        "MEDGEN:1658540",
        "UMLS:C4749434" .

