<http://purl.obolibrary.org/obo/HP_0100297> rdfs:label "Increased endomysial connective tissue"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An increased volume of the endomysium, which is a connective tissue sheath that surrounds each muscle fiber. Together, bundles of muscle fibers form a fasciculus, surrounded by another layer of connective tissue called the perimysium."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Endomysial fibrosis"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Endomysial fibrosis" ;
    ns1:xref "UMLS:C4022161"^^<http://example.org/invalidDatatype> .

