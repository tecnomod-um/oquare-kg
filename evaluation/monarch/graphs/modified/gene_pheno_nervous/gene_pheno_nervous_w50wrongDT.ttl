        "Hypertrophy of midface",
        "Midfacial excess",
        "Overgrowth of the midface" ;
    ns1:xref "UMLS:C0240309"^^<http://example.org/invalidDatatype> .

<http://purl.obolibrary.org/obo/HP_0012398> rdfs:label "Peripheral edema" ;
    dcterms:description "An abnormal accumulation of interstitial fluid in the soft tissues of the limbs." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Peripheral oedema" ;
    ns1:synonym "Peripheral oedema"^^<http://example.org/invalidDatatype> ;
