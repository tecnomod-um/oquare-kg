<http://purl.obolibrary.org/obo/HP_0001239> rdfs:label "Wrist flexion contracture"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A chronic loss of wrist joint motion due to structural changes in muscle, tendons, ligaments, or skin that prevent normal movement of the joints of the wrist."^^<http://example.org/invalidDatatype> ;
