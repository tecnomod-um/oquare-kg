<http://purl.obolibrary.org/obo/HP_0001982> rdfs:label "Sea-blue histiocytosis"^^<http://example.org/invalidDatatype> ;
    dcterms:description "An abnormality of histiocytes, in which the cells take on a sea blue appearance due to abnormally increased lipid content. Histiocytes are a type of macrophage. Sea-blue histiocytes are typically large macrophages from 20 to 60 micrometers in diameter with a single eccentric nucleus whose cytoplasm if packed with sea-blue or blue-green granules when stained with Wright-Giemsa."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Sea-blue histiocyte"^^<http://example.org/invalidDatatype> ;
    ns1:synonym "Sea-blue histiocyte"^^<http://example.org/invalidDatatype> ;
