        <http://purl.obolibrary.org/obo/HP_0003205>,
        <http://purl.obolibrary.org/obo/HP_0003208> ;
    ns1:related_synonym "ceroid lipofuscinosis, neuronal, 6"^^<http://example.org/invalidDatatype>,
        "neuronal ceroid lipofuscinosis, Gypsy/Indian early juvenile variant"^^<http://example.org/invalidDatatype>,
