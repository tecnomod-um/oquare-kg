        "Schwann cell tumour",
        "Schwannomas" ;
    ns1:xref "SNOMEDCT_US:404022001"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:985004",
        "UMLS:C0027809" .

<http://purl.obolibrary.org/obo/HP_0100035> rdfs:label "Phonic tics"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Tics are defined as movements or sounds that resemble physiological motor behaviors, but are typically inopportune to social context and appear sudden, repetitive, and often exaggerated. Tic vocalizations commonly termed vocal or phonic tics may include any possible sound (eg, sniffing, coughing, throat clearing, whistling, or grunting), word, or sentence and are most commonly encountered within the spectrum of primary tic disorders, as Tourette syndrome."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Verbal tics"^^<http://example.org/invalidDatatype>,
        "Vocal tics" ;
    ns1:synonym "Verbal tics",
        "Vocal tics" ;
    ns1:xref "UMLS:C0751901" .

<http://purl.obolibrary.org/obo/HP_0100247> rdfs:label "Recurrent singultus" ;
    dcterms:description "A contraction of the diaphragm that repeats several times per minute. In humans, the abrupt rush of air into the lungs causes the epiglottis to close, creating a hic sound. Also known as synchronous diaphragmatic flutter (SDF), or singultus, from the Latin singult, the act of catching one's breath while sobbing. The hiccup is an involuntary action involving a reflex arc." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Recurrent hiccough"^^<http://example.org/invalidDatatype>,
        "Recurrent hiccup"^^<http://example.org/invalidDatatype>,
        "Recurrent synchronous diaphragmatic flutter"^^<http://example.org/invalidDatatype> ;
    ns1:related_synonym "Hiccups"^^<http://example.org/invalidDatatype>,
        "Hiccup" ;
    ns1:synonym "Recurrent hiccup"^^<http://example.org/invalidDatatype>,
        "Recurrent synchronous diaphragmatic flutter"^^<http://example.org/invalidDatatype>,
        "Hiccup",
        "Hiccups",
        "Recurrent hiccough" ;
    ns1:xref "UMLS:C0019521"^^<http://example.org/invalidDatatype>,
        "UMLS:C0744897"^^<http://example.org/invalidDatatype>,
        "SNOMEDCT_US:65958008" .

<http://purl.obolibrary.org/obo/HP_0100256> rdfs:label "Senile plaques" ;
    dcterms:description "Senile plaques are extracellular deposits of amyloid in the gray matter of the brain." ;
