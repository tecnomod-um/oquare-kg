    ns1:xref "UMLS:C4025790" .

<http://purl.obolibrary.org/obo/HP_0002373> rdfs:label "Febrile seizure (within the age range of 3 months to 6 years)" ;
    dcterms:description "A febrile seizure is any type of seizure (most often a generalized tonic-clonic seizure) occurring with fever (at least 38 degrees Celsius) but in the absence of central nervous system infection, severe metabolic disturbance or other alternative precipitant in children between the ages of 3 months and 6 years." ;
    ns1:category ns1:PhenotypicFeature ;
    ns1:exact_synonym "Febrile convulsion"^^<http://example.org/invalidDatatype>,
