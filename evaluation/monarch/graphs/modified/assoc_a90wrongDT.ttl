<http://purl.obolibrary.org/obo/MONDO_0700335> rdfs:label "familial isolated dilated cardiomyopathy"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare familial cardiomyopathy characterized by the dilation of left ventricle and progressively impairing of systolic ventricular function, in the absence of abnormal loading conditions or coronary artery disease sufficient to cause global systolic impairment. The disease may cause heart failure or arrhythmia. The disease is isolated when no additional atypical cardiac or extracardiac manifestations are present."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "familial or idiopathic dilated cardiomyopathy"^^<http://example.org/invalidDatatype>,
        "familial isolated dilated cardiomyopathy" ;
