<http://purl.obolibrary.org/obo/MONDO_0010221> rdfs:label "CHIME syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "CHIME syndrome is a rare ectodermal dysplasia syndrome characterized by ocular colobomas, cardiac defects, ichthyosiform dermatosis, intellectual disability, conductive hearing loss and epilepsy."^^<http://example.org/invalidDatatype> ;
