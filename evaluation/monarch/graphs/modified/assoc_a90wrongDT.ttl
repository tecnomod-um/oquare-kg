<http://purl.obolibrary.org/obo/MONDO_0015281> rdfs:label "atrial standstill"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Atrial standstill is a rare cardiac rhythm disease with a few familial and sporadic cases described to date that is characterized by a transient or permanent absence of electrical and mechanical atrial activity. Electrocardiographic findings include bradycardia, ectopic supraventricular rhythms, lack of atrial excitability and absent P waves."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "atrial cardiomyopathy with heart block"^^<http://example.org/invalidDatatype> ;
