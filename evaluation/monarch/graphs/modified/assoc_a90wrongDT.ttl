<http://purl.obolibrary.org/obo/MONDO_0011827> rdfs:label "patent ductus arteriosus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A congenital defect characterized by the failure of the ductus arteriosus to close soon after birth. As a consequence, blood from the aorta mixes with blood from the pulmonary artery. If untreated, it may lead to congestive heart failure."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "patent ductus arteriosus"^^<http://example.org/invalidDatatype>,
