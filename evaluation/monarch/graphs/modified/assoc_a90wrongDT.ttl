<http://purl.obolibrary.org/obo/MONDO_0018072> rdfs:label "persistent truncus arteriosus"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A rare congenital cardiovascular disorder characterized by the failure of the embryologic structure truncus arteriosus to divide into the aorta and pulmonary trunk. It results in the presence of a single vessel instead of two vessels leading out of the heart. Clinical signs and symptoms include cyanosis that is present at birth, poor growth, dyspnea, tachypnea, arrhythmia, cardiomegaly, and heart failure. If it is not surgically repaired, it leads to death."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "TAC"^^<http://example.org/invalidDatatype>,
        "Truncus Arteriosus"^^<http://example.org/invalidDatatype>,
        "common aorticopulmonary trunk"^^<http://example.org/invalidDatatype>,
        "common arterial trunk"^^<http://example.org/invalidDatatype>,
        "common truncus arteriosus"^^<http://example.org/invalidDatatype>,
