<http://purl.obolibrary.org/obo/MONDO_0017149> rdfs:label "drug- or toxin-induced pulmonary arterial hypertension"^^<http://example.org/invalidDatatype> ;
    dcterms:description "Drug- or toxin-induced pulmonary arterial hypertension (PAH) is a form of pulmonary arterial hypertension (PAH) secondary to the exposition to drugs. Drug- or toxin-induced PAH is characterized by elevated pulmonary arterial resistance leading to right heart failure. Drug or toxin induced PAH is progressive and potentially fatal."^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "drug- or toxin-induced PAH"^^<http://example.org/invalidDatatype> ;
