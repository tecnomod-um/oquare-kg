<http://purl.obolibrary.org/obo/MONDO_0000453> rdfs:label "short QT syndrome"^^<http://example.org/invalidDatatype> ;
    dcterms:description "A genetic disease of the electrical system of the heart that consists of a constellation of signs and symptoms, consisting of a short QT interval on an EKG (< 300 ms) that does not significantly change with heart rate, tall and peaked T waves, and a structurally normal heart. Short QT syndrome appears to be inherited in an autosomal dominant pattern, and a few affected families have been identified"^^<http://example.org/invalidDatatype> ;
    ns1:category ns1:Disease ;
    ns1:exact_synonym "short QT syndrome"^^<http://example.org/invalidDatatype>,
        "ventricular arrhythmia associated with short QT syndrome"^^<http://example.org/invalidDatatype> ;
